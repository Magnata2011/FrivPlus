		{
			if (type == 1)
				return buttonL_ps4_square;
			return button_ps4_square;
		}
		if (os_type == os_psvita)
		{
			if (type == 1)
				return buttonL_vita_square;
			return button_vita_square;
		}
		if (os_type == os_switch)
		{
			if (type == 1)
				return buttonL_nx_y;
