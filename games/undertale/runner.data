ds_map_add(global.text_data_en, "obj_shop5_554", "\E1* tem armor so GOOds^1!&* any battle becom^1!&* a EASY victories!!!/");
ds_map_add(global.text_data_en, "obj_shop5_555", "\E4* but^1, hnnn^1, tem think..^1.&* if u use armors^1, battles woudn b&  a challenge anymores,/");
ds_map_add(global.text_data_en, "obj_shop5_556", "\E3* but tem..^1.&* have a solushun!/");
ds_map_add(global.text_data_en, "obj_shop5_557", "\W* \E6tem wil offer..^1.\Y &* a SKOLARSHIPS\W!/");
ds_map_add(global.text_data_en, "obj_shop5_558", "\W*\E3 if u \Ylose a lot of battles^1, \W &  tem wil \YLOWER THE PRICE\W!/");
ds_map_add(global.text_data_en, "obj_shop5_559", "\E3* so if you get to TOUGH BATLE&  and feel FRUSTRATE^1, can buy&  TEM armor as last resort!/");
ds_map_add(global.text_data_en, "obj_shop5_560", "\E5* but tem armor so goods^1,&* promise to only buy if you&  really needs it^1,/%%");
ds_map_add(global.text_data_en, "obj_shop5_564", "\E1* in fack..^1.&* PRICE MAY ALREADY BE LOWERS!!!&* WOA!!!!/");
ds_map_add(global.text_data_en, "obj_shop5_565", "\E6* Congra-tem-lations!!!/%%");
ds_map_add(global.text_data_en, "obj_shop5_575", "\E0* us tems hav a DEEP HISTORY!!!/%%");
ds_map_add(global.text_data_en, "obj_shop5_579", "\E0* yaYA!!^1!&* tem got degree in TEM STUDIES^1!&* tem can tell you all about&  tem's DEEP HISTORY!!!/%%");
ds_map_add(global.text_data_en, "obj_shop5_584", "\E0* yaYA!!!&* go to TEM SHOP!!!/%%");
ds_map_add(global.text_data_en, "obj_shop5_589", "\E1* WOA!!/");
ds_map_add(global.text_data_en, "obj_shop5_590", "\E2* u gota... \[1]s!!!/");
ds_map_add(global.text_data_en, "obj_shop5_591", "\E4* hnnn...^1.&* i gota have dat \[1]s..^1.&* but i gota pay for colleg,/");
ds_map_add(global.text_data_en, "obj_shop5_594", "\E4* hnnn...^1.&* i gota have dat \[1]s..^1.&* but i gota pay for gradskool,/");
ds_map_add(global.text_data_en, "obj_shop5_596", "\E5* hnnnn....!!^1!&* tem always wanna \[1]s...!/%%");
ds_map_add(global.text_data_en, "obj_shop5_601", "\E2* b..^1 but.../");
ds_map_add(global.text_data_en, "obj_shop5_602", "\E4* p!!!!!!!!!!!!/%%");
ds_map_add(global.text_data_en, "obj_shop5_607", "\E3* You will regret this./%%");
ds_map_add(global.text_data_en, "obj_shop5_611", "\E3* Is this a joke^1?&* Are you having a chuckle^1?&* Ha ha^1, very funny^1.&* I'm the one with a degree./%%");
ds_map_add(global.text_data_en, "obj_shop5_633", "\E1* WOA!!/");
ds_map_add(global.text_data_en, "obj_shop5_634", "\E2* thas ALOT o muns..^1.&* can tem realy acepts.../");
ds_map_add(global.text_data_en, "obj_shop5_635", "\E7* OKs!!!^1!&* tem go to colleg and make&  u prouds!!!/%%");
