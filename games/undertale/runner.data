				global.hp = 1
		}
		if (global.hp <= 0)
			global.hp = 0
	}
	if (global.hope == 2)
		global.hp = 1
}
else
{
	if (global.hp >= 14)
		dmg = 9
	if (global.hp <= 14)
		dmg = 7
	if (global.hp <= 9)
		dmg = 6
	if (global.hp <= 5)
		dmg = 1
	scr_damagestandard_x()
	if (global.hp < 1)
		global.hp = 1
}
