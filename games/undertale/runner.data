ds_map_add(global.text_data_ja, "SCR_TEXT_3348", "ã¾ãšã¯ã€&ã‚ªãƒ¬ã•ã¾ã®&ã„ãˆã«&ã‚ãã³ã«&ãã¦â€¦/");
ds_map_add(global.text_data_ja, "SCR_TEXT_3349", "ãã®ã‚ã¨ã€&ã‚¢ãƒ³ãƒ€ã‚¤ãƒ³&ã®&ã„ãˆã«ã‚‚&ãã¦ã‚ˆï¼/");
ds_map_add(global.text_data_ja, "SCR_TEXT_335", "\E0ï¼Š ãŒã‚“ã°ã£ã¦^1ï¼&ã€€ ã‚ãªãŸãªã‚‰ã€€ãã£ã¨&ã€€ ã§ãã‚‹ã¯ãšï¼/%");
ds_map_add(global.text_data_ja, "SCR_TEXT_3350", "ãã•ã¾ã¨&ã‚¢ãƒ³ãƒ€ã‚¤ãƒ³&ã¯ã€&ããŒã‚ã†ã¨&ãŠã‚‚ã†ãªï¼/");
ds_map_add(global.text_data_ja, "SCR_TEXT_3351", "\TS \F0 \T0 %");
ds_map_add(global.text_data_ja, "SCR_TEXT_3352", "ï¼Š ãƒ„ãƒ¼â€¦/%%");
ds_map_add(global.text_data_ja, "SCR_TEXT_3358", "* (It's a book labelled&  Monster History Part 6.)&         Read it     Do not\C");
ds_map_add(global.text_data_ja, "SCR_TEXT_3359", " ");
ds_map_add(global.text_data_ja, "SCR_TEXT_3363", "* Unfortunately^1, monsters are&  not experienced with&  illness./");
ds_map_add(global.text_data_ja, "SCR_TEXT_3364", "* However^1, when monsters are&  about to expire of age^1,&  they lie down^1, immobile./");
ds_map_add(global.text_data_ja, "SCR_TEXT_3365", "* We call this state&  \"Fallen Down.\"/");
ds_map_add(global.text_data_ja, "SCR_TEXT_3366", "* A person who has Fallen&  Down will soon perish./");
ds_map_add(global.text_data_ja, "SCR_TEXT_3367", "* In a way^1, this confusing&  situation was all too&  familiar./%%");
ds_map_add(global.text_data_ja, "SCR_TEXT_3370", "* (You decide not to read it.)/%%");
ds_map_add(global.text_data_ja, "SCR_TEXT_339", "\E2ï¼Š ã•ã‚^1ã€€&ã€€ ã²ã ã‚Šã®ã‚¹ã‚¤ãƒƒãƒã‚‚&ã€€ ãŠã—ã¦ã¡ã‚‡ã†ã ã„ã€‚/%");
ds_map_add(global.text_data_ja, "SCR_TEXT_3393", "ï¼Š (It's a book labelled&  Monster History Part 7.)&         Read it     Do not\C");
ds_map_add(global.text_data_ja, "SCR_TEXT_3394", " ");
ds_map_add(global.text_data_ja, "SCR_TEXT_3398", "ï¼Š When a human dies^1, its&  soul remains stable&  outside the body./");
ds_map_add(global.text_data_ja, "SCR_TEXT_3399", "ï¼Š Meanwhile^1, a monster's soul&  disappears near-instantly&  upon death./");
ds_map_add(global.text_data_ja, "SCR_TEXT_3400", "ï¼Š This allows monsters to&  absorb the souls of&  humansâ€¦/");
ds_map_add(global.text_data_ja, "SCR_TEXT_3401", "ï¼Š While it is extremely&  difficult for humans to&  absorb a monster's soul./");
ds_map_add(global.text_data_ja, "SCR_TEXT_3402", "ï¼Š This is why they feared us./");
ds_map_add(global.text_data_ja, "SCR_TEXT_3403", "ï¼Š Though monsters are weak^1,&  with enough human soulsâ€¦/");
ds_map_add(global.text_data_ja, "SCR_TEXT_3404", "ï¼Š They could easily destroy&  all of mankind./%%");
ds_map_add(global.text_data_ja, "SCR_TEXT_3407", "ï¼Š (You decide not to read it.)/%%");
ds_map_add(global.text_data_ja, "SCR_TEXT_3413", "ï¼Š (It's a book labelled&  Monster History Part 8.)&         Read it     Do not\C");
ds_map_add(global.text_data_ja, "SCR_TEXT_3414", " ");
ds_map_add(global.text_data_ja, "SCR_TEXT_3418", "ï¼Š There is one exception&  to the aforementioned&  rules:/");
ds_map_add(global.text_data_ja, "SCR_TEXT_3419", "ï¼Š A certain type of monster^1,&  the \"boss\" monster./");
ds_map_add(global.text_data_ja, "SCR_TEXT_342", "\E2ï¼Š ãŸã—ã‹â€¦ã€€ã²ã ã‚Šã®&ã€€ ã‚¹ã‚¤ãƒƒãƒã ã£ãŸã¨&ã€€ ãŠã‚‚ã£ãŸã‘ã‚Œã©â€¦/%");
ds_map_add(global.text_data_ja, "SCR_TEXT_3420", "ï¼Š Due to its life cycle^1, it&  possesses an incredibly&  strong soul for a monster./");
ds_map_add(global.text_data_ja, "SCR_TEXT_3421", "ï¼Š This soul can remain&  stable after death^1, if&  only for a few moments./%%");
ds_map_add(global.text_data_ja, "SCR_TEXT_3424", "ï¼Š (You decide not to read it.)/%%");
ds_map_add(global.text_data_ja, "SCR_TEXT_3429", "ï¼Š (ã™ã¹ã¦ã®ã»ã‚“ã«ã€€ã€Œãƒ‹ãƒ³ã‚²ãƒ³ã®&ã€€ ã‚Œãã—ã€ã¨ã€€ãƒ©ãƒ™ãƒ«ãŒã¯ã£ã¦ã‚ã‚‹)& \>0ã‚ˆã‚€\>1ã‚ˆã¾ãªã„\C");
