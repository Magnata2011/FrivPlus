		if (pour_index <= 7.8)
			draw_sprite(spr_mainchara_pourwater, floor(pour_index), xx, obj_mainchara.y)
		else if (xx < thisx)
		{
			xx += 1
			draw_sprite(spr_maincharal_water, floor((w_timer / 3)), xx, obj_mainchara.y)
		}
		else
		{
			FL_HaveWater = 0
			with (obj_watercooler)
				havewater = 0
			obj_mainchara.visible = true
			with (obj_mainchara)
			{
