			global.hp -= 1
			global.km -= 1
		}
		if (km_t >= (30 + (km_bonus * 10)))
		{
			km_t = 0
			global.hp -= 1
			global.km -= 1
		}
		if (global.hp <= 0)
			global.hp = 1
	}
	prevhp = global.hp
}
