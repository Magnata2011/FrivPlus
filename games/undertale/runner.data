		{
			defaultspeed -= 0.01
			snail[0].hspeed = defaultspeed
		}
		if (encouragement == 2)
			snail[0].hspeed = defaultspeed
		if (encouragement >= 3)
		{
			defaultspeed += (0.01 * encouragement)
			snail[0].hspeed = defaultspeed
		}
		encouragement = 0
	}
	if (snail[0].hspeed > 0 || encouragement > 30)
	{
