		if (fileset == 6)
			draw_text_transformed(20, 430, string_hash_to_newline(scr_gettext("flowey_load", "6")), textscale, textscale, 0)
	}
	else
		draw_text_transformed(20, 430, string_hash_to_newline(scr_gettext("flowey_load", "2")), textscale, textscale, 0)
}
