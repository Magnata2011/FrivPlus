	if (prevhp == global.hp)
	{
		km_bonus = 0
		if (global.inv >= 45)
			km_bonus = choose(0, 1)
		if (global.inv >= 60)
			km_bonus = choose(0, 1, 1)
		if (global.inv >= 75)
			km_bonus = 1
		if (km_t >= (1 + km_bonus) && global.km >= 40)
		{
			km_t = 0
			global.hp -= 1
			global.km -= 1
		}
		if (km_t >= (2 + (km_bonus * 2)) && global.km >= 30)
		{
			km_t = 0
			global.hp -= 1
			global.km -= 1
		}
		if (km_t >= (5 + (km_bonus * 3)) && global.km >= 20)
