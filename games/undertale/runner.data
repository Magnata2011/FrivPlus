{
	if (idealdir == 0 && dir > 180)
	{
		neg = 1
		dir -= 360
	}
	if (dir >= 0 && dir < 90 && idealdir == 270)
	{
		neg = 2
		dir = 360
	}
	if (neg == 0)
	{
		dir %= 360
		dif = (idealdir - dir)
		dir += (dif * (2/3))
		if (dir < 0)
			dir += 360
		if (abs(dif) < 15)
		{
			dir = idealdir
			neg = 0
		}
	}
	if (neg == 1)
	{
		dir %= 360
		dif = abs((idealdir - dir))
		dir += (dif * (2/3))
		if (abs((abs(idealdir) - abs(dir))) < 15)
		{
			dir = idealdir
			neg = 0
		}
	}
	if (neg == 2)
	{
		dif = (idealdir - dir)
		dir += (dif * (2/3))
		if (abs((abs(idealdir) - abs(dir))) < 15)
		{
			dir = idealdir
			neg = 0
		}
	}
}
