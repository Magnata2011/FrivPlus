			for (i = 4; i <= 8; i++)
				border_enabled[i] = 1
		}
		if (CP || BP)
			border_enabled[9] = 1
		if (CH || BH)
			border_enabled[10] = 1
		if (global.osflavor == OSFlavors.Switch)
		{
			if M
			{
				border_enabled[11] = 1
				border_11 = R
			}
			if DB
				border_enabled[12] = 1
		}
		if (os_type == os_xboxone)
		{
			var hasDonated = ini_read_real("Dogshrine", "Donated", 0)
			if hasDonated
				border_enabled[13] = 1
		}
		if (EndF >= 2)
			fun = false
	}
	ossafe_ini_close()
}
