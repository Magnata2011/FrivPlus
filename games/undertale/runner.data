if keyboard_check_pressed(vk_down)
{
	menuc[menu] += 1
	if (menuc[menu] > menumax)
		menuc[menu] = 0
}
if keyboard_check_pressed(vk_up)
{
	menuc[menu] -= 1
	if (menuc[menu] < 0)
		menuc[menu] = menumax
}
