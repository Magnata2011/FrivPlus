		xx_off = (lengthdir_x(1, (image_angle - 90)) * 18)
		yy_off = (lengthdir_y(1, (image_angle - 90)) * 18)
		if (hitted == 0)
		{
			if collision_line((x - (xx * 0.8)), (y - (yy * 0.8)), (x + (xx * 0.8)), (y + (yy * 0.8)), obj_creditsheart, true, true)
				event_user(1)
