ds_map_add(global.text_data_en, "obj_sign_room_156", "* (Please take one.)/%%");
ds_map_add(global.text_data_en, "obj_sign_room_163", "* North: Blook Acres&* East: Hotland&* ???: Temmie Village/%%");
ds_map_add(global.text_data_en, "obj_sign_room_207", "* (Don't want to walk to the&  other side of town?)/");
ds_map_add(global.text_data_en, "obj_sign_room_208", "* (Try the undersnow tunnels^1!)&* (They're efficiently laid out.)/%%");
ds_map_add(global.text_data_en, "obj_sign_room_220", "* hOI!^1!&* welcom to..^1.&* TEM VILLAGE!!!/%%");
ds_map_add(global.text_data_en, "obj_sign_room_221", "* hOI!^1!&* u shud check out..^1.&* TEM SHOP!!!/%%");
ds_map_add(global.text_data_en, "obj_sign_room_222", "* yaYA!^1! i AGREES!^1!&* shud check..^1.&* TEM SHOP!!!/%%");
ds_map_add(global.text_data_en, "obj_sign_room_227", "* Learning how to draw^1?&* Come to the Art Lessons on&  the second floor!/");
ds_map_add(global.text_data_en, "obj_sign_room_228", "* Located in a similar place./%%");
ds_map_add(global.text_data_en, "obj_slimejanitor_73", "* (Seems busy.)/%%");
ds_map_add(global.text_data_en, "obj_slimejanitor_77", "* (Trying to finish up work.)/%%");
ds_map_add(global.text_data_en, "obj_slimejanitor_82", "* (Futility setting in.)/%%");
ds_map_add(global.text_data_en, "obj_smallchair_55", "* (Toriel's small chair.)&* (Its name is Chairiel.)/%%");
ds_map_add(global.text_data_en, "obj_smallchair_57", "* (Who knows what the future&  holds for Chairiel.)/%%");
ds_map_add(global.text_data_en, "obj_smalldoghouse_98", "* (What a tiny doghouse!)/%%");
ds_map_add(global.text_data_en, "obj_smalldoghouse_99", "* (It must be bigger on the&  inside.)/%%");
ds_map_add(global.text_data_en, "obj_smallfrog_61", "* Ribbit^1, ribbit^1.&* (Excuse me^1, human.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_62", "* (I have some advice&  for you about battling&  monsters.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_63", "\W* (If you \YACT\W a certain way&  or \YFIGHT\W until you&  almost defeat them...)/");
ds_map_add(global.text_data_en, "obj_smallfrog_64", "* (They might not want to&  battle you anymore.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_65", "* (If a monster does not&  want to fight you^1, please...)/");
ds_map_add(global.text_data_en, "obj_smallfrog_66", "\W* (Use some \YMERCY^1,\W human.^1)&* Ribbit./%%");
ds_map_add(global.text_data_en, "obj_smallfrog_70", "* Ribbit^1, ribbit^1.&* (Excuse me^1, human.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_71", "* (I have some advice&  for you about battling&  monsters.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_72", "* (The monsters in this world&  are very dangerous and&  aggressive.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_73", "* (In this place^1, running away&  will not work on the&  first turn.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_74", "* (It may be better to try&  another option.^1)&* Ribbit./%%");
ds_map_add(global.text_data_en, "obj_smallfrog_79", "* Ribbit^1, ribbit^1.&* (Excuse me^1, human.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_80", "* (You seem like you have&  grown into a thoughtful and&  conscientious person.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_81", "* (Whether that was from my&  advice or not...^1)&* (I'm quite proud.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_82", "* Ribbit./%%");
ds_map_add(global.text_data_en, "obj_smallfrog_90", "* Ribbit^1, ribbit^1.&* (Just between you and me...)/");
ds_map_add(global.text_data_en, "obj_smallfrog_91", "\W* (I saw \BTORIEL\W come out of&  here just a little&  while ago.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_92", "* (She was carrying some&  groceries.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_93", "* (I didn't ask what they&  were for...)/");
ds_map_add(global.text_data_en, "obj_smallfrog_94", "* (We're all too intimidated&  to talk to her.^1)&* Ribbit./%%");
ds_map_add(global.text_data_en, "obj_smallfrog_97", "* Ribbit^1, ribbit^1.&* (Seems like the RUINS have&  finally opened up.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_98", "* (Maybe we should finally&  go out to the rest of&  the underground.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_99", "* (Huh^1? The barrier's open^1,&  too...?)/");
ds_map_add(global.text_data_en, "obj_smallfrog_100", "* (... let's just take this&  one step at a time^1, OK?)/%%");
ds_map_add(global.text_data_en, "obj_smallfrog_105", "* Ribbit^1, ribbit^1.&* (Just between you and me...)/");
ds_map_add(global.text_data_en, "obj_smallfrog_106", "\W* (I saw \BTORIEL\W come out of&  here just a little&  while ago.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_107", "* (Normally^1, she carries&  groceries out of here.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_108", "* (But this time^1, she wasn't&  carrying anything.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_109", "* (She looked disappointed.^1)&* Ribbit./%%");
ds_map_add(global.text_data_en, "obj_smallfrog_117", "* Ribbit ribbit^1.&* (I heard using \"F4\" can make&  you have a \"full screen.\")/");ds_map_add(global.text_data_en, "obj_smallfrog_118", "* (But what does \"F4\" stand for?^1)&* (\"Four frogs\"?)/");ds_map_add(global.text_data_en, "obj_smallfrog_119", "* (I have only seen a maximum of&  three frogs in this room...)/");
ds_map_add(global.text_data_en, "obj_smallfrog_120", "* (This is troubling^1, to say&  the least.^1)&* Ribbit./%%");
ds_map_add(global.text_data_en, "obj_smallfrog_117_console", "* Ribbit ribbit^1.&* (I heard using \"Borders\" can&  add some color to the world.)/");ds_map_add(global.text_data_en, "obj_smallfrog_118_console", "* (It seems you can choose&  them in the \"Settings\" menu&  before you load your game.)/");ds_map_add(global.text_data_en, "obj_smallfrog_119_console", "* (However, there isn't a&  frog-themed border.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_120_console", "* (So it's just pointless.^1)&* Ribbit./%%");
ds_map_add(global.text_data_en, "obj_smallfrog_124", "* Ribbit ribbit^1.&* (Did you ever find this&  room's fourth frog?)/%%");
ds_map_add(global.text_data_en, "obj_smallfrog_140", "* Ribbit ribbit^1.&* (Yellow names were nice for&  a while.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_141", "* (Next time^1, we should try a&  relaxing shade of green.)/%%");
ds_map_add(global.text_data_en, "obj_smallfrog_145", "* Ribbit ribbit^1.&* (How was your adventure?)/");
ds_map_add(global.text_data_en, "obj_smallfrog_146", "* (It must have been difficult&  without being able to tell&  the enemy's feelings.)/%%");
ds_map_add(global.text_data_en, "obj_smallfrog_150", "* Ribbit ribbit^1.&* (Finally^1, we can all remove&  these aging pink names.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_151", "* (Everyone gave you a big favor&  today.^1)&* (Try to respect that!)/%%");
ds_map_add(global.text_data_en, "obj_smallfrog_xadvice_59", "* Ribbit^1, ribbit^1.&* (Sigh...)/");
ds_map_add(global.text_data_en, "obj_smallfrog_xadvice_60", "* (My friend never listens to&  me.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_xadvice_61", "* (Whenever I talk^1, they skip&  through my words by pressing&  \*X.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_xadvice_62", "* (That's right.......^1)&* (Pressing \*X............^1)&* (................)/");
ds_map_add(global.text_data_en, "obj_smallfrog_xadvice_63", "* (Well^1, at least you listen&  to me.)/%%");
ds_map_add(global.text_data_en, "obj_smallfrog_xadvice_67", "* Ribbit^1, ribbit^1.&* (Say...)/");
ds_map_add(global.text_data_en, "obj_smallfrog_xadvice_68", "* (Now that your journey's&  over^1, maybe you'll have&  time to listen to me.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_xadvice_69", "* (Since most people just&  press \*X to skip through&  my dialogue.)/");
ds_map_add(global.text_data_en, "obj_smallfrog_xadvice_70", "* (That's right.......^1)&* (Pressing \*X............^1)&* (................)/");
ds_map_add(global.text_data_en, "obj_smallfrog_xadvice_71", "* (You've really matured^1,&  haven't you?)/%%");
ds_map_add(global.text_data_en, "obj_smallfrog_xadvice_150", "* (Oh^1, not you too!)/%%");
ds_map_add(global.text_data_en, "obj_smallfrog_xadvice_153", "* (... I suppose some things&  never change.)/%%");
ds_map_add(global.text_data_en, "obj_smallweb_64", "* (It's a spider web.)/");
ds_map_add(global.text_data_en, "obj_smallweb_65", "* (There's a flyer for a&  bake sale on it.)/%%");
ds_map_add(global.text_data_en, "obj_snail2_70", "* (Someone has meticulously&  cleaned all the slime off of&  this snail.)/%%");
ds_map_add(global.text_data_en, "obj_snail2_73", "* (The snail has covered&  itself in slime again...^1)&* (Happy ending...)/%%");
ds_map_add(global.text_data_en, "obj_snail3_70", "* (This snail is counting dollar&  bills.)/%%");
ds_map_add(global.text_data_en, "obj_snail3_73", "* (Using its money^1, the&  snail bought a hat.)/%%");
ds_map_add(global.text_data_en, "obj_snailguy_70", "* I've been long overdue for&  a second house.../%%");
ds_map_add(global.text_data_en, "obj_snailguy_73", "* The housing market will&  probably crash now./");
ds_map_add(global.text_data_en, "obj_snailguy_74", "* But you know^1, home&  is where the heart is./%%");
ds_map_add(global.text_data_en, "obj_snowdecahedron_102", "* (It looks like a snow ball...)/");
ds_map_add(global.text_data_en, "obj_snowdecahedron_103", "* (Actually^1, it's a&  snowdecahedron.)/%%");
ds_map_add(global.text_data_en, "obj_snowdecahedron_104", "* (It's a snow ball.)/%%");
ds_map_add(global.text_data_en, "obj_snowdinlogo_70", "* (Welcome to Snowdin Town!)/%%");
ds_map_add(global.text_data_en, "obj_snowdrake_248", "\"Ice\"&to meet&you.");ds_map_add(global.text_data_en, "obj_snowdrake_249", "Ice puns&are&\"snow\"&problem");ds_map_add(global.text_data_en, "obj_snowdrake_250", "Fights&you in&\"cold\"&blood.");ds_map_add(global.text_data_en, "obj_snowdrake_251", "Better&not snow&\"flake\"&out!");ds_map_add(global.text_data_en, "obj_snowdrake_252", "My fave&ice&cereals:&\"frosted\"");ds_map_add(global.text_data_en, "obj_snowdrake_253", "\"Chill\"&out...");ds_map_add(global.text_data_en, "obj_snowdrake_254", "M.. m..&macaroni&and&\"freeze\"");ds_map_add(global.text_data_en, "obj_snowdrake_257", "Do I&really&...");
ds_map_add(global.text_data_en, "obj_snowdrake_258", "Hey...");
ds_map_add(global.text_data_en, "obj_snowdrake_259", "Guys...&guys...");
ds_map_add(global.text_data_en, "obj_snowdrake_265", "You have&good&taste!!&(In jokes)");
ds_map_add(global.text_data_en, "obj_snowdrake_266", "See!?&Laughs!&Dad was&wrong!");
ds_map_add(global.text_data_en, "obj_snowdrake_267", "Thanks,&you're&all&great.");
ds_map_add(global.text_data_en, "obj_snowdrake_268", "See!?&Laughs!&Dad was&wrong!");
ds_map_add(global.text_data_en, "obj_snowdrake_271", "What are&YOU&laughin'&at?!?");
ds_map_add(global.text_data_en, "obj_snowdrake_278", "Is that&s'posed&to be&funny?");
ds_map_add(global.text_data_en, "obj_snowdrake_279", "Ha...&Ha...&Nice&try.");
ds_map_add(global.text_data_en, "obj_snowdrake_280", "I've&heard&that&one.");
ds_map_add(global.text_data_en, "obj_snowdrake_285", "THIS&won't be&funny&either!");
ds_map_add(global.text_data_en, "obj_snowdrake_286", "Is your&flesh&rotten&as you?");
ds_map_add(global.text_data_en, "obj_snowdrake_287", "(Insults&towards&humans)");
ds_map_add(global.text_data_en, "obj_snowdrake_292", "IT'S&JUST&LIKE&'EM");
ds_map_add(global.text_data_en, "obj_snowdrake_293", "HAHA&YOU'RE&BETTER");
ds_map_add(global.text_data_en, "obj_snowdrake_294", "YOU&NAILED&IT");
ds_map_add(global.text_data_en, "obj_snowdrake_299", "That's&not&like&me...");
ds_map_add(global.text_data_en, "obj_snowdrake_300", "I don't&do it&that&way...");
ds_map_add(global.text_data_en, "obj_snowdrake_301", "It's&better&when I&do it...");
ds_map_add(global.text_data_en, "obj_snowdrake_309", "%%%");
ds_map_add(global.text_data_en, "obj_snowdrake_507", "* Snowdrake is assessing the&  crowd.");
ds_map_add(global.text_data_en, "obj_snowdrake_508", "* Snowdrake is practicing&  its next pun.");
ds_map_add(global.text_data_en, "obj_snowdrake_509", "* Snowdrake is smiling at its&  own bad joke.");
ds_map_add(global.text_data_en, "obj_snowdrake_510", "* It smells like a wet&  pillow.");
ds_map_add(global.text_data_en, "obj_snowdrake_511", "* Snowdrake realized its own&  name is a pun and is&  freaking out.");
ds_map_add(global.text_data_en, "obj_snowdrake_512", "* Snowdrake is pleased with&  its \"cool\" joke.");ds_map_add(global.text_data_en, "obj_snowdrake_513", "* Snowdrake is laughing at&  your imitation of its&  cohort.");
ds_map_add(global.text_data_en, "obj_snowdrake_514", "* Snowdrake pretends not to&  care.");
ds_map_add(global.text_data_en, "obj_snowdrake_515", "* Snowdrake is puffed up..");
ds_map_add(global.text_data_en, "obj_snowdrake_516", "* Snowdrake is flaking&  apart.");
ds_map_add(global.text_data_en, "obj_snowdrake_533", "* SNOWDRAKE - ATK 12 DEF 7&* This teen comedian fights to&  keep a captive audience./^");
ds_map_add(global.text_data_en, "obj_snowdrake_542", "* You boo the Snowdrake./^");
ds_map_add(global.text_data_en, "obj_snowdrake_543", "* You tell the Snowdrake that&  they aren't funny./^");
ds_map_add(global.text_data_en, "obj_snowdrake_545", "* You tell the Snowdrake that&  no one will ever love&  them the way they are.../");
ds_map_add(global.text_data_en, "obj_snowdrake_546", "* They struggle to make a&  retort^1, and slink away&  utterly crushed.../^");
ds_map_add(global.text_data_en, "obj_snowdrake_559", "* You laugh at Snowdrake before&  it says anything funny./^");
ds_map_add(global.text_data_en, "obj_snowdrake_560", "* You laugh at Snowdrake's&  pun./^");
ds_map_add(global.text_data_en, "obj_snowdrake_568", "* You make a bad ice pun./^");
ds_map_add(global.text_data_en, "obj_snowdrake_570", "* You make a bad ice pun./");
ds_map_add(global.text_data_en, "obj_snowdrake_571", "* The other monsters think&  it's hilarious.../^");
ds_map_add(global.text_data_en, "obj_snowdrakedad_75", "* I'm the resort comedian.&* I'm very funny^1.&* People laugh at my jokes./");
ds_map_add(global.text_data_en, "obj_snowdrakedad_76", "* Now^1, my son^1.&* He wants to be a comedian&  like his fathah./");
ds_map_add(global.text_data_en, "obj_snowdrakedad_77", "* But his jokes^1.&* Aren't funny./");
ds_map_add(global.text_data_en, "obj_snowdrakedad_78", "* He tells these awful puns^1.&* He's an embarrassment to&  our family./");
ds_map_add(global.text_data_en, "obj_snowdrakedad_79", "* Ha ha ha ha.../");
ds_map_add(global.text_data_en, "obj_snowdrakedad_80", "* That's not funny./");
ds_map_add(global.text_data_en, "obj_snowdrakedad_81", "* Since his mothah passed on^1,&  he couldn't stand^1.&* Living at home anymore./");
ds_map_add(global.text_data_en, "obj_snowdrakedad_82", "* So he ran away^1.&* I haven't seen him since./");
ds_map_add(global.text_data_en, "obj_snowdrakedad_83", "* I'm a terrible fathah^1.&* Ha ha ha ha.../");
ds_map_add(global.text_data_en, "obj_snowdrakedad_84", "* That's not funny./%%");
ds_map_add(global.text_data_en, "obj_snowdrakedad_87", "* Talking to you about&  this..^1.&* It's breakin' my heart./");
ds_map_add(global.text_data_en, "obj_snowdrakedad_88", "* Ha ha ha ha.../");
ds_map_add(global.text_data_en, "obj_snowdrakedad_89", "* That's not funny./%%");
ds_map_add(global.text_data_en, "obj_snowdrakedad_94", "* The doctah^1.&* She brought my wife.&* Back from the dead./");
ds_map_add(global.text_data_en, "obj_snowdrakedad_95", "* My son^1.&* He seems happy again./");
ds_map_add(global.text_data_en, "obj_snowdrakedad_96", "* Our family^1.&* It's biggah than evah./");
ds_map_add(global.text_data_en, "obj_snowdrakedad_97", "* Now that my wife^1.&* Is combined^1.&* With 16 othah people./%%");
ds_map_add(global.text_data_en, "obj_snowdrakedad_102", "* My boss stopped answering my&  calls./");
ds_map_add(global.text_data_en, "obj_snowdrakedad_103", "* I don't know when my next&  performance will be./");
ds_map_add(global.text_data_en, "obj_snowdrakedad_104", "* Maybe I shouldn't try to be&  a comedian anymore.../");
ds_map_add(global.text_data_en, "obj_snowdrakedad_105", "* It's tearing my family apart./%%");
ds_map_add(global.text_data_en, "obj_snowdrakedad_110", "* My son..^1.&* He was always making these&  weird ice puns./");
ds_map_add(global.text_data_en, "obj_snowdrakedad_111", "* I hated them^1, so he ran&  away from home.../");
ds_map_add(global.text_data_en, "obj_snowdrakedad_112", "* I think I should try to&  patch things up with him./");
ds_map_add(global.text_data_en, "obj_snowdrakedad_113", "* Have you seen him^1?&* Have you seen my son?/%%");
ds_map_add(global.text_data_en, "obj_snowdrakemom_158", " sn...& o...& wy...");
ds_map_add(global.text_data_en, "obj_snowdrakemom_165", " haha...& i...& remem..&  ber...");
ds_map_add(global.text_data_en, "obj_snowdrakemom_167", " haha...& thank...& you...");
ds_map_add(global.text_data_en, "obj_snowdrakemom_173", "%%%");
ds_map_add(global.text_data_en, "obj_snowdrakemom_387", "* It's so cold.");
ds_map_add(global.text_data_en, "obj_snowdrakemom_388", "* It's so cold.");
ds_map_add(global.text_data_en, "obj_snowdrakemom_389", "* It's so cold.");
ds_map_add(global.text_data_en, "obj_snowdrakemom_390", "* It's so cold.");
ds_map_add(global.text_data_en, "obj_snowdrakemom_391", "* Smells like salty slush.");
ds_map_add(global.text_data_en, "obj_snowdrakemom_392", "* Seems calmed down.");
ds_map_add(global.text_data_en, "obj_snowdrakemom_393", "* Monster has low HP.");
ds_map_add(global.text_data_en, "obj_snowdrakemom_426", "* AMALGAMATE - ATK -12 DEF -5&* Seems like it's losing itself./^");
ds_map_add(global.text_data_en, "obj_snowdrakemom_435", "* You laugh^1, and keep laughing^1.&* It's SO funny^1, you can't stop^1.&* Tears run down your face./");
ds_map_add(global.text_data_en, "obj_snowdrakemom_436", "* ... what^1?&* You didn't do that?/^");
ds_map_add(global.text_data_en, "obj_snowdrakemom_439", "* But it's not funny./^");
ds_map_add(global.text_data_en, "obj_snowdrakemom_451", "* You said something like..^1.&* \"You look horrible.^1\"&* \"Why are you even alive?^1\"/");ds_map_add(global.text_data_en, "obj_snowdrakemom_452", "* ... what^1?&* You didn't say that?/^");
ds_map_add(global.text_data_en, "obj_snowdrakemom_455", "* You call this a performance?/^");
ds_map_add(global.text_data_en, "obj_snowdrakemom_467", "* You told a bad pun about&  snow^1.&* Her expression starts to shift./^");
ds_map_add(global.text_data_en, "obj_snowdrakemom_469", "* You told a bad pun about&  snow^1.&* Her expression changes more./^");
ds_map_add(global.text_data_en, "obj_snowdrakemom_472", "* You told a bad pun about&  snow^1.&* She's completely calmed down./^");
ds_map_add(global.text_data_en, "obj_snowdrakenpc_76", "* I ran away from home^1.&* Why?/");
ds_map_add(global.text_data_en, "obj_snowdrakenpc_77", "* 'Cause my father was so&  \"cold\" to me.../");ds_map_add(global.text_data_en, "obj_snowdrakenpc_78", "* WHAT!^1?&* It's a JOKE!^1!&* LAUGH at it!!/%%");
ds_map_add(global.text_data_en, "obj_snowdrakenpc_82", "* I really don't^1!&* I don't care if he doesn't&  like my jokes!/%%");
ds_map_add(global.text_data_en, "obj_snowdrakenpc_87", "* Mom might have to share her&  mind with other people now^1,&  but she's still my mom./");
ds_map_add(global.text_data_en, "obj_snowdrakenpc_88", "* And that's \"cool!\"/");ds_map_add(global.text_data_en, "obj_snowdrakenpc_89", "* 'Cause^1, uhh^1, we're made&  of ice and stuff./");
ds_map_add(global.text_data_en, "obj_snowdrakenpc_90", "* WHAT!?!^1?&* It's a JOKE!^1!&* LAUGH at it!!/%%");
ds_map_add(global.text_data_en, "obj_snowpoff_100", "* It's a snow poff./%%");
ds_map_add(global.text_data_en, "obj_snowpoff_101", "* And this..^1.&* Is a snow poff./%%");
ds_map_add(global.text_data_en, "obj_snowpoff_102", "* This^1, however^1, is a snow poff./%%");
ds_map_add(global.text_data_en, "obj_snowpoff_103", "* Surprisingly^1, it's a snow poff./%%");
ds_map_add(global.text_data_en, "obj_snowpoff_104", "* Snow poff.../%%");
ds_map_add(global.text_data_en, "obj_snowpoff_105", "* Is it really a snow poff?/%%");
ds_map_add(global.text_data_en, "obj_snowpoff_106", "* Behold^1!&* A snow poff./%%");
ds_map_add(global.text_data_en, "obj_snowpoff_107", "* What's this called?/%%");
ds_map_add(global.text_data_en, "obj_snowpoff_108", "* Eh^1?&* There's 30 G inside&  this..^1. what is this?/%%");
ds_map_add(global.text_data_en, "obj_sockdrawer_60", "%%");
ds_map_add(global.text_data_en, "obj_sockdrawer_66", "* You peek inside..^2.&* Scandalous!/");
ds_map_add(global.text_data_en, "obj_sockdrawer_67", "* It's TORIEL's sock drawer./%%");
ds_map_add(global.text_data_en, "obj_sockdrawer_68", "* You can't stop looking&  at the socks./%%");
ds_map_add(global.text_data_en, "obj_sosorry_269", "AHHHHHHH!!!!!/%%");
ds_map_add(global.text_data_en, "obj_sosorry_274", "\E1AHHHHH!!!/%%");
ds_map_add(global.text_data_en, "obj_sosorry_279", "\E1Oh!&Whoops!&That hurt!/");
ds_map_add(global.text_data_en, "obj_sosorry_280", "\E2So sorry^1, I must&have gotten in the&way!/");
ds_map_add(global.text_data_en, "obj_sosorry_281", "\E1I really shouldn't&stand so close/");
ds_map_add(global.text_data_en, "obj_sosorry_282", "\E4Ah I'm just being&troublesome/%%");
ds_map_add(global.text_data_en, "obj_sosorry_287", "\E4Darn it, I keep&getting in the way/");
ds_map_add(global.text_data_en, "obj_sosorry_288", "\E2So sorry, I'm such&an oaf/");
ds_map_add(global.text_data_en, "obj_sosorry_289", "\E2Wandering in front&of you.../%%");
ds_map_add(global.text_data_en, "obj_sosorry_294", "\E1.../");
ds_map_add(global.text_data_en, "obj_sosorry_295", "Are you...&trying to KILL me?/");
ds_map_add(global.text_data_en, "obj_sosorry_296", "\E4... so sorry, but&I've had a really&tough year./");
ds_map_add(global.text_data_en, "obj_sosorry_297", "I don't know if I&could take you&killing me on top&of everything./");
ds_map_add(global.text_data_en, "obj_sosorry_298", "\E2You should find&someone else to&kill.&So sorry./%%");
ds_map_add(global.text_data_en, "obj_sosorry_303", "\E1?????/");
ds_map_add(global.text_data_en, "obj_sosorry_304", "\E5I just said I'm&not interested in&the offer!!/");
ds_map_add(global.text_data_en, "obj_sosorry_305", "\E5.../");
ds_map_add(global.text_data_en, "obj_sosorry_306", "\E2Sorry, I must not&have enunciated&clearly enough./");
ds_map_add(global.text_data_en, "obj_sosorry_307", "\E2I am not interested&in being killed.&Thank you very much./%%");
ds_map_add(global.text_data_en, "obj_sosorry_312", "\E5Look, stranger/");
ds_map_add(global.text_data_en, "obj_sosorry_313", "\E4I... I guess I'm&going to have to&tell the truth./");
ds_map_add(global.text_data_en, "obj_sosorry_314", "My whole life, I've&never been worth a&lot of EXP./");
ds_map_add(global.text_data_en, "obj_sosorry_315", "Everyone else at my&work, in my classes,/");
ds_map_add(global.text_data_en, "obj_sosorry_316", "Would raise a&person's LV by 4&or 5 when&destroyed.../");
ds_map_add(global.text_data_en, "obj_sosorry_317", "\E1But me?/");
ds_map_add(global.text_data_en, "obj_sosorry_318", "\E6I wouldn't even&increase your LV&at LV 1./");
ds_map_add(global.text_data_en, "obj_sosorry_319", "\E4For this reason...&I...&I've always been.../");
ds_map_add(global.text_data_en, "obj_sosorry_320", "I've never been&very good at&getting killed.&So.../");
ds_map_add(global.text_data_en, "obj_sosorry_321", "\E3I'm flattered&that you...&Want to destroy me./");
ds_map_add(global.text_data_en, "obj_sosorry_322", "\E8But you are making&a big waste of&your time!!/");
ds_map_add(global.text_data_en, "obj_sosorry_323", "\E8Stop killing me!!!/%%");
ds_map_add(global.text_data_en, "obj_sosorry_328", "\E2OK, OK. Hm./");
ds_map_add(global.text_data_en, "obj_sosorry_329", ".../");
ds_map_add(global.text_data_en, "obj_sosorry_330", "\E7If you stop killing&me, I'll pay you&200G./%%");
ds_map_add(global.text_data_en, "obj_sosorry_335", "\E8220G?/%%");
ds_map_add(global.text_data_en, "obj_sosorry_340", "\E9.../");
ds_map_add(global.text_data_en, "obj_sosorry_341", "\E8300G?/%%");
ds_map_add(global.text_data_en, "obj_sosorry_346", "\E1W..^1.&Wait a second./");
ds_map_add(global.text_data_en, "obj_sosorry_347", "\E1You trying to&kill me...&C...&could it be...?/");
ds_map_add(global.text_data_en, "obj_sosorry_348", "\E6Because you&don't like me&very much...?/");
ds_map_add(global.text_data_en, "obj_sosorry_349", "\E2No, no, that&can't be!/");
ds_map_add(global.text_data_en, "obj_sosorry_350", "This is just a&friendly, um,&killing between&acquaintances!!!/");
ds_map_add(global.text_data_en, "obj_sosorry_351", "\E8Pals... we're...&we're still pals,&right!!/");
ds_map_add(global.text_data_en, "obj_sosorry_352", "\E1OK, maybe not&PALS, but, uh,/");
ds_map_add(global.text_data_en, "obj_sosorry_353", "\E2Friendly strangers?/");
ds_map_add(global.text_data_en, "obj_sosorry_354", "\E8You know, just&one step away from&being buds!!!/");
ds_map_add(global.text_data_en, "obj_sosorry_355", "\E0I mean, I was&practically.../");
ds_map_add(global.text_data_en, "obj_sosorry_356", "\E0I was about to&crack open the&sparkling cider!/");
ds_map_add(global.text_data_en, "obj_sosorry_357", "\E2Pull out some&baguettes and some&swiss cheese!/");
ds_map_add(global.text_data_en, "obj_sosorry_358", "\E8BLOW ON A FREAKING&PARTY HORN!!!/%%");
ds_map_add(global.text_data_en, "obj_sosorry_363", "\E1N... no, you don't&like me either,&huh...?/");
ds_map_add(global.text_data_en, "obj_sosorry_364", "\E4Nobody likes me...&they're just putting&up with me/");
ds_map_add(global.text_data_en, "obj_sosorry_365", "\E6I'm just annoying&you... I should just&leave/");
ds_map_add(global.text_data_en, "obj_sosorry_366", "\E1ARRRRRGHHHH!!!&Why am I such an&idiot??!?!!!!/");
ds_map_add(global.text_data_en, "obj_sosorry_367", "How did I not&see it before!!!/");
ds_map_add(global.text_data_en, "obj_sosorry_368", "\E1You weren't killing&me because you&LIKED me!!!/");
ds_map_add(global.text_data_en, "obj_sosorry_369", "\E6NOBODY does that!/");
ds_map_add(global.text_data_en, "obj_sosorry_370", " That's NOT a thing!/%%");
ds_map_add(global.text_data_en, "obj_sosorry_376", "\E2Oh. Sorry. I was&being too loud.&Ugh./");
ds_map_add(global.text_data_en, "obj_sosorry_377", "\E4I'm wasting your&time, aren't I...?/");
ds_map_add(global.text_data_en, "obj_sosorry_378", "\E9.../");
ds_map_add(global.text_data_en, "obj_sosorry_379", "\E1... whew, I feel&really...&strange./");
ds_map_add(global.text_data_en, "obj_sosorry_380", "\E2I think I need to&go home and lie&down./%%");
ds_map_add(global.text_data_en, "obj_sosorry_392", "\E1Oh, I'm so sorry!&How clumsy of me...&I've bumped into you/");
ds_map_add(global.text_data_en, "obj_sosorry_393", "\E6I'm such a klutz./");
ds_map_add(global.text_data_en, "obj_sosorry_394", "I was just here to&find something to&draw, and.../");
ds_map_add(global.text_data_en, "obj_sosorry_395", "\E2Oh no, it's ok!&It's OK!/");
ds_map_add(global.text_data_en, "obj_sosorry_396", "\E0I'll give you a&gift to make up&for your troubles./");
ds_map_add(global.text_data_en, "obj_sosorry_397", "\E0Let me look in&my vest!/%%");
ds_map_add(global.text_data_en, "obj_sosorry_402", "\E6Ummm, I couldn't&find anything I&want to give away./");
ds_map_add(global.text_data_en, "obj_sosorry_403", "\E2Wait, wait!/");
ds_map_add(global.text_data_en, "obj_sosorry_404", "\M4I've got my notebook!/");
ds_map_add(global.text_data_en, "obj_sosorry_405", "\E0I can draw you a&picture in it!/");
ds_map_add(global.text_data_en, "obj_sosorry_406", "\E7I'm quite the artist,&you know./");
ds_map_add(global.text_data_en, "obj_sosorry_407", "\E8I'll draw you a&GREAT picture!!!/%%");
ds_map_add(global.text_data_en, "obj_sosorry_413", "\E6S.. sorry...&The drawing didn't&come out very well./");
ds_map_add(global.text_data_en, "obj_sosorry_414", "\E2Wait^1!&I know the problem!/");
ds_map_add(global.text_data_en, "obj_sosorry_415", "\M0I just have to&find a better piece&of paper for it!/%%");
ds_map_add(global.text_data_en, "obj_sosorry_420", "\E6None of my papers&are good enough to&use.../");
ds_map_add(global.text_data_en, "obj_sosorry_421", "\E2IT'S OK!!!/");
ds_map_add(global.text_data_en, "obj_sosorry_422", "\E8I know what I&can do!^1!&I'll use my magic&pencil!/");
ds_map_add(global.text_data_en, "obj_sosorry_423", "\E0It has to be under&some of these papers&somewhere!!!!/%%");
ds_map_add(global.text_data_en, "obj_sosorry_429", "\E1AHHHHH!!!/%%");
ds_map_add(global.text_data_en, "obj_sosorry_434", "\M5H\E8ere!&I got it!/");
ds_map_add(global.text_data_en, "obj_sosorry_435", "My magic pencil is&amazing!/");
ds_map_add(global.text_data_en, "obj_sosorry_436", "\E2Everything I draw&with it looks.../");
ds_map_add(global.text_data_en, "obj_sosorry_437", "\E8COMPLETELY REAL!/%%");
ds_map_add(global.text_data_en, "obj_sosorry_445", "\E1I've messed up.&I've really messed up.&Oh no./");
ds_map_add(global.text_data_en, "obj_sosorry_446", "\E2I'll just use a&regular pencil!&I'll try my best!/%%");
ds_map_add(global.text_data_en, "obj_sosorry_453", "\E8Are you ready!?/");
ds_map_add(global.text_data_en, "obj_sosorry_454", "\E0I just finished./");
ds_map_add(global.text_data_en, "obj_sosorry_455", "\M6Here's your picture!&What do you think!?/");
ds_map_add(global.text_data_en, "obj_sosorry_456", "\E2It's a representation&of your deepest&essence.../");
ds_map_add(global.text_data_en, "obj_sosorry_457", "\E7It's great^1, right!?/");
ds_map_add(global.text_data_en, "obj_sosorry_458", ".../");
ds_map_add(global.text_data_en, "obj_sosorry_459", "\E8(They think my art&is terrible.)/");
ds_map_add(global.text_data_en, "obj_sosorry_460", "\M0Well!/");
ds_map_add(global.text_data_en, "obj_sosorry_461", "\E2I'll leave you with&that thought!/");
ds_map_add(global.text_data_en, "obj_sosorry_462", "\E7Goodbye!/");
ds_map_add(global.text_data_en, "obj_sosorry_463", "\E8See you later!/");
ds_map_add(global.text_data_en, "obj_sosorry_464", "\E2Sayonara!/");
ds_map_add(global.text_data_en, "obj_sosorry_465", "\E1Nice knowing ya!/");
ds_map_add(global.text_data_en, "obj_sosorry_466", "\E7Hasta la vista./");
ds_map_add(global.text_data_en, "obj_sosorry_467", "\E9.../");
ds_map_add(global.text_data_en, "obj_sosorry_468", "\E2I should leave./%%");
ds_map_add(global.text_data_en, "obj_sosorry_785", "* The enemy looks nervous.");
ds_map_add(global.text_data_en, "obj_sosorry_786", "* The enemy looks anxious.");
ds_map_add(global.text_data_en, "obj_sosorry_787", "* The enemy taps his fingers&  together like jackhammers.");
ds_map_add(global.text_data_en, "obj_sosorry_788", "* The enemy looks perturbed.");
ds_map_add(global.text_data_en, "obj_sosorry_789", "* The enemy tries to copy your&  movements so it fits in.");
ds_map_add(global.text_data_en, "obj_sosorry_790", "* The enemy uses a hypnotizing&  3D-tush-wiggle attack.");
ds_map_add(global.text_data_en, "obj_sosorry_791", "* Smells... furry.");
ds_map_add(global.text_data_en, "obj_sosorry_792", "* Are we good here!?.");
ds_map_add(global.text_data_en, "obj_sosorry_793", "* The enemy is apologizing to&  its visions of the Reaper.");
ds_map_add(global.text_data_en, "obj_sosorry_826", "* SO SORRY&* This creature is definitely&  in the wrong time and space!/^");
ds_map_add(global.text_data_en, "obj_sosorry_838", "* You wave^1.&* They're a bit preoccupied./^");
ds_map_add(global.text_data_en, "obj_sosorry_841", "* You say hello^1.&* They're a bit preoccupied./^");
ds_map_add(global.text_data_en, "obj_sosorry_844", "* You smile^1.&* They're a bit preoccupied./^");
ds_map_add(global.text_data_en, "obj_sosorry_847", "* You cough^1.&* They're a bit preoccupied./^");
ds_map_add(global.text_data_en, "obj_sosorry_850", "* You weep^1.&* They're a bit preoccupied./^");
ds_map_add(global.text_data_en, "obj_sosorry_950", "\E0Oh^1, and.../");
ds_map_add(global.text_data_en, "obj_sosorry_951", "\E1About all this./");
ds_map_add(global.text_data_en, "obj_sosorry_952", "\E4Um./");
ds_map_add(global.text_data_en, "obj_sosorry_953", "\E2Sorry./%%");
ds_map_add(global.text_data_en, "obj_sosorry_1007", "\E1Uuuuhhhh, oh no!!&That's a little too&real!/%%");
ds_map_add(global.text_data_en, "obj_spaghetti_98", "* (It's a plate of frozen&  spaghetti.)/");
ds_map_add(global.text_data_en, "obj_spaghetti_99", "* (It's so cold^1, it's stuck&  to the table...)/%%");
ds_map_add(global.text_data_en, "obj_spaghetti_102", "* (It's a plate of lukewarm&  spaghetti.)/");
ds_map_add(global.text_data_en, "obj_spaghetti_103", "* (Seems like something tried&  eating it and just..^1.)&* (Gave up.)/%%");
ds_map_add(global.text_data_en, "obj_spagnot_98", "* It's a note from Papyrus.../");
ds_map_add(global.text_data_en, "obj_spagnot_99", "\TP %");
ds_map_add(global.text_data_en, "obj_spagnot_100", "HUMAN!^1!&PLEASE ENJOY THIS&SPAGHETTI./");
ds_map_add(global.text_data_en, "obj_spagnot_101", "(LITTLE DO YOU KNOW^1,&THIS SPAGHETTI IS&A TRAP...)/");
ds_map_add(global.text_data_en, "obj_spagnot_102", "(DESIGNED TO ENTICE&YOU!!!)/");
ds_map_add(global.text_data_en, "obj_spagnot_103", "(YOU'LL BE SO BUSY&EATING IT...)/");
ds_map_add(global.text_data_en, "obj_spagnot_104", "(THAT YOU WON'T&REALIZE THAT YOU&AREN'T PROGRESSING!!)/");
ds_map_add(global.text_data_en, "obj_spagnot_105", "(THOROUGHLY JAPED&AGAIN BY THE GREAT&PAPYRUS!!!)/");
ds_map_add(global.text_data_en, "obj_spagnot_106", " &      NYEH-HEH-HEH^1,&         PAPYRUS/%%");
ds_map_add(global.text_data_en, "obj_spagnot_110", "* It's a note from Papyrus.../");
ds_map_add(global.text_data_en, "obj_spagnot_111", "\TP %");
ds_map_add(global.text_data_en, "obj_spagnot_112", "SEEING AS THIS&SPAGHETTI IS STILL&HERE SOMEHOW.../");
ds_map_add(global.text_data_en, "obj_spagnot_113", "I HEREBY DONATE IT&TO THE PUBLIC./");
ds_map_add(global.text_data_en, "obj_spagnot_114", "IT'S LIKE A&PLAYGROUND FOR&YOUR MOUTH!/");
ds_map_add(global.text_data_en, "obj_spagnot_115", " &      NYEH-HEH-HEH^1,&         PAPYRUS/%%");
ds_map_add(global.text_data_en, "obj_spagnot_120", "* It's illegible chicken-&  scratch./%%");
ds_map_add(global.text_data_en, "obj_spagnot_124", "WHAT!^1?&THAT'S IMPOSSIBLE./%%");
ds_map_add(global.text_data_en, "obj_spagnot_127", "SORRY^1, I HAVE TO LOCK&YOU IN THE GUEST ROOM&UNTIL UNDYNE ARRIVES./");
ds_map_add(global.text_data_en, "obj_spagnot_128", "FEEL FREE TO MAKE&YOURSELF AT HOME!!!/");
ds_map_add(global.text_data_en, "obj_spagnot_129", "REFRESHMENTS AND&ACCOMODATIONS HAVE&BEEN PROVIDED./");
ds_map_add(global.text_data_en, "obj_spagnot_130", " & - NYEHFULLY YOURS^1,&        PAPYRUS/%%");
ds_map_add(global.text_data_en, "obj_spagnot_134", "PLEASE ASK BEFORE&YOU ESCAPE!!!/");
ds_map_add(global.text_data_en, "obj_spagnot_135", "WHEN YOU WENT&MISSING I GOT&WORRIED SICK!!!/");
ds_map_add(global.text_data_en, "obj_spagnot_136", "  - SLIGHTLY&  BONETROUSLED^1,&  PAPYRUS/%%");
ds_map_add(global.text_data_en, "obj_spagnot_140", "IF YOU'RE JUST&LOOKING FOR A&PLACE TO STAY.../");
ds_map_add(global.text_data_en, "obj_spagnot_141", "JUST ASK!!^1!&YOU DON'T NEED&TO FIGHT ME!!!/");
ds_map_add(global.text_data_en, "obj_spagnot_142", " & - YOUR HOST^1,&   PAPYRUS/%%");
ds_map_add(global.text_data_en, "obj_spagnot_147", "* (This note is written&  very oddly^1, as if the paper was&  moving while it was written.)/");
ds_map_add(global.text_data_en, "obj_spagnot_148", "* (It says...^1)&* (Out to lunch...?)/%%");
ds_map_add(global.text_data_en, "obj_spagnot_153", "* (Shoot the opposing ship!^1)&* (Move the boxes to complete&  your mission.)/%%");
ds_map_add(global.text_data_en, "obj_spagnot_158", "* (Shoot the opposing ship!^1)&* (You have just one shot.)/%%");
ds_map_add(global.text_data_en, "obj_spagnot_163", "* (Hey^1!)/");
ds_map_add(global.text_data_en, "obj_spagnot_164", "* (Go up the creepy alleyway&  on the right for some&  great deals!)/%%");
ds_map_add(global.text_data_en, "obj_spiderb_220", "What is it,&deary?/%%");
ds_map_add(global.text_data_en, "obj_spiderb_224", ".../%%");
ds_map_add(global.text_data_en, "obj_spiderb_225", "No, no, it's&time to go~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_226", "...&well... maybe&ONE little&nibble~~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_227", "Just kidding,&of course~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_228", "If you don't mind&being gobbled up~&Ahuhuhu~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_229", "Ahuhuhuhu~&Well, I don't&mind keeping&you here~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_230", "Feeling comfortable&trapped in that&web?/%%");
ds_map_add(global.text_data_en, "obj_spiderb_231", "It's time to go~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_232", "Ahuhuhu~&What are you&doing~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_236", "%%%");
ds_map_add(global.text_data_en, "obj_spiderb_240", "Why so pale?&You should be proud~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_245", "Proud that you're&going to make a&delicious cake~&Ahuhuhu~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_250", "Let you go^1?&Don't be silly~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_255", "Your SOUL is going&to make every spider&very happy~~~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_256", "You're scaring off&all my customers!/%%");
ds_map_add(global.text_data_en, "obj_spiderb_261", "Oh, how rude of me!&I almost forgot&to introduce you&to my pet~/");
ds_map_add(global.text_data_en, "obj_spiderb_262", "It's breakfast time,&isn't it?&Have fun, you two~ /%%");
ds_map_add(global.text_data_en, "obj_spiderb_267", "The person who warned&us about you.../%%");
ds_map_add(global.text_data_en, "obj_spiderb_272", "Offered us a LOT of&money for your SOUL./%%");
ds_map_add(global.text_data_en, "obj_spiderb_273", "Looked like a total&nerd./%%");
ds_map_add(global.text_data_en, "obj_spiderb_278", "They had such a sweet&smile~ and... ahuhu~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_279", "She was very&adamant I run away&with her~~~&Ahuhuhu~~~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_284", "It's strange, but&I swore I saw them&in the shadows...&Changing shape...?/%%");
ds_map_add(global.text_data_en, "obj_spiderb_285", "She even left a&route for me to&escape from~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_291", "Oh, it's lunch time,&isn't it?&And I forgot to&feed my pet~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_296", "With that money,&the spider clans&can finally be&reunited~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_297", "She said she would&block off the rest&of Hotland after I&followed her~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_302", "You haven't heard?&Spiders have been&trapped in the RUINS&for generations!/%%");
ds_map_add(global.text_data_en, "obj_spiderb_303", "Foolish nerd~&A spider NEVER leaves&her web~/");
ds_map_add(global.text_data_en, "obj_spiderb_304", "(Except to sell&pastries~)/%%");
ds_map_add(global.text_data_en, "obj_spiderb_309", "Even if they go&under the door,&Snowdin's fatal cold&is impassable alone./%%");
ds_map_add(global.text_data_en, "obj_spiderb_310", "Ah^1, but I do feel&a little regret&over it now.../%%");
ds_map_add(global.text_data_en, "obj_spiderb_315", "But with the money&from your SOUL, we'll&be able to rent&them a heated limo~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_316", "Yes^1, I should have&wrapped her up when&I had the chance~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_321", "And with all of&the leftovers...^1?&We could have a&nice vacation~/");
ds_map_add(global.text_data_en, "obj_spiderb_322", "Or even build a&spider baseball&field~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_323", "She looked like she&would have made a&juicy donut~~~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_328", "But enough of that...&It's time for&dinner, isn't it?&Ahuhuhu~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_336", "Don't look so&blue^1, my deary~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_599", "* Muffet pours you a cup of&  spiders.");
ds_map_add(global.text_data_en, "obj_spiderb_600", "* All the spiders clap along to&  the music.");
ds_map_add(global.text_data_en, "obj_spiderb_601", "* Muffet does a synchronized&  dance with the other spiders.");
ds_map_add(global.text_data_en, "obj_spiderb_602", "* Muffet tidies up the web&  around you.");
ds_map_add(global.text_data_en, "obj_spiderb_603", "* Smells like freshly baked&  cobwebs.");
ds_map_add(global.text_data_en, "obj_spiderb_636", "* MUFFET - ATK 38.8 DEF 18.8&* If she invites you to her&  parlor^1, excuse yourself./^");
ds_map_add(global.text_data_en, "obj_spiderb_646", "* You struggle to escape the web^1.&* Nothing happened./^");
ds_map_add(global.text_data_en, "obj_spiderb_647", "* You struggle to escape the web^1.&* Muffet covers her mouth&  and giggles at you./^");
ds_map_add(global.text_data_en, "obj_spiderb_648", "* You struggle to escape the web^1.&* Muffet laughs and claps&  her hands./^");
ds_map_add(global.text_data_en, "obj_spiderb_649", "* You struggle to escape the web./");
ds_map_add(global.text_data_en, "obj_spiderb_650", "* Muffet is so amused by your&  antics that she gives you a&  discount!/^");
ds_map_add(global.text_data_en, "obj_spiderb_656", "* You struggle to escape the web^1.&* Nothing happened./^");
ds_map_add(global.text_data_en, "obj_spiderb_678", "* You pay \[1]G^1.&* Muffet reduces her ATTACK&  for this turn!/^");
ds_map_add(global.text_data_en, "obj_spiderb_693", "* You empty your pockets^1, but you&  don't have enough money.&* Muffet lowers the price./^");
ds_map_add(global.text_data_en, "obj_spiderb_710", "* You're out of money^1.&* Muffet shakes her head./^");
ds_map_add(global.text_data_en, "obj_spiderb_714", "* You empty your pockets..^1.&* But you don't have any&  money at all!/");
ds_map_add(global.text_data_en, "obj_spiderb_715", "* Muffet takes pity on you&  and reduces her ATTACK for&  this turn./^");
ds_map_add(global.text_data_en, "obj_spiderb_722", "* Muffet refuses your money./^");
ds_map_add(global.text_data_en, "obj_spiderb_762", "... I think purple is&a better look on&you! Ahuhuhu~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_774", "* You're trapped in a strange&  purple web!");
ds_map_add(global.text_data_en, "obj_spiderb_783", "You're still alive^1?&Ahuhuhu~/");
ds_map_add(global.text_data_en, "obj_spiderb_784", "Oh, my pet~&Looks like it's&time for dessert~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_787", "Huh^1?&Where did you get&that...?/");
ds_map_add(global.text_data_en, "obj_spiderb_788", "Did you steal it?/");
ds_map_add(global.text_data_en, "obj_spiderb_789", "Oh^1, my pet^1~&It's time to show&them what we do&with thieves~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_805", "Huh?&A telegram from&the spiders in&the RUINS?/");
ds_map_add(global.text_data_en, "obj_spiderb_806", "What?&They're saying&that they saw&you, and.../");
ds_map_add(global.text_data_en, "obj_spiderb_807", "... that this is&an error message!?/");
ds_map_add(global.text_data_en, "obj_spiderb_811", "... even if you&are stingy, you&never hurt a&single spider!/");
ds_map_add(global.text_data_en, "obj_spiderb_814", "... even if you&hurt others, you&never hurt a&single spider!/");
ds_map_add(global.text_data_en, "obj_spiderb_819", "... you helped donate&to their cause!/");
ds_map_add(global.text_data_en, "obj_spiderb_823", "... you were&really passionate&about spiders!/");
ds_map_add(global.text_data_en, "obj_spiderb_827", "... you're a total&spider fanatic!/");
ds_map_add(global.text_data_en, "obj_spiderb_832", "They say even if&you are a hyper-&violent murderer.../");
ds_map_add(global.text_data_en, "obj_spiderb_833", "You never laid a&single finger on a&spider!/");
ds_map_add(global.text_data_en, "obj_spiderb_836", "Oh my, this has&all been a big&misunderstanding~/");
ds_map_add(global.text_data_en, "obj_spiderb_837", "I thought you&were someone that&hated spiders~/");
ds_map_add(global.text_data_en, "obj_spiderb_838", "The person who&asked for that SOUL.../");
ds_map_add(global.text_data_en, "obj_spiderb_839", "They must have&meant a DIFFERENT&human in a&striped shirt~/");
ds_map_add(global.text_data_en, "obj_spiderb_842", "The person who&warned me about&you.../");
ds_map_add(global.text_data_en, "obj_spiderb_843", "They really had&no idea what they&were talking about~/");
ds_map_add(global.text_data_en, "obj_spiderb_846", "Sorry for all the&trouble~&Ahuhuhu~/");
ds_map_add(global.text_data_en, "obj_spiderb_847", "I'll make it up&to you~/");
ds_map_add(global.text_data_en, "obj_spiderb_848", "You can come back&here any time...&And, for no charge&at all.../");
ds_map_add(global.text_data_en, "obj_spiderb_849", "I'll wrap you&up and let you&play with my pet&again!/");
ds_map_add(global.text_data_en, "obj_spiderb_850", "Ahuhuhuhuhuhu~&Just kidding~/");
ds_map_add(global.text_data_en, "obj_spiderb_851", "I'll SPARE you&now~/%%");
ds_map_add(global.text_data_en, "obj_spiderb_859", "* Muffet is sparing you.");
ds_map_add(global.text_data_en, "obj_spidergirl_shop_74", "* Welcome to our parlor^1, dearie^1~&* Interested in some spider&  pastries?/");
ds_map_add(global.text_data_en, "obj_spidergirl_shop_75", "* All proceeds go to real&  spiders~/%%");
ds_map_add(global.text_data_en, "obj_spidergirl_shop_76", "* Check out the webs to&  make a purchase~/%%");
ds_map_add(global.text_data_en, "obj_spidertalkevent_103", "* Ahuhuhuhu.../");
ds_map_add(global.text_data_en, "obj_spidertalkevent_104", "* Did you hear what they&  just said?/%%");
ds_map_add(global.text_data_en, "obj_spidertalkevent_106", "* Did you hear what she&  said?/%%");
ds_map_add(global.text_data_en, "obj_spidertalkevent_114", "* They said a human wearing a&  striped shirt will come&  through./%%");
ds_map_add(global.text_data_en, "obj_spidertalkevent_122", "* I heard that they hate&  spiders./%%");
ds_map_add(global.text_data_en, "obj_spidertalkevent_130", "* I heard that they love to&  stomp on them./%%");
ds_map_add(global.text_data_en, "obj_spidertalkevent_132", "* I heard that they hate&  everybody./%%");
ds_map_add(global.text_data_en, "obj_spidertalkevent_140", "* I heard that they like to&  tear their legs off./%%");
ds_map_add(global.text_data_en, "obj_spidertalkevent_149", "* I heard.../%%");
ds_map_add(global.text_data_en, "obj_spidertalkevent_152", "* However.../%%");
ds_map_add(global.text_data_en, "obj_spidertalkevent_154", "* And even if they gave us&  money^1, I heard.../%%");
ds_map_add(global.text_data_en, "obj_spidertalkevent_267", "* ... that they're awfully&  stingy with their money./");
ds_map_add(global.text_data_en, "obj_spidertalkevent_271", "* ... a certain stingy human&  hates spiders./%%");
ds_map_add(global.text_data_en, "obj_spidertalkevent_273", "* Ahuhuhuhu.../");
ds_map_add(global.text_data_en, "obj_spidertalkevent_274", "* You think your taste&  is too refined for our&  pastries^1, don't you^1, deary?/");
ds_map_add(global.text_data_en, "obj_spidertalkevent_275", "* Ahuhuhu..^1.&* I disagree with that&  notion./");
ds_map_add(global.text_data_en, "obj_spidertalkevent_276", "* I think your taste.../");
ds_map_add(global.text_data_en, "obj_spidertalkevent_277", "* Is exactly what this&  next batch needs!/%%");
ds_map_add(global.text_data_en, "obj_spidertalkevent_283", "* ... that can't be true^1,&  can it?/");
ds_map_add(global.text_data_en, "obj_spidertalkevent_284", "* Ahuhuhu.../");
ds_map_add(global.text_data_en, "obj_spidertalkevent_285", "* You donated so much money&  to us./");
ds_map_add(global.text_data_en, "obj_spidertalkevent_286", "* All the spiders want you&  to know how thankful&  they are!/");
ds_map_add(global.text_data_en, "obj_spidertalkevent_287", "* We're in your debt^1, dearie~/%%");
ds_map_add(global.text_data_en, "obj_spidertalkevent_293", "* ... that they have some awful&  taste./");
ds_map_add(global.text_data_en, "obj_spidertalkevent_294", "* What a shame^1.&* A human comes through and they&  aren't even fit to be eaten~/");
ds_map_add(global.text_data_en, "obj_spidertalkevent_295", "* Oh well^1!&* Rotten ingredients can&  always be discarded~/%%");
ds_map_add(global.text_data_en, "obj_spidertalkevent_392", "* Ahuhuhuhu.../");
ds_map_add(global.text_data_en, "obj_spidertalkevent_393", "* That was fun^1!&* See you again^1, dearie!/%%");
ds_map_add(global.text_data_en, "obj_stick_95", "* (It's a tough-looking branch.)&* (It's too heavy to pick up.)/%%");
ds_map_add(global.text_data_en, "obj_stick_99", "* (It's been smashed like it&  was nothing...)/%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_295", "A long time ago,&a human fell&into the RUINS./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_307", "Injured by its&fall, the human&called out for&help./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_333", "ASRIEL^1, the king's&son^1, heard the&human's call./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_345", "He brought the&human back to&the castle./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_370", "Over time^1, ASRIEL&and the human&became like&siblings./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_383", "The King and&Queen treated the&human child as&their own./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_395", "The underground&was full of&hope./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_421", "Then..^1.&One day.../*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_433", "The human became&very ill./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_459", "The sick human&had only one&request./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_472", "To see the&flowers from&their village./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_484", "But there was&nothing we could&do./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_511", "The next day./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_523", "The next day./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_546", ".../*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_558", "The human died./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_583", "ASRIEL^1, wracked&with grief^1,&absorbed the&human's SOUL./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_594", "He transformed&into a being&with incredible&power./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_609", "With the human&SOUL^1, ASRIEL&crossed through&the barrier./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_622", "He carried the&human's body&into the sunset./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_634", "Back to the&village of the&humans./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_649", "ASRIEL reached&the center of&the village./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_662", "There^1, he&found a bed of&golden flowers./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_674", "He carried&the human&onto it./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_689", "Suddenly^1, screams&rang out./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_702", "The villagers&saw ASRIEL&holding the&human's body./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_714", "They thought&that he had&killed the&child./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_727", "The humans&attacked him&with everything&they had./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_740", "He was struck&with blow after&blow./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_752", "ASRIEL had the&power to destroy&them all./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_767", "But.../*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_778", "ASRIEL did not&fight back./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_805", "Clutching the&human.../*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_816", "ASRIEL smiled^1,&and walked away./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_832", "Wounded^1, ASRIEL&stumbled home./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_845", "He entered the&castle and&collapsed./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_857", "His dust spread&across the&garden./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_872", "The kingdom fell&into despair./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_885", "The king and&queen had lost&two children&in one night./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_897", "The humans had&once again taken&everything&from us./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_911", "The king decided&it was time to&end our&suffering./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_924", "Every human who&falls down here&must die./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_936", "With enough souls^1,&we can shatter&the barrier&forever./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_951", "It's not long&now./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_965", "King ASGORE&will let us&go.   /*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_971", "King ASGORE&will give us&hope./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_976", "King ASGORE&will save us&all. /%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1004", "You should be&smiling^1, too./*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1014", "Aren't&you&excited?/*");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1023", "Aren't&you&happy?/%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1047", "You're going&to be free./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1073", "\E0Howdy^1, \[C]!/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1074", "You finally made&it home./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1075", "\E0Remember when we&used to play here?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1076", "\E0Hee hee hee.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1077", "Boy!/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1078", "\E9Today's gonna be&just as fun./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1093", "\E1I remember when I&first woke up here^1,&in the garden./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1094", "I was so scared./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1095", "\E2I couldn't feel my&arms or my legs.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1096", "\E1My entire body had&turned into a&flower!/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1097", "\E5\"Mom^1! Dad^1!&Somebody help me^1!\"&I called out./");ds_map_add(global.text_data_en, "obj_storybattle_gen_1098", "\E9But nobody came./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1107", "\E1Eventually^1, the king&found me^1, crying in&the garden./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1108", "I explained what had&happened to him./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1109", "Then he held me^1,&\[C]./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1110", "He held me with&tears in his eyes^1,&saying.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1111", "\"There^1, there^1.&Everything is going&to be alright.\"/");ds_map_add(global.text_data_en, "obj_storybattle_gen_1112", "He was so..^1.&Emotional./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1113", "\E1But..^1.&For some reason.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1114", "\E1I didn't feel&anything at all./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1123", "\E1I soon realized I&didn't feel ANYTHING&about ANYONE./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1124", "My compassion had&disappeared!/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1125", "\E7And believe me^1,&it's not like I&wasn't trying./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1126", "\E3I wasted weeks with&that stupid king^1,&vainly hoping I would&feel something./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1127", "\E1But it became too&much for me./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1128", "I ran away from&home./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1129", "Eventually^1, I reached&the RUINS./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1130", "\E0Inside I found HER^1,&\[C]./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1131", "I thought of all&people^1, SHE could&make me feel whole&again./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1132", "\E1.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1133", "\E7She failed./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1134", "\E6Ha ha.../%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1144", "\E1I realized those two&were useless./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1145", "I became despondent./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1146", "I just wanted to&love someone./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1147", "I just wanted to&care about someone./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1148", "\[C]^1, you might&not believe this.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1149", "\E2But I decided..^1.&It wasn't worth&living anymore./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1150", "\E7Not in a world&without love./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1151", "\E6Not in a world&without you./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1152", "\E1So.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1153", "\E0I decided to follow&in your footsteps./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1154", "\E1I would erase myself&from existence./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1155", "\E1And you know what?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1156", "\E0I succeeded./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1165", "\E1But as I left this&mortal coil.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1166", "I started to feel&apprehensive./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1167", "\E9If you don't have&a SOUL^1, what happens&when you...?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1168", "\E1Something primal&started to burn&inside me./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1169", "\"No^1,\" I thought^1.&\"I don't want to&die!\"/");ds_map_add(global.text_data_en, "obj_storybattle_gen_1170", ".../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1171", "Then I woke up./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1172", "Like it was all&just a bad dream./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1173", "I was back at the&garden./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1174", "\E0Back at my&\"save point.\"/%%");ds_map_add(global.text_data_en, "obj_storybattle_gen_1183", "Interested^1, I decided&to experiment./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1184", "Again and again^1, I&brought myself to&the edge of death./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1185", "At any point^1, I&could have let this&world continue on&without me./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1186", "But as long as I&was determined to&live.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1187", "\E0I could go back./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1188", "\E6Amazing^1, isn't it^1,&\[C]?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1189", "\E0I was amazed^1, too./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1197", "\E1At first^1, I used my&powers for good./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1198", "\E0I became \"friends\"&with everyone./");ds_map_add(global.text_data_en, "obj_storybattle_gen_1199", "I solved all their&problems flawlessly./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1200", "Their companionship&was amusing.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1201", "\E1For a while. /");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1202", "\E1As time repeated^1,&people proved&themselves&predictable./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1203", "What would this&person say if I&gave them this?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1204", "What would they do&if I said this to&them?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1205", "Once you know the&answer^1, that's it./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1206", "That's all they are./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1217", "\E1It all started&because I was&curious./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1218", "\E0Curious what would&happen if I killed&them./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1219", "\E2\"I don't like this^1,\"&I told myself./");ds_map_add(global.text_data_en, "obj_storybattle_gen_1220", "\E1\"I'm just doing this&because I HAVE to&know what happens./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1221", "\E8Ha ha ha..^1.&What an excuse!/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1222", "\E9You of all people&must know how&liberating it is to&act this way./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1223", "\E8At least we're better&than those sickos&that stand around and&WATCH it happen.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1224", "\E9Those pathetic people&that want to see it^1,&but are too weak to&do it themselves./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1225", "\E0I bet someone like&that's watching right&now^1, aren't they...?/%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1235", "\E1Nowadays^1, even that's&grown tiring./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1236", "\E7You understand^1,&\[C]./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1237", "\E6I've done everything&this world has to&offer./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1238", "\E1I've read every book^1.&I've burned every&book./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1239", "I've won every game^1.&I've lost every game./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1240", "I've appeased&everyone^1.&I've killed everyone./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1241", "Sets of numbers..^1.&Lines of dialogue..^1.&I've seen them all./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1242", "\E1But you..^1.&YOU'RE different./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1243", "\E0I never could&predict YOU^1, \[C]./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1252", "\E1When I saw you in&the RUINS^1, I didn't&recognize you./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1253", "\E8I thought I could&frighten you^1, then&steal your SOUL./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1254", "\E1I failed./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1255", "\E0And when I tried&to load my save&file.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1256", "\E1It didn't work./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1257", "\E9\[C]..^1.&Your DETERMINATION!/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1258", "\E8Somehow^1, it's even&greater than mine!/%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1267", "\E1I just have one&question for you^1,&\[C]./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1268", "How did you get&back to the RUINS&from here...?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1269", "\E0... wait^1, I know./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1270", "She must have taken&you when she left./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1271", "\E1And decided to give&you a proper burial^1,&rather than.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1272", "\E0Hanging out in the&basement forever./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1273", "\E1... but^1, why then...?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1274", "What made you wake&up?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1275", "\E6Did you hear me&calling you...?/%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1286", "\E1It doesn't matter&now./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1287", "\E1I'm so tired of&this^1, \[C]./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1288", "I'm tired of all&these people./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1289", "I'm tired of all&these places./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1290", "I'm tired of being&a flower./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1291", "\[C]./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1292", "\E0There's just one&thing left I want&to do./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1293", "Let's finish what we&started./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1294", "Let's free everyone./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1295", "\E8Then..^1. let's let&them see what&humanity is&REALLY like!/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1296", "\E6That despite it all.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1297", "\E9This world is still&\"kill or be killed!!\"/%%");ds_map_add(global.text_data_en, "obj_storybattle_gen_1307", "\E1Then...?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1308", "\E7Well^1.&I had.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1309", "\E9Been entertaining a&few ways to use&that power./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1310", "\E8Hee hee hee.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1311", "\E1.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1312", "\E1But seeing you here&changed my mind./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1313", "\E6\[C]..^1.&I think if you're&around.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1314", "\E7Just living in the&surface world&doesn't seem so bad./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1324", "\E0We don't even need&to leave to get&them this time./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1325", "The king has six of&them locked away./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1326", "\E1I've tried hundreds&of ways to get him&to show me them.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1327", "\E3But he just won't./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1328", "\E1\[C].../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1329", "\E0I know he'll do it&for YOU./%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1339", "\E0Why am I telling&you all of this?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1340", "\E6\[C]^1, I said it&before./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1341", "\E1Even after all this&time.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1342", "\E0You're still the&only one that&understands me./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1343", "\E8You won't give me&any worthless pity!/%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1353", "\E9Creatures like us.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1354", "\E0Wouldn't hesitate to&KILL each other if&we got in each&other's way./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1355", "\E0So that's.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1356", "\E1So..^1. that's..^1.&Why.../%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1383", "\E2.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1384", "\E2... ha..^1.&Ha.../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1385", "\E6... what's this..^1.&... feeling?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1386", "Why am I..^1.&Shaking?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1387", ".../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1388", "Hey..^1. \[C]..^1.&No hard feelings about&back then^1, right?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1389", ".../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1390", "\E4H-Hey^1, what are you&doing!?/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1391", "B..^1. back off!!/%%");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1412", "I..^1. I've changed&my mind about all&this./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1413", "This isn't a good&idea anymore./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1414", "Y-you should go back^1,&\[C]./");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1415", "\E0This place is fine&the way it is!/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1416", ".../");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1417", "\E4S-s-stop making that&creepy face!/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1418", "This isn't funny!/");
ds_map_add(global.text_data_en, "obj_storybattle_gen_1419", "You've got a SICK&sense of humor!/%%");
ds_map_add(global.text_data_en, "obj_switch_100", "* (The machine isn't working.)/%%");
ds_map_add(global.text_data_en, "obj_switchadvice1_61", "* Please press this switch.& &            - TORIEL/%%");
ds_map_add(global.text_data_en, "obj_switchadvice2_61", "* Please press this switch&  too.&             - TORIEL/%%");
ds_map_add(global.text_data_en, "obj_switchhelptrigger_69", "* (You noticed there was&  a blue switch behind the&  top pillar.)/%%");
ds_map_add(global.text_data_en, "obj_telescope_71", "* Come on! What are you doing!/%%");
ds_map_add(global.text_data_en, "obj_telescope_75", "* (It's an odd-looking&  telescope.)/%%");
ds_map_add(global.text_data_en, "obj_tembattle_282", "awwAwa&cute!!&(pets u)");
ds_map_add(global.text_data_en, "obj_tembattle_283", "OMG!!&humans&TOO CUTE&(dies)");
ds_map_add(global.text_data_en, "obj_tembattle_284", "hOI!!!&i'm&TEMMIE!!");
ds_map_add(global.text_data_en, "obj_tembattle_285", "fhsdhjf&dsfjsd&dshjfsd");
ds_map_add(global.text_data_en, "obj_tembattle_288", "NO!!!!!&muscles&......&NOT CUTE");
ds_map_add(global.text_data_en, "obj_tembattle_292", "NO!!!&so&hungr...&(dies)");
ds_map_add(global.text_data_en, "obj_tembattle_298", "hOI!!!&i'm&tEMMIE!!");
ds_map_add(global.text_data_en, "obj_tembattle_302", "FOOB!!!");
ds_map_add(global.text_data_en, "obj_tembattle_307", "%%%");
ds_map_add(global.text_data_en, "obj_tembattle_504", "* Temmie is trying to glomp&  you.");
ds_map_add(global.text_data_en, "obj_tembattle_505", "* Temmie forgot her other&  attack.");
ds_map_add(global.text_data_en, "obj_tembattle_506", "* Temmie vibrates intensely.");
ds_map_add(global.text_data_en, "obj_tembattle_507", "* Temmie is doing her hairs.");
ds_map_add(global.text_data_en, "obj_tembattle_508", "* Temmiy accidentally misspells&  her own name.");
ds_map_add(global.text_data_en, "obj_tembattle_509", "* Smells like Temmie Flakes.");
ds_map_add(global.text_data_en, "obj_tembattle_511", "* How'd you do that?");
ds_map_add(global.text_data_en, "obj_tembattle_527", "* TEMMIE - RATED TEM OUTTA TEM&* Loves to pet cute humans^1.&* But you're allergic!/^");
ds_map_add(global.text_data_en, "obj_tembattle_539", "* Temmie only wants the&  Temmie Flakes./^");
ds_map_add(global.text_data_en, "obj_tembattle_550", "   Give the Temmie Flakes?& &   Yas             NO!!!!!!!\C");
ds_map_add(global.text_data_en, "obj_tembattle_561", "* You flex at Temmie.../%%");
ds_map_add(global.text_data_en, "obj_tembattle_573", "* You say hello to Temmie./^");
ds_map_add(global.text_data_en, "obj_tembattle_617", "NO!!!!!&muscles&r.....&NOT CUTE/%%");
ds_map_add(global.text_data_en, "obj_tembattle_621", "%%%");
ds_map_add(global.text_data_en, "obj_tembattle_635", "Ooh, I&have to&disagree&; )/%%");
ds_map_add(global.text_data_en, "obj_tembattle_636", "Temmie^1,&are you&okay?&; )/%%");
ds_map_add(global.text_data_en, "obj_tembattle_637", "%%%");
ds_map_add(global.text_data_en, "obj_tembattle_652", "NO!!!!!&!!!!!!!/%%");
ds_map_add(global.text_data_en, "obj_tembattle_653", "%%%");
ds_map_add(global.text_data_en, "obj_temnpc_72", "* hOI!^1!&* im temmie!!!/");
ds_map_add(global.text_data_en, "obj_temnpc_73", "* and dis is my friend..^1.&* temmie!!!/%%");
ds_map_add(global.text_data_en, "obj_temnpc_77", "* woa..^1. tem hear news..^1.&* VERY GOODS!!!/%%");
ds_map_add(global.text_data_en, "obj_temnpc_82", "* hOI!^1!&* im temmie!!!/");
ds_map_add(global.text_data_en, "obj_temnpc_83", "* don forget my friend!/%%");
ds_map_add(global.text_data_en, "obj_temnpc_87", "* yaYA!!^1!&* tems can go free!!/%%");
ds_map_add(global.text_data_en, "obj_temnpc_93", "* Hi./");
ds_map_add(global.text_data_en, "obj_temnpc_94", "* I'm Bob./%%");
ds_map_add(global.text_data_en, "obj_temnpc_98", "* A pleasing development^1, no?/%%");
ds_map_add(global.text_data_en, "obj_temnpc_103", "* awawawawah!!/");
ds_map_add(global.text_data_en, "obj_temnpc_104", "* humans..^1.&* such a.../");
ds_map_add(global.text_data_en, "obj_temnpc_105", "* CUTE!!!!/%%");
ds_map_add(global.text_data_en, "obj_temnpc_109", "* woa..^1.&* if tems can go on surface^1,&  can see,/");
ds_map_add(global.text_data_en, "obj_temnpc_110", "* LOT OF CUTES HUNAN!!!/%%");
ds_map_add(global.text_data_en, "obj_temnpc_116", "* tem..^1. WATCH EGG!!!/");
ds_map_add(global.text_data_en, "obj_temnpc_117", "* eg..^1. wil HATCH!!!/");
ds_map_add(global.text_data_en, "obj_temnpc_118", "* tem..^1. PROUD PARENT!!/%%");
ds_map_add(global.text_data_en, "obj_temnpc_122", "* everyones go free..^1.&* BUT TEM!!!/");
ds_map_add(global.text_data_en, "obj_temnpc_123", "* TEM NOT LEAV!!!&* TEM WATCH EG!!!/");
ds_map_add(global.text_data_en, "obj_temnpc_124", "* tem will be happily fambily,/%%");
ds_map_add(global.text_data_en, "obj_tobdog_pendant_137", "* (The dog absorbs the&  artifact.)/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_153", "And that's the&end of Hard&Mode!/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_175", "\E1Eh??/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_176", "\E2You are ending&it NOW?/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_177", "\E1And on such a&dramatic moment...?/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_192", "That's the&difficult part./");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_193", "Not the bullets./");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_194", "\M2But^1, accepting&that it's all&over.../%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_211", "But there WILL be&more^1, will there&not?/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_224", "\M1Maybe./");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_225", "\M2Knowing the&answer is.../");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_226", "\M2... HARD./");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_227", "\E4.../%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_264", "Hey!/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_265", "Aren't you&supposed&to be dying or&something?/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_280", "Well^1.&What is the point&of that now?/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_293", "What will you do&instead...?/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_308", "Hmmm^1.&Perhaps I will&bake another pie./");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_309", "That last one ended&up a little burnt./%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_324", "\E2I thought it was&good./");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_325", "\E1Theoretically./");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_326", "\E4It's not like I&ate it all while&you were&fighting./%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_360", "Hey^1! Hey^1!&Can I have some&pie!/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_377", "You are just going&to eat it all.../%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_400", "I can helllp!!!/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_415", "Snoring on the&floor is NOT help./%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_429", "I'm not snoring^1,&I'm cheering you&on in my sleep!!/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_430", ".../");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_431", "Oh^1, you're still&here?/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_432", "Don't you have&anything better&to do?/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_512", "\E0Hey./");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_513", "\E3What's the hold&up!?/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_514", "\E9Shouldn't she be&dead by now!?/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_515", "\E1I've been waiting&in that room for.../");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_516", "\E6.../");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_517", "\E7... Hard mode...?/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_518", "\E0Gee^1, you better&take a picture./");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_519", "People are gonna&think you're REALLY&cool./");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_520", "\E9... NOT!/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_521", "\E8Golly^1, talk about&a tryhard./");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_522", "PA^1. THE^1. TIC./%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_544", "\E0Uh^1, so^1, are you&gonna keep going^1,&or...?/%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_558", "It's over./%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_578", "\E8Hahaha^1!&I KNEW that!/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_579", "Why does everyone&have to be so&condescending!?/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_580", "\E1.../");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_581", "\E8So what's YOUR&excuse^1?&Sitting around&here...?/");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_582", "\E0Don't you have&anything better to%%");
ds_map_add(global.text_data_en, "obj_torboss_2ndtime_595", "I already said&that./%%");
ds_map_add(global.text_data_en, "obj_tordogcall_64", "* Ring..\E0.\TT /");
ds_map_add(global.text_data_en, "obj_tordogcall_65", "\F1 %");
ds_map_add(global.text_data_en, "obj_tordogcall_66", "* Hello^1!&* This is TORIEL./");
ds_map_add(global.text_data_en, "obj_tordogcall_67", "\E1* My errands are taking&  longer than I thought&  they would./");
ds_map_add(global.text_data_en, "obj_tordogcall_68", "\E1* You must wait 5 more&  minutes./");
ds_map_add(global.text_data_en, "obj_tordogcall_69", "\E0* Thank you for being&  patient./");
ds_map_add(global.text_data_en, "obj_tordogcall_70", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_tordogcall_71", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_tordogcall_84", "* Ring..\E1.\TT /");
ds_map_add(global.text_data_en, "obj_tordogcall_85", "\F1 %");
ds_map_add(global.text_data_en, "obj_tordogcall_86", "* Hello..^1.&* This is TORIEL./");
ds_map_add(global.text_data_en, "obj_tordogcall_87", "\E1* I found what I was&  looking for./");
ds_map_add(global.text_data_en, "obj_tordogcall_88", "* But before I could&  take it.../");
ds_map_add(global.text_data_en, "obj_tordogcall_89", "* A small^1, white puppy&  snatched it away./");
ds_map_add(global.text_data_en, "obj_tordogcall_90", "\E0* How odd./");
ds_map_add(global.text_data_en, "obj_tordogcall_91", "\E1* Do dogs even LIKE&  flour?/");
ds_map_add(global.text_data_en, "obj_tordogcall_92", "\E8* Err^1, that is an&  unrelated question^1,&  of course./");
ds_map_add(global.text_data_en, "obj_tordogcall_93", "\E1* It will take a little&  longer^1.&* Please understand./");
ds_map_add(global.text_data_en, "obj_tordogcall_94", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_tordogcall_95", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_tordogcall_109", "* Ring.../");
ds_map_add(global.text_data_en, "obj_tordogcall_110", "* (...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_111", "* (You hear heavy panting on&  the other end of the&  phone...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_112", "* (...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_113", "* Bark^1!&* Bark!/");
ds_map_add(global.text_data_en, "obj_tordogcall_114", "* Bark..^1.&* Bark!/");
ds_map_add(global.text_data_en, "obj_tordogcall_115", "* (You hear a distant voice.)\TT/");
ds_map_add(global.text_data_en, "obj_tordogcall_116", "* Stop^1, please!/");
ds_map_add(global.text_data_en, "obj_tordogcall_117", "* Come back here with my&  CELLPHONE!/");
ds_map_add(global.text_data_en, "obj_tordogcall_118", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_tordogcall_119", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_tordogcall_150", "* Ring.../");
ds_map_add(global.text_data_en, "obj_tordogcall_151", "* (...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_152", "* (Snore..^1. snore...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_153", "* (It sounds like a small^1,&  white dog is sleeping on&  the cell phone.)/");
ds_map_add(global.text_data_en, "obj_tordogcall_154", "* (You hear a distant voice.)\TT/");
ds_map_add(global.text_data_en, "obj_tordogcall_155", "* Helloooo^1?&* Little puppy...?/");
ds_map_add(global.text_data_en, "obj_tordogcall_156", "* Where are you...?/");
ds_map_add(global.text_data_en, "obj_tordogcall_157", "* I will give you a nice pat&  on the head!\T0/");
ds_map_add(global.text_data_en, "obj_tordogcall_158", "* (The snoring stops.)\TT/");
ds_map_add(global.text_data_en, "obj_tordogcall_159", "* ... if you return my CELLPHONE.\T0/");
ds_map_add(global.text_data_en, "obj_tordogcall_160", "* (The snoring resumes.)/");
ds_map_add(global.text_data_en, "obj_tordogcall_161", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_tordogcall_162", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_tordogcall_176", "* Ring.../");
ds_map_add(global.text_data_en, "obj_tordogcall_177", "* (...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_178", "* (Snore..^1. snore...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_179", "* (Achoo!)/");
ds_map_add(global.text_data_en, "obj_tordogcall_180", "* (It sounds like a small^1,&  white dog sneezing in its&  sleep.)/");
ds_map_add(global.text_data_en, "obj_tordogcall_181", "* (You hear a distant voice.)\TT/");
ds_map_add(global.text_data_en, "obj_tordogcall_182", "* Here^1, pup-pup-puppy!/");
ds_map_add(global.text_data_en, "obj_tordogcall_183", "* Oh dear^1, I should not keep&  my guest waiting any longer./");
ds_map_add(global.text_data_en, "obj_tordogcall_184", "* ... Oh no^1, how long has it&  been since I have talked to&  them...?/");
ds_map_add(global.text_data_en, "obj_tordogcall_185", "* Perhaps they have been calling&  the phone^1, and...?/");
ds_map_add(global.text_data_en, "obj_tordogcall_186", "* ... here^1, puppy!/");
ds_map_add(global.text_data_en, "obj_tordogcall_187", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_tordogcall_188", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_tordogcall_203", "* Ring.../");
ds_map_add(global.text_data_en, "obj_tordogcall_204", "* (...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_205", "* (Snore..^1. snore...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_206", "* (Yawn...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_207", "* (Blink blink.)/");
ds_map_add(global.text_data_en, "obj_tordogcall_208", "* (Yawn...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_209", "* (Snore..^1. snore...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_210", "* (You hear a tired voice.)\TT/");
ds_map_add(global.text_data_en, "obj_tordogcall_211", "* Doggie..^1.&* Here^1, doggie.../");
ds_map_add(global.text_data_en, "obj_tordogcall_212", "* Oh dear.../");
ds_map_add(global.text_data_en, "obj_tordogcall_213", "* I do wonder how they are.../");
ds_map_add(global.text_data_en, "obj_tordogcall_214", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_tordogcall_215", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_tordogcall_230", "* Ring.../");
ds_map_add(global.text_data_en, "obj_tordogcall_231", "* (Snore..^1. snore...)/");
ds_map_add(global.text_data_en, "obj_tordogcall_232", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_tordogcall_233", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_toriel_friendc_70", "* Hello^1, Frisk^1.&* Alphys upgraded my&  phone./");
ds_map_add(global.text_data_en, "obj_toriel_friendc_71", "* I am having a lot&  of fun with the&  \"texting\" feature./");ds_map_add(global.text_data_en, "obj_toriel_friendc_72", "* Sans^1, \"check out\" this&  one./");ds_map_add(global.text_data_en, "obj_toriel_friendc_74", "* oh man^1, tori.../");
ds_map_add(global.text_data_en, "obj_toriel_friendc_75", "\E1* that's brutal./");
ds_map_add(global.text_data_en, "obj_toriel_friendc_77", "I CAN'T BELIEVE&THE QUEEN HAS&RETURNED.../");
ds_map_add(global.text_data_en, "obj_toriel_friendc_78", "\E4AND ALSO THAT&SHE'S A HUGE&DORK!!!/");
ds_map_add(global.text_data_en, "obj_toriel_friendc_79", "YOU TWO ARE TWO&FEET AWAY FROM&EACH OTHER!!!/");
ds_map_add(global.text_data_en, "obj_toriel_friendc_80", "WHY ARE YOU&TEXTING!!!/");
ds_map_add(global.text_data_en, "obj_toriel_friendc_82", "* Worry not^1, Papyrus^1.&* We are texting for&  a good reason./");
ds_map_add(global.text_data_en, "obj_toriel_friendc_84", "WHY IS THAT./");
ds_map_add(global.text_data_en, "obj_toriel_friendc_86", "* well./");
ds_map_add(global.text_data_en, "obj_toriel_friendc_87", "\E2* cause we're huge&  dorks./");
ds_map_add(global.text_data_en, "obj_toriel_friendc_89", "* Sans^1, please do&  not say that./");
ds_map_add(global.text_data_en, "obj_toriel_friendc_90", "* You are not a dork./");
ds_map_add(global.text_data_en, "obj_toriel_friendc_91", "\E0* You are more of&  a bonehead!/");
ds_map_add(global.text_data_en, "obj_toriel_friendc_93", "HAHAHA^1, WOW!/");
ds_map_add(global.text_data_en, "obj_toriel_friendc_94", "\E0THOSE PUNS ARE&EVEN LESS FUNNY&COMING FROM HER!/");
ds_map_add(global.text_data_en, "obj_toriel_friendc_96", "* then why are you&  smiling?/");
ds_map_add(global.text_data_en, "obj_toriel_friendc_98", "IT'S A PITY&SMILE!!!/%%");
ds_map_add(global.text_data_en, "obj_toriel_friendc_103", "* Frisk^1, do not feel&  left out./");
ds_map_add(global.text_data_en, "obj_toriel_friendc_104", "* I have been writing&  messages to you as&  well!/");
ds_map_add(global.text_data_en, "obj_toriel_friendc_105", "\W* You still have \Ymy&  phone number\W after&  all this time.../");
ds_map_add(global.text_data_en, "obj_toriel_friendc_106", "* Do you not?/%%");
ds_map_add(global.text_data_en, "obj_toriel_friendc_111", "* Frisk^1, how about&  you go look around&  before we all go?/");
ds_map_add(global.text_data_en, "obj_toriel_friendc_112", "* Seeing how many good&  friends you've made&  here.../");
ds_map_add(global.text_data_en, "obj_toriel_friendc_113", "* I am almost certain&  you must have made&  some more./%%");
ds_map_add(global.text_data_en, "obj_torielboss_366", " .....");
ds_map_add(global.text_data_en, "obj_torielboss_367", " .....& .....");
ds_map_add(global.text_data_en, "obj_torielboss_368", " .....& .....& .....");
ds_map_add(global.text_data_en, "obj_torielboss_369", " ...?");
ds_map_add(global.text_data_en, "obj_torielboss_370", " What are& you& doing?");
ds_map_add(global.text_data_en, "obj_torielboss_371", " Attack& or run& away!");
ds_map_add(global.text_data_en, "obj_torielboss_372", " What are& you& proving& this way?");
ds_map_add(global.text_data_en, "obj_torielboss_373", " Fight me& or& leave!");
ds_map_add(global.text_data_en, "obj_torielboss_374", " Stop it.");
ds_map_add(global.text_data_en, "obj_torielboss_376", " Stop& looking& at me& that way.");
ds_map_add(global.text_data_en, "obj_torielboss_377", " Go away!");
ds_map_add(global.text_data_en, "obj_torielboss_378", " ...");
ds_map_add(global.text_data_en, "obj_torielboss_380", " ...& ...");
ds_map_add(global.text_data_en, "obj_torielboss_388", "I know you want&to go home^1, but...");
ds_map_add(global.text_data_en, "obj_torielboss_390", "But please... go&upstairs now.");
ds_map_add(global.text_data_en, "obj_torielboss_391", "I promise I will&take good care&of you here.");
ds_map_add(global.text_data_en, "obj_torielboss_392", "I know we do not&have much^1, but...");
ds_map_add(global.text_data_en, "obj_torielboss_393", "We can have a&good life here.");
ds_map_add(global.text_data_en, "obj_torielboss_395", "Why are you&making this so&difficult?");
ds_map_add(global.text_data_en, "obj_torielboss_397", "Please^1, go upstairs.");
ds_map_add(global.text_data_en, "obj_torielboss_399", ".....");
ds_map_add(global.text_data_en, "obj_torielboss_401", "Ha ha...");
ds_map_add(global.text_data_en, "obj_torielboss_402", "Pathetic^1, is it not^2?&I cannot save even&a single child.");
ds_map_add(global.text_data_en, "obj_torielboss_403", "...");
ds_map_add(global.text_data_en, "obj_torielboss_416", "No^1, I understand./");
ds_map_add(global.text_data_en, "obj_torielboss_417", "You would just be&unhappy trapped&down here./");
ds_map_add(global.text_data_en, "obj_torielboss_418", "The RUINS are very&small once you&get used to them./");
ds_map_add(global.text_data_en, "obj_torielboss_419", "It would not be&right for you to&grow up in a&place like this./");
ds_map_add(global.text_data_en, "obj_torielboss_420", "My expectations...&My loneliness...&My fear.../");
ds_map_add(global.text_data_en, "obj_torielboss_421", "For you^1, my child...&I will put them aside./%%");
ds_map_add(global.text_data_en, "obj_torielboss_445", "\E0Urgh.../");
ds_map_add(global.text_data_en, "obj_torielboss_446", "\E0You are stronger&than I thought.../");
ds_map_add(global.text_data_en, "obj_torielboss_447", "Listen to me^1,& small one.../");
ds_map_add(global.text_data_en, "obj_torielboss_448", "If you go beyond&this door,/");
ds_map_add(global.text_data_en, "obj_torielboss_449", "Keep walking as&far as you can./");
ds_map_add(global.text_data_en, "obj_torielboss_450", "Eventually you will&reach an exit./");
ds_map_add(global.text_data_en, "obj_torielboss_451", "\E1..^1.&..../");
ds_map_add(global.text_data_en, "obj_torielboss_452", "\RASGORE\X..^1.&Do not let \RASGORE\X &take your soul./");
ds_map_add(global.text_data_en, "obj_torielboss_453", "His plan&cannot be allowed&to succeed./");
ds_map_add(global.text_data_en, "obj_torielboss_454", "\E2....../");
ds_map_add(global.text_data_en, "obj_torielboss_455", "Be good^1,&won't you?/");
ds_map_add(global.text_data_en, "obj_torielboss_456", "\E3My child.      %%");
ds_map_add(global.text_data_en, "obj_torielboss_460", "Y... you...&really hate me&that much?/");
ds_map_add(global.text_data_en, "obj_torielboss_461", "Now I see who I&was protecting by&keeping you here./");
ds_map_add(global.text_data_en, "obj_torielboss_462", "Not you.../");
ds_map_add(global.text_data_en, "obj_torielboss_463", "\E5But them!/");
ds_map_add(global.text_data_en, "obj_torielboss_464", "\E3Ha... ha... %%");
ds_map_add(global.text_data_en, "obj_torielboss_469", "\E4You.../");
ds_map_add(global.text_data_en, "obj_torielboss_470", "... at my most&vulnerable&moment.../");
ds_map_add(global.text_data_en, "obj_torielboss_471", "To think I was&worried you&wouldn't fit&in out there.../");
ds_map_add(global.text_data_en, "obj_torielboss_472", "\E5Eheheheh!!!&You really are&no different than&them!/");
ds_map_add(global.text_data_en, "obj_torielboss_473", "\E3Ha... ha... %%");
ds_map_add(global.text_data_en, "obj_torielboss_803", "* Toriel prepares a magical&  attack.");
ds_map_add(global.text_data_en, "obj_torielboss_804", "* Toriel looks through you.");
ds_map_add(global.text_data_en, "obj_torielboss_805", "* Toriel is acting aloof.");
ds_map_add(global.text_data_en, "obj_torielboss_806", "* Toriel takes a deep breath.");
ds_map_add(global.text_data_en, "obj_torielboss_809", "* ...");
ds_map_add(global.text_data_en, "obj_torielboss_834", "* TORIEL - ATK 80 DEF 80&* Knows best for you./^");
ds_map_add(global.text_data_en, "obj_torielboss_843", "* You couldn't think of&  any conversation&  topics./^");
ds_map_add(global.text_data_en, "obj_torielboss_847", "* You tried to think&  of something to say&  again^1, but.../^");
ds_map_add(global.text_data_en, "obj_torielboss_848", "* Ironically^1, talking does not&  seem to be the solution&  to this situation./^");
ds_map_add(global.text_data_en, "obj_torielboss_850", "* You thought about telling&  Toriel that you saw&  her die./");
ds_map_add(global.text_data_en, "obj_torielboss_851", "* But...&* That's creepy./");
ds_map_add(global.text_data_en, "obj_torielboss_852", "* Can you show mercy without&  fighting or running&  away...?/^");
ds_map_add(global.text_data_en, "obj_torielboss_854", "* Can you show mercy&  without running away...?/^");
ds_map_add(global.text_data_en, "obj_torielboss_855", "* Not worth talking to./^");
ds_map_add(global.text_data_en, "obj_torielcall1_90", "* Ring..\E0.\TT /");
ds_map_add(global.text_data_en, "obj_torielcall1_91", "\F1 %");
ds_map_add(global.text_data_en, "obj_torielcall1_92", "* Hello?&* This is TORIEL./");
ds_map_add(global.text_data_en, "obj_torielcall1_93", "\E1* You have not left&  the room^1, have you?/");
ds_map_add(global.text_data_en, "obj_torielcall1_94", "* There are a few puzzles&  ahead that I have&  yet to explain./");
ds_map_add(global.text_data_en, "obj_torielcall1_95", "* It would be dangerous&  to try to solve them&  yourself./");
ds_map_add(global.text_data_en, "obj_torielcall1_96", "* Be good^1, alright?/");
ds_map_add(global.text_data_en, "obj_torielcall1_97", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_torielcall1_98", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_torielcall1_102", "* Ring..\E1.\TT /");
ds_map_add(global.text_data_en, "obj_torielcall1_103", "\F1 %");
ds_map_add(global.text_data_en, "obj_torielcall1_104", "* Hello^1? Hello^1?&* This is TORIEL./");
ds_map_add(global.text_data_en, "obj_torielcall1_105", "* My apologies^1.&* A strange dog&  kidnapped my phone./");
ds_map_add(global.text_data_en, "obj_torielcall1_106", "* So if you called^1, I&  could not have helped&  you./");
ds_map_add(global.text_data_en, "obj_torielcall1_107", "\E0* However^1, I have&  recovered it./");
ds_map_add(global.text_data_en, "obj_torielcall1_108", "* And you are still in&  that room^1, are you not?/");
ds_map_add(global.text_data_en, "obj_torielcall1_109", "* What a good child you&  are./");
ds_map_add(global.text_data_en, "obj_torielcall1_110", "\E1* There are a few puzzles&  ahead that I have&  yet to explain./");
ds_map_add(global.text_data_en, "obj_torielcall1_111", "* It would be dangerous&  to try to solve them&  yourself./");
ds_map_add(global.text_data_en, "obj_torielcall1_112", "\E1* Be good^1, alright?/");
ds_map_add(global.text_data_en, "obj_torielcall1_113", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_torielcall1_114", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_torielcall3_88", "* Ring..\E0.\TT /");
ds_map_add(global.text_data_en, "obj_torielcall3_89", "\F1 %");
ds_map_add(global.text_data_en, "obj_torielcall3_90", "* Hello?&* This is TORIEL./");
ds_map_add(global.text_data_en, "obj_torielcall3_91", "\E1* You do not DISLIKE&  butterscotch^1, do you?/");
ds_map_add(global.text_data_en, "obj_torielcall3_92", "\E1* You do not DISLIKE&  cinnamon^1, do you?/");
ds_map_add(global.text_data_en, "obj_torielcall3_93", "* I know what your&  preference is^1, but.../");
ds_map_add(global.text_data_en, "obj_torielcall3_94", "* Would you turn up your&  nose if you found&  it on your plate?/");
ds_map_add(global.text_data_en, "obj_torielcall3_95", "* Right^1, right^1, I&  understand./");
ds_map_add(global.text_data_en, "obj_torielcall3_96", "\E0* Thank you for being&  patient^1, by the way./");
ds_map_add(global.text_data_en, "obj_torielcall3_97", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_torielcall3_98", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_torielcall4_88", "* Ring..\E0.\TT /");
ds_map_add(global.text_data_en, "obj_torielcall4_89", "\F1 %");
ds_map_add(global.text_data_en, "obj_torielcall4_90", "* Hello?/");
ds_map_add(global.text_data_en, "obj_torielcall4_91", "\E1* You do not have&  any allergies^1, do&  you?/");
ds_map_add(global.text_data_en, "obj_torielcall4_92", "* Huh^1?&* Why am I asking?/");
ds_map_add(global.text_data_en, "obj_torielcall4_93", "\E0* No reason..^1.&* No reason at all./");
ds_map_add(global.text_data_en, "obj_torielcall4_94", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_torielcall4_95", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_torielcall5_90", "* Ring..\E0.\TT /");
ds_map_add(global.text_data_en, "obj_torielcall5_91", "\F1 %");
ds_map_add(global.text_data_en, "obj_torielcall5_92", "* Hello?/");
ds_map_add(global.text_data_en, "obj_torielcall5_93", "\E1* I just realized that it&  has been a while since&  I have cleaned up./");
ds_map_add(global.text_data_en, "obj_torielcall5_94", "\E0* I was not expecting to&  have company so soon./");
ds_map_add(global.text_data_en, "obj_torielcall5_95", "* There are probably a lot&  of things lying about&  here and there./");
ds_map_add(global.text_data_en, "obj_torielcall5_96", "* You can pick them up^1,&  but do not carry more&  than you need./");
ds_map_add(global.text_data_en, "obj_torielcall5_97", "* Someday you might see&  something you really&  like./");
ds_map_add(global.text_data_en, "obj_torielcall5_98", "* You will want to leave&  room in your pockets&  for that./");
ds_map_add(global.text_data_en, "obj_torielcall5_99", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_torielcall5_100", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_torielcall5_104", "* Ring..\E0.\TT /");
ds_map_add(global.text_data_en, "obj_torielcall5_105", "\F1 %");
ds_map_add(global.text_data_en, "obj_torielcall5_106", "* Hello?/");
ds_map_add(global.text_data_en, "obj_torielcall5_107", "\E1* I have a question./");
ds_map_add(global.text_data_en, "obj_torielcall5_108", "* You like things other&  than butterscotch or&  cinnamon^1, too.../");
ds_map_add(global.text_data_en, "obj_torielcall5_109", "* Do you not?/");
ds_map_add(global.text_data_en, "obj_torielcall5_110", "\E0* ..^1. oh^1, what am I&  asking./");
ds_map_add(global.text_data_en, "obj_torielcall5_111", "* I will keep looking./%%");
ds_map_add(global.text_data_en, "obj_torielcall5_112", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_torielcall5_113", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_torieltrigger10_77", "* Every human that falls&  down here meets&  the same fate./");
ds_map_add(global.text_data_en, "obj_torieltrigger10_78", "* I have seen it&  again and again./");
ds_map_add(global.text_data_en, "obj_torieltrigger10_79", "* They come./");
ds_map_add(global.text_data_en, "obj_torieltrigger10_80", "* They leave./");
ds_map_add(global.text_data_en, "obj_torieltrigger10_81", "* They die./");
ds_map_add(global.text_data_en, "obj_torieltrigger10_82", "* You naive child..^1.&* If you leave the&  RUINS.../");
ds_map_add(global.text_data_en, "obj_torieltrigger10_83", "\W* They..^1.&* \RASGORE\W..^1.&* Will kill you./");
ds_map_add(global.text_data_en, "obj_torieltrigger10_84", "* I am only protecting&  you^1, do you understand?/");
ds_map_add(global.text_data_en, "obj_torieltrigger10_85", "* ... go to your room./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger11_79", "* Do not try to stop me./");
ds_map_add(global.text_data_en, "obj_torieltrigger11_80", "* This is your final&  warning./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger12_86", "\E0* Goodbye^1, my child./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger12_149", "\E2* That is right./");
ds_map_add(global.text_data_en, "obj_torieltrigger12_150", "* Go upstairs./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger12_183", "\E2* If you truly wish to&  leave the RUINS.../");
ds_map_add(global.text_data_en, "obj_torieltrigger12_184", "* I will not stop you./");
ds_map_add(global.text_data_en, "obj_torieltrigger12_185", "\E2* However^1, when you&  leave.../");
ds_map_add(global.text_data_en, "obj_torieltrigger12_186", "\E1* Please do not come&  back./");
ds_map_add(global.text_data_en, "obj_torieltrigger12_187", "\E2* I hope you understand./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger12_325", "* You want to leave&  so badly?/");
ds_map_add(global.text_data_en, "obj_torieltrigger12_326", "\E6* Hmph./");
ds_map_add(global.text_data_en, "obj_torieltrigger12_327", "* You are just like&  the others./");
ds_map_add(global.text_data_en, "obj_torieltrigger12_328", "\E7* There is only one&  solution to this./");
ds_map_add(global.text_data_en, "obj_torieltrigger12_329", "* Prove yourself.../");
ds_map_add(global.text_data_en, "obj_torieltrigger12_330", "* Prove to me you&  are strong enough&  to survive./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger12_336", "* Prove to me you&  are strong enough&  to survive!/");
ds_map_add(global.text_data_en, "obj_torieltrigger12_337", "\E6* ... wait./");
ds_map_add(global.text_data_en, "obj_torieltrigger12_338", "* ... why are you looking&  at me like that?/");
ds_map_add(global.text_data_en, "obj_torieltrigger12_339", "* Like you have seen&  a ghost./");
ds_map_add(global.text_data_en, "obj_torieltrigger12_340", "\E7* Do you know something&  that I do not?/");
ds_map_add(global.text_data_en, "obj_torieltrigger12_341", "* No...&* That is impossible./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger12_346", "* Prove to me that you&  are.../");
ds_map_add(global.text_data_en, "obj_torieltrigger12_347", "\E1* Hey^1, let me finish%%");
ds_map_add(global.text_data_en, "obj_torieltrigger12_353", "* Already?/");
ds_map_add(global.text_data_en, "obj_torieltrigger12_354", "* What will it take&  for you to learn&  your lesson?/%%");
ds_map_add(global.text_data_en, "obj_torieltrigger5_185", "* How did you get&  here^1, my child^1?&* Are you hurt?/");
ds_map_add(global.text_data_en, "obj_torieltrigger5_186", "* Not a scratch..^1.&*\E0 Impressive^1!&*\E1 But still.../");
ds_map_add(global.text_data_en, "obj_torieltrigger5_187", "* There^1, there^1, I will&  heal you./");
ds_map_add(global.text_data_en, "obj_torieltrigger5_189", "* Who did this to you^2?\E5 &* You will get an apology./");
ds_map_add(global.text_data_en, "obj_torieltrigger5_190", "\E1* I should not have&  left you alone&  for so long./");
ds_map_add(global.text_data_en, "obj_torieltrigger5_191", "* It was irresponsible&  to try to surprise&  you like this./");
ds_map_add(global.text_data_en, "obj_torieltrigger5_192", "\E8* Err.../");
ds_map_add(global.text_data_en, "obj_torieltrigger5_193", "\E0* Well^1, I suppose I&  cannot hide it&  any longer./");
ds_map_add(global.text_data_en, "obj_torieltrigger5_194", "* Come^1, small one!/%%");
ds_map_add(global.text_data_en, "obj_torieltrigger5_260", "* Oh dear^1, that took&  longer than I&  thought it would./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger6_39", "* Do you smell that^1?/");
ds_map_add(global.text_data_en, "obj_torieltrigger6_40", "* Surprise!/");
ds_map_add(global.text_data_en, "obj_torieltrigger6_41", "* It is a butterscotch-&  cinnamon pie./");
ds_map_add(global.text_data_en, "obj_torieltrigger6_42", "* I thought we might&  celebrate your&  arrival./");
ds_map_add(global.text_data_en, "obj_torieltrigger6_43", "* I want you to have&  a nice time living&  here./");
ds_map_add(global.text_data_en, "obj_torieltrigger6_44", "* So I will hold off&  on snail pie for&  tonight./");
ds_map_add(global.text_data_en, "obj_torieltrigger6_45", "* Here^1, I have another&  surprise for you./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger6_49", "* Do you smell that^1?/");
ds_map_add(global.text_data_en, "obj_torieltrigger6_50", "\E1* Er^1, I assume that&  expression means you&  do./");
ds_map_add(global.text_data_en, "obj_torieltrigger6_51", "\E0* S..^1. surprise!/");
ds_map_add(global.text_data_en, "obj_torieltrigger6_52", "* I have baked a snail&  pie./");
ds_map_add(global.text_data_en, "obj_torieltrigger6_53", "* I thought we might&  celebrate your&  arrival./");
ds_map_add(global.text_data_en, "obj_torieltrigger6_54", "* I want you to have&  a nice time living&  here./");
ds_map_add(global.text_data_en, "obj_torieltrigger6_55", "\E1* So I.../");
ds_map_add(global.text_data_en, "obj_torieltrigger6_56", "\E0* Here^1, I have another&  surprise for you./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger7_41", "* This is it.../%%");
ds_map_add(global.text_data_en, "obj_torieltrigger7_77", "* Is something burning...?&* Um^1, make yourself&  at home!/%%");
ds_map_add(global.text_data_en, "obj_torieltrigger7_243", "* A room of your own.&* I hope you like it!/%%");
ds_map_add(global.text_data_en, "obj_torieltrigger8_77", "* I think you should&  play upstairs&  instead./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger8_78", "* It is dangerous&  to play here./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger8_79", "* It is drafty here.&* You will catch&  a cold./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger8_80", "* It is dusty here.&* You will catch&  a cough./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger8_81", "* There is nothing&  to see here./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger8_82", "* Do you want to&  read a book?/%%");
ds_map_add(global.text_data_en, "obj_torieltrigger8_83", "\E7* I do not like&  the game you&  are playing./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger8_84", "\E0* Why not go for&  a walk in the&  yard?/%%");
ds_map_add(global.text_data_en, "obj_torieltrigger8_85", "* Really now./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger8_86", "\E4* .../%%");
ds_map_add(global.text_data_en, "obj_torieltrigger8_90", "* Hey^1, do not go down&  here./");
ds_map_add(global.text_data_en, "obj_torieltrigger8_91", "* I have something&  to show you&  upstairs./%%");
ds_map_add(global.text_data_en, "obj_torieltrigger9_77", "* You wish to know how&  to return \"home,\"&  do you not?/");ds_map_add(global.text_data_en, "obj_torieltrigger9_78", "* Ahead of us lies the&  end of the RUINS./");
ds_map_add(global.text_data_en, "obj_torieltrigger9_79", "* A one-way exit to the&  rest of the underground./");
ds_map_add(global.text_data_en, "obj_torieltrigger9_80", "* I am going to destroy&  it./");
ds_map_add(global.text_data_en, "obj_torieltrigger9_81", "* No one will ever&  be able to leave&  again./");
ds_map_add(global.text_data_en, "obj_torieltrigger9_82", "* Now be a good child&  and go upstairs./%%");
ds_map_add(global.text_data_en, "obj_torinteractable7_82", "* Do not worry about&  me./");
ds_map_add(global.text_data_en, "obj_torinteractable7_83", "* Someone has to take&  care of these flowers./%%");
ds_map_add(global.text_data_en, "obj_torinteractable7_93", "* Don't worry about&  me./");
ds_map_add(global.text_data_en, "obj_torinteractable7_94", "* Someone has to take&  care of these flowers./%%");
ds_map_add(global.text_data_en, "obj_torinteractable7_99", "* Frisk^1, please leave&  me alone./");
ds_map_add(global.text_data_en, "obj_torinteractable7_100", "\E3* I can't come back^1.&* I just can't^1, OK?/%%");
ds_map_add(global.text_data_en, "obj_torinteractable7_106", "\E7* I don't want to break&  their hearts all over&  again./");
ds_map_add(global.text_data_en, "obj_torinteractable7_107", "* It's better if they&  never see me./%%");
ds_map_add(global.text_data_en, "obj_torinteractable7_113", "\E7* ... why are you still&  here?/");
ds_map_add(global.text_data_en, "obj_torinteractable7_114", "* Are you trying to keep&  me company?/");
ds_map_add(global.text_data_en, "obj_torinteractable7_115", "\E0* Frisk.../");
ds_map_add(global.text_data_en, "obj_torinteractable7_116", "* .../");
ds_map_add(global.text_data_en, "obj_torinteractable7_117", "\E7* Hey./");
ds_map_add(global.text_data_en, "obj_torinteractable7_118", "\E0* Let me ask you a&  question./");
ds_map_add(global.text_data_en, "obj_torinteractable7_119", "* Frisk..^1.&* Why did you come&  here?/");
ds_map_add(global.text_data_en, "obj_torinteractable7_120", "* Everyone knows the&  legend^1, right...?/");
ds_map_add(global.text_data_en, "obj_torinteractable7_121", "* \"Travellers who climb&  Mt. Ebott are said&  to disappear.\"/");ds_map_add(global.text_data_en, "obj_torinteractable7_122", "\E7* .../");
ds_map_add(global.text_data_en, "obj_torinteractable7_123", "* Frisk./");
ds_map_add(global.text_data_en, "obj_torinteractable7_124", "*\E0 Why would you ever&  climb a mountain&  like that?/");
ds_map_add(global.text_data_en, "obj_torinteractable7_125", "\E7* Was it foolishness?/");
ds_map_add(global.text_data_en, "obj_torinteractable7_126", "\E0* Was it fate?/");
ds_map_add(global.text_data_en, "obj_torinteractable7_127", "\E1* Or was it..^1.&* Because you...?/");
ds_map_add(global.text_data_en, "obj_torinteractable7_128", "\E7* Well./");
ds_map_add(global.text_data_en, "obj_torinteractable7_129", "\E0* Only you know the&  answer^1, don't you...?/%%");
ds_map_add(global.text_data_en, "obj_torinteractable7_135", "\E2* I know why \[C]&  climbed the mountain./");
ds_map_add(global.text_data_en, "obj_torinteractable7_136", "\E7* It wasn't for a&  very happy reason./");
ds_map_add(global.text_data_en, "obj_torinteractable7_137", "\E2* Frisk^1.&* I'll be honest with&  you./");
ds_map_add(global.text_data_en, "obj_torinteractable7_138", "\E7* \[C] hated humanity./");
ds_map_add(global.text_data_en, "obj_torinteractable7_139", "\E2* Why they did^1, they&  never talked about&  it./");
ds_map_add(global.text_data_en, "obj_torinteractable7_140", "\E1* But they felt very&  strongly about&  that./%%");
ds_map_add(global.text_data_en, "obj_torinteractable7_146", "\E2* Frisk..^1.&* You really ARE different&  from \[C]./");
ds_map_add(global.text_data_en, "obj_torinteractable7_147", "\E0* In fact^1, though you&  have similar^1, uh^1,&  fashion choices.../");
ds_map_add(global.text_data_en, "obj_torinteractable7_148", "* I don't know why I&  ever acted like you&  were the same person./");
ds_map_add(global.text_data_en, "obj_torinteractable7_149", "\E7* Maybe..^1.&* The truth is.../");
ds_map_add(global.text_data_en, "obj_torinteractable7_150", "\E1* \[C] wasn't really&  the greatest person./");
ds_map_add(global.text_data_en, "obj_torinteractable7_151", "\E7* While^1, Frisk.../");
ds_map_add(global.text_data_en, "obj_torinteractable7_152", "\E0* You're the type of&  friend I wish I&  always had./");
ds_map_add(global.text_data_en, "obj_torinteractable7_153", "\E7* So maybe I was kind&  of projecting a&  little bit./");
ds_map_add(global.text_data_en, "obj_torinteractable7_154", "\E0* Let's be honest^1.&* I did some weird&  stuff as a flower./%%");
ds_map_add(global.text_data_en, "obj_torinteractable7_160", "\E2* There's one last&  thing I feel like&  I should tell you./");
ds_map_add(global.text_data_en, "obj_torinteractable7_161", "* Frisk^1, when \[C]&  and I combined our&  SOULs together.../");
ds_map_add(global.text_data_en, "obj_torinteractable7_162", "* The control over our&  body was actually split&  between us./");
ds_map_add(global.text_data_en, "obj_torinteractable7_163", "* They were the one&  that picked up their&  own empty body./");
ds_map_add(global.text_data_en, "obj_torinteractable7_164", "* And then^1, when we&  got to the village.../");
ds_map_add(global.text_data_en, "obj_torinteractable7_165", "\E2* They were the one&  that wanted to.../");
ds_map_add(global.text_data_en, "obj_torinteractable7_166", "\E1* ... to use our full&  power./");
ds_map_add(global.text_data_en, "obj_torinteractable7_167", "\E2* I was the one that&  resisted./");
ds_map_add(global.text_data_en, "obj_torinteractable7_168", "\E7* And then^1, because of&  me^1, we.../");
ds_map_add(global.text_data_en, "obj_torinteractable7_169", "\E1* Well^1, that's why I&  ended up a flower./");
ds_map_add(global.text_data_en, "obj_torinteractable7_170", "\E2* Frisk.../");
ds_map_add(global.text_data_en, "obj_torinteractable7_171", "* This whole time^1, I've&  blamed myself for&  that decision./");
ds_map_add(global.text_data_en, "obj_torinteractable7_172", "* That's why I adopted&  that horrible view&  of the world./");
ds_map_add(global.text_data_en, "obj_torinteractable7_173", "* \"Kill or be killed.\"/");ds_map_add(global.text_data_en, "obj_torinteractable7_174", "\E7* But now..^1.&* After meeting you.../");
ds_map_add(global.text_data_en, "obj_torinteractable7_175", "\E0* Frisk^1, I don't regret&  that decision anymore./");
ds_map_add(global.text_data_en, "obj_torinteractable7_176", "\E4* I did the right&  thing./");
ds_map_add(global.text_data_en, "obj_torinteractable7_177", "* If I killed those&  humans.../");
ds_map_add(global.text_data_en, "obj_torinteractable7_178", "* We would have had to&  wage war against all&  of humanity./");
ds_map_add(global.text_data_en, "obj_torinteractable7_179", "\E0* And in the end^1,&  everyone went free^1,&  right?/");
ds_map_add(global.text_data_en, "obj_torinteractable7_180", "\E7* I still feel kind&  of sad knowing how&  long it took.../");
ds_map_add(global.text_data_en, "obj_torinteractable7_181", "\E0* ... so maybe it&  wasn't a perfect&  decision./");
ds_map_add(global.text_data_en, "obj_torinteractable7_182", "* But you can't regret&  hard choices your&  whole life^1, right?/");
ds_map_add(global.text_data_en, "obj_torinteractable7_183", "\E7* Well^1, not that I&  have much of a life&  left./");
ds_map_add(global.text_data_en, "obj_torinteractable7_184", "\E0* But that's besides&  the point./%%");
ds_map_add(global.text_data_en, "obj_torinteractable7_190", "* Frisk^1, thank you&  for listening to me./");
ds_map_add(global.text_data_en, "obj_torinteractable7_191", "* You should really go&  be with your friends&  now^1, OK?/");
ds_map_add(global.text_data_en, "obj_torinteractable7_192", "* Oh^1, and^1, please.../");
ds_map_add(global.text_data_en, "obj_torinteractable7_193", "\E7* In the future^1, if you&  uh^1, see me.../");
ds_map_add(global.text_data_en, "obj_torinteractable7_194", "* Don't think of it as&  me^1, OK?/");
ds_map_add(global.text_data_en, "obj_torinteractable7_195", "\E0* I just want you to&  remember me like this./");
ds_map_add(global.text_data_en, "obj_torinteractable7_196", "\E0* Someone that was your&  friend for a little&  while./");
ds_map_add(global.text_data_en, "obj_torinteractable7_197", "\E2* Oh^1, and Frisk.../");
ds_map_add(global.text_data_en, "obj_torinteractable7_198", "\E0* Be careful in the&  outside world^1, OK?/");
ds_map_add(global.text_data_en, "obj_torinteractable7_199", "* Despite what everyone&  thinks^1, it's not as&  nice as it is here./");
ds_map_add(global.text_data_en, "obj_torinteractable7_200", "\E7* There are a lot of&  Floweys out there./");
ds_map_add(global.text_data_en, "obj_torinteractable7_201", "\E2* And not everything can&  be resolved by just&  being nice./");
ds_map_add(global.text_data_en, "obj_torinteractable7_202", "\E0* Frisk.../");
ds_map_add(global.text_data_en, "obj_torinteractable7_203", "* Don't kill^1, and&  don't be killed^1,&  alright?/");
ds_map_add(global.text_data_en, "obj_torinteractable7_204", "* That's the best you&  can strive for./");
ds_map_add(global.text_data_en, "obj_torinteractable7_205", "* Well^1, see you./%%");
ds_map_add(global.text_data_en, "obj_torinteractable7_212", "\E7* Frisk.../");
ds_map_add(global.text_data_en, "obj_torinteractable7_213", "\E6* Don't you have&  anything better to&  do?/%%");
ds_map_add(global.text_data_en, "obj_torn_note_63", " error/%%");
ds_map_add(global.text_data_en, "obj_torn_note_67", "* (There's a note on the&  ground...^1)&* (You can't make it all out.)/");
ds_map_add(global.text_data_en, "obj_torn_note_68", "* \"elevator..^1. lost power..^1.\"&* \"enter the center door...\"/");ds_map_add(global.text_data_en, "obj_torn_note_69", "* (That's all you could read.)/%%");
ds_map_add(global.text_data_en, "obj_torn_note_74", "* (There's a note on the&  ground...^1)&* (You can't make it all out.)/");
ds_map_add(global.text_data_en, "obj_torn_note_75", "* \"drain..^1. dropped it...\"/");ds_map_add(global.text_data_en, "obj_torn_note_76", "* (That's all you could read.)/%%");
ds_map_add(global.text_data_en, "obj_torn_note_81", "* (There's a note on the&  ground...^1)&* (You can't make it all out.)/");
ds_map_add(global.text_data_en, "obj_torn_note_82", "* \"cold...\"/");ds_map_add(global.text_data_en, "obj_torn_note_83", "* (That's all you could read.)/%%");
ds_map_add(global.text_data_en, "obj_torn_note_88", "* (There's a note on the&  ground...^1)&* (You can't make it all out.)/");
ds_map_add(global.text_data_en, "obj_torn_note_89", "* \"curtain...\"/");ds_map_add(global.text_data_en, "obj_torn_note_90", "* (That's all you could read.)/%%");
ds_map_add(global.text_data_en, "obj_torn_note_95", "* (There's a note on the&  ground...^1)&* (You can't make it all out.)/");
ds_map_add(global.text_data_en, "obj_torn_note_96", "* \"under..^1. sheets...\"/");ds_map_add(global.text_data_en, "obj_torn_note_97", "* (That's all you could read.)/%%");
ds_map_add(global.text_data_en, "obj_townnpc_bear1_70", "* This town doesn't have a&  mayor./");
ds_map_add(global.text_data_en, "obj_townnpc_bear1_71", "* But if there's ever a problem^1,&  a skeleton will tell a fish&  lady about it./");
ds_map_add(global.text_data_en, "obj_townnpc_bear1_72", "* Thaaaaaat's politics!/%%");
ds_map_add(global.text_data_en, "obj_townnpc_bear1_73", "* Politics./%%");
ds_map_add(global.text_data_en, "obj_townnpc_bear1_77", "* What if I ran for mayor...?/");
ds_map_add(global.text_data_en, "obj_townnpc_bear1_78", "* I don't think I would do&  a good job^1, and I hate&  responsibility.../");
ds_map_add(global.text_data_en, "obj_townnpc_bear1_79", "* But I love politics^1.&* So I might be a perfect&  match./%%");
ds_map_add(global.text_data_en, "obj_townnpc_bear1_85", "* I heard Dr. Alphys told&  the king and queen the&  awful things she'd done./");
ds_map_add(global.text_data_en, "obj_townnpc_bear1_86", "* The king felt so bad&  that he didn't know^1.&* He gave her a big hug./");
ds_map_add(global.text_data_en, "obj_townnpc_bear1_87", "* Then the queen fired her./");
ds_map_add(global.text_data_en, "obj_townnpc_bear1_88", "* Now we don't have a Royal&  Scientist anymore.../");
ds_map_add(global.text_data_en, "obj_townnpc_bear1_89", "* Thaaaaat's politics!/%%");
ds_map_add(global.text_data_en, "obj_townnpc_bear1_93", "* Too bad there are no&  politics on the surface./%%");
ds_map_add(global.text_data_en, "obj_townnpc_bear1_99", "* Hmmm^1, usually that skeleton&  goes to meet with Undyne&  about now./");
ds_map_add(global.text_data_en, "obj_townnpc_bear1_100", "* Where is he...^1?&* I can feel our political&  system crumbling apart.../%%");
ds_map_add(global.text_data_en, "obj_townnpc_beartree_70", "* Awful teens tormented&  a local monster by decorating&  its tree-like horns./");
ds_map_add(global.text_data_en, "obj_townnpc_beartree_71", "* So we started giving that&  monster presents to make it&  feel better./");
ds_map_add(global.text_data_en, "obj_townnpc_beartree_72", "* Now it's a tradition to put&  presents underneath a decorated&  tree./%%");
ds_map_add(global.text_data_en, "obj_townnpc_beartree_74", "* Guess it was a good thing&  those teens tormented that&  monster...?/%%");
ds_map_add(global.text_data_en, "obj_townnpc_beartree_78", "* Hmm^1?&* Adjusting the presents is&  my responsibility./");
ds_map_add(global.text_data_en, "obj_townnpc_beartree_79", "* Nah^1, to be honest^1, I&  just keep looking to see&  if I've gotten one.../%%");
ds_map_add(global.text_data_en, "obj_townnpc_beartree_84", "* It'll be nice to show humans&  our presents-under-the-tree&  tradition./");
ds_map_add(global.text_data_en, "obj_townnpc_beartree_85", "* They'll probably be weirded&  out by it./%%");
ds_map_add(global.text_data_en, "obj_townnpc_beartree_90", "* You know what's cute?/");
ds_map_add(global.text_data_en, "obj_townnpc_beartree_91", "* Those two married dogs&  always put presents under&  the tree for each other./");
ds_map_add(global.text_data_en, "obj_townnpc_beartree_92", "* It's always the same^1.&* A single bone./");
ds_map_add(global.text_data_en, "obj_townnpc_beartree_93", "* But every time^1, they act&  like it's the first time&  they've gotten it./");
ds_map_add(global.text_data_en, "obj_townnpc_beartree_94", "* Then Papyrus comes to take&  his bones back./");
ds_map_add(global.text_data_en, "obj_townnpc_beartree_95", "* Anyway^1, where are those&  two...?/%%");
ds_map_add(global.text_data_en, "obj_townnpc_beartree_100", "* That's strange^1.&* There was a present here&  for Papyrus.../");
ds_map_add(global.text_data_en, "obj_townnpc_beartree_101", "* Now it's gone^1.&* Did someone steal it?/%%");
ds_map_add(global.text_data_en, "obj_townnpc_bunboy_70", "* That lady over there.../");
ds_map_add(global.text_data_en, "obj_townnpc_bunboy_71", "* Something about her disturbs&  me./%%");
ds_map_add(global.text_data_en, "obj_townnpc_bunboy_72", "* I think I've figured it out^1.&* ... no^1, nevermind./%%");
ds_map_add(global.text_data_en, "obj_townnpc_bunboy_76", "* That lady over there's&  been going for a walk&  for a while now./");
ds_map_add(global.text_data_en, "obj_townnpc_bunboy_77", "* ... but she hasn't moved&  an inch from where she's&  standing./");
ds_map_add(global.text_data_en, "obj_townnpc_bunboy_78", "* W-well^1, I haven't either^1,&  but I don't want her to&  notice me over here.../%%");
ds_map_add(global.text_data_en, "obj_townnpc_bunboy_83", "* Uhhh.../");
ds_map_add(global.text_data_en, "obj_townnpc_bunboy_84", "* Is anyone else weirded out&  by those giant shambling&  amalgamates^1, or...?/%%");
ds_map_add(global.text_data_en, "obj_townnpc_bunboy_85", "* ....../%%");
ds_map_add(global.text_data_en, "obj_townnpc_bunboy_90", "* That lady over there&  seems happy today./");
ds_map_add(global.text_data_en, "obj_townnpc_bunboy_91", "* Don't know why^1, but it's&  sending shivers down my&  spine.../%%");
ds_map_add(global.text_data_en, "obj_townnpc_bunlady_70", "* Isn't my little Cinnamon&  just the cutest?/");
ds_map_add(global.text_data_en, "obj_townnpc_bunlady_71", "* Bun-buns are so adorable..^1.&* Tee hee!/%%");
ds_map_add(global.text_data_en, "obj_townnpc_bunlady_73", "* Bun-bun-bun-bun-bun.../%%");
ds_map_add(global.text_data_en, "obj_townnpc_bunlady_77", "* Huh^1? Yes^1, I'm taking&  my bunny for a walk./");
ds_map_add(global.text_data_en, "obj_townnpc_bunlady_78", "* It's just a very slow one./%%");
ds_map_add(global.text_data_en, "obj_townnpc_bunlady_83", "* That kid over there told&  me that it's weird that&  I have a pet bunny./");
ds_map_add(global.text_data_en, "obj_townnpc_bunlady_84", "* First^1, there'd be nothing&  weird about it^1.&* It's cute!/");
ds_map_add(global.text_data_en, "obj_townnpc_bunlady_85", "* Second..^1.&* What?/");
ds_map_add(global.text_data_en, "obj_townnpc_bunlady_86", "* It's normal to walk your&  younger brother on a&  leash^1, right?/%%");
ds_map_add(global.text_data_en, "obj_townnpc_bunlady_91", "* Ah^1, it's so peaceful&  and quiet.../");
ds_map_add(global.text_data_en, "obj_townnpc_bunlady_92", "* Usually one of those dogs&  chases my little Cinnamon&  around./%%");
ds_map_add(global.text_data_en, "obj_townnpc_bunlady_97", "* Ah^1, it's so peaceful&  and quiet.../");
ds_map_add(global.text_data_en, "obj_townnpc_bunlady_98", "* Usually one of those&  skeletons chases my little&  Cinnamon around./%%");
ds_map_add(global.text_data_en, "obj_townnpc_hatescity_70", "* The capital's getting pretty&  crowded^1, so I've heard they're&  going to start moving here./");
ds_map_add(global.text_data_en, "obj_townnpc_hatescity_71", "* Hmmm..^1.&* I don't want to see the&  erasure of our local culture./");
ds_map_add(global.text_data_en, "obj_townnpc_hatescity_72", "* But I definitely want to see&  some city slickers slip onto&  their butts!/%%");
ds_map_add(global.text_data_en, "obj_townnpc_hatescity_73", "* Yeah^1, bring 'em on!/%%");
ds_map_add(global.text_data_en, "obj_townnpc_hatescity_77", "* What will happen to&  Grillby's if everyone&  moves in...?/");
ds_map_add(global.text_data_en, "obj_townnpc_hatescity_78", "* We're gonna have to have&  chairs to the ceiling./%%");
ds_map_add(global.text_data_en, "obj_townnpc_hatescity_83", "* Hey^1! People won't have to&  move in from the city&  anymore!/");
ds_map_add(global.text_data_en, "obj_townnpc_hatescity_84", "* Seems like we won't have&  to lose our local culture./");
ds_map_add(global.text_data_en, "obj_townnpc_hatescity_85", "* ... except we're all moving&  out of here^1, huh./");
ds_map_add(global.text_data_en, "obj_townnpc_hatescity_86", "* Oh well^1. Guess it can't be&  all punk-peaches and punk-&  cream./%%");
ds_map_add(global.text_data_en, "obj_townnpc_hatescity_91", "* The capital's getting pretty&  crowded^1, so I've heard they're&  going to start moving here./");
ds_map_add(global.text_data_en, "obj_townnpc_hatescity_92", "* ... who knows^1.&* Maybe we'll have room./%%");
ds_map_add(global.text_data_en, "obj_townnpc_icewolf_71", "* Ice Wolf no longer has to&  throw Ice./");
ds_map_add(global.text_data_en, "obj_townnpc_icewolf_72", "* Ice Wolf can take a break to&  buy some pants now./%%");
ds_map_add(global.text_data_en, "obj_townnpc_icewolf_74", "* Ice Wolf thinking of changing&  their name to Jimmy Hotpants./%%");
ds_map_add(global.text_data_en, "obj_townnpc_innlady_114", "* Error./%%");
ds_map_add(global.text_data_en, "obj_townnpc_innlady_199", "* Hiya^1!&* You look like you&  had a great sleep./");
ds_map_add(global.text_data_en, "obj_townnpc_innlady_200", "* Which is incredible^1, because&  you were only up there for&  about two minutes.../");
ds_map_add(global.text_data_en, "obj_townnpc_innlady_203", "* Here's your money back^1.&* You can pay me if you're&  going to stay overnight./%%");
ds_map_add(global.text_data_en, "obj_townnpc_innlady_207", "* Feel free to come back&  if you get tired./%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_80", "* Yo^1!&* You're a kid too^1, right?/");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_81", "* I can tell 'cause you're&  wearing a striped shirt./%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_82", "* I wonder if that weird skeleton&  is an adult or a kid./%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_88", "* Yo..^1.&* There you are!/");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_89", "* I've been kinda worried&  about you since you&  ran away./");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_90", "* ... but now I'm just kinda&  mad^1, ha ha./");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_91", "* If Undyne hadn't saved me^1,&  that woulda been bad.../%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_93", "* .../%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_97", "* Yo..^1.&* Uh.../");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_98", "* Don't talk to me./%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_100", "* .../%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_104", "* Yo!!^1!&* What's up!?/");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_105", "* I've been kinda^1, doing&  some thinking.../");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_106", "* Maybe Undyne...&* Isn't actually as cool as&  we thought./");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_107", "* She's just kinda..^1. mean./");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_108", "* But YO!!^1!&* I just found out about&  someone WAYYY cooler!!!/");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_109", "* Nyeh heh heh!!!/%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_111", "* Nyeh heh heh^1, dude./%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_117", "* Yo^1, everyone ran away and&  hid somewhere./");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_118", "* Man^1, adults can be so&  dumb sometimes^1, haha.../");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_119", "* Don't they know we've&  got Undyne to protect us!?/%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_122", "* Yo^1!&* Are you sneaking out to&  see her^1, too?/");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_123", "* Awesome..^1.&* She's the coolest^1, right!?/");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_124", "* I wanna be just like her&  when I grow up.../");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_125", "* Hey^1, don't tell my parents&  I'm here^1.&* Ha ha./%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_127", "* OK^1, I'm ready when you&  are./%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_129", "* Yo^1!&* Where were you going...?/");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_130", "* My parents didn't tell you&  to come here^1, did they?/%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_132", "* You know where you're&  going^1, right...?/");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_133", "* I was just gonna follow&  you..^1.&* Ha ha./%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_141", "* Yo^1, this ledge is way&  too steep.../%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_147", "* Hmmm..../%%");
ds_map_add(global.text_data_en, "obj_townnpc_monsterkid1_161", "* Yo^1, you aren't going to&  be able to climb with&  an umbrella./%%");
ds_map_add(global.text_data_en, "obj_townnpc_reddemon_70", "* We all know the underground&  has problems^1, but we&  smile anyway./");
ds_map_add(global.text_data_en, "obj_townnpc_reddemon_71", "* Why?/");
ds_map_add(global.text_data_en, "obj_townnpc_reddemon_72", "* We can't do anything^1, so&  why be morose about it?/%%");
ds_map_add(global.text_data_en, "obj_townnpc_reddemon_73", "* Smile smile./%%");
ds_map_add(global.text_data_en, "obj_townnpc_reddemon_83", "* Maybe I'll try frowning&  for once./");
ds_map_add(global.text_data_en, "obj_townnpc_reddemon_84", "* ... no^1.&* I just can't do it./%%");
ds_map_add(global.text_data_en, "obj_townnpc_reddemon_89", "* Oh^1?&* We're free?/");
ds_map_add(global.text_data_en, "obj_townnpc_reddemon_90", "* Finally..^1.&* I'll be able to stop&  smiling./%%");
ds_map_add(global.text_data_en, "obj_townnpc_reddemon_95", "* Just now^1, I felt my smile&  falter for a moment./");
ds_map_add(global.text_data_en, "obj_townnpc_reddemon_96", "* What's wrong?/%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimedad_70", "* Ah^1, to be young again^1.&* The world sure felt boundless./%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimedad_74", "* You like to wander^1.&* You must be young./%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimedad_79", "* Seems like this is the&  beginning of a brand-new^1,&  boundless world.../");
ds_map_add(global.text_data_en, "obj_townnpc_slimedad_80", "* Wah-ha^1!&* This adventurous spirit^1!&* I'm like a kid again!/");
ds_map_add(global.text_data_en, "obj_townnpc_slimedad_81", "* And my children are like..^1.&* Double-children./%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimedad_86", "* I've sent the kids inside./");
ds_map_add(global.text_data_en, "obj_townnpc_slimedad_87", "* It feels unsafe here today./%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimedaughter_80", "* You aren't gonna make me&  be the human again^1, are you?/%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimedaughter_84", "* Can we PLEASE play something&  else...?/%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimedaughter_89", "* Hmmm..^1.&* When humans play Monsters&  and Humans.../");
ds_map_add(global.text_data_en, "obj_townnpc_slimedaughter_90", "* Do they just call it&  Humans and Humans?/%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimeson_75", "* Let's play Monsters and Humans!/%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimeson_79", "* Let's continue to play&  Monsters and Humans!/%%");
ds_map_add(global.text_data_en, "obj_townnpc_slimeson_84", "* Now we can play Monsters&  and Humans with REAL humans!/%%");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_70", "* Everyone is always laughing&  and cracking jokes^1, trying&  to forget our modern crises.../");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_71", "* Dreariness^1.&* Crowding^1.&* Lack of sunlight./");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_72", "* I would join them^1, but I'm&  just not very funny./%%");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_73", "* At least I'm not making puns./%%");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_77", "* Wait^1!&* I've got a joke!/");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_78", "* Knock knock!/");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_79", "* ... Uh^1.&* That's all I've thought of./%%");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_85", "* Looks like I don't have&  to worry about cracking&  jokes anymore./");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_86", "* .../");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_87", "* I was going to say a joke&  here^1, but I really don't&  have one./%%");
ds_map_add(global.text_data_en, "obj_townnpc_unfunny_92", "* It just feels like..^1.&* Like everything is getting&  worse and worse./%%");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_72", "* I \"put out a line\" for some&  girls today./");ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_73", "* Someone told me that there&  are plenty of fish in the&  sea.../");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_74", "* Well^1, I'm taking that&  seriously./");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_75", "* I'm literally going to make&  out with a fish./%%");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_76", "* I guess I could ask out Undyne^1.&* But I think she likes someone&  already./%%");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_80", "* Did I catch anyone yet^1?&* I can't bear to look.../%%");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_85", "* Sans is the most regular&  regular of all./");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_86", "* He hasn't been showing up&  as much recently though./%%");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_91", "* Where the heck is Sans?/");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_92", "* He told me he had some&  bait I could use./");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_93", "* Though it was probably&  some kind of prank./");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_94", "* But I wanted to know what&  the prank was!/%%");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_99", "* In the end^1, I never caught&  any girls on my fishing&  line./");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_100", "* So kid^1, take it from me.../");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_101", "* Don't try to catch hot&  people with a fishing rod./");
ds_map_add(global.text_data_en, "obj_townnpc_weirdfish_102", "* (Somewhere^1, you hear a whinny&  of dismay.)/%%");
ds_map_add(global.text_data_en, "obj_treadmill_event_103", "HEY^1, SANS^1, HAVE&YOU SEEN MY.../");
ds_map_add(global.text_data_en, "obj_treadmill_event_104", "\E0OH, HELLO^1.&YOU AREN'T SANS./");
ds_map_add(global.text_data_en, "obj_treadmill_event_105", "\E3WAIT A SECOND./");
ds_map_add(global.text_data_en, "obj_treadmill_event_106", "\E0WHY WERE YOU USING&A TREADMILL IN&THE DARK?/");
ds_map_add(global.text_data_en, "obj_treadmill_event_107", "\E3IS SANS PRANKING&YOU ACROSS TIME&AND SPACE?/");
ds_map_add(global.text_data_en, "obj_treadmill_event_108", "\E1I HATE IT WHEN&HE DOES THAT!/");
ds_map_add(global.text_data_en, "obj_treadmill_event_109", "\E1HOW IMMATURE CAN&YOU GET?/");
ds_map_add(global.text_data_en, "obj_treadmill_event_110", "\E3ALSO^1, HAVE YOU&SEEN MY ACTION&FIGURES?/");
ds_map_add(global.text_data_en, "obj_treadmill_event_111", "\E0WAIT^1!&I KNOW WHERE TO&LOOK!!!/");
ds_map_add(global.text_data_en, "obj_treadmill_event_112", "IN MY COLLECTION^1!&NYEH HEH HEH!!!/");
ds_map_add(global.text_data_en, "obj_treadmill_event_113", "SOMETIMES^1, I'M A&GENIUS^1.&ALL THE TIME./%%");
ds_map_add(global.text_data_en, "obj_triswitchevent_120", "* Ring.../");
ds_map_add(global.text_data_en, "obj_triswitchevent_121", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_triswitchevent_122", "\E6* OK^1!&* Now press the third&  one!!!/%%");
ds_map_add(global.text_data_en, "obj_triswitchevent_123", "\TS \F0 \E0 \T0 %");
ds_map_add(global.text_data_en, "obj_triswitchevent_124", "* (Click...)/%%");
ds_map_add(global.text_data_en, "obj_triswitchevent_147", "\E1* ............./");
ds_map_add(global.text_data_en, "obj_triswitchevent_148", "\E2* ............./");
ds_map_add(global.text_data_en, "obj_triswitchevent_149", "\E0* H-h-hey!/");
ds_map_add(global.text_data_en, "obj_triswitchevent_150", "\E5* Looks like you!!!^1 &* Only needed to press^1!&* Two of them!!!/");
ds_map_add(global.text_data_en, "obj_triswitchevent_151", "\TS \F0 \E0 \T0 %");
ds_map_add(global.text_data_en, "obj_triswitchevent_152", "* (Click...)/%%");
ds_map_add(global.text_data_en, "obj_triswitchevent_213", "* Ring.../");
ds_map_add(global.text_data_en, "obj_triswitchevent_214", "\TS \E4 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_triswitchevent_215", "\E3* H-h-hey^1!&* You did it!/");
ds_map_add(global.text_data_en, "obj_triswitchevent_216", "\E4* I was worried I&  messed it up&  there.../");
ds_map_add(global.text_data_en, "obj_triswitchevent_217", "\E0* But I guess we&  make a pretty good&  team!/%%");
ds_map_add(global.text_data_en, "obj_triswitchevent_218", "\TS \F0 \E0 \T0 %");
ds_map_add(global.text_data_en, "obj_triswitchevent_219", "* (Click...)/%%");
ds_map_add(global.text_data_en, "obj_truechara_94", "Greetings./");
ds_map_add(global.text_data_en, "obj_truechara_95", "I^2 am \[C]./%%");
ds_map_add(global.text_data_en, "obj_truechara_111", "Thank you./");
ds_map_add(global.text_data_en, "obj_truechara_112", "Your power awakened&me from death./");
ds_map_add(global.text_data_en, "obj_truechara_113", "My \"human soul.\"/");ds_map_add(global.text_data_en, "obj_truechara_114", "My \"determination.\"/");ds_map_add(global.text_data_en, "obj_truechara_115", "They were not mine^1,&but YOURS./");
ds_map_add(global.text_data_en, "obj_truechara_116", "At first^1, I&was so confused./");
ds_map_add(global.text_data_en, "obj_truechara_117", "Our plan had failed^1,&hadn't it?/");
ds_map_add(global.text_data_en, "obj_truechara_118", "Why was I brought&back to life?/");
ds_map_add(global.text_data_en, "obj_truechara_119", ".../");
ds_map_add(global.text_data_en, "obj_truechara_120", "You./");
ds_map_add(global.text_data_en, "obj_truechara_121", "With your guidance./");
ds_map_add(global.text_data_en, "obj_truechara_122", "I realized the purpose&of my reincarnation./");
ds_map_add(global.text_data_en, "obj_truechara_123", "Power./");
ds_map_add(global.text_data_en, "obj_truechara_124", "Together^1, we eradicated&the enemy and became&strong./");
ds_map_add(global.text_data_en, "obj_truechara_125", "HP. ATK. DEF.&GOLD. EXP. LV./");
ds_map_add(global.text_data_en, "obj_truechara_126", "Every time a number&increases^1, that&feeling.../");
ds_map_add(global.text_data_en, "obj_truechara_127", "That's me./");
ds_map_add(global.text_data_en, "obj_truechara_128", "\"\[C].\"/");ds_map_add(global.text_data_en, "obj_truechara_129", "Now./");
ds_map_add(global.text_data_en, "obj_truechara_130", "Now, we have reached&the absolute./");
ds_map_add(global.text_data_en, "obj_truechara_131", "There is nothing&left for us here./");
ds_map_add(global.text_data_en, "obj_truechara_132", "Let us erase this&pointless world^1, and&move on to the next./%%");
ds_map_add(global.text_data_en, "obj_truechara_136", "\"\[C].\"/");ds_map_add(global.text_data_en, "obj_truechara_137", "The demon that comes&when people call&its name./");
ds_map_add(global.text_data_en, "obj_truechara_138", "It doesn't matter when./");
ds_map_add(global.text_data_en, "obj_truechara_139", "It doesn't matter where./");
ds_map_add(global.text_data_en, "obj_truechara_140", "Time after time,&I will appear./");
ds_map_add(global.text_data_en, "obj_truechara_141", "And, with your help./");
ds_map_add(global.text_data_en, "obj_truechara_142", "We will eradicate the&enemy and become&strong./");
ds_map_add(global.text_data_en, "obj_truechara_143", "HP. ATK. DEF.&GOLD. EXP. LV./");
ds_map_add(global.text_data_en, "obj_truechara_144", "Every time a number&increases^1, that&feeling.../");
ds_map_add(global.text_data_en, "obj_truechara_145", "That's me./");
ds_map_add(global.text_data_en, "obj_truechara_146", "\"\[C].\"/");ds_map_add(global.text_data_en, "obj_truechara_147", ".../");
ds_map_add(global.text_data_en, "obj_truechara_148", "But./");
ds_map_add(global.text_data_en, "obj_truechara_149", "You and I are not&the same^1, are we?/");
ds_map_add(global.text_data_en, "obj_truechara_150", "This SOUL resonates&with a strange&feeling./");
ds_map_add(global.text_data_en, "obj_truechara_151", "There is a reason&you continue to&recreate this world./");
ds_map_add(global.text_data_en, "obj_truechara_152", "There is a reason&you continue to&destroy it./");
ds_map_add(global.text_data_en, "obj_truechara_153", "You./");
ds_map_add(global.text_data_en, "obj_truechara_154", "You are wracked with&a perverted&sentimentality./");
ds_map_add(global.text_data_en, "obj_truechara_155", "Hmm./");
ds_map_add(global.text_data_en, "obj_truechara_156", "I cannot understand&these feelings&any more./");
ds_map_add(global.text_data_en, "obj_truechara_157", "Despite this./");
ds_map_add(global.text_data_en, "obj_truechara_158", "I feel obligated to&suggest./");
ds_map_add(global.text_data_en, "obj_truechara_159", "Should you choose to&create this world&once more./");
ds_map_add(global.text_data_en, "obj_truechara_160", "Another path would&be better suited./");
ds_map_add(global.text_data_en, "obj_truechara_161", "Now, partner./");
ds_map_add(global.text_data_en, "obj_truechara_162", "Let us send this&world back into the&abyss./%%");
ds_map_add(global.text_data_en, "obj_truechara_186", "Right^1. You are a&great partner./");
ds_map_add(global.text_data_en, "obj_truechara_187", "We'll be together&forever^1, won't we?/%%");
ds_map_add(global.text_data_en, "obj_truechara_209", "No...?/");
ds_map_add(global.text_data_en, "obj_truechara_210", "Hmm.../");
ds_map_add(global.text_data_en, "obj_truechara_211", "How curious./");
ds_map_add(global.text_data_en, "obj_truechara_212", "You must have&misunderstood./");
ds_map_add(global.text_data_en, "obj_truechara_213", "SINCE WHEN WERE YOU&THE ONE IN CONTROL?/%%");
ds_map_add(global.text_data_en, "obj_truechara_217", "No...?/");
ds_map_add(global.text_data_en, "obj_truechara_218", "Hmm...&This feeling you have./");
ds_map_add(global.text_data_en, "obj_truechara_219", "This is what I&spoke of./");
ds_map_add(global.text_data_en, "obj_truechara_220", "Unfortunately,&regarding this.../");
ds_map_add(global.text_data_en, "obj_truechara_221", "YOU MADE YOUR CHOICE&LONG AGO./%%");
ds_map_add(global.text_data_en, "obj_tsunderplane_235", "It's not&like I&LIKE&you.");
ds_map_add(global.text_data_en, "obj_tsunderplane_236", "Id...&Idiot!");
ds_map_add(global.text_data_en, "obj_tsunderplane_237", "Hmph!&Don't&get in&my way.");
ds_map_add(global.text_data_en, "obj_tsunderplane_238", ">_<...&Human&...");
ds_map_add(global.text_data_en, "obj_tsunderplane_242", "...&H-human&...&...?");
ds_map_add(global.text_data_en, "obj_tsunderplane_243", "Id...&Idiot!");
ds_map_add(global.text_data_en, "obj_tsunderplane_250", "Eeeeh?&H-human&...?");
ds_map_add(global.text_data_en, "obj_tsunderplane_251", "Human,&I...");
ds_map_add(global.text_data_en, "obj_tsunderplane_256", "Huh!?&Y-you&sicko!");
ds_map_add(global.text_data_en, "obj_tsunderplane_257", "Ah...&Is that&true...?");
ds_map_add(global.text_data_en, "obj_tsunderplane_262", "No way!&Why&would I&like YOU");
ds_map_add(global.text_data_en, "obj_tsunderplane_263", "Human,&I...");
ds_map_add(global.text_data_en, "obj_tsunderplane_266", "%%%");
ds_map_add(global.text_data_en, "obj_tsunderplane_465", "* Tsunderplane looks over^1,&  then turns up its nose.");
ds_map_add(global.text_data_en, "obj_tsunderplane_466", "* Tsunderplane shakes its&  nose dimissively at you.");
ds_map_add(global.text_data_en, "obj_tsunderplane_467", "* Tsunderplane \"accidentally\"&  bumps you with its wing.");ds_map_add(global.text_data_en, "obj_tsunderplane_468", "* Tsunderplane gives you a&  condescending barrel roll.");
ds_map_add(global.text_data_en, "obj_tsunderplane_469", "* Smells like an airport&  perfume counter.");
ds_map_add(global.text_data_en, "obj_tsunderplane_470", "* Tsunderplane is looking away&  shyly.");
ds_map_add(global.text_data_en, "obj_tsunderplane_471", "* Tsunderplane's body is smoking.");
ds_map_add(global.text_data_en, "obj_tsunderplane_490", "* TSUNDERPLANE - ATK 25 DEF 26&* Seems mean^1, but does&  it secretly like you?/^");
ds_map_add(global.text_data_en, "obj_tsunderplane_499", "* You tell Tsunderplane it has&  an impressive wingspan./^");
ds_map_add(global.text_data_en, "obj_tsunderplane_501", "* You tell Tsunderplane it has&  an impressive wingspan./^");
ds_map_add(global.text_data_en, "obj_tsunderplane_502", "* You tell Tsunderplane it has&  nice turbines./^");
ds_map_add(global.text_data_en, "obj_tsunderplane_503", "* You tell Tsunderplane it has&  a powerful rudder./^");
ds_map_add(global.text_data_en, "obj_tsunderplane_504", "* You tell Tsunderplane that&  you like its taste in&  movies and books./^");
ds_map_add(global.text_data_en, "obj_tsunderplane_505", "* You tell Tsunderplane that&  it has cute winglets./^");
ds_map_add(global.text_data_en, "obj_tsunderplane_515", "* You get close to Tsunderplane^1.&* But not too close./^");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_75", "* Hey^1!&* Watch where you stand^1,&  jerk!/");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_76", "* Th-though^1, I guess if&  there's nowhere else^1, you&  can stand closer.../%%");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_79", "* Standing so spicey./%%");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_83", "* A-ah..^1. H-human..^1.&* You're leaving?/");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_84", "* I have..^1.&* Something to say to you./");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_85", "* Admittedly^1, I may have had&  limerent feelings for you&  before./");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_86", "* However^1, upon examining my&  own actions^1, I now&  realize.../");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_87", "* I did not love YOU./");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_88", "* I was merely infatuated&  with the CONCEPT of love./");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_89", "* The idea of romance^1, the&  concept of sharing affection&  with another.../");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_90", "* Through these desires^1, I&  built a false concept of&  you in my head./");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_91", "* Such a relationship would&  not have ended well./");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_92", "* In closing^1, I believe it&  is better that I chose to&  say nothing./");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_93", "* Y..^1. y-you i-idiot./%%");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_96", "* I'm not saying it again./%%");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_103", "* H-hey^1, why do you keep&  following me!!!&* You jerk!!!/");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_104", "* Eeeeh^1?&* You're walking in the&  opposite direction...?/");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_105", "* H-hey^1, you think you're too&  good for me^1, huh...?/%%");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_107", "* N-not spicey enough for you^1,&  h-huh.../%%");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_111", "* I..^1. I'm thinking of going&  to the surface.../");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_112", "* Eeeeeh^1?&* You're going to go there&  too?/");
ds_map_add(global.text_data_en, "obj_tsunderplanenpc_113", "* Idiot..^1.&* Quit following me!/%%");
ds_map_add(global.text_data_en, "obj_umbrellabox_62", "* NO!/%%");
ds_map_add(global.text_data_en, "obj_umbrellabox_135", "* (The cavern is too narrow&  for an umbrella.)/%%");
ds_map_add(global.text_data_en, "obj_undyne1_154", "\TP %");
ds_map_add(global.text_data_en, "obj_undyne1_155", "\M5H..^1. HI^1, UNDYNE!&I'M HERE WITH MY&DAILY REPORT.../");
ds_map_add(global.text_data_en, "obj_undyne1_156", "UHHH... REGARDING THAT&HUMAN I CALLED YOU&ABOUT EARLIER.../");
ds_map_add(global.text_data_en, "obj_undyne1_157", "\M0I THINK^1, UH...&HOW DO I.../");
ds_map_add(global.text_data_en, "obj_undyne1_158", "\M1.\M6.. HUH^1?&DID I FIGHT THEM?/");
ds_map_add(global.text_data_en, "obj_undyne1_159", "\M4Y-YES^1!&OF COURSE I DID!/");
ds_map_add(global.text_data_en, "obj_undyne1_160", "\M4I FOUGHT THEM&VALIANTLY!/");
ds_map_add(global.text_data_en, "obj_undyne1_161", "\M5...WHAT^1?\M1 &DID I CAPTURE THEM...?/");
ds_map_add(global.text_data_en, "obj_undyne1_162", "\M0W-W-WELL.../");
ds_map_add(global.text_data_en, "obj_undyne1_163", "\M1NO./");
ds_map_add(global.text_data_en, "obj_undyne1_164", "\M1I TRIED VERY HARD^1,&UNDYNE^1, BUT IN THE&END.../");
ds_map_add(global.text_data_en, "obj_undyne1_165", "\M0I FAILED./");
ds_map_add(global.text_data_en, "obj_undyne1_166", "\M6... W-WHAT?/");
ds_map_add(global.text_data_en, "obj_undyne1_167", "\M1YOU'RE GOING TO TAKE&THE HUMAN'S SOUL&YOURSELF.../");
ds_map_add(global.text_data_en, "obj_undyne1_168", "\M5BUT UNDYNE^1, YOU DON'T&H-HAVE TO DESTROY&THEM^1! \M0YOU SEE.../");
ds_map_add(global.text_data_en, "obj_undyne1_169", "\M1YOU SEE.../%%");
ds_map_add(global.text_data_en, "obj_undyne1_170", "\M6..^1.&.../");
ds_map_add(global.text_data_en, "obj_undyne1_171", "... I UNDERSTAND./");
ds_map_add(global.text_data_en, "obj_undyne1_172", "I'LL HELP YOU IN&ANY WAY I CAN./");
ds_map_add(global.text_data_en, "obj_undyne1_173", "\TS %");
ds_map_add(global.text_data_en, "obj_undyne1_174", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_undyne1_217", "\M0.../");
ds_map_add(global.text_data_en, "obj_undyne1_218", "\M1... I UNDERSTAND./");
ds_map_add(global.text_data_en, "obj_undyne1_219", "I'LL HELP YOU IN&ANY WAY I CAN./%%");
ds_map_add(global.text_data_en, "obj_undyne1_537", "* Yo..^1. did you see the&  way she was staring at&  you...?/");
ds_map_add(global.text_data_en, "obj_undyne1_538", "* That.../");
ds_map_add(global.text_data_en, "obj_undyne1_539", "* ... was AWESOME!/");
ds_map_add(global.text_data_en, "obj_undyne1_540", "* I'm SOOOO jealous!/");
ds_map_add(global.text_data_en, "obj_undyne1_541", "* What'd you do to get her&  attention...^1?&* Ha ha./");
ds_map_add(global.text_data_en, "obj_undyne1_542", "* C'mon^1!&* Let's go watch her beat&  up some bad guys!/%%");
ds_map_add(global.text_data_en, "obj_undyne1_546", "* Yo..^1. did you see the&  way she was staring at&  you...?/");
ds_map_add(global.text_data_en, "obj_undyne1_547", "* That.../");
ds_map_add(global.text_data_en, "obj_undyne1_548", "* ... was AWESOME!/");
ds_map_add(global.text_data_en, "obj_undyne1_549", "* I'm SOOOO jealous!/");
ds_map_add(global.text_data_en, "obj_undyne1_550", "* She was just standing there&  waiting FOREVER^1, and&  then you just...!!!/");
ds_map_add(global.text_data_en, "obj_undyne1_551", "* C'mon^1!&* Let's go watch her beat&  up some bad guys!/%%");
ds_map_add(global.text_data_en, "obj_undyne_echoflower_96", "* Behind you./%%");
ds_map_add(global.text_data_en, "obj_undyne_echoflower_102", "* You aren't gonna tell my&  parents about this^1, are you?/%%");
ds_map_add(global.text_data_en, "obj_undyne_echoflower_299", "* Undyne!!^1!&* I'll help you fight!!!/%%");
ds_map_add(global.text_data_en, "obj_undyne_echoflower_348", "* YO!!!!/");
ds_map_add(global.text_data_en, "obj_undyne_echoflower_349", "* You did it!!^1!&* Undyne is RIGHT in front&  of you!!!/");
ds_map_add(global.text_data_en, "obj_undyne_echoflower_350", "* You've got front row seats&  to her fight!!!/%%");
ds_map_add(global.text_data_en, "obj_undyne_echoflower_388", "* ... wait./");
ds_map_add(global.text_data_en, "obj_undyne_echoflower_389", "* Who's she fighting???/%%");
ds_map_add(global.text_data_en, "obj_undyne_echoflower_419", "* H^1-hey!/");
ds_map_add(global.text_data_en, "obj_undyne_echoflower_420", "* You aren't gonna tell my&  parents about this^1, are you?/%%");
ds_map_add(global.text_data_en, "obj_undyne_ex_781", "* The wind is howling...");
ds_map_add(global.text_data_en, "obj_undyne_ex_808", "* UNDYNE THE UNDYING 99ATK 99DEF&* Heroine reformed by her own&  DETERMINATION to save Earth./^");
ds_map_add(global.text_data_en, "obj_undyne_ex_863", "Damn it.../");
ds_map_add(global.text_data_en, "obj_undyne_ex_864", "So even THAT&power..^1.&It wasn't enough...?/");
ds_map_add(global.text_data_en, "obj_undyne_ex_865", ".../");
ds_map_add(global.text_data_en, "obj_undyne_ex_866", "\E1Heh.../");
ds_map_add(global.text_data_en, "obj_undyne_ex_867", "Heheheh.../");
ds_map_add(global.text_data_en, "obj_undyne_ex_868", "\E2If you..^1./");
ds_map_add(global.text_data_en, "obj_undyne_ex_869", "If you think I'm&gonna give up hope^1,&you're wrong./");
ds_map_add(global.text_data_en, "obj_undyne_ex_870", "Cause I've..^1.&Got my friends&behind me./");
ds_map_add(global.text_data_en, "obj_undyne_ex_871", "\E3Alphys told me that&she would watch me&fight you.../");
ds_map_add(global.text_data_en, "obj_undyne_ex_872", "\E4And if anything went&wrong^1, she would..^1.&evacuate everyone./");
ds_map_add(global.text_data_en, "obj_undyne_ex_873", "\E5By now she's called&ASGORE and told him&to absorb the 6&human SOULs./%%");
ds_map_add(global.text_data_en, "obj_undyne_ex_881", "And with that&power.../%%");
ds_map_add(global.text_data_en, "obj_undyne_ex_893", "This world will&live on...!/%%");
ds_map_add(global.text_data_en, "obj_undyne_friendc_76", "* Hey^1, punk^1!&* What's up!?/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_77", "\E1* A-ACHOO!/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_78", "\E2* Papyrus^1, how can you&  stand this cold?/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_80", "I HAVE NO SKIN./");
ds_map_add(global.text_data_en, "obj_undyne_friendc_82", "* So why don't we&  stand in Grillby's&  instead?/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_84", "BECAUSE I HATE&GREASE./");
ds_map_add(global.text_data_en, "obj_undyne_friendc_86", "* But you don't have&  a stomach!!/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_88", "NO^1, BUT I HAVE&STANDARDS!!!/%%");
ds_map_add(global.text_data_en, "obj_undyne_friendc_92", "* Papyrus.../");
ds_map_add(global.text_data_en, "obj_undyne_friendc_93", "\E1* Why do you live&  in an icy wasteland?/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_95", "THE RENT'S CHEAP./");
ds_map_add(global.text_data_en, "obj_undyne_friendc_97", "* Really^1?&* Don't you live in&  a huge house?/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_99", "YEAH^1, BUT MY&BROTHER PAYS&FOR IT./");
ds_map_add(global.text_data_en, "obj_undyne_friendc_101", "* Where's your brother&  get the money to&  pay for it...?/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_103", "OH^1, THAT'S SIMPLE./");
ds_map_add(global.text_data_en, "obj_undyne_friendc_104", "\E0IT'S A MYSTERY./%%");
ds_map_add(global.text_data_en, "obj_undyne_friendc_112", "* So^1? What are you&  waiting for?/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_113", "* The sooner you get&  it over with^1, the&  better!/%%");
ds_map_add(global.text_data_en, "obj_undyne_friendc_121", "* Hey^1, you sure&  are carrying a&  lot of things./");
ds_map_add(global.text_data_en, "obj_undyne_friendc_122", "* If someone needed&  to give you a thing^1,&  they sure couldn't!/%%");
ds_map_add(global.text_data_en, "obj_undyne_friendc_127", "* What^1?&* You LOST the letter!?/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_128", "* What the HECK!^1?&* How!^1? Why!?/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_129", "\E7* Ughhh..^1.&* This is unbelievable./");
ds_map_add(global.text_data_en, "obj_undyne_friendc_130", "* I should be really&  disappointed in you./");
ds_map_add(global.text_data_en, "obj_undyne_friendc_131", "\E9* But^1, uh^1, to tell&  you the truth^1, I'm&  kind of relieved!/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_132", "\E1* While you were gone^1,&  I actually wrote&  a WAY BETTER letter!/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_133", "\E6* And this time^1, you&  WON'T lose it!!!/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_134", "\E2* I guarantee it!!!/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_135", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_undyne_friendc_136", "* (You got the Undyne Letter&  EX.)/%%");
ds_map_add(global.text_data_en, "obj_undyne_friendc_149", "* Hey^1, I have something&  to give you.../");
ds_map_add(global.text_data_en, "obj_undyne_friendc_150", "\E2* But you're carrying&  way too much!!!/%%");
ds_map_add(global.text_data_en, "obj_undyne_friendc_155", "* Um^1, so^1, I have a&  favor to ask you./");
ds_map_add(global.text_data_en, "obj_undyne_friendc_156", "\E0* Uuuuh^1, I..^1.&* I need you to deliver&  this letter./");
ds_map_add(global.text_data_en, "obj_undyne_friendc_157", "\E9* To Dr. Alphys./");
ds_map_add(global.text_data_en, "obj_undyne_friendc_158", "\E1* Huh!^1?&* Why don't I do it&  myself...?/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_159", "\E8* ... um^1.&* W-well.../");
ds_map_add(global.text_data_en, "obj_undyne_friendc_160", "\E9* I-it's kind of&  personal^1, but we're&  friends..^1. so.../");
ds_map_add(global.text_data_en, "obj_undyne_friendc_161", "\E8* I'll t-tell you.../");
ds_map_add(global.text_data_en, "obj_undyne_friendc_162", "\E6* Hotland SUUUUCKS!!^1!&* I don't wanna have&  to go over there!!!/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_163", "\E3* So here you go./");
ds_map_add(global.text_data_en, "obj_undyne_friendc_164", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_undyne_friendc_165", "* (You got the Undyne's Letter.)/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_167", "* Oh^1, and if you&  read it.../");
ds_map_add(global.text_data_en, "obj_undyne_friendc_168", "\E2* I'll KILL you./");
ds_map_add(global.text_data_en, "obj_undyne_friendc_169", "\E9* Thanks so much^1!&* You're the best!!/%%");
ds_map_add(global.text_data_en, "obj_undyne_friendc_187", "* Hey^1, Alphys^1!&* Alphys!/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_188", "\E1* Do you think we&  can watch something&  with fighting next?/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_189", "\E9* Oh^1, and then...&* Something..^1.&* With princesses!?/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_190", "\E2* Or FIGHTING&  princesses!?/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_192", "\E5* I-I'll see if I&  can manage to find&  any like that^1, Undyne./");
ds_map_add(global.text_data_en, "obj_undyne_friendc_194", "\E6* Yayyyyy!/%%");
ds_map_add(global.text_data_en, "obj_undyne_friendc_199", "\E0* Hey Frisk^1, why don't&  you go say hi to&  Napstablook?/");
ds_map_add(global.text_data_en, "obj_undyne_friendc_200", "\E1* Oh^1, tell them I&  said hi^1, too!/%%");
ds_map_add(global.text_data_en, "obj_undyne_lettercall_113", "* Ring.../");
ds_map_add(global.text_data_en, "obj_undyne_lettercall_115", "\E0* Hey...^1!&* Uh^1, this is&  Undyne.../");
ds_map_add(global.text_data_en, "obj_undyne_lettercall_116", "\E2* (Shut up^1, Papyrus^1!)&* (This was YOUR idea!)/");
ds_map_add(global.text_data_en, "obj_undyne_lettercall_117", "\E1* HUMAN^1!&* You have to deliver&  something for me!/");
ds_map_add(global.text_data_en, "obj_undyne_lettercall_118", "\E9* Uh^1, please?/");
ds_map_add(global.text_data_en, "obj_undyne_lettercall_119", "\E0* I'm at Snowdin&  in front of&  Papyrus's./");
ds_map_add(global.text_data_en, "obj_undyne_lettercall_120", "\E6* See ya^1, punk!/");
ds_map_add(global.text_data_en, "obj_undyne_lettercall_121", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_undyne_lettercall_122", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_undynebattle2_275", "...");
ds_map_add(global.text_data_en, "obj_undynebattle2_278", "Show me what&you've got!");
ds_map_add(global.text_data_en, "obj_undynebattle2_282", "Do your worst!");
ds_map_add(global.text_data_en, "obj_undynebattle2_286", "What's the&matter, scared?");
ds_map_add(global.text_data_en, "obj_undynebattle2_290", "\E6What the hell&is the holdup?");
ds_map_add(global.text_data_en, "obj_undynebattle2_293", "COME ON ALREADY!");
ds_map_add(global.text_data_en, "obj_undynebattle2_295", "IT'S GETTING&HOT IN HERE!");
ds_map_add(global.text_data_en, "obj_undynebattle2_299", "%%%");
ds_map_add(global.text_data_en, "obj_undynebattle2_488", "* Undyne is letting you make&  the first attack.");
ds_map_add(global.text_data_en, "obj_undynebattle2_520", "* UNDYNE - ATK 41 DEF 21&* This time^1, don't hold&  anything back!/^");
ds_map_add(global.text_data_en, "obj_undynebattle2_530", "* You pretend to swing at&  UNDYNE with all your might./%%");
ds_map_add(global.text_data_en, "obj_undynebattle2_578", "I've been&defeated..^1.&My house is in&shambles.../");
ds_map_add(global.text_data_en, "obj_undynebattle2_579", "I even failed to&befriend you./");
ds_map_add(global.text_data_en, "obj_undynebattle2_580", "That's it./");
ds_map_add(global.text_data_en, "obj_undynebattle2_581", "\E8I don't care if&you're my guest&anymore./");
ds_map_add(global.text_data_en, "obj_undynebattle2_582", "\E6One final rematch^1!&All out on both&sides!!!/");
ds_map_add(global.text_data_en, "obj_undynebattle2_583", "IT'S THE ONLY WAY&I CAN REGAIN MY&LOST PRIDE!!!/");
ds_map_add(global.text_data_en, "obj_undynebattle2_584", "NOW COME ON^1!&HIT ME WITH&ALL YOU'VE GOT!&NGAHHHH!!!/%%");
ds_map_add(global.text_data_en, "obj_undynebattle2_599", "* Undyne is letting you make&  the first attack.");
ds_map_add(global.text_data_en, "obj_undynebattle2_645", "What./");
ds_map_add(global.text_data_en, "obj_undynebattle2_646", "\E2That's the best&you can manage?/");
ds_map_add(global.text_data_en, "obj_undynebattle2_647", "\E3Even attacking at&full force.../");
ds_map_add(global.text_data_en, "obj_undynebattle2_648", "You just can't&muster any intent&to hurt me^1,&huh?/");
ds_map_add(global.text_data_en, "obj_undynebattle2_649", "\E4.../");
ds_map_add(global.text_data_en, "obj_undynebattle2_650", "\E7Heh^1, you know&what?/%%");
ds_map_add(global.text_data_en, "obj_undynebattle2_670", "I don't actually&want to hurt you&either./");
ds_map_add(global.text_data_en, "obj_undynebattle2_671", "At first^1, I hated&your stupid&saccharine&schtick^1, but.../");
ds_map_add(global.text_data_en, "obj_undynebattle2_672", "\E3The way you hit&me right now^1,&it.../");
ds_map_add(global.text_data_en, "obj_undynebattle2_673", "\E4Reminded me of&someone I used&to train with./");
ds_map_add(global.text_data_en, "obj_undynebattle2_674", "\E7Now I know you&aren't just some&wimpy loser./");
ds_map_add(global.text_data_en, "obj_undynebattle2_678", "\E9You're a wimpy&loser with a&big heart!/");
ds_map_add(global.text_data_en, "obj_undynebattle2_679", "\E4Just like him.../");
ds_map_add(global.text_data_en, "obj_undynebattle2_680", "\E7.../");
ds_map_add(global.text_data_en, "obj_undynebattle2_681", "\E3Listen^1, human./");
ds_map_add(global.text_data_en, "obj_undynebattle2_682", "\E2It seems that you&and ASGORE are&fated to fight./");
ds_map_add(global.text_data_en, "obj_undynebattle2_683", "\E3But knowing him.../");
ds_map_add(global.text_data_en, "obj_undynebattle2_684", "\E4He probably&doesn't want to./");
ds_map_add(global.text_data_en, "obj_undynebattle2_685", "\E2Talk to him./");
ds_map_add(global.text_data_en, "obj_undynebattle2_686", "\E1I'm sure you can&persuade him to&let you go home./");
ds_map_add(global.text_data_en, "obj_undynebattle2_687", "\E3Eventually^1, some&mean human will&fall down here.../");
ds_map_add(global.text_data_en, "obj_undynebattle2_688", "\E3And I'll take&THEIR soul instead./");
ds_map_add(global.text_data_en, "obj_undynebattle2_689", "\E1That makes sense^1,&right^1?&Fuhuhu./");
ds_map_add(global.text_data_en, "obj_undynebattle2_690", "\E2Oh^1, and if you&DO hurt ASGORE.../");
ds_map_add(global.text_data_en, "obj_undynebattle2_691", "\E7I'll take the&human souls..^1.&Cross the barrier.../");
ds_map_add(global.text_data_en, "obj_undynebattle2_692", "\E6And beat the&hell out of you!/");
ds_map_add(global.text_data_en, "obj_undynebattle2_693", "\E9That's what friends&are for^1, right?/");
ds_map_add(global.text_data_en, "obj_undynebattle2_694", "\E9Fuhuhu!/");
ds_map_add(global.text_data_en, "obj_undynebattle2_695", "\E9Now let's get the&hell out of this&flaming house!/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_401", "Ngahhh!");
ds_map_add(global.text_data_en, "obj_undyneboss_402", "Bring&it on!");
ds_map_add(global.text_data_en, "obj_undyneboss_403", "C'mon!");
ds_map_add(global.text_data_en, "obj_undyneboss_404", "Fuhuhu!");
ds_map_add(global.text_data_en, "obj_undyneboss_405", "Ngahh!!");
ds_map_add(global.text_data_en, "obj_undyneboss_406", "Urahhh!!");
ds_map_add(global.text_data_en, "obj_undyneboss_410", "\E1  You're strong...&  But not strong&  enough!");
ds_map_add(global.text_data_en, "obj_undyneboss_411", "\E4  You're a pain in&  the neck, huh?");
ds_map_add(global.text_data_en, "obj_undyneboss_412", "\E5  DIE ALREADY, YOU&  LITTLE BRAT!");
ds_map_add(global.text_data_en, "obj_undyneboss_416", "%%%");
ds_map_add(global.text_data_en, "obj_undyneboss_427", "  \XAs long as you're&  \GGREEN\X you \RCAN'T&  ESCAPE\X!/");
ds_map_add(global.text_data_en, "obj_undyneboss_428", "  \XUnless you learn&  to \Rface danger&  head-on\X.../");
ds_map_add(global.text_data_en, "obj_undyneboss_429", "  You won't last&  a SECOND against&  ME!/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_437", "  You^1?&  Sparing ME^1?&  Fuhuhuhu!/");
ds_map_add(global.text_data_en, "obj_undyneboss_438", "  How insulting^1!&  I'd NEVER&  surrender to the&  likes of you!/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_439", "  Not bad^1!&  Then how about&  THIS!?/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_442", "\E0  I wanted this to&  be a fair fight./");
ds_map_add(global.text_data_en, "obj_undyneboss_443", "\E1  I thought if I&  beat you like&  this.../");
ds_map_add(global.text_data_en, "obj_undyneboss_444", "  It'd truly show&  how strong&  monsters can be./");
ds_map_add(global.text_data_en, "obj_undyneboss_445", "\E4  BUT NOW???/");
ds_map_add(global.text_data_en, "obj_undyneboss_446", "\E5  I DON'T CARE!/");
ds_map_add(global.text_data_en, "obj_undyneboss_447", "  I'M NOT YOUR&  FREAKING&  KINDERGARTEN&  TEACHER!/");
ds_map_add(global.text_data_en, "obj_undyneboss_448", "\E1  Unless your&  kindergarten&  teacher.../");
ds_map_add(global.text_data_en, "obj_undyneboss_449", "\E5  DOES THIS!/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_459", "\E5  WHAT ARE YOU&  DOING?/");
ds_map_add(global.text_data_en, "obj_undyneboss_460", "  JUST FACE&  UPWARDS!!!/");
ds_map_add(global.text_data_en, "obj_undyneboss_461", "  IT'S NOT HARD!/");
ds_map_add(global.text_data_en, "obj_undyneboss_462", "\E0 %%");
ds_map_add(global.text_data_en, "obj_undyneboss_470", "\E4  Look./");
ds_map_add(global.text_data_en, "obj_undyneboss_471", "\E4  I gave you a&  spear to block&  the bullets with./");
ds_map_add(global.text_data_en, "obj_undyneboss_472", "\E4  Do I have to&  explain this&  any more&  clearly?/");
ds_map_add(global.text_data_en, "obj_undyneboss_473", "\E0 %%");
ds_map_add(global.text_data_en, "obj_undyneboss_481", "\E1  \XWhen I said&  \Rface towards&  danger\X.../");
ds_map_add(global.text_data_en, "obj_undyneboss_482", "\E4  I meant face&  towards the&  bullets!/");
ds_map_add(global.text_data_en, "obj_undyneboss_483", "\E0 %%");
ds_map_add(global.text_data_en, "obj_undyneboss_496", "  For years,&  we've dreamed&  of a happy&  ending...");
ds_map_add(global.text_data_en, "obj_undyneboss_501", "  And now,&  sunlight is&  just within&  our reach!");
ds_map_add(global.text_data_en, "obj_undyneboss_506", "  I won't let&  you snatch it&  away from&  us!");
ds_map_add(global.text_data_en, "obj_undyneboss_510", "\E1  NGAHHH!&  Enough warming&  up!/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_515", "  Heh...&  You're tough!");
ds_map_add(global.text_data_en, "obj_undyneboss_519", "  Mercy^1!&  Ha!/");
ds_map_add(global.text_data_en, "obj_undyneboss_520", "  I still can't&  believe YOU&  want to spare&  ME!/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_528", "  But even if&  you could&  beat me...");
ds_map_add(global.text_data_en, "obj_undyneboss_530", "  But even if&  I spared&  YOU...");
ds_map_add(global.text_data_en, "obj_undyneboss_538", "\X  No human has&  EVER made it&  past&  \RASGORE\X!");
ds_map_add(global.text_data_en, "obj_undyneboss_546", "  Honestly^1,&  killing you&  now is an act&  of mercy...!");
ds_map_add(global.text_data_en, "obj_undyneboss_554", "  ...");
ds_map_add(global.text_data_en, "obj_undyneboss_563", "  Honestly, I'm&  doing you&  a favor...");
ds_map_add(global.text_data_en, "obj_undyneboss_570", "\X  No human has&  EVER made it&  past&  \RASGORE\X!");
ds_map_add(global.text_data_en, "obj_undyneboss_577", "\E1  Killing you&  now is an act&  of mercy!");
ds_map_add(global.text_data_en, "obj_undyneboss_582", "\E4  So STOP being&  so damn&  resilient!/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_587", "  What the&  hell are&  humans made&  out of!?");
ds_map_add(global.text_data_en, "obj_undyneboss_593", "  Anyone else&  would be DEAD&  by now!");
ds_map_add(global.text_data_en, "obj_undyneboss_599", "  Alphys told me&  humans were&  determined...");
ds_map_add(global.text_data_en, "obj_undyneboss_605", "  I see now what&  she meant by&  that!");
ds_map_add(global.text_data_en, "obj_undyneboss_611", "  But I'm&  determined,&  too!");
ds_map_add(global.text_data_en, "obj_undyneboss_616", "  Determined to&  end this&  RIGHT NOW!");
ds_map_add(global.text_data_en, "obj_undyneboss_622", "  ... RIGHT NOW!");
ds_map_add(global.text_data_en, "obj_undyneboss_628", "  ... RIGHT...&  ...&  ... NOW!!");
ds_map_add(global.text_data_en, "obj_undyneboss_634", "  Ha...&  Ha...");
ds_map_add(global.text_data_en, "obj_undyneboss_639", "\E5  NGAHHH!!!&  DIE ALREADY, YOU&  LITTLE BRAT!/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_656", "  YOU'RE GETTING&  IN MY WAY!");
ds_map_add(global.text_data_en, "obj_undyneboss_658", "  I WILL NEVER&  TAKE MERCY FROM&  THE LIKES OF YOU!");
ds_map_add(global.text_data_en, "obj_undyneboss_664", "  I WILL NOT&  BE DEFEATED!");
ds_map_add(global.text_data_en, "obj_undyneboss_666", "  YOU! WILL!&  NEVER! SPARE! ME!");
ds_map_add(global.text_data_en, "obj_undyneboss_672", "\X  YOU'LL NEVER \RESCAPE\X&  FROM ME!!!");
ds_map_add(global.text_data_en, "obj_undyneboss_682", "  Come on^1, is that&  all you've got!?/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_686", "  ... pathetic./");
ds_map_add(global.text_data_en, "obj_undyneboss_687", "  You're going to&  have to try&  harder than that!/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_691", "  S-see how strong&  we are when we&  believe in&  ourselves?/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_695", "  H... heh.../");
ds_map_add(global.text_data_en, "obj_undyneboss_696", "  Had enough yet?/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_700", "\E7  .../");
ds_map_add(global.text_data_en, "obj_undyneboss_701", "  ... I won't..^1.&  ... give up.../%%");
ds_map_add(global.text_data_en, "obj_undyneboss_705", "\E7.../%%");
ds_map_add(global.text_data_en, "obj_undyneboss_1085", "* The wind is howling...");
ds_map_add(global.text_data_en, "obj_undyneboss_1086", "* Undyne flips her spear&  impatiently.");
ds_map_add(global.text_data_en, "obj_undyneboss_1087", "* Flower pollen drifts in&  front of you.");
ds_map_add(global.text_data_en, "obj_undyneboss_1088", "* Water rushes around you.");
ds_map_add(global.text_data_en, "obj_undyneboss_1089", "* The spears pause for a&  moment.");
ds_map_add(global.text_data_en, "obj_undyneboss_1094", "* Undyne points heroically&  towards the sky.");
ds_map_add(global.text_data_en, "obj_undyneboss_1095", "* Undyne flips her spear&  impatiently.");
ds_map_add(global.text_data_en, "obj_undyneboss_1096", "* Undyne suplexes a huge&  boulder^1, just because&  she can.");
ds_map_add(global.text_data_en, "obj_undyneboss_1097", "* Undyne bounces impatiently.");
ds_map_add(global.text_data_en, "obj_undyneboss_1098", "* Undyne flashes a menacing&  smile.");
ds_map_add(global.text_data_en, "obj_undyneboss_1099", "* Undyne draws her finger&  across her neck.");
ds_map_add(global.text_data_en, "obj_undyneboss_1100", "* Undyne holds her fist in&  front of her and shakes&  her head.");
ds_map_add(global.text_data_en, "obj_undyneboss_1101", "* Undyne towers threateningly.");
ds_map_add(global.text_data_en, "obj_undyneboss_1102", "* Undyne thinks of her friends&  and pounds the ground&  with her fists.");
ds_map_add(global.text_data_en, "obj_undyneboss_1103", "* Smells like sushi.");
ds_map_add(global.text_data_en, "obj_undyneboss_1107", "* Undyne's eye is twitching&  involuntarily.");
ds_map_add(global.text_data_en, "obj_undyneboss_1108", "* Undyne is smashing spears&  on the ground.");
ds_map_add(global.text_data_en, "obj_undyneboss_1109", "* Undyne's eyes dart around&  to see if this is&  a prank.");
ds_map_add(global.text_data_en, "obj_undyneboss_1110", "* Undyne is hyperventilating.");
ds_map_add(global.text_data_en, "obj_undyneboss_1111", "* Smells like angry fish.");
ds_map_add(global.text_data_en, "obj_undyneboss_1118", "* Undyne is smiling as if&  nothing is wrong.");
ds_map_add(global.text_data_en, "obj_undyneboss_1119", "* Undyne's body is wavering.");
ds_map_add(global.text_data_en, "obj_undyneboss_1120", "* Undyne's body is losing&  its shape.");
ds_map_add(global.text_data_en, "obj_undyneboss_1121", "* Undyne's body...");
ds_map_add(global.text_data_en, "obj_undyneboss_1122", "* ...");
ds_map_add(global.text_data_en, "obj_undyneboss_1145", "* UNDYNE - ATK 50 DEF 20&* The heroine that NEVER gives&  up./^");
ds_map_add(global.text_data_en, "obj_undyneboss_1168", "* You tell UNDYNE her attacks&  are too easy^1.&* She doesn't care./^");
ds_map_add(global.text_data_en, "obj_undyneboss_1174", "* You tell UNDYNE her attacks&  are too easy^1.&* The bullets get faster./^");
ds_map_add(global.text_data_en, "obj_undyneboss_1176", "* You tell UNDYNE her attacks&  are too easy^1.&* The bullets get unfair./^");
ds_map_add(global.text_data_en, "obj_undyneboss_1182", "* Didn't work./^");
ds_map_add(global.text_data_en, "obj_undyneboss_1195", "* Hamburger Helpers./^");
ds_map_add(global.text_data_en, "obj_undyneboss_1205", "* You told Undyne you didn't&  want to fight^1.&* But nothing happened./^");
ds_map_add(global.text_data_en, "obj_undyneboss_1209", "* You told Undyne you just&  want to be friends.&* She remembers someone.../");
ds_map_add(global.text_data_en, "obj_undyneboss_1210", "* Her attacks became a little&  less extreme./^");
ds_map_add(global.text_data_en, "obj_undyneboss_1215", "* Didn't work./^");
ds_map_add(global.text_data_en, "obj_undyneboss_1278", "En guarde!/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_1281", "\E1  You won't get&  away from me&  this time!/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_1286", "\E4  You've escaped&  from me for&  the LAST time!/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_1292", "\E5  STOP RUNNING&  AWAY!!!/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_1298", "\E5  COME BACK HERE^1,&  YOU LITTLE&  PUNK!!/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_1310", "* Undyne attacks!");
ds_map_add(global.text_data_en, "obj_undyneboss_1336", "Ngahhh.../");
ds_map_add(global.text_data_en, "obj_undyneboss_1337", "You were stronger...&Than I thought.../");
ds_map_add(global.text_data_en, "obj_undyneboss_1338", "So then..^1.&... this is where..^1.&... it ends.../");
ds_map_add(global.text_data_en, "obj_undyneboss_1339", ".../%%");
ds_map_add(global.text_data_en, "obj_undyneboss_1365", "  No.../%%");
ds_map_add(global.text_data_en, "obj_undyneboss_1386", "NO!/");
ds_map_add(global.text_data_en, "obj_undyneboss_1387", "I won't die!/");
ds_map_add(global.text_data_en, "obj_undyneboss_1388", "Alphys..^1.&Asgore..^1.&Papyrus.../");
ds_map_add(global.text_data_en, "obj_undyneboss_1389", "Everyone is counting&on me to protect&them!/");
ds_map_add(global.text_data_en, "obj_undyneboss_1390", "NNNNGAH!/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_1401", "Human!/");
ds_map_add(global.text_data_en, "obj_undyneboss_1402", "In the name of&everybody's hopes&and dreams.../");
ds_map_add(global.text_data_en, "obj_undyneboss_1403", "I WILL DEFEAT YOU!/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_1410", "* Undyne looks determined.");
ds_map_add(global.text_data_en, "obj_undyneboss_1424", ".../");
ds_map_add(global.text_data_en, "obj_undyneboss_1425", "Ha..^1. ha.../");
ds_map_add(global.text_data_en, "obj_undyneboss_1426", "... Alphys.../");
ds_map_add(global.text_data_en, "obj_undyneboss_1427", "This is what I&  was afraid of.../");
ds_map_add(global.text_data_en, "obj_undyneboss_1428", "This is why I&  never told you.../");
ds_map_add(global.text_data_en, "obj_undyneboss_1429", ".../%%");
ds_map_add(global.text_data_en, "obj_undyneboss_1438", "No..^1.&No!/");
ds_map_add(global.text_data_en, "obj_undyneboss_1439", "Not yet!/");
ds_map_add(global.text_data_en, "obj_undyneboss_1440", "I won't die!/%%");
ds_map_add(global.text_data_en, "obj_undyneboss_1449", "NGAHHHHHHHH!!^2! %%");
ds_map_add(global.text_data_en, "obj_undyneboss_1460", " I WON'T DIE^3! %%");
ds_map_add(global.text_data_en, "obj_undyneboss_1470", " I WON'T DIE^3! %%");
ds_map_add(global.text_data_en, "obj_undyneboss_1480", " I WON'T DIE^3! %%");
ds_map_add(global.text_data_en, "obj_undyneboss_1490", " I^2 WON'T^2 %%");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_114", "* Well^1, that was&  fun^1, huh?/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_115", "\E6* We'll have to hang&  out again another&  time...!/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_116", "\E9* But^1, uh^1, somewhere&  else I guess./");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_117", "\E0* In the meantime^1,&  I guess I'll go&  hang with Papyrus./");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_118", "* So if you need&  me^1, drop by Snowdin^1,&  OK!?/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_119", "\E1* OH^1!&* And if you ever&  need help.../");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_120", "\E9* Just give Papyrus a&  ring^1, ok?/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_121", "\E0* Since we're in the&  same spot^1, I'll be&  able to talk too!/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_122", "\E6* Well^1, see ya&  later^1, punk!!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_140", "* Well^1, that was&  fun^1, huh?/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_141", "\E6* We'll have to hang&  out again another&  time...!/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_142", "\E9* But^1, uh^1, somewhere&  else I guess./");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_143", "\E0* In the meantime^1,&  I guess I'll go&  hang with Papyrus./");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_144", "* So if you need&  me^1, drop by Snowdin^1,&  OK!?/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_145", "\E1* OH^1!&* And if you ever&  need help.../");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_146", "\E9* Just give Papyrus a&  ring^1, ok?/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_147", "\E0* Since we're in the&  same spot^1, I'll be&  able to talk too!/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_148", "\E6* Well^1, see ya&  later^1, punk.../");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_149", "\E1* OH!!^1!&* WAIT!!/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_150", "\E0* This is sudden^1, but.../");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_151", "\E9* Can you deliver&  something for me?/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_152", "\E0* Papyrus suggested&  that I ask you./");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_153", "\E3* But he told me when&  I still hated you^1,&  so.../");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_154", "\E1* Uh^1! Anyway!!^1!&* Here^1! Just take it!/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_155", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_156", "* (You got the Undyne's&  Letter.)/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_158", "* Well^1, what are you&  waiting for!?/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_159", "\E1* Go deliver it!!!/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_160", "* .../");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_161", "\E9* Uhhhh..^1.&* Oh^1, yeah.../");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_162", "* It's addressed to&  Dr. Alphys./");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_163", "\E6* OK^1, see you!!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_169", "* Well^1, that was&  fun^1, huh?/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_170", "\E6* We'll have to hang&  out again another&  time...!/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_171", "\E9* But^1, uh^1, somewhere&  else I guess./");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_172", "\E0* In the meantime^1,&  I guess I'll go&  hang with Papyrus./");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_173", "* So if you need&  me^1, drop by Snowdin^1,&  OK!?/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_174", "\E1* OH^1!&* And if you ever&  need help.../");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_175", "\E9* Just give Papyrus a&  ring^1, ok?/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_176", "\E0* Since we're in the&  same spot^1, I'll be&  able to talk too!/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_177", "\E6* Well^1, see ya&  later^1, punk.../");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_178", "\E1* OH!!^1!&* WAIT!!/");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_179", "\E0* This is sudden^1, but.../");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_180", "* Can you.../");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_181", "\E1* Hey^1, wait^1!&* Your inventory's&  full./");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_182", "\E9* Uh^1, well^1, I'll be&  at Papyrus's./");
ds_map_add(global.text_data_en, "obj_undynedate_afterward_183", "\E6* Come see me when&  you have less&  stuff!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_120", "HERE^1, UNDYNE./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_121", "MY FRIEND BROUGHT&A GIFT FOR YOU^1,&ON THEIR OWN!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_143", "* Uhhh..^1. thanks./%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_177", "* I'll^1, uh^1, put it&  with the others./%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_236", "* So are we ready&  to start?/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_250", "WHOOPSY DOOPSY^1!&I JUST REMEMBERED!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_251", "I HAVE TO GO&TO THE BATHROOM!!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_252", "\E0YOU TWO HAVE&FUN!!!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_335", "DANG^1!&WHAT A SHAME.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_336", "\E2I THOUGHT UNDYNE&COULD BE FRIENDS&WITH YOU./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_337", "\E3BUT I GUESS.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_338", "\E3I OVERESTIMATED&HER./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_339", "\E3SHE'S JUST NOT&UP TO THE&CHALLENGE./%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_351", "* CHALLENGE!^1?&* What!?/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_352", "\E0* Papyrus^1!&* Wait a second...!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_367", "* Darnit!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_368", "* He thinks I can't&  be friends with&  YOU!?/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_369", "\E6* Fuhuhu^1!&* What a joke!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_370", "* I could make friends&  with a wimpy loser&  like you any day!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_371", "\E2* I'll show him!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_372", "\E3* Listen up^1, human./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_373", "\E2* We're not just&  going to be&  friends./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_374", "\E3* We're going to&  be.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_375", "\M1* BESTIES./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_376", "* I'll make you&  like me so much.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_377", "\E1* You won't be able&  to think of anyone&  else!!!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_378", "\E3* Fuhuhuhu^1!&* It's the PERFECT&  REVENGE!!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_379", "* .../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_380", "\E9* Why don't you&  have a seat?/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_415", "* Oh^1, leaving so soon?/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_416", "\E3* No^1.&* No you're not./%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_471", "* Comfortable?/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_472", "* I'll get you&  something to drink./%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_561", "* All set^1!&* What would you like?/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_604", "* HEY!!^1!&* DON'T GET UP!!!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_605", "* YOU'RE THE GUEST!^1!&* SIT DOWN AND ENJOY&  YOURSELF!!!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_606", "* .../%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_614", "\E9* Um^1, why not just&  point to what you&  want?/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_615", "* You can use the&  spear!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_643", "\E4* Y'know^1, I was a&  pretty hotheaded&  kid./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_644", "* Once^1, to prove I was&  the strongest^1, I tried&  to fight ASGORE./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_645", "\E1* Emphasis on TRIED./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_646", "\E0* I couldn't land&  a single blow&  on him!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_647", "\E4* And worse^1, the whole&  time^1, he refused&  to fight back!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_648", "\E7* I was so&  humiliated.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_649", "\E0* Afterwards^1, he&  apologized and said&  something goofy.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_650", "* \"Excuse me^1, do you&  want to know how&  to beat me?\"/");ds_map_add(global.text_data_en, "obj_undynedate_inside_651", "\E0* I said yes^1, and&  from then on^1, he&  trained me./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_652", "\E4* One day^1, during&  practice^1, I finally&  knocked him down./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_653", "\E7* I felt..^1. bad./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_654", "\E9* But he was&  beaming.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_655", "\E6* I had never seen&  someone more proud to&  get their butt kicked./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_656", "\E1* ... oh!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_657", "\E9* I almost forgot&  about your tea!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_658", "* Just a moment!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_696", "* Wait a second./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_697", "* Papyrus..^1.&* His cooking lesson.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_698", "\M2* HE WAS SUPPOSED&  TO HAVE THAT RIGHT&  NOW!!!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_699", "\E3* And if HE's not&  here to have it.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_700", "\E2* YOU'LL HAVE TO&  HAVE IT FOR HIM!!!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_833", "* That's right!!!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_834", "\E1* NOTHING has brought&  Papyrus and I&  closer than cooking!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_835", "\E3* Which means that if&  I give you his&  lesson.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_836", "\E2* WE'LL BECOME CLOSER&  THAN YOU CAN&  EVER IMAGINE!!!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_837", "\E6* Fuhuhu!!^1! Afraid!^1?&* We're gonna be best&  friends!!!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1000", "* Ready!^1?&* It's spaghetti time!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1001", "* Let's start with the&  sauce!!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1128", "* Uhh^1, we'll just scrape&  this into a bowl&  later./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1129", "\E1* But for NOW!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1235", "* Alright^1!&* Now it's time&  to stir the pasta!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1236", "* As a general rule&  of thumb^1, the more&  you stir.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1237", "\E1* THE BETTER IT IS!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1238", "\E0* Ready^1?&* Let's do it!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1326", "\M0* Fuhuhuhu^1!&* That's the stuff!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1328", "\E0* Alright^1, now for&  the final step:/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1329", "\E1* TURN UP THE HEAT!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1330", "\E0* Let the stovetop&  symbolize your&  passion!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1331", "\E1* Let your hopes and&  dreams turn into&  burning fire!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1332", "\E2* READY^1?&* Don't hold anything&  back!!!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1444", "* Ah./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1445", "* Man^1, no wonder&  Papyrus sucks at&  cooking./%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1465", "* So what's next^1?&* Scrapbooking^1?&* Friendship bracelets?/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1466", "* .../%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1475", "* ... oh^1, who am I&  kidding./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1476", "* I really screwed this&  up^1, didn't I?/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1477", "\E4* I can't force you to&  like me^1, human./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1478", "\E4* Some people just&  don't get along&  with each other./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1479", "\E7* I understand if&  you feel that&  way about me./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1480", "\E4* And if we can't&  be friends.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1481", "\E7* That's okay./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1482", "\E7* Because..^1.&* If we're not&  friends.../%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1490", "\E2*\M2 IT MEANS I CAN&  DESTROY YOU WITHOUT&  REGRET!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1641", "* It'll take a moment&  for the water to&  boil./%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1671", "* Okay^1, it's all&  done!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1771", "* Here we are./%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1833", "* Careful^1, it's hot./%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1850", "* It's not THAT hot!^1!&* Just drink it already!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1851", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1852", "* (You take a sip of the&  tea.^1)&* (It's burning...)/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1853", "* (But other than that^1,&  it's pretty good.)/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1855", "* It's pretty good^1,&  right?/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1856", "\E6* Nothing but the best&  for my ABSOLUTELY&  PRECIOUS FRIEND!!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1873", "\E9* Hey.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1874", "\E9* You know...&* It's kind of strange&  you chose THAT tea./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1875", "\E4* Golden flower tea.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1876", "\E0* That's ASGORE's&  favorite kind./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1877", "\E4* Actually^1, now that&  I think about it.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1878", "\E9* You kind of remind&  me of him./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1879", "\E6* You're both TOTAL&  weenies!!!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1880", "\E7* ... sort of./%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1898", "\E4* Y'know^1, I was a&  pretty hotheaded&  kid./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1899", "* Once^1, to prove I was&  the strongest^1, I tried&  to fight ASGORE./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1900", "\E1* Emphasis on TRIED./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1901", "\E0* I couldn't land&  a single blow&  on him!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1902", "\E4* And worse^1, the whole&  time^1, he refused&  to fight back!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1903", "\E7* I was so&  humiliated.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1904", "\E0* Afterwards^1, he&  apologized and said&  something goofy.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1905", "* \"Excuse me^1, do you&  want to know how&  to beat me?\"/");ds_map_add(global.text_data_en, "obj_undynedate_inside_1906", "\E0* I said yes^1, and&  from then on^1, he&  trained me./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1907", "\E4* One day^1, during&  practice^1, I finally&  knocked him down./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1908", "\E7* I felt..^1. bad./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1909", "\E9* But he was&  beaming.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1910", "\E6* I had never seen&  someone more proud to&  get their butt kicked./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1911", "\E4* Anyway^1, long story&  short^1, he kept training&  me.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1912", "\E0* And now I'm the&  head of the Royal&  Guard!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1913", "\E6* So I'm the one&  who gets to train&  dorks to fight!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1914", "\E9* ... like^1, uh^1, Papyrus./%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1935", "\E4* But^1, um^1, to be&  honest.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1936", "\E9*... I don't know if.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1937", "\E7* I can ever let&  Papyrus into the&  Royal Guard./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1938", "\E1* Don't tell him I&  said that!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1939", "\E4* He's just..^1.&* Well.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1940", "\E9* I mean^1, it's not&  that he's weak./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1941", "\E1* He's actually&  pretty freaking&  tough!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1942", "\E7* It's just that..^1.&* He's.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1943", "\E1* He's too innocent&  and nice!!!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1944", "\E7* I mean^1, look^1, he&  was SUPPOSED to&  capture you.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1945", "\E5* And he ended up&  being FRIENDS with&  you instead!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1946", "\E1* I could NEVER send&  him into battle!/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1947", "\E7* He'd get ripped&  into little smiling&  shreds./");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1948", "\E7* That's part of why.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1949", "\E9* I started teaching&  him how to cook^1,&  you know?/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1950", "\E7* So^1, um^1, maybe he&  can do something&  else with his life./%%");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1978", "\E1* Oh^1, sorry^1, I was&  talking for so&  long.../");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1979", "\E9* You're out of tea^1,&  aren't you?/");
ds_map_add(global.text_data_en, "obj_undynedate_inside_1980", "\E0* I'll get you some&  more./%%");
ds_map_add(global.text_data_en, "obj_undynedate_outside_155", "PSST./");
ds_map_add(global.text_data_en, "obj_undynedate_outside_156", "\E0MAKE SURE TO&GIVE HER THIS!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_outside_173", "SHE LOVES THESE!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_outside_241", "* Hi^1, Papyrus!/");
ds_map_add(global.text_data_en, "obj_undynedate_outside_243", "* Ready for your extra-&  private^1, one-on-one&  training?/");
ds_map_add(global.text_data_en, "obj_undynedate_outside_245", "YOU BET I AM!/");
ds_map_add(global.text_data_en, "obj_undynedate_outside_246", "AND I BROUGHT&A FRIEND!/%%");
ds_map_add(global.text_data_en, "obj_undynedate_outside_276", "* Hi^1, I don't think&  we've.../");
ds_map_add(global.text_data_en, "obj_undynedate_outside_277", "\E2* .../");
ds_map_add(global.text_data_en, "obj_undynedate_outside_278", "\M9* .../");
ds_map_add(global.text_data_en, "obj_undynedate_outside_280", "\M0.../");
ds_map_add(global.text_data_en, "obj_undynedate_outside_282", "\E1* Why don't^1.&* You two^1.&* Come in?/%%");
ds_map_add(global.text_data_en, "obj_undynedate_outside_364", "* (You hear someone shouting&  a whisper at you from&  inside the house.)/");
ds_map_add(global.text_data_en, "obj_undynedate_outside_366", "NO^1!&YOU CAN'T ESCAPE&FRIENDSHIP!!/%%");
ds_map_add(global.text_data_en, "obj_undyneencounter2_329", "* Yo..^1. did you see that!?/");
ds_map_add(global.text_data_en, "obj_undyneencounter2_330", "* Undyne just.../");
ds_map_add(global.text_data_en, "obj_undyneencounter2_331", "* ... TOUCHED ME!/");
ds_map_add(global.text_data_en, "obj_undyneencounter2_332", "* I'm never washing my face&  ever again...!/");
ds_map_add(global.text_data_en, "obj_undyneencounter2_333", "* Man^1, are you unlucky./");
ds_map_add(global.text_data_en, "obj_undyneencounter2_334", "* If you were standing just&  a LITTLE bit to the left...!/");
ds_map_add(global.text_data_en, "obj_undyneencounter2_335", "* Yo^1, don't worry^1!&* I'm sure we'll see her&  again!/%%");
ds_map_add(global.text_data_en, "obj_undyneencounter2_338", "* ... yo^1, did you notice^1?&* She seemed really mad&  about something!/");
ds_map_add(global.text_data_en, "obj_undyneencounter2_339", "* She looked liked she was&  gonna blast me to pieces!/");
ds_map_add(global.text_data_en, "obj_undyneencounter2_340", "* But..^1. sigh..^1.&* Then she decided to put&  me down.../");
ds_map_add(global.text_data_en, "obj_undyneencounter2_341", "* Yo^1!&* There's always next time^1,&  right^1? Let's go!/%%");
ds_map_add(global.text_data_en, "obj_undyneencounter4_255", "It sounds like it&came from over&here.../");
ds_map_add(global.text_data_en, "obj_undyneencounter4_256", "Oh^1! You've fallen&down^1, haven't you.../");
ds_map_add(global.text_data_en, "obj_undyneencounter4_257", "Are you okay?/");
ds_map_add(global.text_data_en, "obj_undyneencounter4_258", "Here^1, get up.../");
ds_map_add(global.text_data_en, "obj_undyneencounter4_259", ".../");
ds_map_add(global.text_data_en, "obj_undyneencounter4_260", "\[C]^1, huh?/");
ds_map_add(global.text_data_en, "obj_undyneencounter4_261", "That's a nice name./%%");
ds_map_add(global.text_data_en, "obj_undyneencounter4_275", " My name is     %%");
ds_map_add(global.text_data_en, "obj_undynefall_99", "* (Someone has meticulously&  cleaned all the slime off of&  this snail.)/%%");
ds_map_add(global.text_data_en, "obj_undynetrash_69", "* (The trashcan is full&  of broken spears.)/%%");
ds_map_add(global.text_data_en, "obj_undynetrash_72", "* (The trashcan is empty.)/%%");
ds_map_add(global.text_data_en, "obj_undynetrash_76", "* (You found a trashcan.)/");
ds_map_add(global.text_data_en, "obj_undynetrash_77", "* (Inside the trashcan&  was a key^1, barely visible&  to the naked eye...)/");
ds_map_add(global.text_data_en, "obj_undynetrash_78", "* (You take it.)/%%");
ds_map_add(global.text_data_en, "obj_undynetrash_87", "* (A garbage can.^1)&* (But it's pretty cute.)/%%");
ds_map_add(global.text_data_en, "obj_undynetrash_88", "* (It's too dark to see&  near the walls.)/%%");
ds_map_add(global.text_data_en, "obj_undynetrash_91", "* (There's a message crumpled&  up in the trash can.)/");
ds_map_add(global.text_data_en, "obj_undynetrash_92", "* (It's in a strange kind&  of handwriting.)/");
ds_map_add(global.text_data_en, "obj_undynetrash_93", "* (It says...)/");
ds_map_add(global.text_data_en, "obj_undynetrash_94", "* (I KNOW WHAT YOU DID.)/%%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_157", "* Seven./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_158", "\W* Seven human souls^1, and&  \RKing ASGORE\W will become&  a god./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_159", "* Six./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_160", "* That's how many we have&  collected thus far./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_161", "* Understand?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_162", "* Through your seventh and&  final soul^1, this world will&  be transformed./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_163", "* First^1, however^1, as is customary&  for those who make it this&  far.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_164", "* I shall tell you the tragic&  tale of our people./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_165", "* It all started^1, long ago.../%%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_190", "* .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_191", "* No^1, you know what?/%%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_199", "* SCREW IT^3! %%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_206", "* WHY SHOULD I TELL THAT STORY^1  %%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_213", "* WHEN YOU'RE ABOUT TO DIE!?^1!   %%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_220", "* NGAAAAAHHHHHHHHHHHHHHHHH^1! %%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_325", "* YOU!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_326", "* You're standing in&  the way of everybody's&  hopes and dreams!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_327", "\E4* Alphys's history books&  made me think&  humans were cool.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_328", "\E0* ... with their giant&  robots and flowery&  swordswomen./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_329", "\E1* BUT YOU?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_330", "\E2* You're just a coward!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_331", "\E3* Hiding behind that kid&  so you could run away&  from me again!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_332", "* You abandoned your&  friend just so you&  could run away!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_335", "\E2* And let's not forget&  your wimpy goody-two-&  shoes-schtick!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_336", "\E6* Oooh^1! I'm making such a&  difference by hugging&  random strangers!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_337", "*\E3 You know what would&  be more valuable&  to everyone?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_338", "*\E1 IF YOU WERE DEAD!!!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_339", "\E0* That's right^1, human^1!&* Your continued&  existence is a crime!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_340", "* Your life is all&  that stands between&  us and our freedom!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_341", "* Right now^1, I can&  feel everyone's hearts&  pounding together!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_342", "\E0* Everyone's been&  waiting their whole&  lives for this moment!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_343", "\E0* But we're not&  nervous at all./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_344", "\E1* When everyone puts&  their hearts together^1,&  they can't lose!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_345", "\E5* Now^1, human^1!&* Let's end this^1,&  right here^1, right now./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_346", "\E0* I'll show you how&  determined monsters&  can be!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_347", "\E0* Step forward when&  you're ready^1!&* Fuhuhuhu!/%%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_351", "\E1* And^1! And!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_352", "\E7*... and something's&  been bothering me^1,&  too./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_353", "\E4* The whole time I was&  chasing after you.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_354", "\E7* I felt something..^1.&* Strange./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_355", "* The echoes of something&  warm^1, something.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_356", "\E9* Something like \"I miss&  being friends with you.\"/");ds_map_add(global.text_data_en, "obj_undynetrigger_boss_357", "\E2* BUT THAT'S RIDICULOUS!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_358", "\E6I WOULD NEVER GET&  CHUMMY WITH A COWARD&  LIKE YOU!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_359", "\E1* You^1!&* You must have been&  mind-controlling me!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_360", "\E6* Manipulating people to&  make them like you..^1.&* What a Grade-A FREAK!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_361", "\E1* Now enough^1!&* For everyone's hopes^1!&* For everyone's dreams!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_362", "\E2* And for my own&  freaking dignity!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_363", "\E3* I^1, UNDYNE^1, will&  knock you down!/%%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_369", "* YOU!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_370", "* You're standing in&  the way of everybody's&  hopes and dreams!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_371", "\E4* Alphys's history books&  made me think humans&  were compassionate.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_372", "\E1* BUT YOU?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_373", "\E5* You're just a&  remorseless criminal!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_374", "* You wander through the&  caverns^1, attacking&  anyone in your path./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_375", "\E4* Self-defense^1?&* Please./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_376", "* You didn't kill them&  because you had to./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_377", "\E5* You killed them&  because it was&  easy for you./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_378", "* Because it was fun&  for you./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_379", "\E4* Do you think it&  was fun when I&  found out...?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_381", "* Do you think it's&  fun when people's&  family members.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_382", "* ... never come home^1?&* Is that fun?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_386", "* Shyren^1, who was&  just learning to&  sing.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_387", "* ... was dead^1, because&  of the whims of&  a single human?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_392", "* A teenage comedian&  who fell in with&  the wrong crowd.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_393", "* ... was dead^1, because&  of the whims of&  a single human?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_399", "* Doggo^1, who always&  made me laugh.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_400", "* ... was dead^1, because&  of the whims of&  a single human?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_405", "* Those two sweet dogs^1,&  who always took care&  of each other.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_406", "* ... were dead^1, because&  of the whims of&  a single human?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_412", "* That big dog^1, who&  wanted nothing more&  than to play.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_413", "* ... was dead^1, because&  of the whims of&  a single human?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_419", "* Lesser Dog^1, who&  wanted nothing more&  than affection.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_420", "* ... was dead^1, because&  of the whims of&  a single human?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_425", "* The Snowdin Canine&  Unit had been&  completely decimated./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_426", "* My troops and friends^1,&  destroyed..^1.&* Is that fun?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_429", "\E5* No./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_430", "\E3* But your time's up^1,&  villain!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_431", "\E0* You won't hurt anyone&  else./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_432", "* A knight in shining&  armor has appeared./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_433", "\E4* And all the pain&  you inflicted on&  the fallen.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_434", "* Every hope^1, every&  dream you've turned&  to dust.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_435", "\E0* She's gonna send&  right back through&  her spear!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_436", "\E1* NGAHHH!!!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_437", "\E0* I'll show you how&  determined monsters&  truly are!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_438", "* Come on^1!&* Step forward and&  let's end this!/%%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_468", "* .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_469", "* Forget it./%%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_490", "* Look./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_491", "* Papyrus didn't come&  to his meeting&  today./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_492", "* Say what you want&  about him./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_493", "* He's weird^1, he's&  naive^1, he's self-&  absorbed.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_494", "\E5* But Papyrus has&  NEVER missed a&  meeting./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_495", "\E4* And no matter what&  time you call him&  on the phone.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_496", "* Night^1, day^1, afternoon^1,&  morning.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_497", "\E5* He ALWAYS answers&  within the first&  two rings./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_498", "\E4* .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_499", "* But now he's gone./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_500", "* And his brother&  isn't around^1,&  either./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_501", "\E5* .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_502", "* What did you do&  to him?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_503", "* What did you DO&  TO HIM?/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_504", "\E4* Papyrus^1, who I have&  trained every day.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_505", "* Even though I KNOW&  he's too goofy to&  ever hurt anyone.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_506", "\E5* .../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_507", "\E4* Go ahead^1.&* Prepare however you&  want./");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_508", "\E5* But when you step&  forward.../");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_509", "\E1* I will KILL you./%%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss_638", "*TEST!!!/%%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss2_99", "* That's it^1, then...!/");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss2_100", "* No more running away!/%%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss2_103", "* I KNEW you would&  come back here!/%%");
ds_map_add(global.text_data_en, "obj_undynetrigger_boss2_116", "* HERE I COME!!!!!!!");
ds_map_add(global.text_data_en, "obj_undynetrigger_dry_122", "* Armor..^1. so..^1. hot..^1./");
ds_map_add(global.text_data_en, "obj_undynetrigger_dry_123", "* But I can't..^1.&* Give up.../%%");
ds_map_add(global.text_data_en, "obj_vegetoid_172", "Contains&Vitamin&A");
