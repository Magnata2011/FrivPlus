	yy += 18
	draw_set_color(c_white)
	draw_set_font(fnt_maintext)
	if (os_type == os_xboxone)
	{
		for (i = 0; i < 18; i++)
		{
			this_x = (xx + 30)
			if ((i % 2) == 1)
				this_x = xx2
			name = scr_gettext(("credits_short_thanks2_" + string((i + 1))))
			draw_text(this_x, yy, string_hash_to_newline(name))
			if ((i % 2) == 1 || i == 17)
				yy += 18
		}
	}
	else
	{
		for (i = 0; i < 15; i++)
		{
			this_x = (xx + 30)
			if ((i % 2) == 1)
				this_x = xx2
			name = scr_gettext(("credits_short_thanks2_" + string((i + 1))))
			draw_text(this_x, yy, string_hash_to_newline(name))
			if ((i % 2) == 1 || i == 14)
				yy += 18
		}
	}
	yy += 10
	scr_setfont(fnt_ja_maintext)
}
