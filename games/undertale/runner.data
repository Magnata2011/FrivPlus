ds_map_add(global.text_data_en, "obj_fakefroggit_508", "* Froggit didn't understand&  what you said^1, but was&  flattered anyway./^");
ds_map_add(global.text_data_en, "obj_fakefroggit_518", "* Froggit didn't understand&  what you said^1, but was&  scared anyway./^");
