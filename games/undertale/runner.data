					global.msg[8] = scr_gettext("scr_papcall_3999")
					global.msg[9] = scr_gettext("scr_papcall_4000")
					global.msg[10] = scr_gettext("scr_papcall_4001")
					global.msg[11] = scr_gettext("scr_papcall_4002")
