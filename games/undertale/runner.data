			return button_ps4_circle;
		}
		if (os_type == os_psvita)
		{
			if (type == 1)
				return buttonL_vita_circle;
			return button_vita_circle;
		}
		if (os_type == os_switch)
		{
			if (type == 1)
				return buttonL_nx_a;
			return button_nx_a;
		}
		if (os_type == os_xboxone)
		{
			if (type == 1)
				return buttonL_xbox_b;
			return button_xbox_b;
		}
	}
	if (button == gp_face3)
	{
