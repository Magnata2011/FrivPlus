ds_map_add(global.text_data_en, "obj_finalknight_515", "* Knight Knight smashes her&  morningstar.");
ds_map_add(global.text_data_en, "obj_finalknight_516", "* Knight Knight breathes deeply.");
ds_map_add(global.text_data_en, "obj_finalknight_517", "* Knight Knight watches quietly.");
ds_map_add(global.text_data_en, "obj_finalknight_518", "* Knight Knight's armor emits&  a dark sheen.");
ds_map_add(global.text_data_en, "obj_finalknight_519", "* Smells like stardust.");
ds_map_add(global.text_data_en, "obj_finalknight_520", "* Knight Knight is snoring.");
ds_map_add(global.text_data_en, "obj_finalknight_553", "* KNIGHT KNIGHT - ATK 36 DEF 36&* This megaton mercenary wields&  the Good Morningstar./^");
ds_map_add(global.text_data_en, "obj_finalknight_562", "* You ask Knight Knight about&  her day^1.&* There's no response./^");
ds_map_add(global.text_data_en, "obj_finalknight_566", "* You ask Knight Knight about&  her day./^");
ds_map_add(global.text_data_en, "obj_finalknight_570", "* You talk to Knight Knight^1.&* She hums something in&  her sleep.../^");
ds_map_add(global.text_data_en, "obj_finalknight_586", "* You sing an old lullaby^1.&* Knight Knight starts to look&  sleepy.../^");
ds_map_add(global.text_data_en, "obj_finalknight_588", "* You sing Shyren's song^1.&* Knight Knight starts to look&  sleepy.../^");
ds_map_add(global.text_data_en, "obj_finalknight_592", "* You keep singing^1.&* Knight Knight closes its&  eyes a bit.../^");
ds_map_add(global.text_data_en, "obj_finalknight_596", "* You keep singing^1.&* Nothing happened./^");
ds_map_add(global.text_data_en, "obj_finalknight_601", "* You keep singing^1.&* Knight Knight falls asleep./^");
ds_map_add(global.text_data_en, "obj_flowey_bulletmaster_562", "* Flowey's DEFENSE&  dropped to 0^4! %%");
ds_map_add(global.text_data_en, "obj_flowey_bulletmaster_564", "%%%");
ds_map_add(global.text_data_en, "obj_flowey_master_1067", "* No... NO!!!/");
ds_map_add(global.text_data_en, "obj_flowey_master_1068", "* This CAN'T be&  happening!!!/");
ds_map_add(global.text_data_en, "obj_flowey_master_1069", "* You... YOU.../%%");
ds_map_add(global.text_data_en, "obj_flowey_master_1070", "%%%");
ds_map_add(global.text_data_en, "obj_flowey_master_1124", "* You^2 IDIOT^5. %%");
ds_map_add(global.text_data_en, "obj_flowey_master_1181", "* Hee hee hee./");
ds_map_add(global.text_data_en, "obj_flowey_master_1182", "* Did you REALLY&  think.../");
ds_map_add(global.text_data_en, "obj_flowey_master_1183", "* You could&  defeat ME!?/");
ds_map_add(global.text_data_en, "obj_flowey_master_1184", "\E5* I am the GOD of&  this world./");
ds_map_add(global.text_data_en, "obj_flowey_master_1185", "\E6* And YOU?/");
ds_map_add(global.text_data_en, "obj_flowey_master_1186", "* You're HOPELESS./");
ds_map_add(global.text_data_en, "obj_flowey_master_1187", "* Hopeless and&  alone.../");
ds_map_add(global.text_data_en, "obj_flowey_master_1188", "\E0* Golly^1, that's&  right!/");
ds_map_add(global.text_data_en, "obj_flowey_master_1189", "\E7* Your WORTHLESS&  friends.../");
ds_map_add(global.text_data_en, "obj_flowey_master_1190", "\E8* ... can't save&  you now./");
ds_map_add(global.text_data_en, "obj_flowey_master_1191", "\E1* Call for help^1.&* I dare you./");
ds_map_add(global.text_data_en, "obj_flowey_master_1192", "\E5* Cry into the&  darkness!/");
ds_map_add(global.text_data_en, "obj_flowey_master_1193", "\E8\"Mommy^1! Daddy^1!\"&\"Somebody help!\"/");ds_map_add(global.text_data_en, "obj_flowey_master_1194", "\E5* See what good&  it does you!/%%");
ds_map_add(global.text_data_en, "obj_flowey_master_1195", "%%%");
ds_map_add(global.text_data_en, "obj_flowey_master_1196", "%%%");
ds_map_add(global.text_data_en, "obj_flowey_master_1197", "%%%");
ds_map_add(global.text_data_en, "obj_flowey_master_1198", "%%%");
ds_map_add(global.text_data_en, "obj_flowey_master_1216", "* You..^1. uh.../");
ds_map_add(global.text_data_en, "obj_flowey_master_1217", "\E4* Would you STOP that?/");
ds_map_add(global.text_data_en, "obj_flowey_master_1218", "\E6* Anyway^1, YOU!/");
ds_map_add(global.text_data_en, "obj_flowey_master_1260", "(You called for help.^4) %%");
ds_map_add(global.text_data_en, "obj_flowey_master_1261", "%%%");
ds_map_add(global.text_data_en, "obj_flowey_master_1276", "* .../");
ds_map_add(global.text_data_en, "obj_flowey_master_1277", "\E0* But nobody came./");
ds_map_add(global.text_data_en, "obj_flowey_master_1278", "\E2* Boy^1!&* What a shame!/");
ds_map_add(global.text_data_en, "obj_flowey_master_1279", "\E7* Nobody else.../");
ds_map_add(global.text_data_en, "obj_flowey_master_1280", "* Is gonna get to&  see you DIE!!!/%%");
ds_map_add(global.text_data_en, "obj_flowey_master_1281", "%%%");
ds_map_add(global.text_data_en, "obj_flowey_master_1320", "* What^4? %");
ds_map_add(global.text_data_en, "obj_flowey_master_1321", "\E1* How'd you...^4? %");
ds_map_add(global.text_data_en, "obj_flowey_master_1322", "\E2* Well^1, I'll jus^4t%%");
ds_map_add(global.text_data_en, "obj_flowey_master_1323", "%%%");
ds_map_add(global.text_data_en, "obj_flowey_master_1347", "\E4* Wh..^4. %");
ds_map_add(global.text_data_en, "obj_flowey_master_1348", "* Where are my&  powers!^5? %%");
ds_map_add(global.text_data_en, "obj_flowey_master_1349", "%%%");
ds_map_add(global.text_data_en, "obj_flowey_master_1374", "\E5* The souls...^5? %");
ds_map_add(global.text_data_en, "obj_flowey_master_1375", "* What are they&  doing^5? %%");
ds_map_add(global.text_data_en, "obj_flowey_master_1376", "%%%");
ds_map_add(global.text_data_en, "obj_flowey_master_1401", "* NO!^1! NO!!!!^4! %");
ds_map_add(global.text_data_en, "obj_flowey_master_1402", "* YOU CAN'T DO&  THAT!!^4! %");
ds_map_add(global.text_data_en, "obj_flowey_master_1403", "* YOU'RE SUPPOSED&  TO OBEY ME!^4! %");
ds_map_add(global.text_data_en, "obj_flowey_master_1404", "* STOP!!^1!&  STOP IT!!!!^4! %%");
ds_map_add(global.text_data_en, "obj_flowey_master_1405", "%%%");
ds_map_add(global.text_data_en, "obj_flowey_master_1422", "* STOOOOPPPP!!!!!");
ds_map_add(global.text_data_en, "obj_flowey_master_1423", "%%%");
ds_map_add(global.text_data_en, "obj_flowey_wilt_309", "* Flowey ran away.");
ds_map_add(global.text_data_en, "obj_flowey_wilt_348", "I knew you had it in you^3!%%");
ds_map_add(global.text_data_en, "obj_flowey_wilt_470", "\M1I just can't understand.../%%");
ds_map_add(global.text_data_en, "obj_flowey_wilt_481", "\M1I can't understand!/%%");
ds_map_add(global.text_data_en, "obj_flowey_wilt_492", "\M1I can't understand./%%");
ds_map_add(global.text_data_en, "obj_flowey_wilt_503", "\M1... why are you being.../");
ds_map_add(global.text_data_en, "obj_flowey_wilt_504", "\M1... so nice to me?/%%");
ds_map_add(global.text_data_en, "obj_flowey_wilt_514", "\M1... why?/%%");
ds_map_add(global.text_data_en, "obj_flowey_wilt_524", "\M1...?/%%");
ds_map_add(global.text_data_en, "obj_flowey_wilt_534", "\M1.../%%");
ds_map_add(global.text_data_en, "obj_flowey_wilt_545", "\M1I'll kill everyone you love./%%");
ds_map_add(global.text_data_en, "obj_flowey_wilt_556", "\M1I'll kill everyone./%%");
ds_map_add(global.text_data_en, "obj_flowey_wilt_568", "I'll kill you./%%");
ds_map_add(global.text_data_en, "obj_flowey_wilt_579", "\M1If you let me live.../");
ds_map_add(global.text_data_en, "obj_flowey_wilt_580", "\M1I'll come back./%%");
ds_map_add(global.text_data_en, "obj_flowey_wilt_591", "\M1Sparing me won't change&anything./");
ds_map_add(global.text_data_en, "obj_flowey_wilt_592", "\M1Killing me is the only&way to end this./%%");
ds_map_add(global.text_data_en, "obj_flowey_wilt_601", ".../");
ds_map_add(global.text_data_en, "obj_flowey_wilt_602", "\E1What are you doing?/");
ds_map_add(global.text_data_en, "obj_flowey_wilt_603", "\E2Do you really think I've&learned anything from this?/");
ds_map_add(global.text_data_en, "obj_flowey_wilt_604", "\E3No./%%");
ds_map_add(global.text_data_en, "obj_floweybattle1_268", "Is this a joke^2?&Are you braindead^2?&RUN^2. INTO^2. THE.&friendliness pellets/");
ds_map_add(global.text_data_en, "obj_floweybattle1_269", "/");
ds_map_add(global.text_data_en, "obj_floweybattle1_270", "/");
ds_map_add(global.text_data_en, "obj_floweybattle1_271", "/");
ds_map_add(global.text_data_en, "obj_floweybattle1_272", "/");
ds_map_add(global.text_data_en, "obj_floweybattle1_273", "/");
ds_map_add(global.text_data_en, "obj_floweybattle1_274", "/");
ds_map_add(global.text_data_en, "obj_floweybattle1_275", "/");
ds_map_add(global.text_data_en, "obj_floweybattle1_276", "/");
ds_map_add(global.text_data_en, "obj_floweybattle1_277", "/");
ds_map_add(global.text_data_en, "obj_floweybattle1_278", "stop it");
ds_map_add(global.text_data_en, "obj_floweytrigger_122", "\E1* Hello..^1.&* Are you all right?/");
ds_map_add(global.text_data_en, "obj_floweytrigger_123", "* You must be so lost&  and confused.../");
ds_map_add(global.text_data_en, "obj_floweytrigger_124", "\E2* Ah, do not be&  afraid^1, my child./");
ds_map_add(global.text_data_en, "obj_floweytrigger_125", "\W* I am \BTORIEL\W,&  caretaker of the&  \RRUINS\W./");
ds_map_add(global.text_data_en, "obj_floweytrigger_126", "* I pass through here&  every day to see if&  anyone has fallen down./");
ds_map_add(global.text_data_en, "obj_floweytrigger_127", "* You are the first&  human to come here&  in a long time./");
ds_map_add(global.text_data_en, "obj_floweytrigger_128", "* I will do my best&  to protect you during&  your time here./");
ds_map_add(global.text_data_en, "obj_floweytrigger_129", "* Come^1!&* I shall guide you&  through the catacombs./%%");
ds_map_add(global.text_data_en, "obj_floweytrigger_316", "\W* Howdy^2!&* I'm\Y FLOWEY\W.^2 &* \YFLOWEY\W the \YFLOWER\W!/");
ds_map_add(global.text_data_en, "obj_floweytrigger_317", "* Hee hee hee.../");
ds_map_add(global.text_data_en, "obj_floweytrigger_318", "* Why'd you make me&  introduce myself?/");
ds_map_add(global.text_data_en, "obj_floweytrigger_319", "* It's rude to act&  like you don't&  know who I am./");
ds_map_add(global.text_data_en, "obj_floweytrigger_320", "* Someone ought to teach&  you proper manners./");
ds_map_add(global.text_data_en, "obj_floweytrigger_321", "* I guess little old me&  will have to do./");
ds_map_add(global.text_data_en, "obj_floweytrigger_322", "* Ready^2?&* Here we go!/%%");
ds_map_add(global.text_data_en, "obj_floweytrigger_327", "* Don't you have anything&  better to do?/%%");
ds_map_add(global.text_data_en, "obj_floweytrigger_338", "* Error/%%");
ds_map_add(global.text_data_en, "obj_floweytrigger_342", "* Really^1, \[C]?/");
ds_map_add(global.text_data_en, "obj_floweytrigger_343", "\E5* Well^1, do what you&  will./");
ds_map_add(global.text_data_en, "obj_floweytrigger_344", "\E4* I'll be waiting for&  you!/%%");
ds_map_add(global.text_data_en, "obj_floweytrigger_348", "\E0* Hey^1.&* Remember./");
ds_map_add(global.text_data_en, "obj_floweytrigger_349", "\E2* DON'T kill anyone./");
ds_map_add(global.text_data_en, "obj_floweytrigger_350", "\E2* .../");
ds_map_add(global.text_data_en, "obj_floweytrigger_351", "\E1* I can't believe this&  is a REAL thing I&  have to remind you./");
ds_map_add(global.text_data_en, "obj_floweytrigger_352", "\E0* Hee hee hee.../");
ds_map_add(global.text_data_en, "obj_floweytrigger_353", "* Good luck!/%%");
ds_map_add(global.text_data_en, "obj_floweytrigger_357", "* Remember.../");
ds_map_add(global.text_data_en, "obj_floweytrigger_358", "\E1* THIS time^1, you've&  GOT to become friends&  with everyone./");
ds_map_add(global.text_data_en, "obj_floweytrigger_359", "\E2* OK?/");
ds_map_add(global.text_data_en, "obj_floweytrigger_360", "\E5* If you DON'T^1, you'll&  be miserable FOREVER./");
ds_map_add(global.text_data_en, "obj_floweytrigger_361", "\E1* And we wouldn't want&  THAT^1, would we?/");
ds_map_add(global.text_data_en, "obj_floweytrigger_362", "\E0* No..^1.&* We just want you&  to be happy^1, right?/");
ds_map_add(global.text_data_en, "obj_floweytrigger_363", "* Good luck. /%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_158", "* Error/%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_162", "* Hee hee hee.../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_163", "\E2* I hope you like your&  choice./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_164", "* After all^1, it's not&  as if you can go&  back and change fate./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_165", "\E0* In this world^1, it's kill&  or be killed./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_166", "\E2* That old hag thought&  she could break the&  rules./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_167", "\E1* She tried so hard&  to save you humans./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_168", "\E0* But when it came&  down to it.../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_169", "\TF*\E5 Hee hee.../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_170", "\E4* SHE COULDN'T EVEN&  SAVE HERSELF./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_171", "* WHAT AN IDIOT!!/%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_175", "\E2* Heheheheh./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_176", "* You just can't&  get enough^1, can you!?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_177", "\E4* .../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_178", "\E6* How many more&  times will you&  kill her?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_179", "* Ha ha ha ha ha.../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_180", "\E4*\TF You disgusting animal./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_181", "* You didn't even&  TRY to spare her./%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_186", "* Wow^1, you really&  can't get enough./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_187", "\E5* You kind of remind&  me of myself./%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_195", "* Wow^1, you're utterly&  repulsive./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_196", "\E6* You spared her life.../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_197", "* Then you decided that&  just wasn't interesting&  enough for you./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_198", "\E7* So you murdered her&  just to see what&  would happen./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_199", "\E5* You killed her out&  of boredom./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_200", "* Truly disgusting.../%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_203", "* Hee hee.../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_204", "\E4* You naive idiot./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_205", "* Do you think you&  are the only one&  with that power?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_206", "\E4* The power to reshape&  the world.../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_207", "* Purely by your&  own determination./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_208", "* The ability to&  play God!/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_209", "* The ability to \"SAVE.\"/");ds_map_add(global.text_data_en, "obj_floweytrigger2_210", "\E0* I thought I was&  the only one with&  that power^1. But.../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_211", "\E1* I can't SAVE anymore./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_212", "* Apparently YOUR&  desires for this&  world override MINE./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_213", "\E5* Well well./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_214", "* Enjoy that power&  while you can./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_215", "\E4* I'll be watching./%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_226", "* Hahaha.../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_227", "\E1* You're not really human^1,&  are you?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_228", "\E1* No.^2 You're empty inside^2.&* \E4Just like me^1.&* In fact.../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_229", "\E8* You're \[C],^1 right?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_230", "\E0* We're still inseparable^1,&  after all these years.../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_231", "* Listen^1.&* I have a plan to become&  all powerful./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_232", "\E2* Even more powerful than&  you and your stolen&  soul./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_233", "\E4* Let's destroy everything&  in this wretched world./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_234", "\E6* Everyone^1, everything in&  these \E7worthless&  memories.../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_235", "\E5* Let's turn 'em all&  to dust./%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_245", "* Clever.&* Verrrryyy clever./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_246", "* You think you're really&  smart^1, don't you?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_247", "\E0* In this world^1, it's kill&  or be killed./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_248", "\E1* So you were able to&  play by your own&  rules./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_249", "*\E4 You spared the life&  of a single person./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_250", "* Hee hee hee.../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_253", "* Froggit^1, Whimsun^1.&* Vegetoid^1, Loox^1.&* Migosp^1, Moldsmal./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_254", "* Think about those names./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_255", "* Do you think any of&  those monsters have&  families?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_256", "* Do you think any of&  them have friends?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_257", "\E6* Each one could have&  been someone else's&  Toriel./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_258", "\E7* Selfish brat./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_259", "* Somebody is dead&  because of you./%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_264", "\E2* I bet you feel&  really great./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_265", "* You didn't kill&  anybody this time./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_266", "\E0* But what will you&  do if you meet a&  relentless killer?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_267", "* You'll die and you'll&  die and you'll&  die./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_268", "\E1* Until you tire of&  trying./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_269", "\E0* What will you do&  then?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_270", "\E5* Will you kill&  out of frustration?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_271", "* Or will you give&  up entirely on&  this world.../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_272", "\E4* ... and let ME inherit&  the power to control&  it?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_273", "\E5* I am the prince of&  this world's future./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_274", "* Don't worry^1, my little&  monarch^1, my plan&  isn't regicide./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_275", "* This is SO much&  more interesting./%%");
ds_map_add(global.text_data_en, "obj_floweytrigger2_283", "* But don't act so&  cocky./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_284", "* I know what you did./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_285", "\E6* You murdered her./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_286", "\E7* And then you went&  back^1, because you&  regretted it./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_287", "* Ha ha ha ha.../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_288", "\E5* You naive idiot./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_289", "* Do you think you&  are the only one&  with that power?/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_290", "\E4* The power to reshape&  the world.../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_291", "* Purely by your&  own determination./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_292", "* The ability to&  play God!/");
ds_map_add(global.text_data_en, "obj_floweytrigger2_293", "* The ability to \"SAVE.\"/");ds_map_add(global.text_data_en, "obj_floweytrigger2_294", "\E0* I thought I was&  the only one with&  that power^1. But.../");
ds_map_add(global.text_data_en, "obj_floweytrigger2_295", "\E1* I can't SAVE anymore./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_296", "* Apparently YOUR&  desires for this&  world override MINE./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_297", "\E5* Well well./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_298", "* Enjoy that power&  while you can./");
ds_map_add(global.text_data_en, "obj_floweytrigger2_299", "\E4* I'll be watching./%%");
ds_map_add(global.text_data_en, "obj_forcedright_142", "* What's that smell^1?&* (Where's that smell?)/");
ds_map_add(global.text_data_en, "obj_forcedright_143", "* If you're a smell^1...&* (... identify yoursmellf!)/%%");
ds_map_add(global.text_data_en, "obj_forcedright_175", "* Hmmm..^1.&* Here's that weird smell.../");
ds_map_add(global.text_data_en, "obj_forcedright_176", "* It makes me want to&  eliminate./");
ds_map_add(global.text_data_en, "obj_forcedright_177", "* (... Eliminate YOU!)/%%");
ds_map_add(global.text_data_en, "obj_forcedright_220", "* Dogs can pet other dogs??^1?&* (A new world has opened&  up for us...)/");
ds_map_add(global.text_data_en, "obj_forcedright_221", "* Thanks^1, weird puppy!/%%");
ds_map_add(global.text_data_en, "obj_forcedright_224", "* Weird smells can bring&  good things..^1.&* (Friendly fun fetch!)/");
ds_map_add(global.text_data_en, "obj_forcedright_225", "* Thanks^1, weird smell^1!&* (It sure was fun to&  \"stick\" together!)/%%");ds_map_add(global.text_data_en, "obj_friendc_event_115", "  Frisk!/");
ds_map_add(global.text_data_en, "obj_friendc_event_116", "  This is all just&  a bad dream...!/");
ds_map_add(global.text_data_en, "obj_friendc_event_117", "  Please^1, wake up...!/%%");
ds_map_add(global.text_data_en, "obj_friendc_event_181", "* Oh^1!&* You are awake^1!&* Thank goodness!/");
ds_map_add(global.text_data_en, "obj_friendc_event_183", "* W-we were so&  worried...!/");
ds_map_add(global.text_data_en, "obj_friendc_event_184", "* It felt like you&  were out forever!/");
ds_map_add(global.text_data_en, "obj_friendc_event_186", "* Yeah^1! Any longer and&  I would have freaked&  out!/");
ds_map_add(global.text_data_en, "obj_friendc_event_187", "\E2* Tell us next time&  you decide to take&  a nap^1, okay!?/");
ds_map_add(global.text_data_en, "obj_friendc_event_189", "* yeah^1.&* you made papyrus cry&  like a baby./");
ds_map_add(global.text_data_en, "obj_friendc_event_191", "WHAT!^1!&I DIDN'T CRY!!^1!&I DON'T CRY!!/");
ds_map_add(global.text_data_en, "obj_friendc_event_192", "\E3I JUST..^1.&CAUGHT SOMETHING&IN MY EYE./");
ds_map_add(global.text_data_en, "obj_friendc_event_194", "* what did you catch?/");
ds_map_add(global.text_data_en, "obj_friendc_event_196", "TEARS!!!/");
ds_map_add(global.text_data_en, "obj_friendc_event_198", "* Now^1, now./");
ds_map_add(global.text_data_en, "obj_friendc_event_199", "* The important part&  is that Frisk is&  all right./");
ds_map_add(global.text_data_en, "obj_friendc_event_200", "* Here^1, Frisk^1.&* Why not drink some&  tea?/");
ds_map_add(global.text_data_en, "obj_friendc_event_201", "* It'll make you feel&  better./");
ds_map_add(global.text_data_en, "obj_friendc_event_203", "* Errr..^1.&* How about we give&  them space^1, first?/");
ds_map_add(global.text_data_en, "obj_friendc_event_204", "\E2* They must be very&  exhausted./");
ds_map_add(global.text_data_en, "obj_friendc_event_205", "\E8* Though^1, from what^1,&  I am not certain./");
ds_map_add(global.text_data_en, "obj_friendc_event_206", "\E1* Frisk..^1.&* We do not remember&  exactly what happened./");
ds_map_add(global.text_data_en, "obj_friendc_event_207", "\E1* There was a flower..^1.&* And then^1, everything&  went white./");
ds_map_add(global.text_data_en, "obj_friendc_event_208", "\E0* But now the barrier&  is gone./");
ds_map_add(global.text_data_en, "obj_friendc_event_209", "* When you are ready^1,&  we will all return&  to the surface./");
ds_map_add(global.text_data_en, "obj_friendc_event_210", "* It seems the door to&  the east will lead&  us there now./");
ds_map_add(global.text_data_en, "obj_friendc_event_211", "\E2* But before then.../");
ds_map_add(global.text_data_en, "obj_friendc_event_212", "\E0* Perhaps you might&  want to take a&  walk?/");
ds_map_add(global.text_data_en, "obj_friendc_event_213", "* You can say goodbye&  to all of your&  wonderful friends./");
ds_map_add(global.text_data_en, "obj_friendc_event_214", "* Do as you wish^1.&* We will all wait&  for you here./%%");
ds_map_add(global.text_data_en, "obj_friendscene_182", "\E4What a miserable&creature^1, torturing&such a poor^1,&innocent, youth.../");
ds_map_add(global.text_data_en, "obj_friendscene_183", "\E0Do not be afraid^1,&my child./");
ds_map_add(global.text_data_en, "obj_friendscene_184", "\E0It is I^1, TORIEL^1,&your friend and&guardian./");
ds_map_add(global.text_data_en, "obj_friendscene_185", "\E1At first^1, I thought&I would let you&make your journey&alone.../");
ds_map_add(global.text_data_en, "obj_friendscene_186", "\E4But I could not&stop worrying about&you./");
ds_map_add(global.text_data_en, "obj_friendscene_187", "\E4Your adventure must&have been so&treacherous./");
ds_map_add(global.text_data_en, "obj_friendscene_188", "\E2... and ultimately^1,&it would burden you&with a horrible&choice./");
ds_map_add(global.text_data_en, "obj_friendscene_189", "To leave this place^1,&you would have to&take the life of&another person./");
ds_map_add(global.text_data_en, "obj_friendscene_190", "\E2You would have to&defeat ASGORE./");
ds_map_add(global.text_data_en, "obj_friendscene_191", "\E4However..^1.&I realized.../");
ds_map_add(global.text_data_en, "obj_friendscene_192", "\E1I cannot allow that./");
ds_map_add(global.text_data_en, "obj_friendscene_193", "It is not right to&sacrifice someone&simply to let&someone leave here./");
ds_map_add(global.text_data_en, "obj_friendscene_194", "\E4Is that not what&I have been trying to&prevent this&whole time?/");
ds_map_add(global.text_data_en, "obj_friendscene_195", "\E1So^1, for now^1, let&us suspend this&battle./");
ds_map_add(global.text_data_en, "obj_friendscene_196", "\E4As terrible as&ASGORE is.../");
ds_map_add(global.text_data_en, "obj_friendscene_197", "\E0He deserves mercy^1,&too./%%");
ds_map_add(global.text_data_en, "obj_friendscene_226", "Tori..^1.&You&came&back...!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_236", "\E5Do not \"Tori\" me^1,&Dreemurr!/");ds_map_add(global.text_data_en, "obj_friendscene_237", "\E2You pathetic whelp./");
ds_map_add(global.text_data_en, "obj_friendscene_238", "If you really wanted&to free our kind.../");
ds_map_add(global.text_data_en, "obj_friendscene_239", "You could have gone&through the barrier&after you got ONE&SOUL.../");
ds_map_add(global.text_data_en, "obj_friendscene_240", "... taken six SOULs&from the humans^1, then&come back and freed&everyone peacefully./");
ds_map_add(global.text_data_en, "obj_friendscene_241", "\E5But instead^1, you made&everyone live in&despair.../");
ds_map_add(global.text_data_en, "obj_friendscene_242", "Because you would&rather wait here^1,&meekly hoping another&human never comes./%%");
ds_map_add(global.text_data_en, "obj_friendscene_271", ".../");
ds_map_add(global.text_data_en, "obj_friendscene_272", "... Tori.../");
ds_map_add(global.text_data_en, "obj_friendscene_273", "You're right.../");
ds_map_add(global.text_data_en, "obj_friendscene_274", "I am a miserable&creature.../");
ds_map_add(global.text_data_en, "obj_friendscene_275", "... but^1, do you think&we can at least be&friends again?/%%");
ds_map_add(global.text_data_en, "obj_friendscene_301", "(Sigh.)/");
ds_map_add(global.text_data_en, "obj_friendscene_302", "NO^1,&Asgore./%%");
ds_map_add(global.text_data_en, "obj_friendscene_353", "Ngahhhhhh!!^1!&ASGORE^1! Human!!/");
ds_map_add(global.text_data_en, "obj_friendscene_354", "Nobody fight each&other!!!/");
ds_map_add(global.text_data_en, "obj_friendscene_355", "Everyone's gonna&make friends^1, or&else I'll...!!/");
ds_map_add(global.text_data_en, "obj_friendscene_356", "I'll.../");
ds_map_add(global.text_data_en, "obj_friendscene_357", ".../%%");
ds_map_add(global.text_data_en, "obj_friendscene_376", "Hello^1.&I am&TORIEL./");
ds_map_add(global.text_data_en, "obj_friendscene_377", "Are you&the&human's&friend?/");
ds_map_add(global.text_data_en, "obj_friendscene_378", "It is&nice to&meet&you./%%");
ds_map_add(global.text_data_en, "obj_friendscene_388", "Uh^1,&yeah...?/");
ds_map_add(global.text_data_en, "obj_friendscene_389", "Nice to&meet&you!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_413", "Hey&ASGORE^1,&is that&your ex?/");
ds_map_add(global.text_data_en, "obj_friendscene_414", "Jeez^1.&That's&rough^1,&buddy./%%");
ds_map_add(global.text_data_en, "obj_friendscene_450", "H-hey^1!/");
ds_map_add(global.text_data_en, "obj_friendscene_451", "Nobody&hurt&each&other!!/");
ds_map_add(global.text_data_en, "obj_friendscene_452", ".../");
ds_map_add(global.text_data_en, "obj_friendscene_453", ".../%%");
ds_map_add(global.text_data_en, "obj_friendscene_477", "Oh^1!&Are you&another&friend?/");
ds_map_add(global.text_data_en, "obj_friendscene_478", "I am&TORIEL^1.&Hello!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_487", "Uh^1,&h-h-hi!/");
ds_map_add(global.text_data_en, "obj_friendscene_488", ".../");
ds_map_add(global.text_data_en, "obj_friendscene_489", "(THERE'S&TWO OF&THEM???)/%%");
ds_map_add(global.text_data_en, "obj_friendscene_546", "HEY^1!&NOBODY FIGHT&ANYONE!/");
ds_map_add(global.text_data_en, "obj_friendscene_547", "IF ANYONE FIGHTS&ANYONE...!/");
ds_map_add(global.text_data_en, "obj_friendscene_548", "THEN I'LL!!^1!&BE FORCED!!!/");
ds_map_add(global.text_data_en, "obj_friendscene_549", "TO ASK UNDYNE&FOR HELP!!!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_572", "Hello!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_582", "OH^1!&HELLO^1, YOUR&MAJESTY!/");
ds_map_add(global.text_data_en, "obj_friendscene_583", "PSST^1!&HEY^1, HUMAN.../");
ds_map_add(global.text_data_en, "obj_friendscene_584", "DID ASGORE&SHAVE...?/");
ds_map_add(global.text_data_en, "obj_friendscene_585", "AND..^1.&CLONE HIMSELF????/%%");
ds_map_add(global.text_data_en, "obj_friendscene_631", "hey&guys..^1.&what's&up?/%%");
ds_map_add(global.text_data_en, "obj_friendscene_644", "That&voice&...!!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_678", "Hello^1,&I think&we&may.../");
ds_map_add(global.text_data_en, "obj_friendscene_679", "Know&each&other?/%%");
ds_map_add(global.text_data_en, "obj_friendscene_691", "oh hey..^1.&i recognize your&voice^1, too./%%");
ds_map_add(global.text_data_en, "obj_friendscene_705", "I am&TORIEL./");
ds_map_add(global.text_data_en, "obj_friendscene_706", "So nice&to meet&you./%%");
ds_map_add(global.text_data_en, "obj_friendscene_717", "the&name's&sans./");
ds_map_add(global.text_data_en, "obj_friendscene_718", "and^1, uh^1,&same./%%");
ds_map_add(global.text_data_en, "obj_friendscene_733", "Oh^1!&Wait^1,&then...!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_760", "This must be your&brother^1, Papyrus!/");
ds_map_add(global.text_data_en, "obj_friendscene_761", "Greetings^1, Papyrus^1!&It is so nice to&finally meet you!/");
ds_map_add(global.text_data_en, "obj_friendscene_762", "Your brother has&told me so much&about you./%%");
ds_map_add(global.text_data_en, "obj_friendscene_779", "WOWIE.../");
ds_map_add(global.text_data_en, "obj_friendscene_780", "I CAN'T BELIEVE&ASGORE'S CLONE&KNOWS WHO I&AM!!!/");
ds_map_add(global.text_data_en, "obj_friendscene_781", "THIS IS THE BEST&DAY OF MY&LIFE!!!!!!!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_795", "Hey^1, Papyrus.../");
ds_map_add(global.text_data_en, "obj_friendscene_796", "What does a skeleton&tile his roof&with?/%%");
ds_map_add(global.text_data_en, "obj_friendscene_808", "HMMM..^1.&SNOW-PROOF ROOF&TILES???/%%");
ds_map_add(global.text_data_en, "obj_friendscene_819", "No^1, silly^1!&A skeleton tiles&his roof with.../");
ds_map_add(global.text_data_en, "obj_friendscene_820", "SHIN-gles!!!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_846", "I CHANGED MY&MIND!!!/");
ds_map_add(global.text_data_en, "obj_friendscene_847", "THIS IS THE WORST&DAY OF MY LIFE!!!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_863", "Come on^1, ASGORE^1!&It's gonna be OK!/");
ds_map_add(global.text_data_en, "obj_friendscene_864", "There are plenty&of fish in the&sea.../%%");
ds_map_add(global.text_data_en, "obj_friendscene_880", "Y-yeah^1, ASGORE!!/");
ds_map_add(global.text_data_en, "obj_friendscene_881", "Undyne's totally&right about that&fish thing!/");
ds_map_add(global.text_data_en, "obj_friendscene_882", "S-sometimes you've&just got to^1, uh.../");
ds_map_add(global.text_data_en, "obj_friendscene_883", "S-stop going after&furry boss monsters&and^1, uh.../");
ds_map_add(global.text_data_en, "obj_friendscene_884", "J-just get to know&a really cute&fish...?/");
ds_map_add(global.text_data_en, "obj_friendscene_885", ".../");
ds_map_add(global.text_data_en, "obj_friendscene_886", "It's a metaphor./%%");
ds_map_add(global.text_data_en, "obj_friendscene_910", "Well./");
ds_map_add(global.text_data_en, "obj_friendscene_911", "I think&it's a&good&analogy./%%");
ds_map_add(global.text_data_en, "obj_friendscene_945", "OH MY GOD!/");
ds_map_add(global.text_data_en, "obj_friendscene_946", "\XWILL YOU TWO&JUST \RSMOOCH\X &ALREADY!?/");
ds_map_add(global.text_data_en, "obj_friendscene_947", "THE AUDIENCE IS&DYING FOR SOME&ROMANTIC ACTION!!!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_962", "HEY^1, SHUT UP!!!/");
ds_map_add(global.text_data_en, "obj_friendscene_963", "Man^1, the nerve of&that guy!/");
ds_map_add(global.text_data_en, "obj_friendscene_964", "Right^1,&Alphys!??/");
ds_map_add(global.text_data_en, "obj_friendscene_965", ".../");
ds_map_add(global.text_data_en, "obj_friendscene_966", "Uh^1, Alphys?/%%");
ds_map_add(global.text_data_en, "obj_friendscene_982", ".../");
ds_map_add(global.text_data_en, "obj_friendscene_983", "No./");
ds_map_add(global.text_data_en, "obj_friendscene_984", "He's&right./");
ds_map_add(global.text_data_en, "obj_friendscene_985", "LET'S&DO&IT./%%");
ds_map_add(global.text_data_en, "obj_friendscene_1003", "??????????????/");
ds_map_add(global.text_data_en, "obj_friendscene_1004", "Well??^1? Uh??^1?&I guess??^1?&If you want to??^1?&Then????/");
ds_map_add(global.text_data_en, "obj_friendscene_1005", "Don't hold anything&back!!!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1047", "W-wait!/");
ds_map_add(global.text_data_en, "obj_friendscene_1048", "Not in&front of&the&human!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1066", "Uhh^1, right^1!&S-sorry^1, I got a&little carried&away there./%%");
ds_map_add(global.text_data_en, "obj_friendscene_1082", "Hee hee hee./");
ds_map_add(global.text_data_en, "obj_friendscene_1083", "My child^1, it&seems as if you&must stay here&for a while./");
ds_map_add(global.text_data_en, "obj_friendscene_1084", "\E6But looking at&all the great&friends you have&made.../");
ds_map_add(global.text_data_en, "obj_friendscene_1085", "\E0I think.../");
ds_map_add(global.text_data_en, "obj_friendscene_1086", "\E7I think you will&be happy here./%%");
ds_map_add(global.text_data_en, "obj_friendscene_1108", "H-hey^1, that&reminds me./");
ds_map_add(global.text_data_en, "obj_friendscene_1109", "Papyrus..^1.&YOU called&everyone here^1,&right?/");
ds_map_add(global.text_data_en, "obj_friendscene_1110", "Well^1, besides^1,&uh^1, her./");
ds_map_add(global.text_data_en, "obj_friendscene_1111", "Uh^1, anyway..^1.&If I got here&before you.../");
ds_map_add(global.text_data_en, "obj_friendscene_1112", "How did you know&how to call&everybody?/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1122", "LET'S&JUST&SAY.../%%");
ds_map_add(global.text_data_en, "obj_friendscene_1132", "A TINY&FLOWER&HELPED&ME./%%");
ds_map_add(global.text_data_en, "obj_friendscene_1146", "A tiny..^1.&flower?/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1194", "\E0You IDIOTS./");
ds_map_add(global.text_data_en, "obj_friendscene_1195", "\E2While you guys were&having your little&pow-wow.../");
ds_map_add(global.text_data_en, "obj_friendscene_1196", "\E6I took the human&SOULS!/");
ds_map_add(global.text_data_en, "obj_friendscene_1197", "\E5And now^1, not only&are THOSE under my&power.../");
ds_map_add(global.text_data_en, "obj_friendscene_1198", "\E6But all of your&FRIENDS' SOULS are&gonna be mine^1, too!/");
ds_map_add(global.text_data_en, "obj_friendscene_1199", "\E0Hee hee hee./");
ds_map_add(global.text_data_en, "obj_friendscene_1200", "\E1And you know what&the best part is?/");
ds_map_add(global.text_data_en, "obj_friendscene_1201", "\E5It's all your&fault./");
ds_map_add(global.text_data_en, "obj_friendscene_1202", "\E6It's all because&you MADE THEM&love you./");
ds_map_add(global.text_data_en, "obj_friendscene_1203", "\E7All the time you&spent listening to&them.../");
ds_map_add(global.text_data_en, "obj_friendscene_1204", "\E2Encouraging them..^1.&Caring about them.../");
ds_map_add(global.text_data_en, "obj_friendscene_1205", "\E0Without that^1, they&wouldn't have come&here./");
ds_map_add(global.text_data_en, "obj_friendscene_1206", "\E7And now^1, with their&souls and the humans'&together.../");
ds_map_add(global.text_data_en, "obj_friendscene_1207", "\E5I will achieve my&REAL FORM./");
ds_map_add(global.text_data_en, "obj_friendscene_1208", "\E0Hee hee.../");
ds_map_add(global.text_data_en, "obj_friendscene_1209", "\E3Huh?/");
ds_map_add(global.text_data_en, "obj_friendscene_1210", "\E1WHY am I still&doing this?/");
ds_map_add(global.text_data_en, "obj_friendscene_1211", "\E7Don't you get it?/");
ds_map_add(global.text_data_en, "obj_friendscene_1212", "\E0This is all just&a GAME./");
ds_map_add(global.text_data_en, "obj_friendscene_1213", "\E3If you leave the&underground satisfied^1,&you'll \"win\" the&game./");ds_map_add(global.text_data_en, "obj_friendscene_1214", "\E4If you \"win^1,\" you&won't want to \"play\"&with me anymore./");ds_map_add(global.text_data_en, "obj_friendscene_1215", "\E0And what would I&do then?/");
ds_map_add(global.text_data_en, "obj_friendscene_1216", "\E6But this game&between us will&NEVER end./");
ds_map_add(global.text_data_en, "obj_friendscene_1217", "\E5I'll hold victory&in front of you^1,&just within your&reach.../");
ds_map_add(global.text_data_en, "obj_friendscene_1218", "\E6And then tear it&away just before&you grasp it./");
ds_map_add(global.text_data_en, "obj_friendscene_1219", "\E8Over^1, and over^1,&and over.../");
ds_map_add(global.text_data_en, "obj_friendscene_1220", "\E5Hee hee hee./");
ds_map_add(global.text_data_en, "obj_friendscene_1221", "\E1Listen./");
ds_map_add(global.text_data_en, "obj_friendscene_1222", "\E0If you DO defeat&me^1, I'll give you&your \"happy ending.\"/");ds_map_add(global.text_data_en, "obj_friendscene_1223", "\E7I'll bring your&friends back./");
ds_map_add(global.text_data_en, "obj_friendscene_1224", "I'll destroy the&barrier./");
ds_map_add(global.text_data_en, "obj_friendscene_1225", "\E0Everyone will&finally be&satisfied./");
ds_map_add(global.text_data_en, "obj_friendscene_1226", "\E6But that WON'T&happen./");
ds_map_add(global.text_data_en, "obj_friendscene_1227", "\E8You...!/");
ds_map_add(global.text_data_en, "obj_friendscene_1228", "\E0I'll keep you here&no matter what!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1266", "\E0Even if it means&killing you&1,000,000 times!!!!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1357", "What?/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1375", "Do not be afraid^1,&my child.../");
ds_map_add(global.text_data_en, "obj_friendscene_1376", "No matter what&happens.../");
ds_map_add(global.text_data_en, "obj_friendscene_1377", "We will always&be there to&protect you!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1434", "THAT'S RIGHT^1,&HUMAN^1!&YOU CAN&WIN!!/");
ds_map_add(global.text_data_en, "obj_friendscene_1435", "JUST DO&WHAT I^1,&WOULD&DO.../");
ds_map_add(global.text_data_en, "obj_friendscene_1436", "BELIEVE&IN YOU!!!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1449", "Hey^1! Human^1! If&you got past&ME^1, you can&do ANYTHING!/");
ds_map_add(global.text_data_en, "obj_friendscene_1450", "So don't worry^1!&We're with you&all the way!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1463", "huh^1?&you haven't&beaten&this guy yet?/");
ds_map_add(global.text_data_en, "obj_friendscene_1464", "come on^1, this&weirdo's got&nothin' on you./%%");
ds_map_add(global.text_data_en, "obj_friendscene_1514", "Technically^1, it's&impossible for you&to beat him.../");
ds_map_add(global.text_data_en, "obj_friendscene_1515", "B-but..^1.&Somehow^1, I know&you can do it!!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1532", "Human^1, for the&future of&humans and&monsters...!/");
ds_map_add(global.text_data_en, "obj_friendscene_1533", "You have to stay&determined...!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1589", "Urrrgh..^1. NO!/");
ds_map_add(global.text_data_en, "obj_friendscene_1590", "Unbelievable!!/");
ds_map_add(global.text_data_en, "obj_friendscene_1591", "This can't be&happening...!/");
ds_map_add(global.text_data_en, "obj_friendscene_1592", "You..^1. YOU...!/%%");
ds_map_add(global.text_data_en, "obj_friendscene_1635", "I can't believe&you're all so&STUPID./%%");
ds_map_add(global.text_data_en, "obj_friendscene_1665", "ALL OF YOUR SOULS&ARE MINE!!!/%%");
ds_map_add(global.text_data_en, "obj_froggit_30", "Ribbit,&ribbit.");
ds_map_add(global.text_data_en, "obj_froggit_31", "Croak,&croak.");
ds_map_add(global.text_data_en, "obj_froggit_32", "Hop,&hop.");
ds_map_add(global.text_data_en, "obj_froggit_33", "Meow.");
ds_map_add(global.text_data_en, "obj_froggit_36", "(Blushes&deeply.)&Ribbit..");
ds_map_add(global.text_data_en, "obj_froggit_39", "Shiver,&shiver.");
ds_map_add(global.text_data_en, "obj_froggit_42", "%%%");
ds_map_add(global.text_data_en, "obj_froggit_184", "* Froggit doesn't seem to&  know why it's here.");
ds_map_add(global.text_data_en, "obj_froggit_185", "* Froggit hops to and fro.");
ds_map_add(global.text_data_en, "obj_froggit_186", "* The battlefield is filled&  with the smell of mustard&  seed.");
ds_map_add(global.text_data_en, "obj_froggit_187", "* You are intimidated by&  Froggit's raw strength^4.&* Only kidding.");
ds_map_add(global.text_data_en, "obj_froggit_188", "* Froggit seems reluctant&  to fight you.");
ds_map_add(global.text_data_en, "obj_froggit_189", "* Froggit is trying to&  run away.");
ds_map_add(global.text_data_en, "obj_froggit_205", "* FROGGIT - ATK 4 DEF 5&* Life is difficult for&  this enemy./^");
ds_map_add(global.text_data_en, "obj_froggit_214", "* Froggit didn't understand&  what you said^1, but was&  scared anyway./^");
ds_map_add(global.text_data_en, "obj_froggit_225", "* Froggit didn't understand&  what you said^1, but was&  flattered anyway./^");
ds_map_add(global.text_data_en, "obj_gameintro_fake_44", "Long ago^1, two races&ruled over Earth^1:&HUMANS and MONSTERS. \E1 ^1 %");
ds_map_add(global.text_data_en, "obj_gameintro_fake_45", "One day^1, th^7ey all&disappeared without&a trace.");
ds_map_add(global.text_data_en, "obj_garbagepile_70", "* (Piles of garbage.)&* (There are quite a few&  brands you recognize.)/%%");
ds_map_add(global.text_data_en, "obj_garbagepile_71", "* (Just garbage.)/%%");
ds_map_add(global.text_data_en, "obj_garbagepile_72", "* (There's a pile of yellow names&  in the trash pile.)/%%");
ds_map_add(global.text_data_en, "obj_garbagepile_73", "* (Garbage.)/%%");
ds_map_add(global.text_data_en, "obj_garbagepile_74", "* (A trash heap.)/%%");
ds_map_add(global.text_data_en, "obj_garbagepile_75", "* (Your persistent garbage&  habit shows no signs&  of payoff.)/%%");
ds_map_add(global.text_data_en, "obj_garbagepile_76", "* (Trash.)/%%");
ds_map_add(global.text_data_en, "obj_gaster_follower_a_94", "* Alphys might work faster^1.&* But the old Royal Scientist^1,&  Doctor W.D. Gaster?/");
ds_map_add(global.text_data_en, "obj_gaster_follower_a_95", "* One day^1, he vanished&  without a trace./");
ds_map_add(global.text_data_en, "obj_gaster_follower_a_96", "* They say he shattered&  across time and space./");
ds_map_add(global.text_data_en, "obj_gaster_follower_a_97", "* Ha ha..^1.&* How can I say so&  without fear?/");
ds_map_add(global.text_data_en, "obj_gaster_follower_a_98", "* I'm holding a piece of&  him right here./%%");
ds_map_add(global.text_data_en, "obj_gaster_follower_b_94", "* It makes sense why ASGORE&  took so long to hire a&  new Royal Scientist./");
ds_map_add(global.text_data_en, "obj_gaster_follower_b_95", "* After all^1, the old one..^1.&* Dr. Gaster^1.&* What an act to follow!/");
ds_map_add(global.text_data_en, "obj_gaster_follower_b_96", "* They say he created the CORE./");
ds_map_add(global.text_data_en, "obj_gaster_follower_b_97", "* However^1, his life..^1.&* Was cut short./");
ds_map_add(global.text_data_en, "obj_gaster_follower_b_98", "* One day^1, he fell into&  his creation^1, and.../%%");
ds_map_add(global.text_data_en, "obj_gaster_follower_b_102", "* Will Alphys end up the&  same way?/%%");
ds_map_add(global.text_data_en, "obj_gaster_follower_c_95", "* I understand why ASGORE&  waited so long to hire a&  new Royal Scientist./");
ds_map_add(global.text_data_en, "obj_gaster_follower_c_96", "* The previous one..^1.&* Dr. Gaster./");
ds_map_add(global.text_data_en, "obj_gaster_follower_c_97", "* His brilliance was&  irreplaceable./");
ds_map_add(global.text_data_en, "obj_gaster_follower_c_98", "* However^1, his life..^1.&* Was cut short./");
ds_map_add(global.text_data_en, "obj_gaster_follower_c_99", "* One day^1, his experiments&  went wrong^1, and.../%%");
ds_map_add(global.text_data_en, "obj_gaster_follower_c_103", "* Well^1, I needn't gossip./");
ds_map_add(global.text_data_en, "obj_gaster_follower_c_104", "* After all^1, it's rude to&  talk about someone who's&  listening./%%");
ds_map_add(global.text_data_en, "obj_gaster_room_34", "ENTRY NUMBER&SEVENTEEN/");
ds_map_add(global.text_data_en, "obj_gaster_room_35", "DARK&DARKER&YET DARKER/");
ds_map_add(global.text_data_en, "obj_gaster_room_36", "THE DARKNES^2S&KEEPS GROWING/");
ds_map_add(global.text_data_en, "obj_gaster_room_37", "THE SHADOW^2S&CUTTING DEEPER/");
ds_map_add(global.text_data_en, "obj_gaster_room_38", "PHOTON&READING^2S&NEGATIVE/");
ds_map_add(global.text_data_en, "obj_gaster_room_39", "THIS NEX^2T&EXPERIMENT/");
ds_map_add(global.text_data_en, "obj_gaster_room_40", "SEEMS/");
ds_map_add(global.text_data_en, "obj_gaster_room_41", "VERY/");
ds_map_add(global.text_data_en, "obj_gaster_room_42", "VERY/");
ds_map_add(global.text_data_en, "obj_gaster_room_43", "INTERESTING/");
ds_map_add(global.text_data_en, "obj_gaster_room_44", ".../");
ds_map_add(global.text_data_en, "obj_gaster_room_45", "WHAT DO YOU&TWO THINK/%%");
ds_map_add(global.text_data_en, "obj_gladdummy_216", " Thanks!");
ds_map_add(global.text_data_en, "obj_gladdummy_218", "Thanks!");
ds_map_add(global.text_data_en, "obj_gladdummy_219", "Thank&you!");
ds_map_add(global.text_data_en, "obj_gladdummy_220", "Great&work!");
ds_map_add(global.text_data_en, "obj_gladdummy_221", "Bravo!");
ds_map_add(global.text_data_en, "obj_gladdummy_222", "OK!");
ds_map_add(global.text_data_en, "obj_gladdummy_223", "...");
ds_map_add(global.text_data_en, "obj_gladdummy_232", "%%%");
ds_map_add(global.text_data_en, "obj_gladdummy_405", "* Dummy looks like it's&  going to fall over.");
ds_map_add(global.text_data_en, "obj_gladdummy_406", "* Dummy stands around&  absentmindedly.");
ds_map_add(global.text_data_en, "obj_gladdummy_411", "* Dummy tires of your&  aimless shenanigans.");
ds_map_add(global.text_data_en, "obj_gladdummy_448", "* GLAD DUMMY - ATK 0 DEF 0^1 &* Wipe that smile off your&  face./^");
ds_map_add(global.text_data_en, "obj_glydeb_148", "How&great&I am.");
ds_map_add(global.text_data_en, "obj_glydeb_149", "Look.&Watch.&Observe.");
ds_map_add(global.text_data_en, "obj_glydeb_150", "Wow.&Check&out my&pecs.");
ds_map_add(global.text_data_en, "obj_glydeb_151", "Sorry...&for&NOTHING&*ollies*");
ds_map_add(global.text_data_en, "obj_glydeb_159", "Boo?&What a&wimpy&ghost.");
ds_map_add(global.text_data_en, "obj_glydeb_160", "Mmm,&Fresh&Sweet&Haters");
ds_map_add(global.text_data_en, "obj_glydeb_165", "OK!&I rule!&I admit&it!");
ds_map_add(global.text_data_en, "obj_glydeb_168", "What&else do&you have&to say!?");
ds_map_add(global.text_data_en, "obj_glydeb_174", "...");
ds_map_add(global.text_data_en, "obj_glydeb_175", "Eh?&You&forgot&to clap.");
ds_map_add(global.text_data_en, "obj_glydeb_176", "HELLO??&I'M&RIGHT&HERE!!!");
ds_map_add(global.text_data_en, "obj_glydeb_181", "%%%");
ds_map_add(global.text_data_en, "obj_glydeb_414", "* Glyde does fancy flips.");
ds_map_add(global.text_data_en, "obj_glydeb_415", "* Glyde is giving itself a&  high five^1.&* ... somehow.");
ds_map_add(global.text_data_en, "obj_glydeb_416", "* Glyde sees its reflection &  and gets jealous.");
ds_map_add(global.text_data_en, "obj_glydeb_417", "* Glyde is thinking of new&  slang for the word \"cool.\"&* Like \"freakadacious.\"");ds_map_add(global.text_data_en, "obj_glydeb_418", "* An arrogant-smelling wind&  blows through.");
ds_map_add(global.text_data_en, "obj_glydeb_420", "* Glyde is doing tons of flips&  to get your attention.");
ds_map_add(global.text_data_en, "obj_glydeb_421", "* Glyde seems satisfied.");
ds_map_add(global.text_data_en, "obj_glydeb_422", "* Glyde is dying^1, but in a&  cool way.");
ds_map_add(global.text_data_en, "obj_glydeb_455", "* GLYDE - ATK HIGH DEF HIGH&* Refuses to give more details&  about its statistics./^");
ds_map_add(global.text_data_en, "obj_glydeb_466", "* You clap really sloppily^1.&* Glyde sucks up your praise&  like a vacuum cleaner./^");
ds_map_add(global.text_data_en, "obj_glydeb_471", "* You clap like a gorilla^1.&* Glyde is becoming addicted to&  your praise./^");
ds_map_add(global.text_data_en, "obj_glydeb_486", "* You boo..^1. but haters&  only make Glyde stronger^1.&* Glyde ATTACK UP+DEFENSE DOWN./^");
ds_map_add(global.text_data_en, "obj_glydeb_492", "* You boo loudly^1.&* Glyde leaves to look elsewhere&  for praise./^");
ds_map_add(global.text_data_en, "obj_glydeb_506", "* You do nothing^1.&* No effect./^");
ds_map_add(global.text_data_en, "obj_glydeb_511", "* You do nothing^1.&* Glyde leaves to look elsewhere&  for praise./^");
ds_map_add(global.text_data_en, "obj_glydeb_519", "* You do nothing^1.&* Glyde looks desperate for&  attention./^");
ds_map_add(global.text_data_en, "obj_glydeb_525", "* You do nothing^1.&* Glyde looks disappointed you&  aren't paying attention./^");
ds_map_add(global.text_data_en, "obj_bigglydeshot_word_0", "COOL");
ds_map_add(global.text_data_en, "obj_bigglydeshot_word_1", "VIBIN");
ds_map_add(global.text_data_en, "obj_bigglydeshot_word_2", "RAD");
ds_map_add(global.text_data_en, "obj_bigglydeshot_word_3", "NICEY");
ds_map_add(global.text_data_en, "obj_bigglydeshot_word_4", "SPICEY");
ds_map_add(global.text_data_en, "obj_bigglydeshot_word_5", "SWEET");
ds_map_add(global.text_data_en, "obj_bigglydeshot_word_6", "SICK");
ds_map_add(global.text_data_en, "obj_greatdog_440", "* Greater Dog is watching you&  intently.");
ds_map_add(global.text_data_en, "obj_greatdog_441", "* Greater Dog is waiting for&  your command.");
ds_map_add(global.text_data_en, "obj_greatdog_442", "* It smells like freshly-&  squeezed puppy juice.");
ds_map_add(global.text_data_en, "obj_greatdog_443", "* Greater Dog is seeking&  affection.");
ds_map_add(global.text_data_en, "obj_greatdog_444", "* Greater Dog just wants&  affection.");
ds_map_add(global.text_data_en, "obj_greatdog_445", "* Greater Dog is making&  puppy-dog eyes.");
ds_map_add(global.text_data_en, "obj_greatdog_446", "* Greater Dog is patting the&  ground with its front paws.");
ds_map_add(global.text_data_en, "obj_greatdog_447", "* Greater Dog wants some TLC.");
ds_map_add(global.text_data_en, "obj_greatdog_448", "* Pet capacity is 40-percent.");
ds_map_add(global.text_data_en, "obj_greatdog_449", "* Greater Dog is contented.");
ds_map_add(global.text_data_en, "obj_greatdog_450", "* Greater Dog is panting&  slowly.");
ds_map_add(global.text_data_en, "obj_greatdog_466", "* GREATER DOG - ATK 15 DEF 8&* It's so excited that it&  thinks fighting is just play./^");
ds_map_add(global.text_data_en, "obj_greatdog_478", "* The Greater Dog's ears&  perk up^1.&* Nothing else happens./^");
ds_map_add(global.text_data_en, "obj_greatdog_482", "* You call the Greater Dog./");
ds_map_add(global.text_data_en, "obj_greatdog_483", "* It bounds towards you^1,&  flecking slobber into your&  face./^");
ds_map_add(global.text_data_en, "obj_greatdog_495", "* Greater Dog inches closer./^");
ds_map_add(global.text_data_en, "obj_greatdog_501", "* Greater Dog decides you are&  too boring./^");
ds_map_add(global.text_data_en, "obj_greatdog_512", "* You pet the dog./^");
ds_map_add(global.text_data_en, "obj_greatdog_515", "* Tummy rubs are forbidden./^");
ds_map_add(global.text_data_en, "obj_greatdog_520", "* You pet decisively^1.&* Pet capacity reaches 100&  percent./");
ds_map_add(global.text_data_en, "obj_greatdog_521", "* The dog flops over with&  its legs hanging in the air./^");
ds_map_add(global.text_data_en, "obj_greatdog_528", "* As you pet the dog^1,&  it sinks its entire weight&  into you.../");
ds_map_add(global.text_data_en, "obj_greatdog_529", "* Your movements slow./");
ds_map_add(global.text_data_en, "obj_greatdog_530", "* But^1, you still haven't&  pet enough...!/^");
ds_map_add(global.text_data_en, "obj_greatdog_536", "* Greater Dog's excitement is&  creating a power field that&  prevents petting./^");
ds_map_add(global.text_data_en, "obj_greatdog_540", "* Greater Dog curls up in&  your lap as it is&  pet by you./");
ds_map_add(global.text_data_en, "obj_greatdog_541", "* It gets so comfortable&  it falls asleep.../");
ds_map_add(global.text_data_en, "obj_greatdog_542", "* Zzzzz.../");
ds_map_add(global.text_data_en, "obj_greatdog_543", "* .../");
ds_map_add(global.text_data_en, "obj_greatdog_544", "* Then it wakes up^1!&* It's so excited!/^");
ds_map_add(global.text_data_en, "obj_greatdog_549", "* Greater Dog is too far&  away to pet^1.&* You just pet the air./^");
ds_map_add(global.text_data_en, "obj_greatdog_558", "* You play with the dog./^");
ds_map_add(global.text_data_en, "obj_greatdog_561", "* Greater Dog is too tired&  to play./^");
ds_map_add(global.text_data_en, "obj_greatdog_565", "* You make a snowball and&  throw it for the dog&  to fetch./");
ds_map_add(global.text_data_en, "obj_greatdog_566", "* It splats on the ground./");
ds_map_add(global.text_data_en, "obj_greatdog_567", "* Greater Dog picks up all&  the snow in the area&  and brings it to you./");
ds_map_add(global.text_data_en, "obj_greatdog_568", "* Now dog is very tired..^1.&* It rests its head on you.../^");
ds_map_add(global.text_data_en, "obj_greatdog_573", "* Greater Dog is not excited&  enough to play with./^");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_74", "* I'm thinking of getting a&  spiked collar to show off&  my personality./");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_75", "* It makes a statement like..^1.&* \"Attach a leash to me and&  take me for a walk please.\"/%%");ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_79", "* He may not look like it^1,&  but this big guy writes&  the most eloquent letters./");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_80", "* Here^1, take a look!/");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_81", "* (It's just the word \"Bark\"&  but in flowery cursive.)/%%");ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_86", "* Papyrus^1?&* Is that you^1?& Come on.../%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_91", "* Undyne!^1?&* Did you come all the way&  out here...?/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_96", "* Huh^1?&* Since when did you and&  Sans become friends...?/");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_97", "* I don't like him..^1.&* He loves to appear without&  moving./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_101", "* Where're the other two^1?&* I can't play with this&  big dumb guy alone.../");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_102", "* He'll just win!!!/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_104", "* Sometimes the others like to&  prank me^1. They sit still&  so I can't see them./");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_105", "* They must be here^1, playing a&  joke on me./");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_106", "* I'll just wait until one of&  them admits it.../%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_110", "* Having an amorphous^1,&  shambling family member&  is great./");
ds_map_add(global.text_data_en, "obj_grillbynpc_doggo_111", "* They're always moving^1, so I&  can see them 100-percent&  of the time!/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_73", "* Hmmm..^1.&* Isn't human food different&  from monster food?/");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_74", "* It does things like \"spoil.\"/");ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_75", "* And when you eat it^1, it&  passes all the way through&  your whole body./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_76", "* Disgusting./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_77", "* I'd love to try it sometime./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_80", "* And I've heard they have&  things called bathrooms./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_84", "* To a human^1, monster food&  would be very interesting./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_85", "* As soon as you eat it^1, it&  converts perfectly into&  energy./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_86", "* ... that makes me wonder^1.&* How do humans do it?/");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_87", "* Eat during battle...?/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_90", "* Ice cream in one hand^1,&  sword in the other./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_91", "* That's the way of the&  monster warrior.../%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_97", "* Hmmm^1, this is around the&  time that Sans comes in./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_98", "* Then^1, a little bit later^1,&  his brother comes in^1,&  irritated./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_99", "* Yes^1, his brother^1.&* Papyrus./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_100", "* He's an interesting fellow./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_101", "* He always orders a glass of&  milk.../");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_102", "* He says it's \"full of&  strong bones.\"/%%");ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_104", "* Hope he shows up today./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_109", "* Soon^1, I'll be able to try&  some human food.../");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_110", "* And then I guess I'll try&  a human bathroom^1, too./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_115", "* Sans is interesting^1.&* He has told me about all&  kinds of incredible foods./");
ds_map_add(global.text_data_en, "obj_grillbynpc_foodmonster_116", "* But^1, despite his knowledge^1,&  he always orders the worst&  burger off the menu./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_grillby_73", "* ..^1.&* ..^1.&* ..^1./");
ds_map_add(global.text_data_en, "obj_grillbynpc_grillby_74", "* Grillbz said that he'd offer&  you a glass of water^1, but he&  doesn't touch the stuff./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_grillby_78", "* .............^1.&* ..............^1.&* ... good job./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_grillby_83", "* ..^1.&* ..^1.&* ..^1./");
ds_map_add(global.text_data_en, "obj_grillbynpc_grillby_84", "* Grillbz said that your&  food is probably cold&  by now./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_73", "* Those dogs are part of&  the ROYAL GUARD^1, the elite&  military group led by UNDYNE./");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_74", "* She's rude^1, loud^1, and beats up&  everybody who gets in her&  way.../");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_75", "* It's no wonder all the kids&  want to be like her when&  they grow up!/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_77", "* I want to be like UNDYNE&  when I grow up^1, too^1!&* Hoo hoo hoo!/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_81", "* Sans is a sentry^1.&* But don't let his title make&  you think he does anything./");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_82", "\W* Everyone knows he sits&  around in the forest&  reading \Ycar magazines\W./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_87", "* Ehhhhhhhhnnnnn..^1.&* I wish I had something else&  to do./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_92", "* Those dogs are part of&  the ROYAL GUARD^1, the.../");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_93", "* Huh^1?&* Where are they?/");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_94", "* Something feels really off./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_101", "* Wow^1, a brand new world.../");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_102", "* I might not get to&  translate for Grillby&  anymore.../");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_103", "* ... which is fine^1, since I&  was actually just making&  up what he was saying./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_109", "* Grillby is getting nervous./");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_110", "* Sans is his best customer^1,&  and he hasn't shown up&  at all today.../%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_115", "* Something feels really bad^1.&* Our lives are going nowhere^1,&  aren't they...?/");
ds_map_add(global.text_data_en, "obj_grillbynpc_hot2_116", "* I think I need another&  espresso.../%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_73", "* No matter where I go^1,&  it's the same menu^1, the&  same people.../");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_74", "* Help^1!&* I want new drinks an'&  ^1h-^1h-^1h-hot guys!!!!/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_75", "* I guess the bartender's kind&  of ^1h-^1h-^1h-hot.../%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_79", "* C'mon everybody!!^1!&* ^1L-^1l-^1l-let's party!!!/");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_80", "* ... anyone?/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_84", "* Sansyyyy..^1.&* Come back and sit with me.../");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_85", "* Everything's so fun when&  you're around!!!/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_90", "* It's s-s-so quiet in here./");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_91", "* L-lighten up everybody^1!&* This is why I hate&  th-this place./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_98", "* I w-wonder if the&  o-overworld h-has h-hot&  guys.../");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_99", "*  A-and neat d-drinks.../");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_100", "* Ooooooo^1, I'm ready!/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_105", "* H-hey^1, isn't Sansy s'posed&  to come swinging in right&  about now???/");
ds_map_add(global.text_data_en, "obj_grillbynpc_hotandbothered_106", "* C'mon Sansy^1!&* You're the life of the&  party.../%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_lesserdog_71", "* (It's playing poker against&  itself.)/");
ds_map_add(global.text_data_en, "obj_grillbynpc_lesserdog_72", "* (It appears to be losing.)/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_lesserdog_76", "* (It has switched to Go Fish.)/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_lesserdog_81", "* (It finally won a game of&  poker against itself...?)/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_75", "* You better watch where you&  sit down in here^1, kid./");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_76", "* Because that big guy WILL jump&  into your lap and give you&  lots of love and attention./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_80", "* Where's Sans..^1.&* He's supposed to give me&  a pat on the head.../%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_85", "* She hasn't been responding&  to our letters.../");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_86", "* Maybe it's because we let&  Doggo write them all./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_91", "* I was hoping Sans came in&  to give me a pat on the&  head./");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_92", "* Interloper...!/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_96", "* Where's that big lug^1?&* We can't start until he&  shows up./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_98", "* Smells kinda..^1. quiet./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_103", "* Hmmm^1, now that our parents&  are the same entity.../");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_104", "* Does that mean I'm&  married to my sister?/");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_105", "* .../");
ds_map_add(global.text_data_en, "obj_grillbynpc_mandog_106", "* Wait^1, we're dogs^1.&* That stuff's normal./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_121", "* fast shortcut^1, huh?/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_129", "* hey^1, everyone./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_164", "* Hey^1, Sans.&* (Hi^1, Sans.)/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_208", "* Greetings^1, Sans.&* Hiya^1, Sansy~/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_245", "* Hey Sans^1, weren't you just&  here for breakfast a&  few minutes ago?/");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_247", "* nah^1, i haven't had&  breakfast in at least&  half an hour./");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_248", "\E2* you must be thinking&  of brunch./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_286", "* here^1, get comfy./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_521", "* (You tip the ketchup...)/");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_522", "* (The cap falls off and all&  the ketchup in the bottle&  pours onto your food.)/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_545", "* whoops./");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_546", "\E0* eh, forgeddaboudit^1.&* you can have mine./");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_547", "\E1* i'm not hungry anyway./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_577", "* anyway^1, cool or not^1,&  you have to agree&  papyrus tries real hard./");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_578", "\E0* like how he keeps&  trying to be part of&  the royal guard./");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_579", "\E1* one day^1, he went to&  the house of the head&  of the royal guard.../");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_580", "\E0* and begged her to&  let him be in it./");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_581", "\E1* of course^1, she shut&  the door on him because&  it was midnight./");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_582", "\E0* but the next day^1, she&  woke up and saw him&  still waiting there./");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_583", "* seeing his dedication^1,&  she decided to give&  him warrior training./");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_584", "\E1* it's^1, uh^1, still a&  work in progress./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_609", "\E1* oh yeah^1, I wanted&  to ask you something./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_683", "* welp^1, that was a&  long break./");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_684", "\E1* i can't believe i let&  ya pull me away from&  work for that long./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_708", "* just kidding./");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_709", "* grillby^1, put it on&  my tab./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_751", "* by the way.../");
ds_map_add(global.text_data_en, "obj_grillbynpc_sansdate_752", "* ... i was going to say&  something^1, but i forgot./%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_76", "* (We're sentries^1, but we never&  get any respect.)/");
ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_77", "* (I wish those skeletons would&  throw us a bone.)/");
ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_78", "* (We love bones.)/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_81", "* (Where are those skeletons?^1)&* (I wanted to get a bone&  from them...)/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_86", "* (We're considering paying a&  visit to the doctor.)/");
ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_87", "* (No^1! Not the vet!^1)&* (... well^1, maybe she's a&  little like a vet.)/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_92", "* (I like Sans.^1)&* (Sometimes he feeds us scraps&  of food under the table.)/");
ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_93", "* (Then his brother gets mad...^1)&* (But why!^1? We're adults!^1)&* (We can handle it!)/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_97", "* (Where's Doggo?^1)&* (I hope he didn't get&  lost again.)/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_99", "* (It's lonely in here today.^1)&* (If our friends don't show up^1,&  would you like to play?)/%%");
ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_105", "* (All of our parents have&  been combined into one&  horrible being.)/");
ds_map_add(global.text_data_en, "obj_grillbynpc_womandog_106", "* (That's OK^1, though.^1)&* (It's really \"brought our&  families together.\")/%%");
ds_map_add(global.text_data_en, "obj_gyftrot_271", "Error!!");
ds_map_add(global.text_data_en, "obj_gyftrot_273", "Is this&funny to&you?");
ds_map_add(global.text_data_en, "obj_gyftrot_274", "Don't&put any&more on&me!");
ds_map_add(global.text_data_en, "obj_gyftrot_275", "Leave me&alone...");
ds_map_add(global.text_data_en, "obj_gyftrot_276", "Hohoho!&Go ahead&and&laugh...");
ds_map_add(global.text_data_en, "obj_gyftrot_277", "Get this&off of&me...");
ds_map_add(global.text_data_en, "obj_gyftrot_279", "Thanks.");
ds_map_add(global.text_data_en, "obj_gyftrot_283", "Aw, you&shouldn'&have...");
ds_map_add(global.text_data_en, "obj_gyftrot_284", "You even&wrapped&it...");
ds_map_add(global.text_data_en, "obj_gyftrot_285", "Keep&away&from me!");
ds_map_add(global.text_data_en, "obj_gyftrot_286", "I don't&want&your&gift!");
ds_map_add(global.text_data_en, "obj_gyftrot_287", "How do&I know&it's not&a trick?");
ds_map_add(global.text_data_en, "obj_gyftrot_293", "GOSHDARN&TEENAGE&GOOGLY&EYES!!!");
ds_map_add(global.text_data_en, "obj_gyftrot_294", "I WAS&STARTING&TO TRUST&YOU!!!");
ds_map_add(global.text_data_en, "obj_gyftrot_300", "That's&a little&better.");
ds_map_add(global.text_data_en, "obj_gyftrot_301", "Er...&Those&are&real.");
ds_map_add(global.text_data_en, "obj_gyftrot_303", "A weight&has been&lifted.");
ds_map_add(global.text_data_en, "obj_gyftrot_304", "Thanks&for&nothing!");
ds_map_add(global.text_data_en, "obj_gyftrot_312", "%%%");
ds_map_add(global.text_data_en, "obj_gyftrot_507", "* Gyftrot laments its lack of&  hands.");
ds_map_add(global.text_data_en, "obj_gyftrot_508", "* Gyftrot eyes you with&  suspicion.");
ds_map_add(global.text_data_en, "obj_gyftrot_509", "* Gyftrot distrusts your&  youthful demeanor.");
ds_map_add(global.text_data_en, "obj_gyftrot_510", "* Ah^1, the scent of fresh&  pine needles.");
ds_map_add(global.text_data_en, "obj_gyftrot_511", "* Gyftrot tries vainly to&  remove its decorations.");
ds_map_add(global.text_data_en, "obj_gyftrot_512", "* Gyftrot pretends to refuse&  your gift.");
ds_map_add(global.text_data_en, "obj_gyftrot_513", "* Gyftrot politely accepts&  your gift.");
ds_map_add(global.text_data_en, "obj_gyftrot_514", "* Gyftrot stumbles blindly.");
ds_map_add(global.text_data_en, "obj_gyftrot_515", "* Gyftrot is slightly less&  irritated.");
ds_map_add(global.text_data_en, "obj_gyftrot_516", "* Gyftrot's problems have&  been taken away.");
ds_map_add(global.text_data_en, "obj_gyftrot_517", "* Gyftrot looks disappointed.");
ds_map_add(global.text_data_en, "obj_gyftrot_519", "* Gyftrot's antlers tremble.");
ds_map_add(global.text_data_en, "obj_gyftrot_534", "* GYFTROT - ATK 16 DEF 8&* Some teens \"decorated\" it as&  a prank./^");ds_map_add(global.text_data_en, "obj_gyftrot_544", "* You remove the striped cane&  that says \"I use this tiny&  cane to walk\" on it./^");ds_map_add(global.text_data_en, "obj_gyftrot_545", "* You remove the box of&  non-dog-related raisins./^");
ds_map_add(global.text_data_en, "obj_gyftrot_546", "* You remove the lenticular&  bookmark of a smug teen&  winking./^");
ds_map_add(global.text_data_en, "obj_gyftrot_547", "* You remove the barbed wire&  made of pipe cleaners./^");
ds_map_add(global.text_data_en, "obj_gyftrot_548", "* You remove a childhood&  photograph of Snowdrake and&  his parent./^");
ds_map_add(global.text_data_en, "obj_gyftrot_549", "* You remove a small^1, confused&  dog./^");
ds_map_add(global.text_data_en, "obj_gyftrot_550", "* You remove a stocking filled&  with chicken nuggets./^");
ds_map_add(global.text_data_en, "obj_gyftrot_551", "* You remove the shirt that says& 'I'm with stupid' and points&  inward./^");
ds_map_add(global.text_data_en, "obj_gyftrot_553", "* You try to undecorate...?/^");
ds_map_add(global.text_data_en, "obj_gyftrot_554", "* You remove the googly eyes./^");
ds_map_add(global.text_data_en, "obj_gyftrot_579", "* You add some googly eyes&  you found on the ground./^");
ds_map_add(global.text_data_en, "obj_gyftrot_586", "* You can't improve on&  perfection./^");
ds_map_add(global.text_data_en, "obj_gyftrot_601", "* You give the cheapest gift&  of all..^1.&* Friendship./^");
ds_map_add(global.text_data_en, "obj_gyftrot_610", "* You give 35 G because&  you can't think of an&  appropriate gift./^");
ds_map_add(global.text_data_en, "obj_gyftrot_616", "* You give your remaining&  money because you can't&  think of a better gift./^");
ds_map_add(global.text_data_en, "obj_gyftrot_624", "* Gyftrot refuses your gift./^");
ds_map_add(global.text_data_en, "obj_gyftrot_625", "* Hey now^1.&* You aren't made of money./^");
ds_map_add(global.text_data_en, "obj_gyftrot_626", "* Hey now^1.&* You aren't made of friendship./^");
ds_map_add(global.text_data_en, "obj_gyftrotnpc_70", "* I've heard there's a local&  tradition based off of&  my own suffering./");
ds_map_add(global.text_data_en, "obj_gyftrotnpc_71", "* .../%%");
ds_map_add(global.text_data_en, "obj_gyftrotnpc_72", "* .../%%");
ds_map_add(global.text_data_en, "obj_gyftrotnpc_76", "* Everyone's leaving^1, eh?/");
ds_map_add(global.text_data_en, "obj_gyftrotnpc_77", "* Good riddance^1!&* Maybe I'll finally get&  some peace and quiet!/%%");
ds_map_add(global.text_data_en, "obj_heartdefeated_0_0", "  You cannot give&  up just yet.../");
ds_map_add(global.text_data_en, "obj_heartdefeated_0_1", "  \[C]^1!&  Stay determined.../%%");
ds_map_add(global.text_data_en, "obj_heartdefeated_100_0", "  \[C], this is just&  a bad dream.../");
ds_map_add(global.text_data_en, "obj_heartdefeated_100_1", "  Wake up^1!&  It's not over!/%%");
ds_map_add(global.text_data_en, "obj_heartdefeated_101_0", "  \[C]! It's like&  he says.../");
ds_map_add(global.text_data_en, "obj_heartdefeated_101_1", "  You have to&  stay determined.../%%");
ds_map_add(global.text_data_en, "obj_heartdefeated_102_0", "  \[C]! Please&  don't give up.../");
ds_map_add(global.text_data_en, "obj_heartdefeated_102_1", "  Have some&  determination.../%%");
ds_map_add(global.text_data_en, "obj_heartdefeated_103_0", "  \[C]! You're&  \[C]!/");
ds_map_add(global.text_data_en, "obj_heartdefeated_103_1", "  You can't quit^1!&  Stay determined.../%%");
ds_map_add(global.text_data_en, "obj_heartdefeated_104_0", "  \[C], is this&  a kind of joke?/");
ds_map_add(global.text_data_en, "obj_heartdefeated_104_1", "  Cut it out^1!&  Wake up!/%%");
ds_map_add(global.text_data_en, "obj_heartdefeated_105_0", "  \[C], it's not&  time to leave!/");
ds_map_add(global.text_data_en, "obj_heartdefeated_105_1", "  Hold on!/%%");
ds_map_add(global.text_data_en, "obj_heartdefeated_106_0", "  \[C], gather&  your strength./");
ds_map_add(global.text_data_en, "obj_heartdefeated_106_1", "  Stay determined!/%%");
ds_map_add(global.text_data_en, "obj_heartdefeated_107_0", "  \[C], you have&  to keep going./");
ds_map_add(global.text_data_en, "obj_heartdefeated_107_1", "  Stay determined!/%%");
ds_map_add(global.text_data_en, "obj_heartdefeated_200_0", "  You cannot give&  up just yet.../");
ds_map_add(global.text_data_en, "obj_heartdefeated_200_1", "  \[C]^1!&  Stay determined.../%%");
ds_map_add(global.text_data_en, "obj_heartdefeated_201_0", "  Our fate rests &  upon you.../");
ds_map_add(global.text_data_en, "obj_heartdefeated_201_1", "  \[C]^1!&  Stay determined.../%%");
ds_map_add(global.text_data_en, "obj_heartdefeated_202_0", "  You're going to&  be alright!/");
ds_map_add(global.text_data_en, "obj_heartdefeated_202_1", "  \[C]^1!&  Stay determined.../%%");
ds_map_add(global.text_data_en, "obj_heartdefeated_203_0", "  Don't lose hope!/");
ds_map_add(global.text_data_en, "obj_heartdefeated_203_1", "  \[C]^1!&  Stay determined.../%%");
ds_map_add(global.text_data_en, "obj_heartdefeated_204_0", "  It cannot end&  now!/");
ds_map_add(global.text_data_en, "obj_heartdefeated_204_1", "  \[C]^1!&  Stay determined.../%%");
ds_map_add(global.text_data_en, "obj_heartdefeated_300_0", "  geeettttttt&  dunked on!!!/");
ds_map_add(global.text_data_en, "obj_heartdefeated_300_1", "  if we're really&  friends.../");
ds_map_add(global.text_data_en, "obj_heartdefeated_300_2", "  you won't come back./%%");
ds_map_add(global.text_data_en, "obj_heartdefeated_343", "* But it refused^5.%%");
ds_map_add(global.text_data_en, "obj_hearthflame_57", "* The fire isn't burning hot...&* Just pleasantly warm.&* You could put your hand inside./%%");
ds_map_add(global.text_data_en, "obj_heatsflamesman_75", "\W* Heh^1.&* I'm \RHeats Flamesman\W.&* Remember my name!/%%");
ds_map_add(global.text_data_en, "obj_heatsflamesman_85", "* I'll always remember that&  you remembered!/%%");
ds_map_add(global.text_data_en, "obj_heatsflamesman_90", "* I'll never forget that you&  forgot!/%%");
ds_map_add(global.text_data_en, "obj_heatsflamesman_97", "* What?&* Do you want a rematch?/%%");
ds_map_add(global.text_data_en, "obj_hivestem_99", "* hOIVS!/%%");
ds_map_add(global.text_data_en, "obj_hivestem_103", "* p..^1.&* tem heard human allergics&  to tem.../");
ds_map_add(global.text_data_en, "obj_hivestem_104", "* dat OK..^1.&* tem understan.../");
ds_map_add(global.text_data_en, "obj_hivestem_105", "* tem..^1.&* ALSO allergic to tem!!!/%%");
ds_map_add(global.text_data_en, "obj_hotelreceptionist_95", "* bepis/%%");
ds_map_add(global.text_data_en, "obj_hotelreceptionist_100", "* Sorry^1, we aren't allowing&  any more guests at this time./");
ds_map_add(global.text_data_en, "obj_hotelreceptionist_101", "* Or ever again./%%");
ds_map_add(global.text_data_en, "obj_hotelreceptionist_107", "* How unusual./");
ds_map_add(global.text_data_en, "obj_hotelreceptionist_108", "* Mettaton usually shows up&  now to tell everyone they're&  doing a great job./");
ds_map_add(global.text_data_en, "obj_hotelreceptionist_109", "* Even if I was having a bad&  day^1, we'll always give each&  other a thumbs-up^1, and.../");
ds_map_add(global.text_data_en, "obj_hotelreceptionist_110", "* ... oh^1, what am I doing^1?&* I'm not being very&  professional./%%");
ds_map_add(global.text_data_en, "obj_icecap_139", "Where's&YOUR&hat?");
ds_map_add(global.text_data_en, "obj_icecap_140", "Your&head&looks so&...NAKED");
ds_map_add(global.text_data_en, "obj_icecap_141", "What a&great&hat!&(Mine)");
ds_map_add(global.text_data_en, "obj_icecap_142", "Snow?&No! It's&hat&residue.");
ds_map_add(global.text_data_en, "obj_icecap_143", "I just&looove&my hat.&OK?");
ds_map_add(global.text_data_en, "obj_icecap_148", "Fine!!!&I don't&care!!!");
ds_map_add(global.text_data_en, "obj_icecap_149", "OK!&I'll&ignore&you too.");
ds_map_add(global.text_data_en, "obj_icecap_150", "Better&a hatter&than a&HATER.");
ds_map_add(global.text_data_en, "obj_icecap_156", "HELLO???&My hat's&up here.");
ds_map_add(global.text_data_en, "obj_icecap_157", "What?&What are&you&doing?");
ds_map_add(global.text_data_en, "obj_icecap_163", "DUH!&Who&DOESN'T&know?");
ds_map_add(global.text_data_en, "obj_icecap_164", "Envious?&TOO BAD!");
ds_map_add(global.text_data_en, "obj_icecap_165", "My hat's&too loud&for me to&hear you.");
ds_map_add(global.text_data_en, "obj_icecap_169", "I KNEW&IT!!!&THIEF!!");
ds_map_add(global.text_data_en, "obj_icecap_170", "HELP!!!&FASHION&POLICE!!");
ds_map_add(global.text_data_en, "obj_icecap_175", "Haha!&That was&ACTUALLY&funny!");
ds_map_add(global.text_data_en, "obj_icecap_176", "Ha!&Imitated&it spot-&on!");
ds_map_add(global.text_data_en, "obj_icecap_177", "That's&the best&one in&a while!");
ds_map_add(global.text_data_en, "obj_icecap_182", "%%%");
ds_map_add(global.text_data_en, "obj_icecap_374", "* It's snowing dandruff.");
ds_map_add(global.text_data_en, "obj_icecap_375", "* Ice Cap also wants a hat&  for its nose.");
ds_map_add(global.text_data_en, "obj_icecap_376", "* Ice Cap makes sure its hat&  is still there.");
ds_map_add(global.text_data_en, "obj_icecap_377", "* Ice Cap is thinking about a&  certain article of clothing.");
ds_map_add(global.text_data_en, "obj_icecap_378", "* Here comes that new clothes&  smell.");
ds_map_add(global.text_data_en, "obj_icecap_379", "* Ice Cap is secretly checking&  if you're looking at&  its hat.");
ds_map_add(global.text_data_en, "obj_icecap_380", "* Ice Cap is desperate for&  attention.");
ds_map_add(global.text_data_en, "obj_icecap_381", "* Ice Cap's hat is loose.");
ds_map_add(global.text_data_en, "obj_icecap_396", "* ICE CAP - ATK 11 DEF 4&* This teen wonders why&  it isn't named 'Ice Hat.'/^");
ds_map_add(global.text_data_en, "obj_icecap_406", "* You continue not looking&  at Ice Cap's hat./");
ds_map_add(global.text_data_en, "obj_icecap_407", "* It seems defeated.../^");
ds_map_add(global.text_data_en, "obj_icecap_412", "* You manage to tear your&  eyes away from Ice Cap's&  hat./");
ds_map_add(global.text_data_en, "obj_icecap_413", "* It looks annoyed.../^");
ds_map_add(global.text_data_en, "obj_icecap_422", "* You inform Ice Cap that&  it has a great hat!/^");
ds_map_add(global.text_data_en, "obj_icecap_431", "* You tried to steal Ice Cap's&  hat.../");
ds_map_add(global.text_data_en, "obj_icecap_432", "* ... but it's not weakened&  enough!/^");
ds_map_add(global.text_data_en, "obj_icecap_435", "* And succeeded!&* (It melts in your hands...)/^");
ds_map_add(global.text_data_en, "obj_icecap_npcb_70", "* Everyone's wearing hats^1.&* Should I branch into a&  different item?/");
ds_map_add(global.text_data_en, "obj_icecap_npcb_71", "* Ice jorts./");
ds_map_add(global.text_data_en, "obj_icecap_npcb_72", "* ... doesn't have the same&  ring to it./%%");
ds_map_add(global.text_data_en, "obj_icecap_npcb_73", "* Ice socks and sandals./%%");
ds_map_add(global.text_data_en, "obj_icecap_npcb_77", "* I know how to set myself&  apart now^1!&* An ear piercing!/");
ds_map_add(global.text_data_en, "obj_icecap_npcb_78", "* .../");
ds_map_add(global.text_data_en, "obj_icecap_npcb_79", "* Wait./%%");
ds_map_add(global.text_data_en, "obj_icecap_npcg_70", "* Hey^1, stop thinking about&  my hat!/");
ds_map_add(global.text_data_en, "obj_icecap_npcg_71", "* ... you aren't thinking about&  my hat?/");
ds_map_add(global.text_data_en, "obj_icecap_npcg_72", "* ... can you^1, please?/%%");
ds_map_add(global.text_data_en, "obj_icecap_npcg_77", "* Ha^1!&* After all this time^1, you're&  still thinking about my hat!/");
ds_map_add(global.text_data_en, "obj_icecap_npcg_78", "* .../");
ds_map_add(global.text_data_en, "obj_icecap_npcg_79", "* ... please?/%%");
ds_map_add(global.text_data_en, "obj_icecap_npcr_70", "* We all live in the woods^1,&  so no one can tell us&  what to do!/");
ds_map_add(global.text_data_en, "obj_icecap_npcr_71", "* But now everyone ignores&  us.../");
ds_map_add(global.text_data_en, "obj_icecap_npcr_72", "* I don't want freedom if&  it means no one's gonna&  pay attention to me./%%");
ds_map_add(global.text_data_en, "obj_icecap_npcr_77", "* Maybe someone on the surface&  will pay attention to me./");
ds_map_add(global.text_data_en, "obj_icecap_npcr_78", "* There're so many people^1,&  someone has to^1, right!?/%%");
ds_map_add(global.text_data_en, "obj_icecube_174", "I...&I...");
ds_map_add(global.text_data_en, "obj_icecube_175", "What can&I say...");
ds_map_add(global.text_data_en, "obj_icecube_176", "What's&the&point...");
ds_map_add(global.text_data_en, "obj_icecube_177", "So...&Cold...");
ds_map_add(global.text_data_en, "obj_icecube_181", "Yeah...&I like&my hair&too.");
ds_map_add(global.text_data_en, "obj_icecube_182", "Hmm...&Hats are&for&posers.");
ds_map_add(global.text_data_en, "obj_icecube_183", "So I can&still&impress&you?");
ds_map_add(global.text_data_en, "obj_icecube_184", "I wanted&you to&see me&as cool.");
ds_map_add(global.text_data_en, "obj_icecube_188", "Haha!&That was&ACTUALLY&funny!");
ds_map_add(global.text_data_en, "obj_icecube_189", "Ha!&Imitated&it spot-&on!");
ds_map_add(global.text_data_en, "obj_icecube_190", "That's&the best&one in&a while!");
ds_map_add(global.text_data_en, "obj_icecube_196", "%%%");
ds_map_add(global.text_data_en, "obj_icecube_377", "* 'Ice Cap' is no more.");
ds_map_add(global.text_data_en, "obj_icecube_378", "* It smells like frozen despair.");
ds_map_add(global.text_data_en, "obj_icecube_379", "* Ice doesn't mind its identity.");
ds_map_add(global.text_data_en, "obj_icecube_380", "* It's melting.");
ds_map_add(global.text_data_en, "obj_icecube_406", "* ICE - ATK 1 DEF 0&* Without its cap.../^");
ds_map_add(global.text_data_en, "obj_icecube_414", "* You inform Ice Cap that&  it still looks fine.../^");
ds_map_add(global.text_data_en, "obj_iceroom_fakedog_64", "* (You tried to pet the dog^1,&  but it collapsed into a&  pile of fluff...)/");
ds_map_add(global.text_data_en, "obj_iceroom_fakedog_65", "* (Seems like it was actually&  just a dog-shaped husk of&  dog residue.)/%%");
ds_map_add(global.text_data_en, "obj_iceroom_fakedog_71", "* (It's a pile of dog residue.)/%%");
ds_map_add(global.text_data_en, "obj_instantnoodleitem_30", "* You put some water in&  the pot and place it on&  the heat./");
ds_map_add(global.text_data_en, "obj_instantnoodleitem_31", "* You wait for the water&  to boil.../");
ds_map_add(global.text_data_en, "obj_instantnoodleitem_32", "* ..^4.&* ..^4.&* .../");
ds_map_add(global.text_data_en, "obj_instantnoodleitem_33", "* It'^2s boiling./");
ds_map_add(global.text_data_en, "obj_instantnoodleitem_34", "* You place the noodle^1s&  into the pot./");
ds_map_add(global.text_data_en, "obj_instantnoodleitem_35", "* 4^3 minutes lef^3t until&  the noodle^2s are finished./");
ds_map_add(global.text_data_en, "obj_instantnoodleitem_36", "* 3^3 minutes lef^3t until&  the noodle^2s are finished./");
ds_map_add(global.text_data_en, "obj_instantnoodleitem_37", "* 2^3 minutes lef^3t until&  the noodle^2s are finished./");
ds_map_add(global.text_data_en, "obj_instantnoodleitem_38", "* 1^3 minute lef^3t until&  the noodle^2s are finished./");
ds_map_add(global.text_data_en, "obj_instantnoodleitem_39", "* The noodle^3s are finished./");
ds_map_add(global.text_data_en, "obj_instantnoodleitem_40", "* ... they don't taste very&  good./");
ds_map_add(global.text_data_en, "obj_instantnoodleitem_41", "* You add the flavor packet./");
ds_map_add(global.text_data_en, "obj_instantnoodleitem_42", "* That's better./");
ds_map_add(global.text_data_en, "obj_instantnoodleitem_43", "* Not great^1, but better./");
ds_map_add(global.text_data_en, "obj_instantnoodleitem_44", "  %%");
ds_map_add(global.text_data_en, "obj_instantnoodleitem_45", "* You remove the Instant&  Noodles from their&  packaging./");
ds_map_add(global.text_data_en, "obj_instantnoodleitem_85", "* You ate the Instant Noodles.");
ds_map_add(global.text_data_en, "obj_introimage_70", "Long ago^1, two races&ruled over Earth^1:&HUMANS and MONSTERS^6. \E1 ^1 %");
ds_map_add(global.text_data_en, "obj_introimage_71", "One day^1, war broke&out between the two&races^6. \E0 ^1 %");
ds_map_add(global.text_data_en, "obj_introimage_72", "After a long battle^1,&the humans were&victorious^6. \E1 ^1 %");
ds_map_add(global.text_data_en, "obj_introimage_73", "They sealed the monsters&underground with a magic&spell^6. \E0 ^1 %");
ds_map_add(global.text_data_en, "obj_introimage_74", "Many years later^2.^2.^5.  \E1 ^1 %");
ds_map_add(global.text_data_en, "obj_introimage_75", "      MT. EBOTT&         201X^9 \E0 %");
ds_map_add(global.text_data_en, "obj_introimage_76", "Legends say that those&who climb the mountain&never return^5.^3 \E1 %");
ds_map_add(global.text_data_en, "obj_introimage_78", " \E1 %");
ds_map_add(global.text_data_en, "obj_introimage_79", " ^9 ^5 \E0 %");
ds_map_add(global.text_data_en, "obj_introimage_80", " ^9 ^5 ^2 \E1 %");
ds_map_add(global.text_data_en, "obj_introimage_81", " ^9 ^5 ^2 \E2 %");
ds_map_add(global.text_data_en, "obj_introimage_82", " ^9 ^9 ^9 ^9 ^9 ^9 \E2 %%");
ds_map_add(global.text_data_en, "obj_introimage_83", " ^9 ^9 ^9 ^9 ^9  \E0 %%");
ds_map_add(global.text_data_en, "obj_introimage_84", " ^9 ^9 ^9 ^9 ^9 ^9 \E0 %");
ds_map_add(global.text_data_en, "obj_introimage_85", " %%");
ds_map_add(global.text_data_en, "obj_jerry_164", "Guys, it's COLD.&Does ANYONE care?");
ds_map_add(global.text_data_en, "obj_jerry_165", "Why are we doing&this? What a fail.");
ds_map_add(global.text_data_en, "obj_jerry_166", "Wow, you guys&SUCK at this.");
ds_map_add(global.text_data_en, "obj_jerry_167", "SHHHH! I'm&THINKING, guys!!");
ds_map_add(global.text_data_en, "obj_jerry_168", "Ka-SIGH.");
ds_map_add(global.text_data_en, "obj_jerry_171", "Well... can YOU&give me a ride&home?");
ds_map_add(global.text_data_en, "obj_jerry_172", "Huh? Did they&ditch me...? SOME&friends!");
ds_map_add(global.text_data_en, "obj_jerry_173", "Awkwarrrd.");
ds_map_add(global.text_data_en, "obj_jerry_174", "So, like, what&are you even&doing?");
ds_map_add(global.text_data_en, "obj_jerry_175", "The wi-fi here&sucks.");
ds_map_add(global.text_data_en, "obj_jerry_199", "Hahaha!&Say something&else funny!");
ds_map_add(global.text_data_en, "obj_jerry_200", "Haha! Wow!&Drake, you suck!");
ds_map_add(global.text_data_en, "obj_jerry_201", "Hahaha!&Where do you get&your ideas!?!");
ds_map_add(global.text_data_en, "obj_jerry_207", "%%%");
ds_map_add(global.text_data_en, "obj_jerry_407", "* Jerry eats powdery food and&  licks its hands loudly.");
ds_map_add(global.text_data_en, "obj_jerry_408", "* Jerry sneezes without covering&  its nose.");
ds_map_add(global.text_data_en, "obj_jerry_409", "* Jerry tells everyone it has to&  go to the bathroom.");
ds_map_add(global.text_data_en, "obj_jerry_410", "* Jerry lets out a yawn.");
ds_map_add(global.text_data_en, "obj_jerry_411", "* Smells like....... Jerry.");
ds_map_add(global.text_data_en, "obj_jerry_412", "* Jerry is wounded.");
ds_map_add(global.text_data_en, "obj_jerry_414", "* The other monsters celebrate&  Jerry's disappearance.");
ds_map_add(global.text_data_en, "obj_jerry_415", "* Return of Jerry.");
ds_map_add(global.text_data_en, "obj_jerry_442", "* JERRY - ATK 0 DEF 30&* Everyone knows Jerry.&* Makes attacks 2 seconds longer./^");
ds_map_add(global.text_data_en, "obj_jerry_450", "* You and the other&  monsters ditch Jerry&  when it looks away!/^");
ds_map_add(global.text_data_en, "obj_jetpackchara_198", "* MY MY./");
ds_map_add(global.text_data_en, "obj_jetpackchara_199", "* IT SEEMS YOU'VE BESTED ME./");
ds_map_add(global.text_data_en, "obj_jetpackchara_200", "* BUT ONLY BECAUSE YOU HAD&  THE HELP OF THE BRILLIANT&  DOCTOR ALPHYS!/");
ds_map_add(global.text_data_en, "obj_jetpackchara_201", "* OH^1, I LOATHE TO THINK OF&  WHAT WOULD HAVE HAPPENED&  TO YOU WITHOUT HER!!!/");
ds_map_add(global.text_data_en, "obj_jetpackchara_203", "* WELL^1, TOODLES!!/%%");
ds_map_add(global.text_data_en, "obj_jetpackchara_223", "* OH YES^1!&* ABOUT THE SUBSTITUTION.../");
ds_map_add(global.text_data_en, "obj_jetpackchara_224", "* HAVEN'T YOU EVER SEEN&  A COOKING SHOW BEFORE?/");
ds_map_add(global.text_data_en, "obj_jetpackchara_225", "* I ALREADY BAKED THE CAKE&  AHEAD OF TIME!!!!!&* SO FORGET IT!!!/%%");
ds_map_add(global.text_data_en, "obj_jetpackchara_301", "* Ring.../");
ds_map_add(global.text_data_en, "obj_jetpackchara_302", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_jetpackchara_303", "* Wh-what!^1?&* Wh-why aren't you&  m-m-moving?/");
ds_map_add(global.text_data_en, "obj_jetpackchara_304", "* N-no...^1!&* I must not have&  added enough fuel!/");
ds_map_add(global.text_data_en, "obj_jetpackchara_305", "\E8* D-darnit..^1.&* I'm sorry.../");
ds_map_add(global.text_data_en, "obj_jetpackchara_306", "* Even when it's&  something like&  this^1, I.../");
ds_map_add(global.text_data_en, "obj_jetpackchara_307", "* I still...^1!&* I still.../%%");
ds_map_add(global.text_data_en, "obj_jetpackchara_324", "* OH NO^1, WOULD YOU LOOK AT&  THAT!/");
ds_map_add(global.text_data_en, "obj_jetpackchara_325", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_jetpackchara_326", "* What?/");
ds_map_add(global.text_data_en, "obj_jetpackchara_327", "\TS \E0 \F0 \TM %");
ds_map_add(global.text_data_en, "obj_jetpackchara_328", "* I FORGOT!&* RIGHT ABOUT NOW IS WHEN&  WE HAVE OUR COMMERCIAL BREAK!/");
ds_map_add(global.text_data_en, "obj_jetpackchara_329", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_jetpackchara_330", "* Wh..^1.&* What are you...%");
ds_map_add(global.text_data_en, "obj_jetpackchara_331", "\TS \E0 \F0 \TM %");
ds_map_add(global.text_data_en, "obj_jetpackchara_332", "* UNFORTUNATELY, THAT MEANS&  NO ONE IS WATCHING THIS&  RIGHT NOW./");
ds_map_add(global.text_data_en, "obj_jetpackchara_333", "* I'M NOT GOING TO DESTROY&  YOU WITHOUT A LIVE&  TELEVISION AUDIENCE!!/");
ds_map_add(global.text_data_en, "obj_jetpackchara_334", "* LOOKS LIKE YOU'VE FOILED ME&  ONCE AGAIN, THANKS TO THE&  BRILLIANT DR. ALPHYS!!!/");
ds_map_add(global.text_data_en, "obj_jetpackchara_335", "* UNTIL NEXT TIME, BEAUTIFUL!/");
ds_map_add(global.text_data_en, "obj_jetpackchara_336", "* TOODLES!/%%");
ds_map_add(global.text_data_en, "obj_judgeshroom_91", "* hOIVS!/%%");
ds_map_add(global.text_data_en, "obj_judgeshroom_95", "* p..^1.&* tem heard human allergics&  to tem.../");
ds_map_add(global.text_data_en, "obj_judgeshroom_96", "* dat OK..^1.&* tem understan.../");
ds_map_add(global.text_data_en, "obj_judgeshroom_97", "* tem..^1.&* ALSO allergic to tem!!!/%%");
ds_map_add(global.text_data_en, "obj_judgeshroom_187", "* Mushroom danc^2e&* Mushroom danc^2e&* Whatever could it mean/%%");
ds_map_add(global.text_data_en, "obj_judgeshroom_211", "* It symbolizes my inner&  pain./%%");
ds_map_add(global.text_data_en, "obj_judgeshroom_213", "* It symbolizes my inner&  torment^1, trapped here&  by my hyphae./");
ds_map_add(global.text_data_en, "obj_judgeshroom_214", "* My struggle to pull away^1.&* My struggle to escape^1.&* But alas^1, to no avail./%%");
ds_map_add(global.text_data_en, "obj_judgeshroom_218", "* If only I could see the&  world above./");
ds_map_add(global.text_data_en, "obj_judgeshroom_219", "* But even if the barrier&  was open^1, how would I&  leave...?/%%");
ds_map_add(global.text_data_en, "obj_judgeshroom_224", "* It means you've lived a&  life of sin./%%");
ds_map_add(global.text_data_en, "obj_judgeshroom_226", "* It means..^1.&* Don't talk to me./%%");
ds_map_add(global.text_data_en, "obj_judgeshroom_231", "* It symbolizes my unbridled&  happiness./");
ds_map_add(global.text_data_en, "obj_judgeshroom_232", "* The government told me&  they are willing to&  transplant me outside!/");
ds_map_add(global.text_data_en, "obj_judgeshroom_233", "* Why didn't you smile at my&  dance^1? It almost feels&  a little rude.../%%");
ds_map_add(global.text_data_en, "obj_killerboysnightout_event_101", "* ... you're here./");
ds_map_add(global.text_data_en, "obj_killerboysnightout_event_102", "* So that means Undyne..^1.&* She's.../");
ds_map_add(global.text_data_en, "obj_killerboysnightout_event_103", "* Like^1, Undyne^1!&* We'll avenge you!/%%");
ds_map_add(global.text_data_en, "obj_killerlab_event_113", "* OH^1, THERE YOU ARE./");
ds_map_add(global.text_data_en, "obj_killerlab_event_114", "\M5* YOU UGLY LITTLE CREATURE^1.&* YOU'VE MADE QUITE A NAME&  FOR YOURSELF./");
ds_map_add(global.text_data_en, "obj_killerlab_event_115", "\M3* SUCH INFAMY...^1!&* I'M IMPRESSED./");
ds_map_add(global.text_data_en, "obj_killerlab_event_116", "\M4* OH^1. YES^1.&* IF YOU'RE LOOKING FOR ALPHYS^1,&  SHE'S NOT HERE./");
ds_map_add(global.text_data_en, "obj_killerlab_event_117", "\M0* WHILE YOU WERE BUSY DOING&  YOUR^1, AHEM^1, THING.../");
ds_map_add(global.text_data_en, "obj_killerlab_event_118", "* SHE WAS RUNNING AROUND&  EVACUATING PEOPLE TO SAFETY./");
ds_map_add(global.text_data_en, "obj_killerlab_event_119", "\M4* NOW THEY'RE IN A PLACE&  WHERE YOU'LL NEVER GET TO&  THEM./");
ds_map_add(global.text_data_en, "obj_killerlab_event_120", "\M2* DECIDING NOT TO FIGHT YOU^1.&* MY MY^1, SHE REALLY IS THE&  ONLY SMART ONE^1, ISN'T SHE?/%%");
ds_map_add(global.text_data_en, "obj_killerlab_event_151", "\M0* OH^1?&* HOW SASSY./");
ds_map_add(global.text_data_en, "obj_killerlab_event_152", "\M4* YOU'RE JUST ITCHING TO GET&  YOUR HANDS ON ME^1, AREN'T&  YOU?/");
ds_map_add(global.text_data_en, "obj_killerlab_event_153", "\M5* WELL..^1. T-O-O B-A-D!/");
ds_map_add(global.text_data_en, "obj_killerlab_event_154", "\M4* THIS WORLD NEEDS STARS MORE&  THAN IT NEEDS CORPSES!/");
ds_map_add(global.text_data_en, "obj_killerlab_event_155", "\M1* TOODLES!/%%");
ds_map_add(global.text_data_en, "obj_kitchenforcefield_123", "* (As per culinary standard^1,&  a death forcefield surrounds&  the kitchen.)/%%");
ds_map_add(global.text_data_en, "obj_kitchenforcefield_124", "* (As per journalistic standards^1,&  a death forcefield surrounds&  the area of intrigue.)/%%");
ds_map_add(global.text_data_en, "obj_kitchenforcefield_125", "* (It's the kind of every-day&  death forcefield you see&  at home.)/%%");
ds_map_add(global.text_data_en, "obj_kitchenforcefield_126", "* (It's a forcefield.)/%%");
ds_map_add(global.text_data_en, "obj_kitchenforcefield_127", "* (It's a battery-powered&  forcefield.)/%%");
ds_map_add(global.text_data_en, "obj_kitchenforcefield_128", "* (It's a forcefield.)/%%");
ds_map_add(global.text_data_en, "obj_knock_room_62", "%%");
ds_map_add(global.text_data_en, "obj_knock_room_65", "* (Doesn't seem like&  anyone's home.)/%%");
ds_map_add(global.text_data_en, "obj_knock_room_67", "* (If someone's there^1,&  they aren't answering&  the door.)/%%");
ds_map_add(global.text_data_en, "obj_knock_room_69", "* (No one is home.^1)&* (And you get the feeling&  no one ever will be.)/%%");
ds_map_add(global.text_data_en, "obj_knock_room_71", "* (You hear irritated groans&  from the inside.)/%%");
ds_map_add(global.text_data_en, "obj_knock_room_75", "* (Sounds like only fire&  lives here now.)/%%");
ds_map_add(global.text_data_en, "obj_knock_room_81", "* Who's there^1?&* I'm in the middle of&  my favorite TV program./");
ds_map_add(global.text_data_en, "obj_knock_room_82", "* I know^1, I know..^1.&* Staring at a screen...&* Sounds like a boring hobby./");
ds_map_add(global.text_data_en, "obj_knock_room_83", "* But TV offers an escape&  to another world^1.&* We really need that./%%");
ds_map_add(global.text_data_en, "obj_knock_room_86", "* You wanna watch too^1?&* Sorry^1, this is a one-player&  TV show./%%");
ds_map_add(global.text_data_en, "obj_knock_room_91", "* Ahh^1, what a beautiful knock..^1.!&* Maybe if I don't answer^1,&  I'll hear it again./%%");
ds_map_add(global.text_data_en, "obj_knock_room_93", "* Ahh^1, my patience rewards me./%%");
ds_map_add(global.text_data_en, "obj_knock_room_95", "* Ahh.../%%");
ds_map_add(global.text_data_en, "obj_knock_room_99", "* (No answer.)/%%");
ds_map_add(global.text_data_en, "obj_knock_room_113", "* (No answer.)/%%");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_218", "* Hey^1!&* Stop!!!/%%");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_258", "* I got you guys some&  food^1, okay!?/%%");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_294", "\E4* Sorry about that.../");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_295", "\E2* They get kind of sassy&  when they don't get&  fed on time./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_296", "\E3* Um!!/");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_299", "\E3* I think they smelled&  the potato chips you&  had^1, and.../");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_301", "\E3* Anyway!/");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_302", "\E6* The power went out^1,&  and I've been trying&  to turn it back on!/");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_303", "\E4* But it seems like you&  were one step ahead&  of me./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_304", "\E2* This was probably just&  a big inconvenience&  for you.../");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_305", "\E4* B-but I appreciate&  that you came here&  to back me up!/");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_306", "\E4* As I said^1, I was&  afraid I might.../");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_307", "\E8* Not come back.../");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_308", "\E5* But that's not because&  of these guys or&  anything!/");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_309", "\E4* I was just worried I&  would be too afraid.../");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_310", "\E9* To tell the truth.../");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_311", "\E8* That I might run away^1,&  or do something.../");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_312", "\E9* Cowardly./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_313", "* .../");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_314", "*\E8 Uh..^1. I..^1.&* I suppose I owe you&  an explanation./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_315", "\E9* As you probably know^1,&  ASGORE asked me to study&  the nature of SOULs./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_316", "\E3* During my research^1, I&  isolated a power I&  called \"determination.\"/");ds_map_add(global.text_data_en, "obj_lab_powerswitch_317", "\E6* I injected it into dying&  monsters so their SOULs&  would last after death./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_318", "\E9* But the experiment&  failed./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_319", "* You see^1, unlike humans',&  monsters' bodies don't&  have enough.../");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_320", "* Physical matter to take&  those concentrations&  of \"determination.\"/");ds_map_add(global.text_data_en, "obj_lab_powerswitch_321", "* Their bodies started to&  melt^1, and lost what&  physicality they had./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_322", "\E3* Pretty soon^1, all of the&  test subjects had melted&  together into.../");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_323", "\E8* Those./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_324", "\E9* Seeing them like this^1,&  I knew.../");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_325", "\E8* I couldn't tell their&  families about it./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_326", "\E8* I couldn't tell anyone&  about it./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_327", "\E9* No matter how much&  everyone was asking me./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_328", "\E9* And I was too afraid to&  do any more work^1,&  knowing.../");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_329", "\E8* ... everything I'd done&  so far had been such&  a horrific failure./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_330", "\E9* ... but now./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_331", "\E9* Now^1, I've changed my&  mind about all this./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_332", "\E9* I'm going to tell&  everyone what I've done./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_333", "\E9* .../");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_335", "* It's going to be hard./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_336", "* Being honest..^1.&* Believing in myself.../");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_337", "* I'm sure there will be&  times where I'll&  struggle./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_338", "* I'm sure there will be&  times where I screw&  up again./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_339", "\E0* But knowing^1, deep down^1,&  that I have friends&  to fall back on.../");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_340", "\E7* I know it'll be a&  lot easier to stand&  on my own./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_341", "* Thank you./%%");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_406", "* Come on^1, guys./");
ds_map_add(global.text_data_en, "obj_lab_powerswitch_407", "* It's time for everyone&  to go home./%%");
ds_map_add(global.text_data_en, "obj_labelevator_a_242", " WARNING! WARNING^6!%");
ds_map_add(global.text_data_en, "obj_labelevator_a_243", " ELEVATOR LOSING POWER^6!%");
ds_map_add(global.text_data_en, "obj_labelevator_a_244", " EM TETHER STABILITY LOST^6!%");
ds_map_add(global.text_data_en, "obj_labelevator_a_245", " ALTITUDE DROPPING^6!%%");
ds_map_add(global.text_data_en, "obj_labelevator_b_122", "* (Ring...)/");
ds_map_add(global.text_data_en, "obj_labelevator_b_123", "* (It's a voice you have&  never heard before.)/%%");
ds_map_add(global.text_data_en, "obj_labelevator_b_131", "* \[C]..^1.&* Are you there?/");
ds_map_add(global.text_data_en, "obj_labelevator_b_132", "* It's been a long time^1,&  hasn't it...?/");
ds_map_add(global.text_data_en, "obj_labelevator_b_133", "* But you've done well./");
ds_map_add(global.text_data_en, "obj_labelevator_b_134", "* Thanks to you^1, everything&  has fallen into place./");
ds_map_add(global.text_data_en, "obj_labelevator_b_135", "* \[C].../");
ds_map_add(global.text_data_en, "obj_labelevator_b_136", "* See you soon./%%");
ds_map_add(global.text_data_en, "obj_labtv_event_94", "* (There's a VHS player with a&  few tapes picked out beside&  it...)/");
ds_map_add(global.text_data_en, "obj_labtv_event_95", "* (They seem to be labelled&  in a specific order.)/");
ds_map_add(global.text_data_en, "obj_labtv_event_96", "* (Will you watch one...?)/%%");
ds_map_add(global.text_data_en, "obj_labtv_event_98", "* (Choose a tape to watch.)/%%");
ds_map_add(global.text_data_en, "obj_labtv_event_287", "* Psssst^1.&* Gorey^1, wake up. \Ta/");
ds_map_add(global.text_data_en, "obj_labtv_event_288", "* Mmm^1?&* What is it^1, dear?/");
ds_map_add(global.text_data_en, "obj_labtv_event_289", "* ... err^1, and why do you&  have that video camera? \TT/");
ds_map_add(global.text_data_en, "obj_labtv_event_290", "* Shush^1!&* I want to get your&  reaction./");
ds_map_add(global.text_data_en, "obj_labtv_event_291", "* Gorey^1, dearest^1.&* What is my favorite&  vegetable?\Ta/");
ds_map_add(global.text_data_en, "obj_labtv_event_292", "* Hmmm..^1.&* Carrots^1, right?\TT/");
ds_map_add(global.text_data_en, "obj_labtv_event_293", "* No no no^1!&* My FAVORITE vegetable is.../");
ds_map_add(global.text_data_en, "obj_labtv_event_294", "* Eda-MOM-e./");
ds_map_add(global.text_data_en, "obj_labtv_event_295", "* ... get it???\Ta/");
ds_map_add(global.text_data_en, "obj_labtv_event_296", "* .../");
ds_map_add(global.text_data_en, "obj_labtv_event_297", "* Go back to bed^1, dear.\TT/");
ds_map_add(global.text_data_en, "obj_labtv_event_298", "* No no!^1!&* Not yet^1!&* Hee hee hee./");
ds_map_add(global.text_data_en, "obj_labtv_event_299", "* Now^1, If I were a dog^1,&  what breed of dog would&  I be?\Ta/");
ds_map_add(global.text_data_en, "obj_labtv_event_300", "* Hmmm..^1. I don't know^1, honey^1.&* What kind of dog would&  you be?\TT/");
ds_map_add(global.text_data_en, "obj_labtv_event_301", "* I would be.../");
ds_map_add(global.text_data_en, "obj_labtv_event_302", "* A MOMERANIAN.\Ta/");
ds_map_add(global.text_data_en, "obj_labtv_event_303", "* Hohoho!/");
ds_map_add(global.text_data_en, "obj_labtv_event_304", "* You sure are excited to&  have this child./");
ds_map_add(global.text_data_en, "obj_labtv_event_305", "* You know^1, if you keep&  making jokes like&  this.../");
ds_map_add(global.text_data_en, "obj_labtv_event_306", "* One day^1, you could be.../");
ds_map_add(global.text_data_en, "obj_labtv_event_307", "* ... a famous MOMedian.\TT/");
ds_map_add(global.text_data_en, "obj_labtv_event_308", "* .../");
ds_map_add(global.text_data_en, "obj_labtv_event_309", "* Well^1, I am going to bed.\Ta/");
ds_map_add(global.text_data_en, "obj_labtv_event_310", "* Hey^1!&* Come on^1, Tori^1!&* That one was funny!\TT/");
ds_map_add(global.text_data_en, "obj_labtv_event_311", "* Hahaha^1, I know^1.&* I am just teasing you./");
ds_map_add(global.text_data_en, "obj_labtv_event_312", "* Goodnight^1, dear.\Ta/");
ds_map_add(global.text_data_en, "obj_labtv_event_313", "* Goodnight, honey.\TT/");
ds_map_add(global.text_data_en, "obj_labtv_event_314", "* .../");
ds_map_add(global.text_data_en, "obj_labtv_event_315", "* Oh dear^1, perhaps it is too&  dark in here for the&  video to come out.../%%");
ds_map_add(global.text_data_en, "obj_labtv_event_350", "* Okay^1, \[C]^1, are you ready?/");
ds_map_add(global.text_data_en, "obj_labtv_event_351", "* Do your creepy face!/");
ds_map_add(global.text_data_en, "obj_labtv_event_352", "* AHHHHH!^1!&* Hee hee hee!/");
ds_map_add(global.text_data_en, "obj_labtv_event_353", "* Oh^1!&* Wait^1!&* I had the lens cap on.../");
ds_map_add(global.text_data_en, "obj_labtv_event_354", "* What!^1?&* You're not gonna do it&  again...?/");
ds_map_add(global.text_data_en, "obj_labtv_event_355", "* Come on^1, quit tricking me^1!&* Haha!/%%");
ds_map_add(global.text_data_en, "obj_labtv_event_391", "* Howdy^1, \[C]^1!&* Smile for the camera!/");
ds_map_add(global.text_data_en, "obj_labtv_event_392", "* Ha^1, this time I got YOU^1!&* I left the cap on..^1.&* ON PURPOSE!/");
ds_map_add(global.text_data_en, "obj_labtv_event_393", "* Now you're smiling for&  noooo reason^1!&* Hee hee hee!/");
ds_map_add(global.text_data_en, "obj_labtv_event_394", "* What^1?&* Oh^1, yeah^1, I remember./");
ds_map_add(global.text_data_en, "obj_labtv_event_395", "* When we tried to make&  butterscotch pie for Dad^1,&  right?/");
ds_map_add(global.text_data_en, "obj_labtv_event_396", "* The recipe asked for cups&  of butter.../");
ds_map_add(global.text_data_en, "obj_labtv_event_397", "* But we accidentally put&  in buttercups instead./");
ds_map_add(global.text_data_en, "obj_labtv_event_398", "* Yeah^1!&* Those flowers got him&  really sick./");
ds_map_add(global.text_data_en, "obj_labtv_event_399", "* I felt so bad^1.&* We made Mom really upset./");
ds_map_add(global.text_data_en, "obj_labtv_event_400", "* I should have laughed it&  off^1, like you did.../");
ds_map_add(global.text_data_en, "obj_labtv_event_401", "* Um^1, anyway^1, where are you&  going with this?/");
ds_map_add(global.text_data_en, "obj_labtv_event_402", "* Huh^1?&* Turn off the camera...^1?&* OK./%%");
ds_map_add(global.text_data_en, "obj_labtv_event_435", "* I..^1. I don't like this idea^1,&  \[C]./");
ds_map_add(global.text_data_en, "obj_labtv_event_436", "* Wh.^1. what^1?&* N-no, I'm not.../");
ds_map_add(global.text_data_en, "obj_labtv_event_437", "* ... big kids don't cry./");
ds_map_add(global.text_data_en, "obj_labtv_event_438", "* Yeah^1, you're right./");
ds_map_add(global.text_data_en, "obj_labtv_event_439", "* No^1!&* I'd never doubt you^1, \[C]..^1.&* Never!/");
ds_map_add(global.text_data_en, "obj_labtv_event_440", "* Y..^1. yeah^1!&* We'll be strong^1!&* We'll free everyone./");
ds_map_add(global.text_data_en, "obj_labtv_event_441", "* I'll go get the flowers./%%");
ds_map_add(global.text_data_en, "obj_labtv_event_473", "* \[C]..^1.&* Can you hear me^1?&* We want you to wake up...\Ta/");
ds_map_add(global.text_data_en, "obj_labtv_event_474", "* \[C]^1!&* You have to stay determined!/");
ds_map_add(global.text_data_en, "obj_labtv_event_475", "* You can't give up..^1.&* You are the future of humans&  and monsters...\TR/");
ds_map_add(global.text_data_en, "obj_labtv_event_476", "* .../");
ds_map_add(global.text_data_en, "obj_labtv_event_477", "* Psst... \[C]..^1.&* Please..^1. wake up.../");
ds_map_add(global.text_data_en, "obj_labtv_event_478", "* I don't like this plan&  anymore./");
ds_map_add(global.text_data_en, "obj_labtv_event_479", "* I..^1. I.../");
ds_map_add(global.text_data_en, "obj_labtv_event_480", "* ..^1. no^1, I said..^1.&* I said I'd never doubt you./");
ds_map_add(global.text_data_en, "obj_labtv_event_481", "* Six^1, right^1?&* We just have to get six.../");
ds_map_add(global.text_data_en, "obj_labtv_event_482", "* And we'll do it together^1,&  right?/%%");
ds_map_add(global.text_data_en, "obj_ladiesfishingrod_137", "* You send the line back out./%%");
ds_map_add(global.text_data_en, "obj_laserswitch1_90", "* (Didn't work.)/%%");
ds_map_add(global.text_data_en, "obj_laserswitch1_119", "* Ring.../");
ds_map_add(global.text_data_en, "obj_laserswitch1_120", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_laserswitch1_121", "\E3* H-hey^1, watch out^1!&* You're going to get&  really hurt!/");
ds_map_add(global.text_data_en, "obj_laserswitch1_122", "\E8* I can't watch this^1.&* I'm disabling the&  lasers./%%");
ds_map_add(global.text_data_en, "obj_laserswitch1_161", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_laserswitch1_162", "\E6* Th..^1. there./");
ds_map_add(global.text_data_en, "obj_laserswitch1_163", "\E3* Be careful^1, okay?/");
ds_map_add(global.text_data_en, "obj_laserswitch1_164", "\E8* .../");
ds_map_add(global.text_data_en, "obj_laserswitch1_165", "\E8* I-I'm sorry^1, it's&  m-my fault you&  got hurt./");
ds_map_add(global.text_data_en, "obj_laserswitch1_166", "\E8* I didn't explain the&  lasers well enough^1,&  and../");
ds_map_add(global.text_data_en, "obj_laserswitch1_167", "\E8* If I hadn't..^1.&* If I hadn't..^1./");
ds_map_add(global.text_data_en, "obj_laserswitch1_168", "\E4* Um^1, delayed using&  my hacking skills^1,&  I mean.../");
ds_map_add(global.text_data_en, "obj_laserswitch1_169", "\E8* ... sorry./");
ds_map_add(global.text_data_en, "obj_laserswitch1_170", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_laserswitch1_171", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_laserswitch1_174", "\E8* I-I'm sorry^1, it's&  m-my fault you&  got hurt./");
ds_map_add(global.text_data_en, "obj_laserswitch1_175", "\E8* I didn't explain the&  lasers well enough^1,&  and.../");
ds_map_add(global.text_data_en, "obj_laserswitch1_176", "\E3* O-oh^1, there's no&  time for this now!/");
ds_map_add(global.text_data_en, "obj_laserswitch1_177", "\E8* Sorry./");
ds_map_add(global.text_data_en, "obj_laserswitch1_178", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_laserswitch1_179", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_lastbeam_230", "STOP IT!!");
ds_map_add(global.text_data_en, "obj_lastbeam_255", "STOP IT NOW!!!");
ds_map_add(global.text_data_en, "obj_lastbeam_296", "* ...");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_187", "* So you finally made it./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_188", "* The end of your journey&  is at hand./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_189", "* In a few moments^1, you&  will meet the king./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_190", "* Together.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_191", "* You will determine the&  future of this world./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_192", "* That's then./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_193", "* Now./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_194", "* You will be judged./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_195", "* You will be judged for&  your every action./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_196", "* You will be judged for&  every EXP you've earned./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_197", "* What's EXP?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_198", "* It's an acronym./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_199", "\W* It stands for \"\Rexecution&  points\W.\"/");ds_map_add(global.text_data_en, "obj_lastsans_trigger_200", "* A way of quantifying the&  pain you have inflicted on&  others./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_201", "* When you kill someone^1,&  your EXP increases./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_202", "* When you have enough EXP^1,&  your LOVE increases./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_203", "* LOVE^1, too^1, is an&  acronym./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_204", "\W* It stands for \"\RLevel of&  Violence\W.\"/");ds_map_add(global.text_data_en, "obj_lastsans_trigger_205", "* A way of measuring someone's&  capacity to hurt./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_206", "* The more you kill^1, the&  easier it becomes to&  distance yourself./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_207", "* The more you distance&  yourself^1, the less you&  will hurt./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_208", "* The more easily you&  can bring yourself to&  hurt others./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_214", "* So you finally made it.../%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_243", "* Now^1, you understand./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_244", "* It's time to begin your&  judgment./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_245", "* Look inside yourself./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_246", "* Have you really done the&  right thing?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_247", "* And^1, considering what&  you've done.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_248", "* What will you do now?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_249", "* Take a moment to think&  about this./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_268", "\TS* .../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_269", "\Ts*\E0 ... but you^1.&* you never gained&  any LOVE./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_270", "\E1* 'course^1, that doesn't&  mean you're completely&  innocent or naive./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_271", "\E0* just that you kept&  a certain tenderness&  in your heart./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_274", "* no matter the struggles&  or hardships you&  faced.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_275", "* you strived to do the&  right thing./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_276", "* you refused to hurt&  anyone./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_277", "* even when you ran&  away^1, you did it&  with a smile./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_278", "* you never gained LOVE^1,&  but you gained love./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_279", "* does that make sense?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_280", "* maybe not./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_283", "\E3* ..^1.&* now./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_284", "\E0* you're about to face&  the greatest challenge&  of your entire journey./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_285", "* your actions here.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_286", "* will determine the&  fate of the entire&  world./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_287", "* if you refuse to&  fight.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_288", "* asgore will take&  your soul and&  destroy humanity./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_289", "* but if you kill&  asgore and go&  home.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_290", "* monsters will remain&  trapped underground./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_291", "* what will you do?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_292", "\E3* .../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_293", "* well^1, if i were you^1,&  i would have thrown&  in the towel by now./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_294", "\E1* but you didn't get&  this far by giving&  up^1, did you?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_295", "\E0* that's right./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_296", "* you have something&  called \"determination.\"/");ds_map_add(global.text_data_en, "obj_lastsans_trigger_297", "* so as long as you&  hold on.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_298", "* so as long as you&  do what's in your&  heart.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_299", "* i believe you can do&  the right thing./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_300", "\E3* alright./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_301", "\E0* we're all counting&  on you, kid./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_302", "\E2* good luck./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_361", "\TS* .../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_362", "\Ts*\E0 truthfully^1, it doesn't&  really matter what you&  said./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_363", "\E0* all that's important is&  that you were honest&  with yourself./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_364", "* what happens now.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_365", "* we leave up to you./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_390", "* Then why'd you&  kill my&  brother?/%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_402", "* You dirty brother&  killer./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_421", "* huh^1?&* you look bored./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_422", "\E1* i get the feeling&  you aren't gonna learn&  anything from this./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_423", "\E0* well^1, guess I gotta&  judge you then./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_424", "* come on^1.&* really?/%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_428", "* lv2..^1.&* seems like you messed&  up the slightest amount./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_429", "\E1* welp^1.&* that's pretty sad./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_430", "\E3* you probably weren't&  even aware of what you&  were doing.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_431", "* and when you learned^1,&  it was too late./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_432", "\E2* nah^1, just kidding./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_433", "\E1* who gets to lv2 on&  accident^1?&* get outta here./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_437", "\E3* lv3.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_438", "\E1* 3's just an ok number^1,&  i guess./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_439", "\E2* i'll give you a C+./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_440", "\E1* you can do better^1,&  right?/%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_444", "\E3* hmmm..^1.&* over lv3^1, huh./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_445", "\E0* you killed some people&  on purpose^1, didn't you?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_446", "\E1* that's probably bad./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_447", "\E3* though^1, maybe some&  of it was in self-&  defense.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_448", "\E1* i don't know^1.&* help me out here./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_449", "* i wasn't watching./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_450", "\E2* anyways^1, don't do that./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_454", "\E3* hmmm..^1.&* over lv9^1, huh./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_455", "\E0* that's over halfway to&  lv20^1, the maximum./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_456", "\E1* but don't think that&  means you're still 50-&  percent good./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_457", "\E3* 50-percent^1, 20-percent./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_458", "\E4* those are both still&  failing grades./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_459", "\E1* besides^1.&* chances are.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_460", "* i've already tried to&  steer you in the right&  direction./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_461", "\E0* so what can i say?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_462", "\E3* what can i say that&  will change the mind of&  a being like you...?/%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_466", "\E3* hmmm..^1.&* over lv14^1, huh./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_467", "\E1* well^1, hmmm..^1.&* judgment-wise.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_468", "\E4* you're a pretty bad&  person./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_469", "* you wander around^1,&  looking for people.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_470", "* killing them to take&  their money./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_471", "\E3* that's just plain&  messed up./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_472", "\E1* and what's worse^1, is&  that as bad as you&  are.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_473", "\E2* you aren't anywhere near&  as bad as you could&  be./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_474", "\E1* you pretty much suck&  at being evil./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_475", "\E1* honestly^1, it's super&  embarrassing./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_476", "\E2* but maybe you'd be&  better.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_477", "\E1* at not killing anyone?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_478", "\E2* crazy idea^1, huh?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_479", "\E0* let me know how that&  one goes./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_485", "* ... huh?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_486", "\E0* what's with that look&  in your eye?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_487", "\E3* did you go through and&  kill someone.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_488", "\E3* just to see what i'd&  say about it?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_489", "\E1* wow^1./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_490", "\E2* you're a pretty gross&  person^1, huh?/%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_494", "\E1* huh^1?&* you STILL look bored./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_495", "\E2* okay then^1, consider&  our session over./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_513", "\E3* .../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_514", "\E1* wait a second./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_515", "\E1* that look on your&  face while i was&  talking.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_516", "\E2* you've already heard&  my spiel^1, haven't you?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_517", "\E3* i suspected something&  like this./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_518", "\E3* you're always acting&  like you know what's&  going to happen./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_519", "\E1* like you've seen it&  all before./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_520", "\E3* so..^1.&* i have a request for&  you./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_521", "\W*\E1 i kind of have a&  \Ysecret codeword\W &  that only i know./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_522", "\E0* so i know if someone&  tells it to me.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_523", "\E1* they'll have to be a&  time traveller./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_524", "\E2* crazy^1, right?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_525", "\E1* anyway^1, here it is.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_526", "\E3* (whisper^1, whisper)/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_527", "\E2* i'm counting on you to&  come back here and&  tell me that./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_528", "\E1* see you later./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_532", "\E0* .../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_533", "\E1* huh^1?&* do you have something&  to say to me?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_534", "\E2* what^1? a codeword^1?&* can you speak a&  little louder?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_535", "\E3* .../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_536", "* did you.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_537", "\E2* ... just say \"i'm a&  stupid doodoo butt?\"/");ds_map_add(global.text_data_en, "obj_lastsans_trigger_538", "\E1* wow^1.&* i can't believe you&  would say that./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_539", "\E3* not only is that&  completely infantile.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_540", "\E2* but it's also my&  secret codeword./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_541", "\E3* that^1, however^1, isn't&  good enough./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_542", "\W*\E1 what you need is the&  \Ysecret\W secret codeword./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_543", "\E2* it's only for people&  that know the secret&  codeword./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_544", "\E0* anyway^1, here it is.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_545", "\E4* (whimsper^1, whimsper).../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_546", "\E2* i'm counting on you to&  come back here and&  tell me that./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_547", "\E1* see you later./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_553", "\E0* .../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_554", "\E1* huh^1?&* do you have something&  to say to me?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_555", "\E2* what^1? a codeword^1?&* can you speak a&  little louder?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_556", "\E3* .../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_557", "* did you.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_558", "\E2* ... just say \"i'm the&  legendary fartmaster?\"/");ds_map_add(global.text_data_en, "obj_lastsans_trigger_559", "\E1* wow./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_560", "\E1* that's..^1. uh..^1.&* really childish./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_561", "\E2* why would you think&  that was a secret&  secret codeword?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_562", "\E1* whoever told you that&  is a dirty liar./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_563", "\E2* i don't have a secret&  secret codeword./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_564", "\E3* however./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_565", "\E2* i do have a secret&  secret triple-secret&  codeword./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_566", "\E1* which you just said./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_567", "\E2* so^1, i guess you're&  qualified./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_568", "\E2* here's the key to my&  room./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_569", "\E3* it's time.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_570", "* you learned the truth./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_571", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_572", "* (When you looked^1, the key was&  already on your keychain.)/%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_578", "\E0* .../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_579", "\E1* huh^1?&* triple secret codeword?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_580", "\E2* nah^1, i'm out of&  material./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_581", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_582", "* (You felt something on your&  keychain.)/%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_634", "\E0* heya./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_635", "\E1* you've been busy^1,&  huh?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_636", "* .../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_637", "\E0* so^1, i've got a&  question for ya./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_638", "\E3* do you think even&  the worst person can&  change...?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_639", "\E3* that everybody can be&  a good person^1, if&  they just try?/%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_643", "\E0* heya./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_644", "\E1* you look frustrated&  about something./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_645", "\E4* guess i'm pretty good&  at my job^1, huh?/%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_650", "\E0* hmm^1.&* that expression.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_651", "\E1* that's the expression&  of someone who's died&  twice in a row./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_652", "\E2* suffice to say^1, you&  look really..^1.&* unsatisfied./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_653", "\E3* all right./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_654", "\E4* how 'bout we make it&  a third?/%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_659", "\E0* hmm^1.&* that expression.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_660", "\E1* that's the expression&  of someone who's died&  thrice in a row./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_661", "\E3* .../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_662", "\E1* hey^1, what comes after&  \"thrice^1,\" anyway?/");ds_map_add(global.text_data_en, "obj_lastsans_trigger_663", "\E4* wanna help me find out?/%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_668", "\E0* hmm^1.&* that expression.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_669", "\E1* that's the expression&  of someone who's died&  quice in a row./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_670", "\E1* quice^1?&* frice?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_671", "\E4* welp^1, won't have to&  use it again anyways./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_676", "\E0* hmm^1.&* that expression.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_677", "\E1* that's the expression&  of someone who's died&  five times in a row./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_678", "\E2* convenient^1, huh^1?&* that's one for each&  finger./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_679", "\E3* but soon.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_680", "\E4* you'll need a cool&  mutant hand to count&  all of your deaths./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_685", "\E0* hmm^1.&* that expression.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_686", "\E1* that's the expression&  of someone who's died&  six times in a row./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_687", "\E2* that's the number of&  fingers on a mutant&  hand./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_688", "\E3* but soon.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_689", "\E4* you'll need to find&  a mutant hand with&  even more fingers./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_694", "\E0* hmm^1.&* that expression.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_695", "\E1* that's the expression&  of someone who's died&  seven times in a row./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_696", "\E0* hey^1, that's good^1.&* seven's supposed to be&  a lucky number./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_697", "\E2* who knows^1, maybe&  you'll hit the&  jackpot.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_698", "\E4* and that number will&  multiply tenfold./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_703", "\E0* hmm^1.&* that expression.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_704", "\E1* that's the expression&  of someone who's died&  eight times in a row./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_705", "\E2* that's the number of&  fingers on a spider./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_706", "\E3* but soon.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_707", "\E1* wait^1, don't spiders&  have legs?/%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_713", "\E0* hmm^1.&* that expression.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_714", "\E1* that's the expression&  of someone who's died&  seven times in a row./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_715", "\E1* .../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_716", "\E2* nope^1, wait^1, that's&  definitely nine^1, sorry./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_717", "\E4* or was it ten?/%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_723", "\E0* hmm^1.&* that expression.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_724", "\E1* that's the expression&  of someone who's died&  ten times in a row./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_725", "\E2* hey^1, congrats^1!&* the big one-oh!/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_726", "\E1* let's invite all your&  friends over for a&  big shindig./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_727", "\E2* we can have pie^1, and&  hot dogs^1, and.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_728", "\E3* hmmm..^1. wait^1.&* something's not right./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_729", "\E4* you don't have any&  friends./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_735", "\E0* hmm^1.&* that expression.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_736", "\E1* that's the expression&  of someone who's died&  eleven times in a row./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_737", "\E2* well^1, give or take./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_738", "\E1* there's nuance to&  this stuff./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_739", "\E2* don't think i'll be&  able to count very&  well from here./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_740", "\E1* count for me^1, ok?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_741", "\E4* we'll start from 12./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_747", "\E0* let's just get to&  the point./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_752", "\E0* .../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_753", "\E1* that expression that&  you're wearing.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_754", "\E3* .../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_755", "\E4* well^1, i won't grace&  it with a description./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_759", "\E0* .../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_760", "\E1* that expression that&  you're wearing.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_761", "\E3* .../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_762", "\E4* you're really kind&  of a freak^1, huh?/%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_786", "\E3* heh heh heh heh.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_787", "\E1* all right./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_788", "\E3* well^1, here's a better&  question./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_789", "\E4* do you wanna have&  a bad time?/");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_790", "\E3* 'cause if you take&  another step&  forward.../");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_791", "\E4* you are REALLY not&  going to like what&  happens next./%%");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_815", "\E3* welp./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_817", "\E3* sorry^1, old lady./");
ds_map_add(global.text_data_en, "obj_lastsans_trigger_818", "* this is why i never&  make promises./%%");
ds_map_add(global.text_data_en, "obj_latchkey_71", "* (You took the key and&  put it on your phone's&  key-chain.)/%%");
ds_map_add(global.text_data_en, "obj_lemonbread_175", "But&nobody&came.");
ds_map_add(global.text_data_en, "obj_lemonbread_176", "Do you&think&I'm&pretty?");
ds_map_add(global.text_data_en, "obj_lemonbread_177", "That's&what&they all&say.");
ds_map_add(global.text_data_en, "obj_lemonbread_178", "Stay&here&with&me...");
ds_map_add(global.text_data_en, "obj_lemonbread_196", "Welcome&to my&special&hell.");
ds_map_add(global.text_data_en, "obj_lemonbread_200", "...");
ds_map_add(global.text_data_en, "obj_lemonbread_202", "Life's&flashing&before&my teeth");
ds_map_add(global.text_data_en, "obj_lemonbread_203", "I've&felt&this&before.");
ds_map_add(global.text_data_en, "obj_lemonbread_207", "%%%");
ds_map_add(global.text_data_en, "obj_lemonbread_429", "* Smells like sweet lemons.");
ds_map_add(global.text_data_en, "obj_lemonbread_433", "* You hear the melody of&  pulsating flesh.");
ds_map_add(global.text_data_en, "obj_lemonbread_434", "* Could this be goodbye!?");
ds_map_add(global.text_data_en, "obj_lemonbread_435", "* Monster has low HP.");
ds_map_add(global.text_data_en, "obj_lemonbread_468", "* You called for help^1.&* But nobody came./^");
ds_map_add(global.text_data_en, "obj_lemonbread_479", "* You hum a familiar tune^1.&* Lemon Bread's body shakes.../^");
ds_map_add(global.text_data_en, "obj_lemonbread_483", "* You hum a familiar tune^1.&* Nothing else happened./^");
ds_map_add(global.text_data_en, "obj_lemonbread_488", "* You hum a familiar tune^1.&* Lemon Bread seems to&  remember something./^");
ds_map_add(global.text_data_en, "obj_lemonbread_501", "* You screamed out^1.&* But nobody came./^");
ds_map_add(global.text_data_en, "obj_lemonbread_512", "* You flexed your arm^1.&* Lemon Bread's muscle shakes.../^");
ds_map_add(global.text_data_en, "obj_lemonbread_516", "* You flexed your arm^1.&* Nothing else happened./^");
ds_map_add(global.text_data_en, "obj_lemonbread_521", "* You flexed your arm^1.&* Lemon Bread seems to&  remember something./^");
ds_map_add(global.text_data_en, "obj_lemonbread_536", "* You let Lemon Bread be^1.&* Lemon Bread's teeth shake.../^");
ds_map_add(global.text_data_en, "obj_lemonbread_540", "* You let Lemon Bread be^1.&* Nothing else happened./^");
ds_map_add(global.text_data_en, "obj_lemonbread_545", "* You let Lemon Bread be^1.&* Lemon Bread seems to&  remember something./^");
ds_map_add(global.text_data_en, "obj_lemonbread_556", "* You cried as loud as you&  could^1.&* But nobody came./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_204", "(Pant&pant)");
ds_map_add(global.text_data_en, "obj_lesserdoge_205", "(Wag&wag)");
ds_map_add(global.text_data_en, "obj_lesserdoge_206", "(Thinks&of&food)");
ds_map_add(global.text_data_en, "obj_lesserdoge_207", "(Tiny&bark)");
ds_map_add(global.text_data_en, "obj_lesserdoge_211", "(Pants&fast)");
ds_map_add(global.text_data_en, "obj_lesserdoge_214", "(Pant!&Pant!)");
ds_map_add(global.text_data_en, "obj_lesserdoge_215", "(Excited&noises)");
ds_map_add(global.text_data_en, "obj_lesserdoge_216", "(Motor&revving)");
ds_map_add(global.text_data_en, "obj_lesserdoge_217", "(Plane&takeoff)");
ds_map_add(global.text_data_en, "obj_lesserdoge_218", "(Kettle&whistle)");
ds_map_add(global.text_data_en, "obj_lesserdoge_219", "(...)");
ds_map_add(global.text_data_en, "obj_lesserdoge_220", "(Faraway&bark)");
ds_map_add(global.text_data_en, "obj_lesserdoge_221", "(...)");
ds_map_add(global.text_data_en, "obj_lesserdoge_222", "(Bark)");
ds_map_add(global.text_data_en, "obj_lesserdoge_223", "(Pant&pant)");
ds_map_add(global.text_data_en, "obj_lesserdoge_224", "%%%");
ds_map_add(global.text_data_en, "obj_lesserdoge_420", "* Lesser Dog cocks its head&  to one side.");
ds_map_add(global.text_data_en, "obj_lesserdoge_421", "* Lesser Dog thinks your&  weapon is a dog treat.");
ds_map_add(global.text_data_en, "obj_lesserdoge_422", "* Lesser Dog is really not&  paying attention.");
ds_map_add(global.text_data_en, "obj_lesserdoge_423", "* Smells like dog chow.");
ds_map_add(global.text_data_en, "obj_lesserdoge_424", "* Lesser Dog is barking&  excitedly.");
ds_map_add(global.text_data_en, "obj_lesserdoge_425", "* Lesser Dog is overstimulated.");
ds_map_add(global.text_data_en, "obj_lesserdoge_426", "* Lesser Dog shows no signs&  of stopping.");
ds_map_add(global.text_data_en, "obj_lesserdoge_427", "* Lesser Dog is lowering.");
ds_map_add(global.text_data_en, "obj_lesserdoge_428", "* Lesser Dog is learning&  to read.");
ds_map_add(global.text_data_en, "obj_lesserdoge_429", "* Lesser Dog is whining&  because it can't see&  you.");
ds_map_add(global.text_data_en, "obj_lesserdoge_430", "* Hello there.");
ds_map_add(global.text_data_en, "obj_lesserdoge_431", "* Lesser Dog is questioning&  your choices.");
ds_map_add(global.text_data_en, "obj_lesserdoge_432", "* Lesser Dog has gone where&  no Dog has gone before.");
ds_map_add(global.text_data_en, "obj_lesserdoge_433", "* Lesser Dog tucks its tail&  between its legs.");
ds_map_add(global.text_data_en, "obj_lesserdoge_449", "* LESSER DOG - ATK 12 DEF 2&* Wields a stone dogger made&  of pomer-granite./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_457", "* You barely lifted your&  hand and Lesser Dog&  got excited./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_458", "* You lightly touched the&  Dog^1.&* It's already overexcited.../^");
ds_map_add(global.text_data_en, "obj_lesserdoge_459", "* You pet the Dog.&* It raises its head up&  to meet your hand./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_460", "* You pet the Dog.&* It was a good Dog./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_461", "* You pet the Dog.&* Its excitement knows no&  bounds./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_462", "* Critical pet!&* Dog excitement increased./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_463", "* You have to jump up&  to pet the Dog./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_464", "* You don't even pet it^1.&* It gets more excited./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_465", "* There is no way to&  stop this madness./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_466", "* Lesser Dog enters the&  realm of the clouds./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_467", "* You call the Dog but it&  is too late^1.&* It cannot hear you./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_468", "* .../^");
ds_map_add(global.text_data_en, "obj_lesserdoge_469", "* You can reach Lesser Dog&  again./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_470", "* You pet Lesser Dog./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_471", "* It's possible that you&  may have a problem./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_472", "* Lesser Dog is unpettable&  but appreciates the attempt./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_473", "* Perhaps mankind was not&  meant to pet this much./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_474", "* It continues./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_475", "* Lesser Dog is beyond&  your reach./^");
ds_map_add(global.text_data_en, "obj_lesserdoge_476", "* Really.../^");
ds_map_add(global.text_data_en, "obj_librarynpc_jumbler_70", "* Beautiful^1.&* An error message./%%");
ds_map_add(global.text_data_en, "obj_librarynpc_jumbler_73", "* That look in your eye.../");
ds_map_add(global.text_data_en, "obj_librarynpc_jumbler_74", "* You're someone that has&  difficulty solving Junior&  Jumble^1, aren't you?/%%");
ds_map_add(global.text_data_en, "obj_librarynpc_jumbler_78", "* That look in your eye.../");
ds_map_add(global.text_data_en, "obj_librarynpc_jumbler_79", "* You're someone that has&  trouble doing crosswords^1,&  aren't you?/%%");
ds_map_add(global.text_data_en, "obj_librarynpc_jumbler_84", "* That look in your eye.../");
ds_map_add(global.text_data_en, "obj_librarynpc_jumbler_85", "* You think Sudoku is just&  moderately challenging^1,&  don't you?/%%");
ds_map_add(global.text_data_en, "obj_librarynpc_jumbler_92", "* The greatest struggle of&  my life is over.../");
ds_map_add(global.text_data_en, "obj_librarynpc_jumbler_93", "* I just solved today's&  Junior Jumble./%%");
ds_map_add(global.text_data_en, "obj_librarynpc_jumbler_97", "* The greatest struggle of&  my life is over.../");
ds_map_add(global.text_data_en, "obj_librarynpc_jumbler_98", "* I just solved today's&  crossword./%%");
ds_map_add(global.text_data_en, "obj_librarynpc_lizard1_70", "* Welcome to the library^1.&* Yes^1, we know^1.&* The sign is misspelled./%%");
ds_map_add(global.text_data_en, "obj_librarynpc_lizard1_73", "* Yes^1, we know^1.&* The sign is misspelled./");
ds_map_add(global.text_data_en, "obj_librarynpc_lizard1_74", "* We have someone working on&  it!/%%");
ds_map_add(global.text_data_en, "obj_librarynpc_lizard1_79", "* Welcome to the library./");
ds_map_add(global.text_data_en, "obj_librarynpc_lizard1_80", "* This is the last day we'll&  be open^1, so make as much&  noise as you want./%%");
ds_map_add(global.text_data_en, "obj_librarynpc_lizard2_70", "* I love working on the&  newspaper./");
ds_map_add(global.text_data_en, "obj_librarynpc_lizard2_71", "* There's so little to report&  that we just fill it with&  comics and games./%%");
ds_map_add(global.text_data_en, "obj_librarynpc_lizard2_75", "* Yes^1.&* I illustrate all of the&  comics myself./");
ds_map_add(global.text_data_en, "obj_librarynpc_lizard2_76", "* Yes^1.&* I give everyone huge beautiful&  eyes and giant muscles./%%");
ds_map_add(global.text_data_en, "obj_librarynpc_lizard2_81", "* Oh my^1, there's so much&  news to report^1, I don't know&  where to begin!/");
ds_map_add(global.text_data_en, "obj_librarynpc_lizard2_82", "* How about this headline..^1.&* \"Monsters Go Free From The&  Underground.\"/");ds_map_add(global.text_data_en, "obj_librarynpc_lizard2_83", "* Nah^1, that doesn't have&  enough pizazz.../");
ds_map_add(global.text_data_en, "obj_librarynpc_lizard2_84", "* How about \"Top 10 Monsters&  You Won't Believe Got Freed&  From The Underground?\"/%%");ds_map_add(global.text_data_en, "obj_librarynpc_wordsearch_70", "* (cough, cough)/");
ds_map_add(global.text_data_en, "obj_librarynpc_wordsearch_71", "* When I was younger^1, my teachers&  gave me word searches when&  they ran out of assignments./");
ds_map_add(global.text_data_en, "obj_librarynpc_wordsearch_72", "* I thought they were a waste&  of time./");
ds_map_add(global.text_data_en, "obj_librarynpc_wordsearch_73", "* But look at me now.../");
ds_map_add(global.text_data_en, "obj_librarynpc_wordsearch_74", "* I'm the number-one word-search&  creator in the entire&  underground!/%%");
ds_map_add(global.text_data_en, "obj_librarynpc_wordsearch_78", "* (cough^1, cough)/");
ds_map_add(global.text_data_en, "obj_librarynpc_wordsearch_79", "* There's a day I just don't&  want to work./");
ds_map_add(global.text_data_en, "obj_librarynpc_wordsearch_80", "* It's called \"Today.\"/%%");ds_map_add(global.text_data_en, "obj_librarynpc_wordsearch_85", "* This will be our newspaper's&  last issue.../");
ds_map_add(global.text_data_en, "obj_librarynpc_wordsearch_86", "* Why don't we just put a&  big \"THE END\" on the front&  and call it a day?/%%");ds_map_add(global.text_data_en, "obj_lock_and_key_66", "* (The way is blocked by two&  padlocks.^1)&* (There's a note attached.)/");
ds_map_add(global.text_data_en, "obj_lock_and_key_67", "* (Howdy^1! I'm in the garden.)/");
ds_map_add(global.text_data_en, "obj_lock_and_key_68", "* (If you have anything you&  need to get off your chest^1,&  please don't hesitate to come.)/");
ds_map_add(global.text_data_en, "obj_lock_and_key_69", "* (The keys are in the kitchen&  and the hallway.)/%%");
ds_map_add(global.text_data_en, "obj_lock_and_key_73", "\R* (He leaves them in the&  kitchen and the hallway.)/%%");
ds_map_add(global.text_data_en, "obj_lock_and_key_78", "* (You'll need both keys to&  get through.)/%%");
ds_map_add(global.text_data_en, "obj_lock_and_key_82", "\R* (There are two keys.)/%%");
ds_map_add(global.text_data_en, "obj_lock_and_key_90", "* (You unlocked the chain.)/%%");
ds_map_add(global.text_data_en, "obj_lock_and_key_94", "\R* (I unlocked the chain.)/%%");
ds_map_add(global.text_data_en, "obj_longsnail_64", "* Snail snail..^1.&* (A long journey extends&  in front of you...)/");
ds_map_add(global.text_data_en, "obj_longsnail_65", "* Snail snail..^1.&* (Reach far and stretch&  beyond the horizons.)/");
ds_map_add(global.text_data_en, "obj_longsnail_66", "* Snail snail^1.&* (So snaileth Sam Byool.)/%%");
ds_map_add(global.text_data_en, "obj_longsnail_70", "* Snail snail./");
ds_map_add(global.text_data_en, "obj_longsnail_71", "* (Good gosh^1, don't I look&  like a perfectly normal&  snail?)/%%");
ds_map_add(global.text_data_en, "obj_longsnail_76", "* Snail snail^1.&* (You reached the end of&  your extensive journey.)/");
ds_map_add(global.text_data_en, "obj_longsnail_77", "* Snail snail^1.&* (What a long trip^1! Remember&  to stretch your muscles.)/%%");
ds_map_add(global.text_data_en, "obj_loox_197", "I've got&my eye&on you.");
ds_map_add(global.text_data_en, "obj_loox_198", "Don't&point&that&at me.");
ds_map_add(global.text_data_en, "obj_loox_199", "Quit&staring&at me.");
ds_map_add(global.text_data_en, "obj_loox_200", "What an&eyesore.");
ds_map_add(global.text_data_en, "obj_loox_201", "How&about a&staring&contest?");
ds_map_add(global.text_data_en, "obj_loox_202", "Please&don't&pick on&me.");
ds_map_add(global.text_data_en, "obj_loox_205", "Finally&someone&gets it.");
ds_map_add(global.text_data_en, "obj_loox_209", "You rude&little&snipe!");
ds_map_add(global.text_data_en, "obj_loox_213", "%%%");
ds_map_add(global.text_data_en, "obj_loox_403", "* Loox is gazing at you.");
ds_map_add(global.text_data_en, "obj_loox_404", "* Loox is staring right&  through you.");
ds_map_add(global.text_data_en, "obj_loox_405", "* Loox gnashes its teeth.");
ds_map_add(global.text_data_en, "obj_loox_406", "* Smells like eyedrops.");
ds_map_add(global.text_data_en, "obj_loox_407", "* Loox has gone bloodshot.");
ds_map_add(global.text_data_en, "obj_loox_408", "* Loox doesn't care about&  fighting anymore.");
ds_map_add(global.text_data_en, "obj_loox_409", "* Loox is watering.");
ds_map_add(global.text_data_en, "obj_loox_425", "* LOOX - ATK 6 DEF 6&* Don't pick on him.&* Family name: Eyewalker/^");
ds_map_add(global.text_data_en, "obj_maddummy_259", "\E1OWWWW^1, you&DUMMIES!!/");
ds_map_add(global.text_data_en, "obj_maddummy_260", "\XWatch where you're&aiming your \RMAGIC\X &attacks!/");
ds_map_add(global.text_data_en, "obj_maddummy_261", "\E3.../");
ds_map_add(global.text_data_en, "obj_maddummy_262", "\XHey^1!&You^1! \E2Forget&I said anything&about \RMAGIC\X!!!/%%");
ds_map_add(global.text_data_en, "obj_maddummy_319", "Foolish^1.&Foolish^1!&FOOLISH!/");
ds_map_add(global.text_data_en, "obj_maddummy_320", "Even if you attack&my vessel^1, you'll&NEVER hurt me!/");
ds_map_add(global.text_data_en, "obj_maddummy_321", "I'm still&incorporeal^1, you&DUMMY!!!/%%");
ds_map_add(global.text_data_en, "obj_maddummy_422", "Foolish.&Foolish!&FOOLISH!");
ds_map_add(global.text_data_en, "obj_maddummy_423", "Futile.&Futile!&FUTILE!");
ds_map_add(global.text_data_en, "obj_maddummy_424", "Pitiful.&Pitiful!&PITIFUL!");
ds_map_add(global.text_data_en, "obj_maddummy_425", "Feeble.&Feeble!&FEEBLE!");
ds_map_add(global.text_data_en, "obj_maddummy_429", " I'll defeat you and& take your SOUL!");
ds_map_add(global.text_data_en, "obj_maddummy_430", " I'll use your SOUL& to cross the barrier!");
ds_map_add(global.text_data_en, "obj_maddummy_431", " I'll stand in the& window of a fancy& store!");
ds_map_add(global.text_data_en, "obj_maddummy_432", "\E3 THEN EVERYTHING I& WANT WILL BE MINE!");
ds_map_add(global.text_data_en, "obj_maddummy_433", "\E2 Huh?& Yeah, I guess& that'll avenge my& cousin.");
ds_map_add(global.text_data_en, "obj_maddummy_434", "\E0 What was their name& again...?");
ds_map_add(global.text_data_en, "obj_maddummy_435", " Whatever.& Whatever!& WHATEVER!!");
ds_map_add(global.text_data_en, "obj_maddummy_441", "DUMMY&BOTS!&MAGIC&MISSILE!");
ds_map_add(global.text_data_en, "obj_maddummy_442", "DUMMY&BOTS!&TRY&AGAIN!");
ds_map_add(global.text_data_en, "obj_maddummy_443", "DUMMY&BOTS!&You're&awful???");
ds_map_add(global.text_data_en, "obj_maddummy_444", "DUMMY&BOTS!&FINAL&ATTACK!");
ds_map_add(global.text_data_en, "obj_maddummy_459", " (Wait^1, is DUMMY& a compliment...?)");
ds_map_add(global.text_data_en, "obj_maddummy_465", "%%%");
ds_map_add(global.text_data_en, "obj_maddummy_1152", "* Mad Dummy is doing an armless&  ska dance.");
ds_map_add(global.text_data_en, "obj_maddummy_1153", "* Mad Dummy is bossing around&  its bullets.");
ds_map_add(global.text_data_en, "obj_maddummy_1154", "* Mad Dummy glares into a&  mirror^1, then turns to you&  with the same expression.");
ds_map_add(global.text_data_en, "obj_maddummy_1155", "* Mad Dummy is hopping mad.");
ds_map_add(global.text_data_en, "obj_maddummy_1156", "* Smells like a clothing&  store.");
ds_map_add(global.text_data_en, "obj_maddummy_1157", "* This message will NEVER&  happen.");
ds_map_add(global.text_data_en, "obj_maddummy_1158", "* Mad Dummy is getting cotton&  all over the dialogue box.");
ds_map_add(global.text_data_en, "obj_maddummy_1174", "* MAD DUMMY - ATK 30 DEF YES&* Because they're a ghost^1,&  physical attacks will fail./^");
ds_map_add(global.text_data_en, "obj_maddummy_1194", "* You talk to the DUMMY^1.&* .../");
ds_map_add(global.text_data_en, "obj_maddummy_1195", "* It doesn't seem much for&  conversation./");
ds_map_add(global.text_data_en, "obj_maddummy_1196", "* No one is happy with this./^");
ds_map_add(global.text_data_en, "obj_maddummy_1259", "* Mad Dummy is looking&  nervous.");
ds_map_add(global.text_data_en, "obj_maddummy_1313", "* Mad Dummy is getting cotton&  all over the dialogue box.");
ds_map_add(global.text_data_en, "obj_maddummy_1329", "\E1HEY GUYS!/%%");
ds_map_add(global.text_data_en, "obj_maddummy_1370", "\E0Dummies^1.&Dummies^1!&DUMMIES!/");
ds_map_add(global.text_data_en, "obj_maddummy_1371", "\E1Remember how I&said NOT to&shoot at me?/");
ds_map_add(global.text_data_en, "obj_maddummy_1372", "\E0Well.../");
ds_map_add(global.text_data_en, "obj_maddummy_1373", "\E3FAILURES^1!&YOU'RE FIRED^1!&YOU'RE ALL BEING&REPLACED!!!/%%");
ds_map_add(global.text_data_en, "obj_maddummy_1414", "\E0Hahaha^1.&Hahaha^1!&HAHAHA!/");
ds_map_add(global.text_data_en, "obj_maddummy_1415", "Now you'll see&my true power:/");
ds_map_add(global.text_data_en, "obj_maddummy_1416", "Relying on people&that aren't garbage!/%%");
ds_map_add(global.text_data_en, "obj_maddummy_1420", "* Mechanical whirrs fill&  the room.");
ds_map_add(global.text_data_en, "obj_maddummy_1464", "\E2(N..^1. no way!)/");
ds_map_add(global.text_data_en, "obj_maddummy_1465", "\E2(These guys are&even WORSE than&the other guys!)/");
ds_map_add(global.text_data_en, "obj_maddummy_1466", "\E3Who cares^1.&Who cares^1!&WHO CARES!!/");
ds_map_add(global.text_data_en, "obj_maddummy_1467", "I DON'T NEED&FRIENDS!!!/%%");
ds_map_add(global.text_data_en, "obj_maddummy_1500", "\E3I'VE GOT&KNIVES!!!/%%");
ds_map_add(global.text_data_en, "obj_maddummy_1539", "\E0I'm..^1./");
ds_map_add(global.text_data_en, "obj_maddummy_1540", "\E2Out of knives./");
ds_map_add(global.text_data_en, "obj_maddummy_1541", "\E3BUT IT DOESN'T&MATTER!!!/");
ds_map_add(global.text_data_en, "obj_maddummy_1542", "YOU CAN'T HURT&ME AND I CAN'T&HURT YOU!/");
ds_map_add(global.text_data_en, "obj_maddummy_1543", "YOU'LL BE STUCK&FIGHTING ME.../");
ds_map_add(global.text_data_en, "obj_maddummy_1544", "Forever./");
ds_map_add(global.text_data_en, "obj_maddummy_1545", "Forever!/");
ds_map_add(global.text_data_en, "obj_maddummy_1546", "FOREVER!!!!/");
ds_map_add(global.text_data_en, "obj_maddummy_1547", "AHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHA%");
ds_map_add(global.text_data_en, "obj_maddummy_1548", "AHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHA%");
ds_map_add(global.text_data_en, "obj_maddummy_1549", "AHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHA%");
ds_map_add(global.text_data_en, "obj_maddummy_1550", "AHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHA%");
ds_map_add(global.text_data_en, "obj_maddummy_1613", "\E2Wh..^1.&What the heck is&this!?/");
ds_map_add(global.text_data_en, "obj_maddummy_1614", "\E3Ergh^1!&Acid rain!?!/");
ds_map_add(global.text_data_en, "obj_maddummy_1615", "Oh^1, FORGET IT^1!&I'm outta here!/%%");
ds_map_add(global.text_data_en, "obj_maddummy_1654", "... sorry^1, i&interrupted you^1,&didn't i?/");
ds_map_add(global.text_data_en, "obj_maddummy_1655", "as soon as i came&over^1, your friend&immediately left.../");
ds_map_add(global.text_data_en, "obj_maddummy_1656", "oh no..^1.&you guys looked&like you were having&fun.../");
ds_map_add(global.text_data_en, "obj_maddummy_1657", "oh no..^1.&i just wanted to&say hi.../");
ds_map_add(global.text_data_en, "obj_maddummy_1658", "oh no.................................................%%");
ds_map_add(global.text_data_en, "obj_maddummy_1663", "oh wait..^1. didn't you&attack me before.../");
ds_map_add(global.text_data_en, "obj_maddummy_1664", "uhhh..^1.&that's awkward./");
ds_map_add(global.text_data_en, "obj_maddummy_1665", "sorry^1.&have a nice day./%%");
ds_map_add(global.text_data_en, "obj_mainend_158", "* (Ring^1, ring...)/");
ds_map_add(global.text_data_en, "obj_mainend_160", "* heya./");
ds_map_add(global.text_data_en, "obj_mainend_161", "\E1* is anyone there...?/");
ds_map_add(global.text_data_en, "obj_mainend_162", "\E2* well^1, i'll just leave&  a message.../%%");
ds_map_add(global.text_data_en, "obj_mainend_169", "\E1* is anyone there...?/");
ds_map_add(global.text_data_en, "obj_mainend_170", "\E2* well..^1. just calling&  to say./");
ds_map_add(global.text_data_en, "obj_mainend_171", "\E1* you made a snowman&  really happy./");
ds_map_add(global.text_data_en, "obj_mainend_172", "\E2* ... guess i should&  say something else^1,&  too./%%");
ds_map_add(global.text_data_en, "obj_mainend_177", "* heya./");
ds_map_add(global.text_data_en, "obj_mainend_178", "\E2* well..^1. just calling&  to say./");
ds_map_add(global.text_data_en, "obj_mainend_179", "\E1* it's been a while^1.&* shouldn't you SAVE?/");
ds_map_add(global.text_data_en, "obj_mainend_180", "\E2* ... guess i should&  say something else^1,&  too./%%");
ds_map_add(global.text_data_en, "obj_mainend_186", "\E1* is anyone there...?/");
ds_map_add(global.text_data_en, "obj_mainend_187", "\E2* well..^1. just calling&  to ask./");
ds_map_add(global.text_data_en, "obj_mainend_188", "\E1* did you ever take&  off that gross&  bandage...?/");
ds_map_add(global.text_data_en, "obj_mainend_189", "\E2* ... guess i should&  say something else^1,&  too./%%");
ds_map_add(global.text_data_en, "obj_mainend_195", "\E1* is anyone there...?/");
ds_map_add(global.text_data_en, "obj_mainend_196", "\E2* well..^1. just calling&  to ask./");
ds_map_add(global.text_data_en, "obj_mainend_197", "\E1* did you ever get&  something to eat?/");
ds_map_add(global.text_data_en, "obj_mainend_198", "\E2* ... guess i should&  say something else^1,&  too./%%");
ds_map_add(global.text_data_en, "obj_mainend_204", "\E1* is anyone there...?/");
ds_map_add(global.text_data_en, "obj_mainend_205", "\E2* well..^1. just calling&  to ask./");
ds_map_add(global.text_data_en, "obj_mainend_206", "\E1* you really like to&  challenge yourself^1,&  huh...?/");
ds_map_add(global.text_data_en, "obj_mainend_207", "\E2* well..^1. good job^1./");
ds_map_add(global.text_data_en, "obj_mainend_208", "\E1* just promise not to&  brag about it^1,&  okay?/");
ds_map_add(global.text_data_en, "obj_mainend_209", "\E2* ... guess i should&  say something else^1,&  too./%%");
ds_map_add(global.text_data_en, "obj_mainend_214", "* .../");
ds_map_add(global.text_data_en, "obj_mainend_215", "* alright^1, i've got the&  number./%%");
ds_map_add(global.text_data_en, "obj_mainend_250", "* so..^1.&* it's been a while./");
ds_map_add(global.text_data_en, "obj_mainend_251", "\E0* the queen returned^1, and&  is now ruling over&  the underground./");
ds_map_add(global.text_data_en, "obj_mainend_252", "* she's enstated a new&  policy.../");
ds_map_add(global.text_data_en, "obj_mainend_253", "\E3* all the humans who fall&  here will be treated&  not as enemies.../");
ds_map_add(global.text_data_en, "obj_mainend_254", "\E0* but as friends./");
ds_map_add(global.text_data_en, "obj_mainend_255", "\E1* it's probably for the&  best^1, anyway./");
ds_map_add(global.text_data_en, "obj_mainend_256", "\E0* the human souls the king&  gathered.../");
ds_map_add(global.text_data_en, "obj_mainend_257", "\E3* seem to have&  disappeared./");
ds_map_add(global.text_data_en, "obj_mainend_258", "\E1* so^1, uh^1, that plan&  ain't happening any&  time soon./");
ds_map_add(global.text_data_en, "obj_mainend_263", "* but even though people&  are heartbroken over&  the king.../");
ds_map_add(global.text_data_en, "obj_mainend_264", "\E1* ... and things are&  looking grim for our&  freedom.../");
ds_map_add(global.text_data_en, "obj_mainend_265", "\E0* the queen's trying her&  best not to let us&  give up hope./");
ds_map_add(global.text_data_en, "obj_mainend_267", "\E1* so^1, uh^1, hey.../");
ds_map_add(global.text_data_en, "obj_mainend_268", "\E1* if we're not giving&  up down here.../");
ds_map_add(global.text_data_en, "obj_mainend_269", "\E2* don't give up wherever&  you are^1, ok?/");
ds_map_add(global.text_data_en, "obj_mainend_270", "\E3* who knows how long&  it will take.../");
ds_map_add(global.text_data_en, "obj_mainend_271", "\E0* but we will get out&  of here./");
ds_map_add(global.text_data_en, "obj_mainend_272", "\E2* that's a promise./");
ds_map_add(global.text_data_en, "obj_mainend_274", "SANS!!!&WHO ARE YOU&TALKING TO???/");
ds_map_add(global.text_data_en, "obj_mainend_276", "* oh^1, nobody./");
ds_map_add(global.text_data_en, "obj_mainend_278", "WHAT!^1?&NOBODY!?/");
ds_map_add(global.text_data_en, "obj_mainend_279", "\E0CAN I TALK TO&THEM TOO???/");
ds_map_add(global.text_data_en, "obj_mainend_281", "* here^1, knock yourself&  out./%%");
ds_map_add(global.text_data_en, "obj_mainend_292", "WAIT A SECOND.../");
ds_map_add(global.text_data_en, "obj_mainend_293", "\E1I RECOGNIZE THIS&NUMBER!!!/");
ds_map_add(global.text_data_en, "obj_mainend_294", "\E0ATTENTION^1, HUMAN!/");
ds_map_add(global.text_data_en, "obj_mainend_295", "\E2I^1, THE GREAT&PAPYRUS.../");
ds_map_add(global.text_data_en, "obj_mainend_296", "\E0AM NOW CAPTAIN OF&THE ROYAL GUARD!/");
ds_map_add(global.text_data_en, "obj_mainend_297", "\E2IT'S EVERYTHING I'VE&EVER DREAMED OF.../");
ds_map_add(global.text_data_en, "obj_mainend_298", "\E3EXCEPT^1, INSTEAD&OF FIGHTING^1, WE&JUST WATER FLOWERS./");
ds_map_add(global.text_data_en, "obj_mainend_299", "\E0SO THAT'S EVER-&SO-SLIGHTLY&DIFFERENT./");
ds_map_add(global.text_data_en, "obj_mainend_300", "\E0AND^1, WE'RE HELPING&DR. ALPHYS&WITH HER RESEARCH!/");
ds_map_add(global.text_data_en, "obj_mainend_301", "\E0SHE'S GONNA FIND A&WAY TO GET US OUT&OF HERE./");
ds_map_add(global.text_data_en, "obj_mainend_302", "UNDYNE IS HELPING&HER TOO!/");
ds_map_add(global.text_data_en, "obj_mainend_303", "\E3THOUGH^1, TO BE&HONEST^1, HER METHOD&OF HELPING.../");
ds_map_add(global.text_data_en, "obj_mainend_304", "\E2SEEMS KIND OF.../");
ds_map_add(global.text_data_en, "obj_mainend_305", "\E3EXPLOSION-INDUCING./");
ds_map_add(global.text_data_en, "obj_mainend_306", "\E0BUT I THINK ALPHYS&LIKES HAVING HER&AROUND./");
ds_map_add(global.text_data_en, "obj_mainend_307", "\E5UH OH!!!/%%");
ds_map_add(global.text_data_en, "obj_mainend_311", "\E0HEY!!^1! HUMAN!!!/");
ds_map_add(global.text_data_en, "obj_mainend_312", "HOW ARE YOU DOING^1?&I'M DOING FINE!!!/");
ds_map_add(global.text_data_en, "obj_mainend_313", "\E3WELL, BESIDES ONE&THING.../");
ds_map_add(global.text_data_en, "obj_mainend_314", "\E3THE QUEEN&DISBANDED THE&ROYAL GUARD./");
ds_map_add(global.text_data_en, "obj_mainend_315", "SINCE WE DON'T&HAVE TO FIGHT&HUMANS ANYMORE./");
ds_map_add(global.text_data_en, "obj_mainend_316", "\E0WOW!!!/");
ds_map_add(global.text_data_en, "obj_mainend_317", "\E3I HAVE NO IDEA&WHAT TO DO&WITH MY LIFE./");
ds_map_add(global.text_data_en, "obj_mainend_318", "\E0BUT^1, THAT'S&OKAY!/");
ds_map_add(global.text_data_en, "obj_mainend_319", "BECAUSE I'M&STILL WORKING&HARD!/");
ds_map_add(global.text_data_en, "obj_mainend_320", "\E4EVEN IF IT'S&ON NOTHING AT&ALL!/");
ds_map_add(global.text_data_en, "obj_mainend_321", "\E0SO DON'T FEEL&BAD!/");
ds_map_add(global.text_data_en, "obj_mainend_322", "PAPYRUS IS FINE!/");
ds_map_add(global.text_data_en, "obj_mainend_323", "\E5UNDYNE IS THE&ONE THAT'S GOT&IT BAD!/");
ds_map_add(global.text_data_en, "obj_mainend_324", "\E3SHE LOST HER&JOB.../");
ds_map_add(global.text_data_en, "obj_mainend_325", "THEN SHE LOST&HER HOUSE.../");
ds_map_add(global.text_data_en, "obj_mainend_326", "\E2IT WAS SAD..^1.&BUT WE'RE TAKING&CARE OF HER!/");
ds_map_add(global.text_data_en, "obj_mainend_327", "\E0SHE LIVES ON&OUR COUCH NOW./");
ds_map_add(global.text_data_en, "obj_mainend_328", "IT'S LIKE A&SLEEPOVER EVERY&NIGHT!/");
ds_map_add(global.text_data_en, "obj_mainend_329", "A SLEEPOVER&THERE'S NO&ESCAPE FROM./");
ds_map_add(global.text_data_en, "obj_mainend_330", "OH^1, WE GAVE HER&A JOB^1, TOO./");
ds_map_add(global.text_data_en, "obj_mainend_331", "\E3SANS HIRED HER AT&HIS ILLEGAL HOT&DOG STAND./");
ds_map_add(global.text_data_en, "obj_mainend_332", "\E5SHE HATES WORKING&THERE!/");
ds_map_add(global.text_data_en, "obj_mainend_333", "\E3BUT SHE MAKES&A MEAN HOT DOG./");
ds_map_add(global.text_data_en, "obj_mainend_334", "\E3.../");
ds_map_add(global.text_data_en, "obj_mainend_335", "\E5OH YEAH./");
ds_map_add(global.text_data_en, "obj_mainend_338", "I DON'T KNOW HOW&TO PUT THIS^1,&BUT.../");
ds_map_add(global.text_data_en, "obj_mainend_339", "\E3SHE^1, UM^1, REALLY&HATES YOU NOW./");
ds_map_add(global.text_data_en, "obj_mainend_340", "\E6EVEN MORE THAN&SHE EVER HAS./");
ds_map_add(global.text_data_en, "obj_mainend_341", "IT'S BECAUSE SHE&MADE FRIENDS WITH&YOU^1, THEN.../");
ds_map_add(global.text_data_en, "obj_mainend_342", "\E5SHE SAID YOU&KILLED SOMEONE?/");
ds_map_add(global.text_data_en, "obj_mainend_343", "\E3I KNOW^1, THAT&SOUNDS RIDICULOUS&DOESN'T IT?/");
ds_map_add(global.text_data_en, "obj_mainend_344", "\E6BUT SHE FEELS SO&HURT AND BETRAYED./");
ds_map_add(global.text_data_en, "obj_mainend_345", "AND ANGRY AT&HERSELF^1, TOO./");
ds_map_add(global.text_data_en, "obj_mainend_346", "SHE SAYS.../");
ds_map_add(global.text_data_en, "obj_mainend_347", "SHE DOESN'T&UNDERSTAND WHY.../");
ds_map_add(global.text_data_en, "obj_mainend_348", "SHE EVER LET&HERSELF BECOME&FRIENDS WITH YOU./");
ds_map_add(global.text_data_en, "obj_mainend_349", "THAT SHE KNEW&WHAT HUMANS WERE&LIKE.../");
ds_map_add(global.text_data_en, "obj_mainend_350", "\E3AND YET SHE&STILL FAILED TO&RESIST./");
ds_map_add(global.text_data_en, "obj_mainend_351", "\E6MORE PEOPLE GOT&HURT BECAUSE OF&HER MISTAKE./");
ds_map_add(global.text_data_en, "obj_mainend_352", "\E5I REALLY CAN'T&UNDERSTATE./");
ds_map_add(global.text_data_en, "obj_mainend_353", "HOW MUCH SHE&HATES YOU./");
ds_map_add(global.text_data_en, "obj_mainend_354", "\E6IT PAINS ME TO&SAY THIS^1, BUT.../");
ds_map_add(global.text_data_en, "obj_mainend_355", "YOU SHOULD&PROBABLY NEVER&COME BACK HERE./");
ds_map_add(global.text_data_en, "obj_mainend_356", "\E3IF YOU DO^1, UNDYNE&WILL DEFINITELY&DESTROY YOU./");
ds_map_add(global.text_data_en, "obj_mainend_357", "\E5NOT EVEN THE QUEEN&CAN STOP HER./");
ds_map_add(global.text_data_en, "obj_mainend_358", "\E6SO^1, UH..^1.&GOODBYE FOREVER./");
ds_map_add(global.text_data_en, "obj_mainend_359", "I'LL MISS YOU^1,&MY FRIEND./%%");
ds_map_add(global.text_data_en, "obj_mainend_364", "\E5AND YOU MADE&ASGORE DISAPPEAR?/");
ds_map_add(global.text_data_en, "obj_mainend_365", "\E3AND MADE ALPHYS&DISAPPEAR^1, TOO./");
ds_map_add(global.text_data_en, "obj_mainend_366", "\E6SHE'S NOT VERY&HAPPY./");
ds_map_add(global.text_data_en, "obj_mainend_367", "SHE SAYS THINGS&LIKE.../");
ds_map_add(global.text_data_en, "obj_mainend_368", "\"I COULDN'T PROTECT&HER.../\"");ds_map_add(global.text_data_en, "obj_mainend_369", "IT'S HARD TO GET&HER TO DO ANYTHING&NOW./");
ds_map_add(global.text_data_en, "obj_mainend_370", "\E5I EVEN SUGGESTED&WE TRY TO GET&REVENGE ON YOU./");
ds_map_add(global.text_data_en, "obj_mainend_371", "\E0YOU KNOW^1, SO I&COULD SEE YOU&AGAIN./");
ds_map_add(global.text_data_en, "obj_mainend_372", "\E5BUT SHE JUST&LOOKED AT ME AND&SAID.../");
ds_map_add(global.text_data_en, "obj_mainend_373", "\E6REVENGE WON'T BRING&ANYBODY BACK./");
ds_map_add(global.text_data_en, "obj_mainend_374", "\E3I HAVE NO IDEA&WHAT YOU DID^1,&BUT.../");
ds_map_add(global.text_data_en, "obj_mainend_375", "\E5CAN YOU PLEASE&BRING BACK HER&FRIENDS?/");
ds_map_add(global.text_data_en, "obj_mainend_376", "IF YOU MADE THEM&DISAPPEAR?/");
ds_map_add(global.text_data_en, "obj_mainend_377", "\E6PLEASE.../");
ds_map_add(global.text_data_en, "obj_mainend_378", "UNDYNE'S NOT&DOING VERY WELL./");
ds_map_add(global.text_data_en, "obj_mainend_379", "BYE./%%");
ds_map_add(global.text_data_en, "obj_mainend_385", "\E3SHE STILL BLAMES&YOU.../");
ds_map_add(global.text_data_en, "obj_mainend_386", "\E3FOR THE&DISAPPEARANCE&OF ASGORE./");
ds_map_add(global.text_data_en, "obj_mainend_387", "\E3.../");
ds_map_add(global.text_data_en, "obj_mainend_388", "\E3SHE TALKS TO ME&A LOT.../");
ds_map_add(global.text_data_en, "obj_mainend_389", "\E5ABOUT GETTING&REVENGE ON YOU./");
ds_map_add(global.text_data_en, "obj_mainend_390", "SHE HAS A&LUDICROUS PLAN.../");
ds_map_add(global.text_data_en, "obj_mainend_391", "TO CROSS THE&BARRIER AND&BEAT YOU UP./");
ds_map_add(global.text_data_en, "obj_mainend_392", "\E3TO BE HONEST^1,&I THINK IT'S&IMPOSSIBLE./");
ds_map_add(global.text_data_en, "obj_mainend_393", "\E0BUT I'D LIKE TO&BELIEVE IT'S&NOT!!!/");
ds_map_add(global.text_data_en, "obj_mainend_394", "CAUSE I WANT TO&GO WITH HER!/");
ds_map_add(global.text_data_en, "obj_mainend_395", "THEN I'D GET TO&SEE YOU AGAIN!/");
ds_map_add(global.text_data_en, "obj_mainend_396", "\E3EVEN IF I'D HAVE&TO FIGHT YOU./");
ds_map_add(global.text_data_en, "obj_mainend_397", "\E0WELL^1, KEEP YOUR&FINGERS CROSSED!/");
ds_map_add(global.text_data_en, "obj_mainend_398", "AND KEEP IN&TOUCH.../");
ds_map_add(global.text_data_en, "obj_mainend_399", "IT'LL MAKE OUR&PLANS EASIER./");
ds_map_add(global.text_data_en, "obj_mainend_400", "BYE!/%%");
ds_map_add(global.text_data_en, "obj_mainend_404", "\E5AND ALPHYS'&DISAPPEARANCE^1, TOO./");
ds_map_add(global.text_data_en, "obj_mainend_405", "\E3SHE'S NOT VERY&HAPPY./");
ds_map_add(global.text_data_en, "obj_mainend_406", "\E6SHE SAYS THINGS&LIKE.../");
ds_map_add(global.text_data_en, "obj_mainend_407", "\"I COULDN'T PROTECT&HER.../\"");ds_map_add(global.text_data_en, "obj_mainend_408", "IT'S HARD TO GET&HER TO DO ANYTHING&NOW./");
ds_map_add(global.text_data_en, "obj_mainend_409", "\E5I EVEN SUGGESTED&WE TRY TO GET&REVENGE ON YOU./");
ds_map_add(global.text_data_en, "obj_mainend_410", "\E0YOU KNOW^1, SO I&COULD SEE YOU&AGAIN./");
ds_map_add(global.text_data_en, "obj_mainend_411", "\E3BUT SHE JUST&LOOKED AT ME AND&SAID.../");
ds_map_add(global.text_data_en, "obj_mainend_412", "\E6REVENGE WON'T BRING&ANYBODY BACK./");
ds_map_add(global.text_data_en, "obj_mainend_413", "I HAVE NO IDEA&WHAT YOU DID^1,&BUT.../");
ds_map_add(global.text_data_en, "obj_mainend_414", "\E5CAN YOU PLEASE&BRING BACK HER&FRIENDS?/");
ds_map_add(global.text_data_en, "obj_mainend_415", "IF YOU MADE THEM&DISAPPEAR?/");
ds_map_add(global.text_data_en, "obj_mainend_416", "\E6PLEASE.../");
ds_map_add(global.text_data_en, "obj_mainend_417", "UNDYNE'S NOT&DOING VERY WELL./");
ds_map_add(global.text_data_en, "obj_mainend_418", "BYE./%%");
ds_map_add(global.text_data_en, "obj_mainend_434", "* Hey^1!&* What are you up&  to^1, punk!?/");
ds_map_add(global.text_data_en, "obj_mainend_435", "\E1* Ngahhhh!/");
ds_map_add(global.text_data_en, "obj_mainend_437", "PLEASE DON'T NOOGIE&THE PHONE./");
ds_map_add(global.text_data_en, "obj_mainend_439", "\E2* Hey^1!&* Who's in charge&  here!?/");
ds_map_add(global.text_data_en, "obj_mainend_441", "ME./");
ds_map_add(global.text_data_en, "obj_mainend_443", "* Oh..^1. yeah^1, that's&  right!/");
ds_map_add(global.text_data_en, "obj_mainend_444", "\E0* I quit my job as&  leader of the Royal&  Guard./");
ds_map_add(global.text_data_en, "obj_mainend_445", "\E4* Actually^1, since we&  won't be fighting&  anymore.../");
ds_map_add(global.text_data_en, "obj_mainend_446", "\E1* The Royal Guard&  totally disbanded./");
ds_map_add(global.text_data_en, "obj_mainend_447", "\E9* There's^1, uh^1, only&  one member now./");
ds_map_add(global.text_data_en, "obj_mainend_449", "BUT HE'S EXTREMELY&GOOD./");
ds_map_add(global.text_data_en, "obj_mainend_451", "* Yeah!^1! He is!!^1!&* C'mere!!/");
ds_map_add(global.text_data_en, "obj_mainend_453", "PLEASE DON'T NOOGIE&THE SKELETON./");
ds_map_add(global.text_data_en, "obj_mainend_455", "* Anyways^1, now I'm&  working as Alphy's&  lab assistant.../");
ds_map_add(global.text_data_en, "obj_mainend_456", "\E2* We're gonna find a&  way out of this dump&  once and for all!!/");
ds_map_add(global.text_data_en, "obj_mainend_457", "\E9* Oh^1, yeah^1, and I'm a&  gym teacher at the&  queen's new school./");
ds_map_add(global.text_data_en, "obj_mainend_458", "\E6* Did you know I can&  bench-press seven&  children!?/");
ds_map_add(global.text_data_en, "obj_mainend_459", "\E9* Awesome^1, right?/");
ds_map_add(global.text_data_en, "obj_mainend_460", "* .../");
ds_map_add(global.text_data_en, "obj_mainend_461", "\E0* Hey./");
ds_map_add(global.text_data_en, "obj_mainend_462", "\E4* I'm sorry about what&  happened with ASGORE./");
ds_map_add(global.text_data_en, "obj_mainend_463", "\E4* You were just doing&  what you had to./");
ds_map_add(global.text_data_en, "obj_mainend_464", "* It's not your fault&  he.../");
ds_map_add(global.text_data_en, "obj_mainend_465", "* .../");
ds_map_add(global.text_data_en, "obj_mainend_466", "\E7* Ah^1, darn it./");
ds_map_add(global.text_data_en, "obj_mainend_467", "* I miss the big guy./");
ds_map_add(global.text_data_en, "obj_mainend_469", "\E7* .../");
ds_map_add(global.text_data_en, "obj_mainend_470", "\E1* Come on^1, Undyne^1!&* Snap out of it!/");
ds_map_add(global.text_data_en, "obj_mainend_471", "\E4* Uh^1, I guess I'll&  tell you how Alphys&  is doing./");
ds_map_add(global.text_data_en, "obj_mainend_472", "\E0* Well^1, she's the&  same as ever./");
ds_map_add(global.text_data_en, "obj_mainend_473", "\E4* Maybe a little more&  reclusive than&  normal./");
ds_map_add(global.text_data_en, "obj_mainend_474", "\E7* Seems like something's&  really bothering&  her.../");
ds_map_add(global.text_data_en, "obj_mainend_475", "\E1* But she can get&  through it!/");
ds_map_add(global.text_data_en, "obj_mainend_476", "\E2* I'm there supporting&  her!!/");
ds_map_add(global.text_data_en, "obj_mainend_477", "\E9* That's what friends&  are for^1, right?/");
ds_map_add(global.text_data_en, "obj_mainend_478", "\E9* .../");
ds_map_add(global.text_data_en, "obj_mainend_479", "\E0* Hey^1, where-ever you&  are.../");
ds_map_add(global.text_data_en, "obj_mainend_480", "\E4* I hope it's better&  than here./");
ds_map_add(global.text_data_en, "obj_mainend_481", "\E7* It took a lot of&  sacrifice for you&  to get there.../");
ds_map_add(global.text_data_en, "obj_mainend_482", "* So^1, where-ever you&  are.../");
ds_map_add(global.text_data_en, "obj_mainend_483", "\E6* You have to try to&  be happy^1, okay!?/");
ds_map_add(global.text_data_en, "obj_mainend_484", "\E2* For our sakes!/");
ds_map_add(global.text_data_en, "obj_mainend_485", "\E0* We'll feel better&  knowing our trouble&  was worth it./");
ds_map_add(global.text_data_en, "obj_mainend_486", "\E9* We're all with you^1!&* Everyone is^1!&* Even the queen!/");
ds_map_add(global.text_data_en, "obj_mainend_487", "\E1* .../");
ds_map_add(global.text_data_en, "obj_mainend_488", "\E2* HEYYY^1!&* WAIT a second!/");
ds_map_add(global.text_data_en, "obj_mainend_489", "\E6* TORIEL^1!&* TORIEL^1!&* Do you wanna...?/");
ds_map_add(global.text_data_en, "obj_mainend_490", "\E1* .../");
ds_map_add(global.text_data_en, "obj_mainend_491", "\E9* Heh^1, she says&  she's busy./");
ds_map_add(global.text_data_en, "obj_mainend_493", "BUT IF SHE KNEW&WHO WE WERE&TALKING TO.../");
ds_map_add(global.text_data_en, "obj_mainend_495", "* we wouldn't get the&  phone back for at&  least a few hours./");
ds_map_add(global.text_data_en, "obj_mainend_497", "WE HAVE THE&MERCY TO SPARE&YOU FROM HER!!/");
ds_map_add(global.text_data_en, "obj_mainend_499", "* But call back any&  time^1, ok?!&* She'd love to talk!/");
ds_map_add(global.text_data_en, "obj_mainend_501", "* oh^1, whoops./");
ds_map_add(global.text_data_en, "obj_mainend_502", "\E0* this thing's almost&  outta batteries./");
ds_map_add(global.text_data_en, "obj_mainend_503", "\E1* so^1, hate to cut this&  short^1, but.../");
ds_map_add(global.text_data_en, "obj_mainend_504", "\E2* be seeing you^1, ok^1,&  buddy?/");
ds_map_add(global.text_data_en, "obj_mainend_506", "BYE BYE FOR NOW!/");
ds_map_add(global.text_data_en, "obj_mainend_508", "* See ya^1, punk!/%%");
ds_map_add(global.text_data_en, "obj_mainend_524", "* H-hey^1, Undyne^1, are&  you okay...?/");
ds_map_add(global.text_data_en, "obj_mainend_526", "* I'm fine^1.&* Why don't you talk&  for a while?/");
ds_map_add(global.text_data_en, "obj_mainend_528", "* U..^1. uh^1, okay!/%%");
ds_map_add(global.text_data_en, "obj_mainend_541", "* Man^1, she's tsundere.../");
ds_map_add(global.text_data_en, "obj_mainend_542", "\E1* .../");
ds_map_add(global.text_data_en, "obj_mainend_543", "\E2* .../");
ds_map_add(global.text_data_en, "obj_mainend_544", "\E7* Um^1, hi.../");
ds_map_add(global.text_data_en, "obj_mainend_545", "\E4* S-sorry^1, I hate&  talking on the&  phone./");
ds_map_add(global.text_data_en, "obj_mainend_546", "\E3* I don't really know&  what to say./");
ds_map_add(global.text_data_en, "obj_mainend_547", "\E1* .../");
ds_map_add(global.text_data_en, "obj_mainend_548", "\E7* Hey^1, why didn't you&  tell me the queen&  was so cute?/");
ds_map_add(global.text_data_en, "obj_mainend_549", "\E3* Uh^1, I mean^1, uh.../");
ds_map_add(global.text_data_en, "obj_mainend_550", "\E6* Mettaton's doing OK!/");
ds_map_add(global.text_data_en, "obj_mainend_551", "* And^1! Um!/");
ds_map_add(global.text_data_en, "obj_mainend_552", "\E6* I'm trying to figure&  a way for us to&  get out of here!/");
ds_map_add(global.text_data_en, "obj_mainend_553", "\E4* B-but I kinda have&  no idea what I'm&  doing./");
ds_map_add(global.text_data_en, "obj_mainend_554", "\E0* I'll figure it out&  eventually^1, though./");
ds_map_add(global.text_data_en, "obj_mainend_555", "\E3* The queen is a lot&  different from&  ASGORE.../");
ds_map_add(global.text_data_en, "obj_mainend_556", "\E7* She actually checks to&  see if I'm doing&  anything./");
ds_map_add(global.text_data_en, "obj_mainend_557", "\E0* She's really turned&  this whole place&  around!/");
ds_map_add(global.text_data_en, "obj_mainend_558", "\E2* .../");
ds_map_add(global.text_data_en, "obj_mainend_559", "\E3* Oh^1!&* Hey^1!&* Wait a second!/");
ds_map_add(global.text_data_en, "obj_mainend_560", "\E0* Hey^1! TORIEL^1!&* Do you wanna talk&  to...?/");
ds_map_add(global.text_data_en, "obj_mainend_561", "\E1* .../");
ds_map_add(global.text_data_en, "obj_mainend_562", "\E0* Well^1, she says she's&  busy./");
ds_map_add(global.text_data_en, "obj_mainend_564", "* Oh^1, she SAYS she's&  busy./");
ds_map_add(global.text_data_en, "obj_mainend_566", "IF SHE KNEW WHO&WE WERE TALKING&TO.../");
ds_map_add(global.text_data_en, "obj_mainend_568", "* we wouldn't get the&  phone back for at&  least a few hours./");
ds_map_add(global.text_data_en, "obj_mainend_570", "WE HAVE THE&MERCY TO SPARE&YOU FROM HER!!/");
ds_map_add(global.text_data_en, "obj_mainend_572", "* B-but^1, if you want&  to^1, call and talk&  to her any time./");
ds_map_add(global.text_data_en, "obj_mainend_574", "* Yeah^1!&* She'd be happy to&  hear from ya!/");
ds_map_add(global.text_data_en, "obj_mainend_576", "* oh^1, whoops./");
ds_map_add(global.text_data_en, "obj_mainend_577", "\E0* this thing's almost&  outta batteries./");
ds_map_add(global.text_data_en, "obj_mainend_578", "\E1* so^1, hate to cut this&  short^1, but.../");
ds_map_add(global.text_data_en, "obj_mainend_579", "\E2* be seeing you^1, ok^1,&  buddy?/");
ds_map_add(global.text_data_en, "obj_mainend_581", "BYE BYE FOR NOW!/");
ds_map_add(global.text_data_en, "obj_mainend_583", "* See ya^1, punk!/");
ds_map_add(global.text_data_en, "obj_mainend_585", "* G-good..^1.&* Good.../");
ds_map_add(global.text_data_en, "obj_mainend_586", "\E4* Hey^1, why do I&  have to be the one&  to hang up?/");
ds_map_add(global.text_data_en, "obj_mainend_587", "\E7* Eheheh..^1.&* I hate goodbyes.../");
ds_map_add(global.text_data_en, "obj_mainend_588", "\E3* Um^1, we'll see you&  again someday!/%%");
ds_map_add(global.text_data_en, "obj_mainend_612", "* (Click...)/%%");
ds_map_add(global.text_data_en, "obj_mainend_650", "* so..^1.&* it's been a while./");
ds_map_add(global.text_data_en, "obj_mainend_651", "\E0* the queen returned^1, and&  attempted to resume&  ruling the underground./");
ds_map_add(global.text_data_en, "obj_mainend_652", "* she enstated a new&  policy.../");
ds_map_add(global.text_data_en, "obj_mainend_653", "\E3* all the humans who fall&  here would be treated&  not as enemies.../");
ds_map_add(global.text_data_en, "obj_mainend_654", "\E0* but as friends./");
ds_map_add(global.text_data_en, "obj_mainend_655", "\E3* .../");
ds_map_add(global.text_data_en, "obj_mainend_656", "\E1* but people REALLY&  didn't like that&  policy./");
ds_map_add(global.text_data_en, "obj_mainend_665", "\E0* because of you^1, not&  only was the king&  gone.../");
ds_map_add(global.text_data_en, "obj_mainend_666", "\E3* but the human souls&  had gone missing as&  well.../");
ds_map_add(global.text_data_en, "obj_mainend_667", "* along with the lives&  of countless citizens./");
ds_map_add(global.text_data_en, "obj_mainend_669", "* along with the life&  of.../");
ds_map_add(global.text_data_en, "obj_mainend_671", "* along with the life&  of undyne^1, their&  greatest hero./");
ds_map_add(global.text_data_en, "obj_mainend_673", "* along with the lives&  of countless citizens./");
ds_map_add(global.text_data_en, "obj_mainend_674", "* nobody wanted to see&  that happen ever again./");
ds_map_add(global.text_data_en, "obj_mainend_675", "\E0* so the people started&  a rebellion to&  overthrow the queen./");
ds_map_add(global.text_data_en, "obj_mainend_676", "\E2* but^1, she^1, uh^1, pretty&  much gave up peacefully&  when she realized./");
ds_map_add(global.text_data_en, "obj_mainend_677", "\E1* so she went back&  to the ruins./");
ds_map_add(global.text_data_en, "obj_mainend_678", "\E0* the underground's&  basically an uneasy&  anarchy now./");
ds_map_add(global.text_data_en, "obj_mainend_679", "\E0* everyone's trying to&  live life like they&  always have.../");
ds_map_add(global.text_data_en, "obj_mainend_680", "\E3* but it's not really&  easy^1, you know?/");
ds_map_add(global.text_data_en, "obj_mainend_681", "* when all of your&  hope has pretty much&  been thrown away.../%%");
ds_map_add(global.text_data_en, "obj_mainend_682", "* .../%%");
ds_map_add(global.text_data_en, "obj_mainend_688", "\E1* undyne spearheaded&  the revolution^1, of&  course./");
ds_map_add(global.text_data_en, "obj_mainend_691", "\E3* she was pretty mad&  after what happened&  to asgore./");
ds_map_add(global.text_data_en, "obj_mainend_695", "\E3* she was pretty mad&  after what happened&  to asgore and alphys./");
ds_map_add(global.text_data_en, "obj_mainend_697", "\E1* she threw the queen&  out of the castle&  with her strength./");
ds_map_add(global.text_data_en, "obj_mainend_698", "\E0* then she became the&  empress of the&  underground.../");
ds_map_add(global.text_data_en, "obj_mainend_699", "* and banished the&  queen back to the&  ruins./");
ds_map_add(global.text_data_en, "obj_mainend_700", "\E1* seems like undyne's..^1.&* hmmm.../");
ds_map_add(global.text_data_en, "obj_mainend_701", "\E3* even more vehement&  about destroying&  humanity than ASGORE./");
ds_map_add(global.text_data_en, "obj_mainend_702", "\E1* .../%%");
ds_map_add(global.text_data_en, "obj_mainend_716", "\E2* but hey^1!&* it's not all bad!/");
ds_map_add(global.text_data_en, "obj_mainend_717", "\E0* she's not so lonely&  anymore./");
ds_map_add(global.text_data_en, "obj_mainend_718", "\E1* me and papyrus go&  and visit her.../");
ds_map_add(global.text_data_en, "obj_mainend_719", "\E0* we bring her books&  from the library^1,&  or play games.../");
ds_map_add(global.text_data_en, "obj_mainend_720", "\E2* we've even convinced&  her to leave&  sometimes./");
ds_map_add(global.text_data_en, "obj_mainend_721", "\E1* as long as me or&  papyrus stay behind&  to watch for humans./");
ds_map_add(global.text_data_en, "obj_mainend_722", "\E2* but papyrus loves&  doing that./");
ds_map_add(global.text_data_en, "obj_mainend_724", "YEAH!!^1!&I LOVE STANDING IN&FOR THE QUEEN!!!/");
ds_map_add(global.text_data_en, "obj_mainend_725", "I'VE BEEN PRACTICING&FOR WHEN A HUMAN&COMES./");
ds_map_add(global.text_data_en, "obj_mainend_726", "I'M GOING TO BE&A GREAT MOM!!!/");
ds_map_add(global.text_data_en, "obj_mainend_727", "\E3BY THE WAY^1,&WHO ARE YOU&TALKING TO?/");
ds_map_add(global.text_data_en, "obj_mainend_729", "* oh^1, nobody./");
ds_map_add(global.text_data_en, "obj_mainend_731", "OH, COOL^1.&TELL THEM I SAY&HI!!!/");
ds_map_add(global.text_data_en, "obj_mainend_733", "* papyrus says hi./");
ds_map_add(global.text_data_en, "obj_mainend_734", "\E0* well^1, i hope things&  are better where&  you are./");
ds_map_add(global.text_data_en, "obj_mainend_735", "\E2* later./%%");
ds_map_add(global.text_data_en, "obj_mainend_740", "\E2* but hey^1!&* it's not all bad!/");
ds_map_add(global.text_data_en, "obj_mainend_741", "\E1* when the queen went&  back to the ruins.../");
ds_map_add(global.text_data_en, "obj_mainend_742", "\E2* i decided to go&  with her./");
ds_map_add(global.text_data_en, "obj_mainend_743", "\E1* and i took out some&  books from the&  library^1, too./");
ds_map_add(global.text_data_en, "obj_mainend_744", "\E1* so she won't have&  to read the same&  ones./");
ds_map_add(global.text_data_en, "obj_mainend_745", "\E0* she's a good roomie^1.&* we have a lot of&  fun./");
ds_map_add(global.text_data_en, "obj_mainend_746", "\E1* .../");
ds_map_add(global.text_data_en, "obj_mainend_747", "\E1* you know./");
ds_map_add(global.text_data_en, "obj_mainend_748", "\E1* sometimes the queen&  talks about.../");
ds_map_add(global.text_data_en, "obj_mainend_749", "\E0* how she'd like to&  see you again./");
ds_map_add(global.text_data_en, "obj_mainend_750", "\E1* isn't that nice?/");
ds_map_add(global.text_data_en, "obj_mainend_751", "\E3* .../");
ds_map_add(global.text_data_en, "obj_mainend_752", "\E3* i don't have the&  heart to tell her&  what you did./");
ds_map_add(global.text_data_en, "obj_mainend_753", "\E0* do you know how she'd&  react?/");
ds_map_add(global.text_data_en, "obj_mainend_754", "\E3* if i told her that&  'cause she protected&  you.../");
ds_map_add(global.text_data_en, "obj_mainend_755", "\E4* ... you went on to&  kill my brother...?/");
ds_map_add(global.text_data_en, "obj_mainend_756", "\E3* .../");
ds_map_add(global.text_data_en, "obj_mainend_757", "\E1* anyway^1, never come&  back here./");
ds_map_add(global.text_data_en, "obj_mainend_758", "\E0* you are not welcome./");
ds_map_add(global.text_data_en, "obj_mainend_759", "\E2* later./%%");
ds_map_add(global.text_data_en, "obj_mainend_784", "* since you left^1,&  things down here.../");
ds_map_add(global.text_data_en, "obj_mainend_785", "\E3* are different./");
ds_map_add(global.text_data_en, "obj_mainend_786", "* with ASGORE gone.../");
ds_map_add(global.text_data_en, "obj_mainend_787", "\E0* undyne became the&  ruler of the&  underground./");
ds_map_add(global.text_data_en, "obj_mainend_788", "\E3* she's decided to&  destroy every human&  that comes here./");
ds_map_add(global.text_data_en, "obj_mainend_789", "\E3* and since the human&  souls disappeared.../");
ds_map_add(global.text_data_en, "obj_mainend_790", "\E0* she's also looking&  for a new way to&  break the barrier.../");
ds_map_add(global.text_data_en, "obj_mainend_791", "* and when she does^1,&  she's going to wage&  war on humanity./");
ds_map_add(global.text_data_en, "obj_mainend_792", "\E1* i mean^1, that was&  asgore's plan^1, too./");
ds_map_add(global.text_data_en, "obj_mainend_793", "\E2* but he was really^1,&  uh^1, bad at it./");
ds_map_add(global.text_data_en, "obj_mainend_794", "\E0* undyne has also&  expanded the royal&  guard massively./");
ds_map_add(global.text_data_en, "obj_mainend_795", "* she says the first&  thing she'll do after&  we get out of here.../");
ds_map_add(global.text_data_en, "obj_mainend_796", "* is take her army.../");
ds_map_add(global.text_data_en, "obj_mainend_797", "\E3* and personally hunt&  you down and destroy&  you./");
ds_map_add(global.text_data_en, "obj_mainend_801", "\E1* meanwhile.../");
ds_map_add(global.text_data_en, "obj_mainend_802", "* i've been knocking&  on the door to&  the RUINs.../");
ds_map_add(global.text_data_en, "obj_mainend_803", "\E3* but the woman that's&  there hasn't been&  answering me./");
ds_map_add(global.text_data_en, "obj_mainend_804", "\E1* maybe she's not&  feeling well?/");
ds_map_add(global.text_data_en, "obj_mainend_805", "\E3* heh./");
ds_map_add(global.text_data_en, "obj_mainend_806", "\E4* or maybe she's not&  feeling anything at&  all...?/");
ds_map_add(global.text_data_en, "obj_mainend_807", "\E4* you'd better watch&  yourself^1, kid./");
ds_map_add(global.text_data_en, "obj_mainend_808", "\E4* things are lookin&  real bad for you./%%");
ds_map_add(global.text_data_en, "obj_mainend_813", "\E1* meanwhile.../");
ds_map_add(global.text_data_en, "obj_mainend_814", "\E3* i've been knocking on&  the door to the&  RUINS.../");
ds_map_add(global.text_data_en, "obj_mainend_815", "\E3* but that woman hasn't&  been answering me.../");
ds_map_add(global.text_data_en, "obj_mainend_816", "\E1* maybe she's not&  feeling well?/");
ds_map_add(global.text_data_en, "obj_mainend_818", "HEY^1, SANS^1, WHO ARE&YOU TALKING TO?/");
ds_map_add(global.text_data_en, "obj_mainend_820", "* oh^1, just the human./");
ds_map_add(global.text_data_en, "obj_mainend_822", "OH^1, COOL./");
ds_map_add(global.text_data_en, "obj_mainend_823", "\E3.../");
ds_map_add(global.text_data_en, "obj_mainend_824", "\E5WAIT, DID YOU&SAY THE HUMAN!?/");
ds_map_add(global.text_data_en, "obj_mainend_825", "\E0CAN I TALK TO&THEM???/");
ds_map_add(global.text_data_en, "obj_mainend_827", "* sure^1, knock yourself&  out./");
ds_map_add(global.text_data_en, "obj_mainend_829", "HEY!!^1!&UNDYNE'S THE&EMPRESS NOW!!/");
ds_map_add(global.text_data_en, "obj_mainend_830", "IT'S AMAZING!!!/");
ds_map_add(global.text_data_en, "obj_mainend_831", "AND SHE APPOINTED&ME TO BE.../");
ds_map_add(global.text_data_en, "obj_mainend_832", "THE MOST IMPORTANT&ROYAL POSITION!!!/");
ds_map_add(global.text_data_en, "obj_mainend_833", "\E3.../");
ds_map_add(global.text_data_en, "obj_mainend_834", "\E3THAT'S IT^1.&THAT'S LITERALLY&THE TITLE./");
ds_map_add(global.text_data_en, "obj_mainend_835", "\E0WHAT DO I DO?/");
ds_map_add(global.text_data_en, "obj_mainend_836", "\E3SHE TOLD ME TO^1,&UM.../");
ds_map_add(global.text_data_en, "obj_mainend_837", "\E3STAND AROUND AND&LOOK CUTE./");
ds_map_add(global.text_data_en, "obj_mainend_838", "\E0WELL!!^1!&THAT'S THE PERFECT&JOB FOR ME!!!/");
ds_map_add(global.text_data_en, "obj_mainend_839", "I DO THAT ALL THE&TIME^1, WITHOUT&TRYING!!/");
ds_map_add(global.text_data_en, "obj_mainend_840", "FINALLY!^1!&I'M IMPORTANT./");
ds_map_add(global.text_data_en, "obj_mainend_841", "AND IT'S ALL&THANKS TO YOU,/");
ds_map_add(global.text_data_en, "obj_mainend_842", "AND THE HORRIBLE&THINGS YOU DID./");
ds_map_add(global.text_data_en, "obj_mainend_843", "THANK YOU^1, HUMAN!/");
ds_map_add(global.text_data_en, "obj_mainend_844", "COME BACK AND&VISIT SOMETIME!!/");
ds_map_add(global.text_data_en, "obj_mainend_845", "\E3WAIT..^1.&UNDYNE WOULD&PROBABLY KILL YOU./");
ds_map_add(global.text_data_en, "obj_mainend_846", "\E0BUT..^1.&YOU'D GET TO&SEE ME./");
ds_map_add(global.text_data_en, "obj_mainend_847", "SO YOU GOTTA&RISK IT!!!/");
ds_map_add(global.text_data_en, "obj_mainend_848", "YOU GOTTA!!!/");
ds_map_add(global.text_data_en, "obj_mainend_849", "SEE YOU SOON./%%");
ds_map_add(global.text_data_en, "obj_mainend_875", "* so^1, it's been a&  while./");
ds_map_add(global.text_data_en, "obj_mainend_876", "\E1* since you left^1, things&  have..^1.&* gotten interesting./");
ds_map_add(global.text_data_en, "obj_mainend_877", "\E0* with ASGORE gone^1, the&  people looked to&  undyne to rule.../");
ds_map_add(global.text_data_en, "obj_mainend_878", "\E3* but she was nowhere&  to be found./");
ds_map_add(global.text_data_en, "obj_mainend_879", "\E2* so mettaton just&  kind of..^1.&* took over?/");
ds_map_add(global.text_data_en, "obj_mainend_880", "\E1* he's brainwashed&  everyone with his&  stupid TV show./");
ds_map_add(global.text_data_en, "obj_mainend_881", "* and made the&  underground into his&  personal paradise./");
ds_map_add(global.text_data_en, "obj_mainend_882", "\E3* it's honestly..^1.&* kinda disturbing./");
ds_map_add(global.text_data_en, "obj_mainend_883", "\E1* as for me^1?&* oh^1, yeah.../");
ds_map_add(global.text_data_en, "obj_mainend_884", "\E2* i'm his agent./%%");
ds_map_add(global.text_data_en, "obj_mainend_896", "\E0* HEY THERE^1, DARLING!/");
ds_map_add(global.text_data_en, "obj_mainend_897", "* THANK YOU SO MUCH FOR&  YOUR HARD WORK.../");
ds_map_add(global.text_data_en, "obj_mainend_898", "* THANKS TO YOU, THE&  UNDERGROUND IS MORE&  EXCITING THAN EVER!/");
ds_map_add(global.text_data_en, "obj_mainend_899", "\E7* OOH LA LA...&* STATUES... MONUMENTS&  TO MY BEAUTY.../");
ds_map_add(global.text_data_en, "obj_mainend_900", "\E6* FLOWERS IN THE&  ARRANGEMENT OF MY&  NAME.../");
ds_map_add(global.text_data_en, "obj_mainend_901", "\E5* HEDGES IN THE SHAPE&  OF MY SMILE.../");
ds_map_add(global.text_data_en, "obj_mainend_902", "\E8* UNDER MY RULE, THE&  UNDERGROUND'S PROBLEMS&  ARE OVER, BABY!/");
ds_map_add(global.text_data_en, "obj_mainend_903", "\E7* CROWDING?&* DREARINESS???/");
ds_map_add(global.text_data_en, "obj_mainend_904", "\E9* WHO NEEDS THE SUN&  WHEN YOU'VE GOT&  THE SPOTLIGHT!!?/");
ds_map_add(global.text_data_en, "obj_mainend_905", "\E1* ECONOMIC COLLAPSE?&* EDUCATION PROBLEMS?&* WHAT!?/");
ds_map_add(global.text_data_en, "obj_mainend_906", "\E8* EVERYTHING'S COVERED&  IN GOLDEN GLITTER!/");
ds_map_add(global.text_data_en, "obj_mainend_907", "\E6* THERE ARE NO&  PROBLEMS, BEAUTIFUL!/");
ds_map_add(global.text_data_en, "obj_mainend_908", "\E0* AND, I'VE ENSTATED&  A NEW POLICY ON&  HUMANITY./");
ds_map_add(global.text_data_en, "obj_mainend_909", "\E1* IF A HUMAN FALLS DOWN&  HERE.../");
ds_map_add(global.text_data_en, "obj_mainend_910", "\E6* THEY CAN JOIN MY&  FAN CLUB FOR FREE!/");
ds_map_add(global.text_data_en, "obj_mainend_911", "\E1* OH, YOU MIGHT BE&  WONDERING ABOUT&  ALPHYS./");
ds_map_add(global.text_data_en, "obj_mainend_912", "\E0* DON'T WORRY!/");
ds_map_add(global.text_data_en, "obj_mainend_913", "\E9* I BUILT A STATUE&  OF HER, TOO./");
ds_map_add(global.text_data_en, "obj_mainend_914", "\E1* .../");
ds_map_add(global.text_data_en, "obj_mainend_915", "\E3* REALLY THOUGH.&* I REALIZED I WAS.../");
ds_map_add(global.text_data_en, "obj_mainend_916", "\E4* NOT THE GREATEST&  TO HER./");
ds_map_add(global.text_data_en, "obj_mainend_917", "\E1* SO I WENT TO&  APOLOGIZE./");
ds_map_add(global.text_data_en, "obj_mainend_918", "\E9* AND, TO ASK HER&  TO HELP ME RULE./");
ds_map_add(global.text_data_en, "obj_mainend_919", "\E1* .../");
ds_map_add(global.text_data_en, "obj_mainend_920", "\E3* BUT I COULDN'T FIND&  HER./");
ds_map_add(global.text_data_en, "obj_mainend_921", "\E4* TRUST ME.&* I LOOKED./");
ds_map_add(global.text_data_en, "obj_mainend_922", "\E3* .../");
ds_map_add(global.text_data_en, "obj_mainend_923", "\E1* ANYWAY./");
ds_map_add(global.text_data_en, "obj_mainend_924", "\E2* I HOPE YOUR LIFE&  AFTER MEETING ME.../");
ds_map_add(global.text_data_en, "obj_mainend_925", "\E7* HAS BEEN WORTH LIVING./");
ds_map_add(global.text_data_en, "obj_mainend_926", "\E6* IT MUST BE A STRUGGLE./");
ds_map_add(global.text_data_en, "obj_mainend_927", "\E0* PLEASE, THINK OF ME&  ALWAYS./");
ds_map_add(global.text_data_en, "obj_mainend_928", "\E5* JUST CONSTANTLY.&* THINK OF ME POSING.&* BEAUTIFULLY.../");
ds_map_add(global.text_data_en, "obj_mainend_929", "\E6* OH YESSSS!!!/");
ds_map_add(global.text_data_en, "obj_mainend_933", "\E6* OH YESSSS!!!/%%");
ds_map_add(global.text_data_en, "obj_mainend_937", "\E2* OH^1, MY OTHER AGENT&  WANTS TO TALK./");
ds_map_add(global.text_data_en, "obj_mainend_939", "HEY!!^1!&IT'S ME^1, PAPYRUS!!/");
ds_map_add(global.text_data_en, "obj_mainend_940", "\E2IMAGINE ME WEARING&COOL GLASSES^1, AND&A SUIT./");
ds_map_add(global.text_data_en, "obj_mainend_941", "\E0AND IMAGINE SANS&WEARING SUNGLASSES&BEING A BOUNCER./");
ds_map_add(global.text_data_en, "obj_mainend_942", "THAT'S OUR LIFE..^1.&IT'S SO COOL!!!/");
ds_map_add(global.text_data_en, "obj_mainend_943", "THINGS HAVE GOTTEN&WAY BETTER SINCE&YOU CAME HERE!!!/");
ds_map_add(global.text_data_en, "obj_mainend_944", "\E3WELL^1, MINUS THE&FACT THAT&EVERYTHING SUCKS.../");
ds_map_add(global.text_data_en, "obj_mainend_945", "\E5FOR ANYONE THAT&DOESNT WORSHIP&METTATON./");
ds_map_add(global.text_data_en, "obj_mainend_946", "\E3AND MINUS THE FACT&THAT MY FRIEND&UNDYNE IS MISSING./");
ds_map_add(global.text_data_en, "obj_mainend_947", "WHO KNOWS WHERE&SHE WENT./");
ds_map_add(global.text_data_en, "obj_mainend_948", "SHE NEVER LIKED&METTATON'S SHOW./");
ds_map_add(global.text_data_en, "obj_mainend_949", "\E3PEOPLE WHO DON'T&TEND TO KIND OF.../");
ds_map_add(global.text_data_en, "obj_mainend_950", "\E5DISAPPEAR./");
ds_map_add(global.text_data_en, "obj_mainend_951", "\E6I MISS HER A&LOT SOMETIMES./");
ds_map_add(global.text_data_en, "obj_mainend_952", "\E0IF YOU SEE HER^1,&CAN YOU TELL HER&I SAID HI?/");
ds_map_add(global.text_data_en, "obj_mainend_953", "THANKS^1!&SEE YOU LATER!/%%");
ds_map_add(global.text_data_en, "obj_mainend_984", "\E3* so.^1.&* it's been a while./");
ds_map_add(global.text_data_en, "obj_mainend_985", "* since you left.../");
ds_map_add(global.text_data_en, "obj_mainend_986", "\E1* things have gotten&  really strange./");
ds_map_add(global.text_data_en, "obj_mainend_987", "\E0* overnight^1, a bunch of&  people mysteriously&  disappeared./");
ds_map_add(global.text_data_en, "obj_mainend_988", "\E3* as well as the&  human souls./");
ds_map_add(global.text_data_en, "obj_mainend_989", "\E3* people were heart-&  broken. everyone they&  looked up to.../");
ds_map_add(global.text_data_en, "obj_mainend_990", "* everything they were&  relying on^1, in one&  night, disappeared./");
ds_map_add(global.text_data_en, "obj_mainend_991", "* everyone clamored to&  elect a new ruler as&  fast as possible./");
ds_map_add(global.text_data_en, "obj_mainend_992", "\E1* so^1, uh..^1.&* by process of&  elimination.../");
ds_map_add(global.text_data_en, "obj_mainend_993", "\E2* papyrus became the&  ruler?/");
ds_map_add(global.text_data_en, "obj_mainend_994", "\E1* why doesn't he talk&  to you about this.../");
ds_map_add(global.text_data_en, "obj_mainend_996", "\E0HELLO!!^1!&HUMAN!!!/");
ds_map_add(global.text_data_en, "obj_mainend_997", "\E3IT'S STRANGE./");
ds_map_add(global.text_data_en, "obj_mainend_998", "\E3ASGORE^1, ALPHYS^1,&METTATON^1, AND&UNDYNE WENT AWAY./");
ds_map_add(global.text_data_en, "obj_mainend_999", "\E0SANS SAYS THEY&WENT ON VACATION./");
ds_map_add(global.text_data_en, "obj_mainend_1000", "I HOPE THEY'RE&HAVING FUN!!!/");
ds_map_add(global.text_data_en, "obj_mainend_1001", "\E3OH YEAH./");
ds_map_add(global.text_data_en, "obj_mainend_1002", "\E0I'M THE RULER OF&THE UNDERGROUND&NOW!!!/");
ds_map_add(global.text_data_en, "obj_mainend_1003", "EVERYTHING IS&IMPROVING A LOT&HERE./");
ds_map_add(global.text_data_en, "obj_mainend_1004", "PRODUCTIVITY IS UP!/");
ds_map_add(global.text_data_en, "obj_mainend_1005", "BECAUSE I TELL&EVERYONE TO KEEP&WORKING./");
ds_map_add(global.text_data_en, "obj_mainend_1006", "AND^1, NO ONE GOES&HUNGRY!!!/");
ds_map_add(global.text_data_en, "obj_mainend_1007", "BECAUSE I COOK&EVERYONE&SPAGHETTI./");
ds_map_add(global.text_data_en, "obj_mainend_1008", "\E3MEANWHILE^1, MY&BROTHER HANDLES&THE PAPERWORK./");
ds_map_add(global.text_data_en, "obj_mainend_1009", "\E3STRANGELY..^1.&HE SEEMS TO BE&WORKING HARD?/");
ds_map_add(global.text_data_en, "obj_mainend_1010", "\E3THIS SOUNDS MESSED&UP..^1. BUT.../");
ds_map_add(global.text_data_en, "obj_mainend_1011", "\E5I'M PROUD..^1.&OF HIM???/");
ds_map_add(global.text_data_en, "obj_mainend_1012", "OH NO!!!!/");
ds_map_add(global.text_data_en, "obj_mainend_1013", "\E0AS FOR OUR HUMAN&POLICY.../");
ds_map_add(global.text_data_en, "obj_mainend_1014", "\E3WE'VE DECIDED^1, UM./");
ds_map_add(global.text_data_en, "obj_mainend_1015", "SANS^1, WHAT WAS IT?/");
ds_map_add(global.text_data_en, "obj_mainend_1017", "\E2* we can't judge&  humans to be all&  good or all bad./");
ds_map_add(global.text_data_en, "obj_mainend_1019", "\E0RIGHT^1!&SO IT'S CASE-BY-&CASE!/");
ds_map_add(global.text_data_en, "obj_mainend_1020", "IF THEY'RE EVIL..^1.&WE GIVE THEM&PUZZLES!/");
ds_map_add(global.text_data_en, "obj_mainend_1021", "IF THEY'RE GOOD..^1.&WE ALSO GIVE&THEM PUZZLES!/");
ds_map_add(global.text_data_en, "obj_mainend_1022", "THAT SEEMS TO BE&THE BEST WAY!/");
ds_map_add(global.text_data_en, "obj_mainend_1023", "\E0.../");
ds_map_add(global.text_data_en, "obj_mainend_1024", "\E3.../");
ds_map_add(global.text_data_en, "obj_mainend_1025", "IS SANS GONE?/");
ds_map_add(global.text_data_en, "obj_mainend_1026", "\E6YOU KNOW.../");
ds_map_add(global.text_data_en, "obj_mainend_1027", "DON'T TELL MY&BROTHER, BUT.../");
ds_map_add(global.text_data_en, "obj_mainend_1028", "DESPITE THE&IMPROVEMENTS&WE'VE MADE.../");
ds_map_add(global.text_data_en, "obj_mainend_1029", "SOMETIMES THIS JOB&IS KIND OF HARD./");
ds_map_add(global.text_data_en, "obj_mainend_1030", "SINCE THE KING&WENT AWAY.../");
ds_map_add(global.text_data_en, "obj_mainend_1031", "LOTS OF PEOPLE&JUST WANT TO&GIVE UP./");
ds_map_add(global.text_data_en, "obj_mainend_1032", "SOMETIMES, EVEN MY&BEST&ENCOURAGEMENT.../");
ds_map_add(global.text_data_en, "obj_mainend_1033", "DOESN'T WORK./");
ds_map_add(global.text_data_en, "obj_mainend_1034", "AND^1, AND^1, I MISS&UNDYNE^1, TOO./");
ds_map_add(global.text_data_en, "obj_mainend_1035", "SHE NEVER ANSWERS&MY PHONE CALLS.../");
ds_map_add(global.text_data_en, "obj_mainend_1036", "\E5SHE MUST BE& HAVING A LOT OF&FUN ON VACATION./");
ds_map_add(global.text_data_en, "obj_mainend_1037", "\E6I JUST WISH SHE'D&SEND A POSTCARD./");
ds_map_add(global.text_data_en, "obj_mainend_1038", ".../");
ds_map_add(global.text_data_en, "obj_mainend_1039", "\E5BUT HEY!!!/");
ds_map_add(global.text_data_en, "obj_mainend_1040", "\E4I WON'T GIVE UP!/");
ds_map_add(global.text_data_en, "obj_mainend_1041", "I CAN'T GIVE UP!/");
ds_map_add(global.text_data_en, "obj_mainend_1042", "I HAVE TO MAKE&EVERYONE GIVE UP&GIVING UP!/");
ds_map_add(global.text_data_en, "obj_mainend_1043", "\E0WE'LL GET OUT&OF HERE^1, SLOWLY!!!/");
ds_map_add(global.text_data_en, "obj_mainend_1044", "THEN WE CAN ALL&HANG OUT AGAIN!!!/");
ds_map_add(global.text_data_en, "obj_mainend_1045", "\E0NYEH HEH HEH!!!/%%");
ds_map_add(global.text_data_en, "obj_mainend_1055", "\E3* it's been a while^1,&  huh?/");
ds_map_add(global.text_data_en, "obj_mainend_1056", "* .../");
ds_map_add(global.text_data_en, "obj_mainend_1057", "* things have gotten&  pretty bad here./");
ds_map_add(global.text_data_en, "obj_mainend_1058", "\E0* everyone considered a&  leader disappeared&  overnight./");
ds_map_add(global.text_data_en, "obj_mainend_1059", "\E1* it's gotten so quiet./");
ds_map_add(global.text_data_en, "obj_mainend_1060", "\E3* there's a bad feeling&  hanging over&  everyone./");
ds_map_add(global.text_data_en, "obj_mainend_1061", "* like everyone's just&  going to die here^1,&  trapped in the dark.../");
ds_map_add(global.text_data_en, "obj_mainend_1062", "\E2* ... i bet you're&  wondering why i'm&  not the ruler./");
ds_map_add(global.text_data_en, "obj_mainend_1063", "\E1* eh./");
ds_map_add(global.text_data_en, "obj_mainend_1064", "\E1* i'm not cut out&  for something like&  that./");
ds_map_add(global.text_data_en, "obj_mainend_1065", "\E2* i like to take it&  easy^1, you know?/");
ds_map_add(global.text_data_en, "obj_mainend_1066", "\E2* .../");
ds_map_add(global.text_data_en, "obj_mainend_1067", "\E3* ... that's a joke./");
ds_map_add(global.text_data_en, "obj_mainend_1068", "\E3* this is what happens&  when people like me&  take it easy./");
ds_map_add(global.text_data_en, "obj_mainend_1069", "* .../");
ds_map_add(global.text_data_en, "obj_mainend_1070", "\E4* see ya./%%");
ds_map_add(global.text_data_en, "obj_mainend_1074", "\E0* hey^1, at least things&  are less crowded./");
ds_map_add(global.text_data_en, "obj_mainend_1075", "\E1* 'cause of all the&  people you killed./");
ds_map_add(global.text_data_en, "obj_mainend_1076", "\E2* hope that was a good&  experience for you./");
ds_map_add(global.text_data_en, "obj_mainend_1077", "\E3* .../");
ds_map_add(global.text_data_en, "obj_mainend_1078", "\E2* just kidding^1.&* i don't really hope&  that./");
ds_map_add(global.text_data_en, "obj_mainend_1079", "\E4* go to hell./%%");
ds_map_add(global.text_data_en, "obj_mainend_1092", "\E3* it's been a while^1,&  huh?/");
ds_map_add(global.text_data_en, "obj_mainend_1093", "* .../");
ds_map_add(global.text_data_en, "obj_mainend_1094", "\E1* it seems a number of&  important people&  disappeared overnight./");
ds_map_add(global.text_data_en, "obj_mainend_1095", "* but no one else was&  harmed./");
ds_map_add(global.text_data_en, "obj_mainend_1096", "\E0* the people were&  confused^1.&* it was complete bedlam./");
ds_map_add(global.text_data_en, "obj_mainend_1097", "\E3* somehow^1, at the end of&  the day.../");
ds_map_add(global.text_data_en, "obj_mainend_1098", "\E1* a small^1, white dog&  became president of&  the underground./");
ds_map_add(global.text_data_en, "obj_mainend_1099", "\E0* it sleeps on the&  throne and does&  absolutely nothing./");
ds_map_add(global.text_data_en, "obj_mainend_1100", "\E1* strangely^1, it seems&  this is the best&  life for everyone./");
ds_map_add(global.text_data_en, "obj_mainend_1101", "\E2* thanks./%%");
ds_map_add(global.text_data_en, "obj_mainend_1112", "\E3* it's been a while^1,&  huh?/");
ds_map_add(global.text_data_en, "obj_mainend_1113", "* .../");
ds_map_add(global.text_data_en, "obj_mainend_1114", "\E1* i'll be honest./");
ds_map_add(global.text_data_en, "obj_mainend_1115", "\E2* i have no idea what&  happened for you&  to get here./");
ds_map_add(global.text_data_en, "obj_mainend_1116", "\E1* this is actually some&  sort of error-&  handling message./");
ds_map_add(global.text_data_en, "obj_mainend_1117", "\E3* so^1, if you're getting&  this ending.../");
ds_map_add(global.text_data_en, "obj_mainend_1118", "\E1* tell whoever made the&  game^1, okay?/");
ds_map_add(global.text_data_en, "obj_mainend_1119", "\E2* they'll fix it^1, or&  if it's a novel&  situation.../");
ds_map_add(global.text_data_en, "obj_mainend_1120", "\E1* they might even add&  another ending to&  the game./");
ds_map_add(global.text_data_en, "obj_mainend_1121", "\E3* chances are^1, though.../");
ds_map_add(global.text_data_en, "obj_mainend_1122", "\E4* you're just a dirty&  hacker^1, aren't you?/");
ds_map_add(global.text_data_en, "obj_mainend_1123", "\E1* yeah^1, get outta here./%%");
ds_map_add(global.text_data_en, "obj_mainend_1136", "\E1* H..^1. hey./");
ds_map_add(global.text_data_en, "obj_mainend_1137", "\E0* So..^1. you're the one&  who killed all my&  friends./");
ds_map_add(global.text_data_en, "obj_mainend_1139", "\E1* I just called to tell&  you./");
ds_map_add(global.text_data_en, "obj_mainend_1141", "\E0* I hate you./");
ds_map_add(global.text_data_en, "obj_mainend_1143", "\E1* Yet..^1. strangely..^1.&* It's because of you^1,&  that.../");
ds_map_add(global.text_data_en, "obj_mainend_1145", "\E2* That I was forced to&  become a better&  person./");
ds_map_add(global.text_data_en, "obj_mainend_1147", "\E0* When I first saw you&  hurting people.../");
ds_map_add(global.text_data_en, "obj_mainend_1148", "* I just sat there^1.&* Watching you./");
ds_map_add(global.text_data_en, "obj_mainend_1149", "\E1* I felt so guilty knowing&  I hadn't do anything&  to stop you./");
ds_map_add(global.text_data_en, "obj_mainend_1150", "\E3* I felt like all I&  do was.../");
ds_map_add(global.text_data_en, "obj_mainend_1151", "\E4* Was hope you would&  destroy me^1, too./");
ds_map_add(global.text_data_en, "obj_mainend_1152", "\E1* But when Undyne called^1,&  with crazed desperation&  in her voice.../");
ds_map_add(global.text_data_en, "obj_mainend_1153", "\E0* I..^1.&* I realized I had to do&  something./");
ds_map_add(global.text_data_en, "obj_mainend_1154", "\E1* Even if it meant&  everybody would.../");
ds_map_add(global.text_data_en, "obj_mainend_1155", "* Have to learn the&  truth about me./");
ds_map_add(global.text_data_en, "obj_mainend_1156", "\E2* It's strange^1.&* You know?/");
ds_map_add(global.text_data_en, "obj_mainend_1157", "\E5* Even after all the&  bad things I did./");
ds_map_add(global.text_data_en, "obj_mainend_1158", "* People treated me like&  a hero./");
ds_map_add(global.text_data_en, "obj_mainend_1159", "\E2* And then they..^1.&* Asked me to run&  everything./");
ds_map_add(global.text_data_en, "obj_mainend_1160", "\E5* So I'm trying my&  best^1, here./");
ds_map_add(global.text_data_en, "obj_mainend_1161", "\E2* I think I have some&  good policies^1, but^1,&  y-you know.../");
ds_map_add(global.text_data_en, "obj_mainend_1162", "\E1* Talking to people&  still makes me&  nervous./");
ds_map_add(global.text_data_en, "obj_mainend_1163", "\E0* I'm no ASGORE^1,&  you know?/");
ds_map_add(global.text_data_en, "obj_mainend_1164", "\E2* .../");
ds_map_add(global.text_data_en, "obj_mainend_1165", "\E4* God..^1.&* I miss everyone./");
ds_map_add(global.text_data_en, "obj_mainend_1166", "\E3* Now that they're&  gone^1, it.../");
ds_map_add(global.text_data_en, "obj_mainend_1167", "* It feels so clear what&  I should have done./");
ds_map_add(global.text_data_en, "obj_mainend_1168", "\E3* What I should have&  said./");
ds_map_add(global.text_data_en, "obj_mainend_1169", "\E6* Undyne..^1.&* Asgore.../");
ds_map_add(global.text_data_en, "obj_mainend_1170", "* Mettaton.../");
ds_map_add(global.text_data_en, "obj_mainend_1171", "\E5* At least Sans is&  still here./");
ds_map_add(global.text_data_en, "obj_mainend_1172", "\E4* He's..^1.&* He's a good guy^1.&* And with him around.../");
ds_map_add(global.text_data_en, "obj_mainend_1173", "\E4* I.../");
ds_map_add(global.text_data_en, "obj_mainend_1174", "\E2* Sigh./");
ds_map_add(global.text_data_en, "obj_mainend_1175", "\E1* You know^1.&* Just daydreaming here^1.&* But.../");
ds_map_add(global.text_data_en, "obj_mainend_1176", "\E5* I really should have&  killed you when I&  had the chance./%%");
ds_map_add(global.text_data_en, "obj_mandog_251", "Take my&wife...&'s fleas.");
ds_map_add(global.text_data_en, "obj_mandog_252", "Don't&touch my&hot dog.");
ds_map_add(global.text_data_en, "obj_mandog_253", "No. 2&Nuzzle&Champs&'98!!");
ds_map_add(global.text_data_en, "obj_mandog_254", "Let's&kick&human&tail!!");
ds_map_add(global.text_data_en, "obj_mandog_259", "Hm?&What's&that&smell?");
ds_map_add(global.text_data_en, "obj_mandog_260", "What!&Smells&like a&...");
ds_map_add(global.text_data_en, "obj_mandog_264", "Paws off&you&smelly&human.");
ds_map_add(global.text_data_en, "obj_mandog_267", "Wow!!!&Pet by&another&pup!!!");
ds_map_add(global.text_data_en, "obj_mandog_272", "Stop!&Don't&touch&her!");
ds_map_add(global.text_data_en, "obj_mandog_273", "What&about&me......&........");
ds_map_add(global.text_data_en, "obj_mandog_280", "Whine.");
ds_map_add(global.text_data_en, "obj_mandog_281", "Whimper.");
ds_map_add(global.text_data_en, "obj_mandog_284", "%%%");
ds_map_add(global.text_data_en, "obj_mandog_474", "* Dogamy is brokenhearted.");
ds_map_add(global.text_data_en, "obj_mandog_490", "* DOGAMY - ATK 14 DEF 5&* Husband of Dogaressa.&* Knows only what he smells./^");
ds_map_add(global.text_data_en, "obj_mandog_498", "* The Dogs sniff you again.../");
ds_map_add(global.text_data_en, "obj_mandog_499", "* But you smell just as&  weird as before!/^");
ds_map_add(global.text_data_en, "obj_mandog_500", "* The Dogs sniff you again.../");
ds_map_add(global.text_data_en, "obj_mandog_501", "* After rolling in the dirt^1,&  you smell all right!/^");
ds_map_add(global.text_data_en, "obj_mandog_502", "* The Dogs already know you&  smell fine./^");
ds_map_add(global.text_data_en, "obj_mandog_503", "* Dogamy won't even lift&  up his snout./^");
ds_map_add(global.text_data_en, "obj_mandog_513", "* Dogamy just growls at&  you./^");
ds_map_add(global.text_data_en, "obj_mandog_516", "* The Dogs are too suspicious&  of your smell./^");
ds_map_add(global.text_data_en, "obj_mandog_517", "* You pet Dogamy./^");
ds_map_add(global.text_data_en, "obj_mandog_527", "* You roll around in the&  dirt and snow./");
ds_map_add(global.text_data_en, "obj_mandog_528", "* You smell like a weird&  puppy./^");
ds_map_add(global.text_data_en, "obj_memoryhead_166", "Come&join&the&fun.");
ds_map_add(global.text_data_en, "obj_memoryhead_167", "It's a&real&get&together");
ds_map_add(global.text_data_en, "obj_memoryhead_168", "Lorem&ipsum&docet");
ds_map_add(global.text_data_en, "obj_memoryhead_169", "Become&one of&us!");
ds_map_add(global.text_data_en, "obj_memoryhead_171", "Come&join&the&fun.");
ds_map_add(global.text_data_en, "obj_memoryhead_181", "That's&a&shame.");
ds_map_add(global.text_data_en, "obj_memoryhead_182", "Oh&well.");
ds_map_add(global.text_data_en, "obj_memoryhead_183", "Be&seeing&you.");
ds_map_add(global.text_data_en, "obj_memoryhead_188", "Then,&hold&still.");
ds_map_add(global.text_data_en, "obj_memoryhead_189", "Just&a&moment.");
ds_map_add(global.text_data_en, "obj_memoryhead_190", "You'll&be with&us&shortly.");
ds_map_add(global.text_data_en, "obj_memoryhead_195", "%%%");
ds_map_add(global.text_data_en, "obj_memoryhead_420", "* But nobody came.");
ds_map_add(global.text_data_en, "obj_memoryhead_421", "* But nobody came.");
ds_map_add(global.text_data_en, "obj_memoryhead_422", "* But nobody came.");
ds_map_add(global.text_data_en, "obj_memoryhead_423", "* But nobody came.");
ds_map_add(global.text_data_en, "obj_memoryhead_424", "* Smells like batteries.");
ds_map_add(global.text_data_en, "obj_memoryhead_425", "* Seems like it doesn't&  care anymore.");
ds_map_add(global.text_data_en, "obj_memoryhead_426", "* Monster has low HP.");
ds_map_add(global.text_data_en, "obj_memoryhead_461", "* No data available./^");
ds_map_add(global.text_data_en, "obj_memoryhead_472", "* The enemy put a piece of&  itself in your inventory./^");
ds_map_add(global.text_data_en, "obj_memoryhead_474", "* But your inventory was full./^");
ds_map_add(global.text_data_en, "obj_memoryhead_484", "* AT - \[1] DF - \[2] /^");
ds_map_add(global.text_data_en, "obj_memoryhead_493", "* You take out your CELL PHONE^1.&* You can hear voices through&  the receiver...!/^");
ds_map_add(global.text_data_en, "obj_memoryhead_511", "* MEMORYHEAD/^");
ds_map_add(global.text_data_en, "obj_mett_bossintro_174", "Ohhhh my./");
ds_map_add(global.text_data_en, "obj_mett_bossintro_175", "If you flipped my&switch, that can&only mean one&thing./");
ds_map_add(global.text_data_en, "obj_mett_bossintro_176", "You're desperate&for the premiere&of my new body./");
ds_map_add(global.text_data_en, "obj_mett_bossintro_177", "How rude.../");
ds_map_add(global.text_data_en, "obj_mett_bossintro_178", "Lucky for you,&I've been aching&to show this off&for a long time./");
ds_map_add(global.text_data_en, "obj_mett_bossintro_179", "So..^1. as thanks^1,&I'll give you a&handsome reward./");
ds_map_add(global.text_data_en, "obj_mett_bossintro_180", "I'll make your&last living&moments.../%%");
ds_map_add(global.text_data_en, "obj_mett_bossintro_213", "ABSOLUTELY beautiful!/%%");
ds_map_add(global.text_data_en, "obj_mettaton_neo_449", "* Stage lights are blaring.");
ds_map_add(global.text_data_en, "obj_mettaton_neo_461", "* Stage lights are blaring.");
ds_map_add(global.text_data_en, "obj_mettaton_neo_482", "* METTATON NEO - 90 ATK 9 DEF&* Dr. Alphys's greatest&  invention./^");
ds_map_add(global.text_data_en, "obj_mettaton_neo_535", "\E6G...&GUESS SHE SHOULD&HAVE WORKED MORE&ON THE DEFENSES.../");
ds_map_add(global.text_data_en, "obj_mettaton_neo_536", "\E6.../");
ds_map_add(global.text_data_en, "obj_mettaton_neo_537", "\E6YOU MAY HAVE&DEFEATED ME...&BUT.../");
ds_map_add(global.text_data_en, "obj_mettaton_neo_538", "\E4I KNOW.&I CAN TELL FROM&THAT STRIKE, DARLING./");
ds_map_add(global.text_data_en, "obj_mettaton_neo_539", "\E5YOU WERE HOLDING&BACK./");
ds_map_add(global.text_data_en, "obj_mettaton_neo_540", "\E6YES, ASGORE WILL&FALL EASILY TO&YOU.../");
ds_map_add(global.text_data_en, "obj_mettaton_neo_541", "\E5BUT YOU WON'T&HARM HUMANITY,&WILL YOU?/");
ds_map_add(global.text_data_en, "obj_mettaton_neo_542", "\E1YOU AREN'T&ABSOLUTELY EVIL./");
ds_map_add(global.text_data_en, "obj_mettaton_neo_543", "\E5IF YOU WERE&TRYING TO BE,&THEN YOU MESSED UP./");
ds_map_add(global.text_data_en, "obj_mettaton_neo_544", "\E0AND SO LATE INTO&THE SHOW, TOO./");
ds_map_add(global.text_data_en, "obj_mettaton_neo_545", "\E0HA... HA.&AT LEAST NOW,&I CAN REST EASY./");
ds_map_add(global.text_data_en, "obj_mettaton_neo_546", "\E3KNOWING ALPHYS AND&THE HUMANS WILL&LIVE ON...!/%%");
ds_map_add(global.text_data_en, "obj_mettaton_neo_550", "\E6GH.../");
ds_map_add(global.text_data_en, "obj_mettaton_neo_551", "\E5GUESS YOU DON'T&WANNA JOIN MY&FAN CLUB...?/%%");
ds_map_add(global.text_data_en, "obj_mettaton_npc_63", "* Capital wenisberry./%%");
ds_map_add(global.text_data_en, "obj_mettaton_npc_69", "\W* \YMILK^1, SUGAR^1, \WAND\Y EGGS\W!&* YOU SHOULD BE ABLE TO FIND&  THEM ON THE BACK COUNTER!/%%");
ds_map_add(global.text_data_en, "obj_mettaton_npc_77", "* GREAT JOB^1!&* JUST PUT THEM IN THE MIDDLE&  OF THIS COUNTER!/%%");
ds_map_add(global.text_data_en, "obj_mettaton_npc_82", "* WHAT'S THE MATTER?&* NOT A CAN FAN?&* THAT'S TOO BAD!/");
ds_map_add(global.text_data_en, "obj_mettaton_npc_83", "* MTT-BRAND USES ONLY THE&  FRESHEST ARTIFICIAL INGREDIENTS&  AND CHEMICALS!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_255", "LET'S START WITH&AN EASY ONE!!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_258", "HERE'S YOUR TERRIFIC&PRIZE!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_262", "ENOUGH ABOUT YOU.&LET'S TALK ABOUT ME!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_266", "HERE'S ANOTHER EASY&ONE FOR YOU!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_270", "DON'T 'COUNT'&ON YOUR VICTORY.../%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_274", "LET'S PLAY MEMORY&GAME./%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_278", "BUT CAN YOU GET&THIS ONE???/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_282", "HERE'S A SIMPLE&ONE./%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_286", "TIME TO BREAK OUT&THE BIG GUNS!!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_294", "%%%");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_490", "* Mettaton.");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_514", "* METTATON - ATK 30 DEF 255&* His metal body renders him&  invulnerable to attack./^");
ds_map_add(global.text_data_en, "obj_mettatonb_quiz_524", "* Screaming is against the&  rules./^");
ds_map_add(global.text_data_en, "obj_mettatonb_second_256", "THIS IS IT, DARLING!&SAY GOODBYE!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_265", "HA!&THAT BUTTON WON'T&SAVE YOU NOW, DARLING!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_268", "YOU WOULDN'T DARE&USE THE [ACT] COMMAND&AND PRESS THAT&BUTTON!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_271", "THAT'S RIGHT!&DON'T PRESS IT!&I'LL DESTROY YOU!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_274", "WITHOUT THAT BUTTON,&YOU ARE INCHING&CLOSER AND CLOSER&TO YOUR DEMISE!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_277", "ANY MINUTE NOW!&    /%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_280", "ANY... MINUTE...&....NOW!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_284", ".............&............/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_290", "..........&...(COUGH)/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_299", "OH!!!&THAT YELLOW GLOW...!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_300", "TOOK YOU LONG&ENOUGH!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_542", "* Mettaton.");
ds_map_add(global.text_data_en, "obj_mettatonb_second_564", "* METTATON - ATK 30 DEF 255&* His metal body STILL renders&  him invulnerable to attack./^");
ds_map_add(global.text_data_en, "obj_mettatonb_second_574", "* You yell..^1.&* Nothing happened./^");
ds_map_add(global.text_data_en, "obj_mettatonb_second_579", "* You press the yellow button^1.&* The phone is resonating with&  Mettaton's presence...!/^");
ds_map_add(global.text_data_en, "obj_mettatonb_second_640", "IS THAT YOUR PHONE?&YOU'D BETTER ANSWER&IT!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_652", "H-hey!!&Th-this seems bad,&but don't worry!!/");
ds_map_add(global.text_data_en, "obj_mettatonb_second_653", "Th-there's one last&thing I installed&on your phone...!/");
ds_map_add(global.text_data_en, "obj_mettatonb_second_654", "\WYou see that\Y &yellow button\W...?/");
ds_map_add(global.text_data_en, "obj_mettatonb_second_655", "Go to this phone's&[[ACT]] menu and&press it!!!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_662", "* Your phone's [[ACT]] menu is&  glowing.");
ds_map_add(global.text_data_en, "obj_mettatonb_second_703", "Now press \*Z!!!");
ds_map_add(global.text_data_en, "obj_mettatonb_second_746", "OOOH!/");
ds_map_add(global.text_data_en, "obj_mettatonb_second_747", "OOOOOOOH!/");
ds_map_add(global.text_data_en, "obj_mettatonb_second_748", "YOU'VE DEFEATED ME!!/");
ds_map_add(global.text_data_en, "obj_mettatonb_second_749", "HOW CAN THIS BE,&YOU WERE STRONGER&THAN I THOUGHT, ETC./%%");
ds_map_add(global.text_data_en, "obj_mettatonb_second_757", "WHATEVER.");
ds_map_add(global.text_data_en, "obj_mettatonb_third_214", "THIS IS IT, DARLING!&SAY GOODBYE!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_224", "YES, I WAS THE ONE&THAT RE-ARRANGED&THE CORE!/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_225", "I WAS THE ONE THAT&HIRED EVERYONE TO&KILL YOU!/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_226", "THAT, HOWEVER, WAS A&SHORT-SIGHTED PLAN./");
ds_map_add(global.text_data_en, "obj_mettatonb_third_227", "YOU KNOW WHAT WOULD&BE A HUNDRED TIMES&BETTER?/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_228", "KILLING YOU MYSELF!!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_233", "LISTEN, DARLING.&I'VE SEEN YOU FIGHT./");
ds_map_add(global.text_data_en, "obj_mettatonb_third_234", "YOU'RE WEAK./");
ds_map_add(global.text_data_en, "obj_mettatonb_third_235", "IF YOU CONTINUE&FORWARD, ASGORE WILL&TAKE YOUR SOUL./");
ds_map_add(global.text_data_en, "obj_mettatonb_third_236", "AND WITH YOUR SOUL,&ASGORE WILL DESTROY&HUMANITY./%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_241", "BUT IF I GET YOUR&SOUL, I CAN STOP&ASGORE'S PLAN!/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_242", "I CAN SAVE HUMANITY&FROM DESTRUCTION!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_247", "THEN, USING YOUR SOUL,&I'LL CROSS THROUGH&THE BARRIER.../");
ds_map_add(global.text_data_en, "obj_mettatonb_third_248", "AND BECOME THE STAR&I'VE ALWAYS DREAMED&OF BEING!/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_249", "HUNDREDS, THOUSANDS.../");
ds_map_add(global.text_data_en, "obj_mettatonb_third_250", "NO!&MILLIONS OF HUMANS&WILL WATCH ME!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_255", "GLITZ! GLAMOUR!&I'LL FINALLY HAVE&IT ALL!/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_256", "SO WHAT IF A FEW&PEOPLE HAVE TO DIE?/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_257", "THAT'S SHOW BUSINESS,&BABY!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_523", "* Mettaton.");
ds_map_add(global.text_data_en, "obj_mettatonb_third_545", "* METTATON - ATK 30 DEF 255&* Seriously^1, his metal body&  is invulnerable!/^");
ds_map_add(global.text_data_en, "obj_mettatonb_third_555", "* This is probably what you'll&  do if things continue in&  this manner./^");
ds_map_add(global.text_data_en, "obj_mettatonb_third_560", "* You tell Mettaton that there's&  a mirror behind him./%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_644", "U..uh... I can't see&what's going on in&there, but.../");
ds_map_add(global.text_data_en, "obj_mettatonb_third_645", "D-d-don't give up,&okay!?/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_646", "Th... there's o-one&l-l-last way to beat&Mettaton.../");
ds_map_add(global.text_data_en, "obj_mettatonb_third_647", "It's... um... it's.../");
ds_map_add(global.text_data_en, "obj_mettatonb_third_648", "This is a work in-&progress, so don't&judge it too hard.../");
ds_map_add(global.text_data_en, "obj_mettatonb_third_649", "But, you know how&Mettaton always faces&f-f-forward?/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_650", "That's because&there's a switch&on his backside./");
ds_map_add(global.text_data_en, "obj_mettatonb_third_651", "S-s-so if y-y-you&c-c-can turn him&around... um.../");
ds_map_add(global.text_data_en, "obj_mettatonb_third_652", "And, umm... press&th-th-th-the&switch.../");
ds_map_add(global.text_data_en, "obj_mettatonb_third_653", "He'll be... um...&He'll be.../");
ds_map_add(global.text_data_en, "obj_mettatonb_third_654", "Vulnerable./");
ds_map_add(global.text_data_en, "obj_mettatonb_third_655", "Well, g-g-gotta go!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_688", "* Seems like a good time to&  turn Mettaton around.");
ds_map_add(global.text_data_en, "obj_mettatonb_third_820", "OH???&A MIRROR???/");
ds_map_add(global.text_data_en, "obj_mettatonb_third_821", "RIGHT, I HAVE TO&LOOK PERFECT FOR&OUR GRAND FINALE!/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_831", "HMMM...&I DON'T SEE IT...&WHERE IS IT...?/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_848", "DID YOU./");
ds_map_add(global.text_data_en, "obj_mettatonb_third_849", "JUST FLIP./");
ds_map_add(global.text_data_en, "obj_mettatonb_third_850", "MY SWITCH?/%%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_943", "THAT WORTHLESS PEA-&SHOOTER WON'T WORK&ON ME, DARLING. ^3 %");
ds_map_add(global.text_data_en, "obj_mettatonb_third_944", "DON'T YOU UNDERSTAND&WHAT ACTING IS!?^3 %%");
ds_map_add(global.text_data_en, "obj_mettatonb_third_952", "* Mettaton.");
ds_map_add(global.text_data_en, "obj_mettatonex_167", ".../%%");
ds_map_add(global.text_data_en, "obj_mettatonex_190", "Lights!&Camera!&Action!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_196", "Drama!&Romance!&Blood-&shed!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_202", "I'm the&idol&everyone&craves!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_208", "Smile&for the&camera!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_214", "Oooh, it's time&for a pop quiz!/");
ds_map_add(global.text_data_en, "obj_mettatonex_215", "I hope you brought&a keyboard.../");
ds_map_add(global.text_data_en, "obj_mettatonex_215_console", "Have fun with that&on-screen keyboard.../");
ds_map_add(global.text_data_en, "obj_mettatonex_216", "This one's an&essay question!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_222", "Your essay really&showed everyone&your heart./");
ds_map_add(global.text_data_en, "obj_mettatonex_223", "Why don't I show&you mine?/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_231", "Ooooh,&I'm just&warming&up!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_237", "But how are you&on the dance floor!?/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_244", "Can you&keep up&the&pace!?/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_253", "Lights!&Camera&Bombs!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_259", "Things&are&blowing&up!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_267", "Time for our union-&regulated break!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_274", "We've grown so&distant, darling.../");
ds_map_add(global.text_data_en, "obj_mettatonex_275", "How about another&heart-to-heart?/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_285", "A.. arms?&Wh... who needs arms&with legs like&these?/");
ds_map_add(global.text_data_en, "obj_mettatonex_286", "I'm still going&to win!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_297", "Come on&...!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_307", "The show&...&must go&on!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_317", "Dr...&Drama!&A...&Action!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_329", "\E5L... lights...&C... camera.../");
ds_map_add(global.text_data_en, "obj_mettatonex_330", "Enough of this!&Do you really want&humanity to perish!?/");
ds_map_add(global.text_data_en, "obj_mettatonex_331", "\E7... or do you just&believe in yourself&that much?/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_353", "Haha, how inspiring!/");
ds_map_add(global.text_data_en, "obj_mettatonex_354", "Well, darling!&It's either me&or you!/");
ds_map_add(global.text_data_en, "obj_mettatonex_355", "\E4But I think we both&already know who's&going to win./");
ds_map_add(global.text_data_en, "obj_mettatonex_356", "\E8Witness the true&power of humanity's&star!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_368", "... then.../");
ds_map_add(global.text_data_en, "obj_mettatonex_369", "\E8Are YOU the star?/");
ds_map_add(global.text_data_en, "obj_mettatonex_370", "Can you really&protect humanity!?/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_638", "* Mettaton.");
ds_map_add(global.text_data_en, "obj_mettatonex_639", "* Mettaton.");
ds_map_add(global.text_data_en, "obj_mettatonex_640", "* Mettaton.");
ds_map_add(global.text_data_en, "obj_mettatonex_641", "* Mettaton.");
ds_map_add(global.text_data_en, "obj_mettatonex_642", "* Smells like Mettaton.");
ds_map_add(global.text_data_en, "obj_mettatonex_644", "* Mettaton has low HP.");
ds_map_add(global.text_data_en, "obj_mettatonex_677", "* METTATON EX - ATK 47 DEF 47&* His weak point is his&  heart-shaped core./^");
ds_map_add(global.text_data_en, "obj_mettatonex_691", "* You say you aren't going&  to get hit at ALL./");
ds_map_add(global.text_data_en, "obj_mettatonex_692", "* Ratings gradually increase&  during Mettaton's turn./^");
ds_map_add(global.text_data_en, "obj_mettatonex_706", "* You posed dramatically^1.&* The audience nods./^");
ds_map_add(global.text_data_en, "obj_mettatonex_708", "* Despite being hurt^1, you&  posed dramatically^1.&* The audience applauds./^");
ds_map_add(global.text_data_en, "obj_mettatonex_710", "* Despite being wounded^1, you&  posed dramatically^1.&* The audience gasps./^");
ds_map_add(global.text_data_en, "obj_mettatonex_712", "* With the last of your power^1,&  you pose dramatically^1.&* The audience screams./^");
ds_map_add(global.text_data_en, "obj_mettatonex_726", "* You turn and scoff at the&  audience./");
ds_map_add(global.text_data_en, "obj_mettatonex_727", "* They're rooting for your&  destruction this turn!/^");
ds_map_add(global.text_data_en, "obj_mettatonex_770", "H.. ha.../");
ds_map_add(global.text_data_en, "obj_mettatonex_771", "So I was wrong./");
ds_map_add(global.text_data_en, "obj_mettatonex_772", "Darling.../");
ds_map_add(global.text_data_en, "obj_mettatonex_773", "\E1You really are&strong enough to&get past ASGORE./");
ds_map_add(global.text_data_en, "obj_mettatonex_774", "\E0Well then.../");
ds_map_add(global.text_data_en, "obj_mettatonex_775", "It's time for&you to go./");
ds_map_add(global.text_data_en, "obj_mettatonex_776", "\E0Don't worry about&me./");
ds_map_add(global.text_data_en, "obj_mettatonex_777", "I might seem like&I'm dying now^1,&but.../");
ds_map_add(global.text_data_en, "obj_mettatonex_778", "\E1Dr. Alphys can&always repair me./");
ds_map_add(global.text_data_en, "obj_mettatonex_779", "\E0And... besides.../");
ds_map_add(global.text_data_en, "obj_mettatonex_780", "Even if I'm not&cut out to be&a star.../");
ds_map_add(global.text_data_en, "obj_mettatonex_781", "\E1I still got to&perform for a&human, didn't I?/");
ds_map_add(global.text_data_en, "obj_mettatonex_782", "So, thank you,&darling.../%%");
ds_map_add(global.text_data_en, "obj_mettatonex_804", "\E1You've been a&great audience!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_836", "OOH^1, LOOK AT&THESE RATINGS!!!/");
ds_map_add(global.text_data_en, "obj_mettatonex_837", "\E6THIS IS THE MOST&VIEWERS I'VE EVER&HAD!!!/");
ds_map_add(global.text_data_en, "obj_mettatonex_838", "WE'VE REACHED THE&VIEWER CALL-IN&MILESTONE!/");
ds_map_add(global.text_data_en, "obj_mettatonex_839", "\E8ONE LUCKY VIEWER&WILL HAVE THE CHANCE&TO TALK TO ME.../");
ds_map_add(global.text_data_en, "obj_mettatonex_840", "\E7... BEFORE I LEAVE&THE UNDERGROUND&FOREVER!!/");
ds_map_add(global.text_data_en, "obj_mettatonex_841", "\E9LET'S SEE WHO&CALLS IN FIRST!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_866", "\E0HI^1, YOU'RE ON TV!/");
ds_map_add(global.text_data_en, "obj_mettatonex_867", "WHAT DO YOU HAVE&TO SAY ON THIS^1,&OUR LAST SHOW???/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_880", "...../");
ds_map_add(global.text_data_en, "obj_mettatonex_881", "oh......../");
ds_map_add(global.text_data_en, "obj_mettatonex_882", "\E1hi..^1.&mettaton.../");
ds_map_add(global.text_data_en, "obj_mettatonex_883", "i really liked&watching your show.../");
ds_map_add(global.text_data_en, "obj_mettatonex_884", "my life is pretty&boring..^1. but.../");
ds_map_add(global.text_data_en, "obj_mettatonex_885", "seeing you on the&screen..^1. brought&excitement to my&life..^1. vicariously/");
ds_map_add(global.text_data_en, "obj_mettatonex_886", "i can't tell^1, but..^1.&i guess this is&the last episode...?/");
ds_map_add(global.text_data_en, "obj_mettatonex_887", "\E3i'll miss you..^1.&mettaton....../");
ds_map_add(global.text_data_en, "obj_mettatonex_888", "... oh...^1. i didn't&mean to talk so&long.../");
ds_map_add(global.text_data_en, "obj_mettatonex_889", "\E2oh........../%%");
ds_map_add(global.text_data_en, "obj_mettatonex_900", "NO^1, WAIT^1!&WAIT^1, BL.../");
ds_map_add(global.text_data_en, "obj_mettatonex_901", "\E1H..^1.&THEY ALREADY HUNG&UP./");
ds_map_add(global.text_data_en, "obj_mettatonex_902", "\E3.../");
ds_map_add(global.text_data_en, "obj_mettatonex_903", "\E0I'LL TAKE ANOTHER&CALLER!!!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_915", "\E1Mettaton^1, your show&made us so happy!/%%");
ds_map_add(global.text_data_en, "obj_mettatonex_928", "Mettaton^1, I don't&know what I'll&watch without you./%%");
ds_map_add(global.text_data_en, "obj_mettatonex_941", "Mettaton^1, there's&a Mettaton-shaped&hole in my Mettaton-&shaped heart./%%");
ds_map_add(global.text_data_en, "obj_mettatonex_964", "\E3AH..^1. I.../");
ds_map_add(global.text_data_en, "obj_mettatonex_965", "I SEE.../");
ds_map_add(global.text_data_en, "obj_mettatonex_966", "\E4.../");
ds_map_add(global.text_data_en, "obj_mettatonex_967", "EVERYONE..^1.&THANK YOU SO MUCH./");
ds_map_add(global.text_data_en, "obj_mettatonex_968", ".../");
ds_map_add(global.text_data_en, "obj_mettatonex_969", "\E0DARLING./");
ds_map_add(global.text_data_en, "obj_mettatonex_970", "\E1PERHAPS..^1. IT MIGHT BE&BETTER IF I STAY&HERE FOR A WHILE./");
ds_map_add(global.text_data_en, "obj_mettatonex_971", "\E2HUMANS ALREADY HAVE&STARS AND IDOLS^1,&BUT MONSTERS.../");
ds_map_add(global.text_data_en, "obj_mettatonex_972", "\E0THEY ONLY HAVE ME./");
ds_map_add(global.text_data_en, "obj_mettatonex_973", "\E1IF I LEFT..^1.&THE UNDERGROUND WOULD&LOSE ITS SPARK./");
ds_map_add(global.text_data_en, "obj_mettatonex_974", "\E3I'D LEAVE AN ACHING&VOID THAT CAN NEVER&BE FILLED./");
ds_map_add(global.text_data_en, "obj_mettatonex_975", "\E0SO..^1. I THINK I'LL&HAVE TO DELAY MY&BIG DEBUT./");
ds_map_add(global.text_data_en, "obj_mettatonex_976", "\E2BESIDES./");
ds_map_add(global.text_data_en, "obj_mettatonex_977", "\E1YOU'VE PROVEN TO&BE VERY STRONG./");
ds_map_add(global.text_data_en, "obj_mettatonex_978", "\E0PERHAPS..^1. EVEN STRONG&ENOUGH TO GET PAST&ASGORE./");
ds_map_add(global.text_data_en, "obj_mettatonex_979", "\E0I'M SURE YOU'LL BE&ABLE TO PROTECT&HUMANITY./");
ds_map_add(global.text_data_en, "obj_mettatonex_980", "\E4HA^1, HA.../");
ds_map_add(global.text_data_en, "obj_mettatonex_981", "IT'S ALL FOR THE&BEST^1, ANYWAY./");
ds_map_add(global.text_data_en, "obj_mettatonex_982", "\E3THE TRUTH IS^1, THIS&FORM'S ENERGY&CONSUMPTION IS.../");
ds_map_add(global.text_data_en, "obj_mettatonex_983", "INEFFICIENT./");
ds_map_add(global.text_data_en, "obj_mettatonex_984", "IN A FEW MOMENTS^1,&I'LL RUN OUT OF&BATTERY POWER^1, AND.../");
ds_map_add(global.text_data_en, "obj_mettatonex_985", "\E4WELL./");
ds_map_add(global.text_data_en, "obj_mettatonex_986", "\E0I'LL BE ALRIGHT./");
ds_map_add(global.text_data_en, "obj_mettatonex_987", "\E5KNOCK 'EM DEAD^1,&DARLING./");
ds_map_add(global.text_data_en, "obj_mettatonex_988", "\E0AND EVERYONE..^1.&THANK YOU./");
ds_map_add(global.text_data_en, "obj_mettatonex_989", "YOU'VE BEEN A&GREAT AUDIENCE!/%%");
ds_map_add(global.text_data_en, "obj_mettboss_event_170", "* REALLY^1?&* WHERE?/%%");
ds_map_add(global.text_data_en, "obj_mettboss_event_187", "* CLEVER..^1.&* VERY CLEVER./%%");
ds_map_add(global.text_data_en, "obj_mettboss_event_230", "* OH YES.&* THERE YOU ARE, DARLING./");
ds_map_add(global.text_data_en, "obj_mettboss_event_231", "* IT'S TIME TO HAVE OUR&  LITTLE SHOWDOWN./");
ds_map_add(global.text_data_en, "obj_mettboss_event_232", "* IT'S TIME TO FINALLY STOP&  THE \"MALFUNCTIONING\" ROBOT./");ds_map_add(global.text_data_en, "obj_mettboss_event_233", "* ... NOT!!!/");
ds_map_add(global.text_data_en, "obj_mettboss_event_234", "* MALFUNCTION?&* REPROGRAMMING?&* GET REAL./");
ds_map_add(global.text_data_en, "obj_mettboss_event_235", "* THIS WAS ALL JUST A BIG&  SHOW./");
ds_map_add(global.text_data_en, "obj_mettboss_event_236", "* AN ACT./");
ds_map_add(global.text_data_en, "obj_mettboss_event_237", "* ALPHYS HAS BEEN PLAYING&  YOU FOR A FOOL THE&  WHOLE TIME./");
ds_map_add(global.text_data_en, "obj_mettboss_event_238", "* AS SHE WATCHED YOU ON THE&  SCREEN^1, SHE GREW ATTACHED&  TO YOUR ADVENTURE./");
ds_map_add(global.text_data_en, "obj_mettboss_event_239", "* SHE DESPERATELY WANTED TO&  BE A PART OF IT./");
ds_map_add(global.text_data_en, "obj_mettboss_event_240", "* SO SHE DECIDED TO INSERT&  HERSELF INTO YOUR STORY./");
ds_map_add(global.text_data_en, "obj_mettboss_event_241", "* SHE REACTIVATED PUZZLES^1.&* SHE DISABLED ELEVATORS^1.&* SHE ENLISTED ME TO TORMENT YOU./");
ds_map_add(global.text_data_en, "obj_mettboss_event_242", "* ALL SO SHE COULD SAVE&  YOU FROM DANGERS THAT&  DIDN'T EXIST./");
ds_map_add(global.text_data_en, "obj_mettboss_event_243", "* ALL SO YOU WOULD THINK&  SHE'S THE GREAT PERSON.../");
ds_map_add(global.text_data_en, "obj_mettboss_event_244", "* THAT SHE'S NOT./");
ds_map_add(global.text_data_en, "obj_mettboss_event_245", "* AND NOW^1, IT'S TIME FOR&  HER FINEST HOUR./");
ds_map_add(global.text_data_en, "obj_mettboss_event_247", "* AT THIS VERY MOMENT,&  ALPHYS IS WAITING OUTSIDE&  THE ROOM./");
ds_map_add(global.text_data_en, "obj_mettboss_event_248", "* DURING OUR \"BATTLE,\" SHE&  WILL INTERRUPT./");ds_map_add(global.text_data_en, "obj_mettboss_event_249", "* SHE WILL PRETEND TO&  \"DEACTIVATE\" ME, \"SAVING\" YOU&  ONE FINAL TIME./");ds_map_add(global.text_data_en, "obj_mettboss_event_250", "* FINALLY.&* SHE'LL BE THE HEROINE OF&  YOUR ADVENTURE./");
ds_map_add(global.text_data_en, "obj_mettboss_event_251", "* YOU'LL REGARD HER SO HIGHLY&  SHE'LL EVEN BE ABLE TO&  CONVINCE YOU NOT TO LEAVE./");
ds_map_add(global.text_data_en, "obj_mettboss_event_252", "* ... OR NOT./");
ds_map_add(global.text_data_en, "obj_mettboss_event_253", "* YOU SEE, I'VE HAD ENOUGH OF&  THIS PREDICTABLE CHARADE./");
ds_map_add(global.text_data_en, "obj_mettboss_event_254", "* I HAVE NO DESIRE TO HARM&  HUMANS.&* FAR FROM IT, ACTUALLY./");
ds_map_add(global.text_data_en, "obj_mettboss_event_255", "* MY ONLY DESIRE IS TO&  ENTERTAIN./");
ds_map_add(global.text_data_en, "obj_mettboss_event_256", "* AFTER ALL, THE AUDIENCE&  DESERVES A GOOD SHOW,&  DON'T THEY?/");
ds_map_add(global.text_data_en, "obj_mettboss_event_257", "* AND WHAT'S A GOOD SHOW.../");
ds_map_add(global.text_data_en, "obj_mettboss_event_258", "* WITHOUT A PLOT TWIST?/%%");
ds_map_add(global.text_data_en, "obj_mettboss_event_263", "* MY^1, MY^1.&* SO YOU'VE FINALLY ARRIVED./");
ds_map_add(global.text_data_en, "obj_mettboss_event_264", "* AFTER OUR FIRST MEETING^1, I&  REALIZED..^1.&* SOMETHING GHASTLY./");
ds_map_add(global.text_data_en, "obj_mettboss_event_265", "* YOU'RE NOT JUST A THREAT&  TO MONSTERS..^1.&* BUT HUMANITY^1, AS WELL./");
ds_map_add(global.text_data_en, "obj_mettboss_event_266", "* OH MY^1.&* THAT'S AN ISSUE./");
ds_map_add(global.text_data_en, "obj_mettboss_event_267", "* YOU SEE^1, I CAN'T BE A&  STAR WITHOUT AN AUDIENCE./");
ds_map_add(global.text_data_en, "obj_mettboss_event_268", "* AND BESIDES.../");
ds_map_add(global.text_data_en, "obj_mettboss_event_269", "* THERE ARE SOME PEOPLE..^1.&* I WANT TO PROTECT./%%");
ds_map_add(global.text_data_en, "obj_mettboss_event_303", "* H-hey!!^1!&* Wh-wh-what's going on!?/");
ds_map_add(global.text_data_en, "obj_mettboss_event_304", "* Th-th-the door just&  locked itself!/%%");
ds_map_add(global.text_data_en, "obj_mettboss_event_321", "\M1* SORRY^1, FOLKS^1!&* THE OLD PROGRAM'S BEEN&  CANCELLED!!!/");
ds_map_add(global.text_data_en, "obj_mettboss_event_322", "* BUT WE'VE GOT A FINALE&  THAT WILL DRIVE YOU WILD!!/%%");
ds_map_add(global.text_data_en, "obj_mettboss_event_341", "\M5* REAL DRAMA!!&* REAL ACTION!!&* REAL BLOODSHED!!/");
ds_map_add(global.text_data_en, "obj_mettboss_event_342", "* ON OUR NEW SHOW.../");
ds_map_add(global.text_data_en, "obj_mettboss_event_343", "* \"ATTACK OF THE KILLER&  ROBOT!\"/%%");ds_map_add(global.text_data_en, "obj_mettboss_event_411", "* AH HA HA^1.&* EAGER, AS ALWAYS, EH?/");
ds_map_add(global.text_data_en, "obj_mettboss_event_412", "* BUT DON'T TOUCH THAT DIAL.&* THERE'S SOMETHING YOU&  HAVEN'T ACCOUNTED FOR./");
ds_map_add(global.text_data_en, "obj_mettboss_event_413", "* AS ANY TRUE FAN WOULD KNOW,&  I WAS FIRST CREATED AS&  A HUMAN ERADICATION ROBOT./");
ds_map_add(global.text_data_en, "obj_mettboss_event_414", "* IT WAS ONLY AFTER BECOMING A&  STAR THAT I WAS GIVEN A&  MORE... PHOTOGENIC BODY./");
ds_map_add(global.text_data_en, "obj_mettboss_event_415", "* HOWEVER./");
ds_map_add(global.text_data_en, "obj_mettboss_event_416", "* THOSE ORIGINAL FUNCTIONS&  HAVE NEVER BEEN FULLY&  REMOVED.../");
ds_map_add(global.text_data_en, "obj_mettboss_event_417", "* COME ANY CLOSER, AND&  I'LL BE FORCED TO SHOW&  YOU.../");
ds_map_add(global.text_data_en, "obj_mettboss_event_418", "\M5* MY TRUE FORM!/%%");
ds_map_add(global.text_data_en, "obj_mettboss_event_443", "\M0* FINE THEN!/");
ds_map_add(global.text_data_en, "obj_mettboss_event_444", "\M5* RRRRREADY^1?&* IIIIIIIT'S SHOWTIME!!!/%%");
ds_map_add(global.text_data_en, "obj_mettdestroyed_event_169", "* I..^1. I managed to open&  the lock^1!&* Are you two.../%%");
ds_map_add(global.text_data_en, "obj_mettdestroyed_event_197", "* Oh my god./%%");
ds_map_add(global.text_data_en, "obj_mettdestroyed_event_222", "* Mettaton!/");
ds_map_add(global.text_data_en, "obj_mettdestroyed_event_223", "\E1* Mettaton^1, are you.../%%");
ds_map_add(global.text_data_en, "obj_mettdestroyed_event_244", "* H..^1. hey.../");
ds_map_add(global.text_data_en, "obj_mettdestroyed_event_245", "* D..^1. don't worry&  about it.../");
ds_map_add(global.text_data_en, "obj_mettdestroyed_event_246", "* I can always.../");
ds_map_add(global.text_data_en, "obj_mettdestroyed_event_247", "\E5* I can always build&  a different robot!/");
ds_map_add(global.text_data_en, "obj_mettdestroyed_event_248", "\E6* .../");
ds_map_add(global.text_data_en, "obj_mettdestroyed_event_249", "\E5* Why don't you go&  on ahead?/%%");
ds_map_add(global.text_data_en, "obj_mettdestroyed_event_254", "* ... thank GOD^1, it's just&  the batteries./");
ds_map_add(global.text_data_en, "obj_mettdestroyed_event_255", "\E9* Mettaton^1, if you were&  gone^1, I would have..^1.&* I would have.../");
ds_map_add(global.text_data_en, "obj_mettdestroyed_event_256", "\E8* .../");
ds_map_add(global.text_data_en, "obj_mettdestroyed_event_257", "\E6* I m-mean^1, h-hey^1, it's&  n-^1no problem^1, you&  know?/");
ds_map_add(global.text_data_en, "obj_mettdestroyed_event_258", "\E5* He's just a robot^1, if&  you messed it up^1, I&  c-could always.../");
ds_map_add(global.text_data_en, "obj_mettdestroyed_event_259", "\E6* J-just build another./");
ds_map_add(global.text_data_en, "obj_mettdestroyed_event_260", "\E4* .../");
ds_map_add(global.text_data_en, "obj_mettdestroyed_event_261", "* Why don't you go&  on ahead?/%%");
ds_map_add(global.text_data_en, "obj_metteggs_58", "* (You found the eggs.)/%%");
ds_map_add(global.text_data_en, "obj_mettmilk_58", "* (You found the milk.)/%%");
ds_map_add(global.text_data_en, "obj_mettnews_artifact_117", "* Error Baby%%");
ds_map_add(global.text_data_en, "obj_mettnews_battleobj_199", "* Error./%%");
ds_map_add(global.text_data_en, "obj_mettnews_battleobj_204", "* Great job^1!&* Keep heading around the&  room!/");
ds_map_add(global.text_data_en, "obj_mettnews_battleobj_205", "* Try to go for the&  one in the bottom-&  left next!/%%");
ds_map_add(global.text_data_en, "obj_mettnews_battleobj_209", "* Great job^1!&* Keep heading around the&  room!/");
ds_map_add(global.text_data_en, "obj_mettnews_battleobj_210", "* Try to go for the&  one in the top-&  right next!/%%");
ds_map_add(global.text_data_en, "obj_mettnews_battleobj_214", "* Great job^1!&* Head to the left&  next!/%%");
ds_map_add(global.text_data_en, "obj_mettnews_battleobj_218", "* Great job^1!&* Head to the right&  next!/%%");
ds_map_add(global.text_data_en, "obj_mettnews_battleobj_223", "* You couldn't even&  get one bomb...!?/%%");
ds_map_add(global.text_data_en, "obj_mettnews_battleobj_246", "* Error,/%%");
ds_map_add(global.text_data_en, "obj_mettnews_battleobj_249", "* Great job^1!&* Head for the center^1!&* There's one left there!/%%");
ds_map_add(global.text_data_en, "obj_mettnews_battleobj_252", "* Great job^1!&* Head for the center!/");
ds_map_add(global.text_data_en, "obj_mettnews_battleobj_253", "* I'm using^1, uh^1, EM fields&  to trap the glass of&  water there!/%%");
ds_map_add(global.text_data_en, "obj_mettnews_battleobj_257", "* Great job^1!&* There's only one left&  in the bottom-right!/%%");
ds_map_add(global.text_data_en, "obj_mettnews_battleobj_261", "* Great job^1!&* There's only one left&  at the top!/%%");
ds_map_add(global.text_data_en, "obj_mettnews_battleobj_265", "* Great job^1!&* There's only one left&  at the top-right!/%%");
ds_map_add(global.text_data_en, "obj_mettnews_battleobj_269", "* Great job^1!&* There's only one left&  at the bottom-left!/%%");
ds_map_add(global.text_data_en, "obj_mettnews_battleobj_275", "* It's..^1. it's.../%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_88", "* Ring.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_89", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_mettnewsevent_90", "* Okay^1, I'm back!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_91", "\E0* A-another dark room^1,&  huh?/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_92", "\E6* Don't worry!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_93", "\E0* M-my hacking skills&  have got things&  covered!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_159", "\E3* Are you serious?/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_174", "* OHHHHHH YESSS!!!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_175", "* GOOD EVENING^1, BEAUTIES AND&  GENTLEBEAUTIES!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_176", "* THIS IS METTATON^1, REPORTING&  LIVE FROM MTT NEWS!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_177", "\M2* AN INTERESTING SITUATION HAS&  ARISEN IN EASTERN HOTLAND!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_178", "\M3* FORTUNATELY^1, OUR CORRESPONDENT&  IS OUT THERE^1, REPORTING LIVE!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_179", "\M6* BRAVE CORRESPONDENT^1!&* PLEASE FIND SOMETHING&  NEWSWORTHY TO REPORT!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_180", "\M4* OUR TEN WONDERFUL VIEWERS&  ARE WAITING FOR YOU!!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_229", "\M3* ATTENTION^1, VIEWERS^1!&* OUR CORRESPONDENT HAS&  FOUND..^1. A DOG!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_230", "\M4* (CUE AUDIENCE AWWS)/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_231", "\M3* THAT'S RIGHT^1, FOLKS^1!&* IT'S THE FEEL-GOOD&  STORY OF THE YEAR!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_232", "\M4* LOOK AT ITS LITTLE&  EARS^1, TINY PAWS^1, FLUFFY&  TAIL.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_233", "* .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_234", "* WAIT A SECOND./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_235", "\M5* THAT'S NOT A TAIL!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_236", "\M3* THAT'S.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_237", "\M5* A FUSE!!!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_264", "\M4* THAT'S RIGHT..^1.&* THAT DOG.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_265", "\M5* IS A BOMB!!!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_266", "\M5* BUT DON'T PANIC!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_267", "\M4* YOU HAVEN'T EVEN SEEN&  THE REST OF THE ROOM&  YET!!!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_283", "\M3* ATTENTION^1, VIEWERS^1!&* OUR CORRESPONDENT HAS&  FOUND..^1. A GLASS OF WATER!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_284", "\M4* BUT WHAT'S ASTONISHING&  ABOUT THIS GLASS OF&  WATER.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_285", "\M3* IS HOW UNINTERESTING IT IS!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_286", "\M4* LIKE ALL GLASSES OF WATER^1,&  IT'S COMPRISED OF WATER^1,&  GLASS^1, NITROGLYCERIN.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_287", "* .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_288", "* WAIT A SECOND./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_289", "\M5* THAT'S NOT A GLASS OF&  WATER!!!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_290", "\M3* THAT'S.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_291", "\M5* A BOMB!!!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_318", "\M5* OH NO!!^1!&* THIS NEWS REPORT.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_319", "\M5* IS TURNING INTO A DISASTER&  REPORT!!!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_320", "\M3* BUT DON'T PANIC!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_321", "\M4* YOU HAVEN'T EVEN SEEN&  THE REST OF THE ROOM&  YET!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_337", "\M3* ATTENTION^1, VIEWERS^1!&* OUR CORRESPONDENT HAS&  FOUND..^1. A MOVIE SCRIPT!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_338", "\M5* OH MY^1!&* AND IT LOOKS LIKE IT'S&  FOR MY LATEST FILM!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_339", "\M3* LET'S NOT KEEP THEM WAITING^1!&* LET'S OPEN IT UP AND GET&  THE SCOOP!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_372", "\M4* ... OH??^1?&* WHAT'S THAT INSIDE THE&  SCRIPT?/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_373", "\M4* THAT TICKING SOUND..^1.&* THAT LIT FUSE.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_374", "\M5* OH MY!!^1!&* LOOKS LIKE I WAS WRONG&  ABOUT THE MOVIE!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_375", "* WE DEFINITELY HAVE A BOX&  OFFICE BOMB ON OUR HANDS!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_376", "* AND IT'S ABOUT TO BLAST&  YOU TO BITS!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_377", "\M3* BUT DON'T GET TOO EXCITED!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_378", "\M4* YOU HAVEN'T EVEN SEEN&  THE REST OF THE ROOM&  YET!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_394", "\M3* ATTENTION^1, VIEWERS^1!&* OUR CORRESPONDENT HAS&  FOUND..^1. A BASKETBALL!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_395", "\M4* AH^1.&* BASKETBALLS./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_396", "\M3* CIRCLES OF FUN^1.&* ORBS OF JOY^1.&* SPHERES OF AMUSEMENT./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_397", "\M4* BUT YOU SHOULDN'T PLAY&  WITH THIS ONE^1.&* IT'S AN MTT-BRAND FASHIONBALL./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_398", "\M3* PROPER MAINTENANCE IS&  REQUIRED TO KEEP IT LOOKING&  GOOD./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_399", "\M3* AS YOU CAN SEE^1, EVEN EXPOSURE&  TO HUMAN BODY HEAT CAUSES&  THE PAINT TO SLOUGH OFF./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_400", "* .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_401", "* WAIT A SECOND./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_402", "* THAT'S NOT A BASKETBALL./%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_429", "\M5* THAT'S A BOMB!!!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_430", "* OH NO!!^1!&* THIS SPORT REVIEW.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_431", "* IS TURNING INTO A SHORT&  REVIEW!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_432", "* BECAUSE IT'LL BE OVER^1.&* AFTER YOU BLOW UP./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_434", "\M3* BUT DON'T GET TOO EXCITED!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_435", "\M4* YOU HAVEN'T EVEN SEEN&  THE REST OF THE ROOM&  YET!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_449", "\M3* ATTENTION^1, VIEWERS^1!&* OUR CORRESPONDENT HAS&  FOUND..^1. A PRESENT!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_450", "\M4* AND IT'S TIME FOR THE&  UNBOXING VIDEO!!!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_451", "\M5* LET'S FIND OUT WHAT'S&  INSIDE!!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_479", "\M2* THAT ROUND^1, BLACK SHAPE..^1.&* COULD IT BE???/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_480", "\M4* LOOKS LIKE CHRISTMAS CAME&  EARLY THIS YEAR./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_481", "\M5* IF SANTA GAVE PEOPLE BOMBS&  INSTEAD OF PRESENTS!!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_482", "\M2* REALLY THOUGH^1.&* A BOMB^1.&* WHAT A THOUGHTFUL GIFT./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_483", "\M4* THEY EVEN DECIDED TO&  LIGHT IT FOR YOU!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_484", "\M3* BUT DON'T GET TOO EXCITED!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_485", "\M4* YOU HAVEN'T EVEN SEEN&  THE REST OF THE ROOM&  YET!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_499", "\M3* ATTENTION^1, VIEWERS^1!&* OUR CORRESPONDENT HAS&  FOUND..^1. A VIDEO GAME!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_500", "\M4* THIS ACTION-PACKED GAME&  IS GUARANTEED TO BLOW YOU&  AWAY!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_501", "\M3* STRANGE ENEMIES^1!&* STRANGE ALLIES^1!&* ATTRACTIVE ROBOTS!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_502", "\M4* FEATURING UP TO SIX&  ARBITRARY DIALOGUE CHOICES&  AT ONCE!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_503", "\M5* CORRESPONDENT^1!&* LET'S LOOK INSIDE THE CASE!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_531", "\M4* ..^1.&* THOSE RED CYLINDERS WITH&  BURNING FUSES.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_532", "\M5* OH NO^1!&* THIS GAME LITERALLY IS&  DYNAMITE!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_533", "\M5* I GUESS THEY WERE RIGHT&  ALL ALONG!!!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_534", "\M5* VIDEO-GAMES DO CAUSE&  VIOLENCE!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_535", "\M4* OR AT LEAST THIS ONE'S&  ABOUT TO./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_536", "\M3* BUT DON'T GET TOO EXCITED!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_537", "\M4* YOU HAVEN'T EVEN SEEN&  THE REST OF THE ROOM&  YET!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_609", "* OH MY!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_610", "* IT SEEMS EVERYTHING IN THIS&  AREA IS ACTUALLY A BOMB!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_613", "* THAT DOG'S A BOMB!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_618", "* THAT PRESENT'S A BOMB!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_649", "* THAT BASKETBALL'S A BOMB!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_654", "* THAT PRESENT'S A BOMB!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_684", "* EVEN MY WORDS ARE...!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_694", "\TS ^7  %");
ds_map_add(global.text_data_en, "obj_mettnewsevent_695", " %%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_708", "\W* BRAVE CORRESPONDENT..^1.&* IF YOU DON'T DEFUSE ALL OF&  THE BOMBS.../%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_730", "\W*\M9 THIS BIG BOMB WILL BLOW&  YOU TO SMITHEREENS IN&  \YTWO MINUTES\W!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_731", "\M8* THEN YOU WON'T BE REPORTING&  \"LIVE\" ANY LONGER!/");ds_map_add(global.text_data_en, "obj_mettnewsevent_732", "* HOW TERRIBLE^1!&* HOW DISTURBING!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_733", "\M9* OUR NINE VIEWERS ARE GOING&  TO LOVE WATCHING THIS!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_734", "* GOOD LUCK^1, DARLING!!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_827", "* Ring.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_828", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_mettnewsevent_829", "* D-don't worry!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_830", "\E6* I installed a&  bomb-defusing program&  on your phone!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_831", "\W* Use the 'defuse' option&  when the bomb is in the&  \GDEFUSE ZONE\W!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_832", "\E0* N-now^1, go get 'em!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_925", "* WELL DONE^1, DARLING!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_926", "* YOU'VE DEACTIVATED ALL OF&  THE BOMBS!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_927", "\W* IF YOU DIDN'T DEACTIVATE&  THEM^1, THE BIG BOMB WOULD&  HAVE EXPLODED IN \YTWO MINUTES\W./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_928", "\W* NOW IT WON'T EXPLODE&  IN \YTWO MINUTES\W!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_929", "\W*\M9 INSTEAD IT'LL EXPLODE&  IN \YTWO SECONDS\W!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_930", "* GOODBYE^1, DARLING!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_934", "* TOO BAD^1, DARLING!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_935", "\W* YOU FAILED TO DEFUSE ALL&  OF THE BOMBS WITHIN \YTHREE&  MINUTES\W!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_936", "* NOW THE BIG BOMB IS&  GOING TO BLOW YOU TO&  SMITHEREENS!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_937", "* READY^1, VIEWERS^1?&* HERE COMES THE MOMENT&  YOU'VE ALL BEEN WAITING FOR!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_938", "* AHAHAH!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_939", "* GOODBYE^1, DARLING!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_987", "\M8* AH./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_988", "* IT SEEMS THE BOMB ISN'T&  GOING OFF./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_989", "\S-\Sp\T0* Ring...\S+/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_991", "* That's b-because!!!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_992", "* While you were&  monologuing... I...!!!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_993", "\E4* I f..^1. fix..^1.&* Um..^1. I ch-change.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_994", "\TS \F0 \E0 \TM %");
ds_map_add(global.text_data_en, "obj_mettnewsevent_995", "* OH NO^1.&* YOU DEACTIVATED THE BOMB&  WITH YOUR HACKING SKILLS./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_997", "* Yeah^1!&* That's what I did!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_998", "\TS \F0 \E0 \TM %");
ds_map_add(global.text_data_en, "obj_mettnewsevent_999", "\M9* CURSES^1!&* IT SEEMS I'VE BEEN FOILED&  AGAIN!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1000", "* CURSE YOU^1, HUMAN^1!&* CURSE YOU^1, DR. ALPHYS^1,&  FOR HELPING SO MUCH!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1001", "\M8* BUT I DON'T CURSE MY&  EIGHT WONDERFUL VIEWERS&  FOR TUNING IN!!!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1002", "* UNTIL NEXT TIME^1, DARLING!/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1017", "* W-wow..^1.&* W-we really showed&  him^1, huh?/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1018", "\E2* .../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1019", "\E4* H-hey^1, I know I was&  kind of weird at&  first.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1020", "\E0* But I really think&  I'm getting more.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1021", "\E4* Uh^1, more.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1022", "\E6* M-more confident about&  guiding you!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1023", "\E0* S-so don't worry&  about that b-big&  d-dumb robot.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1024", "\E6* I-I'll protect you&  from him!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1025", "\E3* A-and if it really&  c-came down to it^1,&  we could just t-turn.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1026", "\E5* Um^1, nevermind./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1027", "\E0* Later!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1028", "\TS \F0 \E0 \T0 %");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1029", "* (Click...)/%%");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1034", "* B-boy..^1.&* That was close^1, huh?/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1035", "\E8* I guess a little&  closer than I would&  have liked./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1036", "\E9* I should have given&  you better directions.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1037", "\E8* A-and there j-just&  w-wasn't enough&  time.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1038", "\E6* W-well^1!&* That's Mettaton's fault^1,&  not mine!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1039", "\E9* I c-can't second&  guess myself now./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1040", "\E4* I'm f-finally starting&  to f-feel confident&  about g-guiding you./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1041", "\E6* I'll protect you from&  that mean old robot^1,&  n-no matter what!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1042", "\E3* If I have to^1,&  I'll even t-turn.../");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1043", "\E5* Um^1, nevermind./");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1044", "\E0* We're over halfway&  to the core!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1045", "* Let's go!/");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1046", "\TS \F0 \E0 \T0 %");
ds_map_add(global.text_data_en, "obj_mettnewsevent_1047", "* (Click...)/%%");
ds_map_add(global.text_data_en, "obj_mettsugar_58", "* (You found the sugar.)/%%");
ds_map_add(global.text_data_en, "obj_mettwallhole_58", "* (The space behind the wall&  is only a few feet&  wide.)/%%");
ds_map_add(global.text_data_en, "obj_mettwallhole_61", "* (It's just here to complete&  the look.)/%%");
ds_map_add(global.text_data_en, "obj_microwave_98", "* (It's an unplugged microwave.)/");
ds_map_add(global.text_data_en, "obj_microwave_99", "* (All of the settings&  say \"spaghetti.\")/%%");ds_map_add(global.text_data_en, "obj_migosp_227", "FILTHY&SINGLE&MINDER..");
ds_map_add(global.text_data_en, "obj_migosp_228", "OBEY&THE&OVERMIND&..");
ds_map_add(global.text_data_en, "obj_migosp_229", "LEGION!&WE&ARE&LEGION");
ds_map_add(global.text_data_en, "obj_migosp_230", "HEED&THE&SWARM");
ds_map_add(global.text_data_en, "obj_migosp_231", "IN&UNISON,&NOW");
ds_map_add(global.text_data_en, "obj_migosp_234", "I&DON'T&CARE.");
ds_map_add(global.text_data_en, "obj_migosp_239", "Bein' me&is the&best!");
ds_map_add(global.text_data_en, "obj_migosp_240", "La la~&Just be&yourself~");
ds_map_add(global.text_data_en, "obj_migosp_241", "Nothin'&like&alone&time!");
ds_map_add(global.text_data_en, "obj_migosp_242", "Mmm, cha&cha cha!");
ds_map_add(global.text_data_en, "obj_migosp_243", "Swing&your&arms,&baby");
ds_map_add(global.text_data_en, "obj_migosp_246", "Hiya~");
ds_map_add(global.text_data_en, "obj_migosp_251", "%%%");
ds_map_add(global.text_data_en, "obj_migosp_441", "* Migosp skitters around.");
ds_map_add(global.text_data_en, "obj_migosp_442", "* Migosp is knitting its brow.");
ds_map_add(global.text_data_en, "obj_migosp_443", "* Migosp is whispering to the&  others.");
ds_map_add(global.text_data_en, "obj_migosp_444", "* It's starting to smell like&  a roach motel.");
ds_map_add(global.text_data_en, "obj_migosp_445", "* Migosp doesn't have a care&  in the world.");
ds_map_add(global.text_data_en, "obj_migosp_446", "* Migosp refuses to give&  up.");
ds_map_add(global.text_data_en, "obj_migosp_468", "* MIGOSP - ATK 7 DEF 5&* It seems evil^1, but it's&  just with the wrong crowd.../^");
ds_map_add(global.text_data_en, "obj_migospel_213", "Ha ha&hee hee&ho ho&huu huu!");
ds_map_add(global.text_data_en, "obj_migospel_214", "Honk!&HOOONK!");
ds_map_add(global.text_data_en, "obj_migospel_215", "(Mime&noises)");
ds_map_add(global.text_data_en, "obj_migospel_216", "They're&coming.");
ds_map_add(global.text_data_en, "obj_migospel_221", "I love&to&laugh!");
ds_map_add(global.text_data_en, "obj_migospel_228", "Send in&the&clowns.");
ds_map_add(global.text_data_en, "obj_migospel_229", "Everyone&has&gone.");
ds_map_add(global.text_data_en, "obj_migospel_230", "They&cannot&worry&for me.");
ds_map_add(global.text_data_en, "obj_migospel_231", "Don't&let them&see me&this way.");
ds_map_add(global.text_data_en, "obj_migospel_236", "Laughter&hides&the&pain.");
ds_map_add(global.text_data_en, "obj_migospel_241", "%%%");
ds_map_add(global.text_data_en, "obj_migospel_435", "* Migospel is juggling balls&  of ants.");
ds_map_add(global.text_data_en, "obj_migospel_436", "* Migospel makes a balloon animal&  out of bees^3.&* Shape: Pile of bees");
ds_map_add(global.text_data_en, "obj_migospel_437", "* Migospel intentionally&  pratfalls^1.&* Twenty times.");
ds_map_add(global.text_data_en, "obj_migospel_438", "* Smells like bug-flavored cotton&  candy.");
ds_map_add(global.text_data_en, "obj_migospel_439", "* Migospel's facade is broken.");
ds_map_add(global.text_data_en, "obj_migospel_440", "* Migospel's clown aura fades.");
ds_map_add(global.text_data_en, "obj_migospel_465", "* MIGOSPEL - ATK 28 DEF 17&* This messed-up clownbug thinks&  battle's a performance./^");
ds_map_add(global.text_data_en, "obj_migospel_474", "* Talking has no effect./^");
ds_map_add(global.text_data_en, "obj_mkid_actor_337", "* So^1, one time./");
ds_map_add(global.text_data_en, "obj_mkid_actor_338", "* We had a school project where&  we had to take care of&  a flower./");
ds_map_add(global.text_data_en, "obj_mkid_actor_339", "* The king ^1- we had to call him&  \"Mr. Dreemurr\" ^1- volunteered&  to donate his own flowers./");ds_map_add(global.text_data_en, "obj_mkid_actor_340", "* He ended up coming to school&  and teaching the class about&  responsibility and stuff./");
ds_map_add(global.text_data_en, "obj_mkid_actor_341", "* That got me thinking.../");
ds_map_add(global.text_data_en, "obj_mkid_actor_342", "* YO^1!&* How COOL would it be if&  UNDYNE came to school!?/");
ds_map_add(global.text_data_en, "obj_mkid_actor_343", "* She could beat up ALL&  the teachers!!/%%");
ds_map_add(global.text_data_en, "obj_mkid_battle_207", "...");
ds_map_add(global.text_data_en, "obj_mkid_battle_208", "...");
ds_map_add(global.text_data_en, "obj_mkid_battle_209", "...");
ds_map_add(global.text_data_en, "obj_mkid_battle_210", "...");
ds_map_add(global.text_data_en, "obj_mkid_battle_215", "%%%");
ds_map_add(global.text_data_en, "obj_mkid_battle_450", "* Monster Kid quivers anxiously.");
ds_map_add(global.text_data_en, "obj_mkid_battle_479", "* MONSTER KID 2 ATK 2 DEF&* Looks like free EXP./^");
ds_map_add(global.text_data_en, "obj_mkid_battle_553", "Undyne..^1.&You're..^1.&You're hurt.../%%");
ds_map_add(global.text_data_en, "obj_mkid_battle_565", "Hurt?&It's nothing./");
ds_map_add(global.text_data_en, "obj_mkid_battle_566", "Next time^1, listen&when I tell you&to leave^1, okay?/%%");
ds_map_add(global.text_data_en, "obj_mkid_battle_574", "Undyne..^1.&I.../%%");
ds_map_add(global.text_data_en, "obj_mkid_battle_584", "I'll take care of&this!/");
ds_map_add(global.text_data_en, "obj_mkid_battle_585", "Get out of here!/%%");
ds_map_add(global.text_data_en, "obj_mkid_battle_632", "... heh...&\"It's nothing\".../");ds_map_add(global.text_data_en, "obj_mkid_battle_633", "No..^1. s-somehow^1,&with just one&hit.../");
ds_map_add(global.text_data_en, "obj_mkid_battle_634", "I'm already.../");
ds_map_add(global.text_data_en, "obj_mkid_battle_635", "Already.../");
ds_map_add(global.text_data_en, "obj_mkid_battle_636", "D..^1. damn it..../%%");
ds_map_add(global.text_data_en, "obj_mkid_battle_655", "Papyrus..^1.&Alphys..^1.&ASGORE.../");
ds_map_add(global.text_data_en, "obj_mkid_battle_656", "Just like that^1,&I.../");
ds_map_add(global.text_data_en, "obj_mkid_battle_657", "I've failed you./%%");
ds_map_add(global.text_data_en, "obj_mkid_battle_689", ".../");
ds_map_add(global.text_data_en, "obj_mkid_battle_690", "No.../%%");
ds_map_add(global.text_data_en, "obj_mkid_battle_702", "My body..^1.&It feels like it's&splitting apart./");
ds_map_add(global.text_data_en, "obj_mkid_battle_703", "Like any instant..^1.&I'll scatter into&a million pieces./");
ds_map_add(global.text_data_en, "obj_mkid_battle_704", "But.../");
ds_map_add(global.text_data_en, "obj_mkid_battle_705", "Deep^1, deep in my&soul./");
ds_map_add(global.text_data_en, "obj_mkid_battle_706", "There's a burning&feeling I can't&describe./");
ds_map_add(global.text_data_en, "obj_mkid_battle_707", "\E6A burning feeling&that WON'T let me&die./");
ds_map_add(global.text_data_en, "obj_mkid_battle_708", "\E5This isn't just&about monsters&anymore^1, is it?/");
ds_map_add(global.text_data_en, "obj_mkid_battle_709", "If you get past&me^1, you'll.../");
ds_map_add(global.text_data_en, "obj_mkid_battle_710", "You'll destroy them&all^1, won't you?/");
ds_map_add(global.text_data_en, "obj_mkid_battle_711", "Monsters..^1.&Humans..^1.&Everyone.../");
ds_map_add(global.text_data_en, "obj_mkid_battle_712", "Everyone's hopes^1.&Everyone's dreams^1.&Vanquished in an&instant./");
ds_map_add(global.text_data_en, "obj_mkid_battle_713", "\E6But I WON'T let&you do that./");
ds_map_add(global.text_data_en, "obj_mkid_battle_714", "Right now^1, everyone&in the world.../");
ds_map_add(global.text_data_en, "obj_mkid_battle_715", "\E7I can feel their&hearts beating as&one./");
ds_map_add(global.text_data_en, "obj_mkid_battle_716", "And we all have&ONE goal./");
ds_map_add(global.text_data_en, "obj_mkid_battle_717", "\E8To defeat YOU./");
ds_map_add(global.text_data_en, "obj_mkid_battle_718", "\E7Human^1.&No^1, WHATEVER you&are./");
ds_map_add(global.text_data_en, "obj_mkid_battle_719", "\E8For the sake of&the whole world.../%%");
ds_map_add(global.text_data_en, "obj_mkid_battle_728", "\E9I^1, UNDYNE^1, will&strike you down!/%%");
ds_map_add(global.text_data_en, "obj_mkid_battle_827", "You're gonna have&to try a little&harder than THAT./%%");
ds_map_add(global.text_data_en, "obj_mkid_battle_883", "You.../");
ds_map_add(global.text_data_en, "obj_mkid_battle_884", "\E9You're gonna have&to try a little&harder than THAT!/%%");
ds_map_add(global.text_data_en, "obj_mkid_goner_91", "* Yo^1!&* You're a ??? too^1, right?/%%");
ds_map_add(global.text_data_en, "obj_mkid_goner_95", "* Have you ever thought about&  a world where everything is&  exactly the same.../");
ds_map_add(global.text_data_en, "obj_mkid_goner_96", "* Except you don't exist?/");
ds_map_add(global.text_data_en, "obj_mkid_goner_97", "* Everything functions&  perfectly without you.../");
ds_map_add(global.text_data_en, "obj_mkid_goner_98", "* Ha^1, ha..^1.&* The thought terrifies me./%%");
ds_map_add(global.text_data_en, "obj_mkid_goner_102", "* .../%%");
ds_map_add(global.text_data_en, "obj_mkid_goner_107", "* An umbrella...^1?&* But it's not raining./");
ds_map_add(global.text_data_en, "obj_mkid_goner_108", "* Ha^1, ha.../");
ds_map_add(global.text_data_en, "obj_mkid_goner_109", "* You know^1, that does make&  me feel a little better&  about this./");
ds_map_add(global.text_data_en, "obj_mkid_goner_110", "* Thank you./");
ds_map_add(global.text_data_en, "obj_mkid_goner_111", "* Please forget about me./%%");
ds_map_add(global.text_data_en, "obj_mkid_goner_115", "* Please don't think about&  this anymore./%%");
