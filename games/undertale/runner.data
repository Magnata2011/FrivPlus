ds_map_add(global.text_data_en, "obj_phonecall_room_236", "* Alright^1, now just&  keep heading&  up!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_237", "\E6* .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_238", "\E3* ..^1.&* That pit..^1.&* Isn't on my map./");
ds_map_add(global.text_data_en, "obj_phonecall_room_239", "\E6* Forget it^1!&* Let's try the&  left side!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_240", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_241", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_245", "* Ring.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_246", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_247", "* H-hey^1, aren't&  you gonna use&  the elevator?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_248", "\E6* I guess you can&  go this way!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_249", "\E3* .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_250", "* If there wasn't&  a huge pit in&  the way...?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_251", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_252", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_259", "* Ring.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_260", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_261", "* Wh..^1. where'd this&  pit come from?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_262", "\E8* You should be able&  to walk across&  here.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_263", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_264", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_275", "* Ring.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_276", "\TS \E6 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_277", "* Ready^1?&* This is it!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_278", "* Take the elevator&  up to the top&  of the CORE!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_279", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_280", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_290", "* Ring.../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_302", "* Ring.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_303", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_304", "* Hi^1, Alphys here!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_305", "* This room is like&  the room we saw&  before./");
ds_map_add(global.text_data_en, "obj_phonecall_room_306", "* There are two puzzles&  to the north and&  south.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_307", "* You'll have to solve&  them both to proceed!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_308", "\E2* .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_309", "\E0* A-also... I'd like&  to say!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_310", "\E3* I don't really...&* Like giving away&  puzzle solutions./");
ds_map_add(global.text_data_en, "obj_phonecall_room_311", "\E6* But if you need&  help^1, just call&  me^1, ok?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_312", "\E3* Actually^1, wait^1, I&  have an idea!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_313", "\E0* Let's be friends&  on UnderNet!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_314", "\E7* Then you can just&  ping me when you&  need help!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_315", "\E0* .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_316", "\E4* Wait^1, we're already&  friends^1, aren't we?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_317", "\E5* I signed you up^1,&  didn't I?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_318", "\E5* You've been reading&  my posts the whole&  time.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_319", "\E6* Well^1! I hope^1!&  You agree with me^1!&* About Mew Mew 2!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_320", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_321", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_353", "* Ring.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_354", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_355", "* Uh^1, h-h-hey!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_356", "\E0* I'm going to the&  bathroom^1, so I'll&  be MIA for a bit./");
ds_map_add(global.text_data_en, "obj_phonecall_room_357", "* I'm..^1. I'm sure you&  can handle this&  puzzle yourself!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_358", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_359", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_372", "* Ring.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_373", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_374", "* S-see that building in&  the distance?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_375", "\E0* That's the CORE^1.&* The source of all power&  for the underground./");
ds_map_add(global.text_data_en, "obj_phonecall_room_376", "\E6* It converts geothermal&  energy into magical&  electricity^1, by.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_377", "\E3* Uhh^1, anyway^1, that's&  where we're going to&  go./");
ds_map_add(global.text_data_en, "obj_phonecall_room_378", "\E0* In the CORE is an&  elevator directly to&  ASGORE's castle./");
ds_map_add(global.text_data_en, "obj_phonecall_room_379", "\E0* And from there..^1.&* You can go home./");
ds_map_add(global.text_data_en, "obj_phonecall_room_380", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_381", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_397", "* Ring.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_398", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_399", "* Uuuh^1, I think...&* Umm.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_400", "\E6* Hey^1!&* About the puzzles on&  the left and right...!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_401", "\E6* They're a bit difficult&  to explain^1, but.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_402", "\E4* ... uhhh^1, you already&  s-solved them?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_403", "\E5* Awesome!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_404", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_405", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_411", "* Ring.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_412", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_413", "* Alphys^1! Here!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_414", "\E6* Th-that blue laser&  seems totally&  impassable!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_415", "\E3* B-b-but!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_416", "\E6* As the Royal Scientist^1,&  I h-have some tricks&  up my sleeve!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_417", "* I'll h-hack into th-the&  Hotland laser database&  and take it out!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_418", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_419", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_423", "* Ring.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_424", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_425", "* A-another laser^1,&  huh?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_426", "\E8* I'm sorry^1, I won't&  play around this&  time./");
ds_map_add(global.text_data_en, "obj_phonecall_room_427", "\E6* Hold on a second!!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_428", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_429", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_464", "* Ring.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_465", "\TS \E6 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_466", "\E6* A-A-Alphys here!!!!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_467", "\E3* Th..^1. the northern door&  will stay locked until&  you.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_468", "* S-solve the puzzles on&  the right and left!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_469", "\E0* I..^1. I think you&  sh-should g-g-go to the&  right first!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_470", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_471", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_498", "* Ring.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_499", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_500", "* Uhh^1!&* H-hi^1, so^1, the blue&  lasers.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_501", "\E4* Uhh^1!&* I mean^1, Alphys here^1!&* Hi!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_502", "\W*\E6 The \Lblue lasers\W won't&  hurt you if you don't&  move!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_503", "\W*\E3 \OO-orange\W ones^1, um..^1.&* Y-you have to be&  moving^1, and they.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_504", "\E4* Um^1, they won't^1, um.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_505", "\E6* Move through those&  ones!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_506", "\E1* .../");
ds_map_add(global.text_data_en, "obj_phonecall_room_507", "\E5* Uhh^1, bye!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_508", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_509", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_521", "* Ring..^1. Ring.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_522", "* Click...?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_523", "* (Whoever was calling hung up&  before you answered it.)/%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_569", "* Ring.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_571", "HOWDY!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_572", "IF IT ISN'T MY&GOOD FRIEND^1,&WHO TRUSTS ME./");
ds_map_add(global.text_data_en, "obj_phonecall_room_573", "THIS IS PAPYRUS^1.&YOUR ALSO&MUTUAL FRIEND./");
ds_map_add(global.text_data_en, "obj_phonecall_room_574", "\E3ALPHYS AND I&FINISHED OUR&TRAINING EARLY./");
ds_map_add(global.text_data_en, "obj_phonecall_room_575", "\E5VERY EARLY./");
ds_map_add(global.text_data_en, "obj_phonecall_room_576", "\E3SO I SENT HER&HOME./");
ds_map_add(global.text_data_en, "obj_phonecall_room_577", "\E5VERY HOME./");
ds_map_add(global.text_data_en, "obj_phonecall_room_578", "\E3UH... NOW./");
ds_map_add(global.text_data_en, "obj_phonecall_room_579", "\E0I FEEL STRONGLY&AND FOR NO&APPARENT REASON./");
ds_map_add(global.text_data_en, "obj_phonecall_room_580", "\E3YOU SHOULD ALSO&GO..^1. THERE./");
ds_map_add(global.text_data_en, "obj_phonecall_room_581", "\E0TO HER^1.&LAB..^1. HOUSE./");
ds_map_add(global.text_data_en, "obj_phonecall_room_582", "I HAVE ONLY&GOOD FEELINGS&ABOUT THIS./");
ds_map_add(global.text_data_en, "obj_phonecall_room_583", "\E5GOODBYE./");
ds_map_add(global.text_data_en, "obj_phonecall_room_584", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_585", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_phonecall_room_593", "* Ring.../");
ds_map_add(global.text_data_en, "obj_phonecall_room_594", "\TS \E4 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_phonecall_room_595", "\E3* H..^1. hi...^1!&* It's Dr. Alphys./");
ds_map_add(global.text_data_en, "obj_phonecall_room_596", "\E0* This p-puzzle is&  kinda..^1. um..^1. timing-&  based./");
ds_map_add(global.text_data_en, "obj_phonecall_room_597", "\E3* Y-you see those&  switches over there?/");
ds_map_add(global.text_data_en, "obj_phonecall_room_598", "\E0* Y-you'll have to press&  all three of them&  within 3 seconds./");
ds_map_add(global.text_data_en, "obj_phonecall_room_599", "\E6* I'll t-try to help&  you with the&  rhythm!/");
ds_map_add(global.text_data_en, "obj_phonecall_room_600", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_phonecall_room_601", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_piano_68", "* Come on! What are you doing!/%%");
ds_map_add(global.text_data_en, "obj_playmovement_206", "* OH^1?&* THAT HUMAN.../%%");
ds_map_add(global.text_data_en, "obj_playmovement_348", "* COULD IT BE...?/%%");
ds_map_add(global.text_data_en, "obj_playmovement_375", "* ... MY ONE TRUE LOVE?/%%");
ds_map_add(global.text_data_en, "obj_playmovement_791", "* SO SAD./");
ds_map_add(global.text_data_en, "obj_playmovement_792", "* SO SAD THAT YOU ARE&  GOING TO THE DUNGEON./%%");
ds_map_add(global.text_data_en, "obj_playmovement_795", "* OOMPH!&* I AM SO OVERWHELMED WITH&  TRAGEDIES./");
ds_map_add(global.text_data_en, "obj_playmovement_796", "* THE KING HAS ORDERED YOU&  TO WASTE AWAY IN THE CASTLE&  BASEMENT./");
ds_map_add(global.text_data_en, "obj_playmovement_797", "* AND BEFORE WE EVEN HAD&  TIME TO SING A SWEET&  SONG ABOUT IT./");
ds_map_add(global.text_data_en, "obj_playmovement_798", "* MY DEAR HEART^1!&* I CAN BARELY LOOK UPON YOU^1,&  KNOWING WHAT COMES NEXT.../%%");
ds_map_add(global.text_data_en, "obj_playmovement_821", "* WELL^1, TOODLES!/%%");
ds_map_add(global.text_data_en, "obj_potheat_73", "* Hold \*D to turn up the heat!");
ds_map_add(global.text_data_en, "obj_potheat_108", "* Left^1? You fool^2!%");
ds_map_add(global.text_data_en, "obj_potheat_109", "\E6* THIS BURNER ONLY&  GOES ONE WAY!!^2!%%");
ds_map_add(global.text_data_en, "obj_potheat_132", "* Hotter^2!%%");
ds_map_add(global.text_data_en, "obj_potheat_155", "* HOTTER^1, DARNIT^2!%%");
ds_map_add(global.text_data_en, "obj_potheat_179", "* HOTTER!!!!!!^2!%%");
ds_map_add(global.text_data_en, "obj_potheat_196", "* Wait^1, that's too ^1- %%");
ds_map_add(global.text_data_en, "obj_potheat_211", "* Ugh^1, let me do it!/%%");
ds_map_add(global.text_data_en, "obj_potheat_232", "* See!^1?&* This is how you ^1-%%");
ds_map_add(global.text_data_en, "obj_potstir_64", "* Press \*Z repeatedly to stir!");
ds_map_add(global.text_data_en, "obj_potstir_81", "* Stir harder^2!%%");
ds_map_add(global.text_data_en, "obj_potstir_93", "* HARDER^2!%%");
ds_map_add(global.text_data_en, "obj_potstir_106", "* HARDER!!!^2!%%");
ds_map_add(global.text_data_en, "obj_potstir_119", "* Ugh^1, let me do it!/%%");
ds_map_add(global.text_data_en, "obj_powerlaser_event_178", "* Ring.../");
ds_map_add(global.text_data_en, "obj_powerlaser_event_179", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_powerlaser_event_180", "* M..^1. more lasers.../");
ds_map_add(global.text_data_en, "obj_powerlaser_event_181", "\E8* Okay^1, I..^1.&* I won't mess around&  this time./");
ds_map_add(global.text_data_en, "obj_powerlaser_event_182", "\E6* I'll just deactivate&  the lasers and let&  you through./");
ds_map_add(global.text_data_en, "obj_powerlaser_event_183", "\E3* .../");
ds_map_add(global.text_data_en, "obj_powerlaser_event_184", "\E3* They're..^1.&* They're not turning&  off.../");
ds_map_add(global.text_data_en, "obj_powerlaser_event_185", "\E8* I can't turn them&  off^1, I.../");
ds_map_add(global.text_data_en, "obj_powerlaser_event_186", "\E6* I-i-it's okay^1!&* I have this under&  control!/");
ds_map_add(global.text_data_en, "obj_powerlaser_event_187", "* I'm going to turn&  off the p-power for&  that whole node./");
ds_map_add(global.text_data_en, "obj_powerlaser_event_188", "* Then you can walk&  across./");
ds_map_add(global.text_data_en, "obj_powerlaser_event_189", "\E3* .../");
ds_map_add(global.text_data_en, "obj_powerlaser_event_190", "\E6* Okay^1, go!/");
ds_map_add(global.text_data_en, "obj_powerlaser_event_191", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_powerlaser_event_192", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_powerlaser_event_195", "* Ring.../");
ds_map_add(global.text_data_en, "obj_powerlaser_event_196", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_powerlaser_event_197", "* H..^1. huh?&* I..^1. I guess this&  was the right way./");
ds_map_add(global.text_data_en, "obj_powerlaser_event_198", "* M..^1. more lasers.../");
ds_map_add(global.text_data_en, "obj_powerlaser_event_199", "\E8* Okay^1, I..^1.&* I won't mess around&  this time./");
ds_map_add(global.text_data_en, "obj_powerlaser_event_200", "\E6* I'll just deactivate&  the lasers and let&  you through./");
ds_map_add(global.text_data_en, "obj_powerlaser_event_201", "\E3* .../");
ds_map_add(global.text_data_en, "obj_powerlaser_event_202", "\E3* They're..^1.&* They're not turning&  off.../");
ds_map_add(global.text_data_en, "obj_powerlaser_event_203", "\E8* I can't turn them&  off^1, I.../");
ds_map_add(global.text_data_en, "obj_powerlaser_event_204", "\E6* I-i-it's okay^1!&* I have this under&  control!/");
ds_map_add(global.text_data_en, "obj_powerlaser_event_205", "* I'm going to turn&  off the p-power for&  that whole node./");
ds_map_add(global.text_data_en, "obj_powerlaser_event_206", "* Then you can walk&  across./");
ds_map_add(global.text_data_en, "obj_powerlaser_event_207", "\E3* .../");
ds_map_add(global.text_data_en, "obj_powerlaser_event_208", "\E6* Okay^1, go!/");
ds_map_add(global.text_data_en, "obj_powerlaser_event_209", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_powerlaser_event_210", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_powerlaser_event_244", "* Ring.../");
ds_map_add(global.text_data_en, "obj_powerlaser_event_245", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_powerlaser_event_246", "* W-WAIT^1!&* STOP!/%%");
ds_map_add(global.text_data_en, "obj_powerlaser_event_264", "\E8* Th-the power..^1.&* It's turning itself&  back on./");
ds_map_add(global.text_data_en, "obj_powerlaser_event_265", "\E9* D-damn it..^1.&* Th-this isn't supposed&  to.../");
ds_map_add(global.text_data_en, "obj_powerlaser_event_266", "* I.../");
ds_map_add(global.text_data_en, "obj_powerlaser_event_267", "\E3* I'm gonna turn&  it off again./");
ds_map_add(global.text_data_en, "obj_powerlaser_event_268", "* When it turns off^1,&  move a little^1, and&  then STOP./");
ds_map_add(global.text_data_en, "obj_powerlaser_event_269", "\E8* OK^1?&* Y-you won't get&  h-h-hurt./");
ds_map_add(global.text_data_en, "obj_powerlaser_event_270", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_powerlaser_event_271", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_powerlaser_event_304", "* Ring.../");
ds_map_add(global.text_data_en, "obj_powerlaser_event_305", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_powerlaser_event_306", "* Oh my god^1, are&  you okay!?/");
ds_map_add(global.text_data_en, "obj_powerlaser_event_307", "\E8* I-I c-couldn't keep&  the power off&  long enough.../");
ds_map_add(global.text_data_en, "obj_powerlaser_event_308", "\E6* No^1, no^1, we've&  got this^1, it's just&  a little further!/");
ds_map_add(global.text_data_en, "obj_powerlaser_event_309", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_powerlaser_event_310", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_powerlaser_event_341", "* Ring.../");
ds_map_add(global.text_data_en, "obj_powerlaser_event_342", "\TS \E6 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_powerlaser_event_343", "* S-see^1?&* I've got everything&  under control./");
ds_map_add(global.text_data_en, "obj_powerlaser_event_344", "* Everything's under&  control!/");
ds_map_add(global.text_data_en, "obj_powerlaser_event_345", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_powerlaser_event_346", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_precore_event_117", "* Ring.../");
ds_map_add(global.text_data_en, "obj_precore_event_118", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_precore_event_119", "* Huh^1?&* Who are they?/");
ds_map_add(global.text_data_en, "obj_precore_event_120", "* N-nobody else is&  s-supposed to be&  here.../");
ds_map_add(global.text_data_en, "obj_precore_event_121", "\E6* Oh well^1!&* We can't worry&  about that now!/");
ds_map_add(global.text_data_en, "obj_precore_event_122", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_precore_event_123", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_purpledude_111", "* Ahhh..^1.&* No umbrellas allowed!/%%");
ds_map_add(global.text_data_en, "obj_purpledude_249", "* Thanks for stepping on&  my face^1.&* Here's the 3 gold./");
ds_map_add(global.text_data_en, "obj_purpledude_250", "* (You got 3 gold.)/%%");
ds_map_add(global.text_data_en, "obj_puzzlehater_76", "* Bahh!!^1!&* Nevermind!!/%%");
ds_map_add(global.text_data_en, "obj_puzzlehater_80", "* So^1?&* What are you waiting for!?/%%");
ds_map_add(global.text_data_en, "obj_puzzlehater_85", "* Bah^1! Today's monsters don't&  appreciate what makes&  puzzles great!/");
ds_map_add(global.text_data_en, "obj_puzzlehater_86", "* Nowadays \"puzzles\" are nothing&  but lasers and moving rocks.../");ds_map_add(global.text_data_en, "obj_puzzlehater_87", "* Bahh!!!/");
ds_map_add(global.text_data_en, "obj_puzzlehater_88", "* There's no ART in that&  actiony^1, mindless schlock^1!&* It's just timing-based drivel!/");
ds_map_add(global.text_data_en, "obj_puzzlehater_89", "* Give me something that&  challenges the deepest&  reaches of my mind.../");
ds_map_add(global.text_data_en, "obj_puzzlehater_90", "* You^1!&* You're young^1!&* You've still got hope!/");
ds_map_add(global.text_data_en, "obj_puzzlehater_91", "* Geh heh heh...^1!&* Here..^1. try solving this&  block-pushing puzzle!/%%");
ds_map_add(global.text_data_en, "obj_puzzlehater_97", "* Geh^1?&* Who are you?/");
ds_map_add(global.text_data_en, "obj_puzzlehater_98", "* Freedom^1? What^1? Bah^1!&* You're pullin' my leg!/%%");
ds_map_add(global.text_data_en, "obj_puzzlehater_102", "* You again!^1?&* Bah^1! I don't care about&  going free!/");
ds_map_add(global.text_data_en, "obj_puzzlehater_103", "* .../");
ds_map_add(global.text_data_en, "obj_puzzlehater_104", "* Do you think humans could&  appreciate the details&  of classic puzzles...?/%%");
ds_map_add(global.text_data_en, "obj_puzzlehaterbox_78", "* (It's a box.^1)&* (Presumably to be pushed.)/%%");
ds_map_add(global.text_data_en, "obj_puzzlehaterbox_84", "* Bah!/%%");
ds_map_add(global.text_data_en, "obj_puzzlehaterbox_91", "* What...^1?&* WHAT are you doing!^1?&* You're pushing it ALL WRONG!/");
ds_map_add(global.text_data_en, "obj_puzzlehaterbox_92", "* Bah^1, forget it^1!&* This generation is REALLY&  hopeless!/%%");
ds_map_add(global.text_data_en, "obj_puzzlewall1_62", "COME ON!&DON'T BE SO&RUDE!!!/");
ds_map_add(global.text_data_en, "obj_puzzlewall1_63", "I SET UP&THIS PUZZLE&JUST FOR YOU!/%%");
ds_map_add(global.text_data_en, "obj_puzzlewall1_66", "\E3DO YOU TREAT&YOUR MOTHER&THIS WAY.../");
ds_map_add(global.text_data_en, "obj_puzzlewall1_67", "WHEN SHE MAKES&YOU A PUZZLE&?!?!?/%%");
ds_map_add(global.text_data_en, "obj_puzzlewall1_71", "\E3HUMANS.../%%");
ds_map_add(global.text_data_en, "obj_puzzlewall2_62", "SANS!!!^1!&THE HUMAN IS&ESCAPING!!!/");
ds_map_add(global.text_data_en, "obj_puzzlewall2_63", "YOU MADE THE&PUZZLE TOO&HARD!!/");
ds_map_add(global.text_data_en, "obj_puzzlewall2_64", "HEY YOU!!^1!&GET BACK HERE!/%%");
ds_map_add(global.text_data_en, "obj_pyrope_266", "Hot!!!&Error.");
ds_map_add(global.text_data_en, "obj_pyrope_270", "Burn,&baby,&BURN!");
ds_map_add(global.text_data_en, "obj_pyrope_271", "Hot&enough&for&ya!?");
ds_map_add(global.text_data_en, "obj_pyrope_272", "Feel&the&heat.");
ds_map_add(global.text_data_en, "obj_pyrope_273", "Is it&cold in&here?");
ds_map_add(global.text_data_en, "obj_pyrope_280", "Hot!!&HOT!!&Hotter!&HOTTER!!");
ds_map_add(global.text_data_en, "obj_pyrope_285", "BRRRR!&What's&the&deal!?");
ds_map_add(global.text_data_en, "obj_pyrope_289", "Sorry!!&I'm all&tied&up!!");
ds_map_add(global.text_data_en, "obj_pyrope_294", "%%%");
ds_map_add(global.text_data_en, "obj_pyrope_492", "* Pyrope is protected by its&  winsome smile.");
ds_map_add(global.text_data_en, "obj_pyrope_493", "* Pyrope is pretending to&  pull the fire alarm.");
ds_map_add(global.text_data_en, "obj_pyrope_494", "* Pyrope is chuckling through&  its teeth.");
ds_map_add(global.text_data_en, "obj_pyrope_495", "* Pyrope is pretending to be&  a candle.");
ds_map_add(global.text_data_en, "obj_pyrope_496", "* Smells like rope burn.");
ds_map_add(global.text_data_en, "obj_pyrope_497", "* Pyrope wants more heat.");
ds_map_add(global.text_data_en, "obj_pyrope_498", "* The room is sweltering!");
ds_map_add(global.text_data_en, "obj_pyrope_524", "* PYROPE - ATK 29 DEF 14&* This mischievous monster&  is never warm enough./^");
ds_map_add(global.text_data_en, "obj_pyrope_534", "* You blow on Pyrope.&* Its flames die down.&* Pyrope's ATTACK dropped!/^");
ds_map_add(global.text_data_en, "obj_pyrope_555", "* You crank up the thermostat.&* Pyrope begins to get&  excited./^");
ds_map_add(global.text_data_en, "obj_pyrope_556", "* You crank up the thermostat.&* It's super hot!&* Pyrope looks satisfied./^");
ds_map_add(global.text_data_en, "obj_pyrope_557", "* You crank up the thermostat.&* It's SOOOO hot!/^");
ds_map_add(global.text_data_en, "obj_pyrope_571", "* You invite Pyrope to hang&  out./^");
ds_map_add(global.text_data_en, "obj_pyropenpc_72", "* Haha^1, ha ha ha^1.&* Secret^1, secret^1.&* I've done up a trouble./");
ds_map_add(global.text_data_en, "obj_pyropenpc_73", "* I set the lava on fire./");
ds_map_add(global.text_data_en, "obj_pyropenpc_74", "* No one will EVER know^1.&* It's the perfect crime.../%%");
ds_map_add(global.text_data_en, "obj_pyropenpc_78", "* Haha^1, ha ha ha^1.&* If we leave^1, no one will&  REALLY ever know!!/%%");
ds_map_add(global.text_data_en, "obj_pyropenpc_82", "* The lava's so spicey now./%%");
ds_map_add(global.text_data_en, "obj_pyropenpc_87", "* Haha^1, ha ha ha^1.&* Ya wanna \"hang\" out?/");ds_map_add(global.text_data_en, "obj_pyropenpc_88", "* Haha^1, ha ha ha^1.&* Sorry^1, I'm all TIED UP!!!/");
ds_map_add(global.text_data_en, "obj_pyropenpc_89", "* Psyche^1! Owned^1!&* No one wants to be MY&  friend!!!/%%");
ds_map_add(global.text_data_en, "obj_pyropenpc_93", "* Haha^1, ha ha ha^1.&* Wonder if any humans would&  wanna be my friend./");
ds_map_add(global.text_data_en, "obj_pyropenpc_94", "* PSYYYYCHE^1!&* That'd NEVER happen!/%%");
ds_map_add(global.text_data_en, "obj_pyropenpc_97", "* I'm too spicey to have&  any friends./%%");
ds_map_add(global.text_data_en, "obj_questionasker_119", "ERROR? %%");
ds_map_add(global.text_data_en, "obj_questionasker_130", "HAHAHA, YOU WISH!&WRONG!");
ds_map_add(global.text_data_en, "obj_questionasker_132", "WRONG! IF ONLY ALPHYS&COULD HELP!");
ds_map_add(global.text_data_en, "obj_questionasker_134", "NOPE! TOO BAD ALPHYS&CAN'T HELP!");
ds_map_add(global.text_data_en, "obj_questionasker_136", "WRONG!!! WRONG!!!&WROOOOOOOONG!!");
ds_map_add(global.text_data_en, "obj_questionasker_138", "COMPLETELY UTTERLY&WRONG!!!!!!");
ds_map_add(global.text_data_en, "obj_questionasker_140", "BOY, THAT'S&EMBARRASSING, HUH?");
ds_map_add(global.text_data_en, "obj_questionasker_142", "TIME'S UP!&GUESS THAT'S A NO?? ");
ds_map_add(global.text_data_en, "obj_questionasker_144", "NO NO NO!&CAN'T YOU READ!?");
ds_map_add(global.text_data_en, "obj_questionasker_151", "RIGHT! SOUNDS LIKE&YOU GET IT!");
ds_map_add(global.text_data_en, "obj_questionasker_153", "CORRECT! WHAT A&TERRIFIC ANSWER!");
ds_map_add(global.text_data_en, "obj_questionasker_155", "TOO EASY FOR&YOU, HUH??????????");
ds_map_add(global.text_data_en, "obj_questionasker_157", "WONDERFUL! I'M&ASTOUNDED, FOLKS!");
ds_map_add(global.text_data_en, "obj_questionasker_159", "CORRECT! YOU'RE SO&LUCKY TODAY!!!");
ds_map_add(global.text_data_en, "obj_questionasker_161", "I'M SO FLATTERED YOU&REMEMBERED!");
ds_map_add(global.text_data_en, "obj_questionasker_163", "GREAT ANSWER!&I LOVE IT!!!!!!!");
ds_map_add(global.text_data_en, "obj_questionasker_165", "OF COURSE THAT&WAS EASY FOR YOU!");
ds_map_add(global.text_data_en, "obj_questionasker_176", "* The quiz show continues.");
ds_map_add(global.text_data_en, "obj_questionasker_538", "OH^1! OH^1! I KNOW&THIS ONE!!!&IT'S SNAIL ICE&CREAM!!!!!!!^1!%");
ds_map_add(global.text_data_en, "obj_questionasker_539", "IN THE FOURTH&CHAPTER EVERYONE&GOES TO THE&BEACH!!!%");
ds_map_add(global.text_data_en, "obj_questionasker_540", "AND SHE BUYS&ICE CREAM FOR&ALL OF HER&FRIENDS!!!!%");
ds_map_add(global.text_data_en, "obj_questionasker_541", "BUT IT'S SNAIL&FLAVOR AND SHE'S&THE ONLY ONE&WHO WANTS IT!!!!!!%");
ds_map_add(global.text_data_en, "obj_questionasker_542", "IT'S ONE OF MY&FAVORITE PARTS&OF THE GAME&BECAUSE%");
ds_map_add(global.text_data_en, "obj_questionasker_543", "IT'S ACTUALLY A&VERY POWERFUL&message abou^1t&friendshi^1p and..^2.%%");
ds_map_add(global.text_data_en, "obj_questionasker_566", "ALPHYS^1,&ALPHYS^1,&ALPHYS./");
ds_map_add(global.text_data_en, "obj_questionasker_567", "YOU AREN'T HELPING&OUR CONTESTANT,&ARE YOU?/");
ds_map_add(global.text_data_en, "obj_questionasker_568", "OOOOOOH!!!&YOU SHOULD HAVE&TOLD ME./");
ds_map_add(global.text_data_en, "obj_questionasker_569", "I'LL ASK A&QUESTION.../");
ds_map_add(global.text_data_en, "obj_questionasker_570", "YOU'LL BE SURE&TO KNOW THE&ANSWER TO!/%%");
ds_map_add(global.text_data_en, "obj_questionasker_598", "ALPHYS^1, ALPHYS^1,&ALPHYS./");
ds_map_add(global.text_data_en, "obj_questionasker_599", "YOU AREN'T HELPING&OUR CONTESTANT,&ARE YOU?/");
ds_map_add(global.text_data_en, "obj_questionasker_600", "OOOOOOH!!!&YOU SHOULD HAVE&TOLD ME./");
ds_map_add(global.text_data_en, "obj_questionasker_601", "I'LL ASK A&QUESTION.../");
ds_map_add(global.text_data_en, "obj_questionasker_602", "YOU'LL BE SURE&TO KNOW THE&ANSWER TO!/%%");
ds_map_add(global.text_data_en, "obj_questionasker_607", "SEE, ALPHYS?&I TOLD YOU IT&WAS OBVIOUS./");
ds_map_add(global.text_data_en, "obj_questionasker_608", "EVEN THE HUMAN&FIGURED IT OUT./");
ds_map_add(global.text_data_en, "obj_questionasker_609", "YES, SHE SCRAWLS&HER NAME IN THE&MARGINS OF HER&NOTES./");
ds_map_add(global.text_data_en, "obj_questionasker_610", "SHE NAMES PROGRAMMING&VARIABLES AFTER&HER./");
ds_map_add(global.text_data_en, "obj_questionasker_613", "SHE EVEN WRITES&STORIES OF THEM&TOGETHER.../");
ds_map_add(global.text_data_en, "obj_questionasker_614", "SHARING A DOMESTIC&LIFE./");
ds_map_add(global.text_data_en, "obj_questionasker_615", "PROBABILITY OF&CRUSH:&101 PERCENT./");
ds_map_add(global.text_data_en, "obj_questionasker_616", "MARGIN OF ERROR.&ONE PERCENT./%%");
ds_map_add(global.text_data_en, "obj_questionasker_624", "WHY WOULD SOMEONE&OUTFIT AN&AMUSEMENT ROBOT.../");
ds_map_add(global.text_data_en, "obj_questionasker_625", "WITH BRUTAL COMBAT&CAPABILITIES?/");
ds_map_add(global.text_data_en, "obj_questionasker_626", "SIMPLE./");
ds_map_add(global.text_data_en, "obj_questionasker_627", "TO IMPRESS MR.&ASGORE DREEMURR,&OF COURSE!/");
ds_map_add(global.text_data_en, "obj_questionasker_628", "OR AS ALPHYS&CALLS HIM.../");
ds_map_add(global.text_data_en, "obj_questionasker_629", "\"MR. DREAMY.\"/");ds_map_add(global.text_data_en, "obj_questionasker_630", "THOSE STRONG ARMS.../");
ds_map_add(global.text_data_en, "obj_questionasker_631", "THAT LUSTROUS&BEARD.../");
ds_map_add(global.text_data_en, "obj_questionasker_632", "LIKE ALL THOSE WHO&CREATE WEAPONS./");
ds_map_add(global.text_data_en, "obj_questionasker_633", "SHE CRAVES THE&TENDER EMBRACE OF&A BURLY MAN./");
ds_map_add(global.text_data_en, "obj_questionasker_634", "CAN SHE TRULY&BE BLAMED?/%%");
ds_map_add(global.text_data_en, "obj_questionasker_642", "... SERIOUSLY?/");
ds_map_add(global.text_data_en, "obj_questionasker_643", "MY MY..^1.&HOW CONCEITED CAN&YOU GET...?/");
ds_map_add(global.text_data_en, "obj_questionasker_644", "I LOVE IT!/");
ds_map_add(global.text_data_en, "obj_questionasker_645", "AND WHILE YOU ARE&COMPLETELY WRONG^1,&YOU DESERVE SOME&CREDIT./");
ds_map_add(global.text_data_en, "obj_questionasker_646", "I'VE SEEN HER WATCH&YOU ON HER COMPUTER&SCREEN./");
ds_map_add(global.text_data_en, "obj_questionasker_647", "SMILING WHEN YOU&SUCCEED./");
ds_map_add(global.text_data_en, "obj_questionasker_648", "SHRIEKING WHEN YOU&FAIL./");
ds_map_add(global.text_data_en, "obj_questionasker_649", "AND ALWAYS, ALWAYS,&WHISPERING.../");
ds_map_add(global.text_data_en, "obj_questionasker_650", "\"NO! WRONG!&YOU HAVE TO&GO THAT WAY!\"/");ds_map_add(global.text_data_en, "obj_questionasker_651", "IN ITS OWN WAY^1,&IS THIS NOT&LOVE??/%%");
ds_map_add(global.text_data_en, "obj_questionasker_657", "CORRECT./");
ds_map_add(global.text_data_en, "obj_questionasker_658", "DR. ALPHYS HAS&A CRUSH ON.../");
ds_map_add(global.text_data_en, "obj_questionasker_659", "THE UNKNOWABLE./");
ds_map_add(global.text_data_en, "obj_questionasker_660", "YOU SEE, ALPHYS&BELIEVES THERE IS&SOMEONE OUT THERE./");
ds_map_add(global.text_data_en, "obj_questionasker_661", "SOMEONE WATCHING HER./");
ds_map_add(global.text_data_en, "obj_questionasker_662", "SOMEONE SHE THINKS&IS \"CUTE\" AND&\"INTERESTING.\"/");ds_map_add(global.text_data_en, "obj_questionasker_663", "HELLO, THEORETICAL&PERSON./");
ds_map_add(global.text_data_en, "obj_questionasker_664", "DR. ALPHYS LIKES&YOU./");
ds_map_add(global.text_data_en, "obj_questionasker_665", "TOO BAD YOU&ARE NOT REAL./");
ds_map_add(global.text_data_en, "obj_questionasker_666", "*DERISIVE&LAUGHTRACK*/%%");
ds_map_add(global.text_data_en, "obj_questionasker_691", "H-hey^1, I've done&research about this!/");
ds_map_add(global.text_data_en, "obj_questionasker_692", "There are alternate&universes out there!/");
ds_map_add(global.text_data_en, "obj_questionasker_693", "S-someday^1, maybe^1, I&could meet them.../%%");
ds_map_add(global.text_data_en, "obj_questionasker_704", "YOU SAID THE&EXACT SAME THING&ABOUT \"MEW MEW&KISSY CUTIE.\"/");ds_map_add(global.text_data_en, "obj_questionasker_705", "BUT I'LL GIVE YOU&THE BENEFIT OF&THE DOUBT./");
ds_map_add(global.text_data_en, "obj_questionasker_706", "PERSON^1, IF YOU'RE&OUT THERE.../");
ds_map_add(global.text_data_en, "obj_questionasker_707", "HOW ABOUT GIVING US&A SIGN^1, RIGHT NOW?/%%");
ds_map_add(global.text_data_en, "obj_questionasker_725", "THAT SETTLES&THAT, DOESN'T IT?/%%");
ds_map_add(global.text_data_en, "obj_questionasker_745", "WELL WELL WELL./");
ds_map_add(global.text_data_en, "obj_questionasker_746", "WITH DR. ALPHYS&HELPING YOU.../");
ds_map_add(global.text_data_en, "obj_questionasker_747", "THE SHOW HAS NO&DRAMATIC TENSION!/");
ds_map_add(global.text_data_en, "obj_questionasker_748", "WE CAN'T GO ON&LIKE THIS!!/");
ds_map_add(global.text_data_en, "obj_questionasker_749", "BUT./");
ds_map_add(global.text_data_en, "obj_questionasker_750", "BUT!!!/");
ds_map_add(global.text_data_en, "obj_questionasker_751", "THIS WAS JUST THE&PILOT EPISODE!!/");
ds_map_add(global.text_data_en, "obj_questionasker_752", "NEXT UP, MORE&DRAMA!/");
ds_map_add(global.text_data_en, "obj_questionasker_753", "MORE ROMANCE!!!/");
ds_map_add(global.text_data_en, "obj_questionasker_754", "MORE BLOODSHED!!!/");
ds_map_add(global.text_data_en, "obj_questionasker_755", "UNTIL NEXT TIME,&DARLINGS...!!!/%%");
ds_map_add(global.text_data_en, "obj_readable_modernbook_59", "%%");
ds_map_add(global.text_data_en, "obj_readable_modernbook_60", "* (Here I am..^1.&* Writing this book.)/");
ds_map_add(global.text_data_en, "obj_readable_modernbook_61", "* (A person comes in and picks&  up the book...)/");
ds_map_add(global.text_data_en, "obj_readable_modernbook_62", "* (They start reading it...!)/");
ds_map_add(global.text_data_en, "obj_readable_modernbook_63", "* Oh^1, sorry^1.&* I'm still writing that one./%%");
ds_map_add(global.text_data_en, "obj_readable_modernbook_68", "* (Some unfinished book.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_64", "%%");
ds_map_add(global.text_data_en, "obj_readable_room1_65", "* Only the fearless may proceed.&* Brave ones, foolish ones.&* Both walk not the middle road./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_66", "* Stay on the path./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_67", "* The western room is the&  eastern room's blueprint./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_68", "* Three out of four grey rocks&  recommend you push them./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_69", "* (There's an ant-sized frog in&  a crack in the wall...^1)&* (It waves at you.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_69_console_1", "* (There's a small crack in the&  wall here.)/");
ds_map_add(global.text_data_en, "obj_readable_room1_69_console_2", "* (There's a frog inside...^2)&* (Wait^1! There are two!)/");
ds_map_add(global.text_data_en, "obj_readable_room1_69_console_3", "* (You had a wonderful,&  exclusive experience...)/");
ds_map_add(global.text_data_en, "obj_readable_room1_69_console_4", "* (... that only someone who&  saw two frogs could feel.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_70", "* There is just one switch./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_71", "* The far door is not an exit^1.&* It simply marks a rotation&  in perspective./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_72", "* If you can read this^1,&  press the blue switch./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_73", "* If you can read this^1,&  press the red switch./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_74", "* If you can read this^1,&  press the green switch./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_75", "* These books are worn...&* They must have been read&  many times./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_78", "* (There's an old calendar from&  the end of 201X.^1)&* (A date is circled on it.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_79", "\R* (The date I came here.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_81", "* The ends of the tools have&  been filed down to&  make them safer./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_82", "* Seems like gardening tools./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_83", "* Look at these cool toys^2!&* They don't interest you&  at all./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_84", "* (Dusty toys.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_86", "* Throne Room/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_90", "* (It's a coffin.^1)&* (There's a name engraved on&  it.)/");
ds_map_add(global.text_data_en, "obj_readable_room1_91", "* (\"\[C].\")/");ds_map_add(global.text_data_en, "obj_readable_room1_92", "* (It's empty.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_96", "* (The coffin is empty...?)/");
ds_map_add(global.text_data_en, "obj_readable_room1_97", "* (You didn't notice before^1,&  but there's something like...)/");
ds_map_add(global.text_data_en, "obj_readable_room1_98", "* (... mummy wrappings at the&  bottom of it.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_103", "\R* (It's as comfortable as it&  looks.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_112", "* You peek inside..^2.&* Scandalous!/");
ds_map_add(global.text_data_en, "obj_readable_room1_113", "* It's TORIEL's sock&  collection./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_114", "* You can't stop looking&  at the socks./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_118", "* (You came all the way&  back here to look at&  Toriel's socks.)/");
ds_map_add(global.text_data_en, "obj_readable_room1_119", "* (You have great priorities&  in life.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_125", "* It's a clothes drawer^1.&* There are robes^1, button-up&  shirts.../");
ds_map_add(global.text_data_en, "obj_readable_room1_126", "* ... and a pink^1, hand-knit&  sweater that says&  \"Mr. Dad Guy.\"/%%");ds_map_add(global.text_data_en, "obj_readable_room1_130", "\R* Still has that sweater./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_134", "* (It's just a chair.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_139", "* (It's a throne.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_142", "* \"Room under renovations.\"/%%");ds_map_add(global.text_data_en, "obj_readable_room1_143", "* \"Room under renovations.\"/%%");ds_map_add(global.text_data_en, "obj_readable_room1_144", "* For some reason^1, there&  is a brand-name chocolate&  bar in the fridge./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_147", "* (The fridge is full of&  unopened containers of&  snails.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_151", "\R* No chocolate./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_154", "* ...!^1?&* There's a camera hidden&  in the bushes./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_155", "* (His.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_158", "* There's a switch hidden&  in the snow^1.&* Click!/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_159", "* The switch is stuck now./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_162", "* There's a switch here^1.&* It's been depressed with&  vines./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_164", "* On the floor inside is&  a box of pomeraisins./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_198", "* (It's a school report about&  monster funerals.)/");
ds_map_add(global.text_data_en, "obj_readable_room1_199", "* Monster funerals^1, technically&  speaking^2, are cool as heck./");
ds_map_add(global.text_data_en, "obj_readable_room1_200", "* When monsters get old and&  kick the bucket^1, they turn&  into dust./");
ds_map_add(global.text_data_en, "obj_readable_room1_201", "* At funerals^1, we take that&  dust and spread it on that&  person's favorite thing./");
ds_map_add(global.text_data_en, "obj_readable_room1_202", "* Then their essence will live&  on in that thing.../");
ds_map_add(global.text_data_en, "obj_readable_room1_203", "* Uhhh^1, am I at the page&  minimum yet^1?&* I'm kinda sick of writing this./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_208", "\W* Mom says that sleeping&  can recover your health&  \Yabove your maximum HP\W./");
ds_map_add(global.text_data_en, "obj_readable_room1_209", "* ... what's maximum HP?/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_213", "* Mom says that we can&  go to the surface world&  now!/");
ds_map_add(global.text_data_en, "obj_readable_room1_214", "* ... what's so great about&  that^1, anyway^1?&* I don't wanna move./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_219", "* (It's merely a decoy.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_228", "* \"The power to take their&  SOULs.\"/");ds_map_add(global.text_data_en, "obj_readable_room1_229", "* \"This is the power that&  the humans feared.\"/%%");ds_map_add(global.text_data_en, "obj_readable_room1_235", "* (Ancient writing covers the&  walls..^1. you can just make&  out the words.)/");
ds_map_add(global.text_data_en, "obj_readable_room1_236", "* \"The War of Humans and&  Monsters.\"/%%");ds_map_add(global.text_data_en, "obj_readable_room1_241", "* The northern room hides a&  great treasure./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_247", "* Hurt, beaten, and fearful for&  our lives, we surrendered&  to the humans./");
ds_map_add(global.text_data_en, "obj_readable_room1_248", "* Seven of their greatest&  magicians sealed us underground&  with a magic spell./");
ds_map_add(global.text_data_en, "obj_readable_room1_249", "* Anything can enter through the&  seal, but only beings with a&  powerful SOUL can leave./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_256", "* However...&* There is a prophecy./");
ds_map_add(global.text_data_en, "obj_readable_room1_257", "* The Angel...&* The One Who Has Seen The&  Surface.../");
ds_map_add(global.text_data_en, "obj_readable_room1_258", "* They will return.&* And the underground will go&  empty./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_263", "* The ancient glyphs have been&  painted over with a list of&  21 different flavors./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_269", "* Achoo^1!&* Tried to catch a bug^1, but&  I just caught a cold.../%%");
ds_map_add(global.text_data_en, "obj_readable_room1_274", "* The humans, afraid of our&  power^1, declared war on us./");
ds_map_add(global.text_data_en, "obj_readable_room1_275", "* They attacked suddenly, and&  without mercy./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_280", "* Without candles or magic to&  guide them Home^1, the monsters&  used crystals to navigate./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_292", "* (It's a beat-up figurine&  of a female human with&  cat ears.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_293", "* (It's too dark to see&  near the walls.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_299", "* (Scientific books.^1)&* (They seem very dusty.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_304", "* (It's a fridge.^1)&* (It's strangely warm.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_306", "* (It's too dark to see&  near the walls.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_312", "* MILK^1? EGGS^1? IN THE FRIDGE?/");
ds_map_add(global.text_data_en, "obj_readable_room1_313", "* NO WAY^1, DARLING^1!&* THEY'D GET COLD!!!/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_320", "* Ring.../");
ds_map_add(global.text_data_en, "obj_readable_room1_321", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_readable_room1_322", "* Um^1, is it really&  a good idea to be&  getting a snack?/");
ds_map_add(global.text_data_en, "obj_readable_room1_323", "\E8* Well^1, I guess I&  really shouldn't&  judge you.../");
ds_map_add(global.text_data_en, "obj_readable_room1_324", "\E0* After all^1, I'm the&  one eating potato&  chips in my PJs!/");
ds_map_add(global.text_data_en, "obj_readable_room1_325", "\E5* Uhhh^1, I mean..^1.&* H-hey^1, go over to&  the right!/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_328", "* Ring.../");
ds_map_add(global.text_data_en, "obj_readable_room1_329", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_readable_room1_330", "* H-hey^1!&* Head over to the&  right!/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_347", "* I hate cold food./");
ds_map_add(global.text_data_en, "obj_readable_room1_349", "\E0* So Alphys fixed up&  my fridge so it&  heats up food instead!/");
ds_map_add(global.text_data_en, "obj_readable_room1_350", "\E6* Hot Fridge..^1.&* The world's greatest&  invention!/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_354", "\E6* Hot Fridge..^1.&* The world's greatest&  invention!/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_360", "* This oven is some&  top-of-the-line&  MTT thing./");
ds_map_add(global.text_data_en, "obj_readable_room1_361", "\E4* But^1, y'know^1, as much&  as technology&  advances.../");
ds_map_add(global.text_data_en, "obj_readable_room1_362", "\E0* Nothing beats food&  home-cooked with&  fire magic./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_369", "* (It looks like some sort of&  powerful bracelet...)/");
ds_map_add(global.text_data_en, "obj_readable_room1_370", "* (Wait.^1)&* (It's just a croissant...)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_375", "* (It's just a regular wall.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_380", "* (East...)&* (The End.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_385", "* (Solve this puzzle,&  and The End will open.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_390", "* (Traverse the northern&  room^1, and The End will&  open.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_395", "* (I cannot fight.)&* (I cannot think.)/");
ds_map_add(global.text_data_en, "obj_readable_room1_396", "* (But^1, with patience^1,&  I will make my way&  through.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_401", "* (Get lost...)&* (And stay that way.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_406", "* (Why not relax and have&  a nice snack?)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_416", "* (It's completely trashed.^1)&* (There's no way it could&  ever be repaired.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_419", "* (It's out of batteries.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_425", "* ENTRY NUMBER 1/");
ds_map_add(global.text_data_en, "obj_readable_room1_426", "* This is it..^1.&* Time to do what the King&  has asked me to do./");
ds_map_add(global.text_data_en, "obj_readable_room1_427", "* I will create the power to&  free us all./");
ds_map_add(global.text_data_en, "obj_readable_room1_428", "* I will unleash the power of&  the SOUL./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_430", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_435", "* POWER ROOM/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_436", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_441", "* ENTRY NUMBER 6/");
ds_map_add(global.text_data_en, "obj_readable_room1_442", "* ASGORE asked everyone&  outside the city for monsters&  that had \"fallen down.\"/");ds_map_add(global.text_data_en, "obj_readable_room1_443", "* Their bodies came in today./");
ds_map_add(global.text_data_en, "obj_readable_room1_444", "* They're still comatose..^1.&* And soon^1, they'll all&  turn into dust./");
ds_map_add(global.text_data_en, "obj_readable_room1_445", "* But what happens if I&  inject \"determination\" into&  them?/");ds_map_add(global.text_data_en, "obj_readable_room1_446", "* If their SOULS persist&  after they perish^1, then.../");
ds_map_add(global.text_data_en, "obj_readable_room1_447", "* Freedom might be closer&  than we all thought./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_449", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_454", "* ENTRY NUMBER 9/");
ds_map_add(global.text_data_en, "obj_readable_room1_455", "* things aren't going well./");
ds_map_add(global.text_data_en, "obj_readable_room1_456", "* none of the bodies have&  turned into dust^1, so I&  can't get the SOULs./");
ds_map_add(global.text_data_en, "obj_readable_room1_457", "* i told the families that&  i would give them the&  dust back for the funerals./");
ds_map_add(global.text_data_en, "obj_readable_room1_458", "* people are starting to&  ask me what's happening./");
ds_map_add(global.text_data_en, "obj_readable_room1_459", "* what do i do?/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_462", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_467", "* ENTRY NUMBER 12/");
ds_map_add(global.text_data_en, "obj_readable_room1_468", "* nothing is happening^1.&* i don't know what to do./");
ds_map_add(global.text_data_en, "obj_readable_room1_469", "* i'll just keep injecting&  everything with& \"determination.\"/");ds_map_add(global.text_data_en, "obj_readable_room1_470", "* i want this to work./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_471", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_476", "* ENTRY NUMBER 14/");
ds_map_add(global.text_data_en, "obj_readable_room1_477", "* Everyone that had fallen&  down.../");
ds_map_add(global.text_data_en, "obj_readable_room1_478", "* ... has woken up./");
ds_map_add(global.text_data_en, "obj_readable_room1_479", "* They're all walking around&  and talking like nothing&  is wrong./");
ds_map_add(global.text_data_en, "obj_readable_room1_480", "* I thought they were&  goners...?/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_481", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_486", "* ENTRY NUMBER 7/");
ds_map_add(global.text_data_en, "obj_readable_room1_487", "* We'll need a vessel to&  wield the monster SOULs&  when the time comes./");
ds_map_add(global.text_data_en, "obj_readable_room1_488", "* After all^1, a monster&  cannot absorb the SOULs&  of other monsters./");
ds_map_add(global.text_data_en, "obj_readable_room1_489", "* Just as a human cannot&  absorb a human SOUL.../");
ds_map_add(global.text_data_en, "obj_readable_room1_490", "* So then.../");
ds_map_add(global.text_data_en, "obj_readable_room1_491", "* What about something that's&  neither human nor monster?/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_492", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_497", "* ENTRY NUMBER 15/");
ds_map_add(global.text_data_en, "obj_readable_room1_498", "* Seems like this research&  was a dead end.../");
ds_map_add(global.text_data_en, "obj_readable_room1_499", "* But at least we got a&  happy ending out of it...?/");
ds_map_add(global.text_data_en, "obj_readable_room1_500", "* I sent the SOULS back to&  ASGORE^1, returned the&  vessel to his garden..../");
ds_map_add(global.text_data_en, "obj_readable_room1_501", "* And I called all of the&  families and told them&  everyone's alive./");
ds_map_add(global.text_data_en, "obj_readable_room1_502", "* I'll send everyone back&  tomorrow. :) /%%");
ds_map_add(global.text_data_en, "obj_readable_room1_503", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_517", "* DT EXTRACTION MACHINE&* STATUS: INACTIVE/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_518", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_523", "* ENTRY NUMBER 4/");
ds_map_add(global.text_data_en, "obj_readable_room1_524", "* I've been researching humans&  to see if I can find any&  info about their SOULS./");
ds_map_add(global.text_data_en, "obj_readable_room1_525", "* I ended up snooping around&  the castle...&* And found these weird tapes./");
ds_map_add(global.text_data_en, "obj_readable_room1_526", "* I don't feel like ASGORE's&  watched them.../");
ds_map_add(global.text_data_en, "obj_readable_room1_527", "* I don't think he should./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_528", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_538", "* ENTRY NUMBER 19/");
ds_map_add(global.text_data_en, "obj_readable_room1_539", "* the families keep calling&  me to ask when everyone&  is coming home./");
ds_map_add(global.text_data_en, "obj_readable_room1_540", "* what am i supposed to say?/");
ds_map_add(global.text_data_en, "obj_readable_room1_541", "* i don't even answer the&  phone anymore./%%");
ds_map_add(global.text_data_en, "obj_readable_room1_542", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_543", "* (It's too dark to see near&  the walls.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_548", "* (Seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_551", "* ENTRY NUMBER 8/");
ds_map_add(global.text_data_en, "obj_readable_room1_552", "* I've chosen a candidate./");
ds_map_add(global.text_data_en, "obj_readable_room1_553", "* I haven't told ASGORE yet^1,&  because I want to surprise&  him with it.../");
ds_map_add(global.text_data_en, "obj_readable_room1_554", "* In the center of his&  garden^1, there's something&  special./");
ds_map_add(global.text_data_en, "obj_readable_room1_555", "* The first golden flower^1,&  that grew before all the&  others./");
ds_map_add(global.text_data_en, "obj_readable_room1_556", "* The flower from the outside&  world./");
ds_map_add(global.text_data_en, "obj_readable_room1_557", "* It appeared just before&  the queen left./");
ds_map_add(global.text_data_en, "obj_readable_room1_558", "* I wonder.../");
ds_map_add(global.text_data_en, "obj_readable_room1_559", "* What happens when something&  without a SOUL gains&  the will to live?/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_565", "* (None of the buttons work.^1)&* (It seems to have lost power.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_570", "* (The door is jammed shut&  with vines.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_575", "* (Seems like another elevator&  has lost its power.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_580", "* (The jukebox is broken.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_585", "* (It's locked.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_590", "* (It's a worn mattress.^1)&* (The sheets are bunched up in a&  weird^1, creasy ball.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_595", "* (There's a photo album inside&  the drawer.)/");
ds_map_add(global.text_data_en, "obj_readable_room1_596", "* (There are photos of Sans with&  a lot of people you don't&  recognize.)/");
ds_map_add(global.text_data_en, "obj_readable_room1_597", "* (He looks happy.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_602", "* (There's a photo album inside&  the drawer.)/");
ds_map_add(global.text_data_en, "obj_readable_room1_603", "* (There are photos of Sans with&  a lot of people you don't&  recognize.)/");
ds_map_add(global.text_data_en, "obj_readable_room1_604", "* (... and^1, one photo of you&  standing with Sans and all&  your friends.)/");
ds_map_add(global.text_data_en, "obj_readable_room1_605", "* (He looks happy.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_610", "* (There's a photo album inside&  the drawer.)/");
ds_map_add(global.text_data_en, "obj_readable_room1_611", "* (There are photos of..^1. Huh?)/");
ds_map_add(global.text_data_en, "obj_readable_room1_612", "* (A card is sticking out from&  the back flap of the binder.)/");
ds_map_add(global.text_data_en, "obj_readable_room1_613", "* (It's a poorly drawn picture&  of three smiling people.^1)&* (Written on it...)/");
ds_map_add(global.text_data_en, "obj_readable_room1_614", "* \"don't forget.\"/%%");ds_map_add(global.text_data_en, "obj_readable_room1_621", "* (It's a poster for Mettaton's&  latest stage performance.)/");
ds_map_add(global.text_data_en, "obj_readable_room1_622", "* (A tragic tale of two star-&  crossed lovers^1, kept apart&  by the tides of fate...)/");
ds_map_add(global.text_data_en, "obj_readable_room1_623", "* (Looks like it's almost time&  for the performance.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_628", "* (It's locked from the inside.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_633", "* (There's an inscription on&  this fountain.)/");
ds_map_add(global.text_data_en, "obj_readable_room1_634", "* Royal Memorial Fountain&* Built 201X&* (Mettaton Added Last Week)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_639", "* (It's a Wall of Fame full of&  quotes and photos from visiting&  celebrities.)/");
ds_map_add(global.text_data_en, "obj_readable_room1_640", "* \"The food is to die for!^1\"&* \"Gorgeous style and fragrance!^1\"&* \"My face tastes beautiful!\"/");ds_map_add(global.text_data_en, "obj_readable_room1_641", "* (... these are all Mettaton.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_646", "* (It's a lamp.^1)&* (There's no lightswitch.)/");
ds_map_add(global.text_data_en, "obj_readable_room1_647", "* (It says that stars make&  their own light...)/%%");
ds_map_add(global.text_data_en, "obj_readable_room1_652", "* (Rich history of Tem.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_60", "%%");
ds_map_add(global.text_data_en, "obj_readable_room2_63", "* (An empty photo frame.)&* (It's really dusty...)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_67", "* (An empty photo frame.)&* (Someone's dusted it off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_72", "* (It's a family photograph.^1)&* (Everyone is smiling.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_75", "\R* .../%%");
ds_map_add(global.text_data_en, "obj_readable_room2_80", "* It's a history book^1.&* Here's a random page.../");
ds_map_add(global.text_data_en, "obj_readable_room2_81", "* Trapped behind the barrier&  and fearful of further&  human attacks^1, we retreated./");
ds_map_add(global.text_data_en, "obj_readable_room2_82", "* Far^1, far into the earth&  we walked^1, until we reached&  the cavern's end./");
ds_map_add(global.text_data_en, "obj_readable_room2_83", "* This was our new home^1,&  which we named.../");
ds_map_add(global.text_data_en, "obj_readable_room2_84", "* \"Home.\"/");ds_map_add(global.text_data_en, "obj_readable_room2_85", "* As great as our king is^1,&  he is pretty lousy at&  names./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_90", "* It's a bureau./");
ds_map_add(global.text_data_en, "obj_readable_room2_91", "* There's a Santa Claus outfit&  inside./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_94", "\R* Nothing useful./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_100", "* (There are photo albums...^1)&* (Scrapbooks...^1)&* (Books on how to make tea...)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_101", "* (They all seem very worn.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_105", "\R* Nothing useful./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_111", "* It's a golden flower./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_114", "* Inside is an old calendar&  from the beginning of&  201X./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_115", "* (It's a golden flower.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_119", "* (It's another throne covered&  by a white sheet.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_124", "* Just a regular old bucket^3 & &  of snails./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_127", "* It's an encyclopedia of&  subterranean plants. You&  open to the middle.../");
ds_map_add(global.text_data_en, "obj_readable_room2_128", "* \"Typha\" - A group of wetland&  flowering plants with&  brown^1, oblong seedpods./");ds_map_add(global.text_data_en, "obj_readable_room2_129", "* Known more commonly as& \"water sausages.\"/%%");ds_map_add(global.text_data_en, "obj_readable_room2_135", "* You have seen this type&  of plant before but&  do not know its name./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_136", "* Oh^2!&* It is a \"water sausage.\"/%%");ds_map_add(global.text_data_en, "obj_readable_room2_140", "* What a nice smell...&* Too hot to eat^1, though./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_141", "* The size of the pie&  intimidates you too much&  for you to eat it./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_144", "* (Most of the pie is gone.^1)&* (There are dog prints in&  it...)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_149", "* While monsters are mostly made&  of magic^1, human beings are&  mostly made of water./");
ds_map_add(global.text_data_en, "obj_readable_room2_150", "* Humans^1, with their physical&  forms^1, are far stronger&  than us./");
ds_map_add(global.text_data_en, "obj_readable_room2_151", "* But they will never know&  the joy of expressing&  themselves through magic./");
ds_map_add(global.text_data_en, "obj_readable_room2_152", "* They'll never get a bullet-&   pattern birthday card.../%%");
ds_map_add(global.text_data_en, "obj_readable_room2_164", "* It's a door./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_166", "* ...!^1?&* There's a camera hidden&  in the bushes./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_178", "\W* \OBravery^1. \YJustice.\W  &*\B Integrity^1. \GKindness^1.\W &*\P Perseverance^1. \LPatience. \W /");
ds_map_add(global.text_data_en, "obj_readable_room2_179", "\W* Using these^1, you were&  able to win at \"\RBall Game\W.\"/");ds_map_add(global.text_data_en, "obj_readable_room2_180", "* (You are awarded 50G.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_186", "\W* \RRED\W - Try as you might^1,&  you continue to be yourself./");
ds_map_add(global.text_data_en, "obj_readable_room2_187", "* (You are awarded 10G.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_194", "\W* \OORANGE\W - You are the kind of&  person who rushes fists-first&  through all obstacles./");
ds_map_add(global.text_data_en, "obj_readable_room2_195", "* (You are awarded 5G.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_201", "\W* \YYELLOW\W - Your sure-fire&  accuracy put an end to&  the mayhem of \"Ball.\"/");ds_map_add(global.text_data_en, "obj_readable_room2_202", "* (You are awarded 3G.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_208", "\W* \BBLUE\W - Hopping and twirling^1,&  your original style&  pulled you through./");
ds_map_add(global.text_data_en, "obj_readable_room2_209", "* (You are awarded 2G.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_215", "\W* \GGREEN\W - Your concern and care&  for \"Ball\" led you to a&  delicious victory./");ds_map_add(global.text_data_en, "obj_readable_room2_216", "* (You are awarded 1G.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_222", "\W* \PPURPLE\W - Even when you felt&  trapped^1, you took notes and&  achieved the end of \"Ball.\"/");ds_map_add(global.text_data_en, "obj_readable_room2_223", "* (You are awarded 2G.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_229", "\W* \LLIGHT BLUE\W - \"Ball\" is \"Small.^1\"&* You waited^1, still^1, for&  this opportunity.../");ds_map_add(global.text_data_en, "obj_readable_room2_230", "* ... then dethroned \"Ball\" with&  a sharp attack./");ds_map_add(global.text_data_en, "obj_readable_room2_231", "* (You are awarded 4G.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_238", "* (This flag has nothing else&  to offer.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_245", "\W* Ah^1! Wow^1! Woah^1!&* It's a \"\RHole\W\"./%%");ds_map_add(global.text_data_en, "obj_readable_room2_247", "* There's a hole here./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_252", "* (Hers.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_259", "THIS IS MY BROTHER'S&PET ROCK./");
ds_map_add(global.text_data_en, "obj_readable_room2_260", "\E1HE ALWAYS FORGETS&TO FEED IT./");
ds_map_add(global.text_data_en, "obj_readable_room2_261", "\E3AS USUAL^1, I HAVE&TO TAKE&RESPONSIBILITY./");
ds_map_add(global.text_data_en, "obj_readable_room2_262", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_readable_room2_263", "* (The rock is covered in&  sprinkles.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_266", "* (This rock is covered in&  sprinkles.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_268", "* (This rock is covered in&  sprinkles.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_276", "ISN'T THAT FLAG&NEATO?/");
ds_map_add(global.text_data_en, "obj_readable_room2_277", "UNDYNE FOUND IT&AT THE BAY.../");
ds_map_add(global.text_data_en, "obj_readable_room2_278", "\E3I THINK IT'S FROM&THE HUMAN WORLD?/");
ds_map_add(global.text_data_en, "obj_readable_room2_279", "\E0NOW^1, I KNOW&WHAT YOU'RE&THINKING./");
ds_map_add(global.text_data_en, "obj_readable_room2_280", "\E3WHY WOULD A&HUMAN FLAG.../");
ds_map_add(global.text_data_en, "obj_readable_room2_281", "HAVE A COOL&SKELETON ON IT?/");
ds_map_add(global.text_data_en, "obj_readable_room2_282", "WELL..^1.&I HAVE A THEORY./");
ds_map_add(global.text_data_en, "obj_readable_room2_283", "\E3I THINK HUMANS.../");
ds_map_add(global.text_data_en, "obj_readable_room2_284", "\E0MUST HAVE&DESCENDED FROM&SKELETONS!!!/");
ds_map_add(global.text_data_en, "obj_readable_room2_285", "NYEH HEH HEH!!!/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_287", "* (It's a beat-up pirate&  flag.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_288", "* (It's a beat-up pirate&  flag.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_295", "* Why did the humans attack^1?&* Indeed^1, it seemed that they&  had nothing to fear./");
ds_map_add(global.text_data_en, "obj_readable_room2_296", "* Humans are unbelievably strong.&* It would take the SOUL of&  nearly every monster.../");
ds_map_add(global.text_data_en, "obj_readable_room2_297", "* ... just to equal the power&  of a single human SOUL./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_302", "* This power has no counter.&* Indeed, a human cannot&  take a monster's SOUL./");
ds_map_add(global.text_data_en, "obj_readable_room2_303", "* When a monster dies, its&  SOUL disappears./");
ds_map_add(global.text_data_en, "obj_readable_room2_304", "* And an incredible power&  would be needed to take the&  SOUL of a living monster./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_310", "* There is only one way to&  reverse this spell./");
ds_map_add(global.text_data_en, "obj_readable_room2_311", "* If a huge power, equivalent&  to seven human SOULs, attacks&  the barrier.../");
ds_map_add(global.text_data_en, "obj_readable_room2_312", "* It will be destroyed./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_318", "* In the end, it could&  hardly be called a war./");
ds_map_add(global.text_data_en, "obj_readable_room2_319", "* United, the humans were too&  powerful, and us monsters,&  too weak./");
ds_map_add(global.text_data_en, "obj_readable_room2_320", "* Not a single SOUL was taken,&  and countless monsters were&  turned to dust.../%%");
ds_map_add(global.text_data_en, "obj_readable_room2_326", "* I'm catching bugs^1.&* But the underground doesn't&  have many.../");
ds_map_add(global.text_data_en, "obj_readable_room2_327", "* I keep catching the same&  one./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_332", "* (It's a computer.^1)&* (It's accessing some kind of&  puzzle in Snowdin.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_333", "* (It's too dark to see&  near the walls.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_343", "* (It's an oven.^1)&* (It looks pretty modern.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_345", "* (It's too dark to see&  near the walls.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_353", "* OH YES^1! MTT-BRAND OVENS CAN &  REACH TEMPERATURES UP TO&  NINE-THOUSAND DEGREES!/");
ds_map_add(global.text_data_en, "obj_readable_room2_354", "* ROASTING^1! TOASTING^1! BURNING^1!&* CHARRING^1! YOU'RE EXCITED^1,&  AREN'T YOU^1, DARLING? (TM)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_360", "* (It's the oven.^1)&* (Looks like someone forgot&  to preheat it.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_373", "* You wanna see my&  room?/");
ds_map_add(global.text_data_en, "obj_readable_room2_374", "\E3* TOO BAD^1!&* No nerds allowed!/");
ds_map_add(global.text_data_en, "obj_readable_room2_375", "\E9* ... well^1, maybe some&  nerds.../%%");
ds_map_add(global.text_data_en, "obj_readable_room2_377", "* You're being kind&  of creepy./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_390", "* (It's a spider donut.^1)&* (It looks more...^1)&* (Rubbery than usual.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_395", "* (North^1, the warrior's path.)&* (West^1, the sage's path.)&* (Any path leads to The End.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_400", "* (To the East^1!)&* (This is The End.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_405", "* ENTRY NUMBER 2/");
ds_map_add(global.text_data_en, "obj_readable_room2_406", "* The barrier is locked by&  SOUL power../");
ds_map_add(global.text_data_en, "obj_readable_room2_407", "* Unfortunately^1, this power&  cannot be recreated&  artificially./");
ds_map_add(global.text_data_en, "obj_readable_room2_408", "* SOUL power can only be&  derived from what was&  once living./");
ds_map_add(global.text_data_en, "obj_readable_room2_409", "* So^1, to create more^1, we&  will have to use what we&  have now.../");
ds_map_add(global.text_data_en, "obj_readable_room2_410", "* The SOULs of monsters./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_412", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_417", "* ENTRY NUMBER 13/");
ds_map_add(global.text_data_en, "obj_readable_room2_418", "* one of the bodies opened&  its eyes./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_419", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_424", "* (The clock is broken.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_429", "* ENTRY NUMBER 10/");
ds_map_add(global.text_data_en, "obj_readable_room2_430", "* experiments on the&  vessel are a failure./");
ds_map_add(global.text_data_en, "obj_readable_room2_431", "* it doesn't seem to be&  any different from the&  control cases./");
ds_map_add(global.text_data_en, "obj_readable_room2_432", "* whatever^1.&* they're a hassle to work&  with anyway./");
ds_map_add(global.text_data_en, "obj_readable_room2_433", "* the seeds just stick to&  you^1, and won't let go.../%%");
ds_map_add(global.text_data_en, "obj_readable_room2_434", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_439", "* ENTRY NUMBER 16/");
ds_map_add(global.text_data_en, "obj_readable_room2_440", "* no No NO NO NO NO NO/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_441", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_446", "* (There are a bunch of VHSes.^1)&* (Seems like it's mostly&  cartoons of some kind.)/");
ds_map_add(global.text_data_en, "obj_readable_room2_447", "* (They seem to be alphabetized^1,&  save for a few stray...^1)&* (... sticky ones?)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_452", "* ENTRY NUMBER 11/");
ds_map_add(global.text_data_en, "obj_readable_room2_453", "* now that mettaton's made it&  big^1, he never talks to&  me anymore./");
ds_map_add(global.text_data_en, "obj_readable_room2_454", "* ... except to ask when i'm&  going to finish his body./");
ds_map_add(global.text_data_en, "obj_readable_room2_455", "* but i'm afraid if i finish&  his body^1, he won't need me&  anymore.../");
ds_map_add(global.text_data_en, "obj_readable_room2_456", "* then we'll never be friends&  ever again./");
ds_map_add(global.text_data_en, "obj_readable_room2_457", "* ... not to mention^1, every time&  i try to work on it^1, i&  just get really sweaty.../%%");
ds_map_add(global.text_data_en, "obj_readable_room2_462", "* ENTRY NUMBER 20/");
ds_map_add(global.text_data_en, "obj_readable_room2_463", "* ASGORE left me five&  messages today./");
ds_map_add(global.text_data_en, "obj_readable_room2_464", "* four about everyone being&  angry/");
ds_map_add(global.text_data_en, "obj_readable_room2_465", "* one about this cute teacup&  he found that looks like&  me/");
ds_map_add(global.text_data_en, "obj_readable_room2_466", "* thanks asgore./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_467", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_468", "* (It's too dark to see near&  the walls.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_473", "* (Seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_476", "* ENTRY NUMBER 18/");
ds_map_add(global.text_data_en, "obj_readable_room2_477", "* the flower's gone./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_483", "* (It's locked from the&  inside.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_488", "PLEASE DON'T ENTER&THE MYSTERIOUS&SHACK./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_492", "HELLO^1.&THAT'S NOT&MY HOUSE./");
ds_map_add(global.text_data_en, "obj_readable_room2_493", "THAT'S JUST MY&COOL TOOLSHED./");
ds_map_add(global.text_data_en, "obj_readable_room2_495", "* Do you call it&  your COOLSHED!?/");
ds_map_add(global.text_data_en, "obj_readable_room2_497", "NO!!^1!&I'VE NEVER THOUGHT&OF THAT!!!/");
ds_map_add(global.text_data_en, "obj_readable_room2_498", "THAT'S WHY WE'RE&FRIENDS^1,&UNDYNE./");
ds_map_add(global.text_data_en, "obj_readable_room2_499", "YOU ENRICH MY&LIFE WITH SHED-&BASED PUNS./");
ds_map_add(global.text_data_en, "obj_readable_room2_501", "* That's the only&  one I've ever&  made^1, dude./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_506", "READY FOR ANOTHER&NIGHT IN THE&PUNISHMENT SHACK?/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_509", "READY FOR ANOTHER&NIGHT IN THE&PUNISHMENT SHACK?/");
ds_map_add(global.text_data_en, "obj_readable_room2_511", "* Oh my GOD^1, I don't&  even wanna KNOW./");
ds_map_add(global.text_data_en, "obj_readable_room2_513", "DON'T BE SO&JUDGMENTAL^1,&UNDYNE./");
ds_map_add(global.text_data_en, "obj_readable_room2_514", "MY SHACK IS A&FOUR STAR&ESTABLISHMENT./");
ds_map_add(global.text_data_en, "obj_readable_room2_516", "* What^1, lemme guess./");
ds_map_add(global.text_data_en, "obj_readable_room2_517", "\E6* Sometimes you cut a&  hot dog into the&  dog food^1, right?/");
ds_map_add(global.text_data_en, "obj_readable_room2_519", "WHAT!?!?/");
ds_map_add(global.text_data_en, "obj_readable_room2_520", "\E0HOW'D YOU KNOW?/");
ds_map_add(global.text_data_en, "obj_readable_room2_522", "* OH MY GOD^1! NO^1!&* I WAS JOKING!!^1!&* DON'T DO THIS!!!/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_528", "YOU SHOULD LEARN&A PRIVACY./%%");
ds_map_add(global.text_data_en, "obj_readable_room2_534", "* (You can't go through the&  fire exit because you're&  not made of fire.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_539", "* (It's an uncovered pillow.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_544", "* (You look in the drawer.^1)&* (There's some kind of badge.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_549", "* (It's a performance schedule.^1)&* (Comedians^1, dancers^1, Sans...^1)&* (Seems there's a break now.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_554", "* (It's some sort of giant bottle&  of perfume.^1)&* (Eau de Rectangle.)/");
ds_map_add(global.text_data_en, "obj_readable_room2_555", "* (The cap is so comically large^1,&  you can't open it.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_560", "* (Feeling of being watched.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_563", "* (She's waiting for someone to&  let her out.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room2_569", "* (The gems on the southern&  wall shine in a&  spectacular pattern.)/");
ds_map_add(global.text_data_en, "obj_readable_room2_570", "* (It's a nice thing you can&  see the southern wall from&  this angle.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_59", "%%");
ds_map_add(global.text_data_en, "obj_readable_room3_60", "* (A box of kids' shoes in&  a disparity of sizes.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_63", "* (It's a drawing of a&  golden flower.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_66", "\R* My drawing./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_71", "* (Definitely bigger than&  a twin-sized bed.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_74", "* (Earlier^1, you identified&  this as bigger than a&  twin-sized bed.)/");
ds_map_add(global.text_data_en, "obj_readable_room3_75", "* (But now^1, you realize&  it's actually one size&  bigger than a double.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_79", "* The coals are still warm./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_81", "* (Macaroni art of a flower.^1)&* ('For King Dad!')/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_83", "* Inside the drawer are&  flower seeds and some&  broken crayons./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_84", "* There is some white fur&  stuck in the drain./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_85", "* (There is some white fur&  stuck in the drain.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_89", "* Because they are made of&  magic^1, monsters' bodies are&  attuned to their SOUL./");
ds_map_add(global.text_data_en, "obj_readable_room3_90", "* If a monster doesn't want&  to fight^1, its defenses will&  weaken./");
ds_map_add(global.text_data_en, "obj_readable_room3_91", "* And the crueller the intentions&  of our enemies^1, the more&  their attacks will hurt us./");
ds_map_add(global.text_data_en, "obj_readable_room3_92", "* Therefore^1, if a being with&  a powerful SOUL struck with&  the desire to kill.../");
ds_map_add(global.text_data_en, "obj_readable_room3_93", "* Um^1, let's end the chapter&  here.../%%");
ds_map_add(global.text_data_en, "obj_readable_room3_104", "* ...!^1?&* There's a camera behind the&  sentry station./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_108", "* ...!^1?&* There is a camera behind the..^1.&  \"sentry station.\"/%%");ds_map_add(global.text_data_en, "obj_readable_room3_112", "* ...!^1?&* There's a camera hidden inside&  this lump of snow./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_116", "* ...!^1?&* There's a camera hidden inside&  this tree./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_120", "* ...!^1?&* There's a camera hidden inside&  this tree./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_124", "* ...!^1?&* There's a camera behind the&  sentry station./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_128", "* ...!^1?&* There's a camera underneath&  the bridge./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_132", "* ...!^1?&* There's a camera hidden in&  the trees here./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_139", "* When four Bridge Seeds align&  in the water^1, they will&  sprout./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_141", "* If an error is made, the Bell&  Blossom can call Bridge Seeds&  back to where they started./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_142", "* WISHING ROOM/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_147", "* But humans have one weakness.&* Ironically, it is the strength&  of their SOUL./");
ds_map_add(global.text_data_en, "obj_readable_room3_148", "* Its power allows it to persist&  outside the human body, even&  after death./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_154", "* There is only one exception./");
ds_map_add(global.text_data_en, "obj_readable_room3_155", "* The SOUL of a special species&  of monster called a&  \"Boss Monster.\"/");ds_map_add(global.text_data_en, "obj_readable_room3_156", "* A Boss Monster's SOUL is&  strong enough to persist&  after death.../");
ds_map_add(global.text_data_en, "obj_readable_room3_157", "* If only for a few moments./");
ds_map_add(global.text_data_en, "obj_readable_room3_158", "* A human could absorb this&  SOUL.&* But this has never happened./");
ds_map_add(global.text_data_en, "obj_readable_room3_159", "* And now it never will./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_165", "* But this cursed place has&  no entrances or exits./");
ds_map_add(global.text_data_en, "obj_readable_room3_166", "* There is no way a human&  could come here./");
ds_map_add(global.text_data_en, "obj_readable_room3_167", "* We will remain trapped&  down here forever./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_175", "A CLASSIC IMAGE./");
ds_map_add(global.text_data_en, "obj_readable_room3_176", "IT ALWAYS REMINDS&ME OF WHAT'S&IMPORTANT IN LIFE./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_180", "* (It's a painting of a&  cartoon bone.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_195", "* (Whenever the girl moves her&  net^1, this bug scurries straight&  into it.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_200", "* (Seems like the notes to&  something^1, but it's all&  written in chicken scratch.)/");
ds_map_add(global.text_data_en, "obj_readable_room3_201", "* (It seems like a walkthrough&  to a game^1, or...?)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_202", "* (It's too dark to see&  near the walls.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_207", "* (VHSes and DVDs of various&  cartoons.)/");
ds_map_add(global.text_data_en, "obj_readable_room3_208", "* (They are all labelled \"Human&  History.\")/%%");ds_map_add(global.text_data_en, "obj_readable_room3_213", "* (It's a specifically-regular&  -sized sink.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_215", "* (It's too dark to see&  near the walls.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_222", "* THIS ISN'T A SHOW ABOUT&  WASHING YOUR HANDS, DARLING./");
ds_map_add(global.text_data_en, "obj_readable_room3_223", "* THAT'S ON WEDNESDAYS!/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_228", "* THIS ISN'T A SHOW ABOUT&  WASHING YOUR HANDS, DARLING./");
ds_map_add(global.text_data_en, "obj_readable_room3_229", "* THAT'S ON WEDNESDAYS!/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_242", "* One time^1, Alphys's..^1.&* Uh^1, friend??^1?&* Came over here./");
ds_map_add(global.text_data_en, "obj_readable_room3_243", "\E4* All he did was&  lie seductively&  on the piano.../");
ds_map_add(global.text_data_en, "obj_readable_room3_244", "\E5* And fed himself&  grapes./");
ds_map_add(global.text_data_en, "obj_readable_room3_245", "\E4* I don't really&  like that guy./");
ds_map_add(global.text_data_en, "obj_readable_room3_246", "\E3* But I admire&  his lifestyle./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_248", "* What^1?&* I'm not gonna&  serenade you./%%");
ds_map_add(global.text_data_en, "obj_readable_room3_254", "* ENTRY NUMBER 3/");
ds_map_add(global.text_data_en, "obj_readable_room3_255", "* But extracting a SOUL from&  a living monster would&  require incredible power.../");
ds_map_add(global.text_data_en, "obj_readable_room3_256", "* Besides being impractical^1,&  doing so would instantly&  destroy the SOUL's host./");
ds_map_add(global.text_data_en, "obj_readable_room3_257", "* And^1, unlike the persistent&  SOULs of humans.../");
ds_map_add(global.text_data_en, "obj_readable_room3_258", "* The SOULs of most monsters&  disappear immediately upon&  death./");
ds_map_add(global.text_data_en, "obj_readable_room3_259", "* If only I could make a&  monster's SOUL last.../%%");
ds_map_add(global.text_data_en, "obj_readable_room3_261", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_266", "* (There are a bunch of VHSes.^1)&* (Seems like it's mostly&  cartoons of some kind.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_272", "* ENTRY NUMBER 21/");
ds_map_add(global.text_data_en, "obj_readable_room3_273", "* i spend all my time at&  the garbage dump now/");
ds_map_add(global.text_data_en, "obj_readable_room3_274", "* it's my element/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_275", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_276", "* (It's too dark to see near&  the walls.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_286", "* (It's a thank-you letter.^1)&* (It's addressed to Santa.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_291", "* (Blueprints.^1)&* (You can't read the symbols&  they're written in...)/");
ds_map_add(global.text_data_en, "obj_readable_room3_292", "* (... or maybe it's just the&  handwriting.)/");
ds_map_add(global.text_data_en, "obj_readable_room3_293", "* (Looks like they relate to&  some kind of strange machine.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_303", "* oh..^1. that's my tv.../");
ds_map_add(global.text_data_en, "obj_readable_room3_304", "* there's a show i like to&  watch on it..^1.&* sometimes.../%%");
ds_map_add(global.text_data_en, "obj_readable_room3_308", "* (It's a spooky old TV.^1)&* (Most of the buttons are&  worn away...)/");
ds_map_add(global.text_data_en, "obj_readable_room3_309", "* (Though the channel changing&  buttons look good as new.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_315", "* (Rope.^1)&* (Looks like this dog does&  all its own stunts.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_320", "* (It's some kind of TV show&  featuring Mettaton.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room3_325", "* (Statue of tem..^1. very famus^1)&* (VERY!!!!!!!!!)/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_60", "%%");
ds_map_add(global.text_data_en, "obj_readable_room4_63", "* It's you!/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_64", "* Still just you^1, Frisk./%%");
ds_map_add(global.text_data_en, "obj_readable_room4_66", "* It's me^1, \[C]./%%");
ds_map_add(global.text_data_en, "obj_readable_room4_67", "* It's a golden flower./%%");
ds_map_add(global.text_data_en, "obj_readable_room4_70", "* Despite everything^1, it's&  still you./%%");
ds_map_add(global.text_data_en, "obj_readable_room4_73", "* It's me^1, \[C]./%%");
ds_map_add(global.text_data_en, "obj_readable_room4_76", "* Inside the cupboard are&  cookie cutters for&  gingerbread monsters./%%");
ds_map_add(global.text_data_en, "obj_readable_room4_77", "\R* Where are the knives./%%");
ds_map_add(global.text_data_en, "obj_readable_room4_78", "* The stovetop is very clean^1.&* Toriel must use fire&  magic instead./%%");
ds_map_add(global.text_data_en, "obj_readable_room4_79", "* No one will use this&  anymore.../%%");
ds_map_add(global.text_data_en, "obj_readable_room4_83", "* (It's a note.^1)&* Howdy^1! Help yourself to&  anything you want!/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_84", "* I've read this already./%%");
ds_map_add(global.text_data_en, "obj_readable_room4_90", "* (The stovetop is very clean.^1)&* (Someone must use fire&  magic instead.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_91", "* Stovetop./%%");
ds_map_add(global.text_data_en, "obj_readable_room4_98", "* (What a comfortable bed.^1)&* (If you laid down here^1,&  you might not ever get up.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_99", "* My bed./%%");
ds_map_add(global.text_data_en, "obj_readable_room4_104", "* (It's a twin-sized bed.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_105", "* His bed./%%");
ds_map_add(global.text_data_en, "obj_readable_room4_110", "* (It's a king-sized bed.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_114", "* \"MONSTER HISTORY PART 4\"/");ds_map_add(global.text_data_en, "obj_readable_room4_116", "* Fearing the humans no longer^1,&  we moved out of our old&  city^1, HOME./");
ds_map_add(global.text_data_en, "obj_readable_room4_117", "* We braved harsh cold^1, damp&  swampland^1, and searing heat.../");
ds_map_add(global.text_data_en, "obj_readable_room4_118", "* Until we reached what we now&  call our capital./");
ds_map_add(global.text_data_en, "obj_readable_room4_119", "* \"NEW HOME.\"/");ds_map_add(global.text_data_en, "obj_readable_room4_120", "* Again^1, our King is really&  bad at names...?/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_126", "* Excuse me..^1.&* Yes^1, you^1, with the striped&  shirt./");
ds_map_add(global.text_data_en, "obj_readable_room4_127", "* Can you do something about&  your friend...?/");
ds_map_add(global.text_data_en, "obj_readable_room4_128", "* Yes^1, your friend..^1.&* The one behind you^1, with the&  creepy smile./%%");
ds_map_add(global.text_data_en, "obj_readable_room4_131", "* Hmmm^1?&* Where'd your friend go?/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_139", "* If a monster defeats a human^1,&  they can take its SOUL./");
ds_map_add(global.text_data_en, "obj_readable_room4_140", "* A monster with a human SOUL..^1.&* A horrible beast with&  unfathomable power./%%");
ds_map_add(global.text_data_en, "obj_readable_room4_145", "* (It's a video feed of your&  location.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_146", "* It's you...?/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_147", "* It's me^1, \[C]./%%");
ds_map_add(global.text_data_en, "obj_readable_room4_159", "* (It's a microwave.^1)&* (That's great if you're a&  microwave fan.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_161", "* (It's too dark to see&  near the walls.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_168", "* MTT-BRAND MICROWAVE^1!&* ORIGIN OF THE MTT CHALLENGE!/");
ds_map_add(global.text_data_en, "obj_readable_room4_169", "* PUT YOUR FOOD IN AND SET&  THE MICROWAVE ON HIGH FOR&  FIVE MINUTES.../");
ds_map_add(global.text_data_en, "obj_readable_room4_170", "* IF YOU CAN STILL RECOGNIZE&  YOUR MEAL^1, WE'LL DOUBLE YOUR&  MONEY BACK!!!/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_174", "* STILL FIDDLING WITH THAT&  MICROWAVE, EH, DARLING?/");
ds_map_add(global.text_data_en, "obj_readable_room4_175", "* CAN'T BLAME YOU FOR BEING&  TOTALLY ENAMORED WITH AN&  ELECTRONIC BOX./%%");
ds_map_add(global.text_data_en, "obj_readable_room4_182", "* (In the sink is a teacup&  in the shape of a fish.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_193", "* ENTRY NUMBER 5/");
ds_map_add(global.text_data_en, "obj_readable_room4_194", "* I've done it./");
ds_map_add(global.text_data_en, "obj_readable_room4_195", "* Using the blueprints^1, I've&  extracted it from the&  human SOULs./");
ds_map_add(global.text_data_en, "obj_readable_room4_196", "* I believe this is what&  gives their SOULs the strength&  to persist after death./");
ds_map_add(global.text_data_en, "obj_readable_room4_197", "* The will to keep living..^1.&* The resolve to change fate./");
ds_map_add(global.text_data_en, "obj_readable_room4_198", "* Let's call this power.../");
ds_map_add(global.text_data_en, "obj_readable_room4_199", "\Y* \"Determination.\"/%%");ds_map_add(global.text_data_en, "obj_readable_room4_201", "* (It seems to be turned off.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_206", "* (Golden flowers.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_212", "* (It's Sans's dirty sock pile.^1)&* (Sc..^1. scandalous...?)/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_217", "* (There's a strange machine&  behind the curtain.^1)&* (It seems to be broken.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_222", "* (It's locked.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_226", "* (You unlocked the door and&  entered.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_234", "* (Finally^1, the pieces of the&  puzzle are coming together.^1)&* (The jigsaw puzzle.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room4_237", "* Huh!^1?&* There's a camera behind&  the waterfall./%%");
ds_map_add(global.text_data_en, "obj_readable_room5_64", "%%");
ds_map_add(global.text_data_en, "obj_readable_room5_68", "* (There are a lot of striped&  shirts in here.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_69", "* Our clothes./%%");
ds_map_add(global.text_data_en, "obj_readable_room5_74", "* (It's ASGORE's journal.)&* (All the current page says&  is 'Nice day today!')/");
ds_map_add(global.text_data_en, "obj_readable_room5_75", "* (The ink is still almost wet.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_78", "* (The ink's dry now.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_80", "* The entries are always the&  same./%%");
ds_map_add(global.text_data_en, "obj_readable_room5_82", "* (It's just a chair.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_92", "* (It's a teacup shaped like&  a yellow lizard.^1)&* (It's full of soda.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_93", "* (It's too dark to see&  near the walls.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_104", "* (It's a promo poster for&  Mettaton's TV premiere.)/");
ds_map_add(global.text_data_en, "obj_readable_room5_105", "* (On the flap it says \"Thank&  you for making my dreams&  come true.\")/%%");ds_map_add(global.text_data_en, "obj_readable_room5_110", "* (An incredible invention.)/");
ds_map_add(global.text_data_en, "obj_readable_room5_111", "* (When not in use^1, this bed&  folds into an extremely-&  easy-to-draw box.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_116", "* (Pink goop drips from this&  strange machine.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_126", "* A haunting song echoes&  down the corridor...&* Won't you play along?/");
ds_map_add(global.text_data_en, "obj_readable_room5_127", "* Only the first 8 are fine./%%");
ds_map_add(global.text_data_en, "obj_readable_room5_131", "* (It's an illustration of a&  strange creature...)/");
ds_map_add(global.text_data_en, "obj_readable_room5_132", "* (There's something very&  unsettling about this drawing.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_138", "* Love^1, hope^1, compassion..^1.&* This is what people say&  monster SOULs are made of./");
ds_map_add(global.text_data_en, "obj_readable_room5_139", "* But the absolute nature of&  \"SOUL\" is unknown./");ds_map_add(global.text_data_en, "obj_readable_room5_140", "* After all^1, humans have proven&  their SOULs don't need these&  things to exist./%%");
ds_map_add(global.text_data_en, "obj_readable_room5_145", "* (There's a silverware drawer.^1)&* (It has forks^1, spoons^1,&  knives...)/");
ds_map_add(global.text_data_en, "obj_readable_room5_146", "* (... tiny swords^1, axes^1,&  spears^1, nunchucks...)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_154", "* I can't believe he&  leapt through the&  window like that./");
ds_map_add(global.text_data_en, "obj_readable_room5_155", "\E6* Normally he NAILS&  the landing./%%");
ds_map_add(global.text_data_en, "obj_readable_room5_160", "* (Small puddle forming.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_163", "* (Medium puddle forming.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_167", "* (Large puddle forming.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_171", "* (A small tree is growing in&  the puddle.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_177", "* (It's a bathroom sign.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_186", "* (Inside the drawer is a silver&  key.)/");
ds_map_add(global.text_data_en, "obj_readable_room5_187", "* (You put it on your keychain.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_192", "* (Clothes and trombones are&  shoved in haphazardly.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_197", "* (It appears to be a self-&  sustaining tornado made of&  trash.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_203", "* (It's glued to the table.)/%%");
ds_map_add(global.text_data_en, "obj_readable_room5_209", "* (What the hey is this?)/%");
ds_map_add(global.text_data_en, "obj_readable_room5_216", "* (Dumplings.)&* (They look slightly nibbled...)/");
