ds_map_add(global.text_data_en, "scr_battlegroup_704", "* Royal Guard attacks!");
ds_map_add(global.text_data_en, "scr_battlegroup_719", "* Tsunderplane gets in the way!&* Not on purpose or anything.");
ds_map_add(global.text_data_en, "scr_battlegroup_733", "* Vulkin strolls in.");
ds_map_add(global.text_data_en, "scr_battlegroup_747", "* Pyrope bounds towards you!");
ds_map_add(global.text_data_en, "scr_battlegroup_778", "* Woshua and Aaron appear.");
ds_map_add(global.text_data_en, "scr_battlegroup_795", "* Moldbygg and Woshua appear.");
ds_map_add(global.text_data_en, "scr_battlegroup_826", "* Muffet traps you!");
ds_map_add(global.text_data_en, "scr_battlegroup_868", "* Madjick pops out of its hat!");
ds_map_add(global.text_data_en, "scr_battlegroup_882", "* Knight Knight blocks the way!");
ds_map_add(global.text_data_en, "scr_battlegroup_896", "* Final Froggit was already there^1,&  waiting for you.");
ds_map_add(global.text_data_en, "scr_battlegroup_910", "* Astigmatism drew near.");
ds_map_add(global.text_data_en, "scr_battlegroup_924", "* Whimsalot rushed in!");
ds_map_add(global.text_data_en, "scr_battlegroup_938", "* Whimsalot and Final Froggit&  appeared.");
ds_map_add(global.text_data_en, "scr_battlegroup_953", "* Whimsalot and Astigmatism&  appeared.");
ds_map_add(global.text_data_en, "scr_battlegroup_968", "* Final Froggit and Astigmatism&  appeared.");
ds_map_add(global.text_data_en, "scr_battlegroup_983", "* What a nightmare!");
ds_map_add(global.text_data_en, "scr_battlegroup_999", "* Mercenaries emerge from&  the shadows.");
ds_map_add(global.text_data_en, "scr_battlegroup_1015", "* Defuse the bomb!");
ds_map_add(global.text_data_en, "scr_battlegroup_1029", "* Defuse the dog!");
ds_map_add(global.text_data_en, "scr_battlegroup_1049", "* Defuse the extremely agile&  glass of water!");
ds_map_add(global.text_data_en, "scr_battlegroup_1068", "* Defuse the script!");
ds_map_add(global.text_data_en, "scr_battlegroup_1088", "* Defuse the basketball!");
ds_map_add(global.text_data_en, "scr_battlegroup_1107", "* Defuse the present!");
ds_map_add(global.text_data_en, "scr_battlegroup_1126", "* Defuse the game!");
ds_map_add(global.text_data_en, "scr_battlegroup_1160", "* Tsunderplane attacks!&* Not because it's jealous Vulkin&  is paying attention to you!");
ds_map_add(global.text_data_en, "scr_battlegroup_1176", "* The rare and threatening&  Double Davis.");
ds_map_add(global.text_data_en, "scr_battlegroup_1191", "* A strange parade blocks the&  path.");
ds_map_add(global.text_data_en, "scr_battlegroup_1221", "* Mettaton EX makes his premiere!");
ds_map_add(global.text_data_en, "scr_battlegroup_1236", "* Smells like sweet lemons.");
ds_map_add(global.text_data_en, "scr_battlegroup_1250", "* ,");
ds_map_add(global.text_data_en, "scr_battlegroup_1264", "* It's so cold.");
ds_map_add(global.text_data_en, "scr_battlegroup_1278", "*        drew near!");
ds_map_add(global.text_data_en, "scr_battlegroup_1294", "* It's the Amalgamate.");
ds_map_add(global.text_data_en, "scr_battlegroup_1314", "* The Lost Soul appeared.");
ds_map_add(global.text_data_en, "scr_battlegroup_1334", "* The Lost Souls appeared.");
ds_map_add(global.text_data_en, "scr_battlegroup_1395", "* In my way.");
ds_map_add(global.text_data_en, "scr_battlegroup_1410", "* The heroine appears.");
ds_map_add(global.text_data_en, "scr_battlegroup_1422", "* Glad Dummy lets you go.");
ds_map_add(global.text_data_en, "scr_battlegroup_1439", "* Mettaton NEO blocks the way!");
ds_map_add(global.text_data_en, "scr_battlegroup_1484", "* ASGORE attacks!");
ds_map_add(global.text_data_en, "scr_battlegroup_1501", "* That doesn't seem correct.");
ds_map_add(global.text_data_en, "scr_battlegroup_1517", "* Final Froggit stopped chasing&  Migospel around.");
ds_map_add(global.text_data_en, "scr_battlegroup_1532", "* Parsnik slithered out of the&  earth!");
ds_map_add(global.text_data_en, "scr_battlegroup_1547", "* You tripped over some&  Moldessas.");
ds_map_add(global.text_data_en, "scr_battlegroup_1563", "* A line of Moldessas block the&  path.");
ds_map_add(global.text_data_en, "scr_battlegroup_1580", "* Can you believe it?");
ds_map_add(global.text_data_en, "scr_battlegroup_1595", "* Final Froggit hopped in...?");
ds_map_add(global.text_data_en, "scr_battlegroup_1609", "* Whimsalot and Parsnik appeared.");
ds_map_add(global.text_data_en, "scr_battlegroup_1624", "* Migospel flutters in^1, carrying&  Moldessa.");
ds_map_add(global.text_data_en, "scr_battlegroup_1639", "* Migospel flutters in^1, carrying&  Parsnik.");
ds_map_add(global.text_data_en, "scr_battlegroup_1654", "* Parsniks hissed out of the&  earth!");
ds_map_add(global.text_data_en, "scr_battlegroup_1669", "* Not only potatoes have eyes.");
ds_map_add(global.text_data_en, "scr_battlegroup_1684", "* Eyes appeared from the shadows.");
ds_map_add(global.text_data_en, "scr_battlegroup_1699", "* Looks like a real party.");
ds_map_add(global.text_data_en, "scr_battlegroup_1716", "* Party from Hell.");
ds_map_add(global.text_data_en, "scr_battlegroup_1733", "* Glyde swooped in!");
ds_map_add(global.text_data_en, "scr_battlegroup_1747", "* You're blocked in politely!");
ds_map_add(global.text_data_en, "scr_battlegroup_1762", "* It's the end.");
ds_map_add(global.text_data_en, "scr_battlegroup_1787", "* ASRIEL blocks the way!");
ds_map_add(global.text_data_en, "scr_battlegroup_1789", "* ASRIEL's SOUL was awakened&  by the power of your&  friends!");
ds_map_add(global.text_data_en, "scr_battlegroup_1791", "* It's time to say goodbye.");
ds_map_add(global.text_data_en, "obj_basicmonster_act", "* Monster does an action.");
ds_map_add(global.text_data_en, "obj_basicmonster_info", "* Smells like a monster.");
ds_map_add(global.text_data_en, "obj_basicmonster_mercy", "* Monster seems satisfied.");
ds_map_add(global.text_data_en, "obj_basicmonster_lowhp", "* Monster has low HP.");
ds_map_add(global.text_data_en, "obj_basicmonster_check", "* MONSTER - ATK \[1] DEF \[2]&* Mistakenly believes its lava&  is a monster./^");
ds_map_add(global.text_data_en, "obj_basicmonster_playeract", "* You execute some action./^");
ds_map_add(global.text_data_en, "obj_napstablook_189", "* YOU WON!&* You lost 1 experience point./%");
ds_map_add(global.text_data_en, "obj_torielboss_240", "* YOU WON!&* You lost 1 experience point./%");
ds_map_add(global.text_data_en, "SCR_TEXT_2510", "* You..^1.&* You came from outside^1,&  didn't you?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2511", "* People like you are so&  rare.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2512", "* Please^1!* Stranger!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2513", "* Tell me about outside...?& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2514", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2535", "* Huh^1?&* \"SURFACE\"^1?&* What do you mean?/");ds_map_add(global.text_data_en, "SCR_TEXT_2536", "* I just meant outside this&  room./");
ds_map_add(global.text_data_en, "SCR_TEXT_2537", "* If you haven't noticed^1, my&  mycelium have bound me&  to the ground./");
ds_map_add(global.text_data_en, "SCR_TEXT_2538", "* Please^1!&* Stranger!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2539", "* I'll make this simple./");
ds_map_add(global.text_data_en, "SCR_TEXT_2540", "* I've spent my whole life&  in the same spot^1,&  in the same room./");
ds_map_add(global.text_data_en, "SCR_TEXT_2541", "* But I've long wondered&  what lies inside the&  room to the right./");
ds_map_add(global.text_data_en, "SCR_TEXT_2542", "* Long I've fantasized&  about entering^1, and&  changing my scenery.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2543", "* No..^1.&* Changing my LIFE!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2544", "* Please^1.&* Go and tell me what's&  inside./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2553", "* Is everyone out there&  like you^1?&* How terrible./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2518", "* Well^1, what are you&  waiting for?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2522", "* Oh^1!&* You're back!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2523", "* How's the room?& &         Different   Same\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2524", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2561", "* Oh^1, that's a relief^1!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2562", "* That's all I need to&  continue my fantasies^1.&* Thank you^1, stranger./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2506", "* My mind is running wild^1!&* I haven't felt like this&  in a long time.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2567", "* So it's the same./");
ds_map_add(global.text_data_en, "SCR_TEXT_2568", "* The same.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2569", "* Same.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2570", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_2571", "* OK./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2507", "* Please leave./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2780", "* (It's a horse stable.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2781", "* (Do you want to go&  inside?)&         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2782", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2788", "* (You jostle the door.)&* (It's locked.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2789", "* (Suddenly^1, from inside&  the [redacted], you hear a&/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3358", "* (It's a book labelled&  Monster History Part 6.)&         Read it     Do not\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3359", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3363", "* Unfortunately^1, monsters are&  not experienced with&  illness./");
ds_map_add(global.text_data_en, "SCR_TEXT_3364", "* However^1, when monsters are&  about to expire of age^1,&  they lie down^1, immobile./");
ds_map_add(global.text_data_en, "SCR_TEXT_3365", "* We call this state&  \"Fallen Down.\"/");ds_map_add(global.text_data_en, "SCR_TEXT_3366", "* A person who has Fallen&  Down will soon perish./");
ds_map_add(global.text_data_en, "SCR_TEXT_3367", "* In a way^1, this confusing&  situation was all too&  familiar./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3370", "* (You decide not to read it.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4551", "* \YMETTATON has sent you a&  Mortal Enemy request.\W /");
ds_map_add(global.text_data_en, "SCR_TEXT_4552", "* Accept the request?& &         Accept      Reject\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4553", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4559", "* Congratulations^1!&* You are now Mortal Enemies&  with Mettaton./");
ds_map_add(global.text_data_en, "SCR_TEXT_4560", "* \YCOOLSKELETON95\W has posted&  a comment on this change./");
ds_map_add(global.text_data_en, "SCR_TEXT_4561", "* CONGRATULATIONS^1, YOU TWO^1!&* WISH YOU A LONG AND&  HORRIBLE RIVALRY./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4565", "* You rejected the request./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4571", "* \YMETTATON has sent you an&  invitation to \"Die.\"\W /");ds_map_add(global.text_data_en, "SCR_TEXT_4572", "* RSVP?& &         Respond     Ignore\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4573", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4579", "* Bepis valley Granola Bars/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4583", "* Bepis valley Granola Bars/%%");
