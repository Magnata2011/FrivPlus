ds_map_add(global.text_data_en, "scr_battlegroup_548", "* Icecap and Snowdrake&  confront you^1, sighing.&* Jerry.");
ds_map_add(global.text_data_en, "scr_battlegroup_549", "* Icecap and Chilldrake&  confront you^1, sighing.&* Jerry.");
