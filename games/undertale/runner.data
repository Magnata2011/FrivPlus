ds_map_add(global.text_data_en, "obj_papcheckpoint_108", "(UPDATE: AM I A&ROYAL GUARDSMAN&YET???)/%%");
ds_map_add(global.text_data_en, "obj_papcheckpoint_112", "* These instructions&  are written in&  chicken scratch./%%");
ds_map_add(global.text_data_en, "obj_papcomputer_63", "THE INTERNET^1!&I'M QUITE&POPULAR THERE./");
ds_map_add(global.text_data_en, "obj_papcomputer_64", "I'M JUST A&DOZEN AWAY.../");
ds_map_add(global.text_data_en, "obj_papcomputer_65", "FROM A DOUBLE&DIGIT FOLLOWER&COUNT!/");
ds_map_add(global.text_data_en, "obj_papcomputer_66", "\E3OF COURSE^1, FAME&HAS A STEEP&PRICE./");
ds_map_add(global.text_data_en, "obj_papcomputer_67", "\E1A JEALOUS TROLL&HAS BESIEGED MY&ONLINE PERSONA./");
ds_map_add(global.text_data_en, "obj_papcomputer_68", "ALWAYS SENDING&ME BAD PUNS IN&A GOOFY FONT.../%%/");
ds_map_add(global.text_data_en, "obj_papcomputer_73", "* (The computer's internet&  browser is opened to&  a social media site.)/%%");
ds_map_add(global.text_data_en, "obj_papcomputer_79", "* (The computer's internet&  browser is opened to&  a social media site.)/%%");
ds_map_add(global.text_data_en, "obj_papcomputer_84", "* (The computer's internet&  browser is opened to&  a music-sharing forum.)/%%");
ds_map_add(global.text_data_en, "obj_papcomputer_90", "* (Looks like this dog makes&  a lot of bad posts&  on-line.)/");
ds_map_add(global.text_data_en, "obj_papcomputer_91", "* (Text to speech is on.)/");
ds_map_add(global.text_data_en, "obj_papcomputer_92", "* (Seems like the dog barks^1,&  and it translates to these&  bad posts.)/");
ds_map_add(global.text_data_en, "obj_papcomputer_93", "* (It doesn't really know what&  it's saying.)/");
ds_map_add(global.text_data_en, "obj_papcomputer_94", "* (Seems like most bad posts&  on-line^1, are actually this&  dog.)/");
ds_map_add(global.text_data_en, "obj_papcomputer_95", "* (Thinking about this...^1)&* (Brings you relief.)/%%");
ds_map_add(global.text_data_en, "obj_papcouch_62", "* (You touch the couch.^1)&* (It makes a jangling sound.)/");
ds_map_add(global.text_data_en, "obj_papcouch_63", "* (You find a bunch of loose&  coins inside the couch...)/");
ds_map_add(global.text_data_en, "obj_papcouch_64", "* (You got 20G.)/%%");
ds_map_add(global.text_data_en, "obj_papcouch_70", "* (It's a saggy old couch.)/%%");
ds_map_add(global.text_data_en, "obj_papdate_150", "        DATING^1  START!^5 %%");
ds_map_add(global.text_data_en, "obj_papdate_151", "        HANGOUT^1 START!^5 %%");
ds_map_add(global.text_data_en, "obj_papdate_166", "HERE WE ARE!^1!&ON OUR DATE!!/");
ds_map_add(global.text_data_en, "obj_papdate_167", "HERE WE ARE!^1!&HANGING OUT!!/");
ds_map_add(global.text_data_en, "obj_papdate_169", "\E3I'VE ACTUALLY&NEVER DONE THIS&BEFORE./");
ds_map_add(global.text_data_en, "obj_papdate_170", "\E0BUT DON'T WORRY!!!/");
ds_map_add(global.text_data_en, "obj_papdate_171", "YOU CAN'T SPELL&'PREPARED' WITHOUT&SEVERAL LETTERS&FROM MY NAME!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_198", "I SNAGGED AN&OFFICIAL&DATING RULEBOOK&FROM THE LIBRARY!/");
ds_map_add(global.text_data_en, "obj_papdate_199", "I SNAGGED AN&OFFICIAL&HANGOUT GUIDEBOOK&FROM THE LIBRARY!/");
ds_map_add(global.text_data_en, "obj_papdate_201", "WE'RE READY TO&HAVE A GREAT&TIME!/");
ds_map_add(global.text_data_en, "obj_papdate_202", "\F4 \E8 %");
ds_map_add(global.text_data_en, "obj_papdate_203", "LET'S SEE.../");
ds_map_add(global.text_data_en, "obj_papdate_204", "\XSTEP ONE..^1. PRESS&THE [ C ] KEY ON&YOUR KEYBOARD FOR&\"\RDATING HUD\X.\"/");ds_map_add(global.text_data_en, "obj_papdate_205", "\XSTEP ONE..^1. PRESS&THE [ C ] KEY ON&YOUR KEYBOARD FOR&\"\RFRIENDSHIP HUD\X.\"/");ds_map_add(global.text_data_en, "obj_papdate_206", "\XSTEP ONE..^1. PRESS&YOUR CONTROLLER'S&\*C BUTTON FOR&\"\RDATING HUD\X.\"/");ds_map_add(global.text_data_en, "obj_papdate_207", "\XSTEP ONE..^1. PRESS&YOUR CONTROLLER'S&\*C BUTTON FOR&\"\RFRIENDSHIP HUD\X.\"/");ds_map_add(global.text_data_en, "obj_papdate_208", "\E3I THINK YOU&ALREADY DID&THAT.../%%");
ds_map_add(global.text_data_en, "obj_papdate_220", "\E3I THINK YOU&ALREADY DID&THAT.../%%");
ds_map_add(global.text_data_en, "obj_papdate_232", "\E3.../");
ds_map_add(global.text_data_en, "obj_papdate_233", "\E3OKAY^1, FORGET IT./%%");
ds_map_add(global.text_data_en, "obj_papdate_279", "\E0WOWIE!!^1!&I FEEL SO&INFORMED!!!/");
ds_map_add(global.text_data_en, "obj_papdate_280", " %");
ds_map_add(global.text_data_en, "obj_papdate_281", "I THINK WE'RE&READY FOR STEP&TWO!!!/");
ds_map_add(global.text_data_en, "obj_papdate_282", "\F4 \E8 %");
ds_map_add(global.text_data_en, "obj_papdate_283", "\"STEP TWO..^1.&ASK THEM&ON A DATE.\"/");ds_map_add(global.text_data_en, "obj_papdate_284", "\"STEP TWO..^1.&ASK THEM&TO HANG OUT.\"/");ds_map_add(global.text_data_en, "obj_papdate_286", "\E0A\F0HEM!/");
ds_map_add(global.text_data_en, "obj_papdate_287", "\E1HUMAN^1!&I^1, THE GREAT&PAPYRUS.../");
ds_map_add(global.text_data_en, "obj_papdate_288", "WILL GO ON&A DATE WITH&YOU!!!/*");
ds_map_add(global.text_data_en, "obj_papdate_289", "WILL HANG OUT&WITH YOU!!!/*");
ds_map_add(global.text_data_en, "obj_papdate_302", "                              &   Yes             No       &                            ");
ds_map_add(global.text_data_en, "obj_papdate_326", "R-REALLY??^1?&WOWIE!!!/");
ds_map_add(global.text_data_en, "obj_papdate_332", "FORTUNATELY^1, IT&ONLY SAYS TO&ASK!!!/");
ds_map_add(global.text_data_en, "obj_papdate_334", "\E0I GUESS THAT&MEANS IT'S&TIME FOR PART&THREE!!!/");
ds_map_add(global.text_data_en, "obj_papdate_335", "\F4 \E8 %");
ds_map_add(global.text_data_en, "obj_papdate_336", "\"STEP THREE..^1.&PUT ON NICE&CLOTHES TO&SHOW YOU CARE!\"/");ds_map_add(global.text_data_en, "obj_papdate_337", "\E3.../%%");
ds_map_add(global.text_data_en, "obj_papdate_357", "\E3WAIT A SECOND./%%");
ds_map_add(global.text_data_en, "obj_papdate_367", "\"WEAR CLOTHING...\"/");ds_map_add(global.text_data_en, "obj_papdate_369", "THAT THING ON&YOUR BODY.../");
ds_map_add(global.text_data_en, "obj_papdate_370", "THAT BANDAGE&HANGING OFF&OF YOU.../");
ds_map_add(global.text_data_en, "obj_papdate_371", "THAT RIBBON IN&YOUR HAIR.../");
ds_map_add(global.text_data_en, "obj_papdate_372", "THAT BANDANNA&AROUND YOUR&HEAD.../");
ds_map_add(global.text_data_en, "obj_papdate_373", "THAT TUTU AROUND&YOUR WAIST.../");
ds_map_add(global.text_data_en, "obj_papdate_374", "THOSE GLASSES ON&YOUR FACE.../");
ds_map_add(global.text_data_en, "obj_papdate_375", "THAT APRON YOU&PUT ON.../");
ds_map_add(global.text_data_en, "obj_papdate_376", "THAT COWBOY HAT&ON YOUR HEAD.../");
ds_map_add(global.text_data_en, "obj_papdate_377", "THAT LOCKET&AROUND YOUR NECK./");
ds_map_add(global.text_data_en, "obj_papdate_378", "\E1YOU'RE WEARING&CLOTHING RIGHT&NOW!!!/");
ds_map_add(global.text_data_en, "obj_papdate_379", "\E3NOT ONLY THAT.../");
ds_map_add(global.text_data_en, "obj_papdate_380", "\E1EARLIER TODAY^1,&YOU WERE ALSO&WEARING CLOTHING!/");
ds_map_add(global.text_data_en, "obj_papdate_381", "\F3 \E2 %");
ds_map_add(global.text_data_en, "obj_papdate_382", "NO..^1.&COULD IT BE???/");
ds_map_add(global.text_data_en, "obj_papdate_383", "\F0 \E1 %");
ds_map_add(global.text_data_en, "obj_papdate_386", "YOU'VE WANTED TO&DATE ME FROM&THE VERY&BEGINNING!??/*");
ds_map_add(global.text_data_en, "obj_papdate_389", "YOU'VE WANTED TO&HANG OUT WITH&ME FROM THE&VERY BEGINNING!??/*");
ds_map_add(global.text_data_en, "obj_papdate_404", "                              &   Yes             No       &                            ");
ds_map_add(global.text_data_en, "obj_papdate_453", "NO!!/");
ds_map_add(global.text_data_en, "obj_papdate_454", "YOU PLANNED IT&ALL!!!/");
ds_map_add(global.text_data_en, "obj_papdate_457", "YOU'RE WAY BETTER&AT DATING THAN&I AM!!!/");
ds_map_add(global.text_data_en, "obj_papdate_458", "\XN\E6-NOOOO!!!&YOUR \BDATING POWER\X &...!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_460", "YOU'RE WAY BETTER&AT HANGING OUT&THAN I AM!!!/");
ds_map_add(global.text_data_en, "obj_papdate_461", "\XN\E6-NOOOO!!!&YOUR \BFRIENDSHIP&POWER\X!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_465", "\E3DESPITE THAT^1, YOU&CHOSE TO WEAR&CLOTHING TODAY^1, OF&ALL DAYS...?/");
ds_map_add(global.text_data_en, "obj_papdate_468", "\E2WAS YOUR INTEREST&IN ME.../");
ds_map_add(global.text_data_en, "obj_papdate_469", "\XN\E6-NOOOO!!!&YOUR \BDATING POWER\X &...!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_470", "\E2WAS YOUR&FRIENDSHIP.../");
ds_map_add(global.text_data_en, "obj_papdate_471", "\XN\E6-NOOOO!!!&YOUR \BFRIENDSHIP&POWER\X!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_472", "\F3PREDESTINED!?!?/");
ds_map_add(global.text_data_en, "obj_papdate_520", "NYEH!/");
ds_map_add(global.text_data_en, "obj_papdate_521", "NYEH HEH HEH!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_535", "\F0DON'T THINK YOU'VE&BESTED ME YET!/");
ds_map_add(global.text_data_en, "obj_papdate_536", "I^1, THE GREAT&PAPYRUS.../");
ds_map_add(global.text_data_en, "obj_papdate_539", "HAVE NEVER BEEN&BEATEN AT DATING^1,&AND I NEVER WILL!/");
ds_map_add(global.text_data_en, "obj_papdate_540", "JUST IN CASE&SOMEBODY HAPPENS&TO ASK ME ON&A DATE!!!/");
ds_map_add(global.text_data_en, "obj_papdate_541", "HAVE NEVER BEEN&BEATEN AT HANGING&OUT^1, AND I NEVER&WILL!/");
ds_map_add(global.text_data_en, "obj_papdate_542", "JUST IN CASE&SOMEONE WANTS&TO HANG OUT!/");
ds_map_add(global.text_data_en, "obj_papdate_543", "\E0I CAN EASILY&KEEP UP WITH&YOU!!!/");
ds_map_add(global.text_data_en, "obj_papdate_544", "\E1YOU SEE^1,&I^1, TOO^1, CAN WEAR&CLOTHING!!!/");
ds_map_add(global.text_data_en, "obj_papdate_545", "\E3IN FACT.../");
ds_map_add(global.text_data_en, "obj_papdate_546", "\E1I ALWAYS WEAR MY&\"SPECIAL\" CLOTHES&UNDERNEATH MY&REGULAR CLOTHES!!/");ds_map_add(global.text_data_en, "obj_papdate_547", "\E0BEHOLD!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_573", "\E1NYEH!&WHAT DO YOU&THINK OF MY&SECRET STYLE!?!/*");
ds_map_add(global.text_data_en, "obj_papdate_586", "                              &   I love it       I hate it&                            ");
ds_map_add(global.text_data_en, "obj_papdate_611", "\E6NO!!!/");
ds_map_add(global.text_data_en, "obj_papdate_614", "A GENUINE&COMPLIMENT...!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_618", "YOUR HONESTY...^1!&IT SHOWS HOW&MUCH YOU REALLY&CARE!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_667", "\E3HOWEVER.../");
ds_map_add(global.text_data_en, "obj_papdate_668", "\XY\E0OU DON'T TRULY&UNDERSTAND THE\R &HIDDEN POWER\X OF&THIS OUTFIT!!!/");
ds_map_add(global.text_data_en, "obj_papdate_669", "\E3THEREFORE.../%%");
ds_map_add(global.text_data_en, "obj_papdate_679", "\E1WHAT YOU JUST&SAID IS INVALID!!!/");
ds_map_add(global.text_data_en, "obj_papdate_681", "THIS DATE WON'T&ESCALATE ANY&FURTHER!!!/");
ds_map_add(global.text_data_en, "obj_papdate_683", "THIS HANG-OUT&WON'T ESCALATE&ANY FURTHER!/");
ds_map_add(global.text_data_en, "obj_papdate_684", "\X.\E7.. UNLESS&YOU FIND \RMY&SECRET\X!!/");
ds_map_add(global.text_data_en, "obj_papdate_685", "BUT THAT WON'T&HAPPEN!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_705", "* (Move and inspect with \*Z.)");
ds_map_add(global.text_data_en, "obj_papdate_721", "\E3MY HAT...?/");
ds_map_add(global.text_data_en, "obj_papdate_722", "\E8MY HAT./");
ds_map_add(global.text_data_en, "obj_papdate_723", "\E0MY HAT!/");
ds_map_add(global.text_data_en, "obj_papdate_724", "NYEH HEH HEH!/%%");
ds_map_add(global.text_data_en, "obj_papdate_740", "W-WELL THEN..^1.&YOU FOUND MY&SECRET!/");
ds_map_add(global.text_data_en, "obj_papdate_741", "I SUPPOSE I HAVE&NO CHOICE!/");
ds_map_add(global.text_data_en, "obj_papdate_742", "IT'S A PRESENT.../");
ds_map_add(global.text_data_en, "obj_papdate_743", "A PRESENT J-JUST&FOR YOU!!!/");
ds_map_add(global.text_data_en, "obj_papdate_744", "GO AHEAD^1!&OPEN IT!/*");
ds_map_add(global.text_data_en, "obj_papdate_756", "                              &   Open it         Don't    &                            ");
ds_map_add(global.text_data_en, "obj_papdate_780", "\E2YOU CAN'T EVEN&BRING YOURSELF TO&HARM MY DELICATE&WRAPPING??/");
ds_map_add(global.text_data_en, "obj_papdate_781", "\E7N-NO..^1.&THAT TECHNIQUE!/");
ds_map_add(global.text_data_en, "obj_papdate_782", "\E6IT'S TOO STRONG!/");
ds_map_add(global.text_data_en, "obj_papdate_783", "\E7COUNTERATTACK^1!&I'LL OPEN THE&PRESENT MYSELF!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_802", "\E0DO YOU KNOW WHAT&THIS IS?/*");
ds_map_add(global.text_data_en, "obj_papdate_815", "                              &   Of course       No idea  &                            ");
ds_map_add(global.text_data_en, "obj_papdate_842", "\E0\"SPAGHETTI.\"/");ds_map_add(global.text_data_en, "obj_papdate_843", "\E3THAT'S WHAT&YOU'RE THINKING^1,&ISN'T IT?/");
ds_map_add(global.text_data_en, "obj_papdate_844", "\E0RIGHT!/");
ds_map_add(global.text_data_en, "obj_papdate_845", "\E1BUT OH-SO WRONG!/%%");
ds_map_add(global.text_data_en, "obj_papdate_849", "\E0NYEH HEH HEH^1!&THAT'S RIGHT./");
ds_map_add(global.text_data_en, "obj_papdate_850", "YOU HAVE NO IDEA!/");
ds_map_add(global.text_data_en, "obj_papdate_851", "\E3THOUGH THIS&APPEARS TO BE&SPAGHETTI.../%%");
ds_map_add(global.text_data_en, "obj_papdate_864", "\E1THIS AIN'T ANY&PLAIN OL' PASTA!/");
ds_map_add(global.text_data_en, "obj_papdate_865", "\E0THIS IS AN&ARTISAN'S WORK!/");
ds_map_add(global.text_data_en, "obj_papdate_866", "\E3SILKEN SPAGHETTI^1,&FINELY AGED IN&AN OAKEN CASK.../");
ds_map_add(global.text_data_en, "obj_papdate_867", "\E0THEN COOKED BY&ME^1, MASTER CHEF&PAPYRUS!/");
ds_map_add(global.text_data_en, "obj_papdate_868", "\E1HUMAN!!^1!&IT'S TIME TO&END THIS!!/");
ds_map_add(global.text_data_en, "obj_papdate_869", "THERE'S NO WAY&THIS CAN GO&ANY FURTHER!/");
ds_map_add(global.text_data_en, "obj_papdate_870", "EAT THIS^1!&MY ULTIMATE&TECHNIQUE!!!/*");
ds_map_add(global.text_data_en, "obj_papdate_885", "                              &   Eat it          Refuse   &                            ");
ds_map_add(global.text_data_en, "obj_papdate_911", "* (You take a small bite.)/");
ds_map_add(global.text_data_en, "obj_papdate_912", "* (Your face reflexively&  scrunches up.)/");
ds_map_add(global.text_data_en, "obj_papdate_913", "* (The taste is indescribable...)/%%");
ds_map_add(global.text_data_en, "obj_papdate_928", "\E0WHAT A PASSIONATE&EXPRESSION!!!/");
ds_map_add(global.text_data_en, "obj_papdate_929", "\E3YOU MUST REALLY&LOVE MY COOKING!/");
ds_map_add(global.text_data_en, "obj_papdate_930", "\E2AND BY EXTENSION^1,&ME!!!/");
ds_map_add(global.text_data_en, "obj_papdate_931", "\E6MAYBE EVEN MORE&THAN I DO!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_935", "\E3YOU MEAN.../");
ds_map_add(global.text_data_en, "obj_papdate_936", "\E2YOU'RE LETTING ME&HAVE IT INSTEAD?/");
ds_map_add(global.text_data_en, "obj_papdate_937", "\E2BECAUSE YOU KNOW&HOW MUCH I LOVE&PASTA.../");
ds_map_add(global.text_data_en, "obj_papdate_938", "\E6IMPOSSIBLE!^1!&TAKING MY PRESENT&AND TURNING IT&AROUND ON ME!/%%");
ds_map_add(global.text_data_en, "obj_papdate_948", "AUGH!!^5!%%");
ds_map_add(global.text_data_en, "obj_papdate_967", "URRRGH!!^5!%%");
ds_map_add(global.text_data_en, "obj_papdate_987", "NOOOOOOOO!!^4!%%");
ds_map_add(global.text_data_en, "obj_papdate_1021", "HUMAN^1.&IT'S CLEAR NOW./");
ds_map_add(global.text_data_en, "obj_papdate_1022", "YOU'RE MADLY IN&LOVE WITH ME./");
ds_map_add(global.text_data_en, "obj_papdate_1023", "EVERYTHING YOU DO^1.&EVERYTHING&YOU SAY./");
ds_map_add(global.text_data_en, "obj_papdate_1024", "IT'S ALL BEEN&FOR MY SAKE./");
ds_map_add(global.text_data_en, "obj_papdate_1025", "HUMAN^1. I WANT&YOU TO BE&HAPPY^1, TOO./");
ds_map_add(global.text_data_en, "obj_papdate_1026", "IT'S TIME FOR ME&TO EXPRESS MY&FEELINGS./");
ds_map_add(global.text_data_en, "obj_papdate_1027", "IT'S TIME THAT&I TOLD YOU./");
ds_map_add(global.text_data_en, "obj_papdate_1028", "I^1, PAPYRUS.../%%");
ds_map_add(global.text_data_en, "obj_papdate_1032", "HUMAN^1.&IT'S CLEAR NOW./");
ds_map_add(global.text_data_en, "obj_papdate_1033", "YOU'RE COMPLETELY&OBSESSED WITH ME./");
ds_map_add(global.text_data_en, "obj_papdate_1034", "EVERYTHING YOU DO^1.&EVERYTHING&YOU SAY./");
ds_map_add(global.text_data_en, "obj_papdate_1035", "IT'S ALL BEEN&FOR MY SAKE./");
ds_map_add(global.text_data_en, "obj_papdate_1036", "HUMAN^1. I WANT&YOU TO BE&HAPPY^1,TOO./");
ds_map_add(global.text_data_en, "obj_papdate_1037", "IT'S TIME FOR ME&TO EXPRESS MY&FEELINGS./");
ds_map_add(global.text_data_en, "obj_papdate_1038", "IT'S TIME THAT&I TOLD YOU./");
ds_map_add(global.text_data_en, "obj_papdate_1039", "\E8I^1, PAPYRUS.../%%");
ds_map_add(global.text_data_en, "obj_papdate_1079", "I.../");
ds_map_add(global.text_data_en, "obj_papdate_1080", "UM.../");
ds_map_add(global.text_data_en, "obj_papdate_1081", "\E4BOY^1, IS IT HOT&IN HERE^1, OR IS&IT JUST ME??/");
ds_map_add(global.text_data_en, "obj_papdate_1082", "\E4.../");
ds_map_add(global.text_data_en, "obj_papdate_1083", "\E5OH^1, SHOOT./");
ds_map_add(global.text_data_en, "obj_papdate_1084", "HUMAN^1, I.../");
ds_map_add(global.text_data_en, "obj_papdate_1085", "I'M SORRY./");
ds_map_add(global.text_data_en, "obj_papdate_1086", "I DON'T LIKE YOU&THE WAY YOU&LIKE ME./");
ds_map_add(global.text_data_en, "obj_papdate_1087", "\E4ROMANTICALLY^1,&I MEAN./");
ds_map_add(global.text_data_en, "obj_papdate_1088", "\E6I MEAN^1, I TRIED&VERY HARD TO!/");
ds_map_add(global.text_data_en, "obj_papdate_1089", "\E8I THOUGHT THAT&BECAUSE YOU&FLIRTED WITH ME.../");
ds_map_add(global.text_data_en, "obj_papdate_1090", "THAT I WAS&SUPPOSED&TO GO ON A&DATE WITH YOU./");
ds_map_add(global.text_data_en, "obj_papdate_1091", "\E0THEN^1, ON THE DATE^1,&FEELINGS WOULD&BLOSSOM FORTH!!!/");
ds_map_add(global.text_data_en, "obj_papdate_1092", "\E2I WOULD BE ABLE&TO MATCH YOUR&PASSION FOR ME!/");
ds_map_add(global.text_data_en, "obj_papdate_1093", "\E4BUT ALAS..^1.&I^1, THE GREAT&PAPYRUS.../");
ds_map_add(global.text_data_en, "obj_papdate_1094", "\E5HAVE FAILED./");
ds_map_add(global.text_data_en, "obj_papdate_1095", "I FEEL JUST THE&SAME AS BEFORE./");
ds_map_add(global.text_data_en, "obj_papdate_1096", "AND INSTEAD^1, BY&DATING YOU.../");
ds_map_add(global.text_data_en, "obj_papdate_1097", "I HAVE ONLY DRAWN&YOU DEEPER.../");
ds_map_add(global.text_data_en, "obj_papdate_1098", "\E6INTO YOUR INTENSE&LOVE FOR ME!/");
ds_map_add(global.text_data_en, "obj_papdate_1099", "\E5A DARK PRISON OF&PASSION^1, WITH NO&ESCAPE./");
ds_map_add(global.text_data_en, "obj_papdate_1100", "HOW COULD I HAVE&DONE THIS TO MY&DEAR FRIEND...?/");
ds_map_add(global.text_data_en, "obj_papdate_1101", ".../");
ds_map_add(global.text_data_en, "obj_papdate_1102", "\E6NO^1! WAIT^1!&THAT'S WRONG!/");
ds_map_add(global.text_data_en, "obj_papdate_1103", "I CAN'T FAIL AT&ANYTHING!!!/");
ds_map_add(global.text_data_en, "obj_papdate_1104", "\E1HUMAN!!^1!&I'LL HELP YOU&THROUGH THESE&TRYING TIMES!!!/");
ds_map_add(global.text_data_en, "obj_papdate_1105", "\E0I'LL KEEP BEING&YOUR COOL&FRIEND.../");
ds_map_add(global.text_data_en, "obj_papdate_1106", "\E8AND ACT LIKE THIS&ALL NEVER&HAPPENED./");
ds_map_add(global.text_data_en, "obj_papdate_1107", "\E0AFTER ALL^1, YOU&ARE VERY GREAT./");
ds_map_add(global.text_data_en, "obj_papdate_1108", "\E5IT WOULD BE&TRAGIC TO LOSE&YOUR FRIENDSHIP./");
ds_map_add(global.text_data_en, "obj_papdate_1109", "\E0SO PLEASE..../");
ds_map_add(global.text_data_en, "obj_papdate_1110", "\E5DON'T CRY BECAUSE&I WON'T KISS YOU./");
ds_map_add(global.text_data_en, "obj_papdate_1111", "\E4BECAUSE^1, I DON'T&EVEN HAVE LIPS./");
ds_map_add(global.text_data_en, "obj_papdate_1112", "\E0AND HEY^1, SOMEDAY^1,&YOU'LL FIND&SOMEONE AS&GREAT AS ME./");
ds_map_add(global.text_data_en, "obj_papdate_1113", "\E8WELL, NO^1.&THAT'S NOT TRUE./");
ds_map_add(global.text_data_en, "obj_papdate_1114", "\E0BUT I'LL HELP YOU&SETTLE FOR&SECOND BEST!!!/");
ds_map_add(global.text_data_en, "obj_papdate_1115", "NYEH HEH HEH&HEH HEH!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_1121", "\E8HMM.../");
ds_map_add(global.text_data_en, "obj_papdate_1122", "\E0WELL^1, I'M FLATTERED&YOU CARE SO MUCH./");
ds_map_add(global.text_data_en, "obj_papdate_1123", "\E4BUT MAYBE COOL&IT A LITTLE BIT...?/");
ds_map_add(global.text_data_en, "obj_papdate_1124", "\E0YOU ARE A VERY&NICE PERSON./");
ds_map_add(global.text_data_en, "obj_papdate_1125", "I'M GLAD WE'RE&FRIENDS./");
ds_map_add(global.text_data_en, "obj_papdate_1126", "\E8BUT^1, I THINK YOU&CAN REACH YOUR&MAX POTENTIAL,,,/");
ds_map_add(global.text_data_en, "obj_papdate_1127", "\E0IF YOU LIVE MORE&FOR YOUR OWN SAKE^1,&RATHER THAN JUST&FOR MINE./");
ds_map_add(global.text_data_en, "obj_papdate_1128", "\E8HMMM.../");
ds_map_add(global.text_data_en, "obj_papdate_1129", "\E0HEY^1, I KNOW THE&SOLUTION!!!/");
ds_map_add(global.text_data_en, "obj_papdate_1130", "YOU SHOULD HANG&OUT WITH MY BOSS^1,&UNDYNE!!!/");
ds_map_add(global.text_data_en, "obj_papdate_1131", "I THINK IF YOU&SPREAD YOUR FRIEND-&ENERGY OUT MORE.../");
ds_map_add(global.text_data_en, "obj_papdate_1132", "YOU'LL HAVE A MORE&HEALTHY LIFESTYLE./");
ds_map_add(global.text_data_en, "obj_papdate_1133", "YEAH!!^1!&LET'S BE FRIENDS&WITH UNDYNE!!!/");
ds_map_add(global.text_data_en, "obj_papdate_1134", "NYEH HEH HEH&HEH HEH!!!/%%");
ds_map_add(global.text_data_en, "obj_papdate_1175", "OH^1, AND IF YOU&EVER NEED TO&REACH ME.../");
ds_map_add(global.text_data_en, "obj_papdate_1176", "\XHERE'S MY \RPHONE&NUMBER\X./");
ds_map_add(global.text_data_en, "obj_papdate_1177", "YOU CAN CALL&ME ANY TIME!/");
ds_map_add(global.text_data_en, "obj_papdate_1178", "\E4PLATONICALLY./");
ds_map_add(global.text_data_en, "obj_papdate_1179", "\E0WELL^1, GOTTA GO^1!&NYEH HEH HEH!/%%");
ds_map_add(global.text_data_en, "obj_papfridge_71", "AH-HA^1!&INTERESTED IN&MY FOOD MUSEUM?/");
ds_map_add(global.text_data_en, "obj_papfridge_72", "PLEASE^1.&PERUSE MY&CULINARY ARTSHOW./");
ds_map_add(global.text_data_en, "obj_papfridge_73", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_papfridge_74", "* (Half of the fridge is&  filled with containers&  all labelled \"spaghetti.\")/");ds_map_add(global.text_data_en, "obj_papfridge_75", "* (The other half contains&  nothing but an empty&  bag of chips.)/%%");
ds_map_add(global.text_data_en, "obj_papfridge_77", "GREAT FRIDGE^1,&ISN'T IT?/%%");
ds_map_add(global.text_data_en, "obj_papfridge_81", "* (Half of the fridge is&  filled with containers&  all labelled \"spaghetti.\")/");ds_map_add(global.text_data_en, "obj_papfridge_82", "* (The other half contains&  nothing but an empty&  bag of chips.)/%%");
ds_map_add(global.text_data_en, "obj_paphouse_entrance_91", "* (It's locked.)/%%");
ds_map_add(global.text_data_en, "obj_paphouse_entrance_96", "WOW^1, YOU'RE SO&EAGER TO DATE&ME.../");
ds_map_add(global.text_data_en, "obj_paphouse_entrance_97", "WOW^1, YOU'RE SO&EAGER TO HANG&OUT.../");
ds_map_add(global.text_data_en, "obj_paphouse_entrance_98", "YOU'RE TRYING TO&GO INTO MY HOUSE&WITHOUT ME!/");
ds_map_add(global.text_data_en, "obj_paphouse_entrance_99", "THAT'S REALLY&WEIRD!!!/%%");
ds_map_add(global.text_data_en, "obj_paphouse_entrance_103", "* (It's unlocked.)/%%");
ds_map_add(global.text_data_en, "obj_papmailbox_74", "HOW NICE OF YOU&TO CHECK MY MAIL&FOR ME./");
ds_map_add(global.text_data_en, "obj_papmailbox_75", "\E3WAIT^1, NO^1.&THAT'S VERY&STRANGE./%%");
ds_map_add(global.text_data_en, "obj_papmailbox_78", "\E3STOP LOOKING IN&MY EMPTY&MAILBOX./");
ds_map_add(global.text_data_en, "obj_papmailbox_79", "\E0THAT'S MY&EMPTINESS^1, NOT&YOURS./%%");
ds_map_add(global.text_data_en, "obj_papmailbox_96", "* Oh my god^1!&* The letter's not&  to PAPYRUS!!!/");
ds_map_add(global.text_data_en, "obj_papmailbox_98", "YEAH^1, UNDYNE'S&GOT A POINT!/");
ds_map_add(global.text_data_en, "obj_papmailbox_99", "\E0WHY DIDN'T SHE&WRITE A LETTER&TO ME INSTEAD?/");
ds_map_add(global.text_data_en, "obj_papmailbox_101", "* Fine^1, you want a&  letter!?/");
ds_map_add(global.text_data_en, "obj_papmailbox_102", "* I'll give you a&  letter!!!/");
ds_map_add(global.text_data_en, "obj_papmailbox_103", "\E6* YOU GET AN \"F\"!/");ds_map_add(global.text_data_en, "obj_papmailbox_105", "OH NO!!!/");
ds_map_add(global.text_data_en, "obj_papmailbox_106", "\E3WHAT'S THE F&FOR?/");
ds_map_add(global.text_data_en, "obj_papmailbox_108", "* Friendship!!!/%%");
ds_map_add(global.text_data_en, "obj_papsink_100", "IMPRESSED^1?&I INCREASED THE&HEIGHT OF MY SINK./");
ds_map_add(global.text_data_en, "obj_papsink_101", "NOW I CAN FIT MORE&BONES UNDER IT^1!&TAKE A LOOKSY!/%%");
ds_map_add(global.text_data_en, "obj_papsink_106", "FORGET IT./%%");
ds_map_add(global.text_data_en, "obj_papsink_111", "* (This sink is so tall^1, you&  can't even wash your&  hands...)/%%");
ds_map_add(global.text_data_en, "obj_papsink_234", "WHAT!?!?/%%");
ds_map_add(global.text_data_en, "obj_papsink_244", "CATCH THAT&MEDDLING CANINE!/%%");
ds_map_add(global.text_data_en, "obj_papsink_284", "CURSES!!!/%%");
ds_map_add(global.text_data_en, "obj_papsink_313", "SANS!/");
ds_map_add(global.text_data_en, "obj_papsink_314", "STOP PLAGUING MY&LIFE WITH INCIDENTAL&MUSIC!!!/%%");
ds_map_add(global.text_data_en, "obj_papstove_71", "* (There's an empty pie tin&  inside the stove.)/%%");
ds_map_add(global.text_data_en, "obj_papstove_75", "\E0MY BROTHER ALWAYS&GOES OUT TO EAT^1.&BUT.../");
ds_map_add(global.text_data_en, "obj_papstove_76", "\E3RECENTLY^1, HE TRIED&'BAKING' SOMETHING./");
ds_map_add(global.text_data_en, "obj_papstove_77", "IT WAS LIKE..^1.&A QUICHE./");
ds_map_add(global.text_data_en, "obj_papstove_78", "BUT FILLED WITH A&SUGARY^1, NON-EGG&SUBSTANCE./");
ds_map_add(global.text_data_en, "obj_papstove_79", "\E0HOW ABSURD!/%%");
ds_map_add(global.text_data_en, "obj_papstove_82", "* (There's an empty pie tin&  inside the stove.)/%%");
ds_map_add(global.text_data_en, "obj_paptrash_68", "* (You visited the trash&  can.)/%%");
ds_map_add(global.text_data_en, "obj_paptrash_72", "THAT'S THE TRASH&CAN./");
ds_map_add(global.text_data_en, "obj_paptrash_73", "FEEL FREE TO VISIT&IT ANY TIME./%%");
ds_map_add(global.text_data_en, "obj_paptv_152", "\E0OOH, IT'S MY&FAVORITE&GAME-SHOW!/");
ds_map_add(global.text_data_en, "obj_paptv_153", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_paptv_154", "* (It says \"STAY TUNED FOR&  A NEW PROGRAM - MTT.\")/");ds_map_add(global.text_data_en, "obj_paptv_156", "\E1WHAT!!^1!&IT'S USUALLY&BETTER THAN THIS!/");
ds_map_add(global.text_data_en, "obj_paptv_157", "\E2THIS IS JUST&A BAD EPISODE!!^1!&DON'T JUDGE ME!!!/%%");
ds_map_add(global.text_data_en, "obj_paptv_159", "* (It says \"STAY TUNED FOR&  A NEW PROGRAM - MTT.\")/%%");ds_map_add(global.text_data_en, "obj_paptv_160", "* (It says \"STAY TUNED FOR&  A NEW PROGRAM - MTT.\")/%%");ds_map_add(global.text_data_en, "obj_papyrus1_407", "SO^1, AS I&WAS SAYING&ABOUT UNDYNE,/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_411", "\E2SO SANS^1!&WHEN'S THE HUMAN&SHOWING UP???/");
ds_map_add(global.text_data_en, "obj_papyrus1_412", "\E3I WANT TO LOOK&MY SUNDAY BEST.../");
ds_map_add(global.text_data_en, "obj_papyrus1_413", "\E0OR AT LEAST MY&TUESDAY&PRETTY-GOOD./");
ds_map_add(global.text_data_en, "obj_papyrus1_415", "\E1* don't you only have&  one outfit?/");
ds_map_add(global.text_data_en, "obj_papyrus1_417", "\E2YEAH^1, BUT I COULD&STYLE MY HAIR!/");
ds_map_add(global.text_data_en, "obj_papyrus1_419", "\E0* oh^1. right^1.&* good idea./");
ds_map_add(global.text_data_en, "obj_papyrus1_420", "\E1* say^1, why don't you&  look over there?/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_443", "SANS!!&OH MY GOD!!&IS THAT.../");
ds_map_add(global.text_data_en, "obj_papyrus1_444", "A HUMAN!?!?&!??!?!/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_453", "SANS!!&OH MY GOD!!&IS THAT.../");
ds_map_add(global.text_data_en, "obj_papyrus1_454", "A HUMAN!?!?&!??!?!/");
ds_map_add(global.text_data_en, "obj_papyrus1_455", "AND IT LOOKS SO&FAMILIAR...!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_459", "\E0SANS!!^1!&OH MY GOD!!!!/");
ds_map_add(global.text_data_en, "obj_papyrus1_460", "\E3I'M DIZZY^1.&WHAT AM I LOOKING&AT?/");
ds_map_add(global.text_data_en, "obj_papyrus1_462", "\E1* behold./%%");
ds_map_add(global.text_data_en, "obj_papyrus1_496", "* uhhhh.../");
ds_map_add(global.text_data_en, "obj_papyrus1_497", "\E1* actually^1, i think that's&  a rock./%%");
ds_map_add(global.text_data_en, "obj_papyrus1_500", "* uhhhh..^1.&* i think it looks&  familiar.../");
ds_map_add(global.text_data_en, "obj_papyrus1_501", "\E1* because it's a rock?/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_509", "\E0OH MY GOD!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_532", "OH^1./%%");
ds_map_add(global.text_data_en, "obj_papyrus1_534", "WHY ARE YOU&TELLING ME TO&LOOK AT A ROCK./%%");
ds_map_add(global.text_data_en, "obj_papyrus1_547", "* hey^1, what's that in&  front of the rock?/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_567", "OH MY GOD!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_579", "(IS... IS THAT&A HUMAN)/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_581", "I HAVE NO IDEA&WHAT THAT IS./%%");
ds_map_add(global.text_data_en, "obj_papyrus1_592", "(yes)/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_594", "* well^1.&* it's not a rock./%%");
ds_map_add(global.text_data_en, "obj_papyrus1_607", "OH MY GOD!!!/");
ds_map_add(global.text_data_en, "obj_papyrus1_608", "SANS!&I FINALLY&DID IT!!/");
ds_map_add(global.text_data_en, "obj_papyrus1_609", "UNDYNE WILL.../");
ds_map_add(global.text_data_en, "obj_papyrus1_610", "I'M GONNA.../");
ds_map_add(global.text_data_en, "obj_papyrus1_611", "I'LL BE SO.../");
ds_map_add(global.text_data_en, "obj_papyrus1_612", "POPULAR!!^1!&POPULAR!!^1!&POPULAR!!^1!/");
ds_map_add(global.text_data_en, "obj_papyrus1_613", "\E3..^1.'AHEM'/");
ds_map_add(global.text_data_en, "obj_papyrus1_614", "\E1HUMAN^1! YOU&SHALL NOT PASS&THIS AREA!/");
ds_map_add(global.text_data_en, "obj_papyrus1_615", "I^1, THE GREAT&PAPYRUS^1, WILL&STOP YOU!!!/");
ds_map_add(global.text_data_en, "obj_papyrus1_616", "I WILL THEN&CAPTURE YOU!/");
ds_map_add(global.text_data_en, "obj_papyrus1_617", "YOU WILL BE&DELIVERED TO&THE CAPITAL!/");
ds_map_add(global.text_data_en, "obj_papyrus1_618", "THEN..^1.&THEN!!^1!/");
ds_map_add(global.text_data_en, "obj_papyrus1_619", "\E3I'M NOT SURE&WHAT'S NEXT./");
ds_map_add(global.text_data_en, "obj_papyrus1_620", "\E1IN ANY CASE!/");
ds_map_add(global.text_data_en, "obj_papyrus1_621", "CONTINUE...&ONLY IF YOU&DARE!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_624", "\E3NOT A ROCK...?/");
ds_map_add(global.text_data_en, "obj_papyrus1_625", "\E0OH NO!!^1!&BY PROCESS OF&ELIMINATION!!!/");
ds_map_add(global.text_data_en, "obj_papyrus1_626", "\E0THAT MEANS IT'S&A HUMAN!!!/");
ds_map_add(global.text_data_en, "obj_papyrus1_627", "\E3AHEM!^1!&HUMAN!!/");
ds_map_add(global.text_data_en, "obj_papyrus1_628", "\E4PREPARE YOURSELF!^1!&FOR HIGH JINKS^1!&FOR LOW JINKS!/");
ds_map_add(global.text_data_en, "obj_papyrus1_629", "DANGERS^1!&PUZZLES^1!&CAPERS^1! JAPERS!/");
ds_map_add(global.text_data_en, "obj_papyrus1_630", "BEING CAPTURED!^1!&AND OTHER SORTS OF&FUN ACTIVITIES./");
ds_map_add(global.text_data_en, "obj_papyrus1_631", "REFRESHMENTS WILL&BE PROVIDED.../");
ds_map_add(global.text_data_en, "obj_papyrus1_632", "IF YOU DARE!/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_647", "NYEH HEH HEH&HEH HEH HEH&HEH HEH!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus1_667", "* well^1, that went well./");
ds_map_add(global.text_data_en, "obj_papyrus1_668", "* don't sweat it^1, kid./");
ds_map_add(global.text_data_en, "obj_papyrus1_669", "\E2* i'll keep an eyesocket&  out for ya./%%");
ds_map_add(global.text_data_en, "obj_papyrus1_672", "* ... and you don't even&  bat an eye^1, huh?/%%");
ds_map_add(global.text_data_en, "obj_papyrus2_201", "YOU'RE SO&LAZY!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_202", "YOU WERE&NAPPING&ALL NIGHT!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_204", "* i think that's called.../");
ds_map_add(global.text_data_en, "obj_papyrus2_205", "\E1* sleeping./");
ds_map_add(global.text_data_en, "obj_papyrus2_207", "EXCUSES^1,&EXCUSES!/%%");
ds_map_add(global.text_data_en, "obj_papyrus2_213", "REALLY THOUGH!!^1!&THAT HUMAN!!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_214", "\E2DO I KNOW THAT&PERSON???/");
ds_map_add(global.text_data_en, "obj_papyrus2_216", "* do you not know.../");
ds_map_add(global.text_data_en, "obj_papyrus2_217", "\E1* who you know?/");
ds_map_add(global.text_data_en, "obj_papyrus2_219", "PBPBPPBPT!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_220", "OF COURSE I KNOW&WHO I KNOW!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_221", "I WANTED TO KNOW IF&YOU KNOW.../");
ds_map_add(global.text_data_en, "obj_papyrus2_222", "I KNOW WHO I KNOW&AS MUCH AS I KNOW&I KNOW WHO I KNOW!/");
ds_map_add(global.text_data_en, "obj_papyrus2_223", "\E2...YOU KNOW?/%%");
ds_map_add(global.text_data_en, "obj_papyrus2_256", "OH-HO^1!&THE HUMAN&ARRIVES!/");
ds_map_add(global.text_data_en, "obj_papyrus2_259", "OH-HO^1!&SPEAK OF THE DEVIL!/");
ds_map_add(global.text_data_en, "obj_papyrus2_261", "IN ORDER TO&STOP YOU^1.../");
ds_map_add(global.text_data_en, "obj_papyrus2_262", "MY BROTHER AND&I HAVE CREATED&SOME PUZZLES!/");
ds_map_add(global.text_data_en, "obj_papyrus2_263", "I THINK YOU&WILL FIND&THIS ONE.../");
ds_map_add(global.text_data_en, "obj_papyrus2_264", "\E2QUITE&SHOCKING!!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_265", "\E0FOR YOU SEE^1,&THIS IS THE&INVISIBLE.../");
ds_map_add(global.text_data_en, "obj_papyrus2_266", "ELECTRICITY&MAZE!!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_267", "WHEN YOU TOUCH&THE WALLS OF&THIS MAZE,/");
ds_map_add(global.text_data_en, "obj_papyrus2_268", "THIS ORB WILL&ADMINISTER A&HEARTY ZAP!/");
ds_map_add(global.text_data_en, "obj_papyrus2_269", "\E2SOUND LIKE&FUN???/");
ds_map_add(global.text_data_en, "obj_papyrus2_270", "BECAUSE!/");
ds_map_add(global.text_data_en, "obj_papyrus2_271", "THE AMOUNT OF&FUN YOU WILL&PROBABLY HAVE,/");
ds_map_add(global.text_data_en, "obj_papyrus2_272", "\E3IS ACTUALLY&RATHER SMALL&I THINK./");
ds_map_add(global.text_data_en, "obj_papyrus2_273", "\E0OK^1, YOU CAN&GO AHEAD NOW./%%");
ds_map_add(global.text_data_en, "obj_papyrus2_334", "SANS!!^1!&WHAT DID YOU&DO?!?!/%%");
ds_map_add(global.text_data_en, "obj_papyrus2_347", "* i think the human&  has to hold the orb./%%");
ds_map_add(global.text_data_en, "obj_papyrus2_359", "OH^1, OKAY./%%");
ds_map_add(global.text_data_en, "obj_papyrus2_396", "HOLD THIS PLEASE!/%%");
ds_map_add(global.text_data_en, "obj_papyrus2_430", "OKAY^1, TRY NOW!/%%");
ds_map_add(global.text_data_en, "obj_papyrus2_452", "\E1INCREDIBLE!!&YOU SLIPPERY&SNAIL!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_453", "\E3YOU SOLVED IT&SO EASILY..^1.&TOO EASILY!/");
ds_map_add(global.text_data_en, "obj_papyrus2_454", "\E0HOWEVER!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_455", "THE NEXT&PUZZLE WILL&NOT BE EASY!/");
ds_map_add(global.text_data_en, "obj_papyrus2_456", "IT IS DESIGNED&BY MY BROTHER^1,&SANS!/");
ds_map_add(global.text_data_en, "obj_papyrus2_457", "YOU WILL&SURELY BE&CONFOUNDED!/");
ds_map_add(global.text_data_en, "obj_papyrus2_458", "I KNOW I AM!/");
ds_map_add(global.text_data_en, "obj_papyrus2_459", "NYEH HEH HEH&HEH HEH!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus2_506", "OH-HO^1!&THE HUMAN&ARRIVES!/");
ds_map_add(global.text_data_en, "obj_papyrus2_507", "IN ORDER TO&STOP YOU^1.../");
ds_map_add(global.text_data_en, "obj_papyrus2_508", "MY BROTHER AND&I HAVE CREATED&SOME PUZZLES!/");
ds_map_add(global.text_data_en, "obj_papyrus2_509", "I THINK YOU&WILL FIND&THIS ONE.../");
ds_map_add(global.text_data_en, "obj_papyrus2_510", "\E2QUITE&SHOCKING!!!/");
ds_map_add(global.text_data_en, "obj_papyrus2_511", "\E5FOR YOU SEE^1,&THIS IS..^1.&THE^1, INVISIBLE.../%%");
ds_map_add(global.text_data_en, "obj_papyrus2_552", "\E5UHHHHHHH...?/");
ds_map_add(global.text_data_en, "obj_papyrus2_553", "\E3HMMM..^1. YOU MUST&BE HAVING&CULTURE SHOCK./");
ds_map_add(global.text_data_en, "obj_papyrus2_554", "\E0YOU SEE^1, WHERE I&COME FROM^1, IT'S&A LOVING TRADITION./");
ds_map_add(global.text_data_en, "obj_papyrus2_555", "TO SUFFER THROUGH&HORRIBLE PUZZLES&FOR NO REASON./");
ds_map_add(global.text_data_en, "obj_papyrus2_556", "\E5SO^1, UH^1, JUST&WALK BACK THERE^1,&AND.../");
ds_map_add(global.text_data_en, "obj_papyrus2_557", ".../%%");
ds_map_add(global.text_data_en, "obj_papyrus2_601", "\E3SIGH.../");
ds_map_add(global.text_data_en, "obj_papyrus2_602", "\E3WHY COULDN'T WE GET&A HUMAN THAT LIKES&PUZZLES???/%%");
ds_map_add(global.text_data_en, "obj_papyrus3_177", "HUMAN!!^1!&I HOPE YOU'RE&READY FOR.../%%");
ds_map_add(global.text_data_en, "obj_papyrus3_200", "SANS!^1!&WHERE'S THE&PUZZLE!!!/");
ds_map_add(global.text_data_en, "obj_papyrus3_202", "* it's right there^1.&* on the ground./");
ds_map_add(global.text_data_en, "obj_papyrus3_203", "\E1* trust me^1.&* there's no way they can&  get past this one./%%");
ds_map_add(global.text_data_en, "obj_papyrus3_206", "\E1* trust me^1.&* there's no way they'll&  skip this one./%%");
ds_map_add(global.text_data_en, "obj_papyrus3_245", "WHAT THE HECK!!^1!&THEY DIDN'T SKIP&IT!?!?/");
ds_map_add(global.text_data_en, "obj_papyrus3_247", "* i'm tellin' ya^1.&* everyone likes word&  searches./");
ds_map_add(global.text_data_en, "obj_papyrus3_249", "OH MY GOD!!!/");
ds_map_add(global.text_data_en, "obj_papyrus3_250", "I CAN'T WORK IN&THIS ENVIRONMENT!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus3_254", "SANS!!^1!&THAT DID NOTHING!!!/");
ds_map_add(global.text_data_en, "obj_papyrus3_256", "* whoops./");
ds_map_add(global.text_data_en, "obj_papyrus3_257", "\E2* knew i should have&  put down junior jumble&  instead./");
ds_map_add(global.text_data_en, "obj_papyrus3_259", "WHAT?!^1?&JUNIOR JUMBLE!?/");
ds_map_add(global.text_data_en, "obj_papyrus3_260", "\E0FINALLY^1, SOMETHING&WE CAN BOTH&AGREE ON./%%");
ds_map_add(global.text_data_en, "obj_papyrus4_209", "HEY!/");
ds_map_add(global.text_data_en, "obj_papyrus4_210", "IT'S THE HUMAN!/");
ds_map_add(global.text_data_en, "obj_papyrus4_211", "\E0YOU'RE GONNA&LOVE THIS&PUZZLE!/");
ds_map_add(global.text_data_en, "obj_papyrus4_212", "IT WAS MADE&BY THE GREAT.../%%");
ds_map_add(global.text_data_en, "obj_papyrus4_405", "\E3... ARE YOU&SERIOUS?/");
ds_map_add(global.text_data_en, "obj_papyrus4_406", "\E1SANS!!^1!&HELP!!!/");
ds_map_add(global.text_data_en, "obj_papyrus4_407", "THEY KEEP WALKING&THROUGH MY PUZZLES!/");
ds_map_add(global.text_data_en, "obj_papyrus4_408", "\E3THEY'RE SUPPOSED&TO LET ME&EXPLAIN THEM./");
ds_map_add(global.text_data_en, "obj_papyrus4_409", "\E0THEN THREATEN AND&BAFFLE THEM WITH&DANGEROUS JAPES./");
ds_map_add(global.text_data_en, "obj_papyrus4_411", "* well^1, maybe they&  don't like japes./");
ds_map_add(global.text_data_en, "obj_papyrus4_413", "EVERYONE LIKES&JAPES!!!/");
ds_map_add(global.text_data_en, "obj_papyrus4_415", "* what about undyne^1?&* doesn't she hate&  puzzles?/");
ds_map_add(global.text_data_en, "obj_papyrus4_417", "SHE HATES PUZZLES^1.&BUT SHE LOVES&JAPES./");
ds_map_add(global.text_data_en, "obj_papyrus4_419", "* that makes sense./");
ds_map_add(global.text_data_en, "obj_papyrus4_421", "HUMAN!^1!&WHAT DO YOU&THINK!?/");
ds_map_add(global.text_data_en, "obj_papyrus4_422", "PUZZLES OR JAPES?/");
ds_map_add(global.text_data_en, "obj_papyrus4_423", ".../");
ds_map_add(global.text_data_en, "obj_papyrus4_424", "\E3.../");
ds_map_add(global.text_data_en, "obj_papyrus4_425", "OKAY^1, THIS IS&NORMALLY THE&PART./");
ds_map_add(global.text_data_en, "obj_papyrus4_426", "WHERE YOU EITHER&AGREE OR DISAGREE./");
ds_map_add(global.text_data_en, "obj_papyrus4_427", "AND DEPENDING ON&YOUR ANSWER./");
ds_map_add(global.text_data_en, "obj_papyrus4_428", "\E0WE SAY SOMETHING&GREAT IN RESPONSE./");
ds_map_add(global.text_data_en, "obj_papyrus4_429", "\E3.../");
ds_map_add(global.text_data_en, "obj_papyrus4_430", "\E0HERE^1, WHY DON'T&YOU DO THIS&PUZZLE YOURSELF./%%");
ds_map_add(global.text_data_en, "obj_papyrus5_209", "HUMAN!/");
ds_map_add(global.text_data_en, "obj_papyrus5_210", "\E3HMMM..^1.&HOW DO I SAY&THIS.../");
ds_map_add(global.text_data_en, "obj_papyrus5_211", "\E0YOU WERE TAKING A&LONG TIME TO&ARRIVE^1, SO.../");
ds_map_add(global.text_data_en, "obj_papyrus5_212", "I DECIDED TO&IMPROVE THIS&PUZZLE.../");
ds_map_add(global.text_data_en, "obj_papyrus5_213", "BY ARRANGING THE&SNOW TO LOOK MORE&LIKE MY FACE./");
ds_map_add(global.text_data_en, "obj_papyrus5_214", "\E3UNFORTUNATELY^1,&THE SNOW FROZE&TO THE GROUND./");
ds_map_add(global.text_data_en, "obj_papyrus5_215", "\E1NOW THE SOLUTION&IS DIFFERENT!/");
ds_map_add(global.text_data_en, "obj_papyrus5_216", "AND^1,AS USUAL^1, MY&LAZY BROTHER IS&NOWHERE AROUND./");
ds_map_add(global.text_data_en, "obj_papyrus5_217", "\E3I SUPPOSE WHAT&I AM SAYING&IS.../");
ds_map_add(global.text_data_en, "obj_papyrus5_218", "\E0WORRY NOT^1, HUMAN!/");
ds_map_add(global.text_data_en, "obj_papyrus5_219", "I^1, THE GREAT&PAPYRUS^1, WILL SOLVE&THIS CONUNDRUM!/");
ds_map_add(global.text_data_en, "obj_papyrus5_220", "THEN WE CAN BOTH&PROCEED!/");
ds_map_add(global.text_data_en, "obj_papyrus5_221", "MEANWHILE^1, FEEL&FREE TO TRY THE&PUZZLE YOURSELF!/");
ds_map_add(global.text_data_en, "obj_papyrus5_222", "I'LL TRY NOT TO&GIVE AWAY THE&ANSWER!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus5_281", "WOW!!^1!&YOU SOLVED IT!!/");
ds_map_add(global.text_data_en, "obj_papyrus5_282", "AND YOU DID IT&ALL WITHOUT MY&HELP.../");
ds_map_add(global.text_data_en, "obj_papyrus5_283", "MY ADVICE HELPED^1!&IT REALLY HELPED&YOU!!/");
ds_map_add(global.text_data_en, "obj_papyrus5_289", "INCREDIBLE^1!&I'M IMPRESSED!!/");
ds_map_add(global.text_data_en, "obj_papyrus5_290", "YOU MUST CARE&ABOUT PUZZLES&LIKE I DO!/");
ds_map_add(global.text_data_en, "obj_papyrus5_291", "WELL^1, I'M SURE&YOU'LL LOVE THE&NEXT PUZZLE THEN!/");
ds_map_add(global.text_data_en, "obj_papyrus5_292", "IT MIGHT EVEN&BE TOO EASY FOR&YOU!!/");
ds_map_add(global.text_data_en, "obj_papyrus5_293", "NYEH^1!&HEH HEH^1!&HEHEHEH!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus6_138", "HUMAN!/%%");
ds_map_add(global.text_data_en, "obj_papyrus7_156", "HUMAN!/");
ds_map_add(global.text_data_en, "obj_papyrus7_157", "THIS IS YOUR FINAL&AND MOST DANGEROUS&CHALLENGE!/");
ds_map_add(global.text_data_en, "obj_papyrus7_158", "BEHOLD^1!&THE GAUNTLET OF&DEADLY TERROR!/%%");
ds_map_add(global.text_data_en, "obj_papyrus7_194", "WHEN I SAY THE&WORD^1, IT WILL&FULLY ACTIVATE!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_195", "CANNONS WILL FIRE^1!&SPIKES WILL SWING^1!&BLADES WILL SLICE^1!/");
ds_map_add(global.text_data_en, "obj_papyrus7_196", "EACH PART WILL&SWING VIOLENTLY&UP AND DOWN!/");
ds_map_add(global.text_data_en, "obj_papyrus7_197", "ONLY THE TINIEST&CHANCE OF VICTORY&WILL REMAIN!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_198", "ARE YOU READY!?/");
ds_map_add(global.text_data_en, "obj_papyrus7_199", "BECAUSE!/");
ds_map_add(global.text_data_en, "obj_papyrus7_200", "I!/");
ds_map_add(global.text_data_en, "obj_papyrus7_201", "AM!/");
ds_map_add(global.text_data_en, "obj_papyrus7_202", "ABOUT!/");
ds_map_add(global.text_data_en, "obj_papyrus7_203", "TO DO IT!/%%");
ds_map_add(global.text_data_en, "obj_papyrus7_221", " %");
ds_map_add(global.text_data_en, "obj_papyrus7_222", "* well^1?&* what's the holdup?/");
ds_map_add(global.text_data_en, "obj_papyrus7_224", "HOLDUP!^1?&WHAT HOLDUP!?/");
ds_map_add(global.text_data_en, "obj_papyrus7_225", "I'M..^1.&I'M ABOUT TO&ACTIVATE IT NOW!/%%");
ds_map_add(global.text_data_en, "obj_papyrus7_244", " %");
ds_map_add(global.text_data_en, "obj_papyrus7_245", "* that^1, uh^1, doesn't look&  very activated./");
ds_map_add(global.text_data_en, "obj_papyrus7_247", "WELL!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_248", "THIS CHALLENGE!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_249", "\E3IT SEEMS.../");
ds_map_add(global.text_data_en, "obj_papyrus7_250", "MAYBE..^1. TOO EASY&TO DEFEAT THE&HUMAN WITH./");
ds_map_add(global.text_data_en, "obj_papyrus7_251", "\E1YEAH^1!&WE CAN'T USE&THIS ONE!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_252", "I AM A SKELETON&WITH STANDARDS!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_253", "MY PUZZLES ARE&VERY FAIR!/");
ds_map_add(global.text_data_en, "obj_papyrus7_254", "AND MY TRAPS ARE&EXPERTLY COOKED!/");
ds_map_add(global.text_data_en, "obj_papyrus7_255", "BUT THIS METHOD&IS TOO DIRECT^1!&NO CLASS AT ALL!/");
ds_map_add(global.text_data_en, "obj_papyrus7_256", "\E0AWAY IT GOES!/%%");
ds_map_add(global.text_data_en, "obj_papyrus7_260", "WELL!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_261", "\E3... THEY'RE PROBABLY&GOING TO WALK&THROUGH IT./");
ds_map_add(global.text_data_en, "obj_papyrus7_262", "AND IT WON'T BE&ANY FUN AT ALL./");
ds_map_add(global.text_data_en, "obj_papyrus7_264", "* hmmm...&* so this human thing&  was a bust^1, huh?/");
ds_map_add(global.text_data_en, "obj_papyrus7_266", "WELL^1. I MEAN^1.&I'M EXCITED TO&CAPTURE THEM./");
ds_map_add(global.text_data_en, "obj_papyrus7_267", "\E0SO I'LL BECOME&A FAMOUS ROYAL&GUARDSMAN!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_268", "\E3BUT ALL THE TIME&I PUT INTO THESE&PUZZLES.../");
ds_map_add(global.text_data_en, "obj_papyrus7_269", "IT'S KIND OF LIKE&THROWING A&BIRTHDAY PARTY.../");
ds_map_add(global.text_data_en, "obj_papyrus7_271", "* without traps and fire?/");
ds_map_add(global.text_data_en, "obj_papyrus7_273", "EXACTLY!^1!&IT'S POINTLESS!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_274", "\E3MAYBE YOU WERE&RIGHT TO BE LAZY&ABOUT PUZZLES./");
ds_map_add(global.text_data_en, "obj_papyrus7_276", "* me^1?&* right about something^1?&* really?/");
ds_map_add(global.text_data_en, "obj_papyrus7_278", ".../");
ds_map_add(global.text_data_en, "obj_papyrus7_279", "\E0YEAH!^1!&WHAT AM I SAYING!/");
ds_map_add(global.text_data_en, "obj_papyrus7_280", "YOU'RE STILL&COMPLETELY WRONG!/");
ds_map_add(global.text_data_en, "obj_papyrus7_281", "I JUST HAVE THE&WRONG AUDIENCE!/");
ds_map_add(global.text_data_en, "obj_papyrus7_282", "THINK ABOUT HOW&MUCH FUN UNDYNE&WOULD HAVE HERE!/");
ds_map_add(global.text_data_en, "obj_papyrus7_283", "FLAMES^1, VIOLENCE^1.&IT'S RIGHT UP HER&ALLEY!/");
ds_map_add(global.text_data_en, "obj_papyrus7_284", "SO I WON'T WASTE&THIS PUZZLE ON&YOU./");
ds_map_add(global.text_data_en, "obj_papyrus7_285", "I JUST HAVE TO&APPRECIATE.../");
ds_map_add(global.text_data_en, "obj_papyrus7_286", "THE FRIEND I&ALREADY HAVE!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus7_316", "PHEW!/%%");
ds_map_add(global.text_data_en, "obj_papyrus7_333", "WHAT ARE YOU&LOOKING AT!?/");
ds_map_add(global.text_data_en, "obj_papyrus7_334", "THIS WAS ANOTHER&DECISIVE VICTORY&FOR PAPYRUS!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_335", "NYEH!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_336", "HEH!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_337", ".../");
ds_map_add(global.text_data_en, "obj_papyrus7_338", "\E3HEH???/%%");
ds_map_add(global.text_data_en, "obj_papyrus7_341", "A VALUABLE LIFE&LESSON!!!/");
ds_map_add(global.text_data_en, "obj_papyrus7_342", "NYEH HEH HEH!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_184", "HUMAN./");
ds_map_add(global.text_data_en, "obj_papyrus8_185", "ALLOW ME TO TELL&YOU ABOUT SOME&COMPLEX FEELINGS./");
ds_map_add(global.text_data_en, "obj_papyrus8_188", "SOMEHOW^1, I FEEL LIKE&YOU'RE AN OLD FRIEND.../");
ds_map_add(global.text_data_en, "obj_papyrus8_189", "EVEN THOUGH I'VE&NEVER ACTUALLY MET&YOU BEFORE!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_190", "I CAN'T EXPLAIN&WHY I FEEL THIS&WAY.../");
ds_map_add(global.text_data_en, "obj_papyrus8_191", "DID I MEET YOU&ONLINE???/");
ds_map_add(global.text_data_en, "obj_papyrus8_192", "I HAVE MANY \"SOCIAL&MEDIA CONNECTIONS.\"/");ds_map_add(global.text_data_en, "obj_papyrus8_193", "IT'S HARD TO KEEP&TRACK OF THEM&ALL./");
ds_map_add(global.text_data_en, "obj_papyrus8_194", "JUST A DOZEN MORE^1,&AND.../");
ds_map_add(global.text_data_en, "obj_papyrus8_195", "I'LL FINALLY REACH&DOUBLE DIGITS!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_196", "... HEY^1, WAIT A&SECOND!/");
ds_map_add(global.text_data_en, "obj_papyrus8_197", "YOU CAN'T BE MY&FRIEND!!^1!&YOU'RE HUMAN!/");
ds_map_add(global.text_data_en, "obj_papyrus8_198", "I CAN'T BELIEVE YOU&ALMOST TRICKED ME INTO&NOT DEFEATING YOU!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_199", "WHOOPSIE DOOPSIE!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_202", "FEELINGS LIKE.../");
ds_map_add(global.text_data_en, "obj_papyrus8_203", "THE JOY OF FINDING&ANOTHER PASTA&LOVER./");
ds_map_add(global.text_data_en, "obj_papyrus8_204", "THE ADMIRATION FOR&ANOTHER'S PUZZLE-&SOLVING SKILLS./");
ds_map_add(global.text_data_en, "obj_papyrus8_205", "THE DESIRE TO HAVE&A COOL^1, SMART PERSON&THINK YOU ARE COOL./");
ds_map_add(global.text_data_en, "obj_papyrus8_206", "THESE FEELINGS.../");
ds_map_add(global.text_data_en, "obj_papyrus8_207", "THEY MUST BE WHAT&YOU ARE FEELING&RIGHT NOW!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_208", "I CAN HARDLY IMAGINE&WHAT IT MUST BE LIKE&TO FEEL THAT WAY./");
ds_map_add(global.text_data_en, "obj_papyrus8_209", "AFTER ALL^1, I AM&VERY GREAT./");
ds_map_add(global.text_data_en, "obj_papyrus8_210", "I DON'T EVER WONDER&WHAT HAVING LOTS&OF FRIENDS IS LIKE./");
ds_map_add(global.text_data_en, "obj_papyrus8_211", "I PITY YOU..^1.&LONELY HUMAN.../");
ds_map_add(global.text_data_en, "obj_papyrus8_212", "WORRY NOT!!^1!&YOU SHALL BE&LONELY NO LONGER!/");
ds_map_add(global.text_data_en, "obj_papyrus8_213", "I^1, THE GREAT&PAPYRUS^1, WILL BE&YOUR.../");
ds_map_add(global.text_data_en, "obj_papyrus8_214", " ^2.^2../");
ds_map_add(global.text_data_en, "obj_papyrus8_215", "NO.../");
ds_map_add(global.text_data_en, "obj_papyrus8_216", "NO^1, THIS IS ALL&WRONG!/");
ds_map_add(global.text_data_en, "obj_papyrus8_217", "I CAN'T BE YOUR&FRIEND!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_218", "YOU ARE A HUMAN!/");
ds_map_add(global.text_data_en, "obj_papyrus8_219", "I MUST CAPTURE&YOU!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_220", "THEN^1, I CAN FULFILL&MY LIFELONG DREAM!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_221", "POWERFUL^1!&POPULAR^1!&PRESTIGIOUS!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_222", "THAT'S PAPYRUS!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_223", "THE NEWEST MEMBER.../");
ds_map_add(global.text_data_en, "obj_papyrus8_224", "OF THE ROYAL GUARD!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_227", "OH..^1.&WHERE COULD THAT&HUMAN HAVE GONE./");
ds_map_add(global.text_data_en, "obj_papyrus8_228", "... WAIT..^1.&IT'S RIGHT IN&FRONT OF ME!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_229", "HELLO^1!&I WAS WORRIED THAT&YOU HAD GOTTEN LOST!/");
ds_map_add(global.text_data_en, "obj_papyrus8_230", "IT SURE IS A RELIEF&TO KNOW THAT&YOU'RE RIGHT HERE.../");
ds_map_add(global.text_data_en, "obj_papyrus8_231", "... WAIT A SECOND!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_232", "YOU'RE NOT SUPPOSED&TO ESCAPE!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_233", "GET BACK THERE!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_237", "I SUPPOSE THIS PROVES&WHAT I SAID./");
ds_map_add(global.text_data_en, "obj_papyrus8_238", "WE REALLY ARE BOUND&TOGETHER./");
ds_map_add(global.text_data_en, "obj_papyrus8_239", "TWO BONES IN THE&SKELETAL ANATOMY OF&FATE!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_240", "THAT'S HOW YOU APPEAR&HERE NOW.../");
ds_map_add(global.text_data_en, "obj_papyrus8_241", "EVEN THOUGH IT'S VERY&IMPOSSIBLE FOR YOU&TO ESCAPE./");
ds_map_add(global.text_data_en, "obj_papyrus8_242", "AMAZING!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_243", "I FEEL A SINCERE.../");
ds_map_add(global.text_data_en, "obj_papyrus8_244", "WAAAAAIT A SECOND!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_245", "I STILL HAVE TO&CAPTURE YOU!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_246", "WHOOPSIE-DOOPSIE!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_252", "BACK AGAIN^1, EH?/");
ds_map_add(global.text_data_en, "obj_papyrus8_253", "I SUPPOSE IT'S MY&FAULT.../");
ds_map_add(global.text_data_en, "obj_papyrus8_254", "I TOLD YOU BEFORE&THAT I WOULD MAKE&YOU SPAGHETTI./");
ds_map_add(global.text_data_en, "obj_papyrus8_255", "IT'S ONLY NATURAL&THAT YOU WOULD&WANT TO SEE ME.../");
ds_map_add(global.text_data_en, "obj_papyrus8_256", "IN THE DIRE HOPE&THAT I WOULD MAKE&YOU SOME./");
ds_map_add(global.text_data_en, "obj_papyrus8_257", "WELL..^1. I UNDERSTAND./");
ds_map_add(global.text_data_en, "obj_papyrus8_258", "PAPYRUS IS HUNGRY^1,&TOO!/");
ds_map_add(global.text_data_en, "obj_papyrus8_259", "HUNGRY FOR JUSTICE!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_271", "HALT^1, HUMAN!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_386", "I WAS NEVER ONE&  TO BEPIS./%%");
ds_map_add(global.text_data_en, "obj_papyrus8_414", "\E1OH^1, I ALMOST&FORGOT TO TELL&YOU.../");
ds_map_add(global.text_data_en, "obj_papyrus8_415", "TO REACH THE EXIT^1,&YOU WILL HAVE&TO PASS.../");
ds_map_add(global.text_data_en, "obj_papyrus8_416", "\WTHROUGH \YTHE KING\W'S&CASTLE./");
ds_map_add(global.text_data_en, "obj_papyrus8_419", "TO REACH THE EXIT^1,&YOU WILL HAVE&TO MEET.../");
ds_map_add(global.text_data_en, "obj_papyrus8_420", "THE KING./");
ds_map_add(global.text_data_en, "obj_papyrus8_422", "\YTHE KING OF&ALL MONSTERS.../");
ds_map_add(global.text_data_en, "obj_papyrus8_423", "HE IS.../");
ds_map_add(global.text_data_en, "obj_papyrus8_424", "... WELL.../%%");
ds_map_add(global.text_data_en, "obj_papyrus8_441", "\E0HE'S A BIG FUZZY&PUSHOVER!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_442", "EVERYBODY LOVES&THAT GUY./");
ds_map_add(global.text_data_en, "obj_papyrus8_443", "I AM CERTAIN IF&YOU JUST SAY.../");
ds_map_add(global.text_data_en, "obj_papyrus8_444", "\"EXCUSE ME^1, MR.&DREEMURR..^1. CAN I&PLEASE GO HOME?\"/");ds_map_add(global.text_data_en, "obj_papyrus8_445", "HE'LL GUIDE YOU&RIGHT TO THE&BARRIER HIMSELF!/");
ds_map_add(global.text_data_en, "obj_papyrus8_446", "ANYWAY!!^1!&THAT'S ENOUGH&TALKING!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_447", "I'LL BE AT HOME&BEING A COOL&FRIEND!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_448", "FEEL FREE TO&COME BY AND&HANG OUT!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_449", "FEEL FREE TO&COME BY AND HAVE&THAT DATE!/");
ds_map_add(global.text_data_en, "obj_papyrus8_450", "NYEH HEH HEH HEH&HEH HEH HEH!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_515", "HEY^1, QUIT MOVING&WHILE I'M TALKING&TO YOU!/");
ds_map_add(global.text_data_en, "obj_papyrus8_516", "I^1, THE GREAT PAPYRUS^1,&HAVE SOME THINGS&TO SAY./");
ds_map_add(global.text_data_en, "obj_papyrus8_517", "FIRST^1: YOU'RE A&FREAKING WEIRDO!/");
ds_map_add(global.text_data_en, "obj_papyrus8_518", "NOT ONLY DO YOU&NOT LIKE PUZZLES./");
ds_map_add(global.text_data_en, "obj_papyrus8_519", "BUT THE WAY YOU&SHAMBLE ABOUT FROM&PLACE TO PLACE.../");
ds_map_add(global.text_data_en, "obj_papyrus8_520", "THE WAY YOUR HANDS&ARE ALWAYS COVERED&IN DUSTY POWDER./");
ds_map_add(global.text_data_en, "obj_papyrus8_521", "IT FEELS.../");
ds_map_add(global.text_data_en, "obj_papyrus8_522", "LIKE YOUR LIFE IS&GOING DOWN A&DANGEROUS PATH./");
ds_map_add(global.text_data_en, "obj_papyrus8_523", "HOWEVER!/");
ds_map_add(global.text_data_en, "obj_papyrus8_524", "I^1, PAPYRUS^1, SEE&GREAT POTENTIAL&WITHIN YOU!/");
ds_map_add(global.text_data_en, "obj_papyrus8_525", "EVERYONE CAN BE&A GREAT PERSON&IF THEY TRY!/");
ds_map_add(global.text_data_en, "obj_papyrus8_526", "AND ME^1, I HARDLY&HAVE TO TRY AT&ALL!!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_527", "NYEH HEH HEH&HEH HEH HEH!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_555", "HEY^1, QUIT MOVING!/");
ds_map_add(global.text_data_en, "obj_papyrus8_556", "THIS IS EXACTLY&WHAT I AM TALKING&ABOUT!/");
ds_map_add(global.text_data_en, "obj_papyrus8_557", "HUMAN^1! I THINK&YOU ARE IN NEED&OF GUIDANCE!/");
ds_map_add(global.text_data_en, "obj_papyrus8_558", "SOMEONE NEEDS TO&KEEP YOU ON THE&STRAIGHT AND NARROW!/");
ds_map_add(global.text_data_en, "obj_papyrus8_559", "BUT WORRY NOT!&I^1, PAPYRUS.../");
ds_map_add(global.text_data_en, "obj_papyrus8_560", "WILL GLADLY BE&YOUR FRIEND AND&TUTOR!/");
ds_map_add(global.text_data_en, "obj_papyrus8_561", "I WILL TURN YOUR&LIFE RIGHT&AROUND!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus8_590", "I SEE YOU ARE&APPROACHING./");
ds_map_add(global.text_data_en, "obj_papyrus8_591", "ARE YOU OFFERING A&HUG OF ACCEPTANCE?/");
ds_map_add(global.text_data_en, "obj_papyrus8_592", "WOWIE!^1! MY LESSONS&ARE ALREADY&WORKING!!/");
ds_map_add(global.text_data_en, "obj_papyrus8_593", "I^1, PAPYRUS^1,&WELCOME YOU&WITH OPEN ARMS!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_76", "\E3SO^1, ASGORE.../");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_77", "\E0HOW ABOUT MAKING&ME A MEMBER OF&THE ROYAL GUARD?/");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_79", "\E2* Well^1, Papyrus^1, now&  that the war is&  over.../");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_80", "\E0* We might not need&  the Royal Guard&  anymore./");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_82", "\E7WHAT!?/");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_83", "\E1THEN WHAT WAS&THE POINT OF THE&HUMAN'S QUEST!?/");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_84", "\E3THEY JOURNEYED&ALL THAT WAY.../");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_85", "\E4AND I'M STILL&NOT A MEMBER OF&THE ROYAL GUARD!?/");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_86", "\E0TRULY^1, THIS IS&THE WORST&POSSIBLE ENDING./%%");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_91", "\E3IT SEEMS LIKE YOU&REALLY BOTCHED&YOUR QUEST^1, FRISK./");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_92", "\E0BUT^1, I^1, THE&GREAT PAPYRUS.../");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_93", "WILL ALWAYS BE&YOUR FRIEND!!!/");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_95", "\E1* no matter how hard&  you try to get&  rid of him./");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_97", "\E1HEY!/");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_98", "\E0THAT'S TRUE./%%");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_103", "\E3FRISK^1, WHY DON'T&YOU TAKE A WALK&AROUND?/");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_105", "\E1* frisk^1, why don't you&  fly^1?&* it's faster./");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_107", "\E0YEAH^1, FRISK^1, WHY&DON'T YOU FLY?/");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_109", "\E1* Hmmm..^1. Flying sounds&  a little dangerous./");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_111", "\E3* But they CAN'T fly./");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_113", "\E2* Not with THAT&  attitude!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_118", "\E3FRISK..^1.&TAKE A HIKE./");
ds_map_add(global.text_data_en, "obj_papyrus_friendc_119", "\E0HIKING IS GOOD&FOR YOUR BONES./%%");
ds_map_add(global.text_data_en, "obj_papyrus_guide_82", "WELCOME TO SCENIC&MY HOUSE!/");
ds_map_add(global.text_data_en, "obj_papyrus_guide_83", "ENJOY AND TAKE&YOUR TIME!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_guide_84", "WOW!&BEING A GOOD HOST&IS A REAL WORKOUT!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_guide_88", "\E3I CAN'T FEEL MY&LEGS.../");
ds_map_add(global.text_data_en, "obj_papyrus_guide_89", "\E0THAT MUST MEAN&I'M BEING A&GREAT HOST!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_hisroom_86", "TAKE A LOOK&AROUND!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_houseoutside_109", "SO YOU CAME&BACK TO HAVE A&DATE WITH ME!/");
ds_map_add(global.text_data_en, "obj_papyrus_houseoutside_110", "SO YOU CAME&BACK TO SEE ME!/");
ds_map_add(global.text_data_en, "obj_papyrus_houseoutside_111", "\E3YOU MUST BE&REALLY SERIOUS&ABOUT THIS.../");
ds_map_add(global.text_data_en, "obj_papyrus_houseoutside_112", "\E2I'LL HAVE TO TAKE&YOU SOMEPLACE&REALLY SPECIAL.../");
ds_map_add(global.text_data_en, "obj_papyrus_houseoutside_113", "\E0A PLACE I LIKE&TO SPEND A LOT&OF TIME!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_houseoutside_303", "MY HOUSE!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_119", "MY BROTHER STARTED&A SOCK COLLECTION&RECENTLY./");
ds_map_add(global.text_data_en, "obj_papyrus_room_120", "\E3HOW SADDENING.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_121", "\E0SOMETIMES I WONDER&WHAT HE WOULD&DO.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_122", "WITHOUT SUCH A&COOL GUY TAKING&CARE OF HIM???/");
ds_map_add(global.text_data_en, "obj_papyrus_room_123", "NYEH HEH HEH!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_129", "SO^1, YOU WANT&A HINT^1, HUH?/");
ds_map_add(global.text_data_en, "obj_papyrus_room_130", "\E3WELL..^1.&I'VE BEEN LOOKING&AT THE PUZZLE.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_131", "AND I THINK THE&SOLUTION.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_132", "\E0IS TO TURN ALL&OF THE X'S INTO&O'S!/");
ds_map_add(global.text_data_en, "obj_papyrus_room_133", "YOU SHOULD TRY&THAT!/");
ds_map_add(global.text_data_en, "obj_papyrus_room_134", "ASK AGAIN FOR&MORE GREAT HINTS!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_135", "\WMAYBE SOLVING&THE \YLAST PUZZLE\W &AGAIN WILL HELP./");
ds_map_add(global.text_data_en, "obj_papyrus_room_136", "ASK AGAIN FOR&MORE GREAT HINTS!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_157", "Error, Pepibs./%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_161", "I ASKED UNDYNE&IF WE COULD&ALL HANG.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_162", "\E3BUT SHE SAID&SOMETHING WEIRD./");
ds_map_add(global.text_data_en, "obj_papyrus_room_163", "\E0SHE SAID SHE&WON'T HANG OUT&WITH A MURDERER./");
ds_map_add(global.text_data_en, "obj_papyrus_room_164", "\E3BUT..^1. HMM.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_165", "\E5I DON'T REMEMBER&MURDERERING&ANYONE.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_166", "\E3THOUGH I AM A&PRETTY BRUTAL&KIND OF GUY./");
ds_map_add(global.text_data_en, "obj_papyrus_room_167", "\E3THEN SHE SAID&SOMETHING ABOUT&WANTING TO.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_168", "\E1FIGHT SOME KIND&OF BAD GUY./");
ds_map_add(global.text_data_en, "obj_papyrus_room_169", "\E3BUT SHE SEEMS&VERY..^1. WEAK&FROM SOMETHING./");
ds_map_add(global.text_data_en, "obj_papyrus_room_170", "\E5SHE STEPPED OUT&AND COLLAPSED IN&THE DOORWAY./");
ds_map_add(global.text_data_en, "obj_papyrus_room_171", "\E0SO I'M JUST&WAITING HERE IN&CASE SHE NEEDS ME./");
ds_map_add(global.text_data_en, "obj_papyrus_room_172", "\E3SINCE SHE HATES&BEING WAITED ON&HAND AND FOOT./");
ds_map_add(global.text_data_en, "obj_papyrus_room_173", "\E5I THINK WE'LL&HAVE TO HANG&OUT LATER.../%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_176", "HEY^1, I.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_177", "\E5REALLY DOUBT&WE'RE GOING TO&BE ABLE TO HANG./");
ds_map_add(global.text_data_en, "obj_papyrus_room_178", "\E3IT'S HARD TO&IMAGINE^1, BUT.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_179", "\E0YOU'LL HAVE TO&SPEND TIME WITH&NOT ME./%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_185", "HEY^1! READY TO&HANG OUT WITH&UNDYNE???/");
ds_map_add(global.text_data_en, "obj_papyrus_room_186", "GREAT!!^1!&ME TOO!!!/");
ds_map_add(global.text_data_en, "obj_papyrus_room_187", "\E3HOWEVER^1, SHE'S&NOT HERE./");
ds_map_add(global.text_data_en, "obj_papyrus_room_188", "\E0NORMALLY SHE&RETURNS AT ABOUT&THIS TIME./");
ds_map_add(global.text_data_en, "obj_papyrus_room_189", "\E3SHE'S LATE&THOUGH.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_190", "\E3AND SHE'S NOT&ANSWERING HER&PHONE./");
ds_map_add(global.text_data_en, "obj_papyrus_room_191", "\E0HOW STRANGE./");
ds_map_add(global.text_data_en, "obj_papyrus_room_192", "I'LL JUST WAIT&HERE UNTIL SHE&GETS HOME./");
ds_map_add(global.text_data_en, "obj_papyrus_room_193", "I'LL CALL YOU&WHEN SHE GETS&HERE^1, OKAY!?/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_196", "NOPE!^1!&SHE ISN'T HERE&YET!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_202", "UNDYNE'S HOME^1,&BUT SHE ISN'T&FEELING WELL./");
ds_map_add(global.text_data_en, "obj_papyrus_room_203", "\E5I DON'T THINK WE&CAN HANG OUT./");
ds_map_add(global.text_data_en, "obj_papyrus_room_204", "\E3IT SEEMS LIKE SHE&CAUGHT HEAT-STROKE&OR SOMETHING./");
ds_map_add(global.text_data_en, "obj_papyrus_room_205", "SOMEONE MUST HAVE&BROUGHT HER&BACK HOME.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_206", "\E5BECAUSE SHE CAN&BARELY MOVE./");
ds_map_add(global.text_data_en, "obj_papyrus_room_207", "\E0BUT SHE IS&MUTTERING ABOUT&DESTROYING YOU./");
ds_map_add(global.text_data_en, "obj_papyrus_room_208", "SO THAT'S A GOOD&VITAL SIGN./");
ds_map_add(global.text_data_en, "obj_papyrus_room_209", "\E3IN ANY CASE^1, I&DON'T THINK WE&CAN HANG OUT./");
ds_map_add(global.text_data_en, "obj_papyrus_room_210", "\E0I'M JUST WAITING&HERE IN CASE&SHE NEEDS ME./");
ds_map_add(global.text_data_en, "obj_papyrus_room_211", "SO^1, I GUESS YOU&CAN RUN ALONG./%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_214", "UNDYNE IS SICK^1,&SO SHE CAN'T&PLAY TODAY./%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_220", "HEY^1! READY TO&HANG OUT WITH&UNDYNE???/");
ds_map_add(global.text_data_en, "obj_papyrus_room_221", "GREAT!!^1!&BECAUSE SHE'S NOT&EVEN HERE./");
ds_map_add(global.text_data_en, "obj_papyrus_room_222", "BEING READY EARLY^1!&IT SHOWS HOW MUCH&YOU CARE!!/");
ds_map_add(global.text_data_en, "obj_papyrus_room_223", "\E3EVEN IF SHE'S&NOT HERE TO SEE&THAT./%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_226", "NOPE!^1!&SHE ISN'T HERE&YET!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_244", "HELLO^1, MY FRIEND./");
ds_map_add(global.text_data_en, "obj_papyrus_room_245", "WHAT BRINGS YOU&TO PAPYRUS TOWN?/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_248", "HELLO..^1.&H-HOW ARE YOU^1,&MY F-FRIEND?/");
ds_map_add(global.text_data_en, "obj_papyrus_room_249", "\E5I'M FEELING VERY&NOT SUSPICIOUS&TODAY./%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_253", "HEY^1, I HAVE A&GREAT IDEA./");
ds_map_add(global.text_data_en, "obj_papyrus_room_254", "LET'S HANG OUT&WITH UNDYNE&LATER./");
ds_map_add(global.text_data_en, "obj_papyrus_room_255", "I'LL CALL YOU&WHEN I'M READY!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_259", "I'M SO GLAD YOU&AND UNDYNE ARE&FRIENDS NOW./");
ds_map_add(global.text_data_en, "obj_papyrus_room_260", "YOU TWO GO&TOGETHER LIKE&PASTA AND BURNING!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_263", "OH^1, HEY.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_264", "\E3YOU'RE LEAVING&SOON^1, RIGHT!?/");
ds_map_add(global.text_data_en, "obj_papyrus_room_265", "\E1DON'T COME HERE&TO SAY GOODBYE!!/");
ds_map_add(global.text_data_en, "obj_papyrus_room_266", "\E3GOODBYES AREN'T&ALLOWED IN MY&TOWN./");
ds_map_add(global.text_data_en, "obj_papyrus_room_267", "\E0JUST SEE-YOU-&LATERS./%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_272", "IT SEEMS UNDYNE&HAS SOMETHING&FOR YOU./");
ds_map_add(global.text_data_en, "obj_papyrus_room_273", "SHE'S THE PERSON&THAT'S NOT ME./%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_278", "UNDYNE WRITES A&LOT OF LETTERS./");
ds_map_add(global.text_data_en, "obj_papyrus_room_279", "\E3BUT^1, SHE CAN NEVER&SEEM TO FIND THE&RIGHT WORDS./");
ds_map_add(global.text_data_en, "obj_papyrus_room_280", "SO WHEN SHE GOES&TO DELIVER THEM&HERSELF.../");
ds_map_add(global.text_data_en, "obj_papyrus_room_281", "SHE ALWAYS QUITS&SO SHE CAN GO&BACK AND REWRITE./");
ds_map_add(global.text_data_en, "obj_papyrus_room_282", "\E0THAT'S WHY SHE&ASKED YOU!!/");
ds_map_add(global.text_data_en, "obj_papyrus_room_283", "BECAUSE YOU HAVE&NO STANDARDS!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrus_room_287", "ALPHYS SEEMS TO&HAVE DISAPPEARED./");
ds_map_add(global.text_data_en, "obj_papyrus_room_288", "DON'T WORRY^1, THAT'S&NORMAL./");
ds_map_add(global.text_data_en, "obj_papyrus_room_289", "YOU SHOULD GO&TO HER LAB./");
ds_map_add(global.text_data_en, "obj_papyrus_room_290", "I'M SUPPOSED TO&PUT THESE&NUMBERS TOGETHER./%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_270", " ALAS^1, POOR& PAPYRUS!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_272", " W-WELL^1, THAT'S& NOT WHAT I& EXPECTED.../%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_282", " WELL^1, AT LEAST I& STILL HAVE MY& HEAD!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_285", " BUT.../");
ds_map_add(global.text_data_en, "obj_papyrusboss_286", " ST..^1. STILL^1!& I BELIEVE IN& YOU!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_287", " YOU CAN DO A& LITTLE BETTER!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_288", " EVEN IF YOU& DON'T THINK SO!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_289", " I..^1.& I PROMISE.../%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_402", " WELL...! *HUFF^1*& IT'S CLEAR...& YOU CAN'T^1! *HUFF^1*& DEFEAT ME!!!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_403", " YEAH!!!& I CAN SEE YOU& SHAKING IN YOUR& BOOTS!!!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_404", " THEREFORE I^1, THE& GREAT PAPYRUS^1,& ELECT TO GRANT& YOU PITY!!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_405", "\X I WILL \RSPARE\X YOU,& HUMAN!!!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_406", " \XNOW'S YOUR CHANCE& TO ACCEPT MY& \RMERCY\X./%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_423", "* Papyrus is sparing you.");
ds_map_add(global.text_data_en, "obj_papyrusboss_456", " WHAT THE HECK!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_457", " THAT'S MY& SPECIAL ATTACK!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_466", " HEY^1!& YOU STUPID DOG!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_477", " DO YOU HEAR& ME!?/");
ds_map_add(global.text_data_en, "obj_papyrusboss_478", " STOP MUNCHING ON& THAT BONE!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_487", " HEY!!!& WHAT ARE YOU& DOING!!!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_488", " COME BACK HERE& WITH MY SPECIAL& ATTACK!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_502", " .../");
ds_map_add(global.text_data_en, "obj_papyrusboss_503", " OH WELL./");
ds_map_add(global.text_data_en, "obj_papyrusboss_504", " I'LL JUST USE& A REALLY COOL& REGULAR ATTACK./%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_514", "* Papyrus is getting ready&  for a regular attack.");
ds_map_add(global.text_data_en, "obj_papyrusboss_548", "  ...");
ds_map_add(global.text_data_en, "obj_papyrusboss_552", " OH^1, I SHOULD& HAVE BROUGHT ONE&  OF THOSE.");
ds_map_add(global.text_data_en, "obj_papyrusboss_558", " SO YOU'RE& SERIOUS.../");
ds_map_add(global.text_data_en, "obj_papyrusboss_559", " SO YOU WON'T& FIGHT.../");
ds_map_add(global.text_data_en, "obj_papyrusboss_560", " THEN^1, LET'S SEE& IF YOU CAN HANDLE& MY FABLED& 'BLUE ATTACK!'/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_561", "%%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_570", " BEHOLD!");
ds_map_add(global.text_data_en, "obj_papyrusboss_571", " HMMM... I WONDER& WHAT I SHOULD& WEAR...");
ds_map_add(global.text_data_en, "obj_papyrusboss_572", " HOW HIGH CAN YOU& JUMP?");
ds_map_add(global.text_data_en, "obj_papyrusboss_573", " WHAT!? I'M NOT& THINKING ABOUT& THAT DATE THING!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_574", " TRY HOLDING THE& 'UP' BUTTON TO& JUMP!!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_575", "\X YEAH!& DON'T MAKE ME& USE MY \RSPECIAL& ATTACK\X!");
ds_map_add(global.text_data_en, "obj_papyrusboss_576", " HOLD 'UP' LONGER& TO JUMP HIGHER!& JEEZ!!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_577", " I CAN ALMOST& TASTE MY FUTURE& POPULARITY!!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_578", " PAPYRUS:& HEAD OF THE& ROYAL GUARD!");
ds_map_add(global.text_data_en, "obj_papyrusboss_579", " PAPYRUS:& UNPARALLELED& SPAGHETTORE!");
ds_map_add(global.text_data_en, "obj_papyrusboss_580", " UNDYNE WILL BE& REALLY PROUD& OF ME!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_581", " THE KING WILL& TRIM A HEDGE& IN THE SHAPE& OF MY SMILE!!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_582", " MY BROTHER WILL& ... WELL, HE& WON'T CHANGE& VERY MUCH.");
ds_map_add(global.text_data_en, "obj_papyrusboss_583", " I'LL HAVE LOTS& OF ADMIRERS!!& BUT...");
ds_map_add(global.text_data_en, "obj_papyrusboss_584", " HOW WILL I& KNOW IF PEOPLE& SINCERELY LIKE& ME???");
ds_map_add(global.text_data_en, "obj_papyrusboss_585", " WILL ANYONE LIKE& ME AS SINCERELY& AS YOU?");
ds_map_add(global.text_data_en, "obj_papyrusboss_586", " SOMEONE LIKE& YOU IS REALLY& RARE...");
ds_map_add(global.text_data_en, "obj_papyrusboss_587", " I DON'T THINK& THEY'LL LET YOU& GO...");
ds_map_add(global.text_data_en, "obj_papyrusboss_588", " AND DATING MIGHT& BE KIND OF& HARD...");
ds_map_add(global.text_data_en, "obj_papyrusboss_589", " AFTER YOU'RE& CAPTURED AND& SENT AWAY.");
ds_map_add(global.text_data_en, "obj_papyrusboss_590", " URGH...& WHO CARES!& GIVE UP!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_591", "\X GIVE UP OR& FACE MY...& \RSPECIAL ATTACK\X!!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_592", "\X YEAH!!!& VERY SOON I WILL& USE MY& \RSPECIAL ATTACK\X! ");
ds_map_add(global.text_data_en, "obj_papyrusboss_593", "\X NOT TOO LONG& AND I WILL& USE THAT& \RSPECIAL ATTACK\X!!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_594", "\X THIS IS YOUR& LAST CHANCE...& BEFORE MY& \RSPECIAL ATTACK\X!!");
ds_map_add(global.text_data_en, "obj_papyrusboss_595", "\X BEHOLD...!& MY \RSPECIAL& ATTACK\X!");
ds_map_add(global.text_data_en, "obj_papyrusboss_596", " *SIGH* HERE'S AN& ABSOLUTELY& NORMAL ATTACK.");
ds_map_add(global.text_data_en, "obj_papyrusboss_604", " NYEH HEH HEH!");
ds_map_add(global.text_data_en, "obj_papyrusboss_605", " I DON'T DESERVE& SUCH HOSPITALITY& FROM YOU ...");
ds_map_add(global.text_data_en, "obj_papyrusboss_606", " YOUR BARBS HIDE A& HIDDEN AFFECTION^1!& YOU EMOTIONAL& CACTUS!");
ds_map_add(global.text_data_en, "obj_papyrusboss_607", " DON'T WASTE YOUR& WORDS ON ME!");
ds_map_add(global.text_data_en, "obj_papyrusboss_608", " LET'S DATE& L-LATER!^1!& AFTER I CAPTURE& YOU!");
ds_map_add(global.text_data_en, "obj_papyrusboss_612", "  ...");
ds_map_add(global.text_data_en, "obj_papyrusboss_1584", "* Papyrus is preparing a bone&  attack.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1585", "* Papyrus prepares a non-bone&  attack then spends a minute&  fixing his mistake.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1586", "* Papyrus is cackling.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1587", "* Papyrus whispers \"Nyeh heh&  heh!\"");ds_map_add(global.text_data_en, "obj_papyrusboss_1588", "* Papyrus is rattling his bones.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1589", "* Papyrus is trying hard to play&  it cool.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1590", "* Papyrus is considering his&  options.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1591", "* Smells like bones.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1592", "* Papyrus remembered a bad joke&  Sans told and is frowning.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1596", "* Papyrus is thinking about&  what to wear for his date.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1597", "* Papyrus is thinking about&  what to cook for his date.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1598", "* Papyrus dabs some Bone&  Cologne behind his ear.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1599", "* Papyrus dabs marinara sauce&  behind his ear.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1600", "* Papyrus dabs MTT-Brand Bishie&  Cream behind his ear.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1601", "* Papyrus dabs MTT-Brand Anime&  Powder behind his ear.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1602", "* Papyrus dabs MTT-Brand Cute&  Juice behind his ear.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1603", "* Papyrus dabs MTT-Brand&  Attraction Slime behind his&  ear.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1604", "* Papyrus dabs MTT-Brand&  Beauty Yogurt behind his&  ear.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1605", "* Papyrus realizes he doesn't&  have ears.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1609", "* Papyrus is at the edge of&  defeat.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1611", "* Papyrus is sparing you.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1613", "* Papyrus is sparing you.");
ds_map_add(global.text_data_en, "obj_papyrusboss_1645", "* PAPYRUS - ATK 20 DEF 20&* He likes to say:&  \"Nyeh heh heh!\"/^");ds_map_add(global.text_data_en, "obj_papyrusboss_1647", "* PAPYRUS - ATK 3 DEF 3&* Forgettable./^");
ds_map_add(global.text_data_en, "obj_papyrusboss_1661", " HOW SELFLESS.../");
ds_map_add(global.text_data_en, "obj_papyrusboss_1662", " YOU WANT ME TO& FEEL BETTER& ABOUT FIGHTING& YOU.../%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_1663", " THERE'S NO NEED& TO LIE TO& YOURSELF!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_1664", " DON'T...!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_1678", "* You INSULT^1, but to no avail^1.&* Seems ACTing won't escalate&  this battle.../^");
ds_map_add(global.text_data_en, "obj_papyrusboss_1680", "* Papyrus is too busy FIGHTing&  to accept your insult./^");
ds_map_add(global.text_data_en, "obj_papyrusboss_1696", " WHAT!^1?& FL-FLIRTING!?/");
ds_map_add(global.text_data_en, "obj_papyrusboss_1697", "\X SO YOU FINALLY& REVEAL YOUR\R & ULTIMATE FEELINGS\X!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_1698", " W-WELL^1!& I'M A SKELETON& WITH VERY HIGH& STANDARDS!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_1700", " OH NO!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_1713", "* You FLIRT^1, but to no avail^1.&* Seems ACTing won't escalate&  this battle.../^");
ds_map_add(global.text_data_en, "obj_papyrusboss_1715", "* Papyrus is too busy FIGHTing&  to flirt back./^");
ds_map_add(global.text_data_en, "obj_papyrusboss_1754", " OH NO!!^1! YOU'RE& MEETING ALL MY& STANDARDS!!!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_1755", " I GUESS THIS MEANS& I HAVE TO GO ON A& DATE WITH YOU...?/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_1769", " OH NO!!^1!& THAT HUMILITY..^1.& IT REMINDS ME OF,/");
ds_map_add(global.text_data_en, "obj_papyrusboss_1770", " MYSELF!!!/");
ds_map_add(global.text_data_en, "obj_papyrusboss_1771", " YOU'RE MEETING ALL&  MY STANDARDS!!!/%%");
ds_map_add(global.text_data_en, "obj_papyrusboss_1804", "   I can           I have zero&   make            redeeming&   spaghetti       qualities\C");
ds_map_add(global.text_data_en, "obj_papyrussnowman_98", "* (It's a snow Papyrus.)/%%");
