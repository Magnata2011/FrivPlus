ds_map_add(global.text_data_en, "obj_moldessa_205", "Shh...");
ds_map_add(global.text_data_en, "obj_moldessa_206", "Hsh...");
ds_map_add(global.text_data_en, "obj_moldessa_207", "Krr...");
ds_map_add(global.text_data_en, "obj_moldessa_212", "%%%");
ds_map_add(global.text_data_en, "obj_moldessa_418", "* Moldessa's face rearranges&  itself.");
ds_map_add(global.text_data_en, "obj_moldessa_419", "* Moldessa tries to make its&  face look like a movie-&  star's^1, but it shifts apart.");
ds_map_add(global.text_data_en, "obj_moldessa_420", "* Moldessa hides behind its ears^3.&* ... arms?");
ds_map_add(global.text_data_en, "obj_moldessa_421", "* Smells like twelve-week-old&  gummy bears.");
ds_map_add(global.text_data_en, "obj_moldessa_424", "* Moldessa's face falls apart.");
ds_map_add(global.text_data_en, "obj_moldessa_425", "* Moldessa's face looks... happy?");
ds_map_add(global.text_data_en, "obj_moldessa_447", "* MOLDESSA - ATK 27 DEF 23&* Can't decide on a face^1.&* Can't see friend from foe./^");
ds_map_add(global.text_data_en, "obj_moldessa_458", "* You encourage Moldessa to try&  a new look^1.&* Its face shifts.../^");
ds_map_add(global.text_data_en, "obj_moldessa_470", "* You adjust Moldessa's face./^");
ds_map_add(global.text_data_en, "obj_moldessa_471", "* You adjust Moldessa's face^1.&* It seems to be happy with its&  new look./^");
ds_map_add(global.text_data_en, "obj_moldessa_474", "* You adjust Moldessa's face./^");
ds_map_add(global.text_data_en, "obj_moldessa_495", "* You lie down and rest^1.&* Moldessa tucks you in with&  a blanket of moss./");
ds_map_add(global.text_data_en, "obj_moldessa_496", "* While you were sleeping^1, the&  other monsters get bored./^");
ds_map_add(global.text_data_en, "obj_moldessa_506", "* You lie down and rest^1.&* Moldessa tucks you in with&  a blanket of moss./^");
ds_map_add(global.text_data_en, "obj_moldsmal_193", "Burble&burb...");
ds_map_add(global.text_data_en, "obj_moldsmal_194", "Squorch&...");
ds_map_add(global.text_data_en, "obj_moldsmal_195", "*Slime&sounds*");
ds_map_add(global.text_data_en, "obj_moldsmal_196", "*Sexy&wiggle*");
ds_map_add(global.text_data_en, "obj_moldsmal_198", "%%%");
ds_map_add(global.text_data_en, "obj_moldsmal_391", "* Moldsmal burbles quietly.");
ds_map_add(global.text_data_en, "obj_moldsmal_392", "* Moldsmal waits pensively.");
ds_map_add(global.text_data_en, "obj_moldsmal_393", "* Moldsmal is ruminating.");
ds_map_add(global.text_data_en, "obj_moldsmal_394", "* The aroma of lime gelatin&  wafts through.");
ds_map_add(global.text_data_en, "obj_moldsmal_395", "* Moldsmal has started to spoil.");
ds_map_add(global.text_data_en, "obj_moldsmal_412", "* MOLDSMAL - ATK 6 DEF 0&* Stereotypical: Curvaceously&  attractive, but no brains.../^");
ds_map_add(global.text_data_en, "obj_moldsmal_413", "* MOLDSMAL - ATK 12 DEF 0&* It's a different color^1, so&  it's a bit stronger now./^");
ds_map_add(global.text_data_en, "obj_moldsmal_422", "* You lie immobile with Moldsmal.&* You feel like you understand&  the world a little better./^");
ds_map_add(global.text_data_en, "obj_moldsmal_434", "* You wiggle your hips.&* Moldsmal wiggles back.&* What a meaningful conversation!/^");
ds_map_add(global.text_data_en, "obj_moldsmalx_199", "Guoooh!");
ds_map_add(global.text_data_en, "obj_moldsmalx_200", "Roar.");
ds_map_add(global.text_data_en, "obj_moldsmalx_201", "*Slime&sounds*");
ds_map_add(global.text_data_en, "obj_moldsmalx_202", "*Chaste&wiggle*");
ds_map_add(global.text_data_en, "obj_moldsmalx_206", "...");
ds_map_add(global.text_data_en, "obj_moldsmalx_214", "Guoooh!");
ds_map_add(global.text_data_en, "obj_moldsmalx_220", "%%%");
ds_map_add(global.text_data_en, "obj_moldsmalx_451", "* Moldsmal sits motionless.");
ds_map_add(global.text_data_en, "obj_moldsmalx_452", "* Moldsmal is very normal.");
ds_map_add(global.text_data_en, "obj_moldsmalx_453", "* Moldsmal is having quiet&  time.");
ds_map_add(global.text_data_en, "obj_moldsmalx_454", "* Smells like a bait shop.");
ds_map_add(global.text_data_en, "obj_moldsmalx_455", "* Quite impossible.");
ds_map_add(global.text_data_en, "obj_moldsmalx_459", "* Moldbygg needs some distance.");
ds_map_add(global.text_data_en, "obj_moldsmalx_460", "* Moldbygg gyrates reservedly.");
ds_map_add(global.text_data_en, "obj_moldsmalx_461", "* Moldbygg mills about in the&  corner.");
ds_map_add(global.text_data_en, "obj_moldsmalx_462", "* Smells like a bait shop.");
ds_map_add(global.text_data_en, "obj_moldsmalx_463", "* Moldbygg seems comfortable&  with your presence.");
ds_map_add(global.text_data_en, "obj_moldsmalx_464", "* Moldbygg has seen better days.");
ds_map_add(global.text_data_en, "obj_moldsmalx_484", "* MOLDSMAL? - ATK 6 DEF 0&* It's a slime mold...?/^");
ds_map_add(global.text_data_en, "obj_moldsmalx_486", "* MOLDBYGG - ATK 18 DEF 18&* One size greater than&  Moldaverage./^");
ds_map_add(global.text_data_en, "obj_moldsmalx_495", "* You approach Moldsmal.&* Suddenly...!/^");
ds_map_add(global.text_data_en, "obj_moldsmalx_497", "* You lie down.&* Moldbygg lies down too.&* Moldbygg understands life now./^");
ds_map_add(global.text_data_en, "obj_moldsmalx_510", "* You wiggle your hips.&* Suddenly...!/^");
ds_map_add(global.text_data_en, "obj_moldsmalx_513", "* You hug Moldbygg.&* Gross slime covers you.&* Your SPEED decreased./^");
ds_map_add(global.text_data_en, "obj_moldsmalx_526", "* Wrong message!/^");
ds_map_add(global.text_data_en, "obj_moldsmalx_530", "* You don't hug Moldbygg.&* It appreciates your respect&  of its boundaries./^");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger3_134", "* Yo.../%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger3_140", "* Yo..^1./");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger3_141", "* Where's the umbrella...^1?&* Ha... ha.../%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger3_146", "* Yo^1!&* Ready yet?/%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger3_154", "* Yo^1!&* Ready yet?/%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger3_158", "* Yo^1!&* You got us an umbrella?/");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger3_159", "* You're the best!/%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger3_167", "* Yo^1, you got an umbrella?/");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger3_168", "* Awesome!/%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger3_173", "* Yo^1! You can't hold an&  umbrella either?/");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger3_174", "* If you're walking anyway^1,&  I guess I'll go with you^1,&  haha.../%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger3_201", "* Let's go!/%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger3_284", "* Yo^1, I already looked^1,&  Undyne's not over here./");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger3_285", "* So I guess I'll see&  ya later^1, haha./%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger3_286", "* See ya later!/%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger4_66", "* Man^1, Undyne is sooooooo&  cool./");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger4_67", "* She beats up bad guys and&  NEVER loses./");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger4_68", "* If I was a human^1, I would&  wet the bed every night.../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger4_69", "* ... knowing she was gonna&  beat me up^1!&* Ha ha./%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger5_91", "* Ummm^1, maybe she wouldn't beat&  up the teachers.../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger5_92", "* She's too cool to ever&  hurt an innocent person!/%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger6_192", "* Yo^1, you wanna see&  Undyne^1, right...?/");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger6_193", "* Climb on my shoulders./%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger6_195", "* Put up your umbrella and&  climb on my shoulders./%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger6_272", "* Yo^1, you go on ahead./");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger6_273", "* Don't worry about me^1.&* I always find a way to&  get through!/%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger6_276", "* Owww..^1.&* Yo^1, try being a little&  less rough^1, haha./");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger6_277", "* Anyway^1, I'll look for&  another way through^1.&* Later!/%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_124", "* Yo!/%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_214", "* Yo./");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_215", "* Undyne told me to stay&  away from you./");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_216", "* She said you..^1.&* You hurt a lot of people./");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_217", "* .../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_218", "* But^1, yo^1, that's not true^1,&  right!?/");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_219", "* .../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_220", "* ... yo..^1.&* Why won't you answer me?/");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_221", "* A..^1. a..^1. and what's with&  that weird expression...?/%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_225", "* Yo^1, dude..^1.&* I..^1. I heard some things^1,&  and.../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_226", "* What^1?&* Look over here^1?&* What for  %%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_309", "* Yo^1, w-w-wait^1!&* Help^1!&* I tripped!/%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_379", "\W* Wh-what are you \Ystanding&  around\W for?&* \YGet over here^1,\W dude!/%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_417", "* I..^1.&* I'm slipping!/%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_490", "* Undyne..^1. you saved me...?/");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_491", "* Yo^1, I thought I was a&  goner^1, haha.../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_492", "* ... wait^1, are you okay^1?&* It looks like you fell&  pretty hard.../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_493", "* Th-this is my fault^1.&* I should have stayed away from&  them^1, like you said./");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_494", "* They just stood there..^1.&* Watching..^1.&* Waiting for me to fall./");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_495", "* They just went straight to&  fight you instead of&  helping me.../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_496", "* I was so scared^1, and you.../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_497", "* What^1?&* You're gonna go fight them&  now?/");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_498", "* But you look hurt..^1.&* You should rest^1, haha.../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_499", "* .../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_500", "* W-warriors don't rest^1, huh?/");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_501", "* Undyne..^1. you're really cool./%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_643", "* Y..^1. y..^1. yo..^1. dude.../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_644", "* If..^1. If y^1-you wanna hurt&  my friend.../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_645", "* You're gonna have to get&  through me^1, first./%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_714", "* She's gone.../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_715", "* Yo^1, you really saved my skin./");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_716", "* Guess being enemies was just&  a nice thought^1, haha./");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_717", "* We'll just have to be friends&  instead./");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_718", "* ... man^1, I should REALLY go&  home.../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_719", "* I bet my parents are worried&  sick about me!/%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_757", "* Later^1, dude!/%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_836", "* Oh..^1.&* Oh man.../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_837", "* (Man^1, my h-heart's pounding&  right out of my chest...)/");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_838", "* (... what would Undyne do?)/");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_839", "* (...)/");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_840", "* Yo.../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_841", "* Y-you'd b-better st-stop&  r-right where you are.../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_842", "* Cause if you w-wanna hurt&  anyone else..^1. you're.../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_843", "* You're gonna have to get&  through me^1, first./");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_844", "* A..^1. and..^1. and..^1.%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_901", "* S-see^1?&* I knew y-you weren't so&  bad!/");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger7_902", "* I've gotta go tell Undyne&  she was wrong about you!/%%");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger8_85", "* Undyne..^1.&* You...^1.&* You saved me!/");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger8_86", "* Huh^1?&* They ran away?/");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger8_87", "* Yo^1, you're wrong.../");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger8_88", "* They went to get help!/");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger8_89", "* They'll be back any second!!/");
ds_map_add(global.text_data_en, "obj_monsterkidtrigger8_90", "* O-okay^1, I'll go home.../%%");
ds_map_add(global.text_data_en, "obj_movedoge_259", "Don't&move an&inch!");
ds_map_add(global.text_data_en, "obj_movedoge_260", "It moved&!! It&didn't&NOT move!");
ds_map_add(global.text_data_en, "obj_movedoge_261", "Will it&move&this&time?");
ds_map_add(global.text_data_en, "obj_movedoge_264", "HUH!!!&A FUN&STICK&APPEARS!");
ds_map_add(global.text_data_en, "obj_movedoge_271", "WHAT!!!&I'VE&BEEN&PET!!!");
ds_map_add(global.text_data_en, "obj_movedoge_272", "WHERE'S&THAT&COMING&FROM!");
ds_map_add(global.text_data_en, "obj_movedoge_273", "THERE'S&NO END&TO IT!!");
ds_map_add(global.text_data_en, "obj_movedoge_274", "WELL,&THIS IS&THOROUGH&!!!");
ds_map_add(global.text_data_en, "obj_movedoge_277", "OK.&That's&enough.");
