draw_set_color(c_white);

if (hover_category == -1)
{
	var __x = cat_box_x + (SETTINGS_MENU_PAD * 2);
	var __y = (cat_box_y + (SETTINGS_MENU_PAD * 2)) + (i * str_height);
	var daniela_quote = "";
	
	if (season != 0)
	{
		switch (season)
		{
			case 1:
				daniela_quote = daniela_winter_quote;
				break;
			case 2:
