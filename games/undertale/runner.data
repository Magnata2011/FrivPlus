ds_map_add(global.text_data_en, "obj_showercurtain_227", "* (There's a green key lying&  in the bathtub.)/");
ds_map_add(global.text_data_en, "obj_showercurtain_228", "* (You took it and put it&  on your keychain.)/%%");
ds_map_add(global.text_data_en, "obj_showercurtain_248", "* (It's an empty bathtub.)/%%");
ds_map_add(global.text_data_en, "obj_shyren_274", "....&....&toot&....");
ds_map_add(global.text_data_en, "obj_shyren_275", "....&....&hum hum");
ds_map_add(global.text_data_en, "obj_shyren_278", "si re,&si re&si mi&si mi");
ds_map_add(global.text_data_en, "obj_shyren_279", "Si Fa&Si Fa&So Fa So&Mi Re Re");
ds_map_add(global.text_data_en, "obj_shyren_280", "Mi So&Mi So&Mi Si Mi&La Si So");
ds_map_add(global.text_data_en, "obj_shyren_281", "(agg-&ressive&tooting)");
ds_map_add(global.text_data_en, "obj_shyren_282", "(final&toot)");
ds_map_add(global.text_data_en, "obj_shyren_283", "%%%");
ds_map_add(global.text_data_en, "obj_shyren_470", "* Shyren hums very faintly.");
ds_map_add(global.text_data_en, "obj_shyren_471", "* Shyren pretends to be a&  pop idol.");
ds_map_add(global.text_data_en, "obj_shyren_472", "* Shyren taps a little beat&  with her fins.");
ds_map_add(global.text_data_en, "obj_shyren_473", "* Shyren thinks about doing&  karaoke by herself.");
ds_map_add(global.text_data_en, "obj_shyren_474", "* Smells like music.");
ds_map_add(global.text_data_en, "obj_shyren_475", "* Shyren's voice gets raspy.");
ds_map_add(global.text_data_en, "obj_shyren_476", "* Shyren seems much more&  comfortable singing along.");
ds_map_add(global.text_data_en, "obj_shyren_479", "* Sans is selling tickets&  made of toilet paper.");
ds_map_add(global.text_data_en, "obj_shyren_480", "* A hooded figure watches&  the commotion from afar.");
ds_map_add(global.text_data_en, "obj_shyren_482", "* The crowd tosses clothing^1.&* It's a storm of socks.");
ds_map_add(global.text_data_en, "obj_shyren_483", "* Shyren thinks about her&  future.");
ds_map_add(global.text_data_en, "obj_shyren_502", "* SHYREN - ATK 19 DEF 0&* Tone deaf^1. She's too ashamed&  to sing her deadly song./^");
ds_map_add(global.text_data_en, "obj_shyren_503", "* SHYREN - ATK 19 DEF 0&* A talented singer^1, with&  a little help./^");
ds_map_add(global.text_data_en, "obj_shyren_504", "* SHYREN - ATK 19 DEF 0&* That's Shyren^1.&* She's your band-mate./^");
ds_map_add(global.text_data_en, "obj_shyren_514", "* You hum a funky tune^1.&* Shyren follows your melody./^");
ds_map_add(global.text_data_en, "obj_shyren_515", "* You hum a sad song^1.&* Shyren follows your melody./^");
ds_map_add(global.text_data_en, "obj_shyren_516", "* You hum a jazz ballad^1.&* Shyren follows your melody./^");
ds_map_add(global.text_data_en, "obj_shyren_517", "* You hum some more^1.&* Monsters are drawn to the&  music./");
ds_map_add(global.text_data_en, "obj_shyren_518", "* Suddenly^1, it's a concert.../^");
ds_map_add(global.text_data_en, "obj_shyren_519", "* You hum some more^1.&* The seats are sold out^1.&* You feel like a rock star./^");
ds_map_add(global.text_data_en, "obj_shyren_520", "* You hum some more^1.&* But the constant attention.../");
ds_map_add(global.text_data_en, "obj_shyren_521", "* The tours..^1.&* The groupies..^1.&* It's all.../^");
ds_map_add(global.text_data_en, "obj_shyren_522", "* You and Shyren have come so&  far^1, but it's time./");
ds_map_add(global.text_data_en, "obj_shyren_523", "* You both have your own&  journeys to embark on./");
ds_map_add(global.text_data_en, "obj_shyren_524", "* You hum a farewell song./^");
ds_map_add(global.text_data_en, "obj_shyren_537", "* You smile^1.&* You ask to see Shyren's smile^1,&  too./");
ds_map_add(global.text_data_en, "obj_shyren_538", "* Shyren gets quieter^1.&* In the corner^1, Aaron nods&  his head approvingly./^");
ds_map_add(global.text_data_en, "obj_shyren_539", "* You keep smiling^1.&* But nothing happened./^");
ds_map_add(global.text_data_en, "obj_shyren_540", "* You give a darling smile and&  a little wink./");
ds_map_add(global.text_data_en, "obj_shyren_541", "* The crowd goes wild!/^");
ds_map_add(global.text_data_en, "obj_shyren_550", "* You wave your arms wildly^1.&* You are now vulnerable&  to electric attacks./^");
ds_map_add(global.text_data_en, "obj_shyren_551", "* You wave your arms wildly^1.&* The crowd eats it up./^");
ds_map_add(global.text_data_en, "obj_shyrenstrewn_60", "* It's a mixture of socks^1,&  fanmail^1, and toilet paper./%%");
ds_map_add(global.text_data_en, "obj_shyrenstrewn_61", "* There's a conspicuous&  lack of anything on the&  ground./%%");
