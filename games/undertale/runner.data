ds_map_add(global.text_data_en, "SCR_TEXT_61", "\Y ");
ds_map_add(global.text_data_en, "SCR_TEXT_62", "\p ");
ds_map_add(global.text_data_en, "SCR_TEXT_99", "* You bid a quiet farewell&  to the \[I].");
ds_map_add(global.text_data_en, "SCR_TEXT_100", "* You put the \[I]&  on the ground and gave it a&  little pat.");
ds_map_add(global.text_data_en, "SCR_TEXT_102", "* You threw the \[I]&  on the ground like the piece&  of trash it is.");
ds_map_add(global.text_data_en, "SCR_TEXT_103", "* You abandoned the &  \[I].");
ds_map_add(global.text_data_en, "SCR_TEXT_104", "* The \[I] was&  thrown away.");
ds_map_add(global.text_data_en, "SCR_TEXT_111", "   * I'm outta here.");
ds_map_add(global.text_data_en, "SCR_TEXT_112", "   * I've got better to do.");
ds_map_add(global.text_data_en, "SCR_TEXT_113", "   * Escaped...");
ds_map_add(global.text_data_en, "SCR_TEXT_114", "   * Don't slow me down.");
ds_map_add(global.text_data_en, "SCR_TEXT_121", "   * Ran away with \[1] EXP&     and \[2] GOLD.");
ds_map_add(global.text_data_en, "SCR_TEXT_127", "* (The shadow of the ruins&  looms above^1, filling you with&  determination.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_128", "* (HP fully restored.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_129", "* (Playfully crinkling through&  the leaves fills you with&  determination.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_130", "* (HP fully restored.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_131", "* (Knowing the mouse might one&  day leave its hole and&  get the cheese...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_132", "* (It fills you with&  determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_133", "* (Seeing such a cute^1, tidy&  house in the RUINS gives&  you determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_134", "* Determination./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_135", "* (The cold atmosphere of a&  new land... it fills you&  with determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_136", "* (The convenience of that&  lamp still fills you&  with determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_137", "* (Knowing the mouse might one&  day find a way to heat&  up the spaghetti...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_138", "* (It fills you with&  determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_140", "* (Knowing that dog will&  never give up trying to&  make the perfect snowdog...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_141", "* (It fills you with&  determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_142", "* (Snow can always be broken&  down and rebuilt into&  something more useful.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_143", "* (This simple fact fills&  you with determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_144", "* (The sight of such a friendly&  town fills you with&  determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_145", "* (The sound of rushing water&  fills you with&  determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_146", "* (A feeling of dread hangs&  over you...^1)&* (But you stay determined.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_147", "* (Knowing the mouse might one&  day extract the cheese from&  the mystical crystal...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_148", "* (It fills you with&  determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_150", "* (The sound of muffled rain&  on the cavetop...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_151", "* (The serene sound of a&  distant music box...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_152", "* (It fills you with&  determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_153", "* (The feeling of your socks&  squishing as you step&  gives you determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_156", "* (The waterfall here seems&  to flow from the&  ceiling of the cavern...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_157", "* (Occasionally^1, a piece of&  trash will flow&  through...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_158", "* (... and fall into the&  bottomless abyss below.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_159", "* (Viewing this endless&  cycle of worthless&  garbage...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_160", "* (It fills you with&  determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_161", "* (Partaking in worthless&  garbage fills you&  with determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_164", "* (You feel a calming&  tranquility^1. You're filled&  with determination...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_165", "* (You feel..^1. something.)&* (You're filled with&  detemmienation.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_168", "* (The wind is howling^1.&* You're filled with&  determination...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_169", "* (The howling wind is&  now a breeze^1. This gives&  you determination...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_170", "* (The wind has stopped^1.&* You're filled with&  determination...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_174", "* (Seeing such a strange&  laboratory in a place like&  this...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_175", "* (You're filled with&  determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_180", "* (The wooshing sound of steam&  and cogs..^1. it fills you&  with determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_184", "* (An ominous structure looms&  in the distance...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_185", "* (You're filled with&  determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_187", "* (Knowing the mouse might one&  day hack the computerized&  safe and get the cheese...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_188", "* (It fills you with&  determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_191", "* (A huge structure lies north.^1)&* (You're filled with&  determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_195", "* (The relaxing atmosphere&  of this hotel..^1. it fills&  you with determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_199", "* (The air is filled with&  the smell of ozone..^1. it fills&  you with determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_203", "* (Behind this door must be&  the elevator to the King's&  castle.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_204", "* (You're filled with&  determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_208", "* (The smell of cobwebs fills&  the air...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_209", "* (You're filled with&  determination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_242", "* You leave the Quiche on the&  ground and tell it you'll&  be right back./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_246", "* Use the box?& &         Yes         No      \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_247", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_248", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_270", "  %%");
ds_map_add(global.text_data_en, "SCR_TEXT_275", "* You have no items^1.&* You put a little time into&  the box./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_276", "* You have no items^1.&* You put a little effort&  into the box./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_277", "* You have no items^1.&* You put a little feeling&  into the box./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_282", "  %%");
ds_map_add(global.text_data_en, "SCR_TEXT_291", "\W* Howdy^2!&* I'm\Y FLOWEY\W.^2 &* \YFLOWEY\W the \YFLOWER\W!/");
ds_map_add(global.text_data_en, "SCR_TEXT_292", "* Hmmm.../");
ds_map_add(global.text_data_en, "SCR_TEXT_293", "* You're new to the&  UNDERGROUND^2, aren'tcha?/");
ds_map_add(global.text_data_en, "SCR_TEXT_294", "* Golly^1, you must be&  so confused./");
ds_map_add(global.text_data_en, "SCR_TEXT_295", "* Someone ought to teach&  you how things work&  around here!/");
ds_map_add(global.text_data_en, "SCR_TEXT_296", "* I guess little old me&  will have to do./");
ds_map_add(global.text_data_en, "SCR_TEXT_297", "* Ready^2?&* Here we go!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_301", "\E2* This way./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_302", "%%%");
ds_map_add(global.text_data_en, "SCR_TEXT_306", "\E2* Welcome to your new&  home^1, innocent one./");
ds_map_add(global.text_data_en, "SCR_TEXT_307", "* Allow me to educate you&  in the operation of the&  RUINS./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_311", "\E2* The RUINS are full of&  puzzles./");
ds_map_add(global.text_data_en, "SCR_TEXT_312", "* Ancient fusions between &  diversions and doorkeys./");
ds_map_add(global.text_data_en, "SCR_TEXT_313", "* One must solve them&  to move from room to&  room./");
ds_map_add(global.text_data_en, "SCR_TEXT_314", "* Please adjust yourself    to the sight of them./%");
ds_map_add(global.text_data_en, "SCR_TEXT_318", "\E2* To make progress here,^1 &  you will need to trigger&  several switches./");
ds_map_add(global.text_data_en, "SCR_TEXT_319", "* Do not worry,^1 I have &  labelled the ones that&  you need to flip./%");
ds_map_add(global.text_data_en, "SCR_TEXT_322", "* Do not worry,^1 I have &  labelled the ones that&  you need to flip./");
ds_map_add(global.text_data_en, "SCR_TEXT_323", "* ... eh^1?&* It seems that the&  labelling has worn away./");
ds_map_add(global.text_data_en, "SCR_TEXT_324", "* Oh dear./");
ds_map_add(global.text_data_en, "SCR_TEXT_325", "* This might be far more&  challenging than I&  anticipated.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_330", "\E2* The first switch is over&  on the wall./%");
ds_map_add(global.text_data_en, "SCR_TEXT_334", "\E1* Do you need some help..^1?&* Press the switch on the   wall./");
ds_map_add(global.text_data_en, "SCR_TEXT_335", "\E0* Come on^1, you can do it!/%");
ds_map_add(global.text_data_en, "SCR_TEXT_339", "\E2* Go on^1, press the switch&  on the left./%");
ds_map_add(global.text_data_en, "SCR_TEXT_342", "\E2* I believe it was&  the switch on the&  left./%");
ds_map_add(global.text_data_en, "SCR_TEXT_347", "\E1* You do know which way&  left is^1, do you not?/");
ds_map_add(global.text_data_en, "SCR_TEXT_348", "\E0* Press the switch that I&  labelled for you./%");
ds_map_add(global.text_data_en, "SCR_TEXT_352", "\E1* You do know which way&  left is^1, do you not?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_357", "\E1* You are very curious,^1 &  are you not?/");
ds_map_add(global.text_data_en, "SCR_TEXT_358", "\E1* Please understand.^2 & \E0I only want the best&  for you./%");
ds_map_add(global.text_data_en, "SCR_TEXT_362", "\E0* Splendid!^2 &* I am proud of you,^1 &  little one./");
ds_map_add(global.text_data_en, "SCR_TEXT_363", "* Let us move to the&  next room./%");
ds_map_add(global.text_data_en, "SCR_TEXT_367", "\E1* As a human living in&  the UNDERGROUND,^1 &  monsters may attack you./");
ds_map_add(global.text_data_en, "SCR_TEXT_368", "\E2* You will need to be&  prepared for this&  situation./");
ds_map_add(global.text_data_en, "SCR_TEXT_369", "\E0* However, worry not!^2 &* The process is simple./");
ds_map_add(global.text_data_en, "SCR_TEXT_370", "\E2* When you encounter a &  monster,^1 you will enter&  a FIGHT./");
ds_map_add(global.text_data_en, "SCR_TEXT_371", "* While you are in a&  FIGHT^1, strike up a&  friendly conversation./");
ds_map_add(global.text_data_en, "SCR_TEXT_372", "\E2* Stall for time.&  I will come to resolve&  the conflict./");
ds_map_add(global.text_data_en, "SCR_TEXT_373", "\E2* Practice talking to&  the dummy./%");
ds_map_add(global.text_data_en, "SCR_TEXT_379", "\E1* Ahh,^1 the dummies are&  not for fighting!^2 &* They are for talking!/");
ds_map_add(global.text_data_en, "SCR_TEXT_380", "* We do not want to hurt&  anybody, do we...?^2 \E0 &* Come now./%");
ds_map_add(global.text_data_en, "SCR_TEXT_384", "\E0* Ah,^1 very good!^2 &* You are very good./%");
ds_map_add(global.text_data_en, "SCR_TEXT_388", "\E1* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_389", "\E1* ... you ran away.../");
ds_map_add(global.text_data_en, "SCR_TEXT_390", "\E0* Truthfully^1, that was&  not a poor choice./");
ds_map_add(global.text_data_en, "SCR_TEXT_391", "\E0* It is better to&  avoid conflict&  whenever possible./");
ds_map_add(global.text_data_en, "SCR_TEXT_392", "\E1* That..^1. however^1, is&  only a dummy^2.&* It cannot harm you./");
ds_map_add(global.text_data_en, "SCR_TEXT_393", "\E1* It is made of cotton^1.&* It has no desire&  for revenge.../");
ds_map_add(global.text_data_en, "SCR_TEXT_394", "\E0* Nevermind^2.&* Stay close to me and&  I will keep you safe./%");
ds_map_add(global.text_data_en, "SCR_TEXT_398", "\E3* ^1.^1.^1./");
ds_map_add(global.text_data_en, "SCR_TEXT_399", "\E4* ^1.^1.^1./");
ds_map_add(global.text_data_en, "SCR_TEXT_400", "\E0* The next room awaits./%");
ds_map_add(global.text_data_en, "SCR_TEXT_405", "\E2* Practice talking to&  the dummy./");
ds_map_add(global.text_data_en, "SCR_TEXT_406", "\E1* You can say anything..^2.\E2 &* I do not think the dummy&  will be bothered./%");
ds_map_add(global.text_data_en, "SCR_TEXT_411", "\E0* Do you need some&  ideas for conversation&  topics?/");
ds_map_add(global.text_data_en, "SCR_TEXT_412", "* Well^1, I often start with&  a simple 'how do you&  do...'/");
ds_map_add(global.text_data_en, "SCR_TEXT_413", "* You could ask them about&  their favorite books.../");
ds_map_add(global.text_data_en, "SCR_TEXT_414", "* Jokes can be useful for&  'breaking the ice.'/");
ds_map_add(global.text_data_en, "SCR_TEXT_415", "* Listen to this one.../");
ds_map_add(global.text_data_en, "SCR_TEXT_416", "* What did the skeleton&  tile his roof with?/");
ds_map_add(global.text_data_en, "SCR_TEXT_417", "* ... SHIN-gles!/");
ds_map_add(global.text_data_en, "SCR_TEXT_418", "\E1* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_419", "\E0* Well^1, I thought it&  was amusing./%");
ds_map_add(global.text_data_en, "SCR_TEXT_423", "\E2* Practice talking to&  the dummy./");
ds_map_add(global.text_data_en, "SCR_TEXT_424", "\E1* You can say anything..^2.\E0 &* The dummy will not&  be bothered./%");
ds_map_add(global.text_data_en, "SCR_TEXT_428", "\E1* There is another puzzle&  in this room.../");
ds_map_add(global.text_data_en, "SCR_TEXT_429", "\E0* I wonder if you can&  solve it?/%");
ds_map_add(global.text_data_en, "SCR_TEXT_433", "\E1* This is the puzzle^1,&  but.../");
ds_map_add(global.text_data_en, "SCR_TEXT_434", "\E0* Here^1, take my hand&  for a moment./%");
ds_map_add(global.text_data_en, "SCR_TEXT_438", "\E1* Puzzles seem a little&  too dangerous for&  now./%");
ds_map_add(global.text_data_en, "SCR_TEXT_442", ".../%");
ds_map_add(global.text_data_en, "SCR_TEXT_446", "\E2* Greetings,^1 my child^2.&* Do not worry^1, I did&  not leave you./");
ds_map_add(global.text_data_en, "SCR_TEXT_447", "\E0* I was merely behind this&  pillar the whole time./");
ds_map_add(global.text_data_en, "SCR_TEXT_448", "* Thank you for trusting&  me./");
ds_map_add(global.text_data_en, "SCR_TEXT_449", "\E2* However^1, there was an&  important reason for&  this exercise./");
ds_map_add(global.text_data_en, "SCR_TEXT_450", "* ... to test your&  independence./");
ds_map_add(global.text_data_en, "SCR_TEXT_451", "\E1* I must attend to some&  business^1, and you must&  stay alone for a while./");
ds_map_add(global.text_data_en, "SCR_TEXT_452", "\E0* Please remain here^2.&*\E1 It's dangerous to&  explore by yourself./");
ds_map_add(global.text_data_en, "SCR_TEXT_453", "\E0* I have an idea^2.&* I will give you a&  CELL PHONE./");
ds_map_add(global.text_data_en, "SCR_TEXT_454", "* If you have a need for&  anything^1, just call./");
ds_map_add(global.text_data_en, "SCR_TEXT_455", "\E1* Be good^1, alright?/%");
ds_map_add(global.text_data_en, "SCR_TEXT_459", "\E0* You have done&  excellently thus&  far^1, my child./");
ds_map_add(global.text_data_en, "SCR_TEXT_460", "\E2* However... I have a&  difficult request to ask&  of you./");
ds_map_add(global.text_data_en, "SCR_TEXT_461", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_462", "* I would like you to walk&  to the end of the room&  by yourself./");
ds_map_add(global.text_data_en, "SCR_TEXT_463", "\E1* Forgive me for this./%");
ds_map_add(global.text_data_en, "SCR_TEXT_467", "* Ring..\E0.\TT /");
ds_map_add(global.text_data_en, "SCR_TEXT_468", "\F1 %");
ds_map_add(global.text_data_en, "SCR_TEXT_469", "* Hello?&* This is TORIEL./");
ds_map_add(global.text_data_en, "SCR_TEXT_470", "* For no reason in&  particular...&* Which do you prefer?/");
ds_map_add(global.text_data_en, "SCR_TEXT_471", "* Cinnamon or&  butterscotch?&  Cinnamon    Bscotch \C");
ds_map_add(global.text_data_en, "SCR_TEXT_472", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_490", "* Oh^1, I see.&* Thank you very much!/");
ds_map_add(global.text_data_en, "SCR_TEXT_491", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_492", "* Click.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_493", "* /");
ds_map_add(global.text_data_en, "SCR_TEXT_497", "* It's a fishing rod affixed&  to the ground.../");
ds_map_add(global.text_data_en, "SCR_TEXT_498", "* Reel it in?& &         Yes         No      \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_499", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_511", "* All that's attached to&  the end is a photo of a&  weird-looking monster.../");
ds_map_add(global.text_data_en, "SCR_TEXT_512", "* (Call Me!&  Here's my number!)/");
ds_map_add(global.text_data_en, "SCR_TEXT_513", "* You decide not to call./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_516", "* All that's attached to&  the end is a note./");
ds_map_add(global.text_data_en, "SCR_TEXT_517", "* (Nevermind^1, guys!)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_522", "* You leave it alone./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_529", "* I shouldn't have given myself&  away so easily.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_533", "* Did you just...&* Consume the part of me&  I had given you?/");
ds_map_add(global.text_data_en, "SCR_TEXT_534", "* In front of my very eyes!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_535", "* I have no words for you..^1.&* Begone!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_540", "* Thank you for taking care&  of me.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_545", "* Huh^1? Again...?/");
ds_map_add(global.text_data_en, "SCR_TEXT_546", "* I'm sorry..^1. if I give you&  any more^1, there will be&  nothing left of me./");
ds_map_add(global.text_data_en, "SCR_TEXT_547", "* I suppose it is true^1.&* Travelling beyond our limits&  is but a fantasy./");
ds_map_add(global.text_data_en, "SCR_TEXT_548", "* It's no different for&  anyone else./");
ds_map_add(global.text_data_en, "SCR_TEXT_549", "* All of monsterkind&  are doomed to stay&  underground^1, forever.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_554", "* How am I doing^1?&* By \"I\" I mean the piece&  of me I gave you.../");ds_map_add(global.text_data_en, "SCR_TEXT_559", "* Huh^1? You lost it...^1?&* ... I suppose I can give&  you another piece.../");
ds_map_add(global.text_data_en, "SCR_TEXT_563", "* You don't have any room^1?&* OK..^1. I understand I am not&  a priority for you^1, then./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_567", "* Please be careful this&  time./");
ds_map_add(global.text_data_en, "SCR_TEXT_568", "* (You got the Snowman&  Piece.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_576", "* Hello^1.&* I am a snowman./");
ds_map_add(global.text_data_en, "SCR_TEXT_577", "* I want to see the world..^1.&* But I cannot move./");
ds_map_add(global.text_data_en, "SCR_TEXT_578", "* If you would be so kind^1,&  traveller^1, please.../");
ds_map_add(global.text_data_en, "SCR_TEXT_579", "* Take a piece of me and&  bring it very far away.&         Yes         No      \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_580", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_590", "* It seems you do not&  have enough room for me./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_593", "* Thank you... good luck!/");
ds_map_add(global.text_data_en, "SCR_TEXT_594", "* (You got the Snowman&  Piece.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_600", "* I see^1.&* Good journey^1, then./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_605", "SANS!!^1!&THAT DIDN'T DO&ANYTHING!/");
ds_map_add(global.text_data_en, "SCR_TEXT_606", "SANS!!^1!&THEY DIDN'T EVEN&LOOK AT IT!/");
ds_map_add(global.text_data_en, "SCR_TEXT_608", "* whoops./");
ds_map_add(global.text_data_en, "SCR_TEXT_609", "* i knew i should have&  used today's crossword&  instead./");
ds_map_add(global.text_data_en, "SCR_TEXT_611", "WHAT!^1?&CROSSWORD!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_612", "I CAN'T BELIEVE&YOU SAID THAT!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_613", "IN MY OPINION.../");
ds_map_add(global.text_data_en, "SCR_TEXT_614", "\E3JUNIOR JUMBLE&IS EASILY THE&HARDEST./");
ds_map_add(global.text_data_en, "SCR_TEXT_616", "* what^1? really^1, dude^1?&* that easy-peasy word&  scramble?/");
ds_map_add(global.text_data_en, "SCR_TEXT_617", "\E1* that's for baby bones./");
ds_map_add(global.text_data_en, "SCR_TEXT_619", "UN^1. BELIEVABLE./");
ds_map_add(global.text_data_en, "SCR_TEXT_620", "\E0HUMAN!!^1!&SOLVE THIS DISPUTE!/");
ds_map_add(global.text_data_en, "SCR_TEXT_621", "\TS \F0 \E0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_622", "* (Which is harder?)& &         Jumble      Crossword \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_623", "   ");
ds_map_add(global.text_data_en, "SCR_TEXT_631", "HA^1! HA^1! YES!/");
ds_map_add(global.text_data_en, "SCR_TEXT_632", "HUMANS MUST BE&VERY INTELLIGENT!/");
ds_map_add(global.text_data_en, "SCR_TEXT_633", "IF THEY ALSO FIND&JUNIOR JUMBLE&SO DIFFICULT!/");
ds_map_add(global.text_data_en, "SCR_TEXT_634", "NYEH^1! HEH^1! HEH HEH!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_639", "YOU TWO ARE WEIRD!/");
ds_map_add(global.text_data_en, "SCR_TEXT_640", "\E3CROSSWORDS ARE SO&EASY./");
ds_map_add(global.text_data_en, "SCR_TEXT_641", "IT'S THE SAME&SOLUTION EVERY&TIME./");
ds_map_add(global.text_data_en, "SCR_TEXT_642", "\E0I JUST FILL ALL&THE BOXES IN WITH&THE LETTER \"Z\".../");ds_map_add(global.text_data_en, "SCR_TEXT_643", "BECAUSE EVERY TIME&I LOOK AT A&CROSSWORD.../");
ds_map_add(global.text_data_en, "SCR_TEXT_644", "ALL I CAN DO IS&SNORE!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_645", "NYEH HEH HEH!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_654", "* Hello^1!&* Would you like some&  Nice Cream?/");
ds_map_add(global.text_data_en, "SCR_TEXT_655", "* It's the frozen treat&  that warms your heart!/");
ds_map_add(global.text_data_en, "SCR_TEXT_656", "* Now just 15G!& &         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_657", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_661", " %");
ds_map_add(global.text_data_en, "SCR_TEXT_662", "* Nice Cream^1!&* It's the frozen treat&  that warms your heart!/");
ds_map_add(global.text_data_en, "SCR_TEXT_663", "* Now just 15G!& &         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_664", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_682", "* Here you go^1!&* Have a super-duper day^1!&* (You got the Nice Cream.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_684", "* Huh^1?&* You don't have enough&  money.../");
ds_map_add(global.text_data_en, "SCR_TEXT_685", "* I wish I could make&  Nice Cream for free.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_688", "* It looks like you're&  holding too much stuff^1!&* Oh well!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_691", "* Well then..^1.&* Tell your friends.../");
ds_map_add(global.text_data_en, "SCR_TEXT_692", "* There's ice cream..^1.&* Out in the middle of&  the woods.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_704", "* Hello^1!&* Would you like some&  Nice Cream?/");
ds_map_add(global.text_data_en, "SCR_TEXT_705", "* It's the frozen treat&  that warms your heart!/");
ds_map_add(global.text_data_en, "SCR_TEXT_706", "* Now just 25G!& &         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_707", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_711", " %");
ds_map_add(global.text_data_en, "SCR_TEXT_712", "* Nice Cream^1!&* It's the frozen treat&  that warms your heart!/");
ds_map_add(global.text_data_en, "SCR_TEXT_713", "* Now just 25G!& &         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_714", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_721", "* Hey^1, you have an umbrella^1,&  just like my cart.../");
ds_map_add(global.text_data_en, "SCR_TEXT_722", "* Such solidarity^1!&* I have no choice but to&  give you a deal!/");
ds_map_add(global.text_data_en, "SCR_TEXT_723", "* Discount Ice Cream! 15G!& &         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_724", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_728", " %");
ds_map_add(global.text_data_en, "SCR_TEXT_729", "* Umbrella solidarity!^1?&* I guess I have to give&  you a deal.../");
ds_map_add(global.text_data_en, "SCR_TEXT_730", "* Discount Ice Cream! 15G!& &         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_731", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_736", "* Hey^1!&* You have 3 Punch Cards!/");
ds_map_add(global.text_data_en, "SCR_TEXT_737", "* How about redeeming them&  for some Nice Cream!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_738", "* It's free!& &         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_739", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_777", "* Super^1! Here you go^1!&* Your Card's in the box!&* (You got the Nice Cream.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_779", "* Huh^1? No money^1?&* Sorry^1, I can't give it to&  you for free./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_781", "* Huh^1? You can't afford it&  even with the discount^1?&* I.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_784", "* It looks like you're&  holding too much stuff^1!&* Oh well!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_803", "* Here^1! A free Nice Cream^1!&* (You lost 3 cards and got&  a Nice Cream.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_809", "* Well then..^1.&* Tell your friends.../");
ds_map_add(global.text_data_en, "SCR_TEXT_810", "* There's ice cream..^1.&* Hidden in the depths of a&  watery cavern.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_815", "* i've been thinking&  about selling treats&  too./");
ds_map_add(global.text_data_en, "SCR_TEXT_816", "* want some fried snow^1?&* it's just 5G.&  Buy         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_817", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_823", "* did i say 5G^1?&* i meant 50G^1.&  Buy         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_824", "  ");
ds_map_add(global.text_data_en, "SCR_TEXT_828", "* you're right./");
ds_map_add(global.text_data_en, "SCR_TEXT_829", "* i should charge way&  more than that./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_836", "* really^1?&* how about 5000G?&  Buy         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_837", "  ");
ds_map_add(global.text_data_en, "SCR_TEXT_841", "* you're right./");
ds_map_add(global.text_data_en, "SCR_TEXT_842", "* that's still too low./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_849", "* 50000G^1.&* that's my final offer.&  Buy         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_850", "  ");
ds_map_add(global.text_data_en, "SCR_TEXT_854", "* i have to pay for&  the raw materials&  somehow./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_861", "* what^1?&* you don't have the&  money?/");
ds_map_add(global.text_data_en, "SCR_TEXT_862", "* hey^1, that's okay./");
ds_map_add(global.text_data_en, "SCR_TEXT_863", "\E1* i don't have any snow./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_867", "* wow^1, that's a lot&  of cash./");
ds_map_add(global.text_data_en, "SCR_TEXT_868", "\E3* that's why i'm sorry&  to say.../");
ds_map_add(global.text_data_en, "SCR_TEXT_869", "\E3* i can't sell you&  this fried snow./");
ds_map_add(global.text_data_en, "SCR_TEXT_870", "\E2* it's got too much&  sentimental value./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_875", "* don't you know a&  good deal when you&  hear one?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_880", "WHAT!^1?&HOW DID YOU&AVOID MY TRAP?/");
ds_map_add(global.text_data_en, "SCR_TEXT_881", "\E3AND^1, MORE&IMPORTANTLY.../");
ds_map_add(global.text_data_en, "SCR_TEXT_882", "\E0IS THERE ANY&LEFT FOR ME???/");
ds_map_add(global.text_data_en, "SCR_TEXT_883", "\TS \F0 \E0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_884", "* (What do you tell Papyrus&  about his spaghetti?)&         Ate it      Left it   \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_885", "   ");
ds_map_add(global.text_data_en, "SCR_TEXT_890", "REALLY!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_893", "\E2WOWIE.../");
ds_map_add(global.text_data_en, "SCR_TEXT_894", "NO ONE'S EVER&ENJOYED MY&COOKING BEFORE.../");
ds_map_add(global.text_data_en, "SCR_TEXT_895", "\E0WELL THEN!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_900", "\E2WOWIE.../");
ds_map_add(global.text_data_en, "SCR_TEXT_901", "YOU RESISTED THE&FLAVOR OF MY&HOMECOOKED PASTA.../");
ds_map_add(global.text_data_en, "SCR_TEXT_902", "JUST SO YOU&COULD SHARE&IT WITH ME???/");
ds_map_add(global.text_data_en, "SCR_TEXT_905", "\E0FRET NOT HUMAN^1!&I^1, MASTER CHEF&PAPYRUS.../");
ds_map_add(global.text_data_en, "SCR_TEXT_906", "WILL MAKE YOU ALL&THE PASTA YOU&COULD EVER WANT!/");
ds_map_add(global.text_data_en, "SCR_TEXT_907", "HEH HEH HEH HEH&HEH HEH NYEH!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_911", "HEY!/");
ds_map_add(global.text_data_en, "SCR_TEXT_912", "IT'S THE HUMAN!/");
ds_map_add(global.text_data_en, "SCR_TEXT_913", "\E0YOU'RE GONNA&LOVE THIS&PUZZLE!/");
ds_map_add(global.text_data_en, "SCR_TEXT_914", "IT WAS MADE&BY THE GREAT&DR. ALPHYS!/");
ds_map_add(global.text_data_en, "SCR_TEXT_915", "YOU SEE&THESE TILES&!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_916", "ONCE I THROW&THIS SWITCH.../");
ds_map_add(global.text_data_en, "SCR_TEXT_917", "THEY WILL&BEGIN TO&CHANGE COLOR!/");
ds_map_add(global.text_data_en, "SCR_TEXT_918", "EACH COLOR HAS&A DIFFERENT&FUNCTION!/");
ds_map_add(global.text_data_en, "SCR_TEXT_919", "RED TILES ARE&IMPASSABLE!/");
ds_map_add(global.text_data_en, "SCR_TEXT_920", "YOU CANNOT&WALK ON THEM!/");
ds_map_add(global.text_data_en, "SCR_TEXT_921", "YELLOW TILES&ARE ELECTRIC!/");
ds_map_add(global.text_data_en, "SCR_TEXT_922", "THEY WILL&ELECTROCUTE&YOU!/");
ds_map_add(global.text_data_en, "SCR_TEXT_923", "GREEN TILES&ARE ALARM&TILES!/");
ds_map_add(global.text_data_en, "SCR_TEXT_924", "IF YOU STEP&ON THEM.../");
ds_map_add(global.text_data_en, "SCR_TEXT_925", "YOU WILL HAVE&TO FIGHT A&MONSTER!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_926", "ORANGE TILES&ARE ORANGE-&SCENTED./");
ds_map_add(global.text_data_en, "SCR_TEXT_927", "THEY WILL MAKE&YOU SMELL&DELICIOUS!/");
ds_map_add(global.text_data_en, "SCR_TEXT_928", "BLUE TILES ARE&WATER TILES./");
ds_map_add(global.text_data_en, "SCR_TEXT_929", "SWIM THROUGH&IF YOU LIKE^1,&BUT.../");
ds_map_add(global.text_data_en, "SCR_TEXT_930", "IF YOU SMELL&LIKE ORANGES!/");
ds_map_add(global.text_data_en, "SCR_TEXT_931", "THE PIRANHAS&WILL BITE&YOU./");
ds_map_add(global.text_data_en, "SCR_TEXT_932", "ALSO^1, IF A&BLUE TILE IS&NEXT TO A,/");
ds_map_add(global.text_data_en, "SCR_TEXT_933", "YELLOW TILE^1,&THE WATER WILL&ALSO ZAP YOU!/");
ds_map_add(global.text_data_en, "SCR_TEXT_934", "PURPLE TILES&ARE SLIPPERY!/");
ds_map_add(global.text_data_en, "SCR_TEXT_935", "YOU WILL SLIDE&TO THE NEXT&TILE!/");
ds_map_add(global.text_data_en, "SCR_TEXT_936", "HOWEVER^1, THE&SLIPPERY&SOAP.../");
ds_map_add(global.text_data_en, "SCR_TEXT_937", "SMELLS LIKE&LEMONS!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_938", "WHICH PIRANHAS&DO NOT LIKE!/");
ds_map_add(global.text_data_en, "SCR_TEXT_939", "PURPLE AND&BLUE ARE OK!/");
ds_map_add(global.text_data_en, "SCR_TEXT_940", "FINALLY^1,&PINK TILES./");
ds_map_add(global.text_data_en, "SCR_TEXT_941", "THEY DON'T DO&ANYTHING./");
ds_map_add(global.text_data_en, "SCR_TEXT_942", "STEP ON THEM&ALL YOU LIKE./");
ds_map_add(global.text_data_en, "SCR_TEXT_943", "HOW WAS THAT!^1?&UNDERSTAND???/");
ds_map_add(global.text_data_en, "SCR_TEXT_944", "\TS \F0 \E0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_945", "* (Understand the explanation?)& &         Of course   No        \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_946", "   ");
ds_map_add(global.text_data_en, "SCR_TEXT_953", "GREAT!^1!&THEN THERE'S ONE&LAST THING.../");
ds_map_add(global.text_data_en, "SCR_TEXT_954", "THIS PUZZLE.../");
ds_map_add(global.text_data_en, "SCR_TEXT_955", "IS ENTIRELY RANDOM&!!!!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_956", "WHEN I PULL THIS&SWITCH^1, IT WILL&MAKE A PUZZLE.../");
ds_map_add(global.text_data_en, "SCR_TEXT_957", "THAT HAS NEVER&BEEN SEEN BEFORE!/");
ds_map_add(global.text_data_en, "SCR_TEXT_958", "NOT EVEN I WILL&KNOW THE SOLUTION!/");
ds_map_add(global.text_data_en, "SCR_TEXT_959", "NYEH HEH HEH^1!&GET READY...!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_965", "OKAY..^1.&I GUESS I'LL&REPEAT MYSELF.../");
ds_map_add(global.text_data_en, "SCR_TEXT_966", "\E0RED TILES ARE&IMPASSABLE./");
ds_map_add(global.text_data_en, "SCR_TEXT_967", "YELLOW TILES ARE&ELECTRIC AND&DANGEROUS./");
ds_map_add(global.text_data_en, "SCR_TEXT_968", "BLUE TILES MAKE&YOU FIGHT A&MONSTER./");
ds_map_add(global.text_data_en, "SCR_TEXT_969", "GREEN TILES ARE&WATER TILES./");
ds_map_add(global.text_data_en, "SCR_TEXT_970", "ORANGE TILES ARE&ORANGE SCENTED./");
ds_map_add(global.text_data_en, "SCR_TEXT_971", "IF YOU STEP ON&ORANGE^1, DON'T STEP&ON GREEN./");
ds_map_add(global.text_data_en, "SCR_TEXT_972", "\E3BROWN TILES ARE.../");
ds_map_add(global.text_data_en, "SCR_TEXT_973", "\E1WAIT!!^1!&THERE ARE NO&BROWN TILES.../");
ds_map_add(global.text_data_en, "SCR_TEXT_974", "\E0PURPLE TILES&SMELL LIKE&LEMONS.../");
ds_map_add(global.text_data_en, "SCR_TEXT_975", "\E3WHY DON'T THE&YELLOW ONES&SMELL LEMONY?/");
ds_map_add(global.text_data_en, "SCR_TEXT_976", "\E3UMM.../");
ds_map_add(global.text_data_en, "SCR_TEXT_977", "\E1WAIT!^1!&DID I MIX UP&GREEN AND BLUE!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_978", "THE BLUE ONES&ARE WATER ONES!/");
ds_map_add(global.text_data_en, "SCR_TEXT_979", "\E3PINK TILES.../");
ds_map_add(global.text_data_en, "SCR_TEXT_980", "I DON'T..^1.&REMEMBER???/");
ds_map_add(global.text_data_en, "SCR_TEXT_981", "\E1WAIT!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_982", "\E3THOSE ONES DON'T&DO ANYTHING./");
ds_map_add(global.text_data_en, "SCR_TEXT_983", "\E0OKAY^1!&DO YOU UNDERSTAND&BETTER NOW!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_984", "\TS \F0 \E0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_985", "* (Understand the explanation?)& &         Yes         Even less \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_986", "   ");
ds_map_add(global.text_data_en, "SCR_TEXT_994", "GREAT!^1!&THEN THERE'S ONE&LAST THING.../");
ds_map_add(global.text_data_en, "SCR_TEXT_995", "THIS PUZZLE.../");
ds_map_add(global.text_data_en, "SCR_TEXT_996", "IS ENTIRELY RANDOM&!!!!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_997", "WHEN I PULL THIS&SWITCH^1, IT WILL&MAKE A PUZZLE.../");
ds_map_add(global.text_data_en, "SCR_TEXT_998", "THAT HAS NEVER&BEEN SEEN BEFORE!/");
ds_map_add(global.text_data_en, "SCR_TEXT_999", "NOT EVEN I WILL&KNOW THE SOLUTION!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1000", "NYEH HEH HEH^1!&GET READY...!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1006", "........../");
ds_map_add(global.text_data_en, "SCR_TEXT_1007", "OK^1, YOU KNOW&WHAT???/");
ds_map_add(global.text_data_en, "SCR_TEXT_1008", "HOW ABOUT..^1.&YOU JUST.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1009", "DO THIS PUZZLE..^1.&ON YOUR OWN.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1010", "I'LL LEAVE THE&INSTRUCTIONS.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1011", "JUST READ THEM./");
ds_map_add(global.text_data_en, "SCR_TEXT_1012", "THEN WHEN YOU&UNDERSTAND IT.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1013", "YOU CAN THROW&THE SWITCH./");
ds_map_add(global.text_data_en, "SCR_TEXT_1014", "AND DO IT AT&YOUR OWN PACE./");
ds_map_add(global.text_data_en, "SCR_TEXT_1015", "GOOD LUCK./");
ds_map_add(global.text_data_en, "SCR_TEXT_1016", "NYEH..^1.&HEH..^1.&HEH!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1024", "* (There's a lone quiche&  sitting underneath&  this bench.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1025", "* (Will you take it?)& &         Take it     Leave it  \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_1026", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1029", "* It's just a bench./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1045", "* (You got the Abandoned&  Quiche.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1048", "* (You're carrying too much.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1049", "* (You aren't ready for the&  responsibility.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1053", "* (The quiche was left all&  alone...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1060", "* (There's a tutu lying on&  the ground here.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1061", "* (Will you take it?)& &         Take it     Leave it  \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_1062", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1065", "* Nothing's here!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1081", "* (You got the Old Tutu.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1084", "* (You're carrying too much.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1088", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_1096", "* (The box contains \[1] cards.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1097", "* (Two bugs in the box are&  playing a \[1]-card game.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1098", "* (There's a smiley face made&  of \[1] cards in the box.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1099", "* (A house made of \[1] cards&  sits in the box.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1100", "* (The box is overstuffed with&  cards.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1101", "* (Take a card?)& &         Take        Leave \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_1102", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1105", "* (It's a box for storing Punch&  Cards^1.)&* (It's empty right now.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1120", "* (You got a Punch Card.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1121", "* (All games must end one day.^1)&* (You got a Punch Card.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1122", "* (Happiness is fleeting.^1)&* (You got a Punch Card.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1123", "* (The house collapses.^1)&* (You got a Punch Card.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1124", "* (You got a Punch Card.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1127", "* (You're carrying too much.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1131", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_1139", "* (It's a pair of ballet shoes.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1140", "* (Will you take it?)& &         Take it     Leave it  \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_1141", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1144", "* Nothing's here!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1160", "* (You got the Ballet Shoes.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1163", "* (You're carrying too much.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1167", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_1172", "* (This little bird wants to&  carry you across.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1173", "* (Accept the bird's offer?)& &         Get ride    No        \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_1174", "  ");
ds_map_add(global.text_data_en, "SCR_TEXT_1177", "* (Umbrellas and birds...^1)&* (A bad combination.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1182", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_1197", "* (It's a legendary artifact.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1198", "* (Will you take it?)& &         Take it     Leave it  \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_1199", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1202", "* (The artifact is gone.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1221", "* (This will never happen.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1224", "* (You're carrying too much.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1225", "* (You're carrying too many&  dogs.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1229", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_1237", "* (The fridge is filled with&  instant noodles and soda.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1238", "* (Take a package of noodles?)& &         Take it     Leave it  \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_1239", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1242", "* (The fridge is filled with&  instant noodles and soda.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1258", "* (You got the Instant Noodles.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1261", "* (You're carrying too much.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1265", "* (You decide to stay healthy.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1273", "* (There's a frypan lying on&  the ground.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1274", "* (Will you take it?)& &         Take it     Leave it  \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_1275", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1278", "* Nothing's here!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1294", "* (You got the Burnt Pan.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1297", "* (You're carrying too much.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1301", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_1308", "* (There's an apron lying on&  the ground.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1309", "* (Will you take it?)& &         Take it     Leave it  \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_1310", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1313", "* Nothing's here!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1329", "* (You got the Stained Apron.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1332", "* (You're carrying too much.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1336", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_1343", "* (There's a Glamburger inside&  the trash can.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1344", "* (Will you take it?)& &         Take it     Leave it  \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_1345", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1348", "* (It's an empty trashcan.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1363", "* (You got the Glamburger.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1366", "* (You're carrying too much.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1370", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_1378", "* (There's 100G inside&  the trash can.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1379", "* (Will you take it?)& &         Take it     Leave it  \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_1380", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1383", "* (It's an empty trashcan.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1393", "* (You got 100G.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1397", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_1406", "* (There's a worn dagger&  inside the box.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1408", "* (Knife inside the box.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1409", "* (Will you take it?)& &         Take it     Leave it  \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_1410", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1413", "* Nothing's here!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1431", "* (You got the Worn Dagger.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1432", "* (You got the Real Knife.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1435", "* (You're carrying too much.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1439", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_1446", "* (There's a heart-shaped&  locket inside the box.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1447", "* (Will you take it?)& &         Take it     Leave it  \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_1448", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1451", "* Nothing's here!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1470", "* (You got the Heart-shaped&  Locket.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1471", "* (You got The Locket.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1474", "* (You're carrying too much.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1478", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_1483", "* (The box is empty.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1492", "* Hello...&* Would you like some&  Nice Cream...?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1493", "* It's the frozen treat...&* That warms your heart./");
ds_map_add(global.text_data_en, "SCR_TEXT_1494", "* Now only 12G!& &         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1495", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1499", " %");
ds_map_add(global.text_data_en, "SCR_TEXT_1500", "* Nice Cream^1.&* It's the frozen treat^1.&* That warms your heart./");
ds_map_add(global.text_data_en, "SCR_TEXT_1501", "* Now just 12G.& &         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1502", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1520", "* Here^1.&* (You got the Nice Cream.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1522", "* You don't have enough&  money.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1525", "* Drop something./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1528", "* Well then..^1.&* Tell your friends.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1529", "* Life..^1. is suffering./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1535", "* (Golden flowers.^1)&* (They must have&  broken your fall.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1536", "%%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1540", "* \"Press \*Z to read signs!\"/%%");ds_map_add(global.text_data_en, "SCR_TEXT_1544", "* Just a regular old pillar./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1548", "* Please don't step on the&  leaves./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1552", "* Didn't you read the sign&  downstairs?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1562", "* WHOA there^1, pardner^2!&* Who said you could push&  me around?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1563", "* HMM^2?&* So you're ASKIN' me to&  move over?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1564", "* Okay^1, just for you^1,&  pumpkin./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1569", "* HMM^2?&* You want me to move some&  more?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1570", "* Alrighty^1, how's this?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1575", "* HMM^2?&* That was the wrong direction?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1576", "* Okay^1, think I got it./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1579", "* Was that helpful?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1583", "* HMM^2?&* You wanted me to STAY there?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1584", "* You're giving me a real&  workout./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1589", "* Aren't things easier when&  you just ask?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1592", "* The exit's open^1?&* Guess I better roll out.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1593", "* Hey^1, y'mind giving me a&  push^1, pumpkin?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1603", "* 'Take one.'&* Take a candy?&         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1604", "* It says 'take one.'&* Take a piece of candy?&         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1606", "* Look at what you've done./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1607", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1624", "* You took a piece of candy.&* (Press \*C to open the menu.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1625", "* You took more candy^1.&* How disgusting../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1626", "* You take another piece.&* You feel like the&  scum of the earth.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1628", "* You took too much too fast.&* The candy spills onto&  the floor./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1631", "* In this hellish world^1, you&  can only take 3 pieces&  of candy.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1635", "* You tried to take a piece&  of candy^1, but you didn't&  have any room./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1639", "* You decided not to take some./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1675", "* It says 'Take them all.'&* Take a candy?&         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1676", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1692", "* You took a piece.&* Boy^1, that's heavy./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1694", "* You can't carry more.&* It's just too heavy./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1695", "* You tried to take a piece&  of candy^1, but you didn't&  have any room./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1698", "* You decided not to take some./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1644", "* zzzzzzzzzzzzzzz..^1.&* zzzzzzzzzzzzzz.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1645", "* zzzzzzzzzz..^1.&* (are they gone yet^1)&* zzzzzzzzzzzzzzz.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1646", "* (This ghost keeps saying 'z'&  out loud repeatedly^1,&  pretending to sleep.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_1647", "* Move it with force?& &         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1648", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1705", "* Leave 7G in the web?& &         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1706", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1723", "* Some spiders crawled down&  and gave you a donut./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1724", "* You didn't have enough&  gold./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1726", "* You are carrying too&  many items./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1729", "*%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1736", "* Leave 18G in the web?& &         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1737", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1754", "* Some spiders crawled down&  and gave you a jug./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1755", "* You didn't have enough&  gold./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1757", "* You are carrying too&  many items./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1760", "*%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1771", "* You found a Faded Ribbon./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1772", "* You are carrying too&  much./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1778", "* It's a switch.&* Press it?&         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1779", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1788", "* Nothing happened./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1789", "%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1790", "* You're making the switches&  uncomfortable with all&  this attention./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1796", "* It's a switch.&* Press it?&         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1797", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1806", "* You hear a clicking sound./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1807", "%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1817", "* You found the Toy Knife./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1818", "* You are carrying too&  much./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1824", "* It's TORIEL's diary.&* Read the circled passage?&         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_1825", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1830", "* You read the passage.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1831", "* \"Why did the skeleton want&  a friend?\"/");ds_map_add(global.text_data_en, "SCR_TEXT_1832", "* \"Because she was feeling&  BONELY...\"/");ds_map_add(global.text_data_en, "SCR_TEXT_1833", "* The rest of the page is&  filled with jokes of&  a similar caliber./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1835", "%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1842", "* You found a slice of&  butterscotch-cinnamon&  pie./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1843", "* You are carrying too&  much./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1853", "* You found a slice of&  snail pie.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1854", "* You are carrying too&  much./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1859", "* Hello there^1,&  little one!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1860", "* The pie has not&  cooled down yet./");
ds_map_add(global.text_data_en, "SCR_TEXT_1861", "* Perhaps you should&  take a nap.&  Yes         No      \C ");
ds_map_add(global.text_data_en, "SCR_TEXT_1862", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1867", "* Sweet dreams./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1870", "\E1* You'd rather stay&  up and chat with&  me^1, then?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1871", "* Up already^1, I see?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1872", "\E0* Um^1, I want you to know&  how glad I am to&  have someone here./");
ds_map_add(global.text_data_en, "SCR_TEXT_1873", "* There are so many&  old books I want&  to share./");
ds_map_add(global.text_data_en, "SCR_TEXT_1874", "* I want to show you&  my favorite bug-&  hunting spot./");
ds_map_add(global.text_data_en, "SCR_TEXT_1875", "* I've also prepared&  a curriculum for&  your education./");
ds_map_add(global.text_data_en, "SCR_TEXT_1876", "* This may come as&  a surprise to you.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1877", "* But I have always&  wanted to be a&  teacher./");
ds_map_add(global.text_data_en, "SCR_TEXT_1878", "\E1* ... actually^1, perhaps&  that isn't very&  surprising./");
ds_map_add(global.text_data_en, "SCR_TEXT_1879", "\E5* STILL./");
ds_map_add(global.text_data_en, "SCR_TEXT_1880", "\E0* I am glad to have&  you living here./");
ds_map_add(global.text_data_en, "SCR_TEXT_1881", "\E1* Oh^1, did you&  want something?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1882", "* What is it?&               When can&  Nothing      I go home?\C ");
ds_map_add(global.text_data_en, "SCR_TEXT_1883", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1891", "* Well^1, talk to me&  again if you&  need anything./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1895", "\E1* What^1?&* This..^1. this IS your&  home now./");
ds_map_add(global.text_data_en, "SCR_TEXT_1896", "* Um..^1. would you like&  to hear about this&  book I am reading?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1897", "\E0* Oh^1, hello!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1898", "* Did you want to&  hear about the&  book I am reading?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1899", "\E0* It is called&  \"72 Uses for Snails.\"/");ds_map_add(global.text_data_en, "SCR_TEXT_1900", "* How about it?&              How to exit&  Sure        the RUINS\C ");
ds_map_add(global.text_data_en, "SCR_TEXT_1901", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1907", "* Here is an exciting&  snail fact./");
ds_map_add(global.text_data_en, "SCR_TEXT_1908", "\E1* Um^1.^1.^1.&*\E0 How about an exciting&  snail fact?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1909", "\E2* Did you know&  that snails.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1911", "\E0* Have a chainsaw-like&  tongue called a&  radula?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1912", "\E0* Sometimes flip their&  digestive systems&  as they mature?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1913", "\E0* Make terrible&  shoelaces?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1914", "\E0* Talk^2. Really^2. Slowly^2?&* Just kidding^1, snails&  don't talk./");
ds_map_add(global.text_data_en, "SCR_TEXT_1915", "\E0* Interesting.&              How to exit&  Yeah        the RUINS\C ");
ds_map_add(global.text_data_en, "SCR_TEXT_1916", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1921", "* Well^1, bother me&  if you need anything&  else./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1924", "\E1* ... I have to do&  something^1.&* Stay here./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1927", "\E0* What is it?&              How to exit&  Nothing     the RUINS\C ");
ds_map_add(global.text_data_en, "SCR_TEXT_1930", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1934", "* If you need anything^1,&  just ask./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1935", "\E1* ... I have to do&  something.&* Stay here./%%.");
ds_map_add(global.text_data_en, "SCR_TEXT_1936", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1940", "\E2NYOO HOO HOO.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1941", "I CAN'T EVEN&STOP SOMEONE AS&WEAK AS YOU.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1942", "UNDYNE'S GOING TO&BE DISAPPOINTED&IN ME./");
ds_map_add(global.text_data_en, "SCR_TEXT_1943", "I'LL NEVER JOIN THE&ROYAL GUARD..^1.&AND.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1944", "MY FRIEND QUANTITY&WILL REMAIN&STAGNANT!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1945", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_1946", "* (What should you say?)&         Let's be    What a&         friends     loser\C");
ds_map_add(global.text_data_en, "SCR_TEXT_1947", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_1956", "\E0WOWIE!^1!&YOU DID IT!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1957", "YOU DIDN'T DO A&VIOLENCE!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1958", "\E5TO BE HONEST^1,&I WAS A LITTLE&AFRAID.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1959", "\E0BUT YOU'RE ALREADY&BECOMING A GREAT&PERSON!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1960", "\E7I'M SO PROUD I&COULD CRY!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1961", "\E3... WAIT^1, WASN'T I&SUPPOSED TO&CAPTURE YOU...?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1962", "\E0WELL^1, FORGET IT!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1963", "I JUST WANT YOU&TO BE THE BEST&PERSON YOU CAN BE./");
ds_map_add(global.text_data_en, "SCR_TEXT_1964", "SO LET'S LET&BYBONES BE&BYBONES./");
ds_map_add(global.text_data_en, "SCR_TEXT_1965", "I'LL EVEN TELL YOU&HOW TO LEAVE THE&UNDERGROUND!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1966", "JUST KEEP GOING&EAST!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1967", "EVENTUALLY YOU'LL&REACH THE KING'S&CASTLE./");
ds_map_add(global.text_data_en, "SCR_TEXT_1968", "THEN YOU CAN&LEAVE!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_1978", "REALLY!^1?&YOU WANT TO BE&FRIENDS^1, WITH ME???/");
ds_map_add(global.text_data_en, "SCR_TEXT_1979", "WELL THEN.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1980", "\E0I GUESS..^1./");
ds_map_add(global.text_data_en, "SCR_TEXT_1981", "I GUESS&I CAN MAKE AN&ALLOWANCE FOR YOU!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1982", " %");
ds_map_add(global.text_data_en, "SCR_TEXT_1987", "HUH^1?&WHY WOULD YOU.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1988", "BERATE YOURSELF&SO LOUDLY???/");
ds_map_add(global.text_data_en, "SCR_TEXT_1989", "IS IT BECAUSE.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1990", "\E3YOU DON'T THINK&YOU'RE GOOD ENOUGH&TO BE MY FRIEND?/");
ds_map_add(global.text_data_en, "SCR_TEXT_1991", "\E0NO!!^1!&YOU'RE GREAT!!^1!&I'LL BE YOUR FRIEND!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1996", "WOWIE!^1!&WE HAVEN'T EVEN HAD&OUR FIRST DATE.../");
ds_map_add(global.text_data_en, "SCR_TEXT_1997", "AND I'VE ALREADY&MANAGED TO HIT&THE FRIEND ZONE!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_1998", "WHO KNEW THAT&ALL I NEEDED TO&MAKE PALS.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2002", "WOW!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2003", "I HAVE FRIENDS!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2004", "AND WHO KNEW THAT&ALL I NEEDED TO&MAKE THEM.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2006", "WAS TO GIVE PEOPLE&AWFUL PUZZLES AND&THEN FIGHT THEM??/");
ds_map_add(global.text_data_en, "SCR_TEXT_2007", "YOU TAUGHT ME A&LOT^1, HUMAN./");
ds_map_add(global.text_data_en, "SCR_TEXT_2008", "I HEREBY GRANT&YOU PERMISSION&TO PASS THROUGH!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2009", "AND I'LL GIVE&YOU DIRECTIONS&TO THE SURFACE./");
ds_map_add(global.text_data_en, "SCR_TEXT_2010", "CONTINUE FORWARD&UNTIL YOU REACH THE&END OF THE CAVERN./");
ds_map_add(global.text_data_en, "SCR_TEXT_2011", "\WTHEN..^1. WHEN YOU&REACH THE CAPITAL^1,&CROSS \YTHE BARRIER\W./");
ds_map_add(global.text_data_en, "SCR_TEXT_2012", "THAT'S THE MAGICAL&SEAL TRAPPING US&ALL UNDERGROUND./");
ds_map_add(global.text_data_en, "SCR_TEXT_2013", "ANYTHING CAN ENTER&THROUGH IT^1, BUT&NOTHING CAN EXIT.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2014", "... EXCEPT SOMEONE&WITH A POWERFUL&SOUL./");
ds_map_add(global.text_data_en, "SCR_TEXT_2015", "... LIKE YOU!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2016", "THAT'S WHY THE&KING WANTS TO&ACQUIRE A HUMAN./");
ds_map_add(global.text_data_en, "SCR_TEXT_2017", "HE WANTS TO OPEN&THE BARRIER WITH&SOUL POWER./");
ds_map_add(global.text_data_en, "SCR_TEXT_2018", "THEN US MONSTERS&CAN RETURN TO&THE SURFACE!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2023", "YOU'RE BACK AGAIN?!?!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2024", "I FINALLY REALIZE&THE TRUE REASON WHY./");
ds_map_add(global.text_data_en, "SCR_TEXT_2025", "YOU.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2026", "JUST MISS SEEING MY&FACE SO MUCH.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2027", "I'M NOT SURE I&CAN FIGHT SOMEONE&WHO FEELS THIS WAY./");
ds_map_add(global.text_data_en, "SCR_TEXT_2028", "BUT MOSTLY..^1. I'M GETTING&REALLY TIRED OF&CAPTURING YOU!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2029", "SO..^1.&WHAT DO YOU SAY?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2030", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_2031", "* (Fight Papyrus?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2032", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2036", "\TP %");
ds_map_add(global.text_data_en, "SCR_TEXT_2039", "OKAY.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2040", "I GUESS./");
ds_map_add(global.text_data_en, "SCR_TEXT_2041", "IF YOU WANT ME TO&CAPTURE YOU./");
ds_map_add(global.text_data_en, "SCR_TEXT_2042", "I'LL TRY AGAIN!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2047", "... OKAY.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2048", "I GUESS I'LL ACCEPT&MY FAILURE.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2058", "* Welcome to Snowed Inn^1!&* Snowdin's premier hotel!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2059", "* One night is 80G.& &         Stay        Leave\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2062", "* Back again^1?&* Well^1, stay as long as you&  like./");
ds_map_add(global.text_data_en, "SCR_TEXT_2063", "* How about it?& &         Stay        Leave\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2065", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2069", "* What^1?&* No^1, you can't get a&  second key!");
ds_map_add(global.text_data_en, "SCR_TEXT_2074", "* Hello^1!&* Sorry^1, no time for a&  nap.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2075", "* Snowed Inn is shutting&  down so we can all go&  to the surface./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2078", "* Oh^1, there you are^1.&* I was worrying about&  you!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2079", "* Things are going to be OK^1,&  you hear?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2080", "* We're all going to the&  surface world soon.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2081", "* There's bound to be a&  place you can stay there!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2089", "Error./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2092", "* Here's your room key^1.&* Make sure to bundle up!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2098", "* ... You don't even have 80G?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2099", "* Oh^1! You poor thing^1.&* I can only imagine what&  you've been through./");
ds_map_add(global.text_data_en, "SCR_TEXT_2100", "* One of the rooms upstairs&  is empty^1./");
ds_map_add(global.text_data_en, "SCR_TEXT_2101", "* You can sleep there for&  free^1, okay?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2109", "* Here's your room key^1.&* Make sure to bundle up!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2116", "* You aren't carrying enough&  money./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2121", "* Well^1, feel free to come&  back any time./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2125", "* (Look through the telescope?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2126", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2130", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2131", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2139", "* i'm thinking about&  getting into the&  telescope business./");
ds_map_add(global.text_data_en, "SCR_TEXT_2140", "* it's normally 50000G&  to use this premium&  telescope.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2141", "* but..^1.&*\E1 since i know you^1,&  you can use it for free./");
ds_map_add(global.text_data_en, "SCR_TEXT_2142", "\E2* howzabout it?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2143", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_2144", "* (Use the telescope?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2148", "* huh^1?&* you aren't satisfied?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2149", "\E1* don't worry./");
ds_map_add(global.text_data_en, "SCR_TEXT_2150", "\E2* i'll give you a&  full refund./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2152", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2157", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2158", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2169", "* well^1, come back&  whenever you want./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2180", "* Ring..\E0./");
ds_map_add(global.text_data_en, "SCR_TEXT_2182", "HELLO^1!&THIS IS PAPYRUS!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2183", "\E3HOW DID I GET THIS&NUMBER...?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2184", "\E0IT WAS EASY!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2185", "\E0I JUST DIALED EVERYNUMBER SEQUENTIALLYUNTIL I GOT YOURS!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2186", "NYEH HEH HEH HEH!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2187", "\E2SO..^1.&WHAT ARE YOU&WEARING...?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2188", "\E3I'M..^1.&ASKING FOR A&FRIEND./");
ds_map_add(global.text_data_en, "SCR_TEXT_2189", "\E0SHE THOUGHT SHE&SAW YOU WEARING A&\[1]./");
ds_map_add(global.text_data_en, "SCR_TEXT_2190", "\E3IS THAT TRUE^1?&ARE YOU WEARING A&\[1]?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2191", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_2192", "* (What will you say?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2193", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2206", "SO YOU ARE WEARING&A \[1].../");
ds_map_add(global.text_data_en, "SCR_TEXT_2207", "GOT IT!!^1!&WINK WINK!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2208", "HAVE A NICE DAY!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2209", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_2210", "* Click.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2215", "SO YOU AREN'T&WEARING A&\[1].../");
ds_map_add(global.text_data_en, "SCR_TEXT_2216", "GOT IT!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2217", "YOU'RE MY FRIEND^1,&SO I TRUST YOU&100-PERCENT./");
ds_map_add(global.text_data_en, "SCR_TEXT_2218", "HAVE A NICE DAY!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2219", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_2220", "* Click.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2227", "* (There's an empty pie tin&  inside the stove.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2231", "\E0MY BROTHER ALWAYS&GOES OUT TO EAT^1.&BUT.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2232", "\E3RECENTLY^1, HE TRIED&'BAKING' SOMETHING./");
ds_map_add(global.text_data_en, "SCR_TEXT_2233", "IT WAS LIKE..^1.&A QUICHE./");
ds_map_add(global.text_data_en, "SCR_TEXT_2234", "BUT FILLED WITH A&SUGARY^1, NON-EGG&SUBSTANCE./");
ds_map_add(global.text_data_en, "SCR_TEXT_2235", "\E0HOW ABSURD!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2240", "* (It's a joke book.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2241", "* (Take a look inside?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2242", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2248", "* (Inside the joke book was&  a quantum physics book.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2249", "* (You look inside...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2250", "* (Inside the quantum physics&  book was another joke&  book.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2251", "* (You look inside...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2252", "* (There's another quantum&  physics book...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2253", "* (You decide to stop.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2257", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2265", "THAT'S MY ROOM^1!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2266", "IF YOU'VE&FINISHED LOOKING&AROUND.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2267", "WE COULD GO IN&AND.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2268", "\"HANG-OUT\" LIKE&A PAIR OF VERY&COOL FRIENDS?/");ds_map_add(global.text_data_en, "SCR_TEXT_2269", "\E3DO WHATEVER&PEOPLE DO WHEN&THEY DATE???/");
ds_map_add(global.text_data_en, "SCR_TEXT_2270", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_2271", "* (Go inside?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2272", " %");
ds_map_add(global.text_data_en, "SCR_TEXT_2276", "* (It's the door to&  Papyrus's room.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2277", "* (It's covered in many&  labels...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2278", "\TP %");
ds_map_add(global.text_data_en, "SCR_TEXT_2279", "* (NO GIRLS ALLOWED!)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2280", "* (NO BOYS ALLOWED!)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2281", "* (PAPYRUS ALLOWED.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2286", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2297", "THERE ARE NO&SKELETONS INSIDE&MY CLOSET!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_2298", "\E3EXCEPT ME&SOMETIMES./");
ds_map_add(global.text_data_en, "SCR_TEXT_2299", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_2300", "* (Look in the closet?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2301", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2305", "* (Look in the closet?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2306", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2313", "* (Clothes are hung up&  neatly inside.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2317", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2322", "IT'S OK TO BE&INTIMIDATED BY&MY FASHION SENSE./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2328", "\E3SO^1, UM.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2329", "\E3IF YOU'VE SEEN&EVERYTHING.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2330", "\E2DO YOU WANT TO&START HANGING OUT?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2331", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_2332", "* (Begin the hangouts?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2333", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2336", "\E2DO YOU WANT TO&START THE DATE?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2337", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_2338", "* (Begin the date?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2339", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2348", "\E0OKAY!!^1!&DATING START!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2349", "\E0OKAY!!^1!&LET'S HANG TEN!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2354", "\E2TAKE YOUR TIME..^1.&I'LL WAIT FOR&YOU./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2359", "* (This mailbox is labelled&  \"PAPYRUS\".)/");ds_map_add(global.text_data_en, "SCR_TEXT_2360", "* (Look inside?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2361", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2366", "* (It's empty.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2368", "* (You realize that would&  probably be illegal.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2372", "* what^1?&* haven't you seen a guy&  with two jobs before?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2373", "\E1* fortunately^1, two jobs&  means twice as many&  legally-required breaks./");
ds_map_add(global.text_data_en, "SCR_TEXT_2374", "\E0* i'm going to grillby's.&* wanna come?&  Yeah        I'm busy \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2375", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2376", "* .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2380", "\E2* hey^1, looks like you're&  really turning yourself&  around./");
ds_map_add(global.text_data_en, "SCR_TEXT_2381", "\E0* how about i treat you&  to lunch at grillby's?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2382", "\E1* ... when everyone you&  scared away comes&  back^1, i mean./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2389", "* well^1, if you insist..^1.&* i'll pry myself away&  from my work.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2394", "* OK^1. have fun./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2399", "\E1* whoops^1, watch where&  you sit down./");
ds_map_add(global.text_data_en, "SCR_TEXT_2400", "* sometimes weirdos put&  whoopee cushions on&  the seats./");
ds_map_add(global.text_data_en, "SCR_TEXT_2401", "\E0* anyway^1, let's order./");
ds_map_add(global.text_data_en, "SCR_TEXT_2402", "* whaddya want...?& &  Fries       Burger\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2403", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2407", "* ok^1, coming right up./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2411", "* hey^1, that sounds&  pretty good./");
ds_map_add(global.text_data_en, "SCR_TEXT_2412", "* grillby^1, we'll have&  a double order of&  fries./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2418", "* hey^1, that sounds&  pretty good./");
ds_map_add(global.text_data_en, "SCR_TEXT_2419", "* grillby^1, we'll have&  a double order of&  burg./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2426", "* so^1, what do you&  think.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2427", "* of my brother?& &  Cool        Uncool\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2428", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2434", "* of course he's cool./");
ds_map_add(global.text_data_en, "SCR_TEXT_2435", "\E1* you'd be cool too&  if you wore that&  outfit every day./");
ds_map_add(global.text_data_en, "SCR_TEXT_2436", "\E0* he'd only take that&  thing off if he&  absolutely had to./");
ds_map_add(global.text_data_en, "SCR_TEXT_2437", "* oh well^1.&* at least he washes&  it./");
ds_map_add(global.text_data_en, "SCR_TEXT_2438", "\E1* and by that i mean&  he wears it in&  the shower./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2442", "* hey^1, pal./");
ds_map_add(global.text_data_en, "SCR_TEXT_2443", "\E1* sarcasm isn't funny^1,&  okay?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2444", "\E0* my brother's a real&  star./");
ds_map_add(global.text_data_en, "SCR_TEXT_2445", "* he's the person who&  pushed me to get&  this sentry job./");
ds_map_add(global.text_data_en, "SCR_TEXT_2446", "* maybe it's a little&  strange^1, but&  sometimes.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2447", "* ... it's nice to have&  someone call you out&  on being lazy./");
ds_map_add(global.text_data_en, "SCR_TEXT_2448", "\E1* even though nothing&  could be further&  from the truth./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2453", "* here comes the grub./");
ds_map_add(global.text_data_en, "SCR_TEXT_2454", "* want some ketchup^1?& &  Yes         No    \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2455", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2461", "\E2* bone appetit./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2465", "\E2* more for me./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2472", "\W* have you ever heard&  of a \Ytalking flower\W?&  Yes         No    \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2473", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2477", "\E1* so you know all&  about it./");
ds_map_add(global.text_data_en, "SCR_TEXT_2478", "\E1* i'll tell you^1, then./");
ds_map_add(global.text_data_en, "SCR_TEXT_2479", "\W*\E0 the \Becho flower\W./");
ds_map_add(global.text_data_en, "SCR_TEXT_2480", "* they're all over the&  marsh./");
ds_map_add(global.text_data_en, "SCR_TEXT_2481", "* say something to them^1,&  and they'll repeat it&  over and over.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2482", "* what about it?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2483", "* well^1, papyrus told&  me something interesting&  the other day./");
ds_map_add(global.text_data_en, "SCR_TEXT_2484", "* sometimes^1, when no&  one else is around.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2485", "* a flower appears and&  whispers things to&  him./");
ds_map_add(global.text_data_en, "SCR_TEXT_2486", "* flattery..^1.&* advice..^1.&* encouragement.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2487", "* ... predictions./");
ds_map_add(global.text_data_en, "SCR_TEXT_2488", "* weird^1, huh?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2489", "* someone must be using&  an echo flower to&  play a trick on him./");
ds_map_add(global.text_data_en, "SCR_TEXT_2490", "* keep an eye out^1, ok?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2491", "* thanks./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2495", "\E1* oh^1, by the way.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2496", "\E0* i'm flat broke^1.&* can you foot the&  bill?/");
ds_map_add(global.text_data_en, "SCR_TEXT_2497", "* it's just 10000G.& &  Yes         No    \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2498", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2502", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2580", "* (Take an umbrella?)& &         Take one    Do not\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2581", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2585", "* (Return the umbrella?)& &         Put back    Do not\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2586", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2597", "* (You took an umbrella.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2608", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2615", "* (You returned the umbrella.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2626", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2634", "* (It's a statue^1.)&* (The structures at its&  feet seem dry.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2637", "* (Put the umbrella on the&  statue?)&         Yes         Do not\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2638", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2642", "* (The music continues^1, and&  doesn't stop.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2651", "* (You place the umbrella&  atop the statue.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2652", "* (Inside the statue^1, a music&  box begins to play...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2667", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2674", "* (It's a rusty old&  fridge.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2675", "* (Look inside?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2676", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2682", "* (You open the fridge.^1)&* (The air fills with a&  rotten stench.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2683", "* (All the food inside here&  spoiled long ago.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2686", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2692", "* error/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2694", "* (The cooler is empty.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2698", "* (Take a space food bar&  from the cooler?)&         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2699", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2704", "* (It's a cooler^1.&* It has no brand^1, and&  shows no signs of wear...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2705", "* (Inside are a couple&  of freeze-dried space&  food bars.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2706", "* (Take one?)& &         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2707", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2726", "* (You got the Astronaut Food.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2728", "* (You're carrying too much.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2732", "* %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2739", "* (Seems like a regular&  training dummy.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2740", "* (Do you want to beat it&  up?)&         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_2741", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2744", "* (You've had enough of&  the dummy.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2752", "* (You tap the dummy with&  your fist.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2753", "* (You feel bad.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2757", "* (You hit the dummy&  lightly.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2758", "* (You don't feel like&  you learned anything.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2762", "* (You sock the dummy.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2763", "* (Who cares?)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2767", "* (You punch the dummy at&  full force.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_2768", "* (Feels good.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2774", "* (You stare into each&  other's eyes for a&  moment...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2837", "* (This CD is labelled&  \"Spooktunes.\")/");ds_map_add(global.text_data_en, "SCR_TEXT_2838", "* (Play it?)& &         Play it     No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2839", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2842", "* (This CD is labelled&  \"Spooktunes.\")/");ds_map_add(global.text_data_en, "SCR_TEXT_2843", "* (This CD is playing.)&* (Turn it off?)&         Stop it     No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2844", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2853", "* (You play the CD.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2859", "* (Spooktunes are dead.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2867", "* (The CD stops moving.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2873", "* %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2881", "* (This CD is labelled&  \"Spookwave.\")/");ds_map_add(global.text_data_en, "SCR_TEXT_2882", "* (Play it?)& &         Play it     No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2883", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2886", "* (This CD is labelled&  \"Spookwave.\")/");ds_map_add(global.text_data_en, "SCR_TEXT_2887", "* (This CD is playing.)&* (Turn it off?)&         Stop it     No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2888", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2897", "* (You play the CD.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2903", "* %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2911", "* (The CD stops moving.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2917", "* %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2924", "* (This CD is labelled&  \"Ghouliday Music.\")/");ds_map_add(global.text_data_en, "SCR_TEXT_2925", "* (Play it?)& &         Play it     No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2926", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2929", "* (This CD is labelled&  \"Ghouliday Music.\")/");ds_map_add(global.text_data_en, "SCR_TEXT_2930", "* (This CD is playing.)&* (Turn it off?)&         Stop it     No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2931", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2940", "* (You play the CD.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2946", "* %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2954", "* (The CD stops moving.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2960", "* %%");
ds_map_add(global.text_data_en, "SCR_TEXT_2968", "* (Look inside the fridge?)& &         Open it     No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2969", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_2977", "* (There's a lonely sandwich&  inside.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2983", "* (It's empty.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2988", "%%");
ds_map_add(global.text_data_en, "SCR_TEXT_2993", "* this is a ghost sandwich.../");
ds_map_add(global.text_data_en, "SCR_TEXT_2994", "* do you want to try it...& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_2995", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3001", "* (You attempt to bite&  into the ghost sandwich.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3002", "* (You phase right through&  it...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3003", "* oh.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3004", "* nevermind.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3008", "* oh.....................&  ....................&  ................./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3014", "* after a great meal i like&  to lie on the ground and&  feel like garbage.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3015", "* it's a family tradition.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3016", "* do you want..^1.&* ... to join me...&         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3017", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3023", "* okay..^1.&* follow my lead.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3028", "* oh.....................&  ....................&  ................./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3034", "* do you want to play a game^1?&* it's called thundersnail./");
ds_map_add(global.text_data_en, "SCR_TEXT_3035", "* the snails will race^1, and if&  the yellow snail wins^1, you&  win./");
ds_map_add(global.text_data_en, "SCR_TEXT_3036", "* it's 10G to play.& &         Play        No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3037", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3045", "* um..^1.&* you don't have any money?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3046", "* n-no^1, you can still play^1,&  don't worry about it.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3047", "* okay..^1.&* press \*Z repeatedly to&  encourage your snail./");
ds_map_add(global.text_data_en, "SCR_TEXT_3048", "* ready?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3052", "* um..^1. that's less than 10G./");
ds_map_add(global.text_data_en, "SCR_TEXT_3053", "* but since you're my only&  real customer^1, i guess i'll&  just take what you have.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3054", "* okay..^1.&* press \*Z repeatedly to&  encourage your snail./");
ds_map_add(global.text_data_en, "SCR_TEXT_3055", "* ready?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3061", "* okay..^1.&* press \*Z repeatedly to&  encourage your snail./");
ds_map_add(global.text_data_en, "SCR_TEXT_3062", "* ready?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3068", "* oh.........../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3073", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3074", "* Seven./");
ds_map_add(global.text_data_en, "SCR_TEXT_3075", "* Seven human souls./");
ds_map_add(global.text_data_en, "SCR_TEXT_3076", "* With the power of seven&  human souls^1, our king.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3077", "\W* \YKing \RASGORE \YDreemurr\W.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3078", "* ... will become a god./");
ds_map_add(global.text_data_en, "SCR_TEXT_3079", "\W* With that power^1, \RASGORE\W &  can finally shatter the&  barrier./");
ds_map_add(global.text_data_en, "SCR_TEXT_3080", "* He will finally take the&  surface back from humanity.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3081", "* And give them back the&  suffering and pain that&  we have endured./");
ds_map_add(global.text_data_en, "SCR_TEXT_3082", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3083", "* Understand^1, human?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3084", "* This is your only chance&  at redemption./");
ds_map_add(global.text_data_en, "SCR_TEXT_3085", "* Give up your soul.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3086", "* Or I'll tear it from&  your body./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3104", "* Yo^1, I know I'm not supposed&  to be here^1, but.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3105", "* I wanna ask you something./");
ds_map_add(global.text_data_en, "SCR_TEXT_3106", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3107", "* Man^1, I've never had to ask&  anyone this before.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3108", "* Umm.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3109", "* Yo..^1. You're human^1, right?&* Haha./");
ds_map_add(global.text_data_en, "SCR_TEXT_3110", "* Man^1! I knew it!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3111", "* ... well^1, I know it now^1,&  I mean.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3112", "* Undyne told me^1, um^1, \"stay&  away from that human.\"/");ds_map_add(global.text_data_en, "SCR_TEXT_3113", "* So^1, like^1, ummm.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3114", "* I guess that makes us enemies&  or something./");
ds_map_add(global.text_data_en, "SCR_TEXT_3115", "* But I kinda stink at that^1,&  haha./");
ds_map_add(global.text_data_en, "SCR_TEXT_3116", "* Yo^1, say something mean so&  I can hate you?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3117", "* Please? & &         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_3118", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3124", "* Huh...?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3125", "* Yo^1, that's your idea of&  something mean?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3126", "* My sister says that to me&  ALL THE TIME!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3127", "* Guess I have to do it^1, haha./");
ds_map_add(global.text_data_en, "SCR_TEXT_3128", "* Yo^1, I..^1. I hate your guts./");
ds_map_add(global.text_data_en, "SCR_TEXT_3129", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3130", "* Man^1, I..^1. I'm such a turd./");
ds_map_add(global.text_data_en, "SCR_TEXT_3131", "* I'm..^1. I'm gonna go home&  now./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3135", "* Yo^1, what^1?&* So I have to do it?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3136", "* Here goes nothing.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3137", "* Yo^1, I..^1. I hate your guts./");
ds_map_add(global.text_data_en, "SCR_TEXT_3138", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3139", "* Man^1, I..^1. I'm such a turd./");
ds_map_add(global.text_data_en, "SCR_TEXT_3140", "* I'm..^1. I'm gonna go home&  now./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3148", "* (It's a water cooler.)&* (Take a cup of water?)&         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_3149", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3153", "* (There's no more water left&  in the cooler.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3155", "* (Sadistically^1, you've poured&  out all the water right in&  front of Undyne's eyes.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3163", "* (You take a cup of water.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3171", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_3177", "* (Get rid of the water?)& &         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_3178", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3184", "* (You pour the water on&  the ground next to the&  water cooler.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3196", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_3201", "* A rousing error./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3205", "* (Give Undyne the water?)& &         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_3206", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3210", "* (She looks dry...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3215", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_3238", "* Ring..\E0./");
ds_map_add(global.text_data_en, "SCR_TEXT_3240", "HELLO^1!&THIS IS PAPYRUS!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3241", "REMEMBER WHEN&I ASKED YOU&ABOUT CLOTHES?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3242", "\E3WELL^1, THE FRIEND&WHO WANTED TO&KNOW.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3243", "\E0HER OPINION OF&YOU IS VERY.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3244", "\E3MURDERY./");
ds_map_add(global.text_data_en, "SCR_TEXT_3245", "\E0ERROR!!^1!&SEE YOU LATER!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3250", "\E0BUT I BET YOU&KNEW THAT&ALREADY!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3251", "\E3AND BECAUSE YOU&KNEW THAT.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3252", "\E0I TOLD HER WHAT&YOU TOLD ME&YOU WERE WEARING!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3253", "A \[1]!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3254", "BECAUSE I KNEW^1,&OF COURSE.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3255", "\E3AFTER SUCH A&SUSPICIOUS&QUESTION.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3256", "\E0YOU WOULD&OBVIOUSLY CHANGE&YOUR CLOTHES!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3257", "YOU'RE SUCH A&SMART COOKIE!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3258", "THIS WAY YOU'RE&SAFE AND I&DIDN'T LIE!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3259", "NO BETRAYAL&ANYWHERE!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3260", "BEING FRIENDS&WITH EVERYONE&IS EASY!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3261", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_3262", "* Click.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3268", "\E0WELL^1, WORRY&NOT DEAR HUMAN!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3269", "PAPYRUS WOULD&NEVER BETRAY YOU!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3270", "\E3I AM NOT A&CRUEL PERSON./");
ds_map_add(global.text_data_en, "SCR_TEXT_3271", "\E0I STRIVE TO BE&COMFORTING AND&PLEASANT./");
ds_map_add(global.text_data_en, "SCR_TEXT_3272", "PAPYRUS!&HE SMELLS LIKE&THE MOON./");
ds_map_add(global.text_data_en, "SCR_TEXT_3273", "SO, BECAUSE OF&MY INHERENT&GOODNESS.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3274", "I TOLD HER YOU&WERE NOT WEARING&A \[1]!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3275", "\E3EVEN THOUGH YOU&TOLD ME YOU&WERE!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3276", "INSTEAD^1, I MADE&SOMETHING UP!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3277", "I TOLD HER YOU&WERE WEARING.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3278", "\E0A \[2]./");
ds_map_add(global.text_data_en, "SCR_TEXT_3279", "\E3IT PAINED ME TO&TELL SUCH A&BOLDFACED LIE./");
ds_map_add(global.text_data_en, "SCR_TEXT_3280", "I KNOW YOU WOULD&NEVER EVER WEAR&A \[2]./");
ds_map_add(global.text_data_en, "SCR_TEXT_3281", "\E0BUT YOUR SAFETY&IS MORE IMPORTANT&THAN FASHION./");
ds_map_add(global.text_data_en, "SCR_TEXT_3282", "\E3DANG!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3283", "I JUST WANT TO&BE FRIENDS WITH&EVERYONE.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3284", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_3285", "* Click.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3291", "\E0WELL^1, WORRY&NOT DEAR HUMAN!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3292", "\E3PAPYRUS WOULD&NEVER BETRAY YOU!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3293", "\WY\E0OU SAID YOU WERE\Y &NOT WEARING A&\[1]\W./");
ds_map_add(global.text_data_en, "SCR_TEXT_3294", "\E3SO OF COURSE&I ACTUALLY&TOLD HER.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3295", "\E0YOU WERE&INDEED WEARING&A \[1]!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3296", "\E3IT PAINED ME TO&TELL SUCH A&BOLDFACED LIE./");
ds_map_add(global.text_data_en, "SCR_TEXT_3297", "BUT SINCE YOU&AREN'T WEARING&A \[1]./");
ds_map_add(global.text_data_en, "SCR_TEXT_3298", "\E0SHE SURELY&WON'T ATTACK&YOU!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3299", "NOW YOU ARE&SAFE AND SOUND./");
ds_map_add(global.text_data_en, "SCR_TEXT_3300", "\E2WOWIE..^1.&THIS IS HARD./");
ds_map_add(global.text_data_en, "SCR_TEXT_3301", "I JUST WANT TO&BE EVERYBODY'S&FRIEND!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3302", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_3303", "* Click.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3309", "\E0BUT I BET YOU&KNEW THAT&ALREADY!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3310", "\E3AND BECAUSE YOU&KNEW THAT.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3311", "\E0I KNEW WHEN&YOU SAID:/");
ds_map_add(global.text_data_en, "SCR_TEXT_3312", "\E3\"I AM NOT&WEARING A&\[1].\"/");ds_map_add(global.text_data_en, "SCR_TEXT_3313", "\E0IT WAS REALLY&A SECRET CODE!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3314", "\E3YOU REALLY&MEANT.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3315", "\E0\"I ACTUALLY AM&WEARING&A \[1]!\"/");ds_map_add(global.text_data_en, "SCR_TEXT_3316", "YOU WERE TRYING&TO PROTECT&YOURSELF.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3317", "WHILE MAKING IT&SO I DIDN'T&HAVE TO LIE!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3318", "I PICKED UP ON&THIS, AND FOLLOWED&YOUR PLAN./");
ds_map_add(global.text_data_en, "SCR_TEXT_3319", "I TOLD HER YOU&WERE NOT WEARING&A \[1]!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3320", "IN FACT I TOOK&IT ONE STEP&FURTHER!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3321", "\E3I TOLD HER YOU&WERE PROBABLY.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3322", "\E0WEARING A&\[2]!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3323", "\E3OF COURSE, YOU&WOULD NEVER&WEAR THAT./");
ds_map_add(global.text_data_en, "SCR_TEXT_3324", "\E0BUT THAT'S THE&POINT!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3325", "SHE WON'T&RECOGNIZE YOU&NOW!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3326", "AND I DIDN'T&HAVE TO BETRAY&EITHER OF YOU!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3327", "SINCE I JUST&TOLD HER WHAT&YOU SAID!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3328", "WOWIE^1!&YOU'RE SUCH A&SMART COOKIE!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3329", "I REALLY CAN&BE FRIENDS WITH&EVERYONE!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3330", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_3331", "* Click.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3337", "* Ring..\E0./");
ds_map_add(global.text_data_en, "SCR_TEXT_3339", "HEY^1!&WHAT'S UP!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3340", "I WAS JUST&THINKING.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3341", "YOU^1, ME^1, AND&UNDYNE SHOULD ALL&HANG OUT SOMETIME!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3342", "I THINK YOU&WOULD MAKE&GREAT PALS!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3343", "LET'S MEET UP&AT HER HOUSE&LATER!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3344", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_3345", "* Click.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3348", "AFTER YOU HANG&OUT WITH ME.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3349", "LET'S MEET UP&AT HER HOUSE!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3350", "I THINK YOU&WOULD MAKE&GREAT PALS!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3351", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_3352", "* Click.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3393", "* (It's a book labelled&  Monster History Part 7.)&         Read it     Do not\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3394", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3398", "* When a human dies^1, its&  soul remains stable&  outside the body./");
ds_map_add(global.text_data_en, "SCR_TEXT_3399", "* Meanwhile^1, a monster's soul&  disappears near-instantly&  upon death./");
ds_map_add(global.text_data_en, "SCR_TEXT_3400", "* This allows monsters to&  absorb the souls of&  humans.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3401", "* While it is extremely&  difficult for humans to&  absorb a monster's soul./");
ds_map_add(global.text_data_en, "SCR_TEXT_3402", "* This is why they feared us./");
ds_map_add(global.text_data_en, "SCR_TEXT_3403", "* Though monsters are weak^1,&  with enough human souls.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3404", "* They could easily destroy&  all of mankind./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3407", "* (You decide not to read it.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3413", "* (It's a book labelled&  Monster History Part 8.)&         Read it     Do not\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3414", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3418", "* There is one exception&  to the aforementioned&  rules:/");
ds_map_add(global.text_data_en, "SCR_TEXT_3419", "* A certain type of monster^1,&  the \"boss\" monster./");ds_map_add(global.text_data_en, "SCR_TEXT_3420", "* Due to its life cycle^1, it&  possesses an incredibly&  strong soul for a monster./");
ds_map_add(global.text_data_en, "SCR_TEXT_3421", "* This soul can remain&  stable after death^1, if&  only for a few moments./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3424", "* (You decide not to read it.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3429", "* (All these books are labelled&  Human History.)&         Read one    Do not\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3430", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3434", "* (You look inside a book.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3435", "* (It's a comic of a giant&  robot fighting a beautiful&  alien princess.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3436", "* (This doesn't strike you&  as very accurate...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3441", "* (You decide not to.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3446", "* (All these books are labelled&  Human History.)&         Read one    Do not\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3447", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3451", "* (You look inside a book.)&* (It's a comic book.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3452", "* (Two scantily-clad chefs are&  flinging energy pancakes&  at each other.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3453", "* (This doesn't strike you&  as very accurate...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3458", "* (You decide not to.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3463", "* (All these books are labelled&  Human History.)&         Read one    Do not\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3464", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3469", "* (You look inside a book.)&* (It's a comic book.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3470", "* (A hideous android is running&  to school with toast in&  its mouth.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3471", "* (Seems like it's late.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3472", "* (This doesn't strike you&  as very accurate...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3477", "* (You decide not to.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3482", "* (There's a piano here.^1)&* (Play it?)&         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3483", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3487", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_3488", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3495", "See that heart^1? &That is your SOUL^1,&the very culmination&of your being!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3496", "Your SOUL starts off&weak^1, but can grow&strong if you gain&a lot of LV./");
ds_map_add(global.text_data_en, "SCR_TEXT_3497", "What's LV stand for^1?&Why^1, LOVE^1, of course!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3498", "You want some&LOVE, don't you?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3499", "Don't worry,&I'll share some&with you!/%");
ds_map_add(global.text_data_en, "SCR_TEXT_3503", "Down here^1, LOVE is&shared through..^1./");
ds_map_add(global.text_data_en, "SCR_TEXT_3504", "Little white..^2.\E1 &\"friendliness&pellets.\"/");ds_map_add(global.text_data_en, "SCR_TEXT_3505", "\E2Are you ready\E0?/%");
ds_map_add(global.text_data_en, "SCR_TEXT_3509", "Move around^1!&Get as many as&you can^2!%%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3510", "%%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3514", "You idiot./");
ds_map_add(global.text_data_en, "SCR_TEXT_3515", "In this world^1, it's&kill or BE killed./");
ds_map_add(global.text_data_en, "SCR_TEXT_3516", "Why would ANYONE pass&up an opportunity&like this!?/%");
ds_map_add(global.text_data_en, "SCR_TEXT_3520", "Die./%");
ds_map_add(global.text_data_en, "SCR_TEXT_3524", "Hey buddy^1,&you missed them./");
ds_map_add(global.text_data_en, "SCR_TEXT_3525", "Let's try again^1,&okay?/%");
ds_map_add(global.text_data_en, "SCR_TEXT_3528", "Is this a joke^2?&Are you braindead^2?&RUN^2. INTO^2. THE^2.&BULLETS!!!");
ds_map_add(global.text_data_en, "SCR_TEXT_3531", "You know what's&going on here^1,&don't you?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3532", "You just wanted to&see me suffer./%");
ds_map_add(global.text_data_en, "SCR_TEXT_3535", "\E1What a terrible&creature^1, torturing&such a poor^1,&innocent youth.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3536", "\E2Ah, do not be&afraid^1, my child./");
ds_map_add(global.text_data_en, "SCR_TEXT_3537", "\XI am \BTORIEL\X,&caretaker of&the \RRUINS\X./");
ds_map_add(global.text_data_en, "SCR_TEXT_3538", "I pass through this&place every day to&see if anyone has&fallen down./");
ds_map_add(global.text_data_en, "SCR_TEXT_3539", "You are the first&human to come here&in a long time./");
ds_map_add(global.text_data_en, "SCR_TEXT_3540", "I will do my best&to ensure your&protection during&your time here./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3541", "\E2Come^2!&I will guide you&through the&catacombs./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3542", "%%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3548", "* Three gold for the ferry.& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3549", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3553", "* Later^1, then./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3554", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3559", "* Hop on!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3564", "* (It's a switch.)& &         Press it    Don't\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3565", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3571", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_3584", "* (The lasers were deactivated.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3591", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_3604", "* (The lasers were reactivated.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3612", "* Ring.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3613", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "SCR_TEXT_3614", "\E1* Um.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3615", "\E0* I noticed you've been&  kind of quiet.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3616", "\W*\E8 Are you w-worried&  about meeting \RASGORE\W...?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3617", "\E2* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3618", "\E0* W-well^1, don't worry^1,&  okay?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3619", "\E7* Th-the king is a&  really nice guy.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3620", "\E0* I'm sure you can&  talk to him^1, and.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3621", "* W-with your human&  soul^1, you can pass&  through the barrier!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3622", "* S-so no worrying^1, OK^1?&* J-just forget about it&  and smile./");
ds_map_add(global.text_data_en, "SCR_TEXT_3623", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_3624", "* Click.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3630", "* hey buddy^1, what's up^1?&* wanna buy a hot dog?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3631", "* it's only 30G.& &  Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_3632", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3638", "* here^1.&* have fun./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3641", "* here's another hot&  dog./");
ds_map_add(global.text_data_en, "SCR_TEXT_3642", "* it's on the house^1.&* well^1, no^1.&* it's on you./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3653", "* sorry^1, thirty is&  the limit on&  head-dogs./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3656", "\TS*^1 \Tsi'll be 'frank' with&  you./");
ds_map_add(global.text_data_en, "SCR_TEXT_3657", "* as much as i like&  putting hot dogs&  on your head.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3658", "* thirty is just&  an excessive number./");
ds_map_add(global.text_data_en, "SCR_TEXT_3659", "* twenty-nine^1, now&  that's fine^1, but&  thirty.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3660", "* does it look like&  my arms can reach&  that high?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3687", "* thanks, kid^1.&* here's your hot dog./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3690", "* thanks, kid^1.&* here's your 'dog./");
ds_map_add(global.text_data_en, "SCR_TEXT_3691", "* yeah^1. 'dog^1.&* apostrophe-dog^1.&* it's short for hot-dog./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3695", "* another h'dog^1?&* here you go.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3696", "* whoops^1, i'm actually&  out of hot dogs./");
ds_map_add(global.text_data_en, "SCR_TEXT_3697", "* here^1, you can have&  a hot cat instead./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3701", "* another dog^1, coming&  right up.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3702", "* ... you really like&  hot animals^1, don't&  you?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3703", "* hey^1, i'm not judging./");
ds_map_add(global.text_data_en, "SCR_TEXT_3704", "* i'd be out of a job&  without folks like you./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3708", "* cool^1.&* here's that ''dog./");
ds_map_add(global.text_data_en, "SCR_TEXT_3709", "* apostrophe-apostrophe&  dog./");
ds_map_add(global.text_data_en, "SCR_TEXT_3710", "* it's short for&  apostrophe-dog./");
ds_map_add(global.text_data_en, "SCR_TEXT_3711", "* which is^1, in turn^1,&  short for.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3715", "* another one^1?&* okay./");
ds_map_add(global.text_data_en, "SCR_TEXT_3716", "* careful^1.&* if you eat&  too many hot dogs.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3717", "* you'll probably get&  huge like me./");
ds_map_add(global.text_data_en, "SCR_TEXT_3718", "* huge as in super-&  popular^1, i mean./");
ds_map_add(global.text_data_en, "SCR_TEXT_3719", "* i'm practically&  a hot-dog tycoon now./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3725", "* whoops^1, you don't have&  enough cash./");
ds_map_add(global.text_data_en, "SCR_TEXT_3726", "* you should get a job^1.&* i've heard being a&  sentry pays well./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3729", "* you're holding too much^1.&* ... guess i'll just put&  it on your head./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3738", "* yeah^1, you've gotta&  save your money for&  college and spiders./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3743", "* Ring.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3744", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "SCR_TEXT_3745", "* L-looks like you&  beat him!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3746", "\E0* Y-you did a really&  great job out there./");
ds_map_add(global.text_data_en, "SCR_TEXT_3747", " &  All thanks&  to you      ... \C");
ds_map_add(global.text_data_en, "SCR_TEXT_3748", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3754", "\E3* What^1?&* Oh no^1, I mean.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3755", "\E4* You were the one&  doing everything cool!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3756", "\E0* I just wrote some&  silly programs for&  your phone./");
ds_map_add(global.text_data_en, "SCR_TEXT_3760", "\E1* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3761", "\E2* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3762", "\E1* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3765", "\E2* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3766", "\E4* ... umm^1, h-hey^1, this&  might sound strange^1,&  but.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3767", "\E6* ... c-can I tell&  you something?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3768", "\E9* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3769", "\E4* B-before I met you^1,&  I d-didn't really.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3770", "\E9* I didn't really&  like myself very&  much./");
ds_map_add(global.text_data_en, "SCR_TEXT_3771", "* For a long time^1,&  I f-felt like a&   total screw-up./");
ds_map_add(global.text_data_en, "SCR_TEXT_3772", "\E9* L-like I couldn't&  do a-anything&  w-without.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3773", "\E9* W-without ending up&  letting everyone&  down./");
ds_map_add(global.text_data_en, "SCR_TEXT_3774", "\E3* B-but...!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3775", "\E4* Guiding you has&  made me feel.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3776", "\E9* A lot better about&  myself./");
ds_map_add(global.text_data_en, "SCR_TEXT_3777", "\E0* So... thanks for&  letting me help&  you./");
ds_map_add(global.text_data_en, "SCR_TEXT_3778", "\E9* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3779", "\E4* Uhhh^1, anyway^1, we're&  almost to the CORE./");
ds_map_add(global.text_data_en, "SCR_TEXT_3780", "\E0* It's just past&  MTT Resort./");
ds_map_add(global.text_data_en, "SCR_TEXT_3781", "\E6* Come on^1!&* Let's finish this!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3782", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_3783", "* Click.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3787", "\E0EUREKA!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3788", "I'VE FIGURED OUT&THE PUZZLE!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3789", "\E3YOU SEEM LIKE&YOU'RE HAVING&FUN^1, THOUGH.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3790", "\E0DO YOU ABSOLUTELY^1,&DAPSOLUTELY WANT&THE SOLUTION???/");
ds_map_add(global.text_data_en, "SCR_TEXT_3791", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_3792", "* (Do you absolutely^1,&  dapsolutely want the answer?)&         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3793", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3800", "THE^1!&SOLUTION^1!&IS!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3801", "(PLEASE IMAGINE&A DRUMROLL IN&YOUR HEAD)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3802", "... THAT TREE&OVER THERE HAS&A SWITCH ON IT!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3803", "CHECK IT&OUTIE!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3807", "WOW..^1.&YOU'RE TRULY A&PUZZLE PASSIONEER!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3808", "I'M SO ENTHUSED&BY YOUR&ENTHUSIASM!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3809", "YOU CAN DO IT^1,&HUMAN!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3814", "I'VE FIGURED OUT&THE PUZZLE!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3815", "\E0DO YOU ABSOLUTELY^1,&DAPSOLUTELY WANT&THE SOLUTION???/");
ds_map_add(global.text_data_en, "SCR_TEXT_3816", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_3817", "* (Do you absolutely^1,&  dapsolutely want the answer?)&         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3818", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3825", "THE^1!&SOLUTION^1!&IS!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3826", "(PLEASE IMAGINE&A DRUMROLL IN&YOUR HEAD)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3827", "... THAT TREE&OVER THERE HAS&A SWITCH ON IT!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3828", "CHECK IT&OUTIE!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3832", "WOW..^1.&YOU'RE TRULY A&PUZZLE PASSIONEER!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3833", "I'M SO ENTHUSED&BY YOUR&ENTHUSIASM!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3834", "YOU CAN DO IT^1,&HUMAN!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3839", "* (There's a switch on the&  trunk of this tree.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_3840", "* (Press it?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3841", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3845", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_3859", "OHO^1!&THE HUMAN ARRIVES!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3860", "ARE YOU READY TO&HANG OUT WITH&UNDYNE?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3861", "I HAVE A PLAN&TO MAKE YOU TWO&GREAT FRIENDS!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3862", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_3863", "* (Will you hang out?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3864", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3872", "OKAY^1!&STAND BEHIND ME!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3878", "HMMM..^1.&STILL GETTING&READY?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3879", "\E0TAKE YOUR TIME!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3884", "OKAY^1!&ALL READIED-UP&TO HANG OUT!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3885", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_3886", "* (Will you hang out?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3887", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3895", "OKAY^1!&STAND BEHIND ME!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3901", "TAKE YOUR TIME!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3910", "OKAY^1!&STAND BEHIND ME!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3916", "TAKE YOUR TIME!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3921", "\E4* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3922", "\E5* So why are YOU&  here?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3923", "\E4* To rub your victory&  in my face?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3924", "\E4* To humiliate me&  even further?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3925", "\E1* IS THAT IT? & &  Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3926", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3932", "\E2* Oh-ho-ho-ho./");
ds_map_add(global.text_data_en, "SCR_TEXT_3933", "\E1* Well^1, I've got news&  for you^1, BRAT./");
ds_map_add(global.text_data_en, "SCR_TEXT_3934", "\E2* You're on MY&  battlefield now./");
ds_map_add(global.text_data_en, "SCR_TEXT_3935", "\E3* And you AREN'T&  going to&  humiliate me./");
ds_map_add(global.text_data_en, "SCR_TEXT_3936", "\E3* I'll TELL you&  what's going to&  happen./");
ds_map_add(global.text_data_en, "SCR_TEXT_3937", "\E0* We're going to&  hang out./");
ds_map_add(global.text_data_en, "SCR_TEXT_3938", "\E2* We're going to&  have a good&  time./");
ds_map_add(global.text_data_en, "SCR_TEXT_3939", "\M1* We're going to&  become \"friends.\"/");ds_map_add(global.text_data_en, "SCR_TEXT_3940", "\E3* You'll become so&  enamored with me.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3941", "\E1* YOU'LL be the one&  feeling humiliated&  for your actions!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3942", "\E6* Fuhuhuhuhu!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3943", "\M2* It's the perfect&  revenge!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3944", "\E1* Err.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3945", "\E9* Why don't you&  have a seat?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3951", "\E4* Then why are you&  here?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3952", "\E1* ...!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3953", "\E2* Wait^1, I get it./");
ds_map_add(global.text_data_en, "SCR_TEXT_3954", "\E3* You think that I'm&  gonna be friends&  with you^1, huh?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3955", "* Right???&              NEVER &  Yes         with you\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3956", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_3963", "\E6* Really^1?&* How delightful!^1!&* I accept!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3964", "* Let's all frolick&  in the fields&  of friendship!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3965", "\E2* ...NOT!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3966", "\E2* Why would I EVER&  be friends with&  YOU!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3967", "\E3* If you weren't my&  houseguest^1, I'd beat&  you up right now!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3968", "\E0* You're the enemy&  of everyone's hopes&  and dreams!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3969", "\E1* I WILL NEVER&  BE YOUR FRIEND./");
ds_map_add(global.text_data_en, "SCR_TEXT_3970", "\E3* Now get out of&  my house!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3976", "\E1* WHAT?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3977", "\E4* First you parade&  into my house^1,&  then you INSULT me?/");
ds_map_add(global.text_data_en, "SCR_TEXT_3978", "\E2* You little BRAT^1!&* I have half a&  mind to.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3979", "\E1* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_3980", "\E3* Wait./");
ds_map_add(global.text_data_en, "SCR_TEXT_3981", "\E2* I'll prove you&  WRONG./");
ds_map_add(global.text_data_en, "SCR_TEXT_3982", "\E3* We ARE going to&  be friends./");
ds_map_add(global.text_data_en, "SCR_TEXT_3983", "\E1* In fact.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3984", "\E3* We./");
ds_map_add(global.text_data_en, "SCR_TEXT_3985", "\M1* Are going to be&  BESTIES./");
ds_map_add(global.text_data_en, "SCR_TEXT_3986", "* I'll make you like&  me so much.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3987", "\E1* Your WHOLE LIFE&  will revolve around&  me!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3988", "\M2* It's the perfect&  revenge!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3989", "\E6* FUHUHUHUHU!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_3990", "\E1* Err.../");
ds_map_add(global.text_data_en, "SCR_TEXT_3991", "\E9* Now^1, why don't&  you have a seat?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_3998", "* (Sit down and progress?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_3999", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4003", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4010", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4011", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4016", "* That sugar's for&  the tea./");
ds_map_add(global.text_data_en, "SCR_TEXT_4017", "\E2* I'm not gonna give&  you a cup of&  sugar!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4018", "\E6* What do I look&  like^1, the ice-cream&  woman?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4019", "\E2* Do human ice-cream&  women TERRORIZE HUMANITY&  with ENERGY SPEARS?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4020", "\E3* Are their ice-cream&  songs a PRELUDE TO&  DESTRUCTION?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4021", "\E1* IS THAT IT? & &  Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4022", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4028", "\E1* ... what^1?&* REALLY?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4029", "\E6* That rules!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4033", "\E3* That's what I&  thought./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4038", "* Envision these&  vegetables as your&  greatest enemy!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4039", "\E2* Now!^1!&* Pound them to dust&  with your fists!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4041", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_4042", "* (How will you pound?)& &         Strong      Wimpy\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4043", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4050", "* (You punch the vegetables&  at full force^1.&* You knock over a tomato.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4052", "* YEAH^1!&* YEAH!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4053", "\E1* Our hearts are&  uniting against these&  healthy ingredients!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4054", "\M2* NOW IT'S MY TURN!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4055", "* NGAHHH!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4060", "* (You pet the vegetables&  in an affectionate&  manner.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4062", "* OH MY GOD!!^1!&* STOP PETTING THE&  ENEMY!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4063", "\M2* I'll show you&  how it's done!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4064", "* NGAHHH!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4071", "* ... we add the&  noodles!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4072", "\E0* Homemade noodles&  are the best!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4073", "\E6* BUT I JUST BUY&  STORE-BRAND!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4074", "\M2* THEY'RE THE&  CHEAPEST!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4075", "\E1* NGAHHHHHHHHH&  HHHHHHHHHH!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4076", "\E9* Uhh^1, just put them&  in the pot./");
ds_map_add(global.text_data_en, "SCR_TEXT_4077", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_4078", "\M0* (How will you put them in?)& &         Fiercely    Careful\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4079", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4086", "* (You throw everything into&  the pot as hard as you can^1,&  including the box.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4087", "* (It clanks against the&  empty bottom.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4089", "\M2* YEAH!!^1!&* I'M INTO IT!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4094", "* (You place the noodles&  in one at a time.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4095", "* (They clank against the&  empty bottom.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4097", "* Nice???/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4103", "\E0* Humans suck^1, but&  their history..^1.&* Kinda rules./");
ds_map_add(global.text_data_en, "SCR_TEXT_4104", "\E2* Case in point^1:&* This giant sword!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4105", "\E0* Historically^1, humans&  wielded swords up&  to 10x their size./");
ds_map_add(global.text_data_en, "SCR_TEXT_4106", "\E1* RIGHT?& &  True        False\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4107", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4113", "\E6* Heh^1, I knew it!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4114", "\E2* When I first heard&  that^1, I immediately&  wanted one!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4115", "\E0* So me and Alphys&  built a giant&  sword together./");
ds_map_add(global.text_data_en, "SCR_TEXT_4116", "\E0* She figured out all&  the specs herself.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4117", "\E6* She's smart^1, huh!?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4121", "\E2* Pfft^1!&* You liar!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4122", "\E3* I've READ Alphys's&  human history book&  collection!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4123", "\E3* I know all about&  your giant swords.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4124", "\E3* Your colossal^1,&  alien-fighting&  robots.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4125", "* Your supernatural&  princesses.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4126", "\E6* Heh^1! There's no&  way you're gonna&  fool me!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4131", "* (Look inside the bone drawer?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4132", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4136", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4147", "\M5* WHAT A SENSATIONAL OPPORTUNITY&  FOR A STORY!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4148", "\M3* I CAN SEE THE HEADLINE NOW:/");
ds_map_add(global.text_data_en, "SCR_TEXT_4149", "\M4* \"A DOG EXISTS SOMEWHERE.\"/");ds_map_add(global.text_data_en, "SCR_TEXT_4150", "\M2* FRANKLY^1, I'M BLOWN AWAY./");
ds_map_add(global.text_data_en, "SCR_TEXT_4151", "* (REPORT THIS ONE?)& &         Report      Look More\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4152", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4159", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4165", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4170", "\M5* THIS DOG..^1.&* STILL EXISTS!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4171", "* THIS STORY..^1.&* JUST KEEPS GETTING&  BETTER AND BETTER!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4172", "\M2* (REPORT THIS ONE?)& &         Report      Look More\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4173", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4179", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4185", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4191", "\M5* OH MY!!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4192", "\M2* ... IT'S A COMPLETELY&  NONDESCRIPT GLASS OF WATER./");
ds_map_add(global.text_data_en, "SCR_TEXT_4193", "\M4* BUT ANYTHING CAN MAKE&  A GREAT STORY WITH ENOUGH&  SPIN!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4194", "\M2* (REPORT THIS ONE?)& &         Report      Look More\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4195", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4201", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4207", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4214", "\M3* I'M HONORED TO BE IN THE&  PRESENCE OF SUCH A HUGE&  LUKEWARM WATER FAN^1, FOLKS!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4215", "\M2* (REPORT THIS ONE?)& &         Report      Look More\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4216", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4222", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4228", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4234", "\M5* OH NO!!^1!&* THAT MOVIE SCRIPT!!^1!&* HOW'D??^1? THAT GET THERE???/");
ds_map_add(global.text_data_en, "SCR_TEXT_4235", "\M4* IT'S A SUPER-JUICY SNEAK&  PREVIEW OF MY LATEST&  GUARANTEED-NOT-TO-BOMB FILM:/");
ds_map_add(global.text_data_en, "SCR_TEXT_4236", "\M6* METTATON THE MOVIE XXVIII..^1.&  STARRING METTATON!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4237", "\M1* I'VE HEARD THAT LIKE THE&  OTHER FILMS.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4238", "\M1* IT CONSISTS MOSTLY OF A SINGLE&  FOUR-HOUR SHOT OF ROSE PETALS&  SHOWERING ON MY RECLINING BODY./");
ds_map_add(global.text_data_en, "SCR_TEXT_4239", "\M5* OOH!!^1!&* BUT THAT'S!!^1!&* NOT CONFIRMED!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4240", "\M5* YOU WOULDN'T (COUGH) SPOIL MY&  MOVIE FOR EVERYONE WITH A&  PROMOTIONAL STORY^1, WOULD YOU?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4241", "\M2* (REPORT THIS ONE?)& &         Report      Look More\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4242", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4248", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4254", "\M5* PHEW!!^1! THAT WAS CLOSE!^1!&* YOU ALMOST GAVE ME A BUNCH&  OF FREE ADVERTISEMENT!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4255", "\M2 %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4260", "\M3* OH^1!&* YOU'RE BACK!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4261", "\M6* THAT'S RIGHT^1, FOLKS^1!&* IT SEEMS NO ONE CAN RESIST&  THE ALLURE OF MY NEW FILM!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4262", "\M2* (REPORT THIS ONE?)& &         Report      Look More\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4263", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4270", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4276", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4282", "\M4* BASKETBALL'S A BLAST^1, ISN'T IT^1,&  DARLING?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4283", "\M1* TOO BAD YOU CAN'T PLAY WITH&  THESE BALLS./");
ds_map_add(global.text_data_en, "SCR_TEXT_4284", "\M4* THEY'RE MTT-BRAND FASHION&  BASKETBALLS^1.&* FOR WEARING^1, NOT PLAYING./");
ds_map_add(global.text_data_en, "SCR_TEXT_4285", "\M6* YOU CAN'T GET RICH AND FAMOUS&  LIKE MOI WITHOUT BEAUTIFYING&  A FEW ORBS./");
ds_map_add(global.text_data_en, "SCR_TEXT_4286", "\M2* (REPORT THIS ONE?)& &         Report      Look More\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4287", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4293", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4299", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4304", "* IT SEEMS OUR REPORTER IS DRAWN&  TO SPORTS LIKE MOTHS TO A&  FLAMING BASKETBALL HOOP./");
ds_map_add(global.text_data_en, "SCR_TEXT_4305", "\M2* (REPORT THIS ONE?)& &         Report      Look More\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4306", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4312", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4318", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4326", "\M5* OH MY^1! IT'S A PRESENT^1!&* AND IT'S ADDRESSED TO YOU^1,&  DARLING!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4327", "\M6* AREN'T YOU JUST BURSTING&  WITH EXCITEMENT?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4328", "\M5* WHAT COULD BE INSIDE^1?&* WELL^1, NO TIME LIKE THE&  \"PRESENT\" TO FIND OUT!/");ds_map_add(global.text_data_en, "SCR_TEXT_4329", "\M2* (REPORT THIS ONE?)& &         Report      Look More\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4330", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4336", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4342", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4347", "\M4* READY FOR YOUR..^1.&* PRESENTATION?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4348", "\M4* (... LET'S CUT THAT ONE IN&  POST.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4349", "\M2* (REPORT THIS ONE?)& &         Report      Look More\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4350", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4356", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4362", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4369", "\M5* OOH LA LA^1!&* THIS VIDEO GAME YOU FOUND..^1.&* IS DYNAMITE!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4370", "\M4* THOUGH I DON'T MAKE AN&  APPEARANCE IN IT UNTIL&  THREE-FOURTHS IN./");
ds_map_add(global.text_data_en, "SCR_TEXT_4371", "\M3* BUT I LIKE THAT./");
ds_map_add(global.text_data_en, "SCR_TEXT_4372", "\M6* APPEARING FROM THE HEAVENS LIKE&  MANNA^1, SLAKING THE AUDIENCE'S&  HUNGER FOR GORGEOUS ROBOTS.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4373", "\M5* OOH^1!&* THAT'S METTATON!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4374", "\M2* (REPORT THIS ONE?)& &         Report      Look More\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4375", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4381", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4387", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4392", "* AH^1, YOU UNDERSTAND./");
ds_map_add(global.text_data_en, "SCR_TEXT_4393", "* THIS IS A GAME WHERE YOU&  SHOULD CHECK EVERYTHING&  TWICE./");
ds_map_add(global.text_data_en, "SCR_TEXT_4394", "\M2* (REPORT THIS ONE?)& &         Report      Look More\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4395", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4401", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4407", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4415", "* Buy a Spider Cider for 9999G?& &         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_4416", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4433", "* Some spiders crawled down&  and gave you a jug./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4434", "* You didn't have enough&  gold./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4436", "* You are carrying too&  many items./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4439", "*%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4447", "* Buy a Spider Donut for 9999G?& &         Yes         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_4448", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4465", "* Some spiders crawled down&  and gave you a donut./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4466", "* You didn't have enough&  gold./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4468", "* You are carrying too&  many items./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4471", "*%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4477", "* Ribbit^1, ribbit.&* (I have heard you are quite&  merciful^1, for a human...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4478", "\W* (Surely you know by now a&  monster wears a \YYELLOW\W name&  when you can \YSPARE\W it.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4479", "* (What do you think of that?)&         Very        It's&         Helpful     Bad\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4480", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4486", "* (It is rather helpful.^1)&* (Remember^1, sparing is just&  saying you won't fight.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4487", "* (Maybe one day^1, you'll&  have to do it even if&  their name isn't yellow.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4491", "* (Really^1? Then^1, I'll tell all&  of my friends to tell&  their friends' friends...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4492", "* (Never use yellow names.)&* (How about that?)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4493", "         Keep        No more&         Yellow      Yellow&         Names       Names\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4494", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4501", "* (OK^1, they will still&  use yellow names.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4505", "* (OK^1, I will let them&  know not to use yellow&  names.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4511", "* Ribbit^1, ribbit^1.&* (How are you doing without&  yellow names?)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4512", "                     Bring &         It's        Them&         great       Back\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4513", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4519", "* (Glad to hear it.^1)&* (Though^1, I do not know why&  you dislike yellow.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4520", "* (You had better hope you do&  not encounter a banana-themed&  monster.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4524", "* (Huh^1? It's rather inconvenient&  that you changed your mind&  like this.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4525", "* (Since I told everyone&  not to use yellow names^1,&  everyone threw theirs out.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4526", "* (This is really troubling...^1)&* (Hmmm...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4527", "\W* (Well^1, last year it was&  fashionable to have \ppink\W &  names.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4528", "* (I think everyone still&  has those in their closets&  somewhere...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4529", "* (I'll ask everyone to look.^1)&* (But this is the last time!)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4535", "* Ribbit^1, ribbit...&* (I hope you're satisfied.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4540", "* \YNAPSTABLOOK22 has sent you&  a friend request.\W /");
ds_map_add(global.text_data_en, "SCR_TEXT_4541", "* Accept the request?& &         Accept      Reject\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4542", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4547", "* (It seems to have already&  rejected itself...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4588", "* hey^1.&* i heard you're going&  to the core./");
ds_map_add(global.text_data_en, "SCR_TEXT_4589", "\E0* how about grabbing some&  dinner with me first?&  Yeah        I'm busy \C");
ds_map_add(global.text_data_en, "SCR_TEXT_4590", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4591", "* .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4597", "* great^1, thanks for&  treating me./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4602", "* well^1, have fun in&  there./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4609", "* This is the barrier./");
ds_map_add(global.text_data_en, "SCR_TEXT_4610", "* This is what keeps&  us all trapped&  underground./");
ds_map_add(global.text_data_en, "SCR_TEXT_4611", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_4612", "* If.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4613", "* If by chance you&  have any unfinished&  business.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4614", "* Please do what you&  must./");
ds_map_add(global.text_data_en, "SCR_TEXT_4615", " & &         Continue    Go Back\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4616", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4623", "* ..^2.&* ... I see.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4624", "* This is it^1, then./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4630", "* I see./");
ds_map_add(global.text_data_en, "SCR_TEXT_4631", "* Anything you want to&  do is important&  enough./");
ds_map_add(global.text_data_en, "SCR_TEXT_4632", "* Even something as small&  as reading a book^1,&  or taking a walk.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4633", "* Please take your time./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4639", "* Oh..^1.&* Back so soon?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4640", "* How are you feeling?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4641", " & &         Ready       Go Back\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4642", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4649", "* ..^2.&* ... I see.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4650", "* This is it^1, then./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4655", "* I see./");
ds_map_add(global.text_data_en, "SCR_TEXT_4656", "* Do what you have to./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4662", "* Tra la la^1.&* I am the riverman./");
ds_map_add(global.text_data_en, "SCR_TEXT_4663", "* Or am I the riverwoman...^1?&* It doesn't really matter./");
ds_map_add(global.text_data_en, "SCR_TEXT_4664", "* I love to ride in my boat^1.&* Would you care to join me?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4665", "* (Ride in the boat?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4666", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4669", "* Tra la la^1.&* Care for a ride?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4670", "* (Ride in the boat?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4671", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4678", "* Where will we go today?& &         Error       Error\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4680", "* Where will we go today?& &         Snowdin     Waterfall\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4682", "* Where will we go today?& &         Snowdin     Hotland\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4684", "* Where will we go today?& &         Waterfall   Hotland\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4686", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4691", "* Then perhaps another time^1.&* Or perhaps not^1.&* It doesn't really matter./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4713", "* Then we're off.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4720", "* (There's a switch on the&  wall.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4721", "* (Press it?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4722", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4725", "* (The switch doesn't do&  anything.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4729", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4743", "* (Seems like a comfortable&  bed.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4744", "* (Lie on it?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4745", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4749", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4763", "* (It's just a regular suspicious&  bed now.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4767", "* (It's a yellow key.^1)&* (You put it on your&  keychain.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4772", "* (There's something under&  the sheets.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4773", "* (Check it out?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4774", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4779", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4791", "* (The power has been turned&  on.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4794", "* (It seems like this controls&  the elevator's power.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4795", "* (Turn it on?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4796", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4801", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_4816", "\E7* I always was a crybaby^1,&  wasn't I^1, \[C]?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4817", "\E1* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_4818", "\E2* ... I know./");
ds_map_add(global.text_data_en, "SCR_TEXT_4819", "\E0* You're not actually&  \[C], are you?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4820", "\E7* \[C]'s been gone for&  a long time./");
ds_map_add(global.text_data_en, "SCR_TEXT_4821", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_4822", "\E9* Um..^1. what.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4823", "\E0* What IS your name?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4824", "\E2* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_4825", "\E5* \"Frisk?\"/");ds_map_add(global.text_data_en, "SCR_TEXT_4826", "\E7* That's.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4827", "\E5* A nice name./");
ds_map_add(global.text_data_en, "SCR_TEXT_4828", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_4829", "\E7* Frisk.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4830", "\E0* I haven't felt like&  this for a long time./");
ds_map_add(global.text_data_en, "SCR_TEXT_4831", "\E2* As a flower^1, I was&  soulless./");
ds_map_add(global.text_data_en, "SCR_TEXT_4832", "\E1* I lacked the power to&  love other people./");
ds_map_add(global.text_data_en, "SCR_TEXT_4833", "\E2* However^1, with everyone's&  souls inside me.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4834", "\E7* I not only have my own&  compassion back.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4835", "\E5* But I can feel every&  other monster's as&  well./");
ds_map_add(global.text_data_en, "SCR_TEXT_4836", "\E7* They all care about&  each other so much./");
ds_map_add(global.text_data_en, "SCR_TEXT_4837", "\E0* And..^1. they care about&  you too^1, Frisk./");
ds_map_add(global.text_data_en, "SCR_TEXT_4838", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_4839", "\E7* I wish I could tell&  you how everyone&  feels about you./");
ds_map_add(global.text_data_en, "SCR_TEXT_4840", "* Papyrus..^1. Sans..^1.&* Undyne..^1. Alphys.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4841", "\E0* ... Toriel./");
ds_map_add(global.text_data_en, "SCR_TEXT_4842", "\E7* Monsters are weird./");
ds_map_add(global.text_data_en, "SCR_TEXT_4843", "\E5* Even though they barely&  know you.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4844", "\E6* It feels like they&  all really love&  you./");
ds_map_add(global.text_data_en, "SCR_TEXT_4845", "\E8* Haha./");
ds_map_add(global.text_data_en, "SCR_TEXT_4846", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_4847", "\E1* Frisk..^1. I..^1.&* I understand if you&  can't forgive me./");
ds_map_add(global.text_data_en, "SCR_TEXT_4848", "* I understand if you&  hate me./");
ds_map_add(global.text_data_en, "SCR_TEXT_4849", "* I acted so strange and&  horrible./");
ds_map_add(global.text_data_en, "SCR_TEXT_4850", "\E3* I hurt you./");
ds_map_add(global.text_data_en, "SCR_TEXT_4851", "* I hurt so many people./");
ds_map_add(global.text_data_en, "SCR_TEXT_4852", "\E1* Friends^1, family^1,&  bystanders.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4853", "\E3* There's no excuse for&  what I've done./");
ds_map_add(global.text_data_en, "SCR_TEXT_4855", " & &  Forgive     Do not\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4856", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4862", "\E3* Wh..^1. what?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4863", "\E7* ... Frisk^1, come on./");
ds_map_add(global.text_data_en, "SCR_TEXT_4864", "\E0* You're..^1.&* You're gonna make me&  cry again./");
ds_map_add(global.text_data_en, "SCR_TEXT_4865", "\E7* ... besides^1, even if&  you do forgive me.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4869", "\E2* ... right^1./");
ds_map_add(global.text_data_en, "SCR_TEXT_4870", "* I understand./");
ds_map_add(global.text_data_en, "SCR_TEXT_4871", "\E1* I just hope that.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4872", "* I can make up for&  it a little right&  now./");
ds_map_add(global.text_data_en, "SCR_TEXT_4875", "\E1* I can't keep these&  souls inside of me./");
ds_map_add(global.text_data_en, "SCR_TEXT_4876", "\E0* The least I can do&  is return them./");
ds_map_add(global.text_data_en, "SCR_TEXT_4877", "\E2* But first.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4878", "\E4* There's something I&  have to do./");
ds_map_add(global.text_data_en, "SCR_TEXT_4879", "* Right now^1, I can feel&  everyone's hearts&  beating as one./");
ds_map_add(global.text_data_en, "SCR_TEXT_4880", "* They're all burning&  with the same&  desire./");
ds_map_add(global.text_data_en, "SCR_TEXT_4881", "* With everyone's power..^1.&* With everyone's&  determination.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4882", "* It's time for&  monsters.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4883", "* To finally go free./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4887", "\E7* Frisk.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4888", "\E0* I have to go now./");
ds_map_add(global.text_data_en, "SCR_TEXT_4889", "\E7* Without the power of&  everyone's souls.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4890", "\E1* I can't keep&  maintaining this&  form./");
ds_map_add(global.text_data_en, "SCR_TEXT_4891", "* In a little while.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4892", "* I'll turn back into&  a flower./");
ds_map_add(global.text_data_en, "SCR_TEXT_4893", "\E3* I'll stop being&  \"myself.\"/");ds_map_add(global.text_data_en, "SCR_TEXT_4894", "* I'll stop being able&  to feel love again./");
ds_map_add(global.text_data_en, "SCR_TEXT_4895", "\E1* So..^1. Frisk./");
ds_map_add(global.text_data_en, "SCR_TEXT_4896", "\E7* It's best if you&  just forget about&  me^1, OK?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4897", "\E0* Just go be with&  the people who&  love you./");
ds_map_add(global.text_data_en, "SCR_TEXT_4898", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_4899", " &         Comfort&         him         Do not\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4900", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4919", "\E0* So^1, Alphys.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4920", "\E9* What do you want&  to do now that&  we're all free?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4921", "\E0* We have the whole&  world to explore&  now./");
ds_map_add(global.text_data_en, "SCR_TEXT_4923", "\E3* W-well^1, of course&  I'm going to go&  out and.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4924", "\E4* Um.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4925", "\E3* No^1, I should be&  honest!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4926", "\E1* I'm gonna stay inside&  and watch anime like&  a total loser!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4928", "\E0THAT'S THE SPIRIT!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4929", "EVERYONE!!^1!&A CELEBRATION!!!&TO BEING LOSERS!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4931", "\E9* Heh^1.&* Papyrus has the&  right idea./");
ds_map_add(global.text_data_en, "SCR_TEXT_4932", "\E0* Losing to Frisk is&  the best thing to&  ever happen to me./");
ds_map_add(global.text_data_en, "SCR_TEXT_4933", "\E0* So I'm glad that&  we.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4934", "\E9* Huh^1?&* What is it^1, Asgore?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4936", "\E2* Um..^1. what's an.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4937", "\E0* ... anime?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4939", "\E1* (Oh My God?)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4940", "\E3* (Frisk^1. Please.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4941", "\E2* (Help me explain what&  anime is to Asgore.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_4942", "\E0* Y-you see^1, it's&  like a cartoon^1,&  but.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4943", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_4944", " &         With        With&         Sword's     Gun's\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4945", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4950", "\E2* So it's like a&  cartoon..^1.&* But with swords?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4952", "\E2* So it's like a&  cartoon..^1.&* But with guns?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4953", "\E0* Golly^1!&* That sounds neato!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4954", "\E3* Where is this^1?&* Where can I see the&  Anime./");
ds_map_add(global.text_data_en, "SCR_TEXT_4956", "\E3* H-hold on^1, uh..^1.&* I think I have&  some on my phone./");
ds_map_add(global.text_data_en, "SCR_TEXT_4957", "\E0* Here^1, l-look at&  this!/");
ds_map_add(global.text_data_en, "SCR_TEXT_4958", "\E0* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_4959", "\E3*...Oh^1, uh.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4960", "\E4* Um..^1. that's the..^1.&* That's the wrong.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4961", "\E5* Uh^1, nevermind./");
ds_map_add(global.text_data_en, "SCR_TEXT_4963", "* Golly^1.&* Were those two robots.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4965", "\E9* ... kissing?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4967", "\E0* Boy^1!&* Technology sure is&  something^1, isn't it?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4969", "\E5* Eheheh..^1. yeah^1!&* It sure is!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4973", "\E0* Psst..^1.&* F-Frisk./");
ds_map_add(global.text_data_en, "SCR_TEXT_4974", "\E3* Um^1, you've gotta&  tell me./");
ds_map_add(global.text_data_en, "SCR_TEXT_4975", "\E6* D..^1. do you think&  Asgore and Toriel&  are...?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4976", "\E3* Uh^1, ever gonna get&  back together?/");
ds_map_add(global.text_data_en, "SCR_TEXT_4977", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_4978", "& &         Yeah        Nope\C");
ds_map_add(global.text_data_en, "SCR_TEXT_4979", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_4983", "* Error.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4987", "\E7* Y-yeah!!^1!&* Yeah^1, that's what&  I hope^1, too./");
ds_map_add(global.text_data_en, "SCR_TEXT_4988", "\E7* Just think about how&  cute they must have&  been together./");
ds_map_add(global.text_data_en, "SCR_TEXT_4989", "\E0* It's quickly becoming&  my number one ship&  of all time./");
ds_map_add(global.text_data_en, "SCR_TEXT_4990", "\E7* Tori and Gorey.../");
ds_map_add(global.text_data_en, "SCR_TEXT_4991", "\E5* My..^1.&* My old boss and&  his ex-wife./");
ds_map_add(global.text_data_en, "SCR_TEXT_4992", "\E8* ... uh^1, that sounds&  a lot less cool&  all of a sudden./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_4998", "\E8* ... yeah^1, that's what&  I thought./");
ds_map_add(global.text_data_en, "SCR_TEXT_4999", "\E7* A woman can dream&  though^1, right?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5000", "\E2* And write fanfiction./");
ds_map_add(global.text_data_en, "SCR_TEXT_5001", "\E1* A LOT of fanfiction./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5007", "\E0* Frisk^1!&* I just realized!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5008", "\E3* Now that we aren't&  fighting each&  other.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5009", "\E2* I can finally ask&  you.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5010", "\E0* \"Would you like a&  cup of tea?\"/");ds_map_add(global.text_data_en, "SCR_TEXT_5011", "\E2* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_5012", "\E0* Would you like a&  cup of tea?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5013", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_5014", "& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5015", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5019", "* Error.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5023", "* Oh^1!&* Well!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5024", "\E3* Actually^1, the cup I&  had is cold now./");
ds_map_add(global.text_data_en, "SCR_TEXT_5025", "* So you shouldn't&  have it./");
ds_map_add(global.text_data_en, "SCR_TEXT_5026", "\E0* But^1, I am so&  happy you said&  yes./");
ds_map_add(global.text_data_en, "SCR_TEXT_5027", "\E0* As soon as I can^1,&  I will make some&  more for you./");
ds_map_add(global.text_data_en, "SCR_TEXT_5028", "\E0* Then we can be&  great pals./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5034", "\E3* Oh.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5035", "\E3* Okay./");
ds_map_add(global.text_data_en, "SCR_TEXT_5037", "\E2* Frisk^1! Stop^1!&* You're breaking his&  big burly heart!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5039", "\E2* Um^1, it's OK^1, Undyne./");
ds_map_add(global.text_data_en, "SCR_TEXT_5040", "\E0* My heart's already&  broken./");
ds_map_add(global.text_data_en, "SCR_TEXT_5042", "\E6* ASGORE^1! STOP^1!&* YOU'RE BREAKING MY&  BIG BURLY HEART!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5044", "\E9* Y-yeah^1, Asgore^1.&* Don't break Undyne's&  heart./");
ds_map_add(global.text_data_en, "SCR_TEXT_5045", "\E2* That's my job./");
ds_map_add(global.text_data_en, "SCR_TEXT_5047", "\E2* OH MY GOD!&* YOU'RE GOING BACK&  IN THE TRASH!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5049", "\E0CAN I GO IN THE&TRASH TOO?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5051", "\E9* Sure^1, Papyrus./");
ds_map_add(global.text_data_en, "SCR_TEXT_5053", "\E1* guess i have to&  go in the trash&  too./");
ds_map_add(global.text_data_en, "SCR_TEXT_5055", "\E0* Oh^1, may I enter&  the trash as well?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5057", "\E1* Uh^1, okay?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5059", "\E0* Am I invited to&  the trash?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5061", "\E6* SURE!!!&* WHY NOT!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5063", "\E1* On second thought^1,&  do not put me&  in the trash./");
ds_map_add(global.text_data_en, "SCR_TEXT_5065", "\E5* Oh.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5067", "\E1* OH MY GOD!!!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5073", "* (If you leave here^1, your&  adventure will really&  be over.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5074", "* (Your friends will follow&  you out of the underground.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5075", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_5076", " &         Don't       I'm&         leave       ready\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5077", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5081", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_5095", "\E0* Oh my.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5097", "\E0* Isn't it beautiful^1,&  everyone?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5099", "\E3* Wow..^1. it's e-even&  better than on TV./");
ds_map_add(global.text_data_en, "SCR_TEXT_5100", "\E7* WAY better^1!&* Better than I ever&  imagined!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5102", "\E1* Frisk^1, you LIVE with&  this!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5103", "\E9* The sunlight is so&  nice..^1. and the air&  is so fresh!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5104", "* I really feel alive!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5106", "\E0HEY SANS.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5107", "\E3WHAT'S THAT GIANT&BALL?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5109", "\E1* we call that&  \"the sun^1,\" my friend./");ds_map_add(global.text_data_en, "SCR_TEXT_5111", "\E0THAT'S THE SUN!^1?&WOWIE!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5112", "I CAN'T BELIEVE&I'M FINALLY MEETING&THE SUN!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5114", "\E0* I could stand here&  and watch this for&  hours.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5116", "\E0* Yes^1, it is beautiful^1,&  is it not?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5117", "\E1* But we should really&  think about what comes&  next./");
ds_map_add(global.text_data_en, "SCR_TEXT_5119", "\E3* Oh^1, right./");
ds_map_add(global.text_data_en, "SCR_TEXT_5120", "\E0* Everyone.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5121", "* This is the beginning&  of a bright new&  future./");
ds_map_add(global.text_data_en, "SCR_TEXT_5122", "* An era of peace between&  humans and monsters./");
ds_map_add(global.text_data_en, "SCR_TEXT_5123", "\E2* Frisk.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5124", "* I have something to&  ask of you./");
ds_map_add(global.text_data_en, "SCR_TEXT_5125", "\E0* Will you act as our&  ambassador to the&  humans?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5126", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_5127", "* (Be the ambassador?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5128", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5133", "WOWi, Nice error./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5136", "\E0YEAH^1!&FRISK WILL BE THE&BEST AMBASSADOR!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5137", "AND I^1, THE GREAT&PAPYRUS.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5138", "WILL BE THE BEST&MASCOT!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5139", "I'LL GO MAKE A&GOOD FIRST&IMPRESSION!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5143", "\E0IT'S OK FRISK^1!&I'VE GOT YOU&COVERED!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5144", "IF YOU DON'T WANT&TO BE THE&AMBASSADOR.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5145", "I CAN DO IT FOR&YOU!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5146", "I'LL GO MAKE A&GOOD FIRST&IMPRESSION!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5151", "* Frisk.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5152", "\E2* You came from this&  world^1, right...?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5153", "\E1* So you must have&  a place to return to^1,&  do you not?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5154", "\E2* What will you do&  now?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5155", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_5156", "         I want      I have&         to stay     places&         with you    to go\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5157", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5161", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_5182", "* (The door has no mail slot.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5183", "* (Slide the letter under?)& &         Slide       NO!!!! \C");
ds_map_add(global.text_data_en, "SCR_TEXT_5184", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5197", "* (You slide the letter under&  the door and give it a&  knock.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5206", "* (You'll keep the letter&  warm for a little longer.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5212", "* (It's a note from Alphys.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5213", "* (Read it...?)& &         Read        Do not \C");
ds_map_add(global.text_data_en, "SCR_TEXT_5214", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5220", "* (It's hard to read because&  of the handwriting^1, but&  you try your best...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5221", "* Hey./");
ds_map_add(global.text_data_en, "SCR_TEXT_5222", "* Thanks for your help back&  there./");
ds_map_add(global.text_data_en, "SCR_TEXT_5223", "* You guys..^1.&* Your support really means a&  lot to me./");
ds_map_add(global.text_data_en, "SCR_TEXT_5224", "* But..^1.&* As difficult as it is&  to say this.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5225", "* You guys alone can't&  magically make my own&  problems go away./");
ds_map_add(global.text_data_en, "SCR_TEXT_5226", "* I want to be a better&  person./");
ds_map_add(global.text_data_en, "SCR_TEXT_5227", "* I don't want to be&  afraid anymore./");
ds_map_add(global.text_data_en, "SCR_TEXT_5228", "* And for that to happen^1,&  I have to be able to&  face my own mistakes./");
ds_map_add(global.text_data_en, "SCR_TEXT_5229", "* I'm going to start&  doing that now./");
ds_map_add(global.text_data_en, "SCR_TEXT_5230", "* I want to be clear./");
ds_map_add(global.text_data_en, "SCR_TEXT_5231", "* This isn't anyone else's&  problem but mine./");
ds_map_add(global.text_data_en, "SCR_TEXT_5232", "* But if you don't ever&  hear from me again.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5233", "* If you want to know&  \"the truth.\"/");ds_map_add(global.text_data_en, "SCR_TEXT_5234", "* Enter the door to the&  north of this note./");
ds_map_add(global.text_data_en, "SCR_TEXT_5235", "* You all at least deserve&  to know what I did./");
ds_map_add(global.text_data_en, "SCR_TEXT_5236", "* (That's all she wrote.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5240", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_5250", "* (Buy chips for 25G?)& &         Buy         No \C");
ds_map_add(global.text_data_en, "SCR_TEXT_5251", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5255", "* (There were no chips left&  in the machine.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5256", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5274", "* (The vending machine&  dispensed some chisps.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5275", "* (You didn't have enough&  gold.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5277", "* (You are carrying too&  many items.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5280", "*%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5285", "* Ring..\E0.\TT /");
ds_map_add(global.text_data_en, "SCR_TEXT_5286", "\F1 %");
ds_map_add(global.text_data_en, "SCR_TEXT_5290", "* Hello?&* This is TORIEL./");
ds_map_add(global.text_data_en, "SCR_TEXT_5291", "* For no reason in&  particular...&* Which do you prefer?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5292", "* Cinnamon or&  butterscotch?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5293", "\E1* ... wait^1.&* Do not tell me./");
ds_map_add(global.text_data_en, "SCR_TEXT_5294", "\E0* It is ERROR MESSAGE!& &  Yes         No      \C");
ds_map_add(global.text_data_en, "SCR_TEXT_5295", "\E0* Is it Butterscotch?& &  Yes         No      \C");
ds_map_add(global.text_data_en, "SCR_TEXT_5296", "\E0* Is it Cinnamon?& &  Yes         No      \C");
ds_map_add(global.text_data_en, "SCR_TEXT_5297", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5309", "\E0* Hee hee hee^1.&* I had a feeling./");
ds_map_add(global.text_data_en, "SCR_TEXT_5310", "\E1* When humans fall down&  here^1, strangely..^1.&* I.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5311", "\E1* I often feel like&  I already know them./");
ds_map_add(global.text_data_en, "SCR_TEXT_5312", "\E0* Truthfully^1, when I first&  saw you^1, I felt.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5313", "\E1* ... like I was seeing&  an old friend for&  the first time./");
ds_map_add(global.text_data_en, "SCR_TEXT_5314", "\E0* Strange^1, is it not?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5315", "* Well^1, thank you for&  your selection./");
ds_map_add(global.text_data_en, "SCR_TEXT_5316", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_5317", "* Click.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5323", "\E1* Oh..^1. I see./");
ds_map_add(global.text_data_en, "SCR_TEXT_5324", "\E0* Well^1, thank you^1.&* Goodbye for now./");
ds_map_add(global.text_data_en, "SCR_TEXT_5325", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_5326", "* Click.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5337", "* (Seems like you could skip&  Mettaton's monologue by&  turning him around now.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5338", "* (What will you do?)& &         Skip        Hear again\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5339", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5345", "* (You told Mettaton there&  was something cool&  behind him.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5353", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_5359", "* though.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5360", "* one thing about you&  always struck me&  as kinda odd./");
ds_map_add(global.text_data_en, "SCR_TEXT_5361", "* now^1, i understand&  acting in self-defense./");
ds_map_add(global.text_data_en, "SCR_TEXT_5362", "* you were thrown into&  those situations&  against your will./");
ds_map_add(global.text_data_en, "SCR_TEXT_5363", "* but.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5364", "* sometimes.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5365", "* you act like you&  know what's gonna&  happen./");
ds_map_add(global.text_data_en, "SCR_TEXT_5366", "* like you've already&  experienced it all&  before./");
ds_map_add(global.text_data_en, "SCR_TEXT_5367", "* this is an odd thing&  to say^1, but.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5368", "\W* if you have some sort&  of \Yspecial power\W.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5369", "* isn't it your&  responsibility to do&  the right thing?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5370", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_5371", " & &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5372", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5379", "\E1* ah./");
ds_map_add(global.text_data_en, "SCR_TEXT_5380", "\E0* i see./");
ds_map_add(global.text_data_en, "SCR_TEXT_5381", "\E3* .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5390", "\E1* heh./");
ds_map_add(global.text_data_en, "SCR_TEXT_5391", "\E0* well^1, that's your&  viewpoint./");
ds_map_add(global.text_data_en, "SCR_TEXT_5392", "\E2* i won't judge you&  for it./");
ds_map_add(global.text_data_en, "SCR_TEXT_5393", "\E3* .../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5402", "* (Ring...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5404", "\E0* Hey!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5405", "\E3* This um^1, doesn't have&  anything to do with&  guiding you..^1. but.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5406", "\E2* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_5407", "\E6* Uhh^1, hey^1, would you want&  to watch a human TV&  show together???/");
ds_map_add(global.text_data_en, "SCR_TEXT_5408", "* Sometime???/");
ds_map_add(global.text_data_en, "SCR_TEXT_5409", "\E4* It's called^1, um^1,&  M..^1.Mew Mew Kissy&  Cutie.../");
ds_map_add(global.text_data_en, "SCR_TEXT_5410", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_5411", " & &         Sure!       ...no...\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5412", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5420", "* R-really!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5421", "\E3* It's so good^1!&* It's um^1, my favorite&  show!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5422", "* It's all about this&  human girl named Mew Mew&  who has cat ears!%");
ds_map_add(global.text_data_en, "SCR_TEXT_5423", "\E3* Which humans don't have!&* S-so she's all&  sensitive about them!%");
ds_map_add(global.text_data_en, "SCR_TEXT_5424", "\E6* But like...&* Eventually!%");
ds_map_add(global.text_data_en, "SCR_TEXT_5425", "* She realizes that her&  ears don't matter!%");
ds_map_add(global.text_data_en, "SCR_TEXT_5426", "* That her friends like&  her despite the ears!%");
ds_map_add(global.text_data_en, "SCR_TEXT_5427", "\E7* It's really moving!%");
ds_map_add(global.text_data_en, "SCR_TEXT_5428", "\E5* Whoops, spoilers%");
ds_map_add(global.text_data_en, "SCR_TEXT_5429", "\E6* Also, this sounds&  weird, but she has&  the power!%");
ds_map_add(global.text_data_en, "SCR_TEXT_5430", "\E5* To control the minds&  of anyone she kisses!%");
ds_map_add(global.text_data_en, "SCR_TEXT_5431", "\E3* She kisses people and&  controls them to fix&  her problems!!%");
ds_map_add(global.text_data_en, "SCR_TEXT_5432", "\E5* They don't remember&  anything after the&  kiss I mean!!%");
ds_map_add(global.text_data_en, "SCR_TEXT_5433", "\E3* BUT IF SHE MISSES&  THE KISS!!!&* THEN!!%");
ds_map_add(global.text_data_en, "SCR_TEXT_5434", "\E4* Then^1, uh^1, and^1, uh^1,&  also I mean^1, of course%");
ds_map_add(global.text_data_en, "SCR_TEXT_5435", "\E5* Eventually^1, she&  realizes that&  controlling people%");
ds_map_add(global.text_data_en, "SCR_TEXT_5436", "\E3* OKAY WELL I almost&  spoiled the whole&  show^1, but%");
ds_map_add(global.text_data_en, "SCR_TEXT_5437", "\E5* Uhhh^1, I think you'd&  really like it!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5438", "\E0* We should watch it^1!&* After you get through&  all this!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5439", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_5440", "* (Click...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5445", "\E5* Um^1! Well^1!&* That's okay!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5446", "* Just thought I'd!^1!&* Ask!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5447", "\E6* B-but I think you'd&  really like it!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5448", "* If you gave it a&  chance!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5449", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "SCR_TEXT_5450", "* (Click...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5455", "\M1* Did y'hear!^1?&* You're back!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5456", "\M0* I'll tell you a big secret./");
ds_map_add(global.text_data_en, "SCR_TEXT_5457", "\M1* I'm starting a band^1, y'hear?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5458", "\M1* It's called the Red Hot&  Chibi Peppers./");
ds_map_add(global.text_data_en, "SCR_TEXT_5459", "\M0* All I've thought of is&  the name./");
ds_map_add(global.text_data_en, "SCR_TEXT_5460", "\M3* And I don't^1, play...&* Instruments^1, or sing./");
ds_map_add(global.text_data_en, "SCR_TEXT_5461", "\M1* Well^1!&* Do you think we'll be&  popular!!!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5462", " & &         Yeah        No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5463", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5471", "\M0* Yeah^1, me too.../%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5477", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_5485", "* (It's a lamp.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5486", "* (Turn it on?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5487", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5493", "* (There's no lightbulb.^1)&* (A flashlight is stuck in&  the bulb socket.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5494", "* (Turn it on?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5495", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5499", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_5506", "* (The flashlight is out of&  batteries.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5510", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_5517", "* Hey^1, hey^1!&* Did you remember my name?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5518", "* (Did you?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5519", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5527", "* Wh-WHAT!^1?&* You REMEMBER!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5528", "* How could I be so easily&  defeateeeeeeeeed!?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5533", "* Wh-WHAT!^1?&* You DON'T REMEMBER!?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5534", "* How could I be so easily&  defeateeeeeeeeed!?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5541", "* (It's a small white dog.^1)&* (It's fast asleep...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5542", "* (Fight the dog?)& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5543", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5550", "* (Can't fight the dog.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5551", "* (Seems like the fabric it's&  sleeping on has too many&  holes in it.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5552", "* (Seems like the dog needs&  to \"patch\" the fabric.)/");ds_map_add(global.text_data_en, "SCR_TEXT_5553", "* (Then you can fight the dog.^1)&* (... maybe.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5554", "* (Upon closer examination^1,&  the holes in the fabric&  seem to be growing.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5555", "* (Might take a while for the&  dog to fix all of them.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5556", "* (Dogs aren't usually very&  good at knitting.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5557", "* (A crocheting dog is out of&  the question.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5561", "* (Let sleeping dogs lie^1, instead&  of fighting them.^1)&* (That's how the saying goes.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5566", "* (Knock knock)./");
ds_map_add(global.text_data_en, "SCR_TEXT_5569", "* Oooooaaah ^1!&* Room service !/");
ds_map_add(global.text_data_en, "SCR_TEXT_5570", "* Got my \"Sea Tea\" ?& &         Yes         No\C");ds_map_add(global.text_data_en, "SCR_TEXT_5571", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5575", "* Room service never came ^1.&* (Sigh ...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5581", "* Thanks a million ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5585", "* (No response.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5598", "* (You pour the Sea Tea under&  the door.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5599", "* HUH !?!?!?!^2?&* That's just the way I want ^1!&* Here's a tip ./");
ds_map_add(global.text_data_en, "SCR_TEXT_5600", "* (You got 99G.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5604", "* ..^1.&* No you don't ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5609", "* Then ...!?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5614", "* (Knock knock)./");
ds_map_add(global.text_data_en, "SCR_TEXT_5617", "* Oooooaaah ^1!&* Room service !/");
ds_map_add(global.text_data_en, "SCR_TEXT_5618", "* Got my \"Cinnamon Bun\" ?& &         Yes         No\C");ds_map_add(global.text_data_en, "SCR_TEXT_5619", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5623", "* Room service never came ^1.&* (Sigh ...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5628", "* Thanks a trillion ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5632", "* (No response.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5646", "* (You flatten the Cinnamon Bun&  until it's paper thin.)&* (You slide it under the door.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5647", "* HUH !?!?!?!^2?&* That's just the way I want ^1!&* Here's a tip ./");
ds_map_add(global.text_data_en, "SCR_TEXT_5648", "* (You got 99G.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5652", "* ..^1.&* No you don't ./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5657", "* Then ...!?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5662", "* (You hear shuffling.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5663", "* (Seems like you could put&  something under the door.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5664", " & &         Put         No Put\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5665", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5669", "* (No response.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5676", "* (...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5677", "* (But you didn't have anything&  appealing.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5705", "* (You put a Hot Dog in front&  of the door.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5706", "* (A white paw shoots out from&  under the door.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5707", "* (It tries to pull the Hot Dog&  into its room...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5708", "* (But it keeps pressing down too&  hard^1, and the hot dog keeps&  spinning away.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5709", "* (...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5710", "* (It finally succeeds.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5711", "* (...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5712", "* (You hear the grinding of&  stone.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5713", "* (A single hushpuppy slides&  out from under the door.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5714", "* (You got Hush Puppy.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5720", "* (You put a Hot Cat in front&  of the door.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5721", "* (You hear growling...)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5727", "* (You put a Dog Salad in front&  of the door.^1)&* (It slides underneath.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5728", "* (...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5729", "* (The Dog Salad was absorbed&  by the darkness.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5736", "* (You put a Dog Residue in&  front of the door.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5737", "* (It slides underneath the door^1,&  as if pulled by a magnet.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5738", "* (...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5743", "* (ZOMMM!!^1!)&* (It shoots back out at a&  high speed!)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5747", "* (Two Dog Residues slowly slide&  back out from underneath&  the door.)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5755", " %%");
ds_map_add(global.text_data_en, "SCR_TEXT_5761", "* Yes^1, we know^1.&* The elevator to the city&  is NOT working./");
ds_map_add(global.text_data_en, "SCR_TEXT_5762", "* Because of this incident^1, rooms&  are running at a special rate!/");
ds_map_add(global.text_data_en, "SCR_TEXT_5763", "* 200G a room^1. Interested^1?& &         Stay        Do not\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5764", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5768", "* 200G a room^1. Interested^1?& &         Stay        Do not\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5769", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5774", "* Did you enjoy your stay?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5775", "* What^1?&* Room..^1.&* Key?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5776", "* No^1, we don't do that./");
ds_map_add(global.text_data_en, "SCR_TEXT_5777", "* If you leave your room^1,&  you'll have to pay again./");
ds_map_add(global.text_data_en, "SCR_TEXT_5778", "* 200G a room^1. Interested^1?& &         Stay        Do not\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5779", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5791", "* Fabulous^1!&* We'll escort you to your&  room!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5797", "* ... that's not enough money./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5802", "* Do let us know if you&  change your mind^1.&* Have a sparkular day!/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5807", "* ... MY ONE TRUE LOVE?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5808", "* .../");
ds_map_add(global.text_data_en, "SCR_TEXT_5809", "* (YOU LOOK BORED^1, DARLING.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5810", "* (I WANT THIS TO BE A STELLAR&  PERFORMANCE^1, SO IF YOU&  WON'T GIVE IT YOUR ALL...)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5811", "* (THEN I'LL SKIP AHEAD FOR&  THE AUDIENCE'S SAKE.)/");
ds_map_add(global.text_data_en, "SCR_TEXT_5812", "* (Perform?)& &         Yeah        Skip this\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5813", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5819", "* (UNDERSTOOD.^1)&* (LET'S KNOCK 'EM DEAD!)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5823", "* (KA-SIGH...^1)&* (THE SHOW MUST GO ON!)/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5829", "Interesting./");
ds_map_add(global.text_data_en, "SCR_TEXT_5830", "You want to go back./");
ds_map_add(global.text_data_en, "SCR_TEXT_5831", "You want to go bac^1k&to the worl^2d&you destroyed./");
ds_map_add(global.text_data_en, "SCR_TEXT_5832", "It was you who pushed&everythin^1g to its edge./");
ds_map_add(global.text_data_en, "SCR_TEXT_5833", "It was you who led the worl^1d&to its destruction./");
ds_map_add(global.text_data_en, "SCR_TEXT_5834", "But you cannot accept it./");
ds_map_add(global.text_data_en, "SCR_TEXT_5835", "You think you are above&consequences.&         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5836", "");
ds_map_add(global.text_data_en, "SCR_TEXT_5842", "Exactly./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5846", "Then what are you looking for?/%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5851", "Perhaps./");
ds_map_add(global.text_data_en, "SCR_TEXT_5852", "We can reach a compromise./");
ds_map_add(global.text_data_en, "SCR_TEXT_5853", "You still have somethin^1g&I want./");
ds_map_add(global.text_data_en, "SCR_TEXT_5854", "Give it to me./");
ds_map_add(global.text_data_en, "SCR_TEXT_5855", "And I will bring this&world back./");
ds_map_add(global.text_data_en, "SCR_TEXT_5856", " & &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5857", "");
ds_map_add(global.text_data_en, "SCR_TEXT_5863", "Then it is agreed./");
ds_map_add(global.text_data_en, "SCR_TEXT_5864", "You will give me your SOUL.& &         Yes         No\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5865", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5869", "Then stay here for&all eternity./");
ds_map_add(global.text_data_en, "SCR_TEXT_5870", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5877", ".../");
ds_map_add(global.text_data_en, "SCR_TEXT_5878", "Then^1, it is done./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5882", "Then stay here for&all eternity./");
ds_map_add(global.text_data_en, "SCR_TEXT_5883", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5888", "* hey./");
ds_map_add(global.text_data_en, "SCR_TEXT_5889", "* is your refrigerator&  running?/");
ds_map_add(global.text_data_en, "SCR_TEXT_5890", " & &         yes         no\C");
ds_map_add(global.text_data_en, "SCR_TEXT_5891", " ");
ds_map_add(global.text_data_en, "SCR_TEXT_5897", "* nice^1.&* i'll be over to deposit&  the brewskis./%%");
ds_map_add(global.text_data_en, "SCR_TEXT_5901", "* ok^1, i'll send someone&  over to fix it./");
ds_map_add(global.text_data_en, "SCR_TEXT_5902", "* thanks for letting me&  know./");
ds_map_add(global.text_data_en, "SCR_TEXT_5903", "* good communication is&  important./%%");
