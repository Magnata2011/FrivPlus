ds_map_add(global.text_data_en, "scr_battlegroup_612", "* Woshua shuffles up.");
ds_map_add(global.text_data_en, "scr_battlegroup_626", "* Shyren hides in the corner&  but somehow encounters you&  anyway.");
ds_map_add(global.text_data_en, "scr_battlegroup_640", "* Mad Dummy blocks the way!");
ds_map_add(global.text_data_en, "scr_battlegroup_654", "* You shouldn't read this.");
