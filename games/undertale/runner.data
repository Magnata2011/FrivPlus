ds_map_add(global.text_data_en, "obj_vegetoid_190", "%%%");
ds_map_add(global.text_data_en, "obj_vegetoid_383", "* Vegetoid gave a mysterious&  smile.");
ds_map_add(global.text_data_en, "obj_vegetoid_384", "* Vegetoid cackles softly.");
ds_map_add(global.text_data_en, "obj_vegetoid_385", "* Vegetoid's here for your&  health.");
ds_map_add(global.text_data_en, "obj_vegetoid_386", "* It smells like steamed&  carrots and peas.");
ds_map_add(global.text_data_en, "obj_vegetoid_387", "* Vegetoid seems kind of&  bruised.");
ds_map_add(global.text_data_en, "obj_vegetoid_414", "* VEGETOID - ATK 6 DEF 6&* Serving Size: 1 Monster&* Not monitored by the USDA/^");
ds_map_add(global.text_data_en, "obj_vegetoid_428", "* You tried to eat Vegetoid^1,&  but it wasn't weakened&  enough./^");
ds_map_add(global.text_data_en, "obj_vegetoid_431", "* You took a bite out of&  Vegetoid^1.&* You recovered 5 HP!/^");
ds_map_add(global.text_data_en, "obj_vegetoid_445", "* You pat your stomach^1.&* Vegetoid offers a healthy&  meal./^");
ds_map_add(global.text_data_en, "obj_vsflowey_heartdefeated_114", "  And you're NEVER&  waking up!^3 %%");
