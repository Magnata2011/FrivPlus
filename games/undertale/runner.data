		{
			var name = global.monstername[i]
			if (global.language == "ja")
			{
				var width = 0
				for (var j = 1; j <= strlen(name); j++)
				{
					var ch = ord(string_char_at(name, j))
					if (ch == 32 || ch >= 65377)
						width += 13
					else if (ch < 8192)
						width += 16
					else
						width += 26
				}
			}
			else
				width = (strlen(name) * 16)
			if (width > maxwidth)
				maxwidth = width
		}
	}
	xwrite = (190 + maxwidth)
	for (i = 0; i < 3; i++)
	{
		if (global.monster[i] == true && (!instance_exists(obj_sansb)))
