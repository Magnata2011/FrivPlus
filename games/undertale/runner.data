		if (angleDiff2 > 80)
			dirspeed = 36
		if (angleDiff2 > 90)
			dirspeed = 42
		if (angleDiff2 > 100)
			dirspeed = 50
		if (angleDiff < 0)
			dirspeed = (-dirspeed)
		image_angle -= dirspeed
