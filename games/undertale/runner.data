			var cost = (pad + string(itemcost[i]))
		else
			cost = string(itemcost[i])
		draw_text(30, (130 + (20 * i)), string_hash_to_newline(scr_gettext("shop_buy_list", cost, scr_gettext(("item_name_" + string(item[i]))))))
	}
