								global.msg[1] = scr_gettext("SCR_TEXT_dogshrine_6004")
								FL_DogShrineLevel += 1
								trophy_unlock(("donate_" + string(FL_DogShrineLevel)))
							}
						}
					}
					if (FL_DogShrineStateAcknowledged == 0)
						FL_DogShrineStateAcknowledged = 1
				}
