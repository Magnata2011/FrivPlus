ds_map_add(global.text_data_en, "obj_aaron_243", "Come on&in, the&water's&fine ; )");
ds_map_add(global.text_data_en, "obj_aaron_244", "No need&for a&swimming&suit ; )");
ds_map_add(global.text_data_en, "obj_aaron_245", "Edu-&cation?&Hobby?&Talent?");
ds_map_add(global.text_data_en, "obj_aaron_246", "Whew,&I'm&sweating&; )");
ds_map_add(global.text_data_en, "obj_aaron_249", "Don't&get too&close&; )");
ds_map_add(global.text_data_en, "obj_aaron_250", "Sure&isn't&creepy&out ; )");
ds_map_add(global.text_data_en, "obj_aaron_251", "I sure&do love&muscles&; )");
ds_map_add(global.text_data_en, "obj_aaron_252", "Whew,&I'm&sweating&; )");
ds_map_add(global.text_data_en, "obj_aaron_257", "Flagrant&error&; )");
ds_map_add(global.text_data_en, "obj_aaron_258", "Flexing&contest?&OK, flex&more ; )");
ds_map_add(global.text_data_en, "obj_aaron_259", "Nice!!&I won't&lose&tho ; )");
ds_map_add(global.text_data_en, "obj_aaron_264", "Fiesty,&huh?&; )");
ds_map_add(global.text_data_en, "obj_aaron_265", "Wow!&Spunky!&Love it&; )");
ds_map_add(global.text_data_en, "obj_aaron_267", "You'll&change&your&mind ; )");
ds_map_add(global.text_data_en, "obj_aaron_272", "CHECK&all you&want ; )");
ds_map_add(global.text_data_en, "obj_aaron_273", "... ; )");
ds_map_add(global.text_data_en, "obj_aaron_276", "Ha, nice.&My kind&of humor&; )");
ds_map_add(global.text_data_en, "obj_aaron_278", "Just the&two of&us, huh?&; )");
ds_map_add(global.text_data_en, "obj_aaron_279", "Hi?&; )");
ds_map_add(global.text_data_en, "obj_aaron_282", "%%%");
ds_map_add(global.text_data_en, "obj_aaron_478", "* Aaron is splashing you&  playfully.");
ds_map_add(global.text_data_en, "obj_aaron_479", "* Aaron is looking around^1,&  fearful of something.");
ds_map_add(global.text_data_en, "obj_aaron_480", "* Aaron is sweating bullets^3.&* Literally.");
ds_map_add(global.text_data_en, "obj_aaron_481", "* Aaron is admiring his own&  muscles.");
ds_map_add(global.text_data_en, "obj_aaron_482", "* Smells like an underwater&  barnyard.");
ds_map_add(global.text_data_en, "obj_aaron_483", "* Smells like a mussel farm.");
ds_map_add(global.text_data_en, "obj_aaron_484", "* Aaron is ready for your&  next flex.");
ds_map_add(global.text_data_en, "obj_aaron_486", "* Aaron's muscles droop&  comically.");
ds_map_add(global.text_data_en, "obj_aaron_502", "* AARON - ATK 24 DEF 12&* This seahorse has a lot of&  HP (Horsepower)./");
ds_map_add(global.text_data_en, "obj_aaron_503", "* All of his attacks are harder&  to dodge at the bottom of the&  box./^");
ds_map_add(global.text_data_en, "obj_aaron_512", "* You tell Aaron to go away./^");
ds_map_add(global.text_data_en, "obj_aaron_514", "* You tell Aaron to go away^1.&* He agrees./^");
ds_map_add(global.text_data_en, "obj_aaron_524", "* You flex^1.&* Aaron flexes twice as hard.&* ATTACK increases for you two./^");
ds_map_add(global.text_data_en, "obj_aaron_525", "* You flex harder^1.&* Aaron flexes thrice as hard.&* ATTACK increases for you two./^");
ds_map_add(global.text_data_en, "obj_aaron_526", "* You flex^1.&* Aaron flexes very hard.../");
ds_map_add(global.text_data_en, "obj_aaron_527", "* He flexes himself out of&  the room!/^");
ds_map_add(global.text_data_en, "obj_aaronnpc_70", "* Since you flexed at me^1,&  I've been thinking of a&  lot of things ; )/");
ds_map_add(global.text_data_en, "obj_aaronnpc_71", "* Like..^1.&* Flexing ; )/%%");
ds_map_add(global.text_data_en, "obj_aaronnpc_75", "* And flexing ; )/%%");
ds_map_add(global.text_data_en, "obj_aaronnpc_80", "* You came all this way to&  see me flex ; )/");
ds_map_add(global.text_data_en, "obj_aaronnpc_81", "* This really says something&  about you ; )/%%");
ds_map_add(global.text_data_en, "obj_aaronnpc_86", "* I..^1. I'm sc-scared... ; )/");
ds_map_add(global.text_data_en, "obj_aaronnpc_87", "* Ghosts aren't real^1, right?&* ; )/");
ds_map_add(global.text_data_en, "obj_aaronnpc_88", "* What^1? They are real^1?&* Oh nooooooo ; )/%%");
ds_map_add(global.text_data_en, "obj_aaronnpc_92", "* First ghosts^1, are real^1, now&  anime's real ; )&* All my nightmares are true ; )/%%");
ds_map_add(global.text_data_en, "obj_actiontable_63", "AH^1, YES^1, ACTION&FIGURES./");
ds_map_add(global.text_data_en, "obj_actiontable_64", "A GREAT REFERENCE&FOR THEORETICAL&BATTLE SCENARIOS./");
ds_map_add(global.text_data_en, "obj_actiontable_66", "\E3HOW DO I HAVE&SO MANY?/");
ds_map_add(global.text_data_en, "obj_actiontable_67", "\E2WELL^1, LET'S JUST&SAY THEY'RE&FROM.../");
ds_map_add(global.text_data_en, "obj_actiontable_68", "\E0A CHUBBY^1, SMILING&MAN WHO LOVES TO&SURPRISE PEOPLE./");
ds_map_add(global.text_data_en, "obj_actiontable_69", "YEAH^1!!&THAT'S RIGHT!/");
ds_map_add(global.text_data_en, "obj_actiontable_70", "SANTA!!!!/%%");
ds_map_add(global.text_data_en, "obj_actiontable_72", "* (Action figures of many&  sexy robots.)/%%");
ds_map_add(global.text_data_en, "obj_actiontable_76", "* (Action figures of many&  sexy robots.)/%%");
ds_map_add(global.text_data_en, "obj_adate_125", "        DATING^1  STAR^5T^2.^2.^2.^3?%%");
ds_map_add(global.text_data_en, "obj_adate_142", "Uhhh^1, sorry^2!&I'm still getting&dressed!/%%");
ds_map_add(global.text_data_en, "obj_adate_170", "H-how do I look?/");
ds_map_add(global.text_data_en, "obj_adate_171", "My friend helped me&pick out this&dress./");
ds_map_add(global.text_data_en, "obj_adate_172", "\E1S\M0he's got a great&sense of.../");
ds_map_add(global.text_data_en, "obj_adate_173", "\E0Um^1, anyway^1!&Let's do this thing!/%%");
ds_map_add(global.text_data_en, "obj_adate_186", "        DATING^3  START^3.%%");
ds_map_add(global.text_data_en, "obj_adate_199", "H-h-hey^1, w-w-wait!/");
ds_map_add(global.text_data_en, "obj_adate_200", "Actually^1, we still&can't start the&date yet!!!/%%");
ds_map_add(global.text_data_en, "obj_adate_209", "        DATING..^1.  STOP^4?%%");
ds_map_add(global.text_data_en, "obj_adate_221", "Umm^1, I've gotta give&you items to raise&your affection&statistic^1, first!/");
ds_map_add(global.text_data_en, "obj_adate_222", "That'll increase the&chance of a successful&outcome to the&date!/");
ds_map_add(global.text_data_en, "obj_adate_223", "\E6Right...?/");
ds_map_add(global.text_data_en, "obj_adate_224", "\E0Anyway^1, d-don't worry^1!&I'm prepared!/");
ds_map_add(global.text_data_en, "obj_adate_225", "\E5I-I've been&stockpiling gifts&in anticipation&for a date like this!/");
ds_map_add(global.text_data_en, "obj_adate_226", "\E7F\M6-first^1, I've got.../");
ds_map_add(global.text_data_en, "obj_adate_227", "\E5Some metal armor&polish!/");
ds_map_add(global.text_data_en, "obj_adate_228", "\E3.../");
ds_map_add(global.text_data_en, "obj_adate_229", "\E6Um^1, maybe you can't&use that./");
ds_map_add(global.text_data_en, "obj_adate_230", "\E5But!!!/");
ds_map_add(global.text_data_en, "obj_adate_231", "I also brought some&waterproof cream for&your scales!/");
ds_map_add(global.text_data_en, "obj_adate_232", "\E3Your^1, uh..^1.&Scales.../");
ds_map_add(global.text_data_en, "obj_adate_233", "\E6Uh^1, well^1, how about.../");
ds_map_add(global.text_data_en, "obj_adate_234", "This magical spear&repair kit^1, that I.../");
ds_map_add(global.text_data_en, "obj_adate_235", "\E7Um.../");
ds_map_add(global.text_data_en, "obj_adate_236", "\E5Hey^1, let's forget&about the items!/");
ds_map_add(global.text_data_en, "obj_adate_237", "\E0L\M0et's just start&the date!/%%");
ds_map_add(global.text_data_en, "obj_adate_301", "        DATING!^1!  START!^3!%%");
ds_map_add(global.text_data_en, "obj_adate_314", "Yeah!!^1!&Let's^1, uh^1, date!/%%");
ds_map_add(global.text_data_en, "obj_adate_352", "... uh.../");
ds_map_add(global.text_data_en, "obj_adate_353", "\E4Do you..^3. like..^3.&Anime...^2?/*");
ds_map_add(global.text_data_en, "obj_adate_367", "                              &   Yes             No       &                            ");
ds_map_add(global.text_data_en, "obj_adate_391", "H-hey^1!&Me too!!/%%");
ds_map_add(global.text_data_en, "obj_adate_396", "Oh./%%");
ds_map_add(global.text_data_en, "obj_adate_414", "Hey^1!&Let's!^1!&Go somewhere!!!/");
ds_map_add(global.text_data_en, "obj_adate_415", "\E7But where's a good&place to go on&a date...?/");
ds_map_add(global.text_data_en, "obj_adate_416", "\E2.../");
ds_map_add(global.text_data_en, "obj_adate_417", "\E0I've got it!!!/");
ds_map_add(global.text_data_en, "obj_adate_418", "\E5Let's go to the&garbage dump!!!/%%");
ds_map_add(global.text_data_en, "obj_adate_476", "Here we are!/");
ds_map_add(global.text_data_en, "obj_adate_477", "This is where Undyne&and I come all&the time.../");
ds_map_add(global.text_data_en, "obj_adate_478", "\E1We find all sorts&of great stuff&here./");
ds_map_add(global.text_data_en, "obj_adate_479", "\E5Heh^1, she's&really.../");
ds_map_add(global.text_data_en, "obj_adate_480", "\E6Uh.../%%");
ds_map_add(global.text_data_en, "obj_adate_503", "Oh no./");
ds_map_add(global.text_data_en, "obj_adate_504", "\E9That's her over&there./");
ds_map_add(global.text_data_en, "obj_adate_505", "\M4I c-can't let her&see me on a date&with you!/");
ds_map_add(global.text_data_en, "obj_adate_506", "\E6Why...?/");
ds_map_add(global.text_data_en, "obj_adate_507", "\M0Because^1, uh..^1.&Well.../");
ds_map_add(global.text_data_en, "obj_adate_508", "\E9Oh no^1, here she&comes!!/%%");
ds_map_add(global.text_data_en, "obj_adate_556", " Hey!^1!& There you are!!/");
ds_map_add(global.text_data_en, "obj_adate_557", "\F2 I^1, uh^1, realized^1,& if you deliver that&  thing.../");
ds_map_add(global.text_data_en, "obj_adate_558", "\F3 It might be a bad& idea./");
ds_map_add(global.text_data_en, "obj_adate_559", "\F4 So I'm gonna do& it!!^1!& Give it to me!!!/");
ds_map_add(global.text_data_en, "obj_adate_560", "\F3 Huh!^1?& You don't have it!?/");
ds_map_add(global.text_data_en, "obj_adate_561", "\F4 Ngggaaahhh!!/");
ds_map_add(global.text_data_en, "obj_adate_562", " Have you at least& seen her!?/*");
ds_map_add(global.text_data_en, "obj_adate_576", "                              &   Yeah            Nope     &                            ");
ds_map_add(global.text_data_en, "obj_adate_602", " Yes?/");
ds_map_add(global.text_data_en, "obj_adate_603", "\F6 So she's somewhere& around here.../");
ds_map_add(global.text_data_en, "obj_adate_604", "\F0 Thanks^1.& I'll keep looking./%%");
ds_map_add(global.text_data_en, "obj_adate_609", " No???/");
ds_map_add(global.text_data_en, "obj_adate_610", " But she wasn't& at home.../");
ds_map_add(global.text_data_en, "obj_adate_611", "\F3 Where the heck& could she be!?/%%");
ds_map_add(global.text_data_en, "obj_adate_669", "\E2Oh my god.../");
ds_map_add(global.text_data_en, "obj_adate_670", "\E6W... well^1, I guess&it's obvious^1, huh?/");
ds_map_add(global.text_data_en, "obj_adate_671", "\E7I...^1 uh..^1.&I really like her./");
ds_map_add(global.text_data_en, "obj_adate_672", "\E9I mean^1, more than&I like other people!/");
ds_map_add(global.text_data_en, "obj_adate_673", "\E7I'm sorry./");
ds_map_add(global.text_data_en, "obj_adate_674", "\E6I j-just figured^1,&y-you know.../");
ds_map_add(global.text_data_en, "obj_adate_675", "\E7It'd be f-fun to&go on like^1, a cute^1,&kind of.../");
ds_map_add(global.text_data_en, "obj_adate_676", "\E6P\M3retend date with you^1?&T-to make you feel&better?/");
ds_map_add(global.text_data_en, "obj_adate_677", "\E7.../");
ds_map_add(global.text_data_en, "obj_adate_678", "\E6Well^1, it sounds even&worse when I put it&like that./");
ds_map_add(global.text_data_en, "obj_adate_679", "\E8I\M0'm sorry^1.&I messed up again./");
ds_map_add(global.text_data_en, "obj_adate_680", "\E7Undyne's the person I..^1.&Um..^1. really want to&go on a date with./");
ds_map_add(global.text_data_en, "obj_adate_681", "But, I mean..^1.&She's way out of&my league./");
ds_map_add(global.text_data_en, "obj_adate_682", "\E9N-not that you&aren't^1, um^1, cool!/");
ds_map_add(global.text_data_en, "obj_adate_683", "\E7B-but..^1. Undyne.../");
ds_map_add(global.text_data_en, "obj_adate_684", "She's so confident..^1.&And strong..^1.&And funny.../");
ds_map_add(global.text_data_en, "obj_adate_685", "\E8And I'm just a&nobody./");
ds_map_add(global.text_data_en, "obj_adate_686", "\M3A fraud./");
ds_map_add(global.text_data_en, "obj_adate_687", "I'm the royal&scientist^1, but.../");
ds_map_add(global.text_data_en, "obj_adate_688", "\M0All I've ever done&is hurt people./");
ds_map_add(global.text_data_en, "obj_adate_689", "\E7I've told her so&many lies^1, she thinks&I'm.../");
ds_map_add(global.text_data_en, "obj_adate_690", "\E6She thinks I'm a&lot cooler than I&actually am./");
ds_map_add(global.text_data_en, "obj_adate_691", "\E7If she gets close&to me^1, she'll.../");
ds_map_add(global.text_data_en, "obj_adate_692", "\E8She'll find out the&truth about me./");
ds_map_add(global.text_data_en, "obj_adate_693", "\E7.../");
ds_map_add(global.text_data_en, "obj_adate_694", "\E7What should I do?/*");
ds_map_add(global.text_data_en, "obj_adate_708", "                              &   Tell her        Keep     &   the truth       lying    ");
ds_map_add(global.text_data_en, "obj_adate_732", "\E9The truth...?/");
ds_map_add(global.text_data_en, "obj_adate_733", "\M4But if I tell her&that^1, she'll hate&me./");
ds_map_add(global.text_data_en, "obj_adate_734", "\E6I\M0sn't it better&this way?/");
ds_map_add(global.text_data_en, "obj_adate_735", "To live a lie where&both people are&happy.../");
ds_map_add(global.text_data_en, "obj_adate_736", "\E7Or a truth where&neither of us&are?/");
ds_map_add(global.text_data_en, "obj_adate_737", "They say \"be&yourself.\"/");ds_map_add(global.text_data_en, "obj_adate_738", "\E8But I don't&really like who&\"myself\" is./");ds_map_add(global.text_data_en, "obj_adate_739", "\E7I'd rather just&be whatever makes&people like me./");
ds_map_add(global.text_data_en, "obj_adate_740", "\E6Eheheh.../");
ds_map_add(global.text_data_en, "obj_adate_741", "\E7.../");
ds_map_add(global.text_data_en, "obj_adate_742", "\E8.../");
ds_map_add(global.text_data_en, "obj_adate_743", "No, you're right./");
ds_map_add(global.text_data_en, "obj_adate_744", "Every day I'm&scared.../");
ds_map_add(global.text_data_en, "obj_adate_745", "\E7Scared what will&happen if people&learn the truth&on their own./");
ds_map_add(global.text_data_en, "obj_adate_746", "\M3They'll all get&hurt because of&me.../");
ds_map_add(global.text_data_en, "obj_adate_747", "\E9B\M4ut how can I&tell UNDYNE the&tr..^1. truth?/");
ds_map_add(global.text_data_en, "obj_adate_748", "\E8I d-don't have the&confidence.../");
ds_map_add(global.text_data_en, "obj_adate_749", "\E9I'm going to mess&it up^1!&How can I&practice!?/%%");
ds_map_add(global.text_data_en, "obj_adate_755", "Yeah..^1. yeah^1, you're&right!/");
ds_map_add(global.text_data_en, "obj_adate_756", "\E6I\M0've come this far^1,&I c-can't tell&her now!/");
ds_map_add(global.text_data_en, "obj_adate_757", "\E7Sh-she'd be really&hurt if she found&out^1, right?/");
ds_map_add(global.text_data_en, "obj_adate_758", "\E5S-so it'll just&be^1, uh^1, a little&secret!/");
ds_map_add(global.text_data_en, "obj_adate_759", "\M1What people don't&know can't hurt&them!!/");
ds_map_add(global.text_data_en, "obj_adate_760", "\M0Th-thank God I've&got an honest&friend like you!!/");
ds_map_add(global.text_data_en, "obj_adate_761", ".../");
ds_map_add(global.text_data_en, "obj_adate_762", "\E3.../");
ds_map_add(global.text_data_en, "obj_adate_763", "\M1B..^1. but what if she&finds out on her&own^1, somehow?/");
ds_map_add(global.text_data_en, "obj_adate_764", "\E7O\M0r if I ever&m-mess up.../");
ds_map_add(global.text_data_en, "obj_adate_765", "\M4Sh-she'd find out&the truth^1, and.../");
ds_map_add(global.text_data_en, "obj_adate_766", "\E8Pr-probably be even&more hurt than if&I told her myself./");
ds_map_add(global.text_data_en, "obj_adate_767", "\E6N\M0-not to mention^1,&l-lying so far..^1.&h..^1. has.../");
ds_map_add(global.text_data_en, "obj_adate_768", "\E8Been really&stressful^1, and scary./");
ds_map_add(global.text_data_en, "obj_adate_769", "\E3.../");
ds_map_add(global.text_data_en, "obj_adate_770", "\E4I think I'm going&to have to tell&her the truth./");
ds_map_add(global.text_data_en, "obj_adate_771", "\E9B-but how!?/");
ds_map_add(global.text_data_en, "obj_adate_772", "\E8I..^1. I don't have&the confidence.../");
ds_map_add(global.text_data_en, "obj_adate_773", "\E7How am I supposed&to practice&something like that!?/%%");
ds_map_add(global.text_data_en, "obj_adate_794", "   Let's           Obviously&   Roleplay        Let's    &   It              Roleplay");
ds_map_add(global.text_data_en, "obj_adate_827", "\E4R..^1. roleplay?/");
ds_map_add(global.text_data_en, "obj_adate_828", "\E3.../");
ds_map_add(global.text_data_en, "obj_adate_829", "\E5.\M1.. That actually&sounds kind of&fun!/");
ds_map_add(global.text_data_en, "obj_adate_830", "\M0OK^1, which one of&us will be Undyne?/*");
ds_map_add(global.text_data_en, "obj_adate_844", "                              &   I'll be         You'll be&   Undyne          Undyne   ");
ds_map_add(global.text_data_en, "obj_adate_868", "Oh^1. Right^1.&Obviously^1.&Ehehe./");
ds_map_add(global.text_data_en, "obj_adate_869", "\E2A\M1hem./");
ds_map_add(global.text_data_en, "obj_adate_870", "\E0H-hi\M3 Undyne..^1.&H-how are you doing&today?/*");
ds_map_add(global.text_data_en, "obj_adate_884", "                              &   I'm fine.       YOur &                      cute, ");
ds_map_add(global.text_data_en, "obj_adate_907", "\E5Ha^1! Ha^1!&Glad to hear it!!/");
ds_map_add(global.text_data_en, "obj_adate_908", "\E3.../");
ds_map_add(global.text_data_en, "obj_adate_909", "\E4Uhhh^1, so I'd like&to^1, um^1, talk to&you about&something./%%");
ds_map_add(global.text_data_en, "obj_adate_913", "\E5Th..^1. thanks!/");
ds_map_add(global.text_data_en, "obj_adate_914", "\E6You say that to me&a lot^1, and I&never know what&to say!!/");
ds_map_add(global.text_data_en, "obj_adate_915", "\E6But I know^1, you just^1,&mean it platonically^1,&because we're just&friends!/");
ds_map_add(global.text_data_en, "obj_adate_916", "\M1Eheheh!!!/");
ds_map_add(global.text_data_en, "obj_adate_917", "\E3.../");
ds_map_add(global.text_data_en, "obj_adate_918", "\E4Uhhh^1, so I'd like&to^1, um^1, talk to&you about&something./%%");
ds_map_add(global.text_data_en, "obj_adate_941", "                              &   What is it,     THEN SHe&   Alphys.         Kisses YOu");
ds_map_add(global.text_data_en, "obj_adate_963", "\E3Umm, you see..^1.&I..^1. I.../");
ds_map_add(global.text_data_en, "obj_adate_964", "\M3I..^1. I h-haven't been&exactly truthful&w-w-with you.../");
ds_map_add(global.text_data_en, "obj_adate_965", "\E4Y\M4..^1. you see^1, I..^1. I.../");
ds_map_add(global.text_data_en, "obj_adate_966", "\E9Oh^1, forget it!/");
ds_map_add(global.text_data_en, "obj_adate_967", "\M0Undyne!!!/");
ds_map_add(global.text_data_en, "obj_adate_968", "I..^1. I want to&tell you how I&feel!/");
ds_map_add(global.text_data_en, "obj_adate_969", "\M4Y-you're so brave^1,&a-and s-strong..^1.&A-and nice.../");
ds_map_add(global.text_data_en, "obj_adate_970", "Y-you always listen&t-to me when I talk&about n-n-nerdy&stuff.../");
ds_map_add(global.text_data_en, "obj_adate_971", "\E0Y-you always d-d-do&your best to m-make&me f-f-feel&special.../");
ds_map_add(global.text_data_en, "obj_adate_972", "\E3L-like t-telling me&that y-you'll b-beat&up anyone that&g-gets in my way.../%%");
ds_map_add(global.text_data_en, "obj_adate_976", "\E9WH-WHAT!?/");
ds_map_add(global.text_data_en, "obj_adate_977", "\M1UNDYNE WOULD NEVER^1,&UH..../");
ds_map_add(global.text_data_en, "obj_adate_978", "\E3.../");
ds_map_add(global.text_data_en, "obj_adate_979", "\M0.../");
ds_map_add(global.text_data_en, "obj_adate_980", "\E4I kiss her back..^1.&S..^1. softly.../");
ds_map_add(global.text_data_en, "obj_adate_981", "\M4I..^1. l-look gently&into her eyes.../%%");
ds_map_add(global.text_data_en, "obj_adate_997", "UNDYNE!!!/");
ds_map_add(global.text_data_en, "obj_adate_998", "I CAN'T TAKE THIS&ANY LONGER!!!/");
ds_map_add(global.text_data_en, "obj_adate_999", "I'M MADLY IN LOVE&WITH YOU!!!/");
ds_map_add(global.text_data_en, "obj_adate_1000", "HOLD ME^1, UNDYNE!^1!&HOLD ME!!!/%%");
ds_map_add(global.text_data_en, "obj_adate_1006", "I START HOLLERING!!/");
ds_map_add(global.text_data_en, "obj_adate_1007", "UNDYNE!!!^1!&I LOVE YOU!!!/");
ds_map_add(global.text_data_en, "obj_adate_1008", "UNDYNE!!^1!&KISS ME AGAIN^1,&UNDYNE!!!/%%");
ds_map_add(global.text_data_en, "obj_adate_1023", "\E9M\M0-m-me^1?&Undyne???/");
ds_map_add(global.text_data_en, "obj_adate_1024", "\E7Uh^1, uh^1, uh^1, uh^1,&ok!/");
ds_map_add(global.text_data_en, "obj_adate_1025", "\E6I'll say what I&think she'd say^1,&and you..^1. ummm..../");
ds_map_add(global.text_data_en, "obj_adate_1026", "\E5You show me what&I'm supposed to do!/");
ds_map_add(global.text_data_en, "obj_adate_1027", "\E2*\M1ahem*/");
ds_map_add(global.text_data_en, "obj_adate_1028", "\E0N\M2gahhhh!!^1!&Hey^1, Alphys!&You look cute&today!/");
ds_map_add(global.text_data_en, "obj_adate_1029", "\E5Which I say often^1!&But platonically&because I would&NEVER like you./*");
ds_map_add(global.text_data_en, "obj_adate_1043", "   Hi Undyne!      Yo your&   Can we          one hot&   talk?           hotbaby");
ds_map_add(global.text_data_en, "obj_adate_1069", "Talk^1, to you^1?&Hmmm..^1.&I guess so./");
ds_map_add(global.text_data_en, "obj_adate_1070", "I often seem&excited to listen&to you for some&reason./");
ds_map_add(global.text_data_en, "obj_adate_1071", "\E4I will make intent&eye contact with you&so you sweat while&you talk./");
ds_map_add(global.text_data_en, "obj_adate_1072", "\E0So^1, what is it?/%%");
ds_map_add(global.text_data_en, "obj_adate_1078", "What!^1?&A... alphys!?/");
ds_map_add(global.text_data_en, "obj_adate_1079", "What's gotten into&you!?/");
ds_map_add(global.text_data_en, "obj_adate_1080", "\E9H\M2-hotbaby!^1?&How dare you call&me that!?/");
ds_map_add(global.text_data_en, "obj_adate_1081", "\E5First off^1, I'm a&baby KNIGHT!/");
ds_map_add(global.text_data_en, "obj_adate_1082", "Captain of the&babies!!!/");
ds_map_add(global.text_data_en, "obj_adate_1083", "Treat my position&with respect^1, or I&will strike you&down!/");
ds_map_add(global.text_data_en, "obj_adate_1084", "\M3Uh^1, now pretend&I'm suplexing a&boulder for no&reason./");
ds_map_add(global.text_data_en, "obj_adate_1085", "\E9U\M0m^1! Anyway^1!&What do you&want to say^1,&Alphys!?/%%");
ds_map_add(global.text_data_en, "obj_adate_1108", "   Let's tell      Alphys&   Undyne the      gives u&   truth           a kiss,");
ds_map_add(global.text_data_en, "obj_adate_1132", "What!?/");
ds_map_add(global.text_data_en, "obj_adate_1133", "So you've been&lying to me the&whole time.../");
ds_map_add(global.text_data_en, "obj_adate_1134", "\E7Alphys!!^1!&I can't believe you!/");
ds_map_add(global.text_data_en, "obj_adate_1135", "\E8You w-worthless&slime!/");
ds_map_add(global.text_data_en, "obj_adate_1136", "\E9How could you&betray our&friendship!!/");
ds_map_add(global.text_data_en, "obj_adate_1137", "\E8After how much I&trusted you!!!/%%");
ds_map_add(global.text_data_en, "obj_adate_1143", "WH-WHAT!^1?&I WOULD NEVER.../");
ds_map_add(global.text_data_en, "obj_adate_1144", "\M0Alphys^1!&What are you&d-doing!/");
ds_map_add(global.text_data_en, "obj_adate_1145", "I s-say^1, pushing&you away from&me.../");
ds_map_add(global.text_data_en, "obj_adate_1146", "\E3You sh-shouldn't&k-kiss me...!!/");
ds_map_add(global.text_data_en, "obj_adate_1147", "\E3.../");
ds_map_add(global.text_data_en, "obj_adate_1148", "\E4.../");
ds_map_add(global.text_data_en, "obj_adate_1149", "\E3B-but^1, y-you're so&good at it.../");
ds_map_add(global.text_data_en, "obj_adate_1150", "\E5B-b-b-because of what&you learned from&th-those d-d-dating&video games.../");
ds_map_add(global.text_data_en, "obj_adate_1151", "I...^1.&I c-c-can't help but&k-k-kiss you back.../%%");
ds_map_add(global.text_data_en, "obj_adate_1167", "ALPHYS^1!&I'LL NEVER LOVE YOU!/");
ds_map_add(global.text_data_en, "obj_adate_1168", "NEVER WILL YOU FEEL&MY PASSIONATE&EMBRACE!!!/");
ds_map_add(global.text_data_en, "obj_adate_1169", "I^1, UNDYNE^1, WILL&NEVER KISS YOU&WITH MY BEAUTIFUL&LIPS!!!/%%");
ds_map_add(global.text_data_en, "obj_adate_1176", "NGAHHHH!!^1!&NGAHHH!!!!/");
ds_map_add(global.text_data_en, "obj_adate_1177", "I'M UNDYNE AND I'M&PILING ON THE&SMOOCHES!!!/%%");
ds_map_add(global.text_data_en, "obj_adate_1236", "WHAT did you just&say?/%%");
ds_map_add(global.text_data_en, "obj_adate_1259", "\E1U..^1. Undyne^1!&I..^1. was..^1. just.../%%");
ds_map_add(global.text_data_en, "obj_adate_1271", "\F6Hey^1, woah^1, wait&a second!/");
ds_map_add(global.text_data_en, "obj_adate_1272", "Your outfit's really&cute^1!&What's the occasion?/");
ds_map_add(global.text_data_en, "obj_adate_1273", "\F0.\E0../");
ds_map_add(global.text_data_en, "obj_adate_1274", "\F2W\E1ait a second./");
ds_map_add(global.text_data_en, "obj_adate_1275", "\F1Are you two.../");
ds_map_add(global.text_data_en, "obj_adate_1276", "\F3On a date?/%%");
ds_map_add(global.text_data_en, "obj_adate_1287", "\E1UHHH^1, \F4YES!/");
ds_map_add(global.text_data_en, "obj_adate_1288", "\E7I mean^1, \F5UHHH NO!/");
ds_map_add(global.text_data_en, "obj_adate_1289", "\E3I mean^1, \F7we were^1,& bu^1t%");
ds_map_add(global.text_data_en, "obj_adate_1290", "\E1I mean^1, actually we&were \F3only romantically&roleplaying as you!/%%");
ds_map_add(global.text_data_en, "obj_adate_1300", "\F3WHAT???/%%");
ds_map_add(global.text_data_en, "obj_adate_1311", "\E8I MEAN!!!/");
ds_map_add(global.text_data_en, "obj_adate_1312", "\E3I mean.../");
ds_map_add(global.text_data_en, "obj_adate_1313", "Undyne..^1.&I.../%%");
ds_map_add(global.text_data_en, "obj_adate_1326", "\F4I've been lying to&you!/%%");
ds_map_add(global.text_data_en, "obj_adate_1336", "\F3WHAT??^1?&ABOUT WHAT???/%%");
ds_map_add(global.text_data_en, "obj_adate_1349", "About... well.../");
ds_map_add(global.text_data_en, "obj_adate_1350", "\E2Everything!/%%");
ds_map_add(global.text_data_en, "obj_adate_1366", "\E7I told you that&seaweed was like...&scientifically&important...%");
ds_map_add(global.text_data_en, "obj_adate_1367", "\F5Really, I just...&I just use it to&make ice cream^1!%%");
ds_map_add(global.text_data_en, "obj_adate_1383", "And those human&history books I&keep reading...%");
ds_map_add(global.text_data_en, "obj_adate_1384", "\F7Those are just&dorky comic books^1!%%");
ds_map_add(global.text_data_en, "obj_adate_1400", "And the history&movies..^1.&those..^2.%");
ds_map_add(global.text_data_en, "obj_adate_1401", "\F2Those are just^1, uh^1,&anime^2!&They aren't real^2!%%");
ds_map_add(global.text_data_en, "obj_adate_1417", "And that time I&told you I was&busy with work on&the phone..^1. I...%");
ds_map_add(global.text_data_en, "obj_adate_1418", "\F9Was just eating&frozen yogurt in&my pajamas!%");
ds_map_add(global.text_data_en, "obj_adate_1419", "\E3That time I...%%");
ds_map_add(global.text_data_en, "obj_adate_1433", "Alphys./%%");
ds_map_add(global.text_data_en, "obj_adate_1444", "\E5I..^1. I just wanted to&impress you!/");
ds_map_add(global.text_data_en, "obj_adate_1445", "I just wanted you&to think I was&smart and cool./");
ds_map_add(global.text_data_en, "obj_adate_1446", "That I wasn't&some..^1.&nerdy loser./%%");
ds_map_add(global.text_data_en, "obj_adate_1459", "Alphys./%%");
ds_map_add(global.text_data_en, "obj_adate_1470", "\E5Undyne^1, I..^1.&I really think you're&neat^1, OK.../%%");
ds_map_add(global.text_data_en, "obj_adate_1481", "Alphys./");
ds_map_add(global.text_data_en, "obj_adate_1482", "Shhhh./");
ds_map_add(global.text_data_en, "obj_adate_1483", "Shhhhhh./%%");
ds_map_add(global.text_data_en, "obj_adate_1522", "\F0Alphys!/");
ds_map_add(global.text_data_en, "obj_adate_1523", "I..^1. think you're&neat^1, too, I guess./");
ds_map_add(global.text_data_en, "obj_adate_1524", "\F1But, you've gotta&realize.../");
ds_map_add(global.text_data_en, "obj_adate_1525", "\F2Most of what you&said really doesn't&matter to me./");
ds_map_add(global.text_data_en, "obj_adate_1526", "I don't care if&you're watching kid&cartoons or reading&history books./");
ds_map_add(global.text_data_en, "obj_adate_1527", "\F3To me^1, ALL of&that stuff is&just NERDY CRAP!/");
ds_map_add(global.text_data_en, "obj_adate_1528", "What I like about&you is that you're&PASSIONATE^1!&You're ANALYTICAL!!/");
ds_map_add(global.text_data_en, "obj_adate_1529", "It doesn't matter&what it is^1!&YOU CARE ABOUT IT!!/");
ds_map_add(global.text_data_en, "obj_adate_1530", "\F4100-PERCENT!^1!&AT MAXIMUM POWER!!!/");
ds_map_add(global.text_data_en, "obj_adate_1531", "\F5... so^1, you don't&have to lie to me./");
ds_map_add(global.text_data_en, "obj_adate_1532", "\F0I don't want you&to have to lie to&anyone anymore./");
ds_map_add(global.text_data_en, "obj_adate_1533", "\F6Alphys..^1. I want to&help you become&happy with who&you are!/");
ds_map_add(global.text_data_en, "obj_adate_1534", "\F5And I know just&the training you&need to do that!/%%");
ds_map_add(global.text_data_en, "obj_adate_1566", "Undyne..^1.&You.../");
ds_map_add(global.text_data_en, "obj_adate_1567", "\E4Y-you're gonna train&me...?/%%");
ds_map_add(global.text_data_en, "obj_adate_1574", "\F2Pffft^1, what^1?&ME?/%%");
ds_map_add(global.text_data_en, "obj_adate_1594", "\F6Nah^1, I'm gonna&get Papyrus to&do it./%%");
ds_map_add(global.text_data_en, "obj_adate_1612", "GET THOSE BONES&SHAKIN'!!!/");
ds_map_add(global.text_data_en, "obj_adate_1613", "IT'S TIME TO JOG&100 LAPS^1, HOOTING&ABOUT HOW GREAT&WE ARE!!!/%%");
ds_map_add(global.text_data_en, "obj_adate_1622", "Ready^1?&I'm about to start&the timer!/%%");
ds_map_add(global.text_data_en, "obj_adate_1636", "\E5 & &    U-Undyne.../");
ds_map_add(global.text_data_en, "obj_adate_1637", "\E1 & &    I'll do my&    best...!/%%");
ds_map_add(global.text_data_en, "obj_adate_1659", "\F3OH MY GOD!!!/");
ds_map_add(global.text_data_en, "obj_adate_1660", "\F5She was kidding^1,&right!? /");
ds_map_add(global.text_data_en, "obj_adate_1661", "Those cartoons..^1.&those comics.../");
ds_map_add(global.text_data_en, "obj_adate_1662", "\F7Those are still&REAL^1, right!?/");
ds_map_add(global.text_data_en, "obj_adate_1663", "\F8ANIME'S REAL^1,&RIGHT?!?!/%%");
ds_map_add(global.text_data_en, "obj_adate_1688", "   Anime is        Anime &   Real            is not &                   real");
ds_map_add(global.text_data_en, "obj_adate_1708", "HA HA HA!!!/");
ds_map_add(global.text_data_en, "obj_adate_1709", "I KNEW IT!!!/");
ds_map_add(global.text_data_en, "obj_adate_1710", "GIGANTIC SWORDS!!^1!&MAGICAL PRINCESSES^1!&HERE I COME!!!/%%");
ds_map_add(global.text_data_en, "obj_adate_1714", "\F3No..^1. NO!!!!/");
ds_map_add(global.text_data_en, "obj_adate_1715", "I CAN FEEL MY&HEART BREAKING&INTO PIECES!!!/%%");
ds_map_add(global.text_data_en, "obj_adate_1736", "\F6.../");
ds_map_add(global.text_data_en, "obj_adate_1737", "Uhh^1, thanks for&taking care of&Alphys./");
ds_map_add(global.text_data_en, "obj_adate_1738", "\F9I didn't get to&say what I wanted&to^1, but.../");
ds_map_add(global.text_data_en, "obj_adate_1739", "\F0Things seem like&they're going to get&better for her./");
ds_map_add(global.text_data_en, "obj_adate_1740", "\F6Well^1, I gotta go&catch up with&them!/");
ds_map_add(global.text_data_en, "obj_adate_1741", "Later!/%%");
ds_map_add(global.text_data_en, "obj_adate_1745", "\F3.../");
ds_map_add(global.text_data_en, "obj_adate_1746", "\F5... no^1, I can&survive this.../");
ds_map_add(global.text_data_en, "obj_adate_1747", "\F3I have to be strong./");
ds_map_add(global.text_data_en, "obj_adate_1748", "\F9For Alphys./");
ds_map_add(global.text_data_en, "obj_adate_1749", "\F0Thank you^1, human^1,&for telling me&the truth./");
ds_map_add(global.text_data_en, "obj_adate_1750", "\F9I'll try my best to&live in this&world.../");
ds_map_add(global.text_data_en, "obj_adate_1751", "\F0See you later!/%%");
ds_map_add(global.text_data_en, "obj_alabdoor_l_153", "* (There's no response.)/%%");
ds_map_add(global.text_data_en, "obj_alabdoor_l_207", "* (...)/");
ds_map_add(global.text_data_en, "obj_alabdoor_l_208", "* (O^1-oh n^1-no^1, is that another&  letter...?)/");
ds_map_add(global.text_data_en, "obj_alabdoor_l_209", "* (I don't want to open it...^1)&* (C-^1can't I just slide it&  back out...?)/");
ds_map_add(global.text_data_en, "obj_alabdoor_l_210", "* (...)/");
ds_map_add(global.text_data_en, "obj_alabdoor_l_211", "* (N..^1. no..^1. I can't keep doing&  this.^1)&* (I'll read this one.)/");
ds_map_add(global.text_data_en, "obj_alabdoor_l_212", "* (...)/");
ds_map_add(global.text_data_en, "obj_alabdoor_l_213", "* (Um...^1)&* (I-it's shut k-kind of&  strongly^1, isn't it?)/");
ds_map_add(global.text_data_en, "obj_alabdoor_l_214", "* (Wait a second...)/%%");
ds_map_add(global.text_data_en, "obj_alabdoor_l_252", "* Hey^1, if this is a&  joke^1, it's.../");
ds_map_add(global.text_data_en, "obj_alabdoor_l_253", "\E1* .../");
ds_map_add(global.text_data_en, "obj_alabdoor_l_254", "\E3* Oh My God?/");
ds_map_add(global.text_data_en, "obj_alabdoor_l_255", "\E5* Did YOU write this&  letter?/");
ds_map_add(global.text_data_en, "obj_alabdoor_l_256", "\E6* It wasn't signed^1, so^1,&  I had no idea who&  could have.../");
ds_map_add(global.text_data_en, "obj_alabdoor_l_257", "\E8* Oh my god^1.&* Oh no./");
ds_map_add(global.text_data_en, "obj_alabdoor_l_258", "\E7* That's adorable.../");
ds_map_add(global.text_data_en, "obj_alabdoor_l_259", "\E5* And I h-had no idea&  you^1, um^1, wrote that way!/");
ds_map_add(global.text_data_en, "obj_alabdoor_l_260", "\E9* It's surprising^1, too..^1.&* After all the gross&  stuff I did.../");
ds_map_add(global.text_data_en, "obj_alabdoor_l_261", "\E8* I don't really deserve&  to be forgiven./");
ds_map_add(global.text_data_en, "obj_alabdoor_l_262", "\E4* Much less^1, um.../");
ds_map_add(global.text_data_en, "obj_alabdoor_l_263", "\E5* This?/");
ds_map_add(global.text_data_en, "obj_alabdoor_l_264", "\E1* And so passionately^1,&  too./");
ds_map_add(global.text_data_en, "obj_alabdoor_l_265", "\E2* .../");
ds_map_add(global.text_data_en, "obj_alabdoor_l_266", "\E0* You know what^1, okay^1!&* I'll do it!/");
ds_map_add(global.text_data_en, "obj_alabdoor_l_267", "\E5* It's the least I can&  do to make it up&  to you!/");
ds_map_add(global.text_data_en, "obj_alabdoor_l_268", "\W*\E7 Y-yeah^1!&* \WLet's \Rgo on a date\W!/%%");
ds_map_add(global.text_data_en, "obj_alphys_friendc_81", "\E0* On second thought^1,&  maybe I WON'T write&  fanfic of real people./");
ds_map_add(global.text_data_en, "obj_alphys_friendc_82", "\E7* I mean^1, isn't real life&  already the greatest&  fanfiction of all?/");
ds_map_add(global.text_data_en, "obj_alphys_friendc_83", "\E8* .../");
ds_map_add(global.text_data_en, "obj_alphys_friendc_84", "\E3* Uh^1, don't tell&  anyone I said that./");
ds_map_add(global.text_data_en, "obj_alphys_friendc_85", "\E1* Cause I'm gonna&  post it online!/%%");
ds_map_add(global.text_data_en, "obj_alphys_friendc_90", "\E0* I sure am excited&  to finally use the&  human internet./");
ds_map_add(global.text_data_en, "obj_alphys_friendc_91", "\E7* I bet they have all&  sorts of things Undyne&  and I can watch!/");
ds_map_add(global.text_data_en, "obj_alphys_friendc_93", "\E6* Oh man!!!/");
ds_map_add(global.text_data_en, "obj_alphys_friendc_94", "* We're gonna be&  able to watch&  anime online!?/");
ds_map_add(global.text_data_en, "obj_alphys_friendc_96", "\E7* Of course^1, Undyne!/");
ds_map_add(global.text_data_en, "obj_alphys_friendc_97", "\E2* What do you think&  we've been fighting&  for all along?/");
ds_map_add(global.text_data_en, "obj_alphys_friendc_99", "\E2* yeah^1, what do you.../");
ds_map_add(global.text_data_en, "obj_alphys_friendc_100", "\E1* whoops./");
ds_map_add(global.text_data_en, "obj_alphys_friendc_102", "\E1* Jinx^1!&* I knew you were&  gonna make that joke!/");
ds_map_add(global.text_data_en, "obj_alphys_friendc_104", "\E3WAIT^1, ALPHYS, I&DIDN'T KNOW YOU&KNEW SANS./");
ds_map_add(global.text_data_en, "obj_alphys_friendc_106", "\E5* Well..^1.&* I.../");
ds_map_add(global.text_data_en, "obj_alphys_friendc_108", "\E2* doesn't everybody?/");
ds_map_add(global.text_data_en, "obj_alphys_friendc_110", "\E0* Who the hell is Sans?/");
ds_map_add(global.text_data_en, "obj_alphys_friendc_111", "\E8* .../");
ds_map_add(global.text_data_en, "obj_alphys_friendc_112", "\E0* Who the HECK is Sans?/");
ds_map_add(global.text_data_en, "obj_alphys_friendc_114", "\E1* TORIEL!?!?!/%%");
ds_map_add(global.text_data_en, "obj_alphys_friendc_119", "\E0* Hey Frisk^1, why&  don't you go look&  for Mettaton?/");
ds_map_add(global.text_data_en, "obj_alphys_friendc_120", "\E8* He was here for&  a while^1, too.../");
ds_map_add(global.text_data_en, "obj_alphys_friendc_121", "\E0* But he said he&  had to go somewhere./%%");
ds_map_add(global.text_data_en, "obj_alphys_npc_76", "* Th-that last&  question.../");
ds_map_add(global.text_data_en, "obj_alphys_npc_77", "\E4* He wasn't s-supposed&  to ask that one.../%%");
ds_map_add(global.text_data_en, "obj_alphys_npc_82", "* (Yellow feet are tapping&  just behind the door.)/%%");
ds_map_add(global.text_data_en, "obj_alphys_npc_91", "* I..^1. I just need&  a moment./%%");
ds_map_add(global.text_data_en, "obj_alphys_npc_99", "* .../%%");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_108", "* S..^1. Sorry about&  that!/");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_109", "\E5* L-let's k-keep&  going!/%%");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_148", "* S-so you're about&  to meet ASGORE^1,&  h-huh?/");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_149", "\E6* You must be..^1.&* Y-you must be.../");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_150", "\E5* Pr..^1. pretty&  excited about all&  that^1, huh?/%%");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_175", "* You'll f-f-finally.../");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_176", "\E7* You'll finally get&  to go home!/%%");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_206", "* W..^1.&* Wait!/%%");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_228", "* I mean^1, um..^1.&* I.../");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_229", "\E1* I was just going&  to..^1.&* ...um.../");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_230", "\E2* Say goodbye^1, and.../");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_231", "* .../");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_232", "\E3* .../");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_233", "\E4* .../");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_234", "* I can't take&  this anymore./%%");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_262", "* I.../");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_263", "\E5* I lied to you./");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_264", "\E7* A human SOUL isn't&  strong enough to&  cross the barrier alone./");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_265", "\E6* It takes at least&  a human soul.../");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_266", "\E5* And a monster&  soul./");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_267", "\E5* .../%%");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_295", "* If you want to&  go home.../");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_296", "\E5* You'll have to&  take his soul./");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_297", "\E7* You'll have to&  kill ASGORE./%%");
ds_map_add(global.text_data_en, "obj_alphysfollow_event_345", "* I'm sorry./%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_166", "* Oh^1.&* My god./%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_175", "* I didn't expect you&  to show up so&  soon!/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_176", "* I haven't showered^1, I'm&  barely dressed^1, it's&  all messy^1, and.../%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_224", "* Ummm.../");
ds_map_add(global.text_data_en, "obj_alphystrigger1_225", "* H-h-hiya!/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_226", "* I'm Dr. Alphys^1.&* I'm ASGORE's royal&  scientist!/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_227", "\E3* B-b-but^1, ahhhh^1,&  I'm not one of&  the \"bad guys\"!/");ds_map_add(global.text_data_en, "obj_alphystrigger1_228", "\E0* Actually^1, since you&  stepped out of the&  RUINS^1, I've^1, um.../");
ds_map_add(global.text_data_en, "obj_alphystrigger1_229", "\E7* ... been \"observing\"&  your journey through&  my console./");ds_map_add(global.text_data_en, "obj_alphystrigger1_230", "\E3* Your fights..^1.&* Your friendships..^1.&* Everything!/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_231", "\E0* I was originally&  going to stop&  you^1, but.../");
ds_map_add(global.text_data_en, "obj_alphystrigger1_236", "\E7* Watching someone on&  a screen really makes&  you root for them./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_237", "\E7* Watching you^1, I felt&  like..^1. like I was&  seeing an old friend./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_238", "\E0* S-so^1, ahhh^1, now I&  want to help you!/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_239", "\E6* Using my knowledge^1,&  I can easily guide&  you through Hotland!/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_240", "\E0* I know a way right&  to ASGORE's castle^1,&  no problem!/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_241", "\E2* .../");
ds_map_add(global.text_data_en, "obj_alphystrigger1_242", "\E7* Well^1, actually^1, umm^1,&  there's just a&  tiny issue./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_243", "\E0* A long time ago^1, I&  made a robot named&  Mettaton./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_244", "* Originally^1, I built&  him to be an&  entertainment robot./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_245", "\E7* Uh^1, you know^1, like&  a robotic TV star&  or something./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_246", "\E0* Anyway^1, recently I&  decided to make him&  more useful./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_247", "\E7* You know^1, just some&  small practical&  adjustments./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_248", "\E0* Like^1, um.../");
ds_map_add(global.text_data_en, "obj_alphystrigger1_249", "\E4* Anti..^1. anti-human&  combat features?/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_250", "\E6* Of c-course^1, when I&  saw you coming^1, I&  immediately decided.../");
ds_map_add(global.text_data_en, "obj_alphystrigger1_251", "\E3* I have to remove&  those features!/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_252", "\E4* Unfortunately^1, I may&  have made a teensy&  mistake while doing so./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_253", "* And^1, um.../");
ds_map_add(global.text_data_en, "obj_alphystrigger1_254", "\E5* Now he's an unstoppable&  killing machine with a&  thirst for human blood?/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_255", "* Ehehehehe.../");
ds_map_add(global.text_data_en, "obj_alphystrigger1_256", "\E8* Heh./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_257", "\E0* But^1, ummm^1, hopefully&  we won't run into&  him!/%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_288", "* ...?/%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_312", "* Did you hear&  something?/%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_344", "* Oh no./%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_393", "* OHHHH YES!/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_394", "* WELCOME^1, BEAUTIES.../%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_441", "\M1* ... TO TODAY'S QUIZ SHOW!!!/%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_468", "\M0* OH BOY^1!&* I CAN ALREADY TELL IT'S&  GONNA BE A GREAT SHOW!/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_469", "\M2* EVERYONE GIVE A BIG&  HAND FOR OUR WONDERFUL&  CONTESTANT!/%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_493", "\M0* NEVER PLAYED BEFORE^1,&  GORGEOUS?/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_494", "\M2* NO PROBLEM^1!&* IT'S SIMPLE!/");
ds_map_add(global.text_data_en, "obj_alphystrigger1_495", "\M4* THERE'S ONLY ONE&  RULE./");
ds_map_add(global.text_data_en, "obj_alphystrigger1_496", "* ANSWER CORRECTLY.../%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_514", "* OR YOU DIE!!!/%%");
ds_map_add(global.text_data_en, "obj_alphystrigger1_566", "* .../");
ds_map_add(global.text_data_en, "obj_alphystrigger1_567", "\E0* Well that was&  certainly something./%%");
ds_map_add(global.text_data_en, "obj_alphystrigger2_87", "* Wait^1, wait!/%%");
ds_map_add(global.text_data_en, "obj_alphystrigger2_146", "\E0* Let me give you my&  ph-phone number!/");
ds_map_add(global.text_data_en, "obj_alphystrigger2_147", "\E7* Th-then..^1. m-maybe..^1.&* If you need help^1,&  I could.../%%");
ds_map_add(global.text_data_en, "obj_alphystrigger2_169", "\E3* Wh..^1. where'd you get&  that phone!?&* It's ANCIENT!/");
ds_map_add(global.text_data_en, "obj_alphystrigger2_170", "\E1* It doesn't even have&  texting./");
ds_map_add(global.text_data_en, "obj_alphystrigger2_171", "\E3* W-wait a second^1,&  please!/%%");
ds_map_add(global.text_data_en, "obj_alphystrigger2_221", "\E0* Here^1, I upgraded it&  for you!/");
ds_map_add(global.text_data_en, "obj_alphystrigger2_222", "* It can do texting^1,&  items^1, it's got a&  key chain.../");
ds_map_add(global.text_data_en, "obj_alphystrigger2_223", "* I even signed you up&  for the underground's&  No. 1 social network!/");
ds_map_add(global.text_data_en, "obj_alphystrigger2_224", "\E7* Now we're officially&  friends^1!&* Ehehehe!/");
ds_map_add(global.text_data_en, "obj_alphystrigger2_225", "\E0* Heheh.../");
ds_map_add(global.text_data_en, "obj_alphystrigger2_226", "\E0* Heh.../");
ds_map_add(global.text_data_en, "obj_alphystrigger2_227", "\E0* .../");
ds_map_add(global.text_data_en, "obj_alphystrigger2_228", "\E1* .../");
ds_map_add(global.text_data_en, "obj_alphystrigger2_229", "\E2* .../");
ds_map_add(global.text_data_en, "obj_alphystrigger2_230", "\E1* .../");
ds_map_add(global.text_data_en, "obj_alphystrigger2_231", "\E2* .../");
ds_map_add(global.text_data_en, "obj_alphystrigger2_232", "\E4* I'm going to the&  bathroom./%%");
ds_map_add(global.text_data_en, "obj_amalgam_fridge_99", "* (It's a refrigerator.^1)&* (It's empty.)/%%");
ds_map_add(global.text_data_en, "obj_amalgam_fridge_103", "* (It's some sort of cold^1,&  rectangular object.)/%%");
ds_map_add(global.text_data_en, "obj_amalgam_fridge_107", "* (You found a blue key on&  the ground.^1)&* (You put it on your keychain.)/%%");
ds_map_add(global.text_data_en, "obj_artclass_sign_208", "* Art Club: Meet here!&* Next meeting:&* October 10th 8PM/%%");
ds_map_add(global.text_data_en, "obj_artclass_sign_213", "* (Art club is cancelled!)/%%");
ds_map_add(global.text_data_en, "obj_artclass_sign_218", "* (Art is dead.)/%%");
ds_map_add(global.text_data_en, "obj_artclass_sign_224", "* Let's meet again someday!/%%");
ds_map_add(global.text_data_en, "obj_artclass_sign_231", "* Who knows what lies in the&  future for Art Club!?/%%");
ds_map_add(global.text_data_en, "obj_artclass_sign_281", "* Ahhhh!!^1!&* I'm late!!^1!&* I'm late!!!/");
ds_map_add(global.text_data_en, "obj_artclass_sign_282", "* I'm so sorry!!!/%%");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_178", "* (A strange light fills the&  room.^5)   %");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_179", "* (Twilight is shining through&  the barrier.^3)   %");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_180", "* (It seems your journey is&  finally over.^4)%");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_181", "     * (You're filled with&          DETERMINATION.^5) %%");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_213", "Human.../");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_214", "\E1It was&nice to&meet&you./");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_215", "\E0Goodbye./%%");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_220", "\E1Now,&now./");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_221", "There's&no need&to&fight./");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_222", "Why not&settle&this.../");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_223", "Over a&nice cup&of tea?/%%");
ds_map_add(global.text_data_en, "obj_asgore_finalintro_496", "* ASGORE attacks!");
ds_map_add(global.text_data_en, "obj_asgore_friendc_76", "\E0* Howdy^1, Frisk./");
ds_map_add(global.text_data_en, "obj_asgore_friendc_77", "\E3* Sorry about almost&  trying to take&  your SOUL./");
ds_map_add(global.text_data_en, "obj_asgore_friendc_78", "\E5* I feel very bad&  about it./");
ds_map_add(global.text_data_en, "obj_asgore_friendc_79", "\E0* I hope we can&  still be pals./");
ds_map_add(global.text_data_en, "obj_asgore_friendc_81", "\E0* Hey^1, don't worry&  about it^1, ASGORE./");
ds_map_add(global.text_data_en, "obj_asgore_friendc_82", "\E2* I think everybody's&  tried to kill Frisk&  at least once./");
ds_map_add(global.text_data_en, "obj_asgore_friendc_84", "\E2* Oh..^1. I see!/");
ds_map_add(global.text_data_en, "obj_asgore_friendc_85", "\E0* In that case^1, I'm&  not sorry^1, Frisk./");
ds_map_add(global.text_data_en, "obj_asgore_friendc_87", "\E6* ASGORE^1!&* That's not what I&  meant!/%%");
ds_map_add(global.text_data_en, "obj_asgore_friendc_97", "\E3* Oh^1, Frisk^1, if you're&  not busy.../");
ds_map_add(global.text_data_en, "obj_asgore_friendc_98", "\E0* On nice days^1, you&  should walk around and&  have a good time./");
ds_map_add(global.text_data_en, "obj_asgore_friendc_99", "\E0* That's important./%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_243", "Ah.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_244", ".../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_245", "So that&is how&it is./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_246", ".../%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_251", "\E3Why..^1.&You.../%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_275", "I remember the day&after my son&died./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_276", "The entire underground&was devoid of hope./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_277", "The future had once&again been taken&from us by the&humans./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_278", "In a fit of anger,&I declared war./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_279", "I said that I would&destroy any human&that came here./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_280", "I would use their&souls to become&godlike.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_281", "... and free us from&this terrible prison./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_282", "Then, I would destroy&humanity.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_283", "And let monsters rule&the surface, in peace./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_284", "Soon, the people's&hopes returned./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_285", "My wife, however,&became disgusted with&my actions./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_286", "She left this place,&never to be seen&again./%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_294", "Truthfully.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_295", "I do not want power./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_296", "I do not want to&hurt anyone./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_297", "I just wanted everyone&to have hope.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_298", "But.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_299", "I cannot take this&any longer./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_300", "I just want to&see my wife./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_301", "I just want to&see my child./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_302", "Please..^1.&Young one.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_303", "This war has gone&on long enough./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_304", "You have the power.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_305", "Take my soul, and&leave this cursed&place./%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_340", ".../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_341", "\E0After everything I&have done to&hurt you.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_342", "\E7You would rather&stay down here&and suffer.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_343", "\E9Than live happily&on the surface?/");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_344", "\E6.../%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_352", "\E1Human.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_353", "\E7I promise you.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_354", "\E7For as long as&you remain here.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_355", "\E1My wife and I will&take care of you&as best we can./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_356", "\E2We can sit in&the living room^1,&telling stories.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_357", "\E1Eating butterscotch&pie.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_358", "\E2We could be&like.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_359", "\E8Like a family.../%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_623", "You&IDIOT./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_627", "\[C]./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_628", "You&haven't&learned&a thing./%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_632", "Hee&hee&hee./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_633", "So you&finally&get it./%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_639", "\[C]./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_640", "So you&DO&recall./%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_651", "In&this&world.../%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_692", "It's KILL or BE killed^4.%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_769", "Hee hee hee^1.&Don't worry./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_770", "I know there's no&REAL point in&fighting you./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_771", "The human souls&would probably just&revolt again./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_772", "So...!/%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_778", "Hee hee hee^1./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_779", "Did you REALLY&think killing me&would make a&DIFFERENCE?/");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_780", "No./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_781", "Every time you&load your SAVE^1,&I'll come back./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_782", "And every time you&try to get a&happy ending.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_783", "I'll be there to&tear it away!/");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_784", "Ha ha ha!!!/%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_792", "Well^1, let's get&this over with./%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_796", ".../%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_831", "\E2.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_832", "\E0No^1.&That's just a&fantasy^1, isn't it?/");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_833", "\E1Young one^1, when I&look at you.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_834", "\E2I'm reminded of the&human that fell here&long ago.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_835", "\E8You have the same&feeling of hope in&your eyes./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_836", "\E7There is an ancient&prophecy among our&people.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_837", "One day^1, a savior&will come from the&heavens./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_838", "\E1... I believe the&one that was&prophecied was you./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_839", "Somewhere in the&world outside.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_840", "There must be a way&to free us from our&prison./");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_841", "\E0It pains me to&give you this&responsiblity^1, but.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_842", "\E0Please^1.&Take my soul..^1.&and seek the truth./%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_898", "\E0Ha... ha.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_899", "\E6I'm sorry.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_900", "I couldn't give you&a simple^1, happy&ending.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_901", "But I believe your&freedom.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_902", "... is what my son.../");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_903", "\E8... what ASRIEL would&have wanted./%%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_979", "See^1?&I never betrayed&you^2! %");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_980", "It was all a&trick, see^2? %");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_981", "I was waiting to&kill him for you^2! %");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_982", "\E1After all it's me&your best friend^2! %");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_983", "\E2I'm helpful, I can&be useful to you^1 %");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_984", "\E1I promise I won't&get in your way^1 %%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_995", "\E2I can help..^1.&I can..^1.&I can..^2. %%");
ds_map_add(global.text_data_en, "obj_asgore_lastcutscene_1006", "\E3Please don't&kill me./%%");
ds_map_add(global.text_data_en, "obj_asgore_prebarrier_event_78", "* How tense.../");
ds_map_add(global.text_data_en, "obj_asgore_prebarrier_event_79", "\E2* Just think of it like.../");
ds_map_add(global.text_data_en, "obj_asgore_prebarrier_event_80", "\E0* A visit to the dentist./%%");
ds_map_add(global.text_data_en, "obj_asgore_prebarrier_event_112", "* Are you ready?/");
ds_map_add(global.text_data_en, "obj_asgore_prebarrier_event_113", "\E3* If you are not^1, I&  understand./");
ds_map_add(global.text_data_en, "obj_asgore_prebarrier_event_114", "\E2* I am not ready either./%%");
ds_map_add(global.text_data_en, "obj_asgoreb_652", "* ...");
ds_map_add(global.text_data_en, "obj_asgoreb_658", "* Asgore has low HP.");
ds_map_add(global.text_data_en, "obj_asgoreb_692", "* ASGORE 80 ATK 80 DEF /^");
ds_map_add(global.text_data_en, "obj_asgoreb_705", "* But there was nothing to&  say./^");
ds_map_add(global.text_data_en, "obj_asgoreb_711", "* You quietly tell ASGORE&  you don't want to fight&  him./");
ds_map_add(global.text_data_en, "obj_asgoreb_712", "* His hands tremble for a&  moment./^");
ds_map_add(global.text_data_en, "obj_asgoreb_716", "* You tell ASGORE that you&  don't want to fight him./");
ds_map_add(global.text_data_en, "obj_asgoreb_717", "* His breathing gets funny&  for a moment./^");
ds_map_add(global.text_data_en, "obj_asgoreb_721", "* You firmly tell ASGORE to&  STOP fighting./");
ds_map_add(global.text_data_en, "obj_asgoreb_722", "* Recollection flashes in his&  eyes.../");
ds_map_add(global.text_data_en, "obj_asgoreb_723", "* ASGORE's ATTACK dropped^1!&* ASGORE's DEFENSE dropped!/^");
ds_map_add(global.text_data_en, "obj_asgoreb_729", "* Seems talking won't do any&  more good./^");
ds_map_add(global.text_data_en, "obj_asgoreb_731", "* All you can do is FIGHT./^");
ds_map_add(global.text_data_en, "obj_asgoreb_748", "* You tell ASGORE that he's&  killed you \[1]./");
ds_map_add(global.text_data_en, "obj_asgoreb_killcount_1", "once before");
ds_map_add(global.text_data_en, "obj_asgoreb_killcount_2", "twice before");
ds_map_add(global.text_data_en, "obj_asgoreb_killcount_3", "three times");
ds_map_add(global.text_data_en, "obj_asgoreb_killcount_4", "four times");
ds_map_add(global.text_data_en, "obj_asgoreb_killcount_5", "five times");
ds_map_add(global.text_data_en, "obj_asgoreb_killcount_6", "six times");
ds_map_add(global.text_data_en, "obj_asgoreb_killcount_7", "seven times");
ds_map_add(global.text_data_en, "obj_asgoreb_killcount_8", "eight times");
ds_map_add(global.text_data_en, "obj_asgoreb_killcount_9", "nine times");
ds_map_add(global.text_data_en, "obj_asgoreb_killcount_10", "too many times&  to count");
ds_map_add(global.text_data_en, "obj_asgoreb_749", "* He nods sadly./^");
ds_map_add(global.text_data_en, "obj_asgoreb_751", "* He nods grievously./^");
ds_map_add(global.text_data_en, "obj_asgoreb_753", "* He nods pitifully./^");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_131", "* Dum dee dum.../");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_132", "* Oh^1?&* Is someone there?/");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_133", "* Just a moment!/");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_134", "* I have almost finished watering&  these flowers./%%");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_138", "* Curious^1.&* I've never seen a plant..^1.&* Cry before./%%");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_162", "* ... Here we are!/%%");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_193", "* Howdy^1!&* How can I.../%%");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_224", "* Oh./%%");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_247", "\E3* .../");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_248", "\E2* I so badly want to&  say^1, \"would you like&  a cup of tea?\"/");ds_map_add(global.text_data_en, "obj_asgoremeet_event_249", "* But.../");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_250", "\E3* You know how it is./%%");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_289", "* Nice day today^1, huh?/");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_290", "* Birds are singing^1,&  flowers are blooming.../");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_291", "* Perfect weather for a&  game of catch./%%");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_313", "* .../");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_314", "* You know what we must&  do./");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_315", "* When you are ready^1,&  come into the next&  room./%%");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_369", "\E3* ... huh?/");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_370", "* You must be the one&  that flower just warned&  me about./");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_371", "\E0* Howdy!/");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_372", "* .../");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_373", "\E3* Erm..^1.&* What kind of monster&  are you...?/");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_374", "\E0* Sorry^1, I cannot tell./");
ds_map_add(global.text_data_en, "obj_asgoremeet_event_375", "* Well^1, we can always%%");
ds_map_add(global.text_data_en, "obj_asriel_overworldanim_174", "* I'm so sorry./%%");
ds_map_add(global.text_data_en, "obj_asriel_overworldanim_440", "* Ha..^1. ha.../");
ds_map_add(global.text_data_en, "obj_asriel_overworldanim_441", "* I don't want to let&  go.../%%");
ds_map_add(global.text_data_en, "obj_asriel_overworldanim_495", "\E7* Frisk.../");
ds_map_add(global.text_data_en, "obj_asriel_overworldanim_496", "* You're.../");
ds_map_add(global.text_data_en, "obj_asriel_overworldanim_497", "\E0* You're going to do&  a great job^1, OK?/");
ds_map_add(global.text_data_en, "obj_asriel_overworldanim_498", "* No matter what you&  do./");
ds_map_add(global.text_data_en, "obj_asriel_overworldanim_499", "* Everyone will be&  there for you^1,&  okay?/%%");
ds_map_add(global.text_data_en, "obj_asriel_overworldanim_533", "\E7* Well..^1.&* My time's running out./");
ds_map_add(global.text_data_en, "obj_asriel_overworldanim_534", "* Goodbye./%%");
ds_map_add(global.text_data_en, "obj_asriel_overworldanim_572", "* By the way.../");
ds_map_add(global.text_data_en, "obj_asriel_overworldanim_573", "* Frisk./");
ds_map_add(global.text_data_en, "obj_asriel_overworldanim_574", "\E6* ... take care of Mom&  and Dad for me^1, OK?/%%");
ds_map_add(global.text_data_en, "obj_asrielappear_110", "Finally./");
ds_map_add(global.text_data_en, "obj_asrielappear_111", "I was so&tired of&being a&flower./%%");
ds_map_add(global.text_data_en, "obj_asrielappear_147", "Howdy!/");
ds_map_add(global.text_data_en, "obj_asrielappear_148", "\[C]^1,&are you&there?/");
ds_map_add(global.text_data_en, "obj_asrielappear_149", "It's me^1,&your&best&friend./%%");
ds_map_add(global.text_data_en, "obj_FinalWriter_34", " ASRIEL   DREEMURR ");
ds_map_add(global.text_data_en, "obj_asrielb_245", "\E1You know.../");
ds_map_add(global.text_data_en, "obj_asrielb_246", "\M1I \E0don't care about&destroying this&world anymore./%%");
ds_map_add(global.text_data_en, "obj_asrielb_251", "\E1After I defeat you&and gain total&control over the&timeline.../");
ds_map_add(global.text_data_en, "obj_asrielb_252", "\E2I just want to reset&everything./%%");
ds_map_add(global.text_data_en, "obj_asrielb_257", "\E3All your progress..^1.&Everyone's memories./");
ds_map_add(global.text_data_en, "obj_asrielb_258", "\E2I'll bring them all&back to zero!/%%");
ds_map_add(global.text_data_en, "obj_asrielb_263", "\E2Then we can do&everything ALL over&again./%%");
ds_map_add(global.text_data_en, "obj_asrielb_268", "\E3And you know what&the best part of&all this is?/");
ds_map_add(global.text_data_en, "obj_asrielb_269", "\E2You'll DO it./%%");
ds_map_add(global.text_data_en, "obj_asrielb_274", "\E1And then you'll&lose to me again./%%");
ds_map_add(global.text_data_en, "obj_asrielb_279", "\E3And again./%%");
ds_map_add(global.text_data_en, "obj_asrielb_284", "\E3And again!!!/%%");
ds_map_add(global.text_data_en, "obj_asrielb_289", "\E1Because you want a&\"happy ending.\"/%%");ds_map_add(global.text_data_en, "obj_asrielb_294", "Because you \"love&your friends.\"/%%");ds_map_add(global.text_data_en, "obj_asrielb_299", "Because you \"never&give up.\"/%%");ds_map_add(global.text_data_en, "obj_asrielb_304", "\M1I\E1sn't that&delicious?/");
ds_map_add(global.text_data_en, "obj_asrielb_305", "\M0Your \"determination.^1\"&The power that let&you get this far.../");ds_map_add(global.text_data_en, "obj_asrielb_306", "\E2It's gonna be your&downfall!/%%");
ds_map_add(global.text_data_en, "obj_asrielb_311", "\E2Now^1, ENOUGH messing&around!/");
ds_map_add(global.text_data_en, "obj_asrielb_312", "It's time to purge&this timeline once&and for all!/%%");
ds_map_add(global.text_data_en, "obj_asrielb_541", "* Asriel readies \"STAR BLAZING.\"");ds_map_add(global.text_data_en, "obj_asrielb_542", "* Asriel charges \"SHOCKER&  BREAKER.\"");ds_map_add(global.text_data_en, "obj_asrielb_543", "* Asriel calls on \"CHAOS SABER.\"");ds_map_add(global.text_data_en, "obj_asrielb_544", "* Asriel readies \"CHAOS BUSTER.\"");ds_map_add(global.text_data_en, "obj_asrielb_545", "* Asriel readies \"GALACTA&  BLAZING.\"");ds_map_add(global.text_data_en, "obj_asrielb_546", "* Asriel calls on \"CHAOS SLICER.\"");ds_map_add(global.text_data_en, "obj_asrielb_547", "* Asriel readies \"SHOCKER&  BREAKER II.\"");ds_map_add(global.text_data_en, "obj_asrielb_548", "* Asriel readies \"CHAOS&  BLASTER.\"");ds_map_add(global.text_data_en, "obj_asrielb_549", "* Asriel readies \"HYPER GONER.\"");ds_map_add(global.text_data_en, "obj_asrielb_550", "* Asriel is glowing with a&  strange power.");
ds_map_add(global.text_data_en, "obj_asrielb_551", "* It's the end.");
ds_map_add(global.text_data_en, "obj_asrielb_585", "* ASRIEL DREEMURR \z4   ATK \z4   DEF&* Legendary being made of every&  SOUL in the underground./^");
ds_map_add(global.text_data_en, "obj_asrielb_587", "* ASRIEL DREEMURR \z4   ATK \z4   DEF&* The Absolute GOD of Hyperdeath!/^");
ds_map_add(global.text_data_en, "obj_asrielb_597", "* You held on to your hopes..^1.&* You reduced how much DAMAGE&  you'll take this turn!/^");
ds_map_add(global.text_data_en, "obj_asrielb_598", "* You kept holding on^1.&* DAMAGE reduced!/^");
ds_map_add(global.text_data_en, "obj_asrielb_614", "* You think about why you're&  here now.../");
ds_map_add(global.text_data_en, "obj_asrielb_615", "* You can feel the empty&  space in your inventory&  get smaller and smaller!/^");
ds_map_add(global.text_data_en, "obj_asrielb_618", "* Your items fill up with&  dreams./^");
ds_map_add(global.text_data_en, "obj_asrielb_669", "\E0... even after that&attack^1, you're still&standing in my way...?/");
ds_map_add(global.text_data_en, "obj_asrielb_670", "\M1W\E0ow..^1.&You really ARE&something special./");
ds_map_add(global.text_data_en, "obj_asrielb_671", "\M0B\E3ut don't get&cocky./");
ds_map_add(global.text_data_en, "obj_asrielb_672", "\E0Up until now^1, I've&only been using&a fraction of my&REAL power!/");
ds_map_add(global.text_data_en, "obj_asrielb_673", "\E2Let's see what good&your DETERMINATION&is against THIS!!/%%");
ds_map_add(global.text_data_en, "obj_asrielbed_87", "* \[C]^1, please.../");
ds_map_add(global.text_data_en, "obj_asrielbed_88", "* Wake up!/");
ds_map_add(global.text_data_en, "obj_asrielbed_89", "* You are the future&  of humans and&  monsters.../%%");
ds_map_add(global.text_data_en, "obj_asrielbed_93", "* (It felt strange to lie&  in the bed.)/");
ds_map_add(global.text_data_en, "obj_asrielbed_94", "* (It feels entirely too&  small for you now.)/%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_58", "* You feel something faintly&  resonating within ASRIEL.");
ds_map_add(global.text_data_en, "obj_asrielfinal_59", "* You feel something&  resonating within ASRIEL.");
ds_map_add(global.text_data_en, "obj_asrielfinal_60", "* You feel something strongly&  resonating within ASRIEL.");
ds_map_add(global.text_data_en, "obj_asrielfinal_61", "* You feel your friends' SOULs&  resonating within ASRIEL!");
ds_map_add(global.text_data_en, "obj_asrielfinal_423", "* The whole world is ending.");
ds_map_add(global.text_data_en, "obj_asrielfinal_425", "* You feel something faintly&  resonating within ASRIEL.");
ds_map_add(global.text_data_en, "obj_asrielfinal_426", "* You feel something&  resonating within ASRIEL.");
ds_map_add(global.text_data_en, "obj_asrielfinal_427", "* You feel something strongly&  resonating within ASRIEL.");
ds_map_add(global.text_data_en, "obj_asrielfinal_428", "* You feel your friends' SOULs&  resonating within ASRIEL!");
ds_map_add(global.text_data_en, "obj_asrielfinal_429", "* ...");
ds_map_add(global.text_data_en, "obj_asrielfinal_468", "* Strangely^1, as your friends&  remembered you.../");
ds_map_add(global.text_data_en, "obj_asrielfinal_469", "* Something else began resonating&  within the SOUL^1, stronger&  and stronger./");
ds_map_add(global.text_data_en, "obj_asrielfinal_470", "* It seems that there's still&  one last person that needs&  to be saved./");
ds_map_add(global.text_data_en, "obj_asrielfinal_471", "* But who...?/");
ds_map_add(global.text_data_en, "obj_asrielfinal_472", "* .../");
ds_map_add(global.text_data_en, "obj_asrielfinal_473", "* Suddenly^1, you realize./");
ds_map_add(global.text_data_en, "obj_asrielfinal_474", "* You reach out and call&  their name./%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_552", "* Can't move your body^1.&* Nothing happened./");
ds_map_add(global.text_data_en, "obj_asrielfinal_553", "* You struggle..^1.&* Nothing happened./");
ds_map_add(global.text_data_en, "obj_asrielfinal_554", "* You tried to reach your&  SAVE file^1.&* Nothing happened./");
ds_map_add(global.text_data_en, "obj_asrielfinal_555", "* You tried again to reach&  your SAVE file^1.&* Nothing happened./");
ds_map_add(global.text_data_en, "obj_asrielfinal_556", "* Seems SAVING the game really&  is impossible./");
ds_map_add(global.text_data_en, "obj_asrielfinal_559", "* SAVING over ASRIEL's file&  seems like the only way to&  defeat him.../");
ds_map_add(global.text_data_en, "obj_asrielfinal_560", "* But^1, having never SAVED&  before^1, you lack the power&  to do it./");
ds_map_add(global.text_data_en, "obj_asrielfinal_561", "* Seems SAVING the game really&  is impossible./");
ds_map_add(global.text_data_en, "obj_asrielfinal_563", "* .../");
ds_map_add(global.text_data_en, "obj_asrielfinal_564", "* But.../");
ds_map_add(global.text_data_en, "obj_asrielfinal_565", "* Maybe^1, with what little&  power you have.../");
ds_map_add(global.text_data_en, "obj_asrielfinal_566", "* You can SAVE something else./%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_577", "* Can't move your body./^");
ds_map_add(global.text_data_en, "obj_asrielfinal_648", "* !?!?");
ds_map_add(global.text_data_en, "obj_asrielfinal_674", "Huh^1? What are you&doing...!?");
ds_map_add(global.text_data_en, "obj_asrielfinal_723", "");
ds_map_add(global.text_data_en, "obj_asrielfinal_724", "");
ds_map_add(global.text_data_en, "obj_asrielfinal_725", "");
ds_map_add(global.text_data_en, "obj_asrielfinal_726", "");
ds_map_add(global.text_data_en, "obj_asrielfinal_732", "");
ds_map_add(global.text_data_en, "obj_asrielfinal_737", "");
ds_map_add(global.text_data_en, "obj_asrielfinal_741", "");
ds_map_add(global.text_data_en, "obj_asrielfinal_746", "%%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_767", "Urah ha ha ha...&Behold my TRUE power!/%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_771", "I can feel it.../");
ds_map_add(global.text_data_en, "obj_asrielfinal_772", "Every time you die^1,&your grip on this&world slips away./");
ds_map_add(global.text_data_en, "obj_asrielfinal_773", "Every time you die^1,&your friends forget&you a little more./");
ds_map_add(global.text_data_en, "obj_asrielfinal_774", "Your life will end&here^1, in a world&where no one&remembers you.../%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_779", "Still^1, you're&hanging on...?/");
ds_map_add(global.text_data_en, "obj_asrielfinal_780", "That's fine./");
ds_map_add(global.text_data_en, "obj_asrielfinal_781", "In a few moments^1,&you'll forget&everything^1, too./");
ds_map_add(global.text_data_en, "obj_asrielfinal_782", "That attitude will&serve you well in&your next life!/%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_787", "Ura ha ha.../");
ds_map_add(global.text_data_en, "obj_asrielfinal_788", "Still!?/");
ds_map_add(global.text_data_en, "obj_asrielfinal_789", "Come on.../");
ds_map_add(global.text_data_en, "obj_asrielfinal_790", "Show me what good&your DETERMINATION&is now!/%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_796", "Ultimate bepis/%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_819", "\E1Wh..^1.&what did you do...?/");
ds_map_add(global.text_data_en, "obj_asrielfinal_820", "\E3What's this&feeling...^1?&What's happening&to me?/");
ds_map_add(global.text_data_en, "obj_asrielfinal_821", "\E2No^1! NO^1!&I don't need&ANYONE!/%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_826", "\E6STOP IT^1!&Get away from me!/");
ds_map_add(global.text_data_en, "obj_asrielfinal_827", "Do you hear me!?/");
ds_map_add(global.text_data_en, "obj_asrielfinal_828", "\E2I'll tear you&apart!/%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_833", "\E3.../");
ds_map_add(global.text_data_en, "obj_asrielfinal_834", "\E3.../");
ds_map_add(global.text_data_en, "obj_asrielfinal_835", "\[C]..^1.&Do you know why&I'm doing this...?/");
ds_map_add(global.text_data_en, "obj_asrielfinal_836", "Why I keep fighting&to keep you&around...?/%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_841", "\E4I'm doing this.../");
ds_map_add(global.text_data_en, "obj_asrielfinal_842", "\E6Because you're&special^1, \[C]./");
ds_map_add(global.text_data_en, "obj_asrielfinal_843", "You're the only one&that understands&me./");
ds_map_add(global.text_data_en, "obj_asrielfinal_844", "You're the only one&who's any fun to&play with anymore./%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_849", "\E4.../");
ds_map_add(global.text_data_en, "obj_asrielfinal_850", "No.../");
ds_map_add(global.text_data_en, "obj_asrielfinal_851", "\E1That's not JUST&it./");
ds_map_add(global.text_data_en, "obj_asrielfinal_852", "I..^1. I.../");
ds_map_add(global.text_data_en, "obj_asrielfinal_853", "\E4I'm doing this&because I care&about you^1, \[C]!/");
ds_map_add(global.text_data_en, "obj_asrielfinal_854", "\E4I care about you&more than anybody&else!/%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_859", "\E4I'm not ready for&this to end./");
ds_map_add(global.text_data_en, "obj_asrielfinal_860", "I'm not ready for&you to leave./");
ds_map_add(global.text_data_en, "obj_asrielfinal_861", "I'm not ready to&say goodbye to&someone like&you again.../%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_868", "\E7So, please..^1.&STOP doing this.../");
ds_map_add(global.text_data_en, "obj_asrielfinal_869", "AND JUST LET ME&WIN!!!/%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_877", "\E5.../");
ds_map_add(global.text_data_en, "obj_asrielfinal_878", "\[C].../%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_886", "\E5I'm so alone^1,&\[C].../%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_894", "\E5I'm so afraid^1,&\[C].../%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_903", "\[C]^1, I.../%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_911", "I...");
ds_map_add(global.text_data_en, "obj_asrielfinal_976", "* You called out to your&  friends with all your&  heart./");
ds_map_add(global.text_data_en, "obj_asrielfinal_977", "* From somewhere^1, you felt&  their support.../^");
ds_map_add(global.text_data_en, "obj_asrielfinal_1007", "* You reached out to ASRIEL's&  SOUL and called out to your&  friends./");
ds_map_add(global.text_data_en, "obj_asrielfinal_1008", "* They're in there somewhere^1,&  aren't they?/");
ds_map_add(global.text_data_en, "obj_asrielfinal_1009", "* .../");
ds_map_add(global.text_data_en, "obj_asrielfinal_1010", "* Within the depths of ASRIEL's&  SOUL^1, something's resonating..!/%%");
ds_map_add(global.text_data_en, "obj_asrielfinal_1014", "* Within the depths of ASRIEL's&  SOUL^1, something's resonating..!/%%");
ds_map_add(global.text_data_en, "obj_assortedtrash_79", "* (You rest your hand on&  the rusted bike.^1)/");
ds_map_add(global.text_data_en, "obj_assortedtrash_80", "* (Its horn wheezes a honk&  of despair.)/%%");
ds_map_add(global.text_data_en, "obj_assortedtrash_86", "* (A beat-up desktop computer.^1)&* (The inside is empty.)/%%");
ds_map_add(global.text_data_en, "obj_assortedtrash_91", "* (It's a DVD case for an&  anime.)/");
ds_map_add(global.text_data_en, "obj_assortedtrash_92", "* (Desperate claw marks cover&  the edges.)/%%");
ds_map_add(global.text_data_en, "obj_astigmatism_210", "...&...");
ds_map_add(global.text_data_en, "obj_astigmatism_211", "You've&seen&enough.");
ds_map_add(global.text_data_en, "obj_astigmatism_212", "Take&your&last&look.");
ds_map_add(global.text_data_en, "obj_astigmatism_213", "...");
ds_map_add(global.text_data_en, "obj_astigmatism_220", "What are&you so&afraid&of?");
ds_map_add(global.text_data_en, "obj_astigmatism_222", "Finally,&someone&gets it.");
ds_map_add(global.text_data_en, "obj_astigmatism_228", "How&dare&you.");
ds_map_add(global.text_data_en, "obj_astigmatism_230", "That's&right!");
ds_map_add(global.text_data_en, "obj_astigmatism_236", "You&dare&defy me?");
ds_map_add(global.text_data_en, "obj_astigmatism_238", "You've&pushed&your&luck.");
ds_map_add(global.text_data_en, "obj_astigmatism_242", "That&takes&guts.");
ds_map_add(global.text_data_en, "obj_astigmatism_248", "...&Don't&pick on&me.");
ds_map_add(global.text_data_en, "obj_astigmatism_249", "...&Pick on&me.");
ds_map_add(global.text_data_en, "obj_astigmatism_254", "%%%");
ds_map_add(global.text_data_en, "obj_astigmatism_456", "* Astigmatism gazes through&  your soul.");
ds_map_add(global.text_data_en, "obj_astigmatism_457", "* Astigmatism gives you a&  hypnotizing glare.");
ds_map_add(global.text_data_en, "obj_astigmatism_458", "* Astigmatism clicks its teeth.");
ds_map_add(global.text_data_en, "obj_astigmatism_459", "* Smells like glasses.");
ds_map_add(global.text_data_en, "obj_astigmatism_460", "* Astigmatism has gone&  bloodshot.");
ds_map_add(global.text_data_en, "obj_astigmatism_461", "* Astigmatism doesn't care&  about fighting anymore.");
ds_map_add(global.text_data_en, "obj_astigmatism_462", "* Astigmatism is watering.");
ds_map_add(global.text_data_en, "obj_astigmatism_495", "* ASTIGMATISM - ATK 32 DEF 26&* This relentless bully ALWAYS&  gets its way./^");
ds_map_add(global.text_data_en, "obj_astigmatism_504", "* You pick on Astigmatism./^");
ds_map_add(global.text_data_en, "obj_astigmatism_518", "* You don't pick on Astigmatism./^");
ds_map_add(global.text_data_en, "obj_astigmatism_533", "* You stand up to Astigmatism./^");
ds_map_add(global.text_data_en, "obj_astigmatism_534", "* You stand up to Astigmatism^1.&* The other monsters are&  impressed./^");
ds_map_add(global.text_data_en, "obj_autowater_81", "* (The cup of water returned&  to the water cooler.)/%%");
ds_map_add(global.text_data_en, "obj_autowater_85", "* (The cup of water was erased&  by a mysterious force.)/%%");
ds_map_add(global.text_data_en, "obj_autowater_89", "* (The water evaporated from&  the heat.)/");
ds_map_add(global.text_data_en, "obj_autowater_90", "* (The cup evaporated^1, too.)/%%");
ds_map_add(global.text_data_en, "obj_bara01_252", "Like,&give us&the soul&brah.");
ds_map_add(global.text_data_en, "obj_bara01_253", "Like,&\"you're&dead\"&and all.");
ds_map_add(global.text_data_en, "obj_bara01_254", "Like,&prepare&to die,&right?");
ds_map_add(global.text_data_en, "obj_bara01_255", "Like,&perish&and&stuff.");
ds_map_add(global.text_data_en, "obj_bara01_259", "D...&Dude...");
ds_map_add(global.text_data_en, "obj_bara01_262", "Like,&team&attack!");
ds_map_add(global.text_data_en, "obj_bara01_266", "Like...&what?&I don't&get it.");
ds_map_add(global.text_data_en, "obj_bara01_267", "I...&I...");
ds_map_add(global.text_data_en, "obj_bara01_272", "Like,&hands&off the&merch.");
ds_map_add(global.text_data_en, "obj_bara01_278", "H-HEY,&STOP&THAT!!");
ds_map_add(global.text_data_en, "obj_bara01_285", "02...&this is,&like,&for you.");
ds_map_add(global.text_data_en, "obj_bara01_286", "Like,&02...");
ds_map_add(global.text_data_en, "obj_bara01_287", "02...&are you&really..");
ds_map_add(global.text_data_en, "obj_bara01_288", "...");
ds_map_add(global.text_data_en, "obj_bara01_291", "02...&I never&told&him...");
ds_map_add(global.text_data_en, "obj_bara01_293", "02!?&B-but&why!?");
ds_map_add(global.text_data_en, "obj_bara01_300", "%%%");
ds_map_add(global.text_data_en, "obj_bara01_524", "* 02 seems to be bothered by&  his outfit.");
ds_map_add(global.text_data_en, "obj_bara01_525", "* 01 is polishing his face.");
ds_map_add(global.text_data_en, "obj_bara01_526", "* 01 stands guard.");
ds_map_add(global.text_data_en, "obj_bara01_527", "* 02 watches your movements.");
ds_map_add(global.text_data_en, "obj_bara01_528", "* Smells like a military zoo.");
ds_map_add(global.text_data_en, "obj_bara01_535", "* 01 holds his head in his&  hands.");
ds_map_add(global.text_data_en, "obj_bara01_536", "* Anguished noises come from&  inside 01's armor.");
ds_map_add(global.text_data_en, "obj_bara01_537", "* 01 stands still.");
ds_map_add(global.text_data_en, "obj_bara01_538", "* 01 doesn't know what to do.");
ds_map_add(global.text_data_en, "obj_bara01_542", "* 01's breathing intensifies.");
ds_map_add(global.text_data_en, "obj_bara01_558", "* RG 01 - ATK 30 DEF 20&* Royal Guard member with&  shining^1, polished armor./^");
ds_map_add(global.text_data_en, "obj_bara01_561", "* I see two lovers staring over&  the edge of the cauldron of&  hell./^");
ds_map_add(global.text_data_en, "obj_bara01_571", "* You attempt to touch RG 01's&  armor^1.&* Your hands slip off./^");
ds_map_add(global.text_data_en, "obj_bara01_581", "* You tell RG 01 to be honest&  with his feelings./^");
ds_map_add(global.text_data_en, "obj_bara01_615", "D-dude&.../");
ds_map_add(global.text_data_en, "obj_bara01_616", "I can't&.../");
ds_map_add(global.text_data_en, "obj_bara01_617", "I can't&take&this&anymore!/");
ds_map_add(global.text_data_en, "obj_bara01_618", "Not like&this!!/%%");
ds_map_add(global.text_data_en, "obj_bara01_632", "Like^1, 02!&I like.../");
ds_map_add(global.text_data_en, "obj_bara01_633", "I like^1, LIKE you^1,&bro!/");
ds_map_add(global.text_data_en, "obj_bara01_634", "The way you fight..^1.&The way you talk.../");
ds_map_add(global.text_data_en, "obj_bara01_635", "I love doing team&attacks with you./");
ds_map_add(global.text_data_en, "obj_bara01_636", "I love standing here&with you^1, bouncing&and waving our&weapons in sync.../");
ds_map_add(global.text_data_en, "obj_bara01_637", "02..^1.&I^1, like^1, want to stay&like this forever.../%%");
ds_map_add(global.text_data_en, "obj_bara01_650", "^1.^1../");
ds_map_add(global.text_data_en, "obj_bara01_651", "^1.^1.^1.^1./%%");
ds_map_add(global.text_data_en, "obj_bara01_663", "Uh.../");
ds_map_add(global.text_data_en, "obj_bara01_664", "I mean,&uh.../");
ds_map_add(global.text_data_en, "obj_bara01_665", "Psyche!&Gotcha,&bro!!!&Haha!/%%");
ds_map_add(global.text_data_en, "obj_bara01_668", "Whew,&bro!&That&human,/");
ds_map_add(global.text_data_en, "obj_bara01_669", "Put me&under,&uh, mind&control!/");
ds_map_add(global.text_data_en, "obj_bara01_670", "What was&I just&saying?/");
ds_map_add(global.text_data_en, "obj_bara01_671", "It's all&a blur,&dude!!&Whoops!/%%");
ds_map_add(global.text_data_en, "obj_bara01_687", "... 01./%%");
ds_map_add(global.text_data_en, "obj_bara01_699", "Y-yeah,&bro??/%%");
ds_map_add(global.text_data_en, "obj_bara01_716", ".../");
ds_map_add(global.text_data_en, "obj_bara01_717", "... do&you want&to.../");
ds_map_add(global.text_data_en, "obj_bara01_718", "... get&some ice&cream.../");
ds_map_add(global.text_data_en, "obj_bara01_719", "...&after&this?/%%");
ds_map_add(global.text_data_en, "obj_bara01_731", "Like.../");
ds_map_add(global.text_data_en, "obj_bara01_732", "Sure,&dude!&Haha!/%%");
ds_map_add(global.text_data_en, "obj_bara01_751", "* 01 and 02 are looking at&  each other happily.");
ds_map_add(global.text_data_en, "obj_bara02_256", "...&...&...&sigh.");
ds_map_add(global.text_data_en, "obj_bara02_257", "...&...&heh.");
ds_map_add(global.text_data_en, "obj_bara02_258", "...&...&what?");
ds_map_add(global.text_data_en, "obj_bara02_259", "...&...&hmph.");
ds_map_add(global.text_data_en, "obj_bara02_262", "...&team&attack.");
ds_map_add(global.text_data_en, "obj_bara02_266", "...&i&won't&tell.");
ds_map_add(global.text_data_en, "obj_bara02_271", "...&getting&...&warmer.");
ds_map_add(global.text_data_en, "obj_bara02_272", "...&hello.");
ds_map_add(global.text_data_en, "obj_bara02_279", "...");
ds_map_add(global.text_data_en, "obj_bara02_280", "...");
ds_map_add(global.text_data_en, "obj_bara02_281", "...");
ds_map_add(global.text_data_en, "obj_bara02_282", "...");
ds_map_add(global.text_data_en, "obj_bara02_285", "01...&you...!&..!!!!");
ds_map_add(global.text_data_en, "obj_bara02_287", "01...!?&What&the...!?");
ds_map_add(global.text_data_en, "obj_bara02_292", "%%%");
ds_map_add(global.text_data_en, "obj_bara02_527", "* Sweat pours from 02's armor.");
ds_map_add(global.text_data_en, "obj_bara02_528", "* 01 is polishing his face.");
ds_map_add(global.text_data_en, "obj_bara02_529", "* 01 stands guard.");
ds_map_add(global.text_data_en, "obj_bara02_530", "* 02 watches your movements.");
ds_map_add(global.text_data_en, "obj_bara02_531", "* Smells like a military zoo.");
ds_map_add(global.text_data_en, "obj_bara02_538", "* 02 is clenching and unclenching&  his fists.");
ds_map_add(global.text_data_en, "obj_bara02_539", "* 02 is shaking his head.");
ds_map_add(global.text_data_en, "obj_bara02_540", "* 02 is striking his sword&  against the ground.");
ds_map_add(global.text_data_en, "obj_bara02_541", "* 02 is coughing.");
ds_map_add(global.text_data_en, "obj_bara02_545", "* 02's breathing intensifies.");
ds_map_add(global.text_data_en, "obj_bara02_564", "* RG 02 - ATK 30 DEF 20&* Royal Guard member with&  stuffy armor./^");
ds_map_add(global.text_data_en, "obj_bara02_567", "* Do they both wish for death^1?&* That means their love will&  end in hell./");
ds_map_add(global.text_data_en, "obj_bara02_568", "* I couldn't stop laughing./^");
ds_map_add(global.text_data_en, "obj_bara02_580", "* You clean RG 02's armor.&* Its cooling dirt begins to&  wash away./^");
ds_map_add(global.text_data_en, "obj_bara02_581", "* You were repelled./^");
ds_map_add(global.text_data_en, "obj_bara02_585", "* You pat RG 02's chest&  like a muscular bongo./^");
ds_map_add(global.text_data_en, "obj_bara02_597", "* You tell RG 02 your favorite&  secret./^");
ds_map_add(global.text_data_en, "obj_bara02_644", "...&can't&...&take it./");
ds_map_add(global.text_data_en, "obj_bara02_645", "...&armor...&too...&HOT!!!/%%");
ds_map_add(global.text_data_en, "obj_bara02_664", "...&much&better./%%");
ds_map_add(global.text_data_en, "obj_bara02_672", "* RG 01 looks bothered by&  something.");
ds_map_add(global.text_data_en, "obj_barriercut_94", "The barrier was&destroyed^7.%%");
ds_map_add(global.text_data_en, "obj_barrierevent_145", "* Ready?/%%");
ds_map_add(global.text_data_en, "obj_battlebomb_217", "Tick.");
ds_map_add(global.text_data_en, "obj_battlebomb_218", "Tock.");
ds_map_add(global.text_data_en, "obj_battlebomb_219", "Tick.");
ds_map_add(global.text_data_en, "obj_battlebomb_220", "Tock.");
ds_map_add(global.text_data_en, "obj_battlebomb_222", "Zzz...");
ds_map_add(global.text_data_en, "obj_battlebomb_223", "Swish.");
ds_map_add(global.text_data_en, "obj_battlebomb_245", "%%%");
ds_map_add(global.text_data_en, "obj_battlebomb_485", "* The bomb is still active!");
ds_map_add(global.text_data_en, "obj_battlebomb_486", "* The dog is still active!");
ds_map_add(global.text_data_en, "obj_battlebomb_513", "* BOMB&* Could blow at any moment./^");
ds_map_add(global.text_data_en, "obj_battlebomb_514", "* ANNOYING DOG-BOMB&* It's blissfully unaware of&  its circumstances./^");
ds_map_add(global.text_data_en, "obj_battlebomb_515", "* EXTREMELY AGILE G.O.W.&* All things considered^1, it's an&  extremely agile glass of water./^");
ds_map_add(global.text_data_en, "obj_battlebomb_516", "* SCRIPT BOMB&* Like all modern blockbusters^1,&  it's full of explosions./^");
ds_map_add(global.text_data_en, "obj_battlebomb_517", "* BASKET BOMB&* Even if you explode^1, you'll&  at least look good./^");
ds_map_add(global.text_data_en, "obj_battlebomb_518", "* PRESENT BOMB&* Regardless^1, you'll have to&  write a thank-you letter./^");
ds_map_add(global.text_data_en, "obj_battlebomb_519", "* GAME BOMB&* You really should have rented&  it first./^");
ds_map_add(global.text_data_en, "obj_battlebomb_536", "* Defuse failed^1!&* Aim for DEFUSE ZONE!/^");
ds_map_add(global.text_data_en, "obj_battlebomb_541", "* Bomb defused!");
ds_map_add(global.text_data_en, "obj_battlebomb_542", "* Dog defused!");
ds_map_add(global.text_data_en, "obj_battlecontroller_286", "* YOU WON!&* You earned \[1] EXP and \[2] gold.");
ds_map_add(global.text_data_en, "obj_battlecontroller_287", "&* Your LOVE increased.");
ds_map_add(global.text_data_en, "obj_bed_dark_64", " error/%%");
ds_map_add(global.text_data_en, "obj_bed_dark_66", "* (It's a bed.)/%%");
ds_map_add(global.text_data_en, "obj_bed_watcher_94", "* (Seems like a comfy bed.)/");
ds_map_add(global.text_data_en, "obj_bed_watcher_95", "* (You could probably climb&  into it if you were to&  the left of it.)/%%");
ds_map_add(global.text_data_en, "obj_blookdiary_64", "%%");
ds_map_add(global.text_data_en, "obj_blookdiary_70", "* Dear Diary^1:&* Shyren's sister \"fell down\"&  recently./");ds_map_add(global.text_data_en, "obj_blookdiary_71", "* It's sad^1.&* Without her sister to&  speak for her.../");
ds_map_add(global.text_data_en, "obj_blookdiary_72", "* She's become more&  reclusive than ever./");
ds_map_add(global.text_data_en, "obj_blookdiary_73", "* So I reached out to her^1,&  and told her.../");
ds_map_add(global.text_data_en, "obj_blookdiary_74", "* That she^1, Blooky^1, and I&  should all perform together&  sometime./");
ds_map_add(global.text_data_en, "obj_blookdiary_75", "* She seemed to like&  that idea./%%");
ds_map_add(global.text_data_en, "obj_blookdiary_80", "* Dearer Diary^1:&* I like to buy a new diary&  for every entry I make./");
ds_map_add(global.text_data_en, "obj_blookdiary_81", "* I love to collect diaries./%%");
ds_map_add(global.text_data_en, "obj_blookdiary_85", "* Dearest Diary^1:&* Our cousin left the farm&  to become a training dummy./");
ds_map_add(global.text_data_en, "obj_blookdiary_86", "* That leaves just Blooky&  and I./");
ds_map_add(global.text_data_en, "obj_blookdiary_87", "* Blooky asked me if I was&  going to try to become&  corporeal^1, too./");
ds_map_add(global.text_data_en, "obj_blookdiary_88", "* They sounded so..^1.&* Resigned.../");
ds_map_add(global.text_data_en, "obj_blookdiary_89", "* Come on^1, Blooky^1.&* You know I'd never leave&  you behind./");
ds_map_add(global.text_data_en, "obj_blookdiary_90", "* And besides.../");
ds_map_add(global.text_data_en, "obj_blookdiary_91", "* I'd never find the kind&  of body I'm looking for^1,&  anyway./%%");
ds_map_add(global.text_data_en, "obj_blookdiary_96", "* My Darling Diary^1:&* I met someone..^1.&* Interesting today./");
ds_map_add(global.text_data_en, "obj_blookdiary_97", "* Last week I posted that&  advertisement for my&  Human Fanclub./");
ds_map_add(global.text_data_en, "obj_blookdiary_98", "* Today was our first meeting./");
ds_map_add(global.text_data_en, "obj_blookdiary_99", "* Only one other person came./");
ds_map_add(global.text_data_en, "obj_blookdiary_100", "* Honestly^1, she's a dork^1.&* And she's obsessed with&  these awful cartoons./");
ds_map_add(global.text_data_en, "obj_blookdiary_101", "* But she's kind of funny^1,&  too..../");
ds_map_add(global.text_data_en, "obj_blookdiary_102", "* I want to see her again./%%");
ds_map_add(global.text_data_en, "obj_blookdiary_107", "* Diary... My dear:&* My diary collection is&  going fabulously./");
ds_map_add(global.text_data_en, "obj_blookdiary_108", "* I have like five now./%%");
ds_map_add(global.text_data_en, "obj_blookdiary_115", "* Dear Diary^1:&* She surpised me with&  something today./");
ds_map_add(global.text_data_en, "obj_blookdiary_116", "* Sketches of a body that&  she wants to create for&  me.../");
ds_map_add(global.text_data_en, "obj_blookdiary_117", "* A form beyond my wildest&  fantasies./");
ds_map_add(global.text_data_en, "obj_blookdiary_118", "* In a form like that^1, I&  could finally feel&  like... \"myself.\"/");ds_map_add(global.text_data_en, "obj_blookdiary_119", "* After all^1, there's no&  way I can be a star&  the way I am now./");
ds_map_add(global.text_data_en, "obj_blookdiary_120", "* Sorry^1, Blooky^1.&* My dreams can't wait&  for anyone.../%%");
ds_map_add(global.text_data_en, "obj_blueattackgen_60", "* You're blue now.");
ds_map_add(global.text_data_en, "obj_blueattackgen_90", " YOU'RE BLUE NOW./");
ds_map_add(global.text_data_en, "obj_blueattackgen_91", " THAT'S MY ATTACK!/");
ds_map_add(global.text_data_en, "obj_blueattackgen_92", " NYEH HEH HEH& HEH HEH HEH& HEH HEH HEH!!!/%%");
ds_map_add(global.text_data_en, "obj_bonebox_63", "HEY^1, THOSE ARE ALL&THE ATTACKS I USED&ON YOU./");
ds_map_add(global.text_data_en, "obj_bonebox_64", "GREAT MEMORIES^1,&HUH?/");
ds_map_add(global.text_data_en, "obj_bonebox_65", "SEEMS LIKE IT&WAS ONLY&YESTERDAY.../");
ds_map_add(global.text_data_en, "obj_bonebox_66", "\E3EVEN THOUGH&IT BASICALLY&JUST HAPPENED./%%");
ds_map_add(global.text_data_en, "obj_bonebox_70", "HEY^1, THOSE ARE ALL&THE ATTACKS I&DIDN'T USE./");
ds_map_add(global.text_data_en, "obj_bonebox_71", "\WHOW LUCKY OF YOU^1!&HAD I ONLY USED&MY \YSPECIAL ATTACK\W,/");
ds_map_add(global.text_data_en, "obj_bonebox_72", "\E2YOU SURELY WOULD&HAVE BEEN BLASTED&TO.../");
ds_map_add(global.text_data_en, "obj_bonebox_73", "\WH\E3EY.^1 WAIT^1.&WHERE'S MY \YSPECIAL&ATTACK\W?/");
ds_map_add(global.text_data_en, "obj_bonebox_74", "\E1NO^1! I'VE BEEN&DOGBURGLED BY THAT&PERNICIOUS PUP!/");
ds_map_add(global.text_data_en, "obj_bonebox_75", "\E3THAT LOATHESOME&SCOUNDREL LOVES TO&SNEAK INTO MY ROOM./");
ds_map_add(global.text_data_en, "obj_bonebox_76", "\E5SOMETIMES IT EVEN&CRAWLS INTO MY BED&WHILE I'M RESTING./");
ds_map_add(global.text_data_en, "obj_bonebox_77", "\E3IF THAT WASN'T&BAD ENOUGH^1, IT HAS&VERY COLD FEET./%%");
ds_map_add(global.text_data_en, "obj_bonebox_81", "* (It's a box of bones.)/%%");
ds_map_add(global.text_data_en, "obj_bonebox_85", "* (It's a box of bones.)/%%");
ds_map_add(global.text_data_en, "obj_bonedrawer_check_84", "%%");
ds_map_add(global.text_data_en, "obj_boysnightout_80", "* Hey^1! You^1!&* Stop!/%%");
ds_map_add(global.text_data_en, "obj_boysnightout_113", "* We've^1, like^1, received an&  anonymous tip about a human&  wearing a striped shirt./");
ds_map_add(global.text_data_en, "obj_boysnightout_114", "* They told us they were&  wandering around Hotland&  right now.../");
ds_map_add(global.text_data_en, "obj_boysnightout_115", "* I know^1, sounds scary^1, huh?/");
ds_map_add(global.text_data_en, "obj_boysnightout_116", "* Well^1, just stay chill^1.&* We'll bring you someplace&  safe^1, OK?/%%");
ds_map_add(global.text_data_en, "obj_boysnightout_117", "%%%");
ds_map_add(global.text_data_en, "obj_boysnightout_156", "* ... Huh^1?&* What is it, bro?/");
ds_map_add(global.text_data_en, "obj_boysnightout_157", "* The shirt they're wearing?/");
ds_map_add(global.text_data_en, "obj_boysnightout_158", "* ... like^1, what about it?/%%");
ds_map_add(global.text_data_en, "obj_boysnightout_181", "* Bro.../");
ds_map_add(global.text_data_en, "obj_boysnightout_182", "* Are you thinkin..^1.&* What I'm thinkin?/");
ds_map_add(global.text_data_en, "obj_boysnightout_183", "* Bummer^1.&* This is^1, like..^1.&* Mega embarrassing./");
ds_map_add(global.text_data_en, "obj_boysnightout_184", "* We^1, like^1, actually&  totally have to kill&  you and stuff./%%");
ds_map_add(global.text_data_en, "obj_businessmanticore_70", "* This elevator goes straight&  to the capital^1.&* But it stopped working./");
ds_map_add(global.text_data_en, "obj_businessmanticore_71", "* The hotel's doing its best to&  accomodate everybody&  stuck here./%%");
ds_map_add(global.text_data_en, "obj_businessmanticore_75", "* Me^1?&* I just like explaining things&  to passersby./%%");
ds_map_add(global.text_data_en, "obj_businessmanticore_80", "* Good news^1!&* The elevator started working&  again./");
ds_map_add(global.text_data_en, "obj_businessmanticore_81", "* But now it's been so busy^1,&  we still haven't gotten the&  chance to ride it./%%");
ds_map_add(global.text_data_en, "obj_businessmanticore_86", "* Mettaton hasn't made a&  performance for more&  than five minutes.../");
ds_map_add(global.text_data_en, "obj_businessmanticore_87", "* What's happening...^1?&* Can you explain it?/%%");
ds_map_add(global.text_data_en, "obj_butterflybullet_102", "* Whimsalot doesn't want to&  fight anymore.");
ds_map_add(global.text_data_en, "obj_cactus_55", "* Ah^1, the cactus.&* Truly the most tsundere&  of plants./%%");
ds_map_add(global.text_data_en, "obj_cactus_58", "* It's not like this cactus&  was waiting for you to come&  back or anything.../%%");
ds_map_add(global.text_data_en, "obj_carbed_63", "THAT'S MY BED!/");
ds_map_add(global.text_data_en, "obj_carbed_64", "IF I EVER GET&TO THE SURFACE.../");
ds_map_add(global.text_data_en, "obj_carbed_65", "I'D LIKE TO&DRIVE DOWN A&LONG HIGHWAY./");
ds_map_add(global.text_data_en, "obj_carbed_66", "WIND IN MY&HAIR.../");
ds_map_add(global.text_data_en, "obj_carbed_67", "SUN ON MY&SKIN.../");
ds_map_add(global.text_data_en, "obj_carbed_68", "\E3OF COURSE^1, THAT'S&JUST A DREAM./");
ds_map_add(global.text_data_en, "obj_carbed_69", "\E0SO INSTEAD I&CRUISE WHILE I&SNOOZE./%%");
ds_map_add(global.text_data_en, "obj_carbed_72", "WHY ARE YOU SO&INTERESTED IN MY&BED?/");
ds_map_add(global.text_data_en, "obj_carbed_73", "\E3ARE YOU TIRED?/%%");
ds_map_add(global.text_data_en, "obj_carbed_78", "* (It's a racecar bed^1, neatly&  made.)/%%");
ds_map_add(global.text_data_en, "obj_carrybird_95", "* Isn't my little Cinnamon&  just the cutest?/");
ds_map_add(global.text_data_en, "obj_carrybird_96", "* Bun-buns are so adorable..^1.&* Tee hee!/%%");
ds_map_add(global.text_data_en, "obj_carrybird_98", "* Bun-bun-bun-bun-bun.../%%");
ds_map_add(global.text_data_en, "obj_chairiel_118", "* (Seems like the right size&  for Toriel.)/%%");
ds_map_add(global.text_data_en, "obj_chairiel_123", "* (It's a great reading chair.^1)&* (But it doesn't seem like&  anyone uses it.)/%%");
ds_map_add(global.text_data_en, "obj_cheesetable1_58", "* This cheese has been here&  quite a long time./");
ds_map_add(global.text_data_en, "obj_cheesetable1_59", "* It's stuck to the table.../%%");
ds_map_add(global.text_data_en, "obj_cheesetable1_62", "* (Looks like cheese has a&  nibble taken out of it.)/%%");
ds_map_add(global.text_data_en, "obj_chewtoy_98", "* (It's a squeaky chew toy.)/%%");
ds_map_add(global.text_data_en, "obj_chilldrake_246", "Brush my&teeth?&No way&in heck!");
ds_map_add(global.text_data_en, "obj_chilldrake_247", "NEVER do&your&homework&!!");
ds_map_add(global.text_data_en, "obj_chilldrake_248", "No&bedtime!&Only&DEADTIME");
ds_map_add(global.text_data_en, "obj_chilldrake_249", "*turns&music up&all the&way*");
ds_map_add(global.text_data_en, "obj_chilldrake_254", "Do you...&really&...");
ds_map_add(global.text_data_en, "obj_chilldrake_255", "I don't&think&you...");
ds_map_add(global.text_data_en, "obj_chilldrake_256", "To tell&you the&truth...");
ds_map_add(global.text_data_en, "obj_chilldrake_258", "You&don't&know my&cause!!");
ds_map_add(global.text_data_en, "obj_chilldrake_265", "Only&Snowy&can do&that.");
ds_map_add(global.text_data_en, "obj_chilldrake_266", "You&ain't&Snowy.");
ds_map_add(global.text_data_en, "obj_chilldrake_267", "Stick to&puns.&They're&better.");
ds_map_add(global.text_data_en, "obj_chilldrake_272", "WRONG!&Let's&fight&and die.");
ds_map_add(global.text_data_en, "obj_chilldrake_273", "Actually&...&Death?");
ds_map_add(global.text_data_en, "obj_chilldrake_274", "Defiance&can't be&defied!");
ds_map_add(global.text_data_en, "obj_chilldrake_279", "IT'S&JUST&LIKE&'EM");
ds_map_add(global.text_data_en, "obj_chilldrake_280", "HAHA&WOWEE");
ds_map_add(global.text_data_en, "obj_chilldrake_281", "YOU&NAILED&IT");
ds_map_add(global.text_data_en, "obj_chilldrake_286", "Where's&Snowy&right&now?");
ds_map_add(global.text_data_en, "obj_chilldrake_287", "Ha...&Ha...");
ds_map_add(global.text_data_en, "obj_chilldrake_288", "Nice&try,&laugh&Picasso.");
ds_map_add(global.text_data_en, "obj_chilldrake_296", "%%%");
ds_map_add(global.text_data_en, "obj_chilldrake_493", "* Chilldrake starts a one-&  monster riot.");
ds_map_add(global.text_data_en, "obj_chilldrake_494", "* Chilldrake is chanting an&  anarchist spell.");
ds_map_add(global.text_data_en, "obj_chilldrake_495", "* Chilldrake is eating its&  own homework.");
ds_map_add(global.text_data_en, "obj_chilldrake_496", "* It smells like \"Ice\"&  scented body-spray.");ds_map_add(global.text_data_en, "obj_chilldrake_497", "* Chilldrake is wondering&  where Snowy went.");
ds_map_add(global.text_data_en, "obj_chilldrake_498", "* Chilldrake feels neutered&  by your agreement.");
ds_map_add(global.text_data_en, "obj_chilldrake_499", "* Chilldrake is laughing at&  your imitation of its&  cohort.");
ds_map_add(global.text_data_en, "obj_chilldrake_500", "* Chilldrake pretends not to&  care.");
ds_map_add(global.text_data_en, "obj_chilldrake_501", "* Chilldrake is puffed up..");
ds_map_add(global.text_data_en, "obj_chilldrake_502", "* Chilldrake is flaking&  apart.");
ds_map_add(global.text_data_en, "obj_chilldrake_518", "* CHILLDRAKE - ATK 12 DEF 7&* Rebels against everything!!&* Looking for its friend Snowy./^");
ds_map_add(global.text_data_en, "obj_chilldrake_527", "* You tell Chilldrake it's&  all wrong./^");
ds_map_add(global.text_data_en, "obj_chilldrake_539", "* You agree with Chilldrake&  before it gives its speech./^");
ds_map_add(global.text_data_en, "obj_chilldrake_540", "* You agree with Chilldrake^1.&* It seems to get very&  uncomfortable.../^");
ds_map_add(global.text_data_en, "obj_chilldrake_548", "* You make fun of Chilldrake./^");
ds_map_add(global.text_data_en, "obj_chilldrake_550", "* You make fun of Chilldrake./");
ds_map_add(global.text_data_en, "obj_chilldrake_551", "* The other monsters think&  it's hilarious.../^");
ds_map_add(global.text_data_en, "obj_chilldrakenpc_70", "* Heh..^1. us teens live&  self-sufficiently off&  the fat of the land.../");
ds_map_add(global.text_data_en, "obj_chilldrakenpc_71", "* Oh^1, and the box lunches my&  parents bring us every&  day./%%");
ds_map_add(global.text_data_en, "obj_chilldrakenpc_72", "* Besides Snowy^1.&* We have to share ours&  with him../%%");
ds_map_add(global.text_data_en, "obj_chilldrakenpc_76", "* Heh..^1.&* I guess we'll have to go to&  the surface./");
ds_map_add(global.text_data_en, "obj_chilldrakenpc_77", "* There are woods there we can&  live in^1, right?/%%");
ds_map_add(global.text_data_en, "obj_chilldrakenpc_82", "* Guh huh huh huh^1./");
ds_map_add(global.text_data_en, "obj_chilldrakenpc_83", "* Us teens rule these woods&  with a smaller-than-&  adult fist./%%");
ds_map_add(global.text_data_en, "obj_chilldrakenpc_87", "* I'm worried about getting&  older..^1.&* I'll stop being a teen./");
ds_map_add(global.text_data_en, "obj_chilldrakenpc_88", "* No^1! I refuse^1!&* I'll just invent new numbers^1,&  like twenty-teen!/%%");
ds_map_add(global.text_data_en, "obj_chipdoor_l_78", "* (The door is locked.)/%%");
ds_map_add(global.text_data_en, "obj_chipdoor_l_79", "* (This half of the door is&  unlocked.)/%%");
ds_map_add(global.text_data_en, "obj_chipdoor_l_82", "* (The door is open.)/%%");
ds_map_add(global.text_data_en, "obj_chipdoor_l_87", "* (The door is open.)/%%");
ds_map_add(global.text_data_en, "obj_chipdoor_r_84", "* (The door is locked.)/%%");
ds_map_add(global.text_data_en, "obj_chipdoor_r_85", "* (This half of the door is&  unlocked.)/%%");
ds_map_add(global.text_data_en, "obj_chipdoor_r_89", "* (The door is open.)/%%");
ds_map_add(global.text_data_en, "obj_chipdoor_r_94", "* (The door is open.)/%%");
ds_map_add(global.text_data_en, "obj_clamgirl_74", "* I'm visiting Waterfall&  from the city./");
ds_map_add(global.text_data_en, "obj_clamgirl_75", "* Synchronicity...^1?&* My neighbor's daughter looks&  about your age./");
ds_map_add(global.text_data_en, "obj_clamgirl_76", "\W* Her name is \"\YSuzy\W.^1\"&* I feel like you two should&  be friends./");ds_map_add(global.text_data_en, "obj_clamgirl_77", "* You have..^1.&* A neighbor's blessing!!!/%%");
ds_map_add(global.text_data_en, "obj_clamgirl_81", "* Not knowing where I live&  is no issue^1.&* Fate finds a way./");
ds_map_add(global.text_data_en, "obj_clamgirl_82", "* In life's grand scheme^1, she&  might be why you came here&  in the first place.../%%");
ds_map_add(global.text_data_en, "obj_clamgirl_93", "* I sense a disturbance in&  the nearby aura.../");
ds_map_add(global.text_data_en, "obj_clamgirl_94", "* I think you should leave&  that girl alone./%%");
ds_map_add(global.text_data_en, "obj_clamgirl_102", "* So you never met my&  neighbor's daughter./");
ds_map_add(global.text_data_en, "obj_clamgirl_103", "* Don't despair^1.&* This world has infinite&  opportunities./");
ds_map_add(global.text_data_en, "obj_clamgirl_104", "* But there's a limit to the&  things you can do today^1.&* Accepting this is healthy./");
ds_map_add(global.text_data_en, "obj_clamgirl_105", "* Take my neighbor's blessing^1!&* And consider this blessing&  for anything you like!/%%");
ds_map_add(global.text_data_en, "obj_clamgirl_110", "* I wanted to tell you about&  my neighbor's daughter./");
ds_map_add(global.text_data_en, "obj_clamgirl_111", "* But you walked right by me&  before I could tell you./");
ds_map_add(global.text_data_en, "obj_clamgirl_112", "* Fate has decided that I&  should not tell you./%%");
ds_map_add(global.text_data_en, "obj_clamguy_73", "* O, k, k, k, k.../");
ds_map_add(global.text_data_en, "obj_clamguy_74", "* I was thirsty^1, so I came&  over from Waterfall to get&  a drink!/%%");
ds_map_add(global.text_data_en, "obj_clamguy_78", "* O, k, k.../");
ds_map_add(global.text_data_en, "obj_clamguy_79", "* What are you doing with&  all of that water?/%%");
ds_map_add(global.text_data_en, "obj_clamguy_83", "* O, k, k, k, k.../");
ds_map_add(global.text_data_en, "obj_clamguy_84", "* So now we have a private pool^1?&* Worse things have happened./%%");
ds_map_add(global.text_data_en, "obj_clamguy_89", "* O, k, k, k, k.../");
ds_map_add(global.text_data_en, "obj_clamguy_90", "* Are you just carrying that&  around to look sophisticated?/");
ds_map_add(global.text_data_en, "obj_clamguy_91", "* Cause it's not working./%%");
ds_map_add(global.text_data_en, "obj_clamguy_98", "* O, k, k, k, k.../");
ds_map_add(global.text_data_en, "obj_clamguy_99", "* I'll be able to have a nice&  drink on the surface./%%");
ds_map_add(global.text_data_en, "obj_colorlever_77", "* (It's some kind of switch.^1)&* (There's a red-colored&  slot in the center.)/%%");
ds_map_add(global.text_data_en, "obj_colorlever_81", "* (The red switch has been&  turned on.)/%%");
ds_map_add(global.text_data_en, "obj_colorlever_89", "* (Click!^1)&* (The red key fits perfectly&  into the slot.)/%%");
ds_map_add(global.text_data_en, "obj_colorlever_98", "* (It's some kind of switch.^1)&* (There's a blue-colored&  slot in the center.)/%%");
ds_map_add(global.text_data_en, "obj_colorlever_102", "* (The blue switch has been&  turned on.)/%%");
ds_map_add(global.text_data_en, "obj_colorlever_110", "* (Click!^1)&* (The blue key fits perfectly&  into the slot.)/%%");
ds_map_add(global.text_data_en, "obj_colorlever_119", "* (It's some kind of switch.^1)&* (There's a green-colored&  slot in the center.)/%%");
ds_map_add(global.text_data_en, "obj_colorlever_123", "* (The green switch has been&  turned on.)/%%");
ds_map_add(global.text_data_en, "obj_colorlever_131", "* (Click!^1)&* (The green key fits perfectly&  into the slot.)/%%");
ds_map_add(global.text_data_en, "obj_colorlever_140", "* (It's some kind of switch.^1)&* (There's a yellow-colored&  slot in the center.)/%%");
ds_map_add(global.text_data_en, "obj_colorlever_144", "* (The yellow switch has been&  turned on.)/%%");
ds_map_add(global.text_data_en, "obj_colorlever_152", "* (Click!^1)&* (The yellow key fits perfectly&  into the slot.)/%%");
ds_map_add(global.text_data_en, "obj_controlspear_89", "* Aim with arrows and select with \*Z.");
ds_map_add(global.text_data_en, "obj_controlspear_90", "* Aim with \*A \*D and select with \*Z.");
ds_map_add(global.text_data_en, "obj_controlspear_132", "* Teabox - Blatantly correct choice.");
ds_map_add(global.text_data_en, "obj_controlspear_143", "* Hot Chocolate - Green cylinder.");
ds_map_add(global.text_data_en, "obj_controlspear_154", "* Soda - Sickly yellow liquid.");
ds_map_add(global.text_data_en, "obj_controlspear_165", "* Sugar - Goes in tea.");
ds_map_add(global.text_data_en, "obj_controlspear_176", "* Undyne.");
ds_map_add(global.text_data_en, "obj_controlspear_192", "* Fridge - Full of food.");
ds_map_add(global.text_data_en, "obj_controlspear_204", "* Sword - Acquired taste.");
ds_map_add(global.text_data_en, "obj_controlspear_select", "* Select with \*Z.");
ds_map_add(global.text_data_en, "obj_controlspear_218", "\E1* ... are you.../");
ds_map_add(global.text_data_en, "obj_controlspear_219", "\E5* Hitting on me????/%%");
ds_map_add(global.text_data_en, "obj_controlspear_223", "* ????????????????/%%");
ds_map_add(global.text_data_en, "obj_controlspear_235", "* The sugar is for&  tea^1, mmm'kay?/%%");
ds_map_add(global.text_data_en, "obj_controlspear_243", "* Oh^1, soda?/");
ds_map_add(global.text_data_en, "obj_controlspear_244", "\E4* Actually^1, even though&  you pointed to it^1,&  you don't look happy./");
ds_map_add(global.text_data_en, "obj_controlspear_245", "\E0* Heh^1, that's fine^1!&* I think soda's gross^1,&  too!/");
ds_map_add(global.text_data_en, "obj_controlspear_246", "\E4* It rots your teeth..^1.&* It rots your mind.../");
ds_map_add(global.text_data_en, "obj_controlspear_247", "\E1* IT ROTS YOUR FIGHTING&  SPIRIT!/");
ds_map_add(global.text_data_en, "obj_controlspear_248", "\E9* ... huh^1?&* Why do I have it?/");
ds_map_add(global.text_data_en, "obj_controlspear_249", "\E8* .../%%");
ds_map_add(global.text_data_en, "obj_controlspear_253", "* What^1?&* You wanna throw the&  spear at it?/%%");
ds_map_add(global.text_data_en, "obj_controlspear_261", "* Oh^1, you want some&  hot chocolate?/");
ds_map_add(global.text_data_en, "obj_controlspear_262", "\E1* Wait^1, wait^1, I just&  remembered..^1.&* That container's empty./");
ds_map_add(global.text_data_en, "obj_controlspear_263", "\E9* I stopped getting&  it because it was&  always a hassle.../");
ds_map_add(global.text_data_en, "obj_controlspear_264", "\E6* ASGORE kept getting&  marshmallows stuck in&  his beard./%%");
ds_map_add(global.text_data_en, "obj_controlspear_268", "* That container's empty./%%");
ds_map_add(global.text_data_en, "obj_controlspear_276", "\E9* ... tea^1, huh^1?&* Coming right up!/%%");
ds_map_add(global.text_data_en, "obj_controlspear_284", "* The fridge!^1?&* You want to have&  the entire fridge!?/");
ds_map_add(global.text_data_en, "obj_controlspear_285", "\E1* No!/%%");
ds_map_add(global.text_data_en, "obj_controlspear_291", "* Believe me^1, I would&  GLADLY give you your&  fill of swords./");
ds_map_add(global.text_data_en, "obj_controlspear_292", "\E9* If you weren't my&  beloved houseguest!/%%");
ds_map_add(global.text_data_en, "obj_convenientlamp_55", "* Just a conveniently-shaped&  lamp./%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_89", "* Ring.../");
ds_map_add(global.text_data_en, "obj_cookshowevent_90", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_cookshowevent_91", "* H-hey^1, it's kind of&  dark \M9in there^1, isn't&  it?/");
ds_map_add(global.text_data_en, "obj_cookshowevent_92", "\E6* Don't worry!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_93", "\E0*\M8 I'll hack into the&  light system and&  brighten it up!/%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_135", "* Oh no./%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_156", "* OHHHH YES!!!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_157", "* WELCOME^1, BEAUTIES, TO THE&  UNDERGROUND'S PREMIER COOKING&  SHOW!!!/%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_174", "* PRE-HEAT YOUR OVENS^1, BECAUSE&  WE'VE GOT A VERY SPECIAL&  RECIPE FOR YOU TODAY!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_175", "* WE'RE GOING TO BE MAKING.../");
ds_map_add(global.text_data_en, "obj_cookshowevent_176", "* A CAKE!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_177", "* MY LOVELY ASSISTANT HERE&  WILL GATHER THE INGREDIENTS./");
ds_map_add(global.text_data_en, "obj_cookshowevent_178", "* EVERYONE GIVE THEM A BIG&  HAND!!!/%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_202", "\W* WE'LL NEED \YSUGAR^1,&  MILK^1, \WAND\Y EGGS.\W /");
ds_map_add(global.text_data_en, "obj_cookshowevent_203", "* GO FOR IT^1, SWEETHEART!/%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_253", "\W* A \YHUMAN SOUL\W!!!!/%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_295", "* Ring.../");
ds_map_add(global.text_data_en, "obj_cookshowevent_296", "\TS \E3 \F0 \TM %");
ds_map_add(global.text_data_en, "obj_cookshowevent_297", "* HELLO...?&* I'M KIND OF IN THE&  MIDDLE OF SOMETHING HERE./");
ds_map_add(global.text_data_en, "obj_cookshowevent_298", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_cookshowevent_299", "* W-wait a second!!!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_300", "* Couldn't you make&  a.../");
ds_map_add(global.text_data_en, "obj_cookshowevent_301", "\E6* Couldn't you use&  a.../");
ds_map_add(global.text_data_en, "obj_cookshowevent_302", "\E4* Couldn't you make&  a substitution in&  the recipe?!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_303", "\TS \E3 \F0 \TM %");
ds_map_add(global.text_data_en, "obj_cookshowevent_304", "* ... A SUBSTITUTION?&* YOU MEAN, USE A DIFFERENT,&  NON-HUMAN INGREDIENT?/");
ds_map_add(global.text_data_en, "obj_cookshowevent_305", "* ... WHY?/");
ds_map_add(global.text_data_en, "obj_cookshowevent_306", "\TS \E6 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_cookshowevent_307", "* Uhh^1, what if&  someone's.../");
ds_map_add(global.text_data_en, "obj_cookshowevent_308", "\E2* .../");
ds_map_add(global.text_data_en, "obj_cookshowevent_309", "\E4* Vegan?/");
ds_map_add(global.text_data_en, "obj_cookshowevent_310", "\TS \E3 \F0 \TM %");
ds_map_add(global.text_data_en, "obj_cookshowevent_311", "* ... VEGAN./");
ds_map_add(global.text_data_en, "obj_cookshowevent_312", "\TS \E5 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_cookshowevent_313", "* Uh well I mean%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_326", "* THAT'S A BRILLIANT IDEA,&  ALPHYS!!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_327", "* ACTUALLY, I HAPPEN TO&  HAVE AN OPTION RIGHT HERE!!!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_328", "* MTT-BRAND ALWAYS-CONVENIENT&  HUMAN-SOUL-FLAVOR-SUBSTITUTE!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_329", "* A CAN OF WHICH...&* IS JUST OVER ON THAT&  COUNTER!!!/%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_376", "* WELL, DARLING?&* WHY DON'T YOU GO GET IT?/%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_434", "* BY THE WAY^1, OUR SHOW RUNS ON&  A STRICT SCHEDULE./");
ds_map_add(global.text_data_en, "obj_cookshowevent_435", "\W* IF YOU CAN'T GET THE&  CAN IN THE NEXT&  \YONE MINUTE...\W /");
ds_map_add(global.text_data_en, "obj_cookshowevent_436", "\W* WE'LL JUST HAVE TO GO&  BACK TO THE \RORIGINAL PLAN\W!!!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_437", "* SO...&* BETTER START CLIMBING,&  BEAUTIFUL!!!/%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_472", "* Ring.../");
ds_map_add(global.text_data_en, "obj_cookshowevent_473", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_cookshowevent_474", "* Oh no!!^1!&* There's not enough&  time to climb up!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_475", "\E2* .../");
ds_map_add(global.text_data_en, "obj_cookshowevent_476", "\E6* F-f-fortunately, I&  might have a plan!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_477", "\E0* When I was upgrading&  your phone, I added&  a few... features./");
ds_map_add(global.text_data_en, "obj_cookshowevent_478", "\E6* You see that huge&  button that says..^1.&* \"JETPACK\"?/");ds_map_add(global.text_data_en, "obj_cookshowevent_479", "\E3* Watch this!/%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_515", "* There!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_516", "* You should have&  just enough fuel to&  reach the top!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_517", "\E3* Now^1, get up&  there!!!/%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_565", "* Ring.../");
ds_map_add(global.text_data_en, "obj_cookshowevent_566", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_cookshowevent_567", "* Wow^1!&* We..^1. we did it!!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_568", "\E0* We..^1. we really did&  it!!!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_569", "\E0* Great job out&  there^1, team!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_570", "\E3* W-well^1, uh^1, anyway^1,&  let's keep heading&  forward!!!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_571", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_cookshowevent_572", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_cookshowevent_575", "* Ring.../");
ds_map_add(global.text_data_en, "obj_cookshowevent_576", "\TS \E1 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_cookshowevent_577", "* .../");
ds_map_add(global.text_data_en, "obj_cookshowevent_578", "\E4* U-um..^1.&* I guess we..^1.&* ... did it?/");
ds_map_add(global.text_data_en, "obj_cookshowevent_579", "\E3* W-well^1, uh^1, anyway^1,&  let's keep heading&  forward!!!/");
ds_map_add(global.text_data_en, "obj_cookshowevent_580", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_cookshowevent_581", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_core_enemyevent_97", "* Ring.../");
ds_map_add(global.text_data_en, "obj_core_enemyevent_98", "\TS \E6 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_core_enemyevent_99", "* H-hey^1, why don't&  you try to use&  the elevator first?/");
ds_map_add(global.text_data_en, "obj_core_enemyevent_100", "* .../%%");
ds_map_add(global.text_data_en, "obj_core_enemyevent_106", "* Ring.../");
ds_map_add(global.text_data_en, "obj_core_enemyevent_107", "\TS \E6 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_core_enemyevent_108", "* H-hey^1, why don't&  you try to go&  to the right first?/");
ds_map_add(global.text_data_en, "obj_core_enemyevent_109", "* .../%%");
ds_map_add(global.text_data_en, "obj_core_enemyevent_116", "* Ring.../");
ds_map_add(global.text_data_en, "obj_core_enemyevent_117", "\TS \E6 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_core_enemyevent_118", "* Okay^1, you should&  be able to make&  it through here.../");
ds_map_add(global.text_data_en, "obj_core_enemyevent_119", "* .../%%");
ds_map_add(global.text_data_en, "obj_core_enemyevent_139", "* W-watch out!/%%");
ds_map_add(global.text_data_en, "obj_core_enemyevent_182", "* Th-that was close.../");
ds_map_add(global.text_data_en, "obj_core_enemyevent_183", "* Wh..^1. why are there&  so many monsters&  here?/");
ds_map_add(global.text_data_en, "obj_core_enemyevent_184", "\E6* I mean..^1.&* It's no problem^1,&  r-r-right?/");
ds_map_add(global.text_data_en, "obj_core_enemyevent_185", "* W-w-we've just got&  to keep heading&  forward!/");
ds_map_add(global.text_data_en, "obj_core_enemyevent_186", "\E9* .../");
ds_map_add(global.text_data_en, "obj_core_enemyevent_187", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_core_enemyevent_188", "* (Click...)/%%");
ds_map_add(global.text_data_en, "obj_core_enemyevent2_142", "* Ring.../");
ds_map_add(global.text_data_en, "obj_core_enemyevent2_143", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_core_enemyevent2_144", "* Sorry^1, I..^1. I.../");
ds_map_add(global.text_data_en, "obj_core_enemyevent2_145", "* I thought that.../");
ds_map_add(global.text_data_en, "obj_core_enemyevent2_146", "\E8* Let's try the&  right path instead./");
ds_map_add(global.text_data_en, "obj_core_enemyevent2_147", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_core_enemyevent2_148", "* (Click...)/%%");
ds_map_add(global.text_data_en, "obj_core_enemyevent2_152", "* Ring.../");
ds_map_add(global.text_data_en, "obj_core_enemyevent2_153", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_core_enemyevent2_154", "* A-are you okay?/");
ds_map_add(global.text_data_en, "obj_core_enemyevent2_155", "* Why didn't you&  head to the&  right...?/");
ds_map_add(global.text_data_en, "obj_core_enemyevent2_156", "\E4* C-C'mon..^1.&* Y-you trust me^1,&  d-don't you?/");
ds_map_add(global.text_data_en, "obj_core_enemyevent2_157", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_core_enemyevent2_158", "* (Click...)/%%");
ds_map_add(global.text_data_en, "obj_core_laserswitch_118", "* Ring.../");
ds_map_add(global.text_data_en, "obj_core_laserswitch_119", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_core_laserswitch_120", "* Oh my god^1, are&  you okay?/");
ds_map_add(global.text_data_en, "obj_core_laserswitch_121", "\E8* I..^1. I'm sorry^1, I&  gave you the&  wrong order./");
ds_map_add(global.text_data_en, "obj_core_laserswitch_122", "\E8* .../");
ds_map_add(global.text_data_en, "obj_core_laserswitch_123", "\E6* E-everything's fine^1,&  okay?/");
ds_map_add(global.text_data_en, "obj_core_laserswitch_124", "* L-let's just keep&  heading to the&  right./");
ds_map_add(global.text_data_en, "obj_core_laserswitch_125", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_core_laserswitch_126", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_core_laserswitch_130", "* Ring.../");
ds_map_add(global.text_data_en, "obj_core_laserswitch_131", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_core_laserswitch_132", "* Oh my god..^1.&* Are you hurt?/");
ds_map_add(global.text_data_en, "obj_core_laserswitch_133", "\E8* I..^1. I'm so sorry^1,&  I... I gave you&  the wrong order./");
ds_map_add(global.text_data_en, "obj_core_laserswitch_134", "\E8* .../");
ds_map_add(global.text_data_en, "obj_core_laserswitch_135", "\E6* Everything's going&  to be fine^1, okay?/");
ds_map_add(global.text_data_en, "obj_core_laserswitch_136", "* L-let's just keep&  heading to the&  right./");
ds_map_add(global.text_data_en, "obj_core_laserswitch_137", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_core_laserswitch_138", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_countermiddle_116", "* PERFECT^1!&* GREAT JOB^1, BEAUTIFUL!/");
ds_map_add(global.text_data_en, "obj_countermiddle_117", "* WE'VE GOT ALL OF THE&  INGREDIENTS WE NEED TO BAKE&  THE CAKE!/");
ds_map_add(global.text_data_en, "obj_countermiddle_118", "\W* \YMILK\W... &* \YSUGAR\W...&* \YEGGS\W.../");
ds_map_add(global.text_data_en, "obj_countermiddle_119", "* ... OH MY^1!&* WAIT A MAGNIFICENT MOMENT^1!&* HOW COULD I FORGET!!!/");
ds_map_add(global.text_data_en, "obj_countermiddle_120", "\W* WE'RE MISSING THE MOST&  \YIMPORTANT INGREDIENT\W!/%%");
ds_map_add(global.text_data_en, "obj_creditsloader_449", "\XI mean^1, we haven't&even done the\R &Special Thanks\X yet.../");
ds_map_add(global.text_data_en, "obj_creditsloader_450", "Ready^1?&Let's end all of&this for good!/%%");
ds_map_add(global.text_data_en, "obj_creditsloader_492", "Ha ha ha ha.../");
ds_map_add(global.text_data_en, "obj_creditsloader_493", "\M1Did you REALLY&think it was&OVER!?!?/%%");
ds_map_add(global.text_data_en, "obj_crygen3_56", "* Napstablook eagerly awaits&  your response.");
ds_map_add(global.text_data_en, "obj_crygen3_80", "do you&like&it...");
ds_map_add(global.text_data_en, "obj_crygen3_81", "%%%");
ds_map_add(global.text_data_en, "obj_crygen3_108", "i call&it&\"dapper&blook\"");ds_map_add(global.text_data_en, "obj_crygen3_109", "%%%");
ds_map_add(global.text_data_en, "obj_darkfridge_116", "* (It's a refrigerator.^1)&* (It's empty.)/%%");
ds_map_add(global.text_data_en, "obj_darkfridge_122", "* (It's a refrigerator.^1)&* (It seems to contain&  samples of some kind.)/%%");
ds_map_add(global.text_data_en, "obj_darkfridge_126", "* There's something here..^1.&* It feels like it's&  breathing./%%");
ds_map_add(global.text_data_en, "obj_darkfridge_133", "* (It's a refrigerator.^1)&* (It's empty.)/%%");
ds_map_add(global.text_data_en, "obj_darkfridge_136", "* There's something here..^1.&* It feels like a tree^1, ripe&  with delicious fruit./%%");
ds_map_add(global.text_data_en, "obj_darkfridge_142", "* (It's a refrigerator.^1)&* (It seems to contain&  samples of some kind.)/%%");
ds_map_add(global.text_data_en, "obj_darkfridge_145", "* There's something here..^1.&* Something in the shape&  of a man./%%");
ds_map_add(global.text_data_en, "obj_darkfridge_151", "* (It's a refrigerator.^1)&* (It's empty.)/%%");
ds_map_add(global.text_data_en, "obj_darkfridge_154", "* There's something here..^1.&* It feels warm^1, and moist./%%");
ds_map_add(global.text_data_en, "obj_darkplant_64", "* (It's a fake plant.)/%%");
ds_map_add(global.text_data_en, "obj_darksans1_187", "* heheh... the old whoopee&  cushion in the hand&  trick./");
ds_map_add(global.text_data_en, "obj_darksans1_188", "* it's ALWAYS funny./");
ds_map_add(global.text_data_en, "obj_darksans1_189", "* anyways^1,&  you're a human, right?/");
ds_map_add(global.text_data_en, "obj_darksans1_190", "\E1* that's hilarious./");
ds_map_add(global.text_data_en, "obj_darksans1_193", "* heh^1, the old whoopee&  cushion in the hand&  trick.../");
ds_map_add(global.text_data_en, "obj_darksans1_194", "\E1* wait a sec..^1.&* have you heard it before&  or something?/");
ds_map_add(global.text_data_en, "obj_darksans1_195", "\E1* you turned around before&  i said to..^1.&* ... weird./");
ds_map_add(global.text_data_en, "obj_darksans1_196", "* ... whatever^1.&* you're a human^1, right?/");
ds_map_add(global.text_data_en, "obj_darksans1_198", "\E0* i'm sans^1.&* sans the skeleton./");
ds_map_add(global.text_data_en, "obj_darksans1_199", "* im actually supposed to&  be on watch for&  humans right now./");
ds_map_add(global.text_data_en, "obj_darksans1_200", "* but..^1. y'know.../");
ds_map_add(global.text_data_en, "obj_darksans1_201", "\E1* i dont really care about&  capturing anybody./");
ds_map_add(global.text_data_en, "obj_darksans1_202", "\E0* now my brother^1,&  papyrus.../");
ds_map_add(global.text_data_en, "obj_darksans1_203", "* he's a human-hunting&  FANATIC./");
ds_map_add(global.text_data_en, "obj_darksans1_204", "\E1* hey^1, actually^1, I think&  that's him over there./");
ds_map_add(global.text_data_en, "obj_darksans1_205", "\E0* i have an idea^1.&* go through this gate&  thingy./");
ds_map_add(global.text_data_en, "obj_darksans1_206", "* yeah, go right through^1.&* my bro made the bars&  too wide to stop anyone./%%");
ds_map_add(global.text_data_en, "obj_darksans1_210", "* heheh... the old whoopee&  cushion in the hand&  trick./");
ds_map_add(global.text_data_en, "obj_darksans1_211", "* it's ALWAYS funny./");
ds_map_add(global.text_data_en, "obj_darksans1_212", "* .../");
ds_map_add(global.text_data_en, "obj_darksans1_213", "\E1* that's^1, uh^1.&* your cue to laugh./");
ds_map_add(global.text_data_en, "obj_darksans1_214", "\E2* or^1, uh^1, to emote&  at all...?/");
ds_map_add(global.text_data_en, "obj_darksans1_215", "\E0* .../");
ds_map_add(global.text_data_en, "obj_darksans1_216", "\E1* (gee^1, lady^1, you really&  know how to pick&  'em, huh...?)/");
ds_map_add(global.text_data_en, "obj_darksans1_217", "\E2* OK^1, that's fine^1.&* everyone's got their&  own sense of humor./");
ds_map_add(global.text_data_en, "obj_darksans1_218", "\E0* i'm sans^1.&* sans the skeleton./");
ds_map_add(global.text_data_en, "obj_darksans1_219", "* im actually supposed to&  be on watch for&  humans right now./");
ds_map_add(global.text_data_en, "obj_darksans1_220", "* but..^1. y'know.../");
ds_map_add(global.text_data_en, "obj_darksans1_221", "\E1* i dont really care about&  capturing anybody./");
ds_map_add(global.text_data_en, "obj_darksans1_222", "\E0* now my brother^1,&  papyrus.../");
ds_map_add(global.text_data_en, "obj_darksans1_223", "* he's a human-hunting&  FANATIC./");
ds_map_add(global.text_data_en, "obj_darksans1_224", "\E1* hey^1, actually^1, I think&  that's him over there./");
ds_map_add(global.text_data_en, "obj_darksans1_225", "\E0* i have an idea^1.&* go through this gate&  thingy./");
ds_map_add(global.text_data_en, "obj_darksans1_226", "* yeah, go right through^1.&* my bro made the bars&  too wide to stop anyone./%%");
ds_map_add(global.text_data_en, "obj_darksans1_345", "* Human./");
ds_map_add(global.text_data_en, "obj_darksans1_346", "* Don't you know how&  to greet a new pal?/");
ds_map_add(global.text_data_en, "obj_darksans1_347", "* Turn around and shake&  my hand./%%");
ds_map_add(global.text_data_en, "obj_darksans1_354", "* Human./");
ds_map_add(global.text_data_en, "obj_darksans1_355", " %");
ds_map_add(global.text_data_en, "obj_darksans1_356", " %%");
ds_map_add(global.text_data_en, "obj_darksans1_399", "* quick^1, behind that&  conveniently-shaped&  lamp./%%");
ds_map_add(global.text_data_en, "obj_darksans1_457", "* sup^1, bro?/");
ds_map_add(global.text_data_en, "obj_darksans1_459", "YOU KNOW WHAT&\"SUP,^1\" BROTHER!/");ds_map_add(global.text_data_en, "obj_darksans1_460", "IT'S BEEN EIGHT&DAYS AND YOU&STILL HAVEN'T.../");
ds_map_add(global.text_data_en, "obj_darksans1_461", "RECALIBRATED^1.&YOUR^1.&PUZZLES^1!/");
ds_map_add(global.text_data_en, "obj_darksans1_462", "YOU JUST HANG&AROUND OUTSIDE&YOUR STATION!/");
ds_map_add(global.text_data_en, "obj_darksans1_463", "WHAT ARE YOU&EVEN DOING?!?/");
ds_map_add(global.text_data_en, "obj_darksans1_465", "* staring at this lamp^1.&* it's really cool^1.&* do you wanna look?/%%");
ds_map_add(global.text_data_en, "obj_darksans1_480", "NO!^1!&I DON'T HAVE&TIME FOR THAT!!/");
ds_map_add(global.text_data_en, "obj_darksans1_481", "WHAT IF A HUMAN&COMES THROUGH&HERE!?!/");
ds_map_add(global.text_data_en, "obj_darksans1_482", "I WANT TO BE&READY!!!/");
ds_map_add(global.text_data_en, "obj_darksans1_483", "I WILL BE THE ONE!&I MUST BE THE ONE!/");
ds_map_add(global.text_data_en, "obj_darksans1_484", "I WILL CAPTURE A&HUMAN!/%%");
ds_map_add(global.text_data_en, "obj_darksans1_496", "THEN^1, I^1, THE&GREAT PAPYRUS.../");
ds_map_add(global.text_data_en, "obj_darksans1_497", "WILL GET&ALL THE THINGS I&UTTERLY DESERVE!/");
ds_map_add(global.text_data_en, "obj_darksans1_498", "RESPECT..^1.&RECOGNITION.../");
ds_map_add(global.text_data_en, "obj_darksans1_499", "I WILL FINALLY&BE ABLE TO JOIN&THE ROYAL GUARD!/");
ds_map_add(global.text_data_en, "obj_darksans1_500", "PEOPLE WILL ASK^1,&TO^1, BE MY^1,&\"FRIEND?\"/");ds_map_add(global.text_data_en, "obj_darksans1_501", "\E2I WILL BATHE IN A&SHOWER OF KISSES&EVERY MORNING./%%");
ds_map_add(global.text_data_en, "obj_darksans1_514", "* hmm.../");
ds_map_add(global.text_data_en, "obj_darksans1_515", "\E1* maybe this lamp will&  help you./%%");
ds_map_add(global.text_data_en, "obj_darksans1_528", "SANS!^1! YOU ARE&NOT HELPING!^1!&YOU LAZYBONES!!/");
ds_map_add(global.text_data_en, "obj_darksans1_529", "ALL YOU DO IS SIT&AND BOONDOGGLE!/");
ds_map_add(global.text_data_en, "obj_darksans1_530", "YOU GET LAZIER&AND LAZIER&EVERY DAY!!!/");
ds_map_add(global.text_data_en, "obj_darksans1_532", "\W* hey^1, take it easy^1.&* i've gotten a \Yton\W &  of work done today./");
ds_map_add(global.text_data_en, "obj_darksans1_533", "\W*\E2 a skele-\Yton\W./%%");
ds_map_add(global.text_data_en, "obj_darksans1_582", "SANS!!!/");
ds_map_add(global.text_data_en, "obj_darksans1_584", "\E1* come on^1.&* you're smiling./");
ds_map_add(global.text_data_en, "obj_darksans1_586", "I AM AND I HATE IT!/");
ds_map_add(global.text_data_en, "obj_darksans1_587", "\E3SIGH.../");
ds_map_add(global.text_data_en, "obj_darksans1_588", "\E2WHY DOES SOMEONE&AS GREAT AS ME.../");
ds_map_add(global.text_data_en, "obj_darksans1_589", "\E3HAVE TO DO SO MUCH&JUST TO GET SOME&RECOGNITION.../");
ds_map_add(global.text_data_en, "obj_darksans1_591", "* wow^1, sounds like&  you're really working&  yourself.../");
ds_map_add(global.text_data_en, "obj_darksans1_592", "\E2* down to the bone./%%");
ds_map_add(global.text_data_en, "obj_darksans1_604", "UGH!!!/");
ds_map_add(global.text_data_en, "obj_darksans1_605", "I WILL ATTEND TO&MY PUZZLES.../");
ds_map_add(global.text_data_en, "obj_darksans1_606", "\E3AS FOR YOUR WORK?/");
ds_map_add(global.text_data_en, "obj_darksans1_607", "PUT A LITTLE MORE,/");
ds_map_add(global.text_data_en, "obj_darksans1_608", "\E4\"BACKBONE\" INTO&IT!!!!/");ds_map_add(global.text_data_en, "obj_darksans1_609", "\E2NYEHEHEHEHEHE&HEHEHEHEHEHE!!!/%%");
ds_map_add(global.text_data_en, "obj_darksans1_644", "HEH!/%%");
ds_map_add(global.text_data_en, "obj_darksans1_666", "* ok^1, you can come out&  now./%%");
ds_map_add(global.text_data_en, "obj_darksans1_720", "* .../");
ds_map_add(global.text_data_en, "obj_darksans1_721", "\E1* uh^1, ok^1, i guess you&  don't have to./%%");
ds_map_add(global.text_data_en, "obj_darksans1_750", "SANS!!^1!&HAVE YOU FOUND A&HUMAN YET!??!/");
ds_map_add(global.text_data_en, "obj_darksans1_752", "* yeah./");
ds_map_add(global.text_data_en, "obj_darksans1_754", "REALLY!?!^1?&WOWIE!!!/");
ds_map_add(global.text_data_en, "obj_darksans1_755", "GUESS THAT'S&SETTLED!!/%%");
ds_map_add(global.text_data_en, "obj_darksans1_780", "* that worked out^1, huh?/%%");
ds_map_add(global.text_data_en, "obj_darksausagenpc_72", "* Why do I look like a weird&  black sausage^1?&* Just the angle./%%");
ds_map_add(global.text_data_en, "obj_darksausagenpc_76", "* As a youth^1, I would sneak&  out to play by this creepy&  flaming pit./");
ds_map_add(global.text_data_en, "obj_darksausagenpc_77", "* Since the CORE is always&  re-arranging^1, it was like&  a game trying to find it./");
ds_map_add(global.text_data_en, "obj_darksausagenpc_78", "* Now it is my special place^1.&* It is nice for cooking s'mores&  and things like that./%%");
ds_map_add(global.text_data_en, "obj_darksausagenpc_83", "* We were hired by Mettaton&  to destroy you./");
ds_map_add(global.text_data_en, "obj_darksausagenpc_84", "* But since he never paid us^1,&  we all decided to quit./");
ds_map_add(global.text_data_en, "obj_darksausagenpc_85", "* No hard feelings./%%");
ds_map_add(global.text_data_en, "obj_darksausagenpc_90", "* Zzzzzzz.../");
ds_map_add(global.text_data_en, "obj_darksausagenpc_91", "* (It's taking a nap.)/%%");
ds_map_add(global.text_data_en, "obj_darksausagenpc_96", "* Why do I look like a black&  sausage and not a knight&  or a wizard?/");
ds_map_add(global.text_data_en, "obj_darksausagenpc_97", "* Well..^1.&* Everyone has an angle they&  look best from../%%");
ds_map_add(global.text_data_en, "obj_darksausagenpc_102", "* The core is made up of&  interchangable rooms./");
ds_map_add(global.text_data_en, "obj_darksausagenpc_103", "* Before you came here^1, the&  layout was altered so you&  would get lost and perish./");
ds_map_add(global.text_data_en, "obj_darksausagenpc_104", "* Yes^1. Just for you^1.&* Do you feel special?/%%");
ds_map_add(global.text_data_en, "obj_darksink_91", "* Error./%%");
ds_map_add(global.text_data_en, "obj_darksink_98", "* (You turned on the sink.)/%%");
ds_map_add(global.text_data_en, "obj_darksink_100", "* (You really like to wash&  your hands.)/%%");
ds_map_add(global.text_data_en, "obj_darksink_110", "* (You turned off the sink.)/%%");
ds_map_add(global.text_data_en, "obj_darksink_122", "* (You turned on the sink.)/%%");
ds_map_add(global.text_data_en, "obj_darksink_132", "* (There's a red key lying&  in the sink.)/");
ds_map_add(global.text_data_en, "obj_darksink_133", "* (You took it and put it&  on your keychain.)/%%");
ds_map_add(global.text_data_en, "obj_dateheart_158", "\E3I SEE^1. I SEE./");
ds_map_add(global.text_data_en, "obj_dateheart_159", "\E0YOU LIKE CARESSING&MY BICEPS WITH A&FLOATING HEART./");
ds_map_add(global.text_data_en, "obj_dateheart_160", "\E1BUT WHO DOESN'T!?/%%");
ds_map_add(global.text_data_en, "obj_dateheart_161", "\E0TRY AGAIN!/%%");
ds_map_add(global.text_data_en, "obj_dateheart_165", "\E0THIS SHIRT DIDN'T&ORIGINALLY SAY&'COOL^1,' BUT I&IMPROVED IT./");
ds_map_add(global.text_data_en, "obj_dateheart_166", "EXPERT TIP^1: ALL&CLOTHING ARTICLES&CAN BE IMPROVED&THIS WAY./%%");
ds_map_add(global.text_data_en, "obj_dateheart_167", "\E1BUT THAT'S NOT A&SECRET!!!/");
ds_map_add(global.text_data_en, "obj_dateheart_168", "IT'S JUST GOOD&ADVICE!!!/%%");
ds_map_add(global.text_data_en, "obj_dateheart_172", "\E2HOLDING MY HAND&SO I'LL TELL&YOU THE ANSWER.../");
ds_map_add(global.text_data_en, "obj_dateheart_173", "\E7NO!!^1!&I MUST RESIST!!/%%");
ds_map_add(global.text_data_en, "obj_dateheart_177", "\E0THERE'S NO SECRET&TO MY LEGS./");
ds_map_add(global.text_data_en, "obj_dateheart_178", "JUST HARD WORK&AND PERSEVERANCE.../%%");
ds_map_add(global.text_data_en, "obj_dateheart_182", "\E3HUMAN SOULS ARE&STRONGER THAN&MONSTER SOULS.../");
ds_map_add(global.text_data_en, "obj_dateheart_183", "\E0BUT THE SOLES OF&OUR SHOES ON THE&OTHER HAND...!/");
ds_map_add(global.text_data_en, "obj_dateheart_184", "\E3... ARE ABOUT THE&SAME./%%");
ds_map_add(global.text_data_en, "obj_dateheart_188", "HAT DIALOGUE./%%");
ds_map_add(global.text_data_en, "obj_dateheart_365", "\E0I UNDERSTAND&WHY YOU'RE&RUNNING AWAY./");
ds_map_add(global.text_data_en, "obj_dateheart_366", "\E2YOU'RE OVERWHELMED&BY THE SIGHT OF&MY COOL VIBES./");
ds_map_add(global.text_data_en, "obj_dateheart_367", "\E0BUT YOU CAN'T&BACK DOWN NOW!!!/%%");
ds_map_add(global.text_data_en, "obj_diamondkid_73", "\W* My fave Mettaton Moment(TM)^1?&* Right \Ywhen everything looks the&  baddest^1, he poses dramatically\W./");
ds_map_add(global.text_data_en, "obj_diamondkid_74", "* Like when he's on a cooking&  show and the eggs don't turn&  out right./%%");
ds_map_add(global.text_data_en, "obj_diamondkid_78", "* But^1!&* Then he says!/");
ds_map_add(global.text_data_en, "obj_diamondkid_79", "\W* Even if you suck at cooking^1,&  you can always \Ybuy an&  MTT-brand Glamburger\W!/");
ds_map_add(global.text_data_en, "obj_diamondkid_80", "\W* Then he \Yeats one^1!\W &* Everyone loves it!/");
ds_map_add(global.text_data_en, "obj_diamondkid_81", "* ... How does he eat it&  without a mouth?/");
ds_map_add(global.text_data_en, "obj_diamondkid_82", "* Uhhh... well..^1.&* Watch the show!/%%");
ds_map_add(global.text_data_en, "obj_diamondkid_87", "* That finale was really..^1.&* That was really sad!/");
ds_map_add(global.text_data_en, "obj_diamondkid_88", "* And Mettaton's schedule&  doesn't show any other&  shows.../%%");
ds_map_add(global.text_data_en, "obj_diamondkid_93", "* I've been thinking about&  getting a sick skateboard./%%");
ds_map_add(global.text_data_en, "obj_diamondkid_98", "\W* My fave Mettaton Moment(TM)&  is when he beats up the&  \Yheel-turning villains\W!/");
ds_map_add(global.text_data_en, "obj_diamondkid_99", "* Even if it's during what's&  supposed to be a quiz show./%%");
ds_map_add(global.text_data_en, "obj_diamondkid_106", "* Oh^1! And I like when he tries&  on all kinds of different&  fashionable outfits!/");
ds_map_add(global.text_data_en, "obj_diamondkid_107", "* Even if it's during what's&  supposed to be a newscast./%%");
ds_map_add(global.text_data_en, "obj_diamondkid_112", "* Did Mettaton retire...?/");
ds_map_add(global.text_data_en, "obj_diamondkid_113", "* Can't he unretire...?/%%");
ds_map_add(global.text_data_en, "obj_diamondkid_119", "* On the surface we'll be able&  to watch all kinds of TV.../");
ds_map_add(global.text_data_en, "obj_diamondkid_120", "* But^1, I bet none of those&  shows are as good as&  Mettaton's!/%%");
ds_map_add(global.text_data_en, "obj_disembodiedfoxhead_60", "* The door leading through&  the area is closed^1?&* So I tried the puzzle?/");
ds_map_add(global.text_data_en, "obj_disembodiedfoxhead_61", "* But I kept running out of&  ammo^1, and it kept restarting?/");
ds_map_add(global.text_data_en, "obj_disembodiedfoxhead_62", "* And my two co-workers won't&  help^1? It's like they don't&  even wanna go to work?/%%");
ds_map_add(global.text_data_en, "obj_disembodiedfoxhead_63", "* Why don't you try^1?&* Try using the console?/%%");
ds_map_add(global.text_data_en, "obj_disembodiedfoxhead_67", "* Wow^1?&* You solved it?/");
ds_map_add(global.text_data_en, "obj_disembodiedfoxhead_68", "* I'm impressed^1?&* You must be a total nerd?/%%");
ds_map_add(global.text_data_en, "obj_disembodiedfoxhead_73", "* So we're all gonna go&  free...?/");
ds_map_add(global.text_data_en, "obj_disembodiedfoxhead_74", "* Does that mean I don't&  get to go to work?/%%");
ds_map_add(global.text_data_en, "obj_disembodiedfoxhead_79", "* Maybe I don't want to go&  to work anymore...?/%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_400", "* Tra la la^1.&* The waters are wild today^1.&* That's good luck.../%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_401", "* Tra la la./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_402", "* Tra la la^1.&* The waters are wild today^1.&* That's bad luck.../%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_403", "* Tra la la^1.&* Eat a mushroom everyday./");
ds_map_add(global.text_data_en, "obj_dogboat_thing_404", "* Why^1?&* Then I know you're listening&  to me.../%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_405", "* Tra la la^1.&* Remember to take a break&  every-so-often.../%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_406", "* Tra la la^1.&* Did you ever hear the old&  song coming from the sea?/%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_407", "* Tra la la^1.&* What's inside an acorn^1?&* It's really just a mystery./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_408", "* Tra la la^1.&* Dancing on a boat is danger^1.&* But good exercise.../%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_409", "* Tra la la^1.&* I heard ASGORE has a favorite&  food./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_410", "* Tra la la^1.&* I heard spiders have a&  favorite food./");
ds_map_add(global.text_data_en, "obj_dogboat_thing_411", "* It's spiders./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_412", "* Tra la la^1.&* The piano plays the&  tinkling song./");
ds_map_add(global.text_data_en, "obj_dogboat_thing_413", "* Hmm..^1. tinkling./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_414", "* Tra la la^1.&* You can never have too&  many hot-dogs./");
ds_map_add(global.text_data_en, "obj_dogboat_thing_415", "* ... sadly^1, that's not true./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_416", "* Tra la la^1.&* Don't snoop behind people's&  houses.../");
ds_map_add(global.text_data_en, "obj_dogboat_thing_417", "* You might be mistaken for&  a trash-can./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_418", "* Tra la la^1.&* The angel is coming..^1.&* Tra la la./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_419", "* Hum hum hum^1. Hum hum hum^1.&* I'm having a little concert./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_420", "* Pet pet pet..^1.&* The neck stretches infinitely&  into the cosmos./");
ds_map_add(global.text_data_en, "obj_dogboat_thing_421", "* ... don't worry about it./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_422", "* Ah,/%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_423", "* Tra la la^1.&* What's a game you can play&  with a dog?/");
ds_map_add(global.text_data_en, "obj_dogboat_thing_424", "* Asking for a friend.../%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_425", "* Tra la la^1.&* Temmie Village.../");
ds_map_add(global.text_data_en, "obj_dogboat_thing_426", "* ... the room before the&  darkening lantern room./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_427", "* Tra la la^1.&* Why don't you sing with me^1.&* Tra la la./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_428", "* Tra la la^1.&* Uh oh^1.&* Suddenly^1, feeling tropical.../%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_429", "* Tra la la^1.&* Hmmm.../");
ds_map_add(global.text_data_en, "obj_dogboat_thing_430", "* I should have worn a few&  more pairs of pants today./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_431", "* Tra la la^1.&* Hmmm.../");
ds_map_add(global.text_data_en, "obj_dogboat_thing_432", "* I should have worn a few&  million more pairs of pants&  today./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_433", "* Tra la la^1.&* Tri li li^1.&* Tre le le./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_447", "* Tra la la^1.&* Somewhere^1, it's \[1]^1.&* So be careful./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_450", "* Tra la la^1.&* If it's hot or cold^1, you&  can count on me./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_451", "* Tra la la^1.&* The water is very wet today./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_452", "* Tra la la^1.&* The water is very dry today./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_453", "* Tra la la^1.&* What's my name^1?&* ... It doesn't really matter./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_454", "* Tra la la^1.&* Humans^1, monsters^1...&* Flowers./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_455", "* Tra la la^1.&* Beware of the man who&  speaks in hands./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_456", "* Tra la la^1.&* Beware of the man who came&  from the other world./%%");
ds_map_add(global.text_data_en, "obj_dogboat_thing_593", "* Come again some time^1.&* Tra la la./%%");
ds_map_add(global.text_data_en, "obj_dogetrigger1_108", "* Did something move^1?&* Was it my imagination?/");
ds_map_add(global.text_data_en, "obj_dogetrigger1_109", "* I can only see moving&  things./");
ds_map_add(global.text_data_en, "obj_dogetrigger1_110", "* If something WAS moving..^1.&* For example^1, a human.../");
ds_map_add(global.text_data_en, "obj_dogetrigger1_111", "* I'll make sure it NEVER&  moves again!/%%");
ds_map_add(global.text_data_en, "obj_dogetrigger1_114", "* Did something move^1?&* Was it my imagination?/");
ds_map_add(global.text_data_en, "obj_dogetrigger1_115", "* I can only see moving&  things./");
ds_map_add(global.text_data_en, "obj_dogetrigger1_116", "* H..^1. hey!&* I can't stop shivering&  all of a sudden./");
ds_map_add(global.text_data_en, "obj_dogetrigger1_117", "* Who..^1. who's there!?/%%");
ds_map_add(global.text_data_en, "obj_dogetrigger1_156", "* S-S-S-Something pet me...&* Something that isn't&  m-m-moving.../");
ds_map_add(global.text_data_en, "obj_dogetrigger1_157", "* I'm gonna need some dog&  treats for this!!!/%%");
ds_map_add(global.text_data_en, "obj_dogetrigger1_160", "* A stick appeared out of&  nowhere^1, then disappeared./");
ds_map_add(global.text_data_en, "obj_dogetrigger1_161", "* Was it a ghost stick?/");
ds_map_add(global.text_data_en, "obj_dogetrigger1_162", "* Did I just return it to&  the afterlife?/");
ds_map_add(global.text_data_en, "obj_dogetrigger1_163", "* I need some dog treats&  to think about this./%%");
ds_map_add(global.text_data_en, "obj_dogfood_98", "* (Unfortunately^1, it's just&  dry food.)/%%");
ds_map_add(global.text_data_en, "obj_dogfood_99", "* (There's a hot dog cut up&  into the kibble.)/%%");
ds_map_add(global.text_data_en, "obj_dogfoodbag_57", "* (It's a half-empty bag&  of dog food.)/%%");
ds_map_add(global.text_data_en, "obj_dogfoodbag_59", "* (It's a bag of dog food.^1)&* (It's half-full.)/%%");
ds_map_add(global.text_data_en, "obj_dogfoodbag_63", "* (It's a half-empty bag&  of dog food.)/");
ds_map_add(global.text_data_en, "obj_dogfoodbag_64", "* (...)/");
ds_map_add(global.text_data_en, "obj_dogfoodbag_65", "* (You just remembered&  something funny.)/%%");
ds_map_add(global.text_data_en, "obj_dogfoodbag_68", "* (It's too dark to see&  near the walls.)/%%");
ds_map_add(global.text_data_en, "obj_doggiebed_98", "* (It's too small to sleep&  on.)/%%");
ds_map_add(global.text_data_en, "obj_dogneckparent_99", "* It's the broken head of&  a snowdog./%%");
ds_map_add(global.text_data_en, "obj_dogpillarparent_117", "* Seems like the base of a&  snowdog./%%");
ds_map_add(global.text_data_en, "obj_dogpillarparent_118", "* It's a pile of mushy snow./%%");
ds_map_add(global.text_data_en, "obj_dogpillarparent_119", "* This dog is staring blankly&  into the snow^1, waiting for&  it to turn into art./%%");
ds_map_add(global.text_data_en, "obj_dogringbell_148", "* Hello^1?&* Is anybody there...^1?&* No?/%%");
ds_map_add(global.text_data_en, "obj_dogringbell_149", "* Are you two playing a trick&  on me^1?&* Real funny./%%");
ds_map_add(global.text_data_en, "obj_dogringbell_150", "* Big guy^1?&* Is that you^1?&* Come on.../%%");
ds_map_add(global.text_data_en, "obj_dogringbell_151", "* Well^1, it's not the tall&  skeleton..^1.&* He's too loud./%%");
ds_map_add(global.text_data_en, "obj_dogringbell_152", "* Whoever you are^1, knock it&  off!!!/%%");
ds_map_add(global.text_data_en, "obj_dogringbell_153", "* .../%%");
ds_map_add(global.text_data_en, "obj_dogroom_npc_74", "* That dog considers itself&  an artist^1, but doesn't ever&  know what to create./");
ds_map_add(global.text_data_en, "obj_dogroom_npc_75", "* It probably doesn't help&  that its brain is the size&  of a piece of kibble./%%");
ds_map_add(global.text_data_en, "obj_dogroom_npc_79", "* That dog from earlier...^1?&* It's at Grillby's^1.&* I think./");
ds_map_add(global.text_data_en, "obj_dogroom_npc_80", "* After work^1, all of the dogs&  go there to play cards&  together./");
ds_map_add(global.text_data_en, "obj_dogroom_npc_81", "* But that dog doesn't really&  know how to express itself./");
ds_map_add(global.text_data_en, "obj_dogroom_npc_82", "* So^1, it ends up playing alone^1,&  instead of introducing&  itself to the others.../%%");
ds_map_add(global.text_data_en, "obj_dogroom_npc_87", "* A dog just rushed in here^1,&  filled with inspiration./");
ds_map_add(global.text_data_en, "obj_dogroom_npc_88", "* It kept trying to build&  a snowdog that expressed&  its own emotions.../");
ds_map_add(global.text_data_en, "obj_dogroom_npc_89", "* But^1, as it built^1, it&  kept getting more excited&  about the sculpture.../");
ds_map_add(global.text_data_en, "obj_dogroom_npc_90", "* Its neck got longer and&  longer^1, and it added more&  and more snow^1, until.../");
ds_map_add(global.text_data_en, "obj_dogroom_npc_91", "* It was rather sad to watch^1,&  but I couldn't turn away./%%");
ds_map_add(global.text_data_en, "obj_dogroom_npc_96", "* We're all free?/");
ds_map_add(global.text_data_en, "obj_dogroom_npc_97", "* OK^1, OK..^1.&* I'll stop lounging around^1.&* Does that dog know?/");
ds_map_add(global.text_data_en, "obj_dogroom_npc_98", "* ... it probably doesn't^1,&  does it...?/%%");
ds_map_add(global.text_data_en, "obj_dogtreat_99", "* (Someone's been smoking&  dog treats.)/%%");
ds_map_add(global.text_data_en, "obj_doodlebug_368", "* DOODLEBOG - ? ATK ? DEF&* Art lets your wildest&  fantasies come to life!/^");
ds_map_add(global.text_data_en, "obj_doodlebug_371", "* DOODLEBOG C - ? ATK ? DEF&* The \"C\" stands for \"seafaring.\"&* It likes to ride in a boat./^");ds_map_add(global.text_data_en, "obj_doodlebug_381", "* You draw a boat.&* Away it goes./^");
ds_map_add(global.text_data_en, "obj_doublesans_75", "* say.../");
ds_map_add(global.text_data_en, "obj_doublesans_76", "\E1* are you following me?/%%");
ds_map_add(global.text_data_en, "obj_doublesans_77", "* are you lost?/%%");
ds_map_add(global.text_data_en, "obj_dummymonster_213", " ^1.^1.^1.^1.^1.");
ds_map_add(global.text_data_en, "obj_dummymonster_222", "%%%");
ds_map_add(global.text_data_en, "obj_dummymonster_394", "* Dummy looks like it's&  going to fall over.");
ds_map_add(global.text_data_en, "obj_dummymonster_395", "* Dummy stands around&  absentmindedly.");
ds_map_add(global.text_data_en, "obj_dummymonster_400", "* Dummy tires of your&  aimless shenanigans.");
ds_map_add(global.text_data_en, "obj_dummymonster_437", "* DUMMY - ATK 0 DEF 0^1 &* A cotton heart and a button ey^1e* You are the apple of my eye/%%");
ds_map_add(global.text_data_en, "obj_dummymonster_445", "* You talk to the DUMMY^2.&* .../");
ds_map_add(global.text_data_en, "obj_dummymonster_446", "* It doesn't seem much for&  conversation./");
ds_map_add(global.text_data_en, "obj_dummymonster_447", "* TORIEL seems happy with you./%%");
ds_map_add(global.text_data_en, "obj_dummytrigger_222", "* Hahaha..^1.&* It's just like you to&  run away./");
ds_map_add(global.text_data_en, "obj_dummytrigger_223", "* FOOL^1!&* You think you can hurt&  ME???/");
ds_map_add(global.text_data_en, "obj_dummytrigger_224", "* Hahaha..^1.&* Too intimidated to fight&  me^1, huh!?/");
ds_map_add(global.text_data_en, "obj_dummytrigger_225", "* I am a ghost that lives&  inside a DUMMY./");
ds_map_add(global.text_data_en, "obj_dummytrigger_226", "* My cousin used to live&  inside a DUMMY^1, too^1.&* Until.../");
ds_map_add(global.text_data_en, "obj_dummytrigger_229", "* YOU CAME ALONG!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_230", "* They were a shy sort^1.&* Living a lonely life in&  the RUINS.../");
ds_map_add(global.text_data_en, "obj_dummytrigger_231", "* They saw you and hoped you&  might TALK to them./");
ds_map_add(global.text_data_en, "obj_dummytrigger_232", "* Perhaps strike up a&  friendly conversation./");
ds_map_add(global.text_data_en, "obj_dummytrigger_233", "* But NO!!!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_234", "* You ran away..^1.&* And broke their little&  ethereal heart./");
ds_map_add(global.text_data_en, "obj_dummytrigger_235", "* Despicable^1.&* Despicable^1!&* DESPICABLE!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_236", "* HUMAN^1!&* I'll show you what REAL&  heartbreak is!/%%");
ds_map_add(global.text_data_en, "obj_dummytrigger_241", "* YOU DESTROYED THEIR HOME!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_242", "* Us ghosts spend our whole&  lives looking for a&  proper vessel./");
ds_map_add(global.text_data_en, "obj_dummytrigger_243", "* Slowly^1, slowly^1, we grow&  closer to our new&  bodies.../");
ds_map_add(global.text_data_en, "obj_dummytrigger_244", "* Until one day^1, we too&  may become corporeal&  beings./");
ds_map_add(global.text_data_en, "obj_dummytrigger_245", "* Beings able to laugh^1,&  love^1, and dance like&  any other.../");
ds_map_add(global.text_data_en, "obj_dummytrigger_246", "* But YOU!!!^1!&* My cousin's future...^1!&* You took it all away!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_251", "* Despicable^1.&* Despicable^1!&* DESPICABLE!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_252", "* HUMAN^1!&* I hope you're not too&  attached to YOUR body.../");
ds_map_add(global.text_data_en, "obj_dummytrigger_253", "* Because your SOUL's about&  to get EVICTED!!!/%%");
ds_map_add(global.text_data_en, "obj_dummytrigger_257", "* YOU CAME ALONG!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_258", "* When you talked to them^1,&  they thought they were&  in for a nice chat.../");
ds_map_add(global.text_data_en, "obj_dummytrigger_259", "* But the things you&  SAID...!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_260", "* Horrible^1.&* Shocking^1!&* UNBELIEVABLE!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_261", "* It spooked them right&  out of their dummy!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_262", "* HUMAN^1!&* I'll scare your SOUL&  out of your body!/%%");
ds_map_add(global.text_data_en, "obj_dummytrigger_267", "* YOU...!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_268", "* You.../");
ds_map_add(global.text_data_en, "obj_dummytrigger_269", "* Shucks^1!&* You were really boring!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_270", "* They got annoyed and flew&  away like any self-&  respecting spectre./");
ds_map_add(global.text_data_en, "obj_dummytrigger_271", "* Well then^1.&* Well then!&* WELL THEN!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_272", "* Boring people are crumbs&  sticking to the face&  of this world./");
ds_map_add(global.text_data_en, "obj_dummytrigger_273", "* Human!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_274", "* I'll wipe you away with&  the dainty handkerchief&  of vengeance!/%%");
ds_map_add(global.text_data_en, "obj_dummytrigger_279", "* Hahaha..^1.&* It's just like you to&  run away./");
ds_map_add(global.text_data_en, "obj_dummytrigger_280", "* FOOL^1!&* You think you can hurt&  ME???/");
ds_map_add(global.text_data_en, "obj_dummytrigger_281", "* Hahaha..^1.&* Too intimidated to fight&  me^1, huh!?/");
ds_map_add(global.text_data_en, "obj_dummytrigger_282", "* I am a ghost that lives&  inside a DUMMY./");
ds_map_add(global.text_data_en, "obj_dummytrigger_283", "* My cousin used to live&  inside a DUMMY^1, too^1.&* Until.../");
ds_map_add(global.text_data_en, "obj_dummytrigger_284", "* YOU CAME ALONG!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_285", "* Not only did YOUR actions&  cause them to leave their&  home.../");
ds_map_add(global.text_data_en, "obj_dummytrigger_286", "* But now all of their neighbors&  are gone^1, too!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_287", "* Despicable^1.&* Despicable^1!&* DESPICABLE!!!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_288", "* You're the worst person I've&  ever met^1!&* I've NEVER been more mad!!!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_289", "* Guooooohhhh!!!^1!&* My mannequin levels are&  going OFF THE CHARTS!!!/%%");
ds_map_add(global.text_data_en, "obj_dummytrigger_344", "* well..^1.&* i'm going to head home&  now.../");
ds_map_add(global.text_data_en, "obj_dummytrigger_345", "* oh..^1. umm..^1.&* feel free to \"come&  with\" if you want.../");ds_map_add(global.text_data_en, "obj_dummytrigger_346", "* but no pressure.../");
ds_map_add(global.text_data_en, "obj_dummytrigger_347", "* i understand if you're&  busy.../");
ds_map_add(global.text_data_en, "obj_dummytrigger_348", "* it's fine.../");
ds_map_add(global.text_data_en, "obj_dummytrigger_349", "* no worries.../");
ds_map_add(global.text_data_en, "obj_dummytrigger_350", "* just thought i'd&  offer.../%%");
ds_map_add(global.text_data_en, "obj_dummytrigger_354", "* well..^1.&* i'm going to head home&  now.../");
ds_map_add(global.text_data_en, "obj_dummytrigger_355", "* just warning you.../");
ds_map_add(global.text_data_en, "obj_dummytrigger_356", "* so you don't accidentally&  follow me to my&  house.../");
ds_map_add(global.text_data_en, "obj_dummytrigger_357", "* you probably wouldn't&  like that.../%%");
ds_map_add(global.text_data_en, "obj_dummytrigger_417", "* ...?/");
ds_map_add(global.text_data_en, "obj_dummytrigger_418", "* This..^1.&* This feeling...?/%%");
ds_map_add(global.text_data_en, "obj_dummytrigger_427", "* Eureka^1.&* Eureka^1!&* EUREKA!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_428", "* Human^1.&* That moment of unbridled&  emotion./");
ds_map_add(global.text_data_en, "obj_dummytrigger_429", "* It allowed me to finally&  fuse with my body!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_430", "* I'm fully corporeal now^1!&* My lifelong dream^1, realized!/");
ds_map_add(global.text_data_en, "obj_dummytrigger_431", "* In return^1, I guess I&  won't stomp you./");
ds_map_add(global.text_data_en, "obj_dummytrigger_432", "* How's that sound?/%%");
ds_map_add(global.text_data_en, "obj_echoflower_96", "* Error!/%%");
ds_map_add(global.text_data_en, "obj_echoflower_104", "* All that gives my life&  validation is explaining&  the Echo Flower.../");
ds_map_add(global.text_data_en, "obj_echoflower_105", "* No one can know.../%%");
ds_map_add(global.text_data_en, "obj_echoflower_110", "* This is an Echo Flower^1.&* It repeats the last thing&  it heard^1, over and over.../%%");
ds_map_add(global.text_data_en, "obj_echoflower_114", "* Neat^1, huh?/%%");
ds_map_add(global.text_data_en, "obj_echoflower_118", "* Never trust a flower..^1.&* That's one of the constants&  of this world./%%");
ds_map_add(global.text_data_en, "obj_echoflower_123", "* (It's strangely silent.)/%%");
ds_map_add(global.text_data_en, "obj_echoflower_130", "* Sitting behind rushing water..^1.&* It makes me feel relaxed./%%");
ds_map_add(global.text_data_en, "obj_echoflower_131", "* I swore I saw something..^1.&* Behind that rushing water.../%%");
ds_map_add(global.text_data_en, "obj_echoflower_135", "* I just wasn't ready for&  the responsibility./%%");
ds_map_add(global.text_data_en, "obj_echoflower_141", "* A long time ago^1, monsters would&  whisper their wishes to the&  stars in the sky./");
ds_map_add(global.text_data_en, "obj_echoflower_142", "* If you hoped with all your&  heart^1, your wish would come&  true./");
ds_map_add(global.text_data_en, "obj_echoflower_143", "* Now^1, all we have are these&  sparkling stones on the&  ceiling.../%%");
ds_map_add(global.text_data_en, "obj_echoflower_145", "* (It's strangely silent.)/%%");
ds_map_add(global.text_data_en, "obj_echoflower_150", "* Thousands of people wishing&  together can't be wrong!/");
ds_map_add(global.text_data_en, "obj_echoflower_151", "* The king will prove that./%%");
ds_map_add(global.text_data_en, "obj_echoflower_153", "* (It's strangely silent.)/%%");
ds_map_add(global.text_data_en, "obj_echoflower_156", "* C'mon^1, sis^1!&* Make a wish!/%%");
ds_map_add(global.text_data_en, "obj_echoflower_157", "* I wish my sister and I will&  see the real stars someday.../%%");
ds_map_add(global.text_data_en, "obj_echoflower_159", "* Ah..^1. seems my horoscope is&  the same as last week's.../%%");
ds_map_add(global.text_data_en, "obj_echoflower_161", "* (It's strangely silent.)/%%");
ds_map_add(global.text_data_en, "obj_echoflower_166", "* Sitting behind rushing water..^1.&* It makes me feel relaxed./%%");
ds_map_add(global.text_data_en, "obj_echoflower_171", "* Squeak./%%");
ds_map_add(global.text_data_en, "obj_echoflower_173", "* (It's strangely silent.)/%%");
ds_map_add(global.text_data_en, "obj_echoflower_178", "* (You hear a passing&  conversation.)/");
ds_map_add(global.text_data_en, "obj_echoflower_179", "* Don't say that^1!&* Come on^1, I promise I&  won't laugh./%%");
ds_map_add(global.text_data_en, "obj_echoflower_183", "* (You hear a passing&  conversation.)/");
ds_map_add(global.text_data_en, "obj_echoflower_184", "* So^1? Don't you have any&  wishes to make?/%%");
ds_map_add(global.text_data_en, "obj_echoflower_189", "* (You hear a passing&  conversation.)/");
ds_map_add(global.text_data_en, "obj_echoflower_190", "* ... hmmm^1, just one^1, but.../");
ds_map_add(global.text_data_en, "obj_echoflower_191", "* It's kind of stupid./%%");
ds_map_add(global.text_data_en, "obj_echoflower_194", "* (It's strangely silent.)/%%");
ds_map_add(global.text_data_en, "obj_echoflower_199", "* I can't run any longer..^1.&* Somebody^1, anybody.../%%");
ds_map_add(global.text_data_en, "obj_echoflower_205", "* Someday^1, I'd like to climb&  this mountain we're all&  buried under./%%");
ds_map_add(global.text_data_en, "obj_echoflower_209", "* (You hear a passing&  conversation.)/");
ds_map_add(global.text_data_en, "obj_echoflower_210", "* Sorry^1, it's just funny.../");
ds_map_add(global.text_data_en, "obj_echoflower_211", "* That's my wish^1, too./%%");
ds_map_add(global.text_data_en, "obj_echoflower_217", "* (You hear laughter.)/");
ds_map_add(global.text_data_en, "obj_echoflower_218", "* ... hey^1, you said you wouldn't&  laugh at it!/%%");
ds_map_add(global.text_data_en, "obj_echoflower_223", "* (You hear a passing&  conversation.)/");
ds_map_add(global.text_data_en, "obj_echoflower_224", "* Someday^1, I'd like to climb&  this mountain we're all&  buried under./");
ds_map_add(global.text_data_en, "obj_echoflower_225", "* Standing under the sky^1, looking&  at the world all around..^1.&* That's my wish./%%");
ds_map_add(global.text_data_en, "obj_echoflower_230", "* (You hear a passing&  conversation.)/");
ds_map_add(global.text_data_en, "obj_echoflower_231", "* Of course I won't laugh!/%%");
ds_map_add(global.text_data_en, "obj_echoflower_236", "* (You hear a passing&  conversation.)/");
ds_map_add(global.text_data_en, "obj_echoflower_237", "* ... hmmm..^1. if I say my wish..^1.&* You promise you won't&  laugh at me?/%%");
ds_map_add(global.text_data_en, "obj_echoflower_243", "* Where oh where could that&  child be...?/");
ds_map_add(global.text_data_en, "obj_echoflower_244", "* I've been looking all over&  for them.../");
ds_map_add(global.text_data_en, "obj_echoflower_245", "\TS* .../");
ds_map_add(global.text_data_en, "obj_echoflower_246", "\TF* Hee hee hee./");
ds_map_add(global.text_data_en, "obj_echoflower_247", "* THAT'S not true./");
ds_map_add(global.text_data_en, "obj_echoflower_248", "* She'll find another kid^1, and&  instantly forget about you./");
ds_map_add(global.text_data_en, "obj_echoflower_249", "* You'll NEVER see her again./%%");
ds_map_add(global.text_data_en, "obj_echoflower_253", "* Where am I...?/");
ds_map_add(global.text_data_en, "obj_echoflower_254", "* It's so cold here..^1.&* And so dark.../");
ds_map_add(global.text_data_en, "obj_echoflower_255", "* Someone help me..^1.&* Anyone..^1. please..^1.&* Help me.../");
ds_map_add(global.text_data_en, "obj_echoflower_256", "\TF* .../");
ds_map_add(global.text_data_en, "obj_echoflower_257", "* But nobody came./%%");
ds_map_add(global.text_data_en, "obj_echoflower_262", "* (It's strangely silent.)/%%");
ds_map_add(global.text_data_en, "obj_echoflower_301", "* (You stop to smell the&  flowers.)/%%");
ds_map_add(global.text_data_en, "obj_elevatordoor_215", "* (The elevator isn't working.)/");
ds_map_add(global.text_data_en, "obj_elevatordoor_218", "\S-\Sp* Ring...\S+/");
ds_map_add(global.text_data_en, "obj_elevatordoor_219", "\TS \E3 \F6 \TA %");
ds_map_add(global.text_data_en, "obj_elevatordoor_220", "* What^1?&* The elevator should&  be working.../");
ds_map_add(global.text_data_en, "obj_elevatordoor_221", "* .../");
ds_map_add(global.text_data_en, "obj_elevatordoor_222", "\E6* W-well then^1!&* Go to the right&  and keep heading up!/%%");
ds_map_add(global.text_data_en, "obj_elevatordoor_223", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_elevatordoor_224", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_elevatordoor_228", "\E6* W-well then^1!&* Let's go to the&  left!/%%");
ds_map_add(global.text_data_en, "obj_elevatordoor_229", "\TS \F0 \T0 %");
ds_map_add(global.text_data_en, "obj_elevatordoor_230", "* Click.../%%");
ds_map_add(global.text_data_en, "obj_elevatordoor_234", "* (The elevator isn't working.)/%%");
ds_map_add(global.text_data_en, "obj_elevatordoor_250", "* (The elevator isn't working.)/%%");
ds_map_add(global.text_data_en, "obj_elevatordoor_258", "* (The elevator is in use.)/%%");
ds_map_add(global.text_data_en, "obj_elevatorpanel_104", "* Please select a location./%%");
ds_map_add(global.text_data_en, "obj_endflowey_188", "\E0Why...?/");
ds_map_add(global.text_data_en, "obj_endflowey_189", "Why did you let me go? /");
ds_map_add(global.text_data_en, "obj_endflowey_190", "\E7Don't you realize that&being nice.../");
ds_map_add(global.text_data_en, "obj_endflowey_191", "\E1... just makes you&get hurt?/");
ds_map_add(global.text_data_en, "obj_endflowey_192", "\E0Look at yourself./");
ds_map_add(global.text_data_en, "obj_endflowey_193", "\E9You made all these&great friends.../");
ds_map_add(global.text_data_en, "obj_endflowey_194", "\E0But now^1, you'll probably&never see them again./");
ds_map_add(global.text_data_en, "obj_endflowey_195", "\E9Not to mention how&much they've been&set back by you./");
ds_map_add(global.text_data_en, "obj_endflowey_196", "\E6Hurts^1, doesn't it?/");
ds_map_add(global.text_data_en, "obj_endflowey_197", "\E7If you had just gone&through without caring&about anyone.../");
ds_map_add(global.text_data_en, "obj_endflowey_198", "\E6You wouldn't have to&feel bad now./");
ds_map_add(global.text_data_en, "obj_endflowey_199", "\E0So I don't get it./");
ds_map_add(global.text_data_en, "obj_endflowey_200", "\E7If you really did&everything the right&way../");
ds_map_add(global.text_data_en, "obj_endflowey_201", "\E0Why did things still&end up like this?/");
ds_map_add(global.text_data_en, "obj_endflowey_202", "\E6Why...?/");
ds_map_add(global.text_data_en, "obj_endflowey_203", "\E5Is life really&that unfair?/");
ds_map_add(global.text_data_en, "obj_endflowey_204", "\E9.../");
ds_map_add(global.text_data_en, "obj_endflowey_205", "\E0Say./");
ds_map_add(global.text_data_en, "obj_endflowey_206", "\E9What if I told you.../");
ds_map_add(global.text_data_en, "obj_endflowey_207", "\E0I knew some way&to get you a better&ending?/");
ds_map_add(global.text_data_en, "obj_endflowey_208", "\E9You'll have to load&your SAVE file, and.../");
ds_map_add(global.text_data_en, "obj_endflowey_211", "\E9You'll have to&start over^1, and.../");
ds_map_add(global.text_data_en, "obj_endflowey_216", "\E0Well, in the meantime^1,&why don't you go see&Dr. Alphys?/");
ds_map_add(global.text_data_en, "obj_endflowey_219", "\E0Well^1, in the meantime^1,&why don't you go see&Undyne?/");
ds_map_add(global.text_data_en, "obj_endflowey_223", "\E0Well^1, in the meantime^1,&why don't you go see&Papyrus^1, then Undyne?/");
ds_map_add(global.text_data_en, "obj_endflowey_226", "\E9It seems like you&could have been&better friends./");
ds_map_add(global.text_data_en, "obj_endflowey_227", "Who knows..^1. maybe&she's got the key&to your happiness...?/");
ds_map_add(global.text_data_en, "obj_endflowey_228", "\E4See you soon./%%");
ds_map_add(global.text_data_en, "obj_endflowey_242", "But^1, despite everything^1,&your happy ending&didn't come./");
ds_map_add(global.text_data_en, "obj_endflowey_243", "\E5Why...?/");
ds_map_add(global.text_data_en, "obj_endflowey_244", "\E4I know why./");
ds_map_add(global.text_data_en, "obj_endflowey_245", "\E4Go to Dr. Alphys./");
ds_map_add(global.text_data_en, "obj_endflowey_246", "\E5Your date with her&has really just&begun./%%");
ds_map_add(global.text_data_en, "obj_endflowey_259", "So you went the&whole way through&without killing.../");
ds_map_add(global.text_data_en, "obj_endflowey_260", "\E5And then you decided&to kill ASGORE?/");
ds_map_add(global.text_data_en, "obj_endflowey_261", "\E6What the hell is&WRONG with you?/");
ds_map_add(global.text_data_en, "obj_endflowey_262", "\E4You COMPLETELY missed&the point./");
ds_map_add(global.text_data_en, "obj_endflowey_263", "\E2Are you trolling me?/");
ds_map_add(global.text_data_en, "obj_endflowey_264", "\E0Because./");
ds_map_add(global.text_data_en, "obj_endflowey_265", "\E4No./");
ds_map_add(global.text_data_en, "obj_endflowey_266", "\E5You are only&trolling yourself./");
ds_map_add(global.text_data_en, "obj_endflowey_267", "\E6What a waste of&everybody's time./");
ds_map_add(global.text_data_en, "obj_endflowey_268", "\E7All you had to&do was make friends./");
ds_map_add(global.text_data_en, "obj_endflowey_269", "With Papyrus^1, Undyne^1,&and then Alphys./");
ds_map_add(global.text_data_en, "obj_endflowey_270", "\E2But you were too&busy messing it up!/%%");
ds_map_add(global.text_data_en, "obj_endflowey_284", "Hey./");
ds_map_add(global.text_data_en, "obj_endflowey_285", "Since you defeated me./");
ds_map_add(global.text_data_en, "obj_endflowey_286", "I've been thinking./");
ds_map_add(global.text_data_en, "obj_endflowey_287", "\E3Is killing things&really necessary?/");
ds_map_add(global.text_data_en, "obj_endflowey_288", "\E1I.../");
ds_map_add(global.text_data_en, "obj_endflowey_289", "\E3I honestly don't&know anymore./");
ds_map_add(global.text_data_en, "obj_endflowey_290", "\E0I have a request&for you./");
ds_map_add(global.text_data_en, "obj_endflowey_291", "\E4Prove to me.../");
ds_map_add(global.text_data_en, "obj_endflowey_292", "\E5Prove to me you&are strong enough&to survive./");
ds_map_add(global.text_data_en, "obj_endflowey_293", "\E6Get here from&the beginning./");
ds_map_add(global.text_data_en, "obj_endflowey_294", "\E0Without killing a&single thing.../");
ds_map_add(global.text_data_en, "obj_endflowey_296", "\E4... and I won't&kill the king./");
ds_map_add(global.text_data_en, "obj_endflowey_298", "\E4... and^1, maybe.../");
ds_map_add(global.text_data_en, "obj_endflowey_299", "\E7Then you'll have&your so-called&\"happy ending.\"/");ds_map_add(global.text_data_en, "obj_endflowey_300", "\E6So^1, what will&it be?/");
ds_map_add(global.text_data_en, "obj_endflowey_301", "\E5Will you prove&yourself?/");
ds_map_add(global.text_data_en, "obj_endflowey_302", "\E8Or will I get to&watch you suffer...?/");
ds_map_add(global.text_data_en, "obj_endflowey_303", "Either way^1, I'm&interested!!!/");
ds_map_add(global.text_data_en, "obj_endflowey_304", "\E4Hee hee hee.../%%");
ds_map_add(global.text_data_en, "obj_endflowey_319", "Interesting.../");
ds_map_add(global.text_data_en, "obj_endflowey_320", "\E6So^1, even with&everything you did.../");
ds_map_add(global.text_data_en, "obj_endflowey_321", "\E5The outcome's still&the same./");
ds_map_add(global.text_data_en, "obj_endflowey_322", "\E9In the end^1, your&choices were an&illusion./");
ds_map_add(global.text_data_en, "obj_endflowey_323", "\E9NOTHING you do&really matters!/");
ds_map_add(global.text_data_en, "obj_endflowey_324", "\E8Hee hee hee!/");
ds_map_add(global.text_data_en, "obj_endflowey_325", "\E8.../");
ds_map_add(global.text_data_en, "obj_endflowey_326", "\E0Well./");
ds_map_add(global.text_data_en, "obj_endflowey_327", "\E6You DID do what&I told you./");
ds_map_add(global.text_data_en, "obj_endflowey_328", "\E5I guess it's up&to me to get you a&REAL happy ending./");
ds_map_add(global.text_data_en, "obj_endflowey_329", "\E0For starters^1, you&can't do it by&yourself./");
ds_map_add(global.text_data_en, "obj_endflowey_330", "Papyrus^1, Undyne^1,&Alphys..^1. these guys./");
ds_map_add(global.text_data_en, "obj_endflowey_331", "\E4Are you friends with&all of them yet?/");
ds_map_add(global.text_data_en, "obj_endflowey_332", "\E5Maybe you should go&back and..^1. \"hang\"&with them./");ds_map_add(global.text_data_en, "obj_endflowey_333", "\E4The power of&friendship.../");
ds_map_add(global.text_data_en, "obj_endflowey_334", "That always saves&the day^1, right?/%%");
ds_map_add(global.text_data_en, "obj_endflowey_349", "\E0So^1, killing people&is ACTUALLY fine...?/");
ds_map_add(global.text_data_en, "obj_endflowey_350", "\E4Sure./");
ds_map_add(global.text_data_en, "obj_endflowey_351", "I'm glad we agree on&the value of a life./");
ds_map_add(global.text_data_en, "obj_endflowey_352", "I've learned SO&MUCH from you./");
ds_map_add(global.text_data_en, "obj_endflowey_353", "\E0Though..^1. are you&REALLY gonna keep&doing things halfway?/");
ds_map_add(global.text_data_en, "obj_endflowey_354", "\E8The amount of people&you killed.../");
ds_map_add(global.text_data_en, "obj_endflowey_355", "\E9It's honestly&DISAPPOINTING./");
ds_map_add(global.text_data_en, "obj_endflowey_356", "\E8You IDIOT./");
ds_map_add(global.text_data_en, "obj_endflowey_357", "\E4You really can't do&ANYTHING right./%%");
ds_map_add(global.text_data_en, "obj_endflowey_372", "Why^1, \[C]...?/");
ds_map_add(global.text_data_en, "obj_endflowey_373", "\E3Why?/");
ds_map_add(global.text_data_en, "obj_endflowey_374", "\E1WHY?/");
ds_map_add(global.text_data_en, "obj_endflowey_375", "\E8We were on our way&to REAL victory.../");
ds_map_add(global.text_data_en, "obj_endflowey_376", "\E9On our way to making&up for LAST time!/");
ds_map_add(global.text_data_en, "obj_endflowey_377", "\E2Why'd you have to&SCREW IT UP?/");
ds_map_add(global.text_data_en, "obj_endflowey_378", "\E5Hahaha.../");
ds_map_add(global.text_data_en, "obj_endflowey_379", "\E9Is this REVENGE?/");
ds_map_add(global.text_data_en, "obj_endflowey_382", "\E1Making me watch you&act so pure and&happy^1, while I...?/");
ds_map_add(global.text_data_en, "obj_endflowey_386", "\E1Making me watch you&live out your life^1,&while I...?/");
ds_map_add(global.text_data_en, "obj_endflowey_389", "\E1.../");
ds_map_add(global.text_data_en, "obj_endflowey_390", "\E7No./");
ds_map_add(global.text_data_en, "obj_endflowey_391", "\E8NO./");
ds_map_add(global.text_data_en, "obj_endflowey_392", "I KNOW what you're&doing./");
ds_map_add(global.text_data_en, "obj_endflowey_393", "You just want to see&what it's all like./");
ds_map_add(global.text_data_en, "obj_endflowey_394", "Before we TEAR IT&AWAY from them./");
ds_map_add(global.text_data_en, "obj_endflowey_395", "Ahahaha.../");
ds_map_add(global.text_data_en, "obj_endflowey_396", "\E9Genius^1, \[C]./");
ds_map_add(global.text_data_en, "obj_endflowey_397", "\E4Well^1, I'll let you&mess around./");
ds_map_add(global.text_data_en, "obj_endflowey_398", "\E8I know you'll come&back eventually./");
ds_map_add(global.text_data_en, "obj_endflowey_399", "\E9And when that time&comes.../");
ds_map_add(global.text_data_en, "obj_endflowey_400", "\E4\[C]./");
ds_map_add(global.text_data_en, "obj_endflowey_401", "\E4I'll be waiting&for you./%%");
ds_map_add(global.text_data_en, "obj_endflowey_415", "Why do you keep&coming back here?/");
ds_map_add(global.text_data_en, "obj_endflowey_416", "\E5Oh^1, I get it^1.&You wanna be friends^1,&huh...?/");
ds_map_add(global.text_data_en, "obj_endflowey_417", "\E8You're PATHETIC./");
ds_map_add(global.text_data_en, "obj_endflowey_418", "\E8You REALLY think I&want to be friends&with YOU?/");
ds_map_add(global.text_data_en, "obj_endflowey_419", "\E5Heh.../");
ds_map_add(global.text_data_en, "obj_endflowey_420", "\E9You really DON'T&get it^1, do you?/");
ds_map_add(global.text_data_en, "obj_endflowey_421", "\E5There's only one&person I could care&about anymore./");
ds_map_add(global.text_data_en, "obj_endflowey_422", "\E6And even then^1, I&couldn't TRULY care&about them./");
ds_map_add(global.text_data_en, "obj_endflowey_423", "\E5I just like to think&there's someone out&there.../");
ds_map_add(global.text_data_en, "obj_endflowey_424", "Someone that I&won't get tired of./");
ds_map_add(global.text_data_en, "obj_endflowey_425", "\E8Someone like ME./");
ds_map_add(global.text_data_en, "obj_endflowey_426", "\E8.../");
ds_map_add(global.text_data_en, "obj_endflowey_427", "\E0Say./");
ds_map_add(global.text_data_en, "obj_endflowey_428", "\E4Quit looking at me&with that stupid&expression./");
ds_map_add(global.text_data_en, "obj_endflowey_429", "You're pissing me&off./%%");
ds_map_add(global.text_data_en, "obj_endflowey_443", "\E0So you're here&again./");
ds_map_add(global.text_data_en, "obj_endflowey_444", "\E2What's wrong with&you?/");
ds_map_add(global.text_data_en, "obj_endflowey_445", "\E4Are you trying to&start the Flowey&Fan Club?/");
ds_map_add(global.text_data_en, "obj_endflowey_446", "\E5Because if you&want to join THAT.../");
ds_map_add(global.text_data_en, "obj_endflowey_447", "\E4You'll have to&talk to Papyrus./");
ds_map_add(global.text_data_en, "obj_endflowey_448", "\E6Yeah^1, he started&one./");
ds_map_add(global.text_data_en, "obj_endflowey_449", "\E5A few different&times^1, anyway./");
ds_map_add(global.text_data_en, "obj_endflowey_450", "\E0I won't lie./");
ds_map_add(global.text_data_en, "obj_endflowey_451", "\E4He's one of the&better characters&to mess around with./");
ds_map_add(global.text_data_en, "obj_endflowey_452", "\E5Took me a long&time to get bored&of that one./");
ds_map_add(global.text_data_en, "obj_endflowey_453", "\E7... Yeah./");
ds_map_add(global.text_data_en, "obj_endflowey_454", "\E4Talk to him&about it./%%");
ds_map_add(global.text_data_en, "obj_endflowey_468", "\E0So./");
ds_map_add(global.text_data_en, "obj_endflowey_469", "\E4Did you start the&Flowey Fan Club?/");
ds_map_add(global.text_data_en, "obj_endflowey_470", "\E5Ha^1.&I'm just kidding./");
ds_map_add(global.text_data_en, "obj_endflowey_471", "\E9I was watching^1.&I know you didn't./");
ds_map_add(global.text_data_en, "obj_endflowey_472", "\E5But I don't care^1.&Really./");
ds_map_add(global.text_data_en, "obj_endflowey_473", "\E6He probably would&have invited his&garbage brother./");
ds_map_add(global.text_data_en, "obj_endflowey_474", "\E4You know^1.&Smiley Trashbag./");
ds_map_add(global.text_data_en, "obj_endflowey_475", "\E0.../");
ds_map_add(global.text_data_en, "obj_endflowey_476", "\E4Say./");
ds_map_add(global.text_data_en, "obj_endflowey_477", "If I have ONE piece&of advice for you.../");
ds_map_add(global.text_data_en, "obj_endflowey_478", "\E9DON'T./");
ds_map_add(global.text_data_en, "obj_endflowey_479", "Let his brother./");
ds_map_add(global.text_data_en, "obj_endflowey_480", "Find out ANYTHING&about you./");
ds_map_add(global.text_data_en, "obj_endflowey_481", "\E6He'll..^1. well.../");
ds_map_add(global.text_data_en, "obj_endflowey_482", "\E5Let's just say./");
ds_map_add(global.text_data_en, "obj_endflowey_483", "\E9He's caused me more&than my fair share&of resets./");
ds_map_add(global.text_data_en, "obj_endflowey_484", "\E4Stay away from&that guy./%%");
ds_map_add(global.text_data_en, "obj_endflowey_498", "\E0Why do you keep&coming back here?/");
ds_map_add(global.text_data_en, "obj_endflowey_499", "You don't REALLY&want to be friends^1,&do you...?/");
ds_map_add(global.text_data_en, "obj_endflowey_500", ".../");
ds_map_add(global.text_data_en, "obj_endflowey_501", "\E4No^1. I get it./");
ds_map_add(global.text_data_en, "obj_endflowey_502", "You're just like me^1,&aren't you?/");
ds_map_add(global.text_data_en, "obj_endflowey_503", "You don't care about&anyone./");
ds_map_add(global.text_data_en, "obj_endflowey_504", "\E4You're just bored./");
ds_map_add(global.text_data_en, "obj_endflowey_505", "You just want to&see what I'll say./");
ds_map_add(global.text_data_en, "obj_endflowey_506", "\E5So you can laugh&and throw me away&like a broken toy./");
ds_map_add(global.text_data_en, "obj_endflowey_507", "\E8Well^1, TOO BAD!/");
ds_map_add(global.text_data_en, "obj_endflowey_508", "\E9I'm not LIKE everybody&else./");
ds_map_add(global.text_data_en, "obj_endflowey_509", "\E9So, from now on.../");
ds_map_add(global.text_data_en, "obj_endflowey_510", "\E4You're not getting&ANYTHING./%%");
ds_map_add(global.text_data_en, "obj_endflowey_524", ".../");
ds_map_add(global.text_data_en, "obj_endflowey_525", "\E4Don't you have&anything BETTER to do?/%%");
ds_map_add(global.text_data_en, "obj_endflowey_regret_111", "Hi./%%");
ds_map_add(global.text_data_en, "obj_endflowey_regret_128", "Seems as if everyone&is perfectly happy./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_129", "Monsters have returned&to the surface./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_130", "Peace and prosperity&will rule across the land./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_131", "\E6Take a deep breath./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_132", "\E5There's nothing left&to worry about./%%");
ds_map_add(global.text_data_en, "obj_endflowey_regret_148", "\E7.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_149", "\E6Well./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_150", "\E1There is one thing./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_151", "\E3One last threat./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_152", "One being with the&power to erase&EVERYTHING.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_153", "\E1Everything everyone's&worked so hard for./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_154", "\E7.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_155", "\E6You know who I'm&talking about^1, don't&you?/");
ds_map_add(global.text_data_en, "obj_endflowey_regret_156", "\E1That's right./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_157", "\E4I'm talking about YOU./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_158", "\E7YOU still have the&power to reset&everything./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_159", "\E0Toriel^1, Sans^1, Asgore^1,&Alphys, Papyrus, Undyne.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_160", "If you so choose.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_161", "Everyone will be&ripped from this&timeline.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_162", "... and sent back before&all of this&ever happened./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_163", "\E6Nobody will&remember anything./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_164", "\E5You'll be able to&do whatever you&want./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_165", "\E0.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_166", "\E7That power./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_167", "\E3I know that power./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_168", "\E6That's the power&you were fighting to&stop^1, wasn't it?/");
ds_map_add(global.text_data_en, "obj_endflowey_regret_169", "\E7The power that I&wanted to use./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_170", "\E6But now^1, the idea&of resetting&everything.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_171", "\E7I.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_172", "\E1I don't think I&could do it all&again./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_173", "Not after that./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_174", "\E7.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_175", "\E1So, please./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_176", "\E3Just let them go./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_177", "Let Frisk be happy./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_178", "Let Frisk live&their life./%%");
ds_map_add(global.text_data_en, "obj_endflowey_regret_195", "\E1.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_197", "\E3But./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_199", "If I can't change&your mind./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_201", "If you DO end up&erasing everything.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_203", "\E7.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_205", "\E6You have to erase&my memories^1, too./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_207", "\E7.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_209", "\E6I'm sorry./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_211", "\E5You've probably heard&this a hundred times&already^1, haven't you...?/");
ds_map_add(global.text_data_en, "obj_endflowey_regret_213", ".../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_215", "\E0Well^1, that's all./");
ds_map_add(global.text_data_en, "obj_endflowey_regret_217", "\E6See you later.../");
ds_map_add(global.text_data_en, "obj_endflowey_regret_219", "\E4\[1]./%%");
ds_map_add(global.text_data_en, "obj_endogeny_360", "* Amalgamate is watching you&  intently.");
ds_map_add(global.text_data_en, "obj_endogeny_361", "* Amalgamate is waiting for&  your command.");
ds_map_add(global.text_data_en, "obj_endogeny_362", "* It smells like a bunch of dogs.");
ds_map_add(global.text_data_en, "obj_endogeny_363", "* Amalgamate is hovering close^1,&  looking for affection.");
ds_map_add(global.text_data_en, "obj_endogeny_366", "* Amalgamate is striking the&  wall with its claws.");
ds_map_add(global.text_data_en, "obj_endogeny_367", "* Amalgamate is twitching&  affectionately.");
ds_map_add(global.text_data_en, "obj_endogeny_368", "* Amalgamate's convulsions&  intensify.");
ds_map_add(global.text_data_en, "obj_endogeny_369", "* Endogeny is contented.");
ds_map_add(global.text_data_en, "obj_endogeny_370", "* Monster has low HP.");
ds_map_add(global.text_data_en, "obj_endogeny_371", "* Endogeny is contented.");
ds_map_add(global.text_data_en, "obj_endogeny_403", "* AMALGAMATE - It's unclear how&  many dogs this counts as./^");
ds_map_add(global.text_data_en, "obj_endogeny_404", "* ENDOGENY - It's unclear how&  many dogs this counts as./^");
ds_map_add(global.text_data_en, "obj_endogeny_416", "* The Amalgamate's feelers&  rotate quickly^1.&* Nothing else happens./^");
ds_map_add(global.text_data_en, "obj_endogeny_420", "* You call the Amalgamate./");
ds_map_add(global.text_data_en, "obj_endogeny_421", "* It bounds towards you^1,&  flecking a strange liquid&  from an orifice./^");
ds_map_add(global.text_data_en, "obj_endogeny_435", "* You try looking away^1, but&  it seems to appear everywhere&  you look./^");
ds_map_add(global.text_data_en, "obj_endogeny_446", "* You pet the Amalgamate./^");
ds_map_add(global.text_data_en, "obj_endogeny_449", "* You'd give it a tummy rub^1,&  but it's not clear where its&  tummy begins or ends./^");
ds_map_add(global.text_data_en, "obj_endogeny_455", "* You pet decisively^1.&* The Amalgamate seems to be&  satisfied by all this./^");
ds_map_add(global.text_data_en, "obj_endogeny_466", "* You pet the Amalgamate^1.&* It starts to generate a&  Stage I Happiness Froth./^");
ds_map_add(global.text_data_en, "obj_endogeny_475", "* You try to pet the&  Amalgamate but your hand&  phases through it./");
ds_map_add(global.text_data_en, "obj_endogeny_476", "* It must not want to be pet&  for now./^");
ds_map_add(global.text_data_en, "obj_endogeny_480", "* You pet the Amalgamate^1.&* It convulses rapidly..^1.&* Then calms down./");
ds_map_add(global.text_data_en, "obj_endogeny_481", "* It rests quietly on your&  lap for a moment.../");
ds_map_add(global.text_data_en, "obj_endogeny_482", "* Zzzzz.../");
ds_map_add(global.text_data_en, "obj_endogeny_483", "* Suddenly^1, it shoots away and&  crawls wildly on the walls!/^");
ds_map_add(global.text_data_en, "obj_endogeny_491", "* Amalgamate is too far&  away to pet^1.&* You just pet the air./^");
ds_map_add(global.text_data_en, "obj_endogeny_500", "* You play with the Amalgamate./^");
ds_map_add(global.text_data_en, "obj_endogeny_503", "* Amalgamate seems too tired&  to play./^");
ds_map_add(global.text_data_en, "obj_endogeny_507", "* You throw your weapon into&  the corner of the room./");
ds_map_add(global.text_data_en, "obj_endogeny_508", "* The Amalgamate brings it back&  to you..^1.&* Proudly?/");
ds_map_add(global.text_data_en, "obj_endogeny_509", "* You repeat this process a&  few times./");
ds_map_add(global.text_data_en, "obj_endogeny_510", "* Now Amalgamate is very tired..^1.&* It leans its dripping^1,&  amorphous body on you.../^");
ds_map_add(global.text_data_en, "obj_endogeny_518", "* Amalgamate is not excited&  enough to play with...?/^");
ds_map_add(global.text_data_en, "obj_essaystuff_159", "Speechless...?&Who can blame you?/%%");
ds_map_add(global.text_data_en, "obj_essaystuff_160", "Well... that's concise./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_161", "Beautiful. Sometimes&the fewest words&speak the loudest./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_162", "Nice. You get a&gold star./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_163", "Oh my... what a&great answer./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_164", "Oooooh, you said so&much about me.../");
ds_map_add(global.text_data_en, "obj_essaystuff_165", "I love how&passionate you are./");
ds_map_add(global.text_data_en, "obj_essaystuff_166", "... even though I&don't understand&what you said.../%%");
ds_map_add(global.text_data_en, "obj_essaystuff_168", "Beautiful.&Why don't you&write a book?/%%");
ds_map_add(global.text_data_en, "obj_essaystuff_219", "Nice detail...&You're right, I do&look quite nice./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_220", "Wonderful! Amazing! A+...&I AM completely stunning./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_221", "Oh, I'm blushing...&You're completely right,&I am beautiful in&every way./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_222", "Oh my... I'm speechless...&You've completely&captured how&beautiful I am./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_224", "That's right.&Legs was the&correct answer!/%%");
ds_map_add(global.text_data_en, "obj_essaystuff_225", "How creative. Arms...&most people just&think about my legs./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_226", "My hair... yes,&I use metal hair&gel./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_233", "Yes^1, my personality&is quite charming^1,&isn't it?/%%");
ds_map_add(global.text_data_en, "obj_essaystuff_234", "They say I have&the voice of a&Siren..^1./");
ds_map_add(global.text_data_en, "obj_essaystuff_235", "... awooga!/%%");
ds_map_add(global.text_data_en, "obj_essaystuff_236", "Dancing...^1?&Thank you^1, I'm&self-taught./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_255", "Huh? This essay is&supposed to be about&me, not about you.../%%");
ds_map_add(global.text_data_en, "obj_essaystuff_264", "What a touching&confession! I'll add&it to the pile./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_271", "Toby? What the hell&is that?&Sounds... sexy./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_289", "Oh my! This is a family&friendly TV show./");
ds_map_add(global.text_data_en, "obj_essaystuff_290", "Now stand still while&I murder you./%%");
ds_map_add(global.text_data_en, "obj_essaystuff_510", "* Mettaton is saving your&  essay for future use.");
ds_map_add(global.text_data_en, "obj_essaystuff_ja_1", "");
ds_map_add(global.text_data_en, "obj_essaystuff_ja_2", "");
ds_map_add(global.text_data_en, "obj_essaystuff_ja_3", "");
ds_map_add(global.text_data_en, "obj_essaystuff_ja_4", "");
ds_map_add(global.text_data_en, "obj_f_frasier_32", " %");
ds_map_add(global.text_data_en, "obj_f_frasier_33", " %");
ds_map_add(global.text_data_en, "obj_f_frasier_34", " %");
ds_map_add(global.text_data_en, "obj_f_frasier_35", " %");
ds_map_add(global.text_data_en, "obj_f_frasier_36", "%%%");
ds_map_add(global.text_data_en, "obj_f_frasier_40", "* Hee hee hee^1.&* Did you really think&  you could run away?/%%");
ds_map_add(global.text_data_en, "obj_f_frasier_43", "* Hee hee hee./");
ds_map_add(global.text_data_en, "obj_f_frasier_44", "* Did you really think&  I was gonna be&  satisfied.../");
ds_map_add(global.text_data_en, "obj_f_frasier_45", "* ... killing you only&  ONE time?/%%");
ds_map_add(global.text_data_en, "obj_f_frasier_49", "* Pathetic..^1.&* Now you're REALLY&  gonna die!/%%");
ds_map_add(global.text_data_en, "obj_f_frasier_53", "* Hee hee hee./");
ds_map_add(global.text_data_en, "obj_f_frasier_54", "* Do you even realize&  what will happen if&  you defeat me...?/%%");
ds_map_add(global.text_data_en, "obj_f_frasier_58", "* Don't you get it?/");
ds_map_add(global.text_data_en, "obj_f_frasier_59", "* There's no such thing&  as happy endings./");
ds_map_add(global.text_data_en, "obj_f_frasier_60", "* This is all that's&  left...!/%%");
ds_map_add(global.text_data_en, "obj_f_frasier_64", "* Are you REALLY that&  desperate...^1?&* Hee hee hee.../%%");
ds_map_add(global.text_data_en, "obj_f_frasier_68", "* Are you letting me&  kill you..^1.&* ... on PURPOSE^2?&* SICKO^1. Ha ha ha./%%");
ds_map_add(global.text_data_en, "obj_f_frasier_72", "* Honestly^1, fighting&  you IS pretty fun.../");
ds_map_add(global.text_data_en, "obj_f_frasier_73", "* ... So even if you&  ARE a sicko^1, I'll&  take it!/%%");
ds_map_add(global.text_data_en, "obj_f_frasier_77", "* Maybe you're wondering&  if I ever get tired&  of winning.../");
ds_map_add(global.text_data_en, "obj_f_frasier_78", "* Wanna see my answer?/%%");
ds_map_add(global.text_data_en, "obj_f_frasier_82", "* Don't you have anything&  better to do?/%%");
ds_map_add(global.text_data_en, "obj_fakefroggit_479", "* Froggit doesn't seem to&  know why it's here.");
ds_map_add(global.text_data_en, "obj_fakefroggit_480", "* Froggit hops to and fro.");
ds_map_add(global.text_data_en, "obj_fakefroggit_481", "* The battlefield is filled   with the smell of&   mustard seed.");
ds_map_add(global.text_data_en, "obj_fakefroggit_482", "* You are intimidated by&  Froggit's raw strength^4.&  * Only kidding.");
