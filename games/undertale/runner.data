		for (i = 0; i < 14; i++)
		{
			this_x = (xx + 30)
			if (i < 10 && (i % 2) == 1)
				this_x = xx2
			name = scr_gettext(("credits_short_thanks1_" + string((i + 1))))
			draw_text(this_x, yy, string_hash_to_newline(name))
			if (i >= 10 || (i % 2) == 1)
				yy += 18
		}
	}
	scr_setfont(fnt_ja_maintext)
}
if (number == 10)
{
	xx = 40
