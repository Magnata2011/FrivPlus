ds_map_add(global.text_data_en, "obj_muffetnpc2_75", "* There you are^1, dearie^1.&* You are always welcome in&  my parlor!/");
ds_map_add(global.text_data_en, "obj_muffetnpc2_76", "* Just stay on your best&  behavior^1~&* Ueee hee hee hee~/%%");
ds_map_add(global.text_data_en, "obj_muffetnpc2_81", "* Bonjour^1, dearie^1~&* I just finished tallying up&  all of our donations!/");
ds_map_add(global.text_data_en, "obj_muffetnpc2_82", "* We've finally raised enough&  to rescue all the spiders&  inside of the RUINS./");
ds_map_add(global.text_data_en, "obj_muffetnpc2_83", "* And we'll also be able to&  afford...!/");
ds_map_add(global.text_data_en, "obj_muffetnpc2_84", "* ... nothing^1, because we&  only sold one donut./");
ds_map_add(global.text_data_en, "obj_muffetnpc2_85", "* What's wrong with everyone^1?&* Don't they like spiders~/%%");
ds_map_add(global.text_data_en, "obj_muffetnpc2_87", "* 4 pairs of stylish sunglasses&  for every spider!/%%");
ds_map_add(global.text_data_en, "obj_muffetnpc2_89", "* 4 pairs of waterproof booties&  for every spider!/%%");
ds_map_add(global.text_data_en, "obj_muffetnpc2_91", "* 4 pairs of stylish heels for&  every spider!/%%");
ds_map_add(global.text_data_en, "obj_muffetnpc2_93", "* A spider baseball field^1!&* We've already got the baseball&  donuts ready~/%%");
ds_map_add(global.text_data_en, "obj_muffetnpc2_95", "* A spider football stadium^1!&* We'll play with 4 balls on the&  field at once!/%%");
ds_map_add(global.text_data_en, "obj_muffetnpc2_99", "* A brand new bakery^1!&* Thank you so much^1, dearie!/");
ds_map_add(global.text_data_en, "obj_muffetnpc2_100", "* It's all because of you^2 &* (r money)./%%");
ds_map_add(global.text_data_en, "obj_muffetnpc2_105", "* A vacation anywhere in the&  entire world!/");
ds_map_add(global.text_data_en, "obj_muffetnpc2_106", "* Should we go to the tropics^1?&* Or a creepy abandoned house^1?&* We can't decide~/%%");
ds_map_add(global.text_data_en, "obj_multitileevent_121", "* OH NO!&* WHATEVER SHALL I DO?/");
ds_map_add(global.text_data_en, "obj_multitileevent_122", "* MY LOVE HAS BEEN CAST AWAY&  INTO THE DUNGEON./");
ds_map_add(global.text_data_en, "obj_multitileevent_123", "* A DUNGEON WITH A PUZZLE SO&  DASTARDLY^1, MY PARAMOUR WILL&  SURELY PERISH!/%%");
ds_map_add(global.text_data_en, "obj_multitileevent_144", "* O, HEAVENS HAVE MERCY!&* THE HORRIBLE COLORED TILE&  MAZE!/");
ds_map_add(global.text_data_en, "obj_multitileevent_145", "* EACH COLORED TILE HAS ITS&  OWN SADISTIC FUNCTION./");
ds_map_add(global.text_data_en, "obj_multitileevent_146", "* FOR EXAMPLE, A GREEN TILE&  SOUNDS A NOISE, AND THEN&  YOU MUST FIGHT A MONSTER./");
ds_map_add(global.text_data_en, "obj_multitileevent_147", "* RED TILES WILL...&* ACTUALLY, WAIT A SECOND./");
ds_map_add(global.text_data_en, "obj_multitileevent_148", "* DIDN'T WE SEE THIS PUZZLE&  ABOUT A HUNDRED ROOMS&  AGO?/");
ds_map_add(global.text_data_en, "obj_multitileevent_149", "* THAT'S RIGHT.&* YOU REMEMBER ALL THE&  RULES, DON'T YOU?/");
ds_map_add(global.text_data_en, "obj_multitileevent_150", "* GREAT...&* THEN I WON'T WASTE YOUR&  TIME REPEATING THEM!!/%%");
ds_map_add(global.text_data_en, "obj_multitileevent_163", "* OH, AND YOU'D BETTER HURRY./");
ds_map_add(global.text_data_en, "obj_multitileevent_164", "\W* BECAUSE IF YOU DON'T GET&  THROUGH IN \Y30 SECONDS\W.../%%");
ds_map_add(global.text_data_en, "obj_multitileevent_192", "* YOU'LL BE INCINERATED BY&  THESE JETS OF FIRE!!/");
ds_map_add(global.text_data_en, "obj_multitileevent_193", "* AHAHAHAHAHAHA!&* AHAHA... HA... HA!/");
ds_map_add(global.text_data_en, "obj_multitileevent_194", "* MY POOR LOVE!&* I'M SO FILLED WITH GRIEF,&  I CAN'T STOP LAUGHING!/");
ds_map_add(global.text_data_en, "obj_multitileevent_195", "* GOOD LUCK, DARLING!/%%");
ds_map_add(global.text_data_en, "obj_multitileevent_279", "* OOOOH, I'M SO SORRY!&* LOOKS LIKE YOU'RE OUT OF&  TIME!!!/%%");
ds_map_add(global.text_data_en, "obj_multitileevent_304", "* HERE COME THE FLAMES, DARLING!/%%");
ds_map_add(global.text_data_en, "obj_multitileevent_330", "* THEY'RE CLOSING IN!/%%");
ds_map_add(global.text_data_en, "obj_multitileevent_356", "* GETTING!&* CLOSER!&* OH MY!/%%");
ds_map_add(global.text_data_en, "obj_multitileevent_382", "* ANY MINUTE NOW!!!/%%");
ds_map_add(global.text_data_en, "obj_multitileevent_409", "* ...&* ...&* (ROBOTIC COUGH)/%%");
ds_map_add(global.text_data_en, "obj_multitileevent_426", "* Ring.../");
ds_map_add(global.text_data_en, "obj_multitileevent_427", "* \TS \F6 \TA %");
ds_map_add(global.text_data_en, "obj_multitileevent_428", "* Watch out!^1!&* I'll save you!!/");
ds_map_add(global.text_data_en, "obj_multitileevent_429", "* I'm hacking into the&  firewall right now!/%%");
ds_map_add(global.text_data_en, "obj_multitileevent_447", "* OH NO!!!&* HOW COULD THIS HAPPEN???/");
ds_map_add(global.text_data_en, "obj_multitileevent_448", "* FOILED AGAIN BY THE BRILLIANT&  DOCTOR ALPHYS!!/%%");
ds_map_add(global.text_data_en, "obj_multitileevent_464", "* THA-%");
ds_map_add(global.text_data_en, "obj_multitileevent_465", "\TS \F6 \TA %");
ds_map_add(global.text_data_en, "obj_multitileevent_466", "\E6* That's right!/");
ds_map_add(global.text_data_en, "obj_multitileevent_467", "\E6* Come on^1, Mettaton^1,&  give up already!/");
ds_map_add(global.text_data_en, "obj_multitileevent_468", "* You'll never be&  able to defeat&  us.../");
ds_map_add(global.text_data_en, "obj_multitileevent_469", "\E0* Not as long as&  we work together!/");
ds_map_add(global.text_data_en, "obj_multitileevent_470", "\E6* Your puzzle's over..&* Now go home and&  leave us alone!/");
ds_map_add(global.text_data_en, "obj_multitileevent_471", "\TS \F0 \TM %");
ds_map_add(global.text_data_en, "obj_multitileevent_472", "* PUZZLE^1?&* OVER?/");
ds_map_add(global.text_data_en, "obj_multitileevent_473", "* ALPHYS^1, DARLING^1, WHAT ARE YOU&  TALKING ABOUT...?/");
ds_map_add(global.text_data_en, "obj_multitileevent_474", "* DID YOU FORGET WHAT THE&  GREEN TILES DO?/");
ds_map_add(global.text_data_en, "obj_multitileevent_475", "* THEY MAKE A SOUND, THEN&  YOU HAVE TO FIGHT A MONSTER./");
ds_map_add(global.text_data_en, "obj_multitileevent_476", "* WELL, DARLING...&* THAT MONSTER.../");
ds_map_add(global.text_data_en, "obj_multitileevent_477", "* IS ME!!/%%");
ds_map_add(global.text_data_en, "obj_multitileevent_480", "* WELL, DARLING...!/");
ds_map_add(global.text_data_en, "obj_multitileevent_481", "* WELL, WELL, WELL./");
ds_map_add(global.text_data_en, "obj_multitileevent_482", "* WELLY WELL WELL./");
ds_map_add(global.text_data_en, "obj_multitileevent_483", "* WELL WELLY WELL WELL,&  WELL WELL WELLY./");
ds_map_add(global.text_data_en, "obj_multitileevent_484", "* YOU NEVER STEPPED ON A&  GREEN TILE./");
ds_map_add(global.text_data_en, "obj_multitileevent_485", "* .../");
ds_map_add(global.text_data_en, "obj_multitileevent_486", "* AND NOW YOU'RE GOING TO DIE./%%");
ds_map_add(global.text_data_en, "obj_multitileevent_592", "* CONGRATULATIONS!/");
ds_map_add(global.text_data_en, "obj_multitileevent_593", "* YOU MADE IT THROUGH THE&  PUZZLE!!!/");
ds_map_add(global.text_data_en, "obj_multitileevent_594", "* AND NOW, WITHOUT FURTHER ADO,&  THE FLAMES WILL BE DEACTIVATED!/%%");
ds_map_add(global.text_data_en, "obj_multitileevent_614", "* NO!&* MORE!&* FIRE!/");
ds_map_add(global.text_data_en, "obj_multitileevent_615", "* ... BUT IT'S AS THE PHRASE&  GOES./");
ds_map_add(global.text_data_en, "obj_multitileevent_616", "* \"OUT OF THE FIRE, AND INTO&  THE FRYING PAN.\"/");ds_map_add(global.text_data_en, "obj_multitileevent_617", "* THAT'S RIGHT, DARLING!/");
ds_map_add(global.text_data_en, "obj_multitileevent_618", "* EVEN IF YOU MANAGE TO BEAT&  THE HEAT.../");
ds_map_add(global.text_data_en, "obj_multitileevent_619", "* YOU'LL NEVER BE ABLE TO&  WITHSTAND MY HOT METAL&  BODY!/");
ds_map_add(global.text_data_en, "obj_multitileevent_620", "* PREPARE YOURSELF FOR MY %%");
ds_map_add(global.text_data_en, "obj_multitileevent_631", "* Ring.../");
ds_map_add(global.text_data_en, "obj_multitileevent_632", "* \TS \F6 \TA %");
ds_map_add(global.text_data_en, "obj_multitileevent_633", "* Watch out!^1!&* I'll save you!!/");
ds_map_add(global.text_data_en, "obj_multitileevent_634", "* Flames^1, deactivate!!/");
ds_map_add(global.text_data_en, "obj_multitileevent_635", "* .../");
ds_map_add(global.text_data_en, "obj_multitileevent_636", "\E3* ... huh?/");
ds_map_add(global.text_data_en, "obj_multitileevent_637", "\TS \F0 \TM %");
ds_map_add(global.text_data_en, "obj_multitileevent_638", "* THE HUMAN FINISHED THE PUZZLE./");
ds_map_add(global.text_data_en, "obj_multitileevent_639", "* I ALREADY TURNED OFF THE&  FLAMES./");
ds_map_add(global.text_data_en, "obj_multitileevent_640", "* IN FACT, I WAS ABOUT TO&  FIGHT THE HUMAN./");
ds_map_add(global.text_data_en, "obj_multitileevent_641", "\TS \F6 \TA %");
ds_map_add(global.text_data_en, "obj_multitileevent_642", "* Wh-wh-what?&* TH-THAT puzzle?/");
ds_map_add(global.text_data_en, "obj_multitileevent_643", "\E5* I mean, uhh.../");
ds_map_add(global.text_data_en, "obj_multitileevent_644", "\E6* Great job!&* We've got him on&  the ropes^1, now!/");
ds_map_add(global.text_data_en, "obj_multitileevent_645", "\TS \F0 \TM %");
ds_map_add(global.text_data_en, "obj_multitileevent_646", "* ON THE ROPES^1?&* HA!/");
ds_map_add(global.text_data_en, "obj_multitileevent_647", "* I ONLY DEACTIVATED THE&  FLAMES KNOWING THAT ALPHYS&  WOULD HAVE ANYWAY./");
ds_map_add(global.text_data_en, "obj_multitileevent_648", "* ... NOW, WHERE WERE WE?/");
ds_map_add(global.text_data_en, "obj_multitileevent_649", "* OH YES./");
ds_map_add(global.text_data_en, "obj_multitileevent_650", "* I WAS GOING TO ERADICATE&  YOU!/%%");
ds_map_add(global.text_data_en, "obj_musicstatue_110", "* NO!/%%");
ds_map_add(global.text_data_en, "obj_musicstatue_114", "* (No point in giving it an&  umbrella now.)/%%");
ds_map_add(global.text_data_en, "obj_napstablook_294", "i'm&fine,&thanks.");
ds_map_add(global.text_data_en, "obj_napstablook_295", "just&pluggin&along...");
ds_map_add(global.text_data_en, "obj_napstablook_296", "nnnnnn&ggghhh.");
ds_map_add(global.text_data_en, "obj_napstablook_297", "oh, i'm&REAL&funny.");
ds_map_add(global.text_data_en, "obj_napstablook_298", "go&ahead,&do it.");
ds_map_add(global.text_data_en, "obj_napstablook_299", "i'd just&weigh&you&down.");
ds_map_add(global.text_data_en, "obj_napstablook_300", "heh...");
ds_map_add(global.text_data_en, "obj_napstablook_301", "heh&heh...");
ds_map_add(global.text_data_en, "obj_napstablook_302", "let me&try...");
ds_map_add(global.text_data_en, "obj_napstablook_305", "i knew&it...");
ds_map_add(global.text_data_en, "obj_napstablook_311", "oh&no...");
ds_map_add(global.text_data_en, "obj_napstablook_317", "oh&gee...");
ds_map_add(global.text_data_en, "obj_napstablook_329", "%%%");
ds_map_add(global.text_data_en, "obj_napstablook_339", "umm... you do&know you cant&kill ghosts, right?/");
ds_map_add(global.text_data_en, "obj_napstablook_340", "we're sorta&incorporeal and&all/");
ds_map_add(global.text_data_en, "obj_napstablook_341", "i was just&lowering my hp&because i didnt&want to be rude/");
ds_map_add(global.text_data_en, "obj_napstablook_342", "sorry..^1.&i just made this&more awkward.../");
ds_map_add(global.text_data_en, "obj_napstablook_343", "pretend you beat&  me.../");
ds_map_add(global.text_data_en, "obj_napstablook_344", "ooooooooo^1o%%");
ds_map_add(global.text_data_en, "obj_napstablook_549", "* Napstablook is staring into&  the distance.");
ds_map_add(global.text_data_en, "obj_napstablook_550", "* Napstablook is wishing they&  weren't here.");
ds_map_add(global.text_data_en, "obj_napstablook_551", "* Napstablook is pretending to&  sleep.");
ds_map_add(global.text_data_en, "obj_napstablook_552", "* The faint odor of ectoplasm&  permeates the vicinity.");
ds_map_add(global.text_data_en, "obj_napstablook_553", "* Napstablook looks just a&  little bit better.");
ds_map_add(global.text_data_en, "obj_napstablook_554", "* Cheering seems to have&  improved Napstablook's&  mood again.");
ds_map_add(global.text_data_en, "obj_napstablook_576", "* NAPSTABLOOK - ATK 10 DEF 10&* This monster doesn't seem to&  have a sense of humor.../^");
ds_map_add(global.text_data_en, "obj_napstablook_579", "* NAPSTABLOOK - ATK 10 DEF 10&* Missed the memo and is the&  same difficulty as normal./^");
ds_map_add(global.text_data_en, "obj_napstablook_603", "* You give Napstablook a&  cruel look./^");
ds_map_add(global.text_data_en, "obj_napstablook_621", "* You try to console&  Napstablook.../^");
ds_map_add(global.text_data_en, "obj_napstablook_622", "* You gave Napstablook a&  patient smile./^");
ds_map_add(global.text_data_en, "obj_napstablook_623", "* You told Napstablook a&  little joke./^");
ds_map_add(global.text_data_en, "obj_napstablook_624", "* Napstablook wants to&  show you something./^");
ds_map_add(global.text_data_en, "obj_napstablook1_62", "* i usually come to the&  RUINS because there's&  nobody around.../");
ds_map_add(global.text_data_en, "obj_napstablook1_63", "* but today i met somebody&  nice.../");
ds_map_add(global.text_data_en, "obj_napstablook1_64", "* .../");
ds_map_add(global.text_data_en, "obj_napstablook1_65", "* oh^1, i'm rambling again/");
ds_map_add(global.text_data_en, "obj_napstablook1_66", "* i'll get out of your way/%%");
ds_map_add(global.text_data_en, "obj_napstablook2_61", "* i fell down a hole...&* now i cant get up.../");
ds_map_add(global.text_data_en, "obj_napstablook2_62", "* go on without me.../");
ds_map_add(global.text_data_en, "obj_napstablook2_63", "* wait^1, ghosts can fly^1,&  can't they.../");
ds_map_add(global.text_data_en, "obj_napstablook2_64", "* oh well.../%%");
ds_map_add(global.text_data_en, "obj_napstablook_actor_114", "* i'm..^1. working on a mix cd..^1.&* make yourself at home...?/%%");
ds_map_add(global.text_data_en, "obj_napstablook_actor_119", "* uh^1, do you wanna..^1.&* listen to some tunes.../");
ds_map_add(global.text_data_en, "obj_napstablook_actor_120", "* or something.../%%");
ds_map_add(global.text_data_en, "obj_napstablook_actor_123", "* uhhhh..^1.&* i'm gonna keep working&  on that mix cd./%%");
ds_map_add(global.text_data_en, "obj_napstablook_actor_127", "* i've almost got a mix cd&  finished for my scary&  neighbor.../");
ds_map_add(global.text_data_en, "obj_napstablook_actor_128", "* it's 74 minutes of people&  screaming their signature&  wrestling moves/");
ds_map_add(global.text_data_en, "obj_napstablook_actor_129", "* but they're all autotuned^1.&* i hope she likes it/%%");
ds_map_add(global.text_data_en, "obj_napstablook_actor_134", "* oh............../%%");
ds_map_add(global.text_data_en, "obj_napstablook_actor_138", "* oh..^1. a classic spooktune..^1.&* they don't make songs like&  this anymore.../%%");
ds_map_add(global.text_data_en, "obj_napstablook_actor_140", "* dang..^1. that ambience...&* it's like my whole body&  is being spooked.../%%");
ds_map_add(global.text_data_en, "obj_napstablook_actor_143", "* oh^1, this one..^1.&* once you learn the lyrics&  it's hard not to sing along.../");
ds_map_add(global.text_data_en, "obj_napstablook_actor_144", "* ooo ooo ooo^2o&* ooo ooo ooo^2o&* oo oo oo^1o oo ooo/%%");
ds_map_add(global.text_data_en, "obj_napstablook_actor_152", "* oh..............^1.&* mettaton.......^1.&* i'm a huge fan......../");
ds_map_add(global.text_data_en, "obj_napstablook_actor_153", "* ..... oh^1, hi/");
ds_map_add(global.text_data_en, "obj_napstablook_actor_157", "* what^1? undyne says hi^1?&* then tell her...^1.&* i say.........../");
ds_map_add(global.text_data_en, "obj_napstablook_actor_158", "* ......................&  ...... something cool./");
ds_map_add(global.text_data_en, "obj_napstablook_actor_163", "* human...^1.&* i'll never forget when you&  cheered me on/");
ds_map_add(global.text_data_en, "obj_napstablook_actor_164", "* when i was pretending to&  sleep.../");
ds_map_add(global.text_data_en, "obj_napstablook_actor_165", "* no one had ever had so&  much faith in my fake&  sleep..../");
ds_map_add(global.text_data_en, "obj_napstablook_actor_171", "* human..^1.&* i'll never forget.../");
ds_map_add(global.text_data_en, "obj_napstablook_actor_172", "* that time you tried to&  destroy me..^1.&* but... you failed..../");
ds_map_add(global.text_data_en, "obj_napstablook_actor_173", "* sorry..^1.&* i messed it up/");
ds_map_add(global.text_data_en, "obj_napstablook_actor_179", "* uh........^1.&* also.....^1.&* this is awkward... but/");
ds_map_add(global.text_data_en, "obj_napstablook_actor_180", "* what's...^1.&  your name/");
ds_map_add(global.text_data_en, "obj_napstablook_actor_181", "* everyone seems to know&  it now^1, except me...../");
ds_map_add(global.text_data_en, "obj_napstablook_actor_182", "* seems like i've been&  missing out lately/");
ds_map_add(global.text_data_en, "obj_napstablook_actor_183", "* i was just sitting at home&  listening to tunes/");
ds_map_add(global.text_data_en, "obj_napstablook_actor_184", "* there was a flash of light&  outside my window/");
ds_map_add(global.text_data_en, "obj_napstablook_actor_185", "* i saw the snails on the farm&  disappear/");
ds_map_add(global.text_data_en, "obj_napstablook_actor_186", "* then i heard a knock at&  the door/");
ds_map_add(global.text_data_en, "obj_napstablook_actor_187", "* the flash of light wanted&  to come in...&* i closed the blinds.../");
ds_map_add(global.text_data_en, "obj_napstablook_actor_188", "* now everyone knows your&  name except for me/");
ds_map_add(global.text_data_en, "obj_napstablook_actor_189", "* \"frisk...\"&* ok^1, i wont forget it/%%");ds_map_add(global.text_data_en, "obj_napstablook_actor_196", "* your name...?/");
ds_map_add(global.text_data_en, "obj_napstablook_actor_197", "* .../");
ds_map_add(global.text_data_en, "obj_napstablook_actor_198", "* \"frisk\"..^1.&* i didnt forget/");ds_map_add(global.text_data_en, "obj_napstablook_actor_199", "* because i cried the&  letters into my hand/%%");
ds_map_add(global.text_data_en, "obj_napstablook_actor_204", "* oh no..^1.&* the letters in my hand&  are joining together/");
ds_map_add(global.text_data_en, "obj_napstablook_actor_205", "* oh no..^1.&* i'm going to forget your&  name.../");
ds_map_add(global.text_data_en, "obj_napstablook_actor_206", "* oh no..^1.&* i'm trying to cry more&  tears into my hand.../");
ds_map_add(global.text_data_en, "obj_napstablook_actor_207", "* oh no..^1.&* the tears are all forming&  a big pile.../");
ds_map_add(global.text_data_en, "obj_napstablook_actor_208", "* oh no..^1.&* your name's getting really&  long/%%");
ds_map_add(global.text_data_en, "obj_napstablook_cd_113", "* (You still need to recover&  after all that lying down.)/%%");
ds_map_add(global.text_data_en, "obj_napstablook_farm1_73", "* awkward..^1.&* i'm working right now.../");
ds_map_add(global.text_data_en, "obj_napstablook_farm1_74", "* i mean.../");
ds_map_add(global.text_data_en, "obj_napstablook_farm1_75", "* welcome to blook family&  snail farm.../");
ds_map_add(global.text_data_en, "obj_napstablook_farm1_76", "* ... yeah^1.&* i'm the only employee./");
ds_map_add(global.text_data_en, "obj_napstablook_farm1_77", "* this place used to get a lot&  of business.../");
ds_map_add(global.text_data_en, "obj_napstablook_farm1_78", "* but our main customer&  disappeared one day.../");
ds_map_add(global.text_data_en, "obj_napstablook_farm1_79", "* now it's just some hairy&  guy that shows up once&  a month.../%%");
ds_map_add(global.text_data_en, "obj_napstablook_farm1_83", "* really^1, i'm working..^1.&* i don't want the boss&  to get mad at me.../");
ds_map_add(global.text_data_en, "obj_napstablook_farm1_84", "* especially since i'm my&  own boss.../%%");
ds_map_add(global.text_data_en, "obj_napstablook_farm1_89", "* hmmm..^1. i should probably&  try to make friends&  with my neighbor/");
ds_map_add(global.text_data_en, "obj_napstablook_farm1_90", "* she's kind of scary^1, but&  i feel like i'm always&  too late to make friends.../");
ds_map_add(global.text_data_en, "obj_napstablook_farm1_91", "* i should at least try.../%%");
ds_map_add(global.text_data_en, "obj_napstablook_farm2_270", "\R 3..^2.& 2..^2.& 1..^2.%%");
ds_map_add(global.text_data_en, "obj_napstablook_farm2_284", "\R GO!!^2!%%");
ds_map_add(global.text_data_en, "obj_napstablook_farm2_374", "\R RACE END!!^2!%%");
ds_map_add(global.text_data_en, "obj_napstablook_farm2_402", "* oh........^1.&* you both tried your best.../");
ds_map_add(global.text_data_en, "obj_napstablook_farm2_403", "* but the snail looks&  discouraged.../");
ds_map_add(global.text_data_en, "obj_napstablook_farm2_404", "* her best wasn't good&  enough.../");
ds_map_add(global.text_data_en, "obj_napstablook_farm2_405", "* oh........../%%");
ds_map_add(global.text_data_en, "obj_napstablook_farm2_408", "* oh.......^1.&* looks like you encouraged&  your snail too much.../");
ds_map_add(global.text_data_en, "obj_napstablook_farm2_409", "* all that pressure to&  succeed..^1.&* really got to her.../");
ds_map_add(global.text_data_en, "obj_napstablook_farm2_410", "* oh......../%%");
ds_map_add(global.text_data_en, "obj_napstablook_farm2_415", "* you won..^1. congratulations./");
ds_map_add(global.text_data_en, "obj_napstablook_farm2_416", "* as a prize^1, you get 9G./");
ds_map_add(global.text_data_en, "obj_napstablook_farm2_417", "* sorry..^1. we have to make&  a profit somehow.../%%");
ds_map_add(global.text_data_en, "obj_napstablook_farm2_422", "* your snail lost by a&  thin margin./");
ds_map_add(global.text_data_en, "obj_napstablook_farm2_423", "* actually^1, the snail is&  under the false belief&  that it won.../");
ds_map_add(global.text_data_en, "obj_napstablook_farm2_424", "* oh no..^1. the snail is looking&  over here.../");
ds_map_add(global.text_data_en, "obj_napstablook_farm2_426", "* here^1, i'll give you some&  money..^1.&* act like you won.../");
ds_map_add(global.text_data_en, "obj_napstablook_farm2_427", "* (You got 30G.)/%%");
ds_map_add(global.text_data_en, "obj_napstablookdate_158", "* oh..^1. hey..^1. you..^1./");
ds_map_add(global.text_data_en, "obj_napstablookdate_159", "* followed me..^1.&* into my house.../");
ds_map_add(global.text_data_en, "obj_napstablookdate_160", "* ..^1.&* m-make yourself at home???/%%");
ds_map_add(global.text_data_en, "obj_napstablookdate_163", "* oh..^1.&* you really came.../");
ds_map_add(global.text_data_en, "obj_napstablookdate_164", "* sorry^1, i...&* wasn't expecting that./");
ds_map_add(global.text_data_en, "obj_napstablookdate_165", "* it's not much^1, but make&  yourself at home./%%");
ds_map_add(global.text_data_en, "obj_napstablookdate_192", "* oh..^1. are you hungry.../");
ds_map_add(global.text_data_en, "obj_napstablookdate_193", "* i can get you something&  to eat.../%%");
ds_map_add(global.text_data_en, "obj_napstablookdate_312", "* here we go..^1.&* you'll lie down as long&  as you don't move./");
ds_map_add(global.text_data_en, "obj_napstablookdate_313", "* so..^1. only move around when&  you want to get up^1, i&  guess./%%");
ds_map_add(global.text_data_en, "obj_napstablookdate_356", "* well^1, that was nice..^1.&* thank you.../%%");
ds_map_add(global.text_data_en, "obj_napstablookfriendtrigger_100", "* oh hey... you...&* followed me.../");
ds_map_add(global.text_data_en, "obj_napstablookfriendtrigger_101", "* my house is up here.../");
ds_map_add(global.text_data_en, "obj_napstablookfriendtrigger_102", "* so you probably don't want to&  come this way.../");
ds_map_add(global.text_data_en, "obj_napstablookfriendtrigger_103", "* hope that helps.../%%");
ds_map_add(global.text_data_en, "obj_napstablookfriendtrigger_108", "* hey..^1.&* my house is up here.../");
ds_map_add(global.text_data_en, "obj_napstablookfriendtrigger_109", "* in case you want to see.../");
ds_map_add(global.text_data_en, "obj_napstablookfriendtrigger_110", "* or in case.../");
ds_map_add(global.text_data_en, "obj_napstablookfriendtrigger_111", "* you don't.../%%");
ds_map_add(global.text_data_en, "obj_napstafridge_75", "* (It's merely a fridge.)/%%");
ds_map_add(global.text_data_en, "obj_napstafridge_100", "* (It's too dark to see&  near the walls.)/%%");
ds_map_add(global.text_data_en, "obj_nastrytree_bottom_55", "* Every time this old tree&  grows any leaves^1, they fall&  right off./%%");
ds_map_add(global.text_data_en, "obj_nastytree_55", "* Every time this old tree&  grows any leaves^1, they fall&  right off./%%");
ds_map_add(global.text_data_en, "obj_nastytree_56", "* It's a neat-looking tree./%%");
ds_map_add(global.text_data_en, "obj_nastytree_59", "* (It's natural for a tree to&  lose its leaves.)/%%");
ds_map_add(global.text_data_en, "obj_nicecreamguy_122", "* I don't understand why&  these aren't selling.../");
ds_map_add(global.text_data_en, "obj_nicecreamguy_123", "* It's the perfect weather&  for something cold.../%%");
ds_map_add(global.text_data_en, "obj_nicecreamguy_135", "* You must have something better to do than read this message./%%");
ds_map_add(global.text_data_en, "obj_nicecreamguy_152", "* I relocated my store^1, but&  there are still no&  customers.../%%");
ds_map_add(global.text_data_en, "obj_nicecreamguy_164", "* You must have something better to do than read this message./%%");
ds_map_add(global.text_data_en, "obj_nicecreamguy_183", "* I thought for sure if I&  went to Hotland^1, I'd sell&  some Nice Creams./");
ds_map_add(global.text_data_en, "obj_nicecreamguy_184", "* But nobody wants them^1.&* Everyone's just eating&  Starfaits and Glamburgers./");
ds_map_add(global.text_data_en, "obj_nicecreamguy_185", "* So!!!/%%");
ds_map_add(global.text_data_en, "obj_nicecreamguy_197", "* You must have something better to do than read this message./%%");
ds_map_add(global.text_data_en, "obj_nicecreamguy_211", "* I'm so happy!^1!&* Nice Cream is really&  changing the world!!/%%");
ds_map_add(global.text_data_en, "obj_nicecreamguy_215", "* Hey^1!&* It's you again^1!/");
ds_map_add(global.text_data_en, "obj_nicecreamguy_216", "* Business is excellent here^1!&* These two fellas bought&  ALL my ice cream!/");
ds_map_add(global.text_data_en, "obj_nicecreamguy_217", "* I've actually sold out of&  everything!!!/");
ds_map_add(global.text_data_en, "obj_nicecreamguy_218", "* ... sorry./");
ds_map_add(global.text_data_en, "obj_nicecreamguy_219", "* Wait^1!&* I've still got something&  for you!/");
ds_map_add(global.text_data_en, "obj_nicecreamguy_220", "* ... a big smile^1!&* How about that!/%%");
ds_map_add(global.text_data_en, "obj_nicecreamguy_227", "* I'm so excited to sell&  Nice Cream on the surface!/");
ds_map_add(global.text_data_en, "obj_nicecreamguy_230", "* If all humans are like you^1,&  then...!/");
ds_map_add(global.text_data_en, "obj_nicecreamguy_231", "* ... then I'll still be&  able to sell to monsters^1,&  I hope./%%");
ds_map_add(global.text_data_en, "obj_nicecreamguy_234", "* If all humans are like you^1,&  I think it'll be a modest&  success!/%%");
ds_map_add(global.text_data_en, "obj_nicecreamguy_236", "* If all humans are like you^1,&  I think it'll be really&  popular!/%%");
ds_map_add(global.text_data_en, "obj_nicecreamguy_288", "* OH!!!^1!&* A CUSTOMER!!!/%%");
ds_map_add(global.text_data_en, "obj_nicecreamguy_291", "* Fortunately^1, I've thought&  of a solution!!/");
ds_map_add(global.text_data_en, "obj_nicecreamguy_292", "* Punch cards!!/");
ds_map_add(global.text_data_en, "obj_nicecreamguy_293", "* Every time you buy a&  Nice Cream^1, you can take a&  punch card from the box./");
ds_map_add(global.text_data_en, "obj_nicecreamguy_294", "* If you have 3 cards^1, you&  can trade them for a&  free Nice Cream!/");
ds_map_add(global.text_data_en, "obj_nicecreamguy_295", "* They're sure to get the&  customers to come back!/%%");
ds_map_add(global.text_data_en, "obj_nicecreamguy_296", "* Anyway.../%%");
ds_map_add(global.text_data_en, "obj_nicecreamguy_302", "* I'm having a going out of&  business sale./%%");
ds_map_add(global.text_data_en, "obj_nicecreamguy_320", "* You must have something better to do than read this message./%%");
ds_map_add(global.text_data_en, "obj_nicesnowman_107", "* Oh^1?&* About that piece I gave you?/");
ds_map_add(global.text_data_en, "obj_nicesnowman_108", "* .../");
ds_map_add(global.text_data_en, "obj_nicesnowman_109", "* ... I never gave you anything./%%");
ds_map_add(global.text_data_en, "obj_nicesnowman_120", "* Ah..^1. I can feel that piece&  of me has been well taken&  care of./");
ds_map_add(global.text_data_en, "obj_nicesnowman_121", "* Thank you./");
ds_map_add(global.text_data_en, "obj_nicesnowman_122", "* Hmmm...^1?&* The barrier's opened up?/");
ds_map_add(global.text_data_en, "obj_nicesnowman_123", "* Hmmm..^1.&* Then^1, if it's not too much&  to ask.../");
ds_map_add(global.text_data_en, "obj_nicesnowman_124", "* ... could you take that&  piece of me to the surface?/");
ds_map_add(global.text_data_en, "obj_nicesnowman_125", "* I would really appreciate&  it./%%");
ds_map_add(global.text_data_en, "obj_nicesnowman_133", "* So^1, did you take that&  piece of me very far&  away...?/");
ds_map_add(global.text_data_en, "obj_nicesnowman_134", "* .../");
ds_map_add(global.text_data_en, "obj_nicesnowman_135", "* Where's the piece!?/%%");
ds_map_add(global.text_data_en, "obj_nicesnowman_140", "* Ah^1, the barrier's open...?/");
ds_map_add(global.text_data_en, "obj_nicesnowman_141", "* You know I cannot move^1.&* Why are you telling me^1?&* To mock me?/");
ds_map_add(global.text_data_en, "obj_nicesnowman_142", "* Everyone may think you are a&  good person^1, but this snowman&  knows the truth./");
ds_map_add(global.text_data_en, "obj_nicesnowman_143", "* Someday^1, your friends will&  realize your heart is as&  cold as my butt./%%");
ds_map_add(global.text_data_en, "obj_nicesnowman_155", "* (You're carrying too many&  items.)/%%");
ds_map_add(global.text_data_en, "obj_nicesnowman_161", "* Hello^1.&* I am a snowman^1.&* I cannot move./");
ds_map_add(global.text_data_en, "obj_nicesnowman_162", "* Traveller^1, if you could.../");
ds_map_add(global.text_data_en, "obj_nicesnowman_163", "* (You got the Snowman Piece.)/%%");
ds_map_add(global.text_data_en, "obj_nicesnowman_167", "* Oh me^1, oh my^1.&* What are you doing?/");
ds_map_add(global.text_data_en, "obj_nicesnowman_168", "* Soon there won't be any&  of me left.../");
ds_map_add(global.text_data_en, "obj_nicesnowman_169", "* (You got the Snowman Piece.)/%%");
ds_map_add(global.text_data_en, "obj_nicesnowman_173", "* Stop..^1.&* Please.../");
ds_map_add(global.text_data_en, "obj_nicesnowman_174", "* (You got the Snowman Piece.)/%%");
ds_map_add(global.text_data_en, "obj_nicesnowman_177", "* (A useless pile of snow.)/%%");
ds_map_add(global.text_data_en, "obj_notify_room_112", "\YALPHYS updated status.\W &* oopswait how's the humnan&  doing/%%");
